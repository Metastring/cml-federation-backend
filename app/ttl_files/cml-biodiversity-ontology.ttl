@prefix cml:   <http://cml.org/ontology#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology Declaration
#################################################################

cml:CMLBiodiversityOntology
    a owl:Ontology ;
    rdfs:label "CML Biodiversity Ontology" ;
    rdfs:comment "Core biodiversity ontology aligned with TDWG (Darwin Core) and EML, designed for CML knowledge graph." .

#################################################################
# Core Classes (Concepts)
#################################################################

### Taxonomy (TDWG-aligned)

cml:TaxonConcept a owl:Class ;
    rdfs:label "Taxon Concept" ;
    rdfs:comment "A taxon as defined according to a particular source." .

cml:ScientificName a owl:Class ;
    rdfs:label "Scientific Name" .

cml:TaxonomicRank a owl:Class ;
    rdfs:label "Taxonomic Rank" .

cml:TaxonIdentifier a owl:Class ;
    rdfs:label "Taxon Identifier" .

### Occurrence & Observation

cml:Occurrence a owl:Class ;
    rdfs:label "Occurrence" ;
    rdfs:comment "An instance of observing a taxon at a place and time." .

cml:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A temporal observation or sampling event." .

cml:Location a owl:Class ;
    rdfs:label "Location" .

### Ecology / Habitat

cml:Habitat a owl:Class ;
    rdfs:label "Habitat" .

cml:Biome a owl:Class ;
    rdfs:label "Biome" .

cml:EnvironmentalCondition a owl:Class ;
    rdfs:label "Environmental Condition" .

### Dataset & Metadata (EML-aligned)

cml:Dataset a owl:Class ;
    rdfs:label "Dataset" .

cml:DataFile a owl:Class ;
    rdfs:label "Data File" .

cml:Method a owl:Class ;
    rdfs:label "Method" .

cml:Provenance a owl:Class ;
    rdfs:label "Provenance" .

cml:License a owl:Class ;
    rdfs:label "License" .

### Agents

cml:Agent a owl:Class ;
    rdfs:label "Agent" .

cml:Person a owl:Class ;
    rdfs:subClassOf cml:Agent ;
    rdfs:label "Person" .

cml:Organization a owl:Class ;
    rdfs:subClassOf cml:Agent ;
    rdfs:label "Organization" .

#################################################################
# Object Properties (Predicates)
#################################################################

### Taxonomy relationships

cml:hasScientificName a owl:ObjectProperty ;
    rdfs:domain cml:TaxonConcept ;
    rdfs:range cml:ScientificName ;
    rdfs:label "has scientific name" .

cml:hasRank a owl:ObjectProperty ;
    rdfs:domain cml:TaxonConcept ;
    rdfs:range cml:TaxonomicRank ;
    rdfs:label "has rank" .

cml:parentTaxon a owl:ObjectProperty ;
    rdfs:domain cml:TaxonConcept ;
    rdfs:range cml:TaxonConcept ;
    rdfs:label "parent taxon" .

cml:accordingTo a owl:ObjectProperty ;
    rdfs:domain cml:TaxonConcept ;
    rdfs:range cml:Organization ;
    rdfs:label "according to source" .

### Occurrence relationships

cml:observedTaxon a owl:ObjectProperty ;
    rdfs:domain cml:Occurrence ;
    rdfs:range cml:TaxonConcept ;
    rdfs:label "observed taxon" .

cml:observedAt a owl:ObjectProperty ;
    rdfs:domain cml:Occurrence ;
    rdfs:range cml:Location ;
    rdfs:label "observed at location" .

cml:observedOn a owl:ObjectProperty ;
    rdfs:domain cml:Occurrence ;
    rdfs:range cml:Event ;
    rdfs:label "observed on event" .

cml:recordedBy a owl:ObjectProperty ;
    rdfs:domain cml:Occurrence ;
    rdfs:range cml:Person ;
    rdfs:label "recorded by" .

### Ecology relationships

cml:hasHabitat a owl:ObjectProperty ;
    rdfs:domain cml:TaxonConcept ;
    rdfs:range cml:Habitat ;
    rdfs:label "has habitat" .

cml:partOf a owl:ObjectProperty ;
    rdfs:domain cml:Habitat ;
    rdfs:range cml:Biome ;
    rdfs:label "part of biome" .

cml:hasEnvironmentalCondition a owl:ObjectProperty ;
    rdfs:domain cml:Occurrence ;
    rdfs:range cml:EnvironmentalCondition ;
    rdfs:label "has environmental condition" .

### Dataset & provenance relationships

cml:describes a owl:ObjectProperty ;
    rdfs:domain cml:Dataset ;
    rdfs:range cml:TaxonConcept ;
    rdfs:label "describes taxon" .

cml:hasOccurrence a owl:ObjectProperty ;
    rdfs:domain cml:Dataset ;
    rdfs:range cml:Occurrence ;
    rdfs:label "has occurrence" .

cml:generatedBy a owl:ObjectProperty ;
    rdfs:domain cml:Dataset ;
    rdfs:range cml:Method ;
    rdfs:label "generated by method" .

cml:providedBy a owl:ObjectProperty ;
    rdfs:domain cml:Dataset ;
    rdfs:range cml:Organization ;
    rdfs:label "provided by" .

cml:hasLicense a owl:ObjectProperty ;
    rdfs:domain cml:Dataset ;
    rdfs:range cml:License ;
    rdfs:label "has license" .

cml:derivedFrom a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range cml:Dataset ;
    rdfs:label "derived from dataset" .

cml:assertedBy a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range cml:Agent ;
    rdfs:label "asserted by agent" .

#################################################################
# Basic Datatype Properties
#################################################################

cml:name a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

cml:description a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "description" .

cml:identifier a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:label "identifier" .

cml:date a owl:DatatypeProperty ;
    rdfs:domain cml:Event ;
    rdfs:range xsd:date ;
    rdfs:label "event date" .
