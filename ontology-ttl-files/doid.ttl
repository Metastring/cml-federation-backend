obo:DOID_1209 a owl:Class ;
    rdfs:label "nutritional optic neuropathy"@en ;
    obo:IAO_0000115 "An optic neuritis that is characterized by nutritional deficiency causing optic nerve dysfunction, has_symptom painless bilateral progressive decrease in visual acuity and color perception, and has_material_basis_in nuritional deficits, especially of folate and vitamin B, which can be associated with restrictive diets and alcohol abuse."@en ;
