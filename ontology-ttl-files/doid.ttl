    rdfs:label "obsolete intestinal capillariasis"@en ;
    obo:IAO_0000115 "A capillariasis that involves infection of the intestine with Capillaria causing abdominal pain, weight loss, stomach growling, depressed levels of potassium and albumin in the blood, and diarrhea."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050230" ;
