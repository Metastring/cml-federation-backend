obo:DOID_13278 a owl:Class ;
    rdfs:label "obsolete Salmonella pneumonia"@en ;
    obo:IAO_0000115 "A Salmonella infectious disease that is caused by Gram-negative bacteria of genus Salmonella which is rare in adults, although more common in children in the tropics. This infection is complicated by suppuration with lung abscess or empyema formation."@en ;
    oboInOwl:hasExactSynonym "Salmonella pneumonia (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
