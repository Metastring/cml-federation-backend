obo:DOID_0050125 a owl:Class ;
    rdfs:label "dengue shock syndrome"@en ;
    obo:IAO_0000115 "A dengue disease that involves the most severe form of dengue fever, has_material_basis_in Dengue virus (Orthoflavivirus denguei), which are transmitted_by Aedes mosquito bite. The infection has_symptom easy bruising, has_symptom blood spots, has_symptom bleeding gums, and has_symptom nosebleeds. It is accompanied by circulatory collapse, involves hypotension, narrow pulse pressure (less than or equal to 20mm Hg), or frank shock. The shock occurs after two to six days of symptoms, followed by collapse, weak pulse, and blueness around the mouth."@en ;
    oboInOwl:hasExactSynonym "DSS"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050125" ;
