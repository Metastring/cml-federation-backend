obo:DOID_0081323 a owl:Class ;
    rdfs:label "breast implant illness"@en ;
    obo:IAO_0000115 "A syndrome that is characterized by fatigue, problems with memory or concentration, joint and muscle pain, hair loss, weight changes and anxiety/depression."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
