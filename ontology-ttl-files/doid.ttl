    rdfs:label "Smith-McCort dysplasia 1"@en ;
    obo:IAO_0000115 "A Smith-McCort dysplasia that is characterized by short limbs and a short trunk with a barrel-shaped chest and has_material_basis_in homozygous or compound heterozygous mutation in the DYM gene (607461) on chromosome 18q21."@en ;
