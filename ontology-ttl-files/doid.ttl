obo:DOID_0081326 a owl:Class ;
    rdfs:label "oxoglutarate dehydrogenase deficiency"@en ;
    obo:IAO_0000115 "An amino acid metabolic disorder that is characterized by infantile and pediatric onset basal ganglia-associated movement disorders, hypotonia, developmental delays, ataxia, and seizures and that has_material_basis_in homozygous mutation in the oxoglutarate dehydrogenase gene (OGDH) on chromosome 7p13."@en ;
