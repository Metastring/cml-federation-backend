[] a owl:Axiom ;
    dc:type obo:ECO_0007645 ;
    oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/37943617/" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:DOID_0070812 ;
    owl:annotatedTarget "A syndrome characterized by early infantile onset of hypotonia, feeding difficulties, poor overall growth, dysmorphic facies, profound developmental delay, and recurrent upper and lower respiratory infections associated with agammaglobulinemia that has_material_basis_in homozygous mutation in the SEL1L gene on chromosome 14q31."@en .

