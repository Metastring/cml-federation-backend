obo:DOID_0081319 a owl:Class ;
    rdfs:label "multiple synostoses syndrome 3"@en ;
    obo:IAO_0000115 "A multiple synostoses syndrome that is characterized by multiple joint fusions, usually commencing in the hands, conductive deafness, and characteristic facial features, including a broad, tubular-shaped nose and a thin upper vermilion and that has_material_basis_in heterozygous mutation in the FGF9 gene on chromosome 13q12."@en ;
    oboInOwl:hasDbXref "MIM:612961" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
