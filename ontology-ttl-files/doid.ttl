obo:DOID_0050172 a owl:Class ;
    rdfs:label "obsolete trivittatus encephalitis"@en ;
    obo:IAO_0000115 "A California virus encephalitis that results_in inflammation located_in brain, has_material_basis_in Trivittatus virus, which is transmitted_by Ochlerotatus trivittatus mosquito. The infection has_symptom headache, has_symptom fever, has_symptom disorientation, has_symptom tremors, has_symptom convulsions, has_symptom paralysis, and has_symptom coma."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
