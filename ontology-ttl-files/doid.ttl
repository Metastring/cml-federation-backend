obo:DOID_0050150 a owl:Class ;
    rdfs:label "Pontiac fever"@en ;
    obo:IAO_0000115 "A legionellosis that involves a milder respiratory illness without pneumonia. Symptoms include fever, headache and muscle aches which last for 2 to 5 days."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
