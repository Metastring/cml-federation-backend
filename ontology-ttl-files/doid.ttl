obo:DOID_0060342 a owl:Class ;
    rdfs:label "acromelic frontonasal dysostosis"@en ;
    obo:IAO_0000115 "A dysostosis characterized by cranium bifidum, severe hypertelorism, median cleft lip and palate, nasal bifurcation, brachycephaly, large fontanelle, tibial hemimelia, preaxial polydactyly of the feet and brain malformations and that has_material_basis_in heterozygous mutation in the ZSWIM6 gene on chromosome 5q12."@en ;
