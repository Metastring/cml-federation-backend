obo:DOID_0080208 a owl:Class ;
    rdfs:label "metabolic dysfunction-associated steatotic liver disease"@en ;
    obo:IAO_0000115 "A steatotic liver disease characterized by at least one of five specified cardiometabolic risk factors and no other discernible cause with normal to no alcohol use. The five cardiometabolic risk factors are: (1) higher than normal body mass index or waist circumference; (2) higher than normal serum glucose or glycated hemoglobin level, or type 2 diabetes; (3) higher than normal blood pressure or hypertensive treatment; (4) higher than normal plasma triglycerides or lipid lowering treatment; and (5) lower than normal plasma high-density lipoprotein cholesterol."@en ;
    oboInOwl:hasAlternativeId "DOID:0080546" ;
    oboInOwl:hasDbXref "MESH:D065626",
