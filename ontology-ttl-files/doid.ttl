obo:DOID_0060136 a owl:Class ;
    rdfs:label "associative agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to recognize visual scenes or classes of objects but retain the ability to describe them."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060136" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060137 a owl:Class ;
    rdfs:label "auditory agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to distinguishing environmental and non-verbal auditory cues including difficulty distinguishing speech from non-speech sounds even though hearing is usually normal."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060137" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060138 a owl:Class ;
    rdfs:label "autotopagnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to orient parts of the body."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060138" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060139 a owl:Class ;
    rdfs:label "color agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to recognize a color, while being able to perceive or distinguish it."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060139" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060140 a owl:Class ;
    rdfs:label "cortical deafness"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to perceive any auditory information but whose hearing is intact."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060140" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060142 a owl:Class ;
    rdfs:label "form agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to perceive a whole object while perceiving only parts of details."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060142" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060143 a owl:Class ;
    rdfs:label "integrative agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to integrate these elements together into comprehensible perceptual wholes while recognizing elements of the whole."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060143" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060144 a owl:Class ;
    rdfs:label "mirror agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to acknowledge objects in the neglected field that are visible when a mirror reflects the object visible in the non-neglected field."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060144" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060146 a owl:Class ;
    rdfs:label "phonagnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to recognize familiar voices."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060146" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060147 a owl:Class ;
    rdfs:label "semantic agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to visually recognise an object while maintaining the use of non-visual sensory systems such as feeling, tapping, smelling, rocking or flicking the object to recognise the object."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060147" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060148 a owl:Class ;
    rdfs:label "simultanagnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to recognize a whole image or scene while retianing the ability to recognize objects or details in their visual field one at a time."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasDbXref "GARD:11943" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060148" ;
    oboInOwl:inSubset doid:DO_rare_slim ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060149 a owl:Class ;
    rdfs:label "social emotional agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to perceive facial expression, body language and intonation, rendering them unable to non-verbally perceive people's emotions and limiting that aspect of social interaction."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasExactSynonym "expressive agnosia"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060149" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060150 a owl:Class ;
    rdfs:label "astereognosia"@en ;
    obo:IAO_0000115 "An agnosia that is the loss of the ability to recognize objects by touch based on its texture, size and weight."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasExactSynonym "somatosensory agnosia"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060150" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060151 a owl:Class ;
    rdfs:label "tactile agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to recognize or identify objects by touch alone."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060151" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060152 a owl:Class ;
    rdfs:label "time agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to comprehend the succession and duration of events."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060152" ;
    rdfs:subClassOf obo:DOID_4090 .

obo:DOID_0060153 a owl:Class ;
    rdfs:label "topographical agnosia"@en ;
    obo:IAO_0000115 "An agnosia that is a loss of the ability to rely on visual cues to guide them directionally due to the inability to recognise objects."@en ;
    oboInOwl:creation_date "2011-08-22T12:04:56Z" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060153" ;
