obo:DOID_14360 a owl:Class ;
    rdfs:label "obsolete Opisthorchis viverrini infectious disease"@en ;
    obo:IAO_0000115 "A opisthorchiasis that involves parasitic infection of the liver, biliary ducts, pancreas and pancreatic ducts by Opisthorchis viverrini. The symptoms include dyspepsia, abdominal pain, diarrhea, constipation, hepatomegaly, cholangitis, cholecystitis, and chlolangiocarcinoma."@en ;
    oboInOwl:hasExactSynonym "Infection by Opisthorchis viverrini (disorder)"@en,
