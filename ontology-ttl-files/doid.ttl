obo:DOID_0050009 a owl:Class ;
    rdfs:label "obsolete intestinal strongyloidiasis"@en ;
    obo:IAO_0000115 "A strongyloidiasis that involves infection of intestine with Strongyloides stercoralis, which results in abdominal pain, diarrhea, ileus, massive gastrointestinal bleeding, severe malabsorption, and peritonitis."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050009" ;
    owl:deprecated true .

obo:DOID_0050010 a owl:Class ;
    rdfs:label "obsolete Mansonella perstans infectious disease"@en ;
    obo:IAO_0000115 "A mansonelliasis that involves parasitic infection by the nematode Mansonella perstans, which resides in body cavities and the surrounding tissues causing angioedema, pruritus, fever, headaches, arthralgias, and neurologic manifestations. Midges transmit the disease."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050010" ;
    owl:deprecated true .

obo:DOID_0050011 a owl:Class ;
    rdfs:label "obsolete Mansonella streptocerca infectious disease"@en ;
    obo:IAO_0000115 "A mansonelliasis that involves parasitic infection by the nematode Mansonella streptocerca, which resides in the dermis and subcutaneous tissue causing pruritus, papular eruptions and pigmentation changes. Midges transmit the disease."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050011" ;
    oboInOwl:inSubset doid:zoonotic_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050012 a owl:Class ;
    rdfs:label "chikungunya"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in infection located_in joint, has_material_basis_in Chikungunya virus (Alphavirus chikungunya), which is transmitted_by Aedes mosquito bite. The infection has_symptom fever, has_symptom arthralgia, and has_symptom maculopapular rash."@en ;
    oboInOwl:hasDbXref "GARD:6038" ;
    oboInOwl:hasExactSynonym "Chikungunya fever"@en ;
