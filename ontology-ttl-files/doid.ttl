obo:DOID_13309 a owl:Class ;
    rdfs:label "obsolete nasopharyngeal diphtheria"@en ;
    obo:IAO_0000115 "A diphtheria that involves membrane formation from the faucial tonsil areas over the pharyngeal wall and into the nasopharynx. Severe disease may cause marked edema of the submandibular areas and the anterior neck along with lymphadenopathy, giving a characteristic bullneck apprearance."@en ;
    oboInOwl:hasExactSynonym "Nasopharyngeal Diphtheria"@en,
        "Nasopharyngeal diphtheria (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
