obo:DOID_13257 a owl:Class ;
    rdfs:label "obsolete Histoplasma duboisii endocarditis"@en ;
    obo:IAO_0000115 "An African histoplasmosis that results_in inflammation located_in endocardium, has_material_basis_in Histoplasma capsulatum var duboisii, transmitted_by airborne spores and has_symptom murmurs, has_symptom peripheral edema, has_symptom pulmonary rales, has_symptom petechia and has_symptom skin lesions."@en ;
