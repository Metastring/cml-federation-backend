    oboInOwl:inSubset doid:DO_rare_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_9562 .

obo:DOID_0050145 a owl:Class ;
    rdfs:label "adenoiditis"@en ;
    obo:IAO_0000115 "An upper respiratory tract disease which involves inflammation, pain, and swelling of the adenoid tissue due to the infection by bacteria and viruses. It occurs primarily in children and may be secondary to an allergy, infection of nose or throat and an obstruction of the eustachian tube. The infection has symptom pain, has symptom redness, has symptom swelling, and has symptom difficulty swallowing."@en ;
    oboInOwl:hasAlternativeId "DOID:13750" ;
    oboInOwl:hasDbXref "ICD10CM:J35.02",
        "ICD9CM:474.01",
        "SNOMEDCT_US_2025_09_01:195794009",
        "UMLS_CUI:C0396023" ;
    oboInOwl:hasExactSynonym "chronic adenoiditis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
