    rdfs:label "O'nyong-nyong fever"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in infection located_in joint, has_material_basis_in Onyong-nyong virus (Alphavirus onyong), which is transmitted_by Anopheles gambiae, and transmitted_by Anopheles funestus mosquitoes. The infection has_symptom fever, has_symptom arthralgia, has_symptom rash, and has_symptom lymphadenitis."@en ;
