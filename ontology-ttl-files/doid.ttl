obo:DOID_0050450 a owl:Class ;
    rdfs:label "Gitelman syndrome"@en ;
    obo:IAO_0000115 "A renal tubular transport disease that is has_material_basis_in mutations in genes that produce proteins involved in the kidneys' reabsorption of salt (sodium chloride or NaCl) from urine back into the bloodstream, thus impairing the kidneys' ability to reabsorb salt, leading to the loss of excess salt in the urine (salt wasting)."@en ;
