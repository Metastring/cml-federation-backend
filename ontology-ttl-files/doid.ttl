obo:DOID_0081328 a owl:Class ;
    rdfs:label "familial hyperinsulinemic hypoglycemia 8"@en ;
    obo:IAO_0000115 "A hyperinsulinemic hypoglycemia characterized by protein-related hypoglycemia and persistent mild hyperammonemia and that has_material_basis_in homozygous mutation in the SLC25A36 gene on chromosome 3q23."@en ;
    oboInOwl:hasDbXref "MIM:620211" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
