obo:DOID_10508 a owl:Class ;
    rdfs:label "obsolete Bacillus anthracis pneumonia"@en ;
    obo:IAO_0000115 "A primary Bacillaceae infectious disease involving Bacillus anthracis infection resulting in pulmonary infiltrates and necrosis."@en ;
    oboInOwl:hasExactSynonym "Anthrax pneumonia (disorder)"@en,
        "Pneumonia in anthrax"@en,
        "Woolsorters' pneumonia"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
