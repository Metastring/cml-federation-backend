            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:NCBITaxon_3052464 ],
        obo:DOID_12205 .

obo:DOID_0050144 a owl:Class ;
    rdfs:label "Kartagener syndrome"@en ;
    obo:IAO_0000115 "A primary ciliary dyskinesia that is characterized by sinusitis, bronchiectasis and situs inversus with dextrocardia resulting from dysfunction of the cilia during embryologic development."@en ;
    oboInOwl:hasDbXref "GARD:6815",
        "MESH:D007619",
        "NCI:C84797",
        "ORDO:98861",
        "SNOMEDCT_US_2021_09_01:42402006" ;
    oboInOwl:hasExactSynonym "Kartagener's syndrome"@en ;
