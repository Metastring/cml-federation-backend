    oboInOwl:hasDbXref "url:http://ghr.nlm.nih.gov/condition/hennekam-syndrome",
        "url:https://en.wikipedia.org/wiki/Hennekam_syndrome",
        "url:https://www.ncbi.nlm.nih.gov/pubmed/14564208",
        "url:https://www.ncbi.nlm.nih.gov/pubmed/24870712",
        "url:https://www.ncbi.nlm.nih.gov/pubmed/2624276" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:DOID_0060366 ;
    owl:annotatedTarget "A lymphatic system disease characterized by he presence of intestinal lymphangiectasia, mental retardation, and characteristic facial anomalies. It is inherited in an autosomal recessive pattern. Most individuals with Hennekam syndrome have characteristic facial abnormalities, such as a flat face with accompanying puffy eyelids and hypertelorism; the nasal bridge is typically flat and the ears are typically small. Congenital extremity and genital lymphedema is present in most patients."@en .

