obo:DOID_0081325 a owl:Class ;
    rdfs:label "developmental and epileptic encephalopathy 94"@en ;
    obo:IAO_0000115 "A developmental and epileptic encephalopathy characterized by onset of multiple seizure types in the first few years of life and associated with poor prognosis and that has_material_basis_in heterozygous mutation in the CHD2 gene on chromosome 15q26."@en ;
    oboInOwl:hasDbXref "MIM:615369" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
