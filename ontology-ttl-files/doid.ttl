obo:DOID_0060225 a owl:Class ;
    rdfs:label "3MC syndrome"@en ;
    obo:IAO_0000115 "A syndrome characterized by blepharophimosis, blepharoptosis, highly arched eyebrows hypertelorism, cleft lip and palate, postnatal growth deficiency, cognitive impairment, hearing loss and, in a smaller percentage of cases, craniosynostosis, radioulnar synostosis and genital and vesicorenal anomalies. It encompasses four disorders that were previously designated the Malpuech, Michels, Mingarelli and Carnevale syndromes."@en ;
    oboInOwl:creation_date "2015-01-16T15:08:40Z" ;
