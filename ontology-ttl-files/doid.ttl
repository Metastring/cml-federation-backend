obo:DOID_0050250 a owl:Class ;
    rdfs:label "philophthalmiasis"@en ;
    obo:IAO_0000115 "A parasitic helminthiasis infectious disease that involves parasitic infection of the eyes by Philophthalmus species. External ocular philophthalmiasis manifests as follicular conjunctivitis and superficial keratitis. Sub-conjunctival ocular philophthalmiasis consists of a mild edema with minimal cellular reaction."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
