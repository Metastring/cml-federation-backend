obo:DOID_12210 a owl:Class ;
    rdfs:label "obsolete Wuchereria bancrofti filariasis"@en ;
    obo:IAO_0000115 "A filarial elephantiasis that involves parasitic infection of the lymphatic system by a filarial worm Wuchereria bancrofti, which is transmitted by mosquitoes. The symptoms include lymphedema, fever, chills, skin infections, painful lymph nodes, orchitis and epididymitis."@en ;
    oboInOwl:hasExactSynonym "Bancroftian filariasis"@en,
        "Infection by Wuchereria bancrofti (disorder)"@en,
        "Infection due to Wuchereria bancrofti"@en,
        "Wuchereria bancrofti infectious disease"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:12210" ;
    owl:deprecated true .

obo:DOID_12211 a owl:Class ;
    rdfs:label "filarial elephantiasis"@en ;
    obo:IAO_0000115 "A filariasis that is characterized by the thickening of the skin and underlying tissues, especially in the legs, male genitals and female breasts, caused by thread-like parasitic worms Wuchereria bancrofti, Brugia malayi or Brugia timori, which inhabit the lymphatics. These nematodes are transmitted by mosquitoes. Acute symptoms include fever, lymphadenitis, lymphangitis, funiculitis, and epididymitis. Chronic symptoms include abscesses, hyperkeratosis, polyarthritis, hydroceles, lymphedema, and elephantiasis."@en ;
    oboInOwl:hasAlternativeId "DOID:13433" ;
    oboInOwl:hasDbXref "MESH:D004605",
