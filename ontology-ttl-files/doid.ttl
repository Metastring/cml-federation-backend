[] a owl:Axiom ;
    dc:type obo:ECO_0007645 ;
    oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/40683276/" ;
    owl:annotatedProperty obo:IAO_0000115 ;
    owl:annotatedSource obo:DOID_0070798 ;
    owl:annotatedTarget "A motor neuron disease characterized by acute onset of progressive muscle weakness and axonal sensorimotor neuropathy following an infection or febrile episode in infancy or early childhood that has_material_basis_in homozygous or compound heterozygous mutation in the RCC1 gene on chromosome 1p35. Affected individuals may have progressive cerebral and cerebellar atrophy and may have recurrent episodes resulting in loss of ambulation, long-term ventilatory support, or early death."@en .

[] a owl:Axiom ;
