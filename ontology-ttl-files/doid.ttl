obo:DOID_0081321 a owl:Class ;
    rdfs:label "contractures, pterygia, and spondylocarpotarsal fusion syndrome 1A"@en ;
    obo:IAO_0000115 "A contractures, pterygia, and spondylocarpotarsal fusion syndrome that is characterized by contractures of proximal and distal joints, pterygia involving the neck, axillae, elbows, and/or knees, as well as variable vertebral, carpal, and tarsal fusions and short stature and that has material_basis_in heterozygous mutation in the MYH3 gene on chromosome 17p13."@en ;
    oboInOwl:hasDbXref "MIM:178110",
        "ORDO:65743" ;
    oboInOwl:hasExactSynonym "Autosomal dominant multiple pterygium syndrome"@en ;
