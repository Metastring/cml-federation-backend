obo:DOID_0050269 a owl:Class ;
    rdfs:label "Trichomonas vaginalis trichomoniasis"@en ;
    obo:IAO_0000115 "A trichomoniasis that involves infection of the urogenital tract, has_material_basis_in Trichomonas vaginalis, which is transmitted through sexual contact. Symptoms include inflammation of the cervix, urethra and vagina which produce an itching or burning sensation, and yellow-green, itchy, frothy foul-smelling vaginal discharge."@en ;
