    oboInOwl:inSubset doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_3458 .

obo:DOID_0081064 a owl:Class ;
    rdfs:label "BN2 diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma that is categorized as BN2 with high probability by the LymphGen algorithm. This is based on a combination of genetic features and BN2 DLBCLs often, but do not always, have a translocation involving the BCL6 locus and/or some combination of mutations affecting NOTCH2, TNFAIP3, BCL10 and UBE2A. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting CD70, which can be coding or non-coding."@en ;
    oboInOwl:hasDbXref "NCI:C148395" ;
    oboInOwl:hasExactSynonym "BN2 DLBCL"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081064" ;
    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081066 a owl:Class ;
    rdfs:label "MCD diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma that is categorized as MCD with high probability by the LymphGen algorithm. This is based on a combination of genetic features and MCD DLBCLs often, but do not always, have the most common hot spot mutation in MYD88 (L265P) and/or activating mutations in CD79B. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting PIM1 and/or ETV6, which can be coding or non-coding."@en ;
    oboInOwl:hasDbXref "NCI:C148394" ;
    oboInOwl:hasExactSynonym "MCD DLBCL"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081066" ;
    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081067 a owl:Class ;
    rdfs:label "N1 diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma that is categorized as N1 with high probability by the LymphGen algorithm. This is based on a combination of genetic features. Although N1 DLBCLs always have an activating mutation affecting NOTCH1, LymphGen can assign cases with this mutation to other classes, depending on the presence of other genetic features."@en ;
    oboInOwl:hasDbXref "NCI:C148396" ;
    oboInOwl:hasExactSynonym "N1 DLBCL"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081067" ;
    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081068 a owl:Class ;
    rdfs:label "ST2 diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma that is categorized as ST2 with high probability by the LymphGen algorithm. This is based on a combination of genetic features and ST2 DLBCLs often, but do not always, have missense or nonsense mutations affecting TET2 and NFKBIA. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting some combination of SGK1, ZFP36L1, SOCS1, HIST1H1E and CD83, which can be coding or non-coding."@en ;
    oboInOwl:hasExactSynonym "ST2 DLBCL"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081068" ;
    oboInOwl:inSubset doid:DO_cancer_slim ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081069 a owl:Class ;
    rdfs:label "A53 diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma that is characterized by aneuploidy with TP53 inactivation."@en ;
    oboInOwl:hasExactSynonym "A53 DLBCL"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081069" ;
    oboInOwl:inSubset doid:DO_cancer_slim ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081070 a owl:Class ;
    rdfs:label "EZB-MYC+ diffuse large B-cell lymphoma"@en ;
    obo:IAO_0000115 "An EZB diffuse large B-cell lymphoma that expresses the double hit gene expression signature (DHITsig+) according to gene expression profiling. In addition to the features characteristic of EZB, these cases commonly, but do not always, harbour MYC translocations and DDX3X mutations."@en ;
