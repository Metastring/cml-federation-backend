obo:DOID_0050148 a owl:Class ;
    rdfs:label "laryngotracheitis"@en ;
    obo:IAO_0000115 "An upper respiratory tract disease involving inflammation of both larynx and trachea often caused by viral infection. The infection can close off the windpipe."@en ;
    oboInOwl:hasAlternativeId "DOID:11795",
        "DOID:9390" ;
    oboInOwl:hasDbXref "ICD10CM:J04",
