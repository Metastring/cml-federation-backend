    rdfs:label "obsolete West Nile virus neurological syndrome"@en ;
    obo:IAO_0000115 "A West Nile virus infectious disease that has_material_basis_in West Nile virus, which can cause meningitis, encephalitis, acute laccid paralysis, Parkingsonian-like conditions or movement disorder."@en ;
    oboInOwl:hasExactSynonym "WNND"@en,
        "WNNS"@en,
        "West nile neuroinvasive disease"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050119" ;
    oboInOwl:inSubset doid:zoonotic_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050126 a owl:Class ;
    rdfs:label "obsolete Tahyna virus encephalitis"@en ;
    obo:IAO_0000115 "A California virus encephalitis that results_in inflammation located_in brain, has_material_basis_in Tahyna virus, which is transmitted_by Aedes, transmitted_by Culex, and transmitted_by Ochlerotatus mosquitoes. The infection has_symptom headache, has_symptom fever, has_symptom anorexia, and has_symptom seizures."@en ;
    oboInOwl:hasExactSynonym "valtice fever"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:hasRelatedSynonym "Tahyna virus infection"@en ;
    oboInOwl:id "DOID:0050126" ;
    oboInOwl:inSubset doid:zoonotic_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050130 a owl:Class ;
    rdfs:label "osmotic diarrhea"@en ;
    obo:IAO_0000115 "A dirrhea that occurs when too much water is drawn into the bowels. This can be the result of maldigestion (e.g., pancreatic disease or Coeliac disease), in which the nutrients are left in the lumen to pull in water. Osmotic diarrhea can also be caused by osmotic laxatives (which work to alleviate constipation by drawing water into the bowels). In healthy individuals, too much magnesium or vitamin C or undigested lactose can produce osmotic diarrhea and distention of the bowel. A person who does not have lactose intolerance can have difficulty absorbing lactose after an extraordinarily high intake of dairy products."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050130" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0019180 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0000570 ],
        obo:DOID_13250 .

obo:DOID_0050131 a owl:Class ;
    rdfs:label "motility-related diarrhea"@en ;
    obo:IAO_0000115 "A diarrhea which is caused by the rapid movement of food through the intestines (hypermotility). If the food moves too quickly through the GI tract, there is not enough time for sufficient nutrients and water to be absorbed."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050131" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0000570 ],
        obo:DOID_13250 .

obo:DOID_0050132 a owl:Class ;
    rdfs:label "inflammatory diarrhea"@en ;
    obo:IAO_0000115 "A gastrointestinal system infectious disease involving diarrhea that occurs when there is damage to the mucosal lining or brush border, which leads to a passive loss of protein-rich fluids, and a decreased ability to absorb these lost fluids. It can be caused by bacterial infections, viral infections, parasitic infections, or autoimmune problems such as inflammatory bowel diseases. It can also be caused by tuberculosis, colon cancer, and enteritis."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050132" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0000570 ],
        obo:DOID_13250 .

obo:DOID_0050138 a owl:Class ;
    rdfs:label "podoconiosis"@en ;
    obo:IAO_0000115 "An elephantiasis that is characterized by lymphadema located_in the lower extremities caused by a genetically determined abnormal inflammatory reaction to mineral particles in irritant red clay soils derived from volcanic deposits."@en ;
    oboInOwl:hasDbXref "MESH:D004604" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050138" ;
    rdfs:subClassOf obo:DOID_4976 .

obo:DOID_0050139 a owl:Class ;
    rdfs:label "obsolete Opisthorchis felineus infectious disease"@en ;
    obo:IAO_0000115 "A opisthorchiasis that involves parasitic infection of the liver, biliary ducts, pancreas and pancreatic ducts by Opisthorchis felineus. The symptoms include fever, general malaise, skin rash, gastrointestinal disturbances, severe anemia and liver damage."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050139" ;
    owl:deprecated true .

obo:DOID_0050140 a owl:Class ;
    rdfs:label "acute diarrhea"@en ;
    obo:IAO_0000115 "A diarrhea that is of rapid onset and course characterized by frequent loose or liquid bowel movements. Acute diarrhea is a common cause of death in developing countries and the second most common cause of infant deaths worldwide."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050140" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0000570 ],
        obo:DOID_13250 .

obo:DOID_0050141 a owl:Class ;
    rdfs:label "intestinal botulism"@en ;
    obo:IAO_0000115 "A botulism that involves intoxication caused by botulinum neurotoxins (BoNTA, B, E and F) in adults, has_material_basis_in Clostridium botulinum A, has_material_basis_in Clostridium botulinum B, has_material_basis_in Clostridium botulinum E and has_material_basis_in Clostridium botulinum F, which are transmitted by ingestion of bacterial spores, which then grow in the intestine and release toxins."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050141" ;
    oboInOwl:inSubset doid:DO_infectious_disease_slim ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002451 ;
            owl:someValuesFrom obo:TRANS_0000012 ],
        obo:DOID_11976 .

obo:DOID_0050143 a owl:Class ;
    rdfs:label "asymptomatic dengue"@en ;
    obo:IAO_0000115 "A dengue disease that results_in infection, has_material_basis_in Dengue virus (Orthoflavivirus denguei), which are transmitted_by Aedes mosquito bite. The infection has no manifestations of symptoms."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050143" ;
