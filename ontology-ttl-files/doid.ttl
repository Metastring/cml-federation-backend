obo:DOID_13307 a owl:Class ;
    rdfs:label "obsolete pseudomembranous diphtheritic conjunctivitis"@en ;
    obo:IAO_0000115 "A pseudomembranous conjunctivitis characterized by swollen and reddened, hot and painful lids. The Corynebacterium diphtheriae bacilli produce profuse exudation which has a tendency to coagulate on the surface of the conjunctiva to form a grayish-white membrane."@en ;
    oboInOwl:hasExactSynonym "Conjunctival diphtheria"@en,
        "Conjunctival diphtheria (disorder)"@en,
        "Pseudomembranous Diphtheritic Conjunctivitis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:13307" ;
    owl:deprecated true .

obo:DOID_13308 a owl:Class ;
    rdfs:label "obsolete diphtheritic myocarditis"@en ;
    obo:IAO_0000115 "A myocarditis characterized by dilated cardiomyopathy and a variety of types of dysrhythmia and conduction disturbances. It is caused by Corynebacterium diphtheriae."@en ;
    oboInOwl:hasExactSynonym "Diphtheritic myocarditis (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
