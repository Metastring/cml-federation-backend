obo:DOID_12115 a owl:Class ;
    rdfs:label "obsolete streptococcal pharyngitis"@en ;
    obo:IAO_0000115 "A commensal streptococcal infectious disease that involves infection of the pharynx and sometimes the larynx and tonsils. It is caused by Group A Streptococcus bacteria. The common symptoms include fever, sore throat, headache, stomach ache, nausea, or chills."@en ;
    oboInOwl:hasExactSynonym "Septic sore throat due to streptococcal infection"@en,
        "Strept throat"@en,
        "Streptococcal angina"@en,
        "Streptococcal sore throat"@en,
