obo:DOID_0050151 a owl:Class ;
    rdfs:label "obsolete tracheobronchial tuberculosis"@en ;
    obo:IAO_0000115 "A pulmonary tuberculosis involving inflammation of trachea and bronchi. The symptoms include dry cough followed by dyspnea, localized wheezing, hemoptysis, hoarseness, anorexia, weight loss, chest pain and fever."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050151" ;
    oboInOwl:inSubset doid:gram-positive_bacterial_infectious_disease ;
