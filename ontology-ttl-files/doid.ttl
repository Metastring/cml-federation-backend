    obo:IAO_0000115 "A (-)ssRNA virus infectious disease that results_in infection in rodents and humans, has_material_basis_in Bunyaviridae viruses, which are transmitted_by arthropod vectors."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
