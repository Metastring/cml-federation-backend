obo:DOID_9392 a owl:Class ;
    rdfs:label "tracheitis"@en ;
    obo:IAO_0000115 "A tracheal disease which involves bacterial infection of the trachea often caused by Staphylococcus aureus and streptococci that follows a recent viral upper respiratory infection. The symptoms include barking croup cough, loud squeaking noise while breathing, scratchy feeling in the throat, high fever, and production of large amounts of pus-filled secretions."@en ;
    oboInOwl:hasAlternativeId "DOID:0050149",
