obo:DOID_0080817 a owl:Class ;
    rdfs:label "T2-high asthma"@en ;
    obo:IAO_0000115 "A chronic asthma that is characterized by the pathophysiology phenotype combination (endotype) of early-onset allergic asthma, late-onset eosinophilic asthma, and aspirin-exacerbated respiratory disease."@en ;
    oboInOwl:hasExactSynonym "type 2 high endotype"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080817" ;
    rdfs:subClassOf obo:DOID_0080809 .

obo:DOID_0080818 a owl:Class ;
    rdfs:label "T2-low asthma"@en ;
    obo:IAO_0000115 "A chronic asthma that is characterized by the pathophysiology phenotype combination (endotype) of non-atopic, smoking, obesity related, and elderly and that is characterized by neutrophilic (sputum neutrophils > 40–60%) or paucigranulocytic (i.e., normal sputum levels of both eosinophils and neutrophils) inflammation and a lack of response to corticosteroid therapy."@en ;
    oboInOwl:hasExactSynonym "type 2 low endotype"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080818" ;
    rdfs:subClassOf obo:DOID_0080809 .

obo:DOID_0080820 a owl:Class ;
    rdfs:label "occupational asthma"@en ;
    obo:IAO_0000115 "An environmental induced asthma that is characterized by a variable airflow limitation due to exposure to inhaled irritants in the workplace."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080820" ;
    rdfs:subClassOf obo:DOID_0080819 .

obo:DOID_0080821 a owl:Class ;
    rdfs:label "exercise-induced bronchoconstriction"@en ;
    obo:IAO_0000115 "An intrinsic asthma that is characterized by narrowing of the airways during or shortly after exercise."@en ;
    oboInOwl:hasExactSynonym "exercise-induced asthma"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080821" ;
    rdfs:subClassOf obo:DOID_9360 .

obo:DOID_0080822 a owl:Class ;
    rdfs:label "aspirin-induced respiratory disease"@en ;
    obo:IAO_0000115 "An intrinsic asthma that is characterized by severe and prolonged airway obstruction after the ingestion of aspirin or other non-steroidal anti-inflammatory drugs."@en ;
    oboInOwl:hasExactSynonym "aspirin-sensitive asthma"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080822" ;
