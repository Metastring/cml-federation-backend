    oboInOwl:inSubset doid:gram-negative_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_14435 a owl:Class ;
    rdfs:label "chronic tubotympanic suppurative otitis media"@en ;
    obo:IAO_0000115 "A suppurative otitis media which is an inflammatory disease of the middle ear cleft characterized by the presence of a persisting perforation within the pars tensa of the tympanic membrane, intermittent profuse muco-purulent otorrhea and gradually progressive conductive hearing loss of more than 12 weeks duration. It is caused by episodes of upper respiratory infections."@en ;
    oboInOwl:hasDbXref "ICD10CM:H66.1",
        "ICD9CM:382.1",
        "SNOMEDCT_US_2025_09_01:87665008",
