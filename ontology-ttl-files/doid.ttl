obo:DOID_0050263 a owl:Class ;
    rdfs:label "obsolete Pseudocoelomata infectious disease"@en ;
    obo:IAO_0000115 "A parasitic helminthiasis infectious disease that involves infection caused by parasitic invertebrates, which have a pseudocoel. Tissue derived from mesoderm only partly lines the fluid filled body cavity of these animals."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
