obo:DOID_10079 a owl:Class ;
    rdfs:label "cysticercosis"@en ;
    obo:IAO_0000115 "A taeniasis that results from ingestion of eggs or larvae of the Taenia solium tapeworm in undercooked pork or fecally contaminated food or water, which subsequently infect the central nervous system, heart, muscles, subcutaneous tissues, and eyes. Neurocysticercosis causes seizures, mental disturbances, focal neurologic deficits and intracerebral lesions."@en ;
