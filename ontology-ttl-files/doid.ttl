obo:DOID_14338 a owl:Class ;
    rdfs:label "obsolete Pseudomonal pneumonia"@en ;
    obo:IAO_0000115 "A Pseudomonas infectious disease that is caused by a Gram-negative bacterium Pseudomonas aeruginosa resulting in pulmonary edema. This bacterium releases immunogenic bacterial components that can gain access to airway epithelium and immune cells in the lung thus causing airway inflammation. P. aeruginosa is the common cause of hospital acquired and ventilator-associated pneumonias."@en ;
    oboInOwl:hasExactSynonym "Pneumonia due to Pseudomonas"@en,
        "Pneumonia due to Pseudomonas (disorder)"@en ;
