obo:DOID_0050180 a owl:Class ;
    rdfs:label "obsolete Colorado tick fever encephalitis"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in inflammation located_in brain, has_material_basis_in Colorado tick fever virus which is transmitted_by rocky mountain wood tick, Dermacentor andersoni. The infection has_symptom fever, has_symptom headache, has_symptom nausea, has_symptom stiff neck, has_symptom chills, has_symptom hallucinations, has_symptom disorientation, and has_symptom memory loss."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
