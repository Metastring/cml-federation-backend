obo:DOID_0050004 a owl:Class ;
    rdfs:label "seminal vesicle acute gonorrhea"@en ;
    obo:IAO_0000115 "A gonococcal seminal vesiculitis that is characterized by back pain, perineal pain, pain with ejaculation, hematospermia and voiding symptoms resulting from inflammation located_in the seminal vesicles caused by Neisseria gonorrhoeae infection."@en ;
    oboInOwl:hasDbXref "SNOMEDCT_US_2025_09_01:301990003",
