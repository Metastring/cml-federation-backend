obo:DOID_0081333 a owl:Class ;
    rdfs:label "Wiedemann-Rautenstrauch syndrome"@en ;
    obo:IAO_0000115 "A progeroid syndrome that is characterized by intrauterine growth retardation, failure to thrive, short stature, a progeroid appearance, hypotonia, and variable mental impairment and that has_material_basis_in compound heterozygous mutation in the POLR3A gene on chromosome 10q22."@en ;
    oboInOwl:hasDbXref "GARD:330",
        "MIM:264090",
        "ORDO:3455" ;
    oboInOwl:hasExactSynonym "Neonatal progeroid syndrome"@en,
