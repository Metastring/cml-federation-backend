obo:DOID_2929 a owl:Class ;
    rdfs:label "Newcastle disease"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in infection in birds and humans, has_material_basis_in Newcastle disease virus (Orthoavulavirus javaense), which is transmitted_by contact with feces and urine of an infected bird, or transmitted_by fomites. The infection has_symptom conjunctivitis, has_symptom headache, and has_symptom lacrimation in humans, and has_symptom gasping, has_symptom coughing, has_symptom twisting of head and neck, has_symptom circling, has_symptom complete paralysis, has_symptom watery diarrhea, and has_symptom reduced egg production in birds."@en ;
