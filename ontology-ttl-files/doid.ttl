obo:DOID_0060339 a owl:Class ;
    rdfs:label "chronic atrial and intestinal dysrhythmia"@en ;
    obo:IAO_0000115 "A syndrome characterized by a unique combination of cardiac arrhythmias and intestinal pseudo-obstruction. It has_material_basis_in the mutated SGOL1 protein. Distinctive clinical features include atrial dysrhythmias, sick sinus syndrome (SSS) and valve anomalies and chronic intestinal pseudo-obstruction (CIPO)."@en ;
    oboInOwl:creation_date "2015-05-18T15:37:53Z" ;
    oboInOwl:hasDbXref "MIM:616201" ;
    oboInOwl:hasExactSynonym "CAID syndrome"@en ;
