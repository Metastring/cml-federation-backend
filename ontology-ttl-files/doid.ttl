    rdfs:label "Crimean-Congo hemorrhagic fever"@en ;
    obo:IAO_0000115 "A viral infectious disease that is a hemorrhagic fever, has_material_basis_in Crimean-Congo haemorrhagic fever virus (Orthonairovirus haemorrhagiae), which is transmitted_by Hyalomma ticks. The infection has_symptom headache, has_symptom high fever, has_symptom back pain, has_symptom joint pain, has_symptom stomach pain, has_symptom vomiting, has_symptom red eyes, has_symptom flushed face, has_symptom red throat, has_symptom petechiae (red spots) on the palate, has_symptom jaundice, has_symptom nosebleeds, and has_symptom blood in the feces and urine."@en ;
