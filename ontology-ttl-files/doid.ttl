obo:DOID_13241 a owl:Class ;
    rdfs:label "Behcet's disease"@en ;
    obo:IAO_0000115 "An autoimmune disease that is characterized by mucocutaneous manifestations, including recurrent oral and genital ulcerations, ocular manifestations, especially chronic relapsing uveitis, and systemic vasculitis involving arteries and veins of all sizes."@en ;
    oboInOwl:hasDbXref "EFO:0003780",
