obo:DOID_0050231 a owl:Class ;
    rdfs:label "obsolete hepatic capillariasis"@en ;
    obo:IAO_0000115 "A capillariasis that involves infection of the liver with Capillaria, which manifests as an acute or subacute hepatitis with eosinophilia. The symptoms include abdominal pain, fever, chills, hepatitis, ascites, hepatolithiasis, and hepatomegaly."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050231" ;
