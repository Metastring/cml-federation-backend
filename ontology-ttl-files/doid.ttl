obo:DOID_13273 a owl:Class ;
    rdfs:label "obsolete Escherichia coli pneumonia"@en ;
    obo:IAO_0000115 "A commensal Escherichia coli infectious disease that is caused by Escherichia coli. The disease results from proliferation of aspirated organisms in terminal airways, usually at multiple sites in the lung. Multifocal area of consolidation result and terminal airways and alveoli are filled with proteinaceous fluid, fibrin, neutrophils, and macrophages."@en ;
    oboInOwl:hasExactSynonym "Pneumonia due to Escherichia coli (disorder)"@en,
        "Pneumonia due to escherichia coli"@en,
        "Pneumonia due to escherichia coli [E. coli]"@en,
        "pneumonia due to escherichia coli"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:13273" ;
    oboInOwl:inSubset doid:gram-negative_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_13274 a owl:Class ;
    rdfs:label "obsolete enzootic pneumonia of calves"@en ;
    obo:IAO_0000115 "A bovine respiratory disease complex which is an infectious disease in calves involving stress and possibly an initial respiratory viral infection followed by a secondary bacterial infection of the lower respiratory tract. Mycoplasmal and bacterial agents including Pasteurella multocida, Mannheimia haemolytica, and Mycoplasma bovis represent the most frequently isolated pathogenic organisms."@en ;
    oboInOwl:hasExactSynonym "Enzootic pneumonia of calves (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:13274" ;
    owl:deprecated true .

obo:DOID_13275 a owl:Class ;
    rdfs:label "obsolete rickettsial pneumonia"@en ;
    obo:IAO_0000115 "A rickettsiosis that is caused by the genus Rickettsia. This infection results in pleural effusions and pulmonary edema."@en ;
    oboInOwl:hasExactSynonym "Rickettsial pneumonia (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:13275" ;
    oboInOwl:inSubset doid:gram-negative_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_13276 a owl:Class ;
    rdfs:label "Mycoplasma pneumoniae pneumonia"@en ;
    obo:IAO_0000115 "A bacterial pneumonia that is caused by the bacterial species Mycoplasma pneumoniae. The symptoms include chest pain, chills, dry cough which is not bloody, excessive sweating, fever, headache and sore throat."@en ;
    oboInOwl:hasDbXref "ICD10CM:J15.7",
