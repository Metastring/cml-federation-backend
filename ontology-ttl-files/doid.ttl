obo:DOID_0081125 a owl:Class ;
    rdfs:label "craniofacial dysmorphism, skeletal anomalies, and impaired intellectual development syndrome 2"@en ;
    obo:IAO_0000115 "A craniofacial dysmorphism, skeletal anomalies, and mental retardation syndrome that is characterized by flat face, low-set ears, and cleft lip and palate, as well as costovertebral anomalies including bifid and fused ribs, vertebral segmentation defects, and scoliosis. Intellectual delay can be severe, with absent speech and that has_material_basis_in homozygous mutation in the RAB5IF gene on chromosome 20q11."@en ;
    oboInOwl:hasDbXref "MIM:616994" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
