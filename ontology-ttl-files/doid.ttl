obo:DOID_0060537 a owl:Class ;
    rdfs:label "mitochondrial complex II deficiency"@en ;
    obo:IAO_0000115 "A mitochondrial metabolism disease characterized by a highly variable phenotype. Some patients have multisystem involvement of the brain, heart, muscle, liver, and kidneys resulting in death in infancy, whereas others have only isolated cardiac or muscle involvement with onset in adulthood and normal cognition. It has_material_basis_in homozygous or compound heterozygous mutation in the nuclear-encoded SDHA gene on chromosome 5p, the nuclear-encoded SDHAF1 gene on chromosome 19q, or the nuclear-encoded SDHD gene on chromosome 11q23."@en ;
    oboInOwl:hasDbXref "GARD:5053",
        "ICD10CM:G71.3",
        "MESH:C565375",
        "MIM:252011",
        "ORDO:3208" ;
    oboInOwl:hasExactSynonym "isolated mitochondrial respiratory chain complex II deficiency"@en,
        "isolated succinate-CoQ reductase deficiency"@en,
        "isolated succinate-coenzyme Q reductase deficiency"@en,
        "isolated succinate-ubiquinone reductase deficiency"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060537" ;
    oboInOwl:inSubset doid:DO_rare_slim ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0004019 ;
            owl:someValuesFrom obo:SO_0001537 ],
        obo:DOID_700 .

obo:DOID_0060538 a owl:Class ;
    rdfs:label "purpura fulminans"@en ;
    obo:IAO_0000115 "A purpura characterized by blood spots, bruising and discoloration of the skin resulting from coagulation in small blood vessels within the skin and rapidly leading to skin necrosis and disseminated intravascular coagulation. It is often fatal."@en ;
    oboInOwl:hasDbXref "ICD10CM:D65",
        "MESH:D055665",
        "ORDO:49566" ;
    oboInOwl:hasExactSynonym "purpura gangrenosa"@en ;
