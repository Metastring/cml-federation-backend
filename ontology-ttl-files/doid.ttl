obo:DOID_13277 a owl:Class ;
    rdfs:label "obsolete Mycoplasma hyopneumoniae pneumonia"@en ;
    obo:IAO_0000115 "A mycoplasmal pneumonia that is a contagious infection of pigs caused my Mycoplasma hyopneumoniae resulting in lung lesions and chronic cough."@en ;
    oboInOwl:hasExactSynonym "mycoplasmal pneumonia of swine"@en ;
