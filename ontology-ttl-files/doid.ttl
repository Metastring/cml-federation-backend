obo:DOID_4367 a owl:Class ;
    rdfs:label "apparent mineralocorticoid excess syndrome"@en ;
    obo:IAO_0000115 "A steroid inherited metabolic disorder characterized by decreased conversion of biologically active cortisol to inactive cortisone resulting in low aldosterone levels, metabolic alkalosis, hypernatremia, hypokalemia and early-onset severe hypertension that has_material_basis_in homozygous or compound heterozygous mutation in the HSD11B2 gene on chromosome 16."@en ;
