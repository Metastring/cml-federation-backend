obo:DOID_11379 a owl:Class ;
    rdfs:label "gnathomiasis"@en ;
    obo:IAO_0000115 "A parasitic helminthiasis infectious disease that involves parasitic infection due to migrating immature worms of Gnathostoma spinigerum or Gnathostoma hispidum, which occurs by eating undercooked fish or poultry containing third-stage larvae, or by drinking water containing infective second-stage larvae in Cyclops. Migration in the subcutaneous tissues causes intermittent, migratory, painful, pruritic swellings (cutaneous larva migrans). Migration to other tissues (visceral larva migrans), result in cough, hematuria, and ocular involvement, with the most serious manifestations eosinophilic meningitis with myeloencephalitis."@en ;
    oboInOwl:hasDbXref "GARD:9286",
        "ICD10CM:B83.1",
        "ICD9CM:128.1",
        "MESH:D058429",
        "NCI:C128395",
