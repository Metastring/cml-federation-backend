obo:DOID_11101 a owl:Class ;
    rdfs:label "trench fever"@en ;
    obo:IAO_0000115 "A primary bacterial infectious disease that results in systemic infection, has_material_basis_in Bartonella quintana, which is transmitted by body lice (Pediculus humanus corporis). The infection has symptom relapsing fever, has symptom headache, has symptom shin pain, and has symptom soreness of the muscles of the legs and back."@en ;
    oboInOwl:hasDbXref "ICD10CM:A79.0",
