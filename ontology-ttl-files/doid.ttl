obo:DOID_0081330 a owl:Class ;
    rdfs:label "glycogen storage disease Ib"@en ;
    obo:IAO_0000115 "A glycogen storage disease I that has_material_basis_in homozygous or compound heterozygous mutation in the G6PT1 gene (SLC37A4), which encodes glucose-6-phosphate translocase, on chromosome 11q23."@en ;
    oboInOwl:hasDbXref "MIM:232220" ;
