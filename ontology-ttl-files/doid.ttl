obo:DOID_9537 a owl:Class ;
    rdfs:label "Lassa fever"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in infection, has_material_basis_in Lassa virus (Mammarenavirus lassaense), which is transmitted_by multimammate rat of the genus Mastomys. The infection has_symptom fever, has_symptom retrosternal pain, has_symptom sore throat, has_symptom back pain, has_symptom cough, has_symptom abdominal pain, has_symptom vomiting, has_symptom diarrhea, has_symptom conjunctivitis, has_symptom facial swelling, has_symptom proteinuria (protein in the urine), and has_symptom mucosal bleeding."@en ;
