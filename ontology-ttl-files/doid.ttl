obo:DOID_0060343 a owl:Class ;
    rdfs:label "glucocorticoid-induced osteoporosis"@en ;
    obo:IAO_0000115 "An osteoporosis caused by chronic glucocorticoid use. Glucocorticoids impair the replication, differentiation and function of osteoblasts and induce the apoptosis of mature osteoblasts and osteocytes; the also favor osteoclastogenesis leading to an increase in bone resorption."@en ;
    oboInOwl:creation_date "2015-05-27T17:07:43Z" ;
