obo:DOID_0080985 a owl:Class ;
    rdfs:label "syndromic X-linked intellectual disorder Lujan-Fryns-type"@en ;
    obo:IAO_0000115 "A syndromic X-linked intellectual disability that is characterized by a tall, marfanoid stature, distinct facial dysmorphism and behavioral problems and that has_material_basis_in hemizygous mutation in the MED12 gene on chromosome Xq13. Opitz-Kaveggia syndrome is an allelic disorder with an overlapping phenotype."@en ;
