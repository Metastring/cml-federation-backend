obo:DOID_10845 a owl:Class ;
    rdfs:label "St. Louis encephalitis"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in inflammation located_in brain, has_material_basis_in St. Louis encephalitis virus (Orthoflavivirus louisense), which is transmitted_by Culex mosquitoes. The infection has_symptom headache, has_symptom high fever, has_symptom neck stiffness, has_symptom stupor, has_symptom disorientation, has_symptom coma, has_symptom tremors, has_symptom convulsions and has_symptom spastic paralysis."@en ;
