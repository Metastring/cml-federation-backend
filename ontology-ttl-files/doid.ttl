obo:DOID_0050175 a owl:Class ;
    rdfs:label "tick-borne encephalitis"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in inflammation located_in brain, has_material_basis_in Tick-borne encephalitis virus (Orthoflavivirus encephalitidis), which is transmitted_by Ixodes ticks. The infection has_symptom drowsiness, has_symptom confusion, has_symptom sensory disturbances, and has_symptom paralysis."@en ;
