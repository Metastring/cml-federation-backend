obo:DOID_0050212 a owl:Class ;
    rdfs:label "obsolete Campylobacter jejuni gastroenteritis"@en ;
    obo:IAO_0000115 "A primary Campylobacter infectious disease that involves inflammation of the stomach and intestines caused by Campylobacter jejuni infection, which is characterized by diarrhea (may be bloody), abdominal pain, fever and vomiting."@en ;
