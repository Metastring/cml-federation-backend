    owl:deprecated true .

obo:DOID_0060054 a owl:Class ;
    rdfs:label "autonomic peripheral neuropathy"@en ;
    obo:IAO_0000115 "A neuropathy that affects the autonomic nervous system and is characterized by urinary incontinence, gastrointestinal dysmotility, orthostatic hypotension, apneas, sweat disturbances and impotence."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0060054" ;
