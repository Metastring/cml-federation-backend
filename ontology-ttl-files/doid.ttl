        "SNOMEDCT_US_2025_09_01:190848001",
        "UMLS_CUI:C0020807" ;
    oboInOwl:hasExactSynonym "Idiopathic pulmonary hemosiderosis"@en,
        "brown induration"@en,
        "brown lung"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:12118" ;
    oboInOwl:inSubset doid:DO_rare_slim ;
    rdfs:comment "MESH C536281 obsoleted in 2024.[LS]"@en ;
