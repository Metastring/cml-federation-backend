obo:DOID_0081334 a owl:Class ;
    rdfs:label "Nestor-Guillermo progeria syndrome"@en ;
    obo:IAO_0000115 "A progeroid syndrome that is characterized by lipoatrophy, osteoporosis, and very severe osteolysis. Patients have no cardiovascular impairment, diabetes mellitus, or hypertriglyceridemia, but suffer profound skeletal abnormalities that affect their quality of life and that has_material_basis_in homozygous mutation in the BANF1 gene on chromosome 11q13. Onset is after 2 years of age."@en ;
    oboInOwl:hasDbXref "GARD:11008",
        "MIM:614008",
        "ORDO:280576" ;
    oboInOwl:hasExactSynonym "Progeria syndrome, childhood-onset, with osteolysis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
