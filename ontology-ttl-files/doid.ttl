    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0060103 .

obo:DOID_0081316 a owl:Class ;
    rdfs:label "primary intracranial sarcoma, DICER1-mutant"@en ;
    obo:IAO_0000115 "A brain sarcoma that is composed of malignant pleomorphic or spindle neoplastic cells typically demonstrating myogenic and/or chondroid differentiation. Cytoplasmic eosinophilic globules and myxoid stroma formation are usually present. It is associated with mutations in the DICER1 gene."@en ;
    oboInOwl:hasDbXref "ICDO:9480/3",
        "NCI:C186610" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
