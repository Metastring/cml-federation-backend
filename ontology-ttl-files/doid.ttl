    rdfs:label "obsolete Pneumocystis infectious disease"@en ;
    obo:IAO_0000115 "An opportunistic mycosis that has_material_basis_in Pneumocystis jirovecii, located_in lymph node, located_in spleen, located_in liver and located_in bone marrow, results_in_formation_of lesions."@en ;
