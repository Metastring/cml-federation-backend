obo:DOID_0060366 a owl:Class ;
    rdfs:label "Hennekam syndrome"@en ;
    obo:IAO_0000115 "A lymphatic system disease characterized by he presence of intestinal lymphangiectasia, mental retardation, and characteristic facial anomalies. It is inherited in an autosomal recessive pattern. Most individuals with Hennekam syndrome have characteristic facial abnormalities, such as a flat face with accompanying puffy eyelids and hypertelorism; the nasal bridge is typically flat and the ears are typically small. Congenital extremity and genital lymphedema is present in most patients."@en ;
    oboInOwl:creation_date "2015-09-17T16:36:59Z" ;
