obo:DOID_2058 a owl:Class ;
    rdfs:label "chronic mucocutaneous candidiasis"@en ;
    obo:IAO_0000115 "A candidiasis that refers to a heterogeneous group of disorders characterized by recurrent or persistent superficial fungal infections located_in skin, located_in mucous membrane, or located_in nail due to T-cell defects, has-agent Candida species and has_symptom scaling of skin lesions, has_symptom thickening of nails, has_symptom swollen periungal tissue, and has_symptom scarring of the scalp."@en ;
