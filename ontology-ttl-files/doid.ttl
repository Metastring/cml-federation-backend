obo:DOID_10564 a owl:Class ;
    rdfs:label "obsolete gangosa of yaws"@en ;
    obo:IAO_0000115 "A late yaws that involves destruction of the bone and cartilage of the nose. This is caused by the spirochete bacterium, Treponema pallidum pertenue."@en ;
    oboInOwl:hasExactSynonym "Gangosa"@en,
        "Gangosa of yaws (disorder)"@en,
