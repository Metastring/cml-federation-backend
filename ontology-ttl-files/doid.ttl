obo:DOID_11336 a owl:Class ;
    rdfs:label "rhinoscleroma"@en ;
    obo:IAO_0000115 "A primary bacterial infectious disease that involves the inflammation of mucosa lining the nasal cavity, pharynx, larynx, trachea and bronchi that is characterized by the formation of granulomas, dense induration of the tissues and nodular deformity caused by Klebsiella rhinoscleromatis."@en ;
    oboInOwl:hasDbXref "ICD9CM:040.1",
