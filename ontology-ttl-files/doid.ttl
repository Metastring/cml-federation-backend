obo:DOID_1221 a owl:Class ;
    rdfs:label "obsolete infiltrative lung tuberculosis"@en ;
    obo:IAO_0000115 "A pulmonary tuberculosis that is characterized by filling of airspaces with fluid, inflammatory exudates (pus, proteins and immunological substances) or cells (malignant cells and red blood cells) in a region of the lung."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
