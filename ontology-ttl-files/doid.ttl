obo:DOID_0081336 a owl:Class ;
    rdfs:label "Thomsen disease"@en ;
    obo:IAO_0000115 "A myotonia congenita that is characterized by muscle stiffness and an inability of the muscle to relax after voluntary contraction and that has_material_basis_in heterozygous mutation in the gene encoding skeletal muscle chloride channel-1 (CLCN1) on chromosome 7q34."@en ;
    oboInOwl:hasDbXref "MIM:160800" ;
    oboInOwl:hasExactSynonym "Congenital myotonia, autosomal dominant form"@en,
