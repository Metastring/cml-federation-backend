obo:DOID_11680 a owl:Class ;
    rdfs:label "obsolete ocular onchocerciasis"@en ;
    obo:IAO_0000115 "A onchocerciasis that involves parasitic infection of the eye by the larvae of Onchocerca volvulus. The microfilariae migrate to the surface of the cornea. Punctate keratitis occurs in the infected area. In severe infection, sclerosing keratitis occurs, making the affected area become opaque leading to blindness."@en ;
    oboInOwl:hasExactSynonym "Ocular Onchocerciasis"@en,
        "Ocular onchocerciasis (disorder)"@en,
        "river blindness"@en ;
