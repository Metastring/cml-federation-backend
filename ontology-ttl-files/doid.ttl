obo:DOID_0060174 a owl:Class ;
    rdfs:label "GABA aminotransferase deficiency"@en ;
    obo:IAO_0000115 "A gamma-amino butyric acid metabolism disorder that is characterized by a defect in the gene coding for gamma-aminobutyrate transaminase, which is responsible for catabolism of gamma-aminobutyric acid (GABA), an important, mostly inhibitory neurotransmitter in the central nervous system, into succinic semialdehyde."@en ;
