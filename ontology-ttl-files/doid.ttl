obo:DOID_0081012 a owl:Class ;
    rdfs:label "critical COVID-19"@en ;
    obo:IAO_0000115 "A COVID-19 that is characterized by the criteria for acute respiratory distress syndrome (ARDS), sepsis, septic shock, or other conditions that would normally require the provision of life sustaining therapies such as mechanical ventilation (invasive or non-invasive) or vasopressor therapy."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081012" ;
    oboInOwl:inSubset doid:DO_infectious_disease_slim ;
    rdfs:subClassOf obo:DOID_0080600 .

obo:DOID_0081013 a owl:Class ;
    rdfs:label "severe COVID-19"@en ;
    obo:IAO_0000115 "A COVID-19 that is characterized by any of (1) Oxygen saturation < 90% on room air, (2) Respiratory rate > 30 breaths/min in adults and children > 5 years old, ≥ 60 breaths/min in children < 2 months old, ≥ 50 in children 2–11 months old, and ≥ 40 in children 1–5 years old, or (3) signs of severe respiratory distress (accessory muscle use, inability to complete full sentences, and, in children, very severe chest wall indrawing, grunting, central cyanosis, or presence of any other general danger signs."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081013" ;
    oboInOwl:inSubset doid:DO_infectious_disease_slim ;
    rdfs:subClassOf obo:DOID_0080600 .

obo:DOID_0081014 a owl:Class ;
    rdfs:label "non-severe COVID-19"@en ;
    obo:IAO_0000115 "A COVID-19 that is characterized by the absence of any criteria for severe or critical COVID-19."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081014" ;
    oboInOwl:inSubset doid:DO_infectious_disease_slim ;
    rdfs:subClassOf obo:DOID_0080600 .

