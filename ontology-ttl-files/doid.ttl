obo:DOID_0081318 a owl:Class ;
    rdfs:label "multiple synostoses syndrome 2"@en ;
    obo:IAO_0000115 "A multiple synostoses syndrome that is characterized by progressive joint fusions of the fingers, wrists, ankles, and cervical spine; characteristic facies, including a broad hemicylindrical nose; and progressive conductive hearing loss and that has_material_basis_in heterozygous mutation in the GDF5 gene on chromosome 20q11."@en ;
    oboInOwl:hasDbXref "GARD:9916",
        "MIM:610017" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
