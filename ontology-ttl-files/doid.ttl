obo:DOID_12124 a owl:Class ;
    rdfs:label "episcleritis periodica fugax"@en ;
    obo:IAO_0000115 "A scleral disease that is characterized by painful inflammation of the episcleral tissues that, importantly, spares the sclera itself and has_symptom pain, red eyes, photophobia, tearing, and blurry vision. Episcleritis periodica fugax is typically self-limited but may be related to vascular congestion within the superficial episcleral plexus and associated with autoimmune disease, connective tissue disease, malignancies, trauma, infection, and medications, especially topiramate and pamidronate."@en ;
    oboInOwl:hasDbXref "ICD10CM:H15.11",
        "ICD9CM:379.01",
        "SNOMEDCT_US_2025_09_01:194141004",
