obo:DOID_4616 a owl:Class ;
    rdfs:label "obsolete bovine atypical interstitial pneumonia"@en ;
    obo:IAO_0000115 "A bovine respiratory disease complex defined as an acute, noncontagious respiratory distress caused 5-10days after change to a better, often lush, pasture. Metabolites of the naturally occurring amino acid L-tryptophan probably are responsible for the disease. Severely affected cattle show extensive respiratory distress with mouth breathing, extension of the tongue, and drooling. There is extensive edema and emphysema, often with the formation of large air-filled bullae in interlobular and subpleural regions of the lung."@en ;
    oboInOwl:hasExactSynonym "Atypical interstitial pneumonia of cattle (disorder)"@en,
        "Fog fever"@en,
        "acute bovine pulmonary emphysema AND edema (disorder)"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:4616" ;
    owl:deprecated true .

