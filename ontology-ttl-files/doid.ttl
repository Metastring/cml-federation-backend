obo:DOID_0050061 a owl:Class ;
    rdfs:label "erysipeloid"@en ;
    obo:IAO_0000115 "A primary bacterial infectious disease that results_in infection located_in skin, has_material_basis_in Erysipelothrix rhusiopathiae, which is transmitted_by contact with infected animals. The infection has_symptom redness of skin, has_symptom tenderness of skin and has_symptom warmth of skin."@en ;
