obo:DOID_0081322 a owl:Class ;
    rdfs:label "contractures, pterygia, and spondylocarpotarsal fusion syndrome 1B"@en ;
    obo:IAO_0000115 "A contractures, pterygia, and spondylocarpotarsal fusion syndrome that is characterized by contractures of proximal and distal joints, pterygia involving the neck, elbows, fingers, and/or knees, and variable vertebral, carpal, and tarsal fusions and that has_material_basis_in compound heterozygous mutation in the MYH3 gene on chromosome 17p13."@en ;
    oboInOwl:hasDbXref "GARD:7111",
