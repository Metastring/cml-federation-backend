    rdfs:label "nonobstructive coronary artery disease"@en ;
    obo:IAO_0000115 "A coronary artery disease that is characterized by atherosclerotic plaque that would not be expected to obstruct blood flow or result in anginal symptoms and stenosis of coronary artery less than 50 percent."@en ;
    oboInOwl:hasExactSynonym "non-CAD"@en ;
