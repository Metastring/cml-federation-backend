obo:DOID_0050213 a owl:Class ;
    rdfs:label "obsolete Vibrio gastroenteritis"@en ;
    obo:IAO_0000115 "A Vibrio infectious disease that involves inflammation of the stomach and intestines caused by noncholera Vibrio species like Vibrio parahaemolyticus, Vibrio fluvialis and Vibrio vulnificus. Some species produce enterotoxins, which impair intestinal absorption, resulting in watery diarrhea. The symptoms include abdominal cramps, fever, vomiting, nausea and diarrhea."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050213" ;
    oboInOwl:inSubset doid:gram-negative_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050215 a owl:Class ;
    rdfs:label "obsolete Staphylococcus gastroenteritis"@en ;
    obo:IAO_0000115 "A staphylococcal infectious disease that is caused by ingestion of food containing enterotoxins, which are produced by staphylococcal species. The symptoms include abdominal cramps, diarrhea, headache and fever."@en ;
    oboInOwl:hasExactSynonym "Staphylococcus Aureus Gastroenteritis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050215" ;
    oboInOwl:inSubset doid:gram-positive_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050216 a owl:Class ;
    rdfs:label "obsolete Bacillus cereus gastroenteritis"@en ;
    obo:IAO_0000115 "A primary Bacillaceae infectious disease that is caused by ingestion of food contaminated with Bacillus cereus, which produces enterotoxins in the intestine. The symptoms include vomiting, abdominal cramps, fever and diarrhea."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050216" ;
    oboInOwl:inSubset doid:gram-positive_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_0050217 a owl:Class ;
    rdfs:label "obsolete Sapovirus gastroenteritis"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in inflammation located_in stomach and located_in intestine, has_material_basis_in Sapovirus, which is transmitted_by ingestion of contaminated food. The infection has_symptom nausea, has_symptom vomiting, has_symptom abdominal pain, and has_symptom diarrhea."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050217" ;
