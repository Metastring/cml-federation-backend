obo:DOID_14464 a owl:Class ;
    rdfs:label "neuroleptic malignant syndrome"@en ;
    obo:IAO_0000115 "A nervous system disease that is characterized by hyperthermia, muscular rigidity, autonomic dysfunction and altered consciousness and is associated with administration of antipsychotic and other central dopaminergic blockers."@en ;
    oboInOwl:hasDbXref "GARD:7195",
        "ICD10CM:G21.0",
        "ICD9CM:333.92",
        "MESH:D009459",
