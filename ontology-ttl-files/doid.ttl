obo:DOID_10520 a owl:Class ;
    rdfs:label "acute infection of pinna"@en ;
    obo:IAO_0000115 "An otitis externa which involves bacterial infections often related to underlying comorbidities as well as trauma. Common sources of trauma include ear piercing, boxing, blunt trauma, burns, bite wounds and iatrogenic insults. The common bacterial pathogens are staphylococcal and streptococcal species."@en ;
    oboInOwl:hasDbXref "ICD9CM:380.11",
        "SNOMEDCT_US_2025_09_01:56663002",
        "UMLS_CUI:C0155392" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:10520" ;
    rdfs:subClassOf obo:DOID_9463 .

obo:DOID_10525 a owl:Class ;
    rdfs:label "double pterygium"@en ;
    obo:IAO_0000115 "A pterygium that is characterized by a fleshy outpouching of conjunctival growth that appears to have multiple heads or areas of bulk or origin and has_symptom multiple fleshy bumps on the surface of the eye, foreign body sensation, decreased vision, and astigmatism. Double pterygiums are more common in people prone to ocular surface injury, such as those living in sunny, hot, and dry climates. Double pterygiums progress from pinguecula."@en ;
    oboInOwl:hasDbXref "ICD9CM:372.44",
        "SNOMEDCT_US_2025_09_01:193883003",
        "UMLS_CUI:C0155157" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:10525" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0002452 ;
            owl:someValuesFrom obo:SYMP_0000321 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0004029 ;
            owl:someValuesFrom obo:DOID_11782 ],
        obo:DOID_0002116 .

obo:DOID_10527 a owl:Class ;
    rdfs:label "obsolete Haemophilus influenzae pneumonia"@en ;
    obo:IAO_0000115 "A Haemophilus influenzae infectious disease that is caused by the strains of Haemophilus influenzae resulting in pleural effusions. This disease occurs in individuals with disorders that impaired the normal defense mechanisms and with pre-existing lung disease. H. influenzae causes bronchopneumonia making the patients wheezy and progressively more breathless."@en ;
    oboInOwl:hasExactSynonym "Haemophilus influenzae pneumonia (disorder)"@en,
        "Pneumonia due to H. influenzae"@en,
        "Pneumonia due to Hemophilus influenzae [H. influenzae]"@en,
        "pneumonia due to hemophilus influenzae"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:10527" ;
    oboInOwl:inSubset doid:gram-negative_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_10531 a owl:Class ;
    rdfs:label "obsolete pneumococcal pneumonia"@en ;
    obo:IAO_0000115 "A pneumococcal infectious disease that involves infection by the bacterium Streptococcus pneumoniae, also known as pneumococcus. In adults, pneumococcal pneumonia is often characterized by sudden onset of illness with symptoms including shaking chills, fever, shortness of breath or rapid breathing, pain in the chest that is worsened by breathing deeply, and a productive cough. In infants and young children, signs and symptoms may not be specific, and may include fever, cough, rapid breathing or grunting."@en ;
    oboInOwl:hasExactSynonym "Chest infection - pneumococcal pneumonia"@en,
        "Lobar -pneumococcal -pneumonia"@en,
        "Lobar pneumonia (disorder)"@en,
        "Pneumococcal lobar pneumonia (disorder)"@en,
        "Pneumococcal pneumonia (disorder)"@en,
        "Pneumococcal pneumonia (disorder) [Ambiguous]"@en,
        "Pneumococcal pneumonia [Streptococcus pneumoniae pneumonia]"@en,
        "Streptococcus pneumoniae pneumonia"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:10531" ;
    oboInOwl:inSubset doid:gram-positive_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_10532 a owl:Class ;
    rdfs:label "obsolete streptococcal pneumonia"@en ;
    obo:IAO_0000115 "A bacterial pneumonia caused due to the infection by Gram-positive bacteria of genus Streptococcus which are the most common cause of community-acquired pneumonias."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:10532" ;
    oboInOwl:inSubset doid:gram-positive_bacterial_infectious_disease ;
    owl:deprecated true .

obo:DOID_10533 a owl:Class ;
    rdfs:label "viral pneumonia"@en ;
    obo:IAO_0000115 "A pneumonia described as an inflammatory illness of the lung commonly caused by viruses such as influenza virus, parainfluenza, adenovirus, rhinovirus, herpes simplex virus, respiratory syncytial virus, hantavirus, and cytomegalovirus."@en ;
    oboInOwl:hasAlternativeId "DOID:13167" ;
    oboInOwl:hasDbXref "ICD10CM:J12.9",
