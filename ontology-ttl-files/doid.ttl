obo:DOID_0050167 a owl:Class ;
    rdfs:label "autoimmune polyendocrine syndrome type 1"@en ;
    obo:IAO_0000115 "An autoimmune polyendocrine syndrome that is inherited in an autosomal recessive fashion, which is characterized by abnormal functioning of the immune system that causes auto-reactivity against endocrine organs."@en ;
    oboInOwl:hasDbXref "GARD:8466",
        "MIM:240300" ;
    oboInOwl:hasExactSynonym "Autoimmune Polyglandular Syndrome I"@en,
        "Whitaker syndrome"@en,
        "autoimmune polyendocrinopathy-candidiasis-ectodermal dystrophy"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050167" ;
