obo:DOID_13343 a owl:Class ;
    rdfs:label "obsolete ocular toxoplasmosis"@en ;
    obo:IAO_0000115 "A toxoplasmosis that results from reactivation of congenital toxoplasmosis, but rarely with acquired infection. Focal necrotizing retinitis and a secondary granulomatous inflammation of the choroid occur. The symptoms include conjunctivitis, ocular pain, blurred vision, and blindness."@en ;
