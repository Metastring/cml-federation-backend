obo:DOID_14515 a owl:Class ;
    rdfs:label "WAGR syndrome"@en ;
    obo:IAO_0000115 "A chromosomal deletion syndrome that is a nephroblastoma that results_in a rare genetic syndrome in which affected children are predisposed to develop Wilms tumor, Aniridia (absence of the colored part of the eye, the iris), genitourinary anomalies, and mental retardation. The condition results from a deletion on chromosome 11 resulting in the loss of several genes. As such, it is one of the best studied examples of a condition caused by loss of neighbouring (contiguous) genes."@en ;
    oboInOwl:hasDbXref "GARD:5528",
        "MESH:D017624",
        "MIM:194072",
        "NCI:C3718",
        "SNOMEDCT_US_2025_09_01:715215007",
