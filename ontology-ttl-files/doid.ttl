obo:DOID_0050168 a owl:Class ;
    rdfs:label "autoimmune polyendocrine syndrome type 2"@en ;
    obo:IAO_0000115 "An autoimmune polyendocrine syndrome that is characterized by abnormal functioning of the immune system that causes auto-reactivity against endocrine organs. It is more heterogeneous and has not been linked to one gene."@en ;
    oboInOwl:hasDbXref "GARD:7611",
        "MIM:269200" ;
