obo:DOID_13867 a owl:Class ;
    rdfs:label "focal labyrinthitis"@en ;
    obo:IAO_0000115 "A labyrinthitis which is an infectious inflammatory disease of a circumscribed area of either the vestibular or the cochlear portion of the labyrinth, or of both together. This is caused by a chronic suppurative otitis media, mastoiditis, or cholesteatoma."@en ;
    oboInOwl:hasDbXref "ICD9CM:386.32",
