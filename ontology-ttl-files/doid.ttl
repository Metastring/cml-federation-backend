    rdfs:label "Cowden syndrome 6"@en ;
    obo:IAO_0000115 "A Cowden syndrome that has_material_basis_in heterozygous mutation in the AKT1 gene on chromosome 14q32.3."@en ;
    oboInOwl:hasDbXref "MIM:615109" ;
    oboInOwl:hasExactSynonym "CWS6"@en ;
