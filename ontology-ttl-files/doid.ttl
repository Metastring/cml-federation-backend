    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_2132 .

obo:DOID_0081317 a owl:Class ;
    rdfs:label "multiple synostoses syndrome 1"@en ;
    obo:IAO_0000115 "A multiple synostoses syndrome is characterized by multiple joint fusions, usually commencing in the hands, conductive deafness, and characteristic facial features, including a broad, tubular-shaped nose and a thin upper vermilion and that has_material_basis_in heterozygous mutation in the NOG gene on chromosome 17q22."@en ;
    oboInOwl:hasDbXref "GARD:3836",
        "MIM:186500" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
