obo:DOID_13328 a owl:Class ;
    rdfs:label "diabetic cataract"@en ;
    obo:IAO_0000115 "A cataract that is characterized by loss of lens transparency secondary to hyperglycemia related to diabetes mellitus."@en ;
    oboInOwl:hasDbXref "ICD9CM:366.41",
