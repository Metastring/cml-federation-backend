obo:DOID_10852 a owl:Class ;
    rdfs:label "middle ear cholesterol granuloma"@en ;
    obo:IAO_0000115 "A otitis media which is an expansile, inflammatory mass of granulation tissue in the middle ear. It is a foreign body reaction to cholesterol deposits that occur in obstructed fluid-filled air cells of the temporal bone. It is present with a conductive hearing loss and a blue eardrum."@en ;
    oboInOwl:hasDbXref "NCI:C3655",
