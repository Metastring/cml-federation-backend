obo:DOID_0081308 a owl:Class ;
    rdfs:label "grade I lymphomatoid granulomatosis"@en ;
    obo:IAO_0000115 "A lymphomatoid granulomatosis that is characterized by the presence of a polymorphous lymphoid infiltrate without cytologic atypia. Large lymphocytes are absent or rare. By in situ hybridization, EBV-positive cells are infrequently seen."@en ;
    oboInOwl:hasDbXref "ICDO:9766/1",
        "NCI:C7931",
        "UMLS_CUI:C0279065" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081308" ;
    oboInOwl:inSubset doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0081307 .

obo:DOID_0081309 a owl:Class ;
    rdfs:label "grade II lymphomatoid granulomatosis"@en ;
    obo:IAO_0000115 "A lymphomatoid granulomatosis that is characterized by the presence of occasional large lymphoid cells or immunoblasts in a polymorphous background. Necrosis is more commonly seen as compared to grade I lymphomatoid granulomatosis. By in situ hybridization, EBV-positive cells are readily seen."@en ;
    oboInOwl:hasDbXref "ICDO:9766/1" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081309" ;
    rdfs:subClassOf obo:DOID_0081307 .

obo:DOID_0081310 a owl:Class ;
    rdfs:label "grade III lymphomatoid granulomatosis"@en ;
    obo:IAO_0000115 "A lymphomatoid granulomatosis that is characterized by the presence of aggregates of neoplastic large B-lymphocytes, usually admixed with pleomorphic and Hodgkin-like cells, in a background of chronic inflammation. Necrotic changes are present and are usually extensive."@en ;
    oboInOwl:hasDbXref "ICDO:9766/3" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081310" ;
    rdfs:subClassOf obo:DOID_0081307 .

obo:DOID_0081311 a owl:Class ;
    rdfs:label "intravascular large B-cell lymphoma"@en ;
    obo:IAO_0000115 "A large B-cell lymphoma that is characterized by the presence of lymphoma cells exclusively in the lumina of small vessels, particularly capillaries."@en ;
    oboInOwl:hasDbXref "ICDO:9712/3",
        "NCI:C4342" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081311" ;
    oboInOwl:inSubset doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0081452 .

obo:DOID_0081313 a owl:Class ;
    rdfs:label "primary diffuse large B-cell lymphoma of the central nervous system"@en ;
    obo:IAO_0000115 "A diffuse large B-cell lymphoma arising from the central nervous system."@en ;
    oboInOwl:hasDbXref "ICDO:9680/3",
        "NCI:C212057",
        "SNOMEDCT_US_2025_09_01:734066005",
        "UMLS_CUI:C2026186" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081313" ;
    oboInOwl:inSubset doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_0050745 .

obo:DOID_0081314 a owl:Class ;
    rdfs:label "extraventricular neurocytoma"@en ;
    obo:IAO_0000115 "A cerebral ventricle cancer that is characterized by the presence of neoplastic uniform, round cells with neuronal differentiation, that arises from the brain parenchyma. Unlike central neurocytoma, it does not involve the lateral ventricles."@en ;
    oboInOwl:hasDbXref "ICDO:9506/1",
        "NCI:C92555" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081314" ;
    oboInOwl:inSubset doid:DO_cancer_slim,
        doid:NCIthesaurus ;
    rdfs:subClassOf obo:DOID_3541 .

obo:DOID_0081315 a owl:Class ;
    rdfs:label "central nervous system tumor with BCOR internal tandem duplication"@en ;
    obo:IAO_0000115 "A central nervous system embryonal tumor that is characterized by the presence of uniform oval or spindle-shaped cells with round or oval nuclei, pseudorosette formation, and heterozygous internal tandem duplication in exon 15 of the BCOR gene."@en ;
    oboInOwl:hasDbXref "ICDO:9500/3",
        "NCI:C186556",
        "UMLS_CUI:C5670630" ;
    oboInOwl:hasExactSynonym "CNS tumour with BCOR internal tandem duplication"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
