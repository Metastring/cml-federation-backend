obo:DOID_11179 a owl:Class ;
    rdfs:label "obsolete otitis media with effusion"@en ;
    obo:IAO_0000115 "A non-suppurative otitis media which is a collection of fluid that occurs in the middle ear space as a result of the negative pressure produced by altered Eustachian tube function. This can occur from viral upper respiratory infection or bacterial infection, or it can precede and/or follow acute bacterial otitis media."@en ;
