obo:DOID_0050261 a owl:Class ;
    rdfs:label "thelaziasis"@en ;
    obo:IAO_0000115 "A parasitic helminthiasis infectious diseasea that involves infection of the eyes in humans by nematode Thelazia callipaeda causing varying degrees of inflammation and lacrimation. In heavier infections, photophobia, edema, conjunctivitis, and blindness occurs."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
