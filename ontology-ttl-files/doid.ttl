obo:DOID_11079 a owl:Class ;
    rdfs:label "leech infestation"@en ;
    obo:IAO_0000115 "A parasitic ectoparasitic infectious disease that involves parasitic infestation by members of the subclass Hirudinea. The leeches remain attached to their hosts and feed on blood until they become full, at which point they fall off to digest. While feeding, they release an anesthetic and use a combination of mucus and suction to stay attached and secrete an anti-clotting enzyme, hirudin, into the host's blood stream."@en ;
    oboInOwl:hasDbXref "ICD10CM:B88.3",
        "ICD9CM:134.2",
        "SNOMEDCT_US_2025_09_01:154423006",
        "UMLS_CUI:C0019575" ;
    oboInOwl:hasExactSynonym "Hirudiniasis"@en,
        "Leeches"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:11079" ;
    oboInOwl:inSubset doid:DO_infectious_disease_slim ;
    rdfs:subClassOf obo:DOID_4110 .

obo:DOID_11088 a owl:Class ;
    rdfs:label "asphyxia neonatorum"@en ;
    obo:IAO_0000115 "A respiratory system disease that is characterized by deprivation of oxygen to a newborn infant that lasts long enough during the birth process to cause physical harm, usually to the brain."@en ;
    oboInOwl:hasDbXref "GARD:5857",
        "ICD10CM:P84",
        "ICD9CM:768.9",
        "MESH:D001238",
        "SNOMEDCT_US_2025_09_01:413654009",
        "UMLS_CUI:C0004045" ;
    oboInOwl:hasExactSynonym "Asphyxia - birth"@en,
        "Asphyxia, in liveborn infant"@en,
        "Birth asphyxia"@en,
        "postnatal asphyxia"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:11088" ;
    oboInOwl:inSubset doid:DO_rare_slim ;
    rdfs:subClassOf obo:DOID_1579 ;
    skos:exactMatch "MESH:D001238" .

obo:DOID_11092 a owl:Class ;
    rdfs:label "obsolete Salmonella gastroenteritis"@en ;
    obo:IAO_0000115 "A Salmonella infectious disease that involves inflammation of the stomach and intestines caused by Salmonella infection. The symptoms include diarrhea, vomiting, abdominal pain, fever and weakness."@en ;
    oboInOwl:hasExactSynonym "Enteric paratyphosis"@en,
        "Salmonella food poisoning"@en,
        "Salmonella food poisoning (disorder)"@en,
        "Salmonella gastroenteritis"@en,
