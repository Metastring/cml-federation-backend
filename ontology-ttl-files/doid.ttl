obo:DOID_13862 a owl:Class ;
    rdfs:label "acute closed-angle glaucoma"@en ;
    obo:IAO_0000115 "A primary angle-closure glaucoma characterized by acute closure of the anterior chamber angle by an intrinsic defect such that aqueous outflow is blocked and the intraocular pressure becomes suddenly inappropriately elevated threatening further optic nerve damage and visual field loss. Acute closed-angle glaucoma has_symptom sudden pain, redness, headache, and blurry vision with haloes around lights. Acute closed-angle glaucoma can be caused by exacerbation of chronic primary angle-closure glaucoma, typically by a medication or state that dilates the eyes and thus narrows the anterior chamber angle, blocking any aqueous outflow."@en ;
    oboInOwl:hasDbXref "ICD10CM:H40.21",
        "ICD9CM:365.22",
        "SNOMEDCT_US_2025_09_01:30041005",
        "UMLS_CUI:C0154946" ;
    oboInOwl:hasExactSynonym "acute angle-closure glaucoma"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
