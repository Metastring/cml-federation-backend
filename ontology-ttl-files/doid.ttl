    obo:IAO_0000115 "A candidiasis that involves infection of the small intestine caused by Candida species, resulting in ulceration."@en ;
    oboInOwl:hasExactSynonym "gastrointestinal candidiasis (disorder)"@en,
        "intestinal moniliasis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:13528" ;
    owl:deprecated true .

obo:DOID_13534 a owl:Class ;
    rdfs:label "purulent labyrinthitis"@en ;
    obo:IAO_0000115 "A labyrinthitis which is a bacterial infectious disease of the inner ear, often causing deafness and loss of vestibular function. This is caused when bacteria spread to the inner ear during the course of severe acute otitis media, purulent meningitis, or an enlarging cholesteatoma."@en ;
    oboInOwl:hasDbXref "ICD9CM:386.33",
        "SNOMEDCT_US_2025_09_01:24817009",
        "UMLS_CUI:C0155506" ;
    oboInOwl:hasExactSynonym "Suppurative labyrinthitis"@en,
        "bacterial labyrinthitis"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:hasRelatedSynonym "acute suppurative labyrinthitis"@en ;
    oboInOwl:id "DOID:13534" ;
    rdfs:subClassOf obo:DOID_1468 .

obo:DOID_13544 a owl:Class ;
    rdfs:label "low tension glaucoma"@en ;
    obo:IAO_0000115 "An open-angle glaucoma characterized by increased intrinsic resistance to aqueous outflow without known secondary causes, an anatomically narrow anterior chamber angle, or elevated intraocular pressure compared to the average population. Normal tension glaucoma has_symptom progressive decreased vision and progressive loss of peripheral vision."@en ;
    oboInOwl:hasDbXref "ICD10CM:H40.12",
        "ICD9CM:365.12",
        "MESH:D057066",
        "SNOMEDCT_US_2025_09_01:155124000",
