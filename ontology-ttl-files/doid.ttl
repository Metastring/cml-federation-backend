obo:DOID_13060 a owl:Class ;
    rdfs:label "traumatic glaucoma"@en ;
    obo:IAO_0000115 "A glaucoma characterized by elevated intraocular pressure secondary to ocular trauma, which leads to glaucomatous optic nerve atrophy and progressive vision loss and has_symptom progressive decreased vision, visual field defects, and decreased peripheral vision. Traumatic glaucoma is caused by ocular trauma that affects aqueous outflow, such as trauma that leads to inflammation or deposition of proteins in the trabecular network, that changes the anterior chamber angle, or that causes chronic inflammation."@en ;
    oboInOwl:hasDbXref "ICD9CM:365.65",
        "SNOMEDCT_US_2025_09_01:68241007",
