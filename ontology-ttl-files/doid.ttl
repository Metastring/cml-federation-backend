obo:DOID_8729 a owl:Class ;
    rdfs:label "milker's nodule"@en ;
    obo:IAO_0000115 "A viral infectious disease that results_in infection of cattle and humans, located_in skin, has_material_basis_in Pseudocowpox virus (Parapoxvirus pseudocowpox), which is transmitted_by contact with the infected cow teats, or transmitted_by fomites. The infection results_in_formation_of lesions on the fingers, hands, and forearms and has_symptom fever, has_symptom lymphangitis, and has_symptom lymphadenopathy."@en ;
