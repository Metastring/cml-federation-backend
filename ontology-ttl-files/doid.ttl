    obo:IAO_0000115 "A (+)ssRNA virus infectious disease that results_in infection in animals and humans, located_in liver, has_material_basis_in Hepeviridae viruses."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0050219" ;
