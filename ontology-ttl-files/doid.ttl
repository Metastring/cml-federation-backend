        obo:DOID_0050737,
        obo:DOID_0081337 .

obo:DOID_0081342 a owl:Class ;
    rdfs:label "congenital myopathy 8"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by hypotonia and delayed motor development apparent from infancy or childhood, resulting in difficulties walking or loss of ambulation within the first few decades and that has_material_basis_in heterozygous mutation in the ACTN2 gene on chromosome 1q43. Heterozygous mutation in the ACTN2 gene can also cause distal myopathy-6 (MPD6), which shows later onset and is less severe."@en ;
    oboInOwl:hasDbXref "MIM:618654" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081342" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:GENO_0000147 ],
        obo:DOID_0050736,
        obo:DOID_0081337 .

obo:DOID_0081343 a owl:Class ;
    rdfs:label "congenital myopathy 9A"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by neonatal hypotonia, poor feeding, fractures of the long bones, and respiratory insufficiency and that has_material_basis_in homozygous mutation in the FXR1 gene on chromosome 3q28."@en ;
    oboInOwl:hasDbXref "MIM:618822" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081343" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:GENO_0000148 ],
        obo:DOID_0050737,
        obo:DOID_0081337 .

obo:DOID_0081344 a owl:Class ;
    rdfs:label "congenital myopathy 9B"@en ;
    obo:IAO_0000115 "A congenital myopathy that is neonatal hypotonia followed by mildly delayed walking in childhood, mainly affecting proximal muscles, and that has_material_basis_in homozygous mutation in the FXR1 gene on chromosome 3q28. Biallelic mutation in the FXR1 gene also causes CMYP9A."@en ;
    oboInOwl:hasDbXref "MIM:618823" ;
    oboInOwl:hasExactSynonym "ongenital proximal myopathy 9B with minicore lesions"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081344" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:GENO_0000148 ],
        obo:DOID_0050737,
        obo:DOID_0081337 .

obo:DOID_0081345 a owl:Class ;
    rdfs:label "congenital myopathy 10B"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by infantile- or childhood-onset myopathy, areflexia, dysphagia, and respiratory distress that usually requires nocturnal ventilation and that has_material_basis_in homozygous or compound heterozygous mutation in the MEGF10 gene on chromosome 5q23. Biallelic mutation in the MEGF10 gene also causes a more severe congenital myopathy with overlapping features."@en ;
    oboInOwl:hasDbXref "MIM:620249" ;
