obo:DOID_0080546 a owl:Class ;
    rdfs:label "obsolete non-alcoholic fatty liver"@en ;
    obo:IAO_0000115 "A metabolic dysfunction-associated steatotic liver disease characterized by the absence of inflammation and hepatocyte injury in the form of hepatocyte ballooning."@en ;
    obo:IAO_0100001 obo:DOID_0080208 ;
    oboInOwl:hasExactSynonym "NAFL"@en,
        "nonalcoholic fatty liver"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0080546" ;
    rdfs:comment "NAFL was not addressed in the 2023 international update that revised the nomenclature and definition of NAFLD/MASLD and NASH/MASH. It has historically been considered a subtype of NAFLD/MASLD, but has frequently been used in clinical literature as a synonym for NAFLD itself. Use of NAFL in clinical literature has declined in connection with the decline of NAFLD. It no longer appears to represent a distinct disease entity (2024-11-22, JAB)."@en ;
    owl:deprecated true .

