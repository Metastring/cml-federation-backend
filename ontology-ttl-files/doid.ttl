    rdfs:label "obsolete histoplasmosis endocarditis"@en ;
    obo:IAO_0000115 "A histoplasmosis endocarditis that results_in inflammation located_in endocardium, has_material_basis_in Histoplasma capsulatum var duboisii or has_material_basis_in Histoplasma capsulatum var capsulatum, transmitted_by airborne spores and has_symptom murmurs, has_symptom peripheral edema, has_symptom pulmonary rales, has_symptom petechia and has_symptom skin lesions."@en ;
