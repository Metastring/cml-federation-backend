obo:DOID_11329 a owl:Class ;
    rdfs:label "ainhum"@en ;
    obo:IAO_0000115 "A connective tissue disease that results in increasing fibrous constriction and ultimately in spontaneous amputation of the toes and especially the little toes. A painful constriction of the base of the fifth toe frequently followed by bilateral spontaneous amputation (autoamputation) a few years later."@en ;
    oboInOwl:hasDbXref "GARD:9512",
