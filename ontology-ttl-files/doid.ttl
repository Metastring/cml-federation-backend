    rdfs:label "meningoencephalitis"@en ;
    obo:IAO_0000115 "A central nervous system disease that involves encephalitis which occurs along with meningitis."@en ;
    oboInOwl:hasDbXref "ICD10CM:A69.22",
        "MESH:D008590",
        "NCI:C34813",
        "SNOMEDCT_US_2025_09_01:7125002",
