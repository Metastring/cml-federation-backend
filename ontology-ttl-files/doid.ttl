    rdfs:label "intestinal tuberculosis"@en ;
    obo:IAO_0000115 "A gastrointestinal tuberculosis that involves diffuse mucosal fold thickening, formation of ulcers and fistulae located_in intestine. The infection has_symptom abdominal pain, has_symptom gastrointestinal bleeding, has_symptom nausea and has_symptom vomiting."@en ;
