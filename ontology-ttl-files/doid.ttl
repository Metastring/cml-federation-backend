    rdfs:label "obsolete Histoplasma duboisii retinitis"@en ;
    obo:IAO_0000115 "An African histoplasmosis that results_in inflammation located_in retina, has_material_basis_in Histoplasma capsulatum var duboisii, transmitted_by airborne spores and results_in_formation_of lesions."@en ;
