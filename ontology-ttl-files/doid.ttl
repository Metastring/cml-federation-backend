obo:DOID_0060015 a owl:Class ;
    rdfs:label "obsolete interleukin-7 receptor alpha deficiency"@en ;
    obo:IAO_0000115 "A severe combined immunodeficiency that results from defective IL7R expression causes T-B+NK+ SCID. Loss of IL-7R function leads to the loss of an antiapoptotic signal, resulting in a loss of T-cell selection in thymus."@en ;
