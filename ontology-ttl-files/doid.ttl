obo:DOID_1056 a owl:Class ;
    rdfs:label "oculocerebrorenal syndrome"@en ;
    obo:IAO_0000115 "A syndrome that has_material_basis_in mutation in the OCRL gene on chromosome Xq26 and that is characterized by hydrophthalmia, cataract, mental retardation, vitamin D-resistant rickets, amino aciduria, and reduced ammonia production by the kidney."@en ;
