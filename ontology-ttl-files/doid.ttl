obo:DOID_0081004 a owl:Class ;
    rdfs:label "high-grade B-cell lymphoma double-hit/triple-hit"@en ;
    obo:IAO_0000115 "A large B-cell lymphoma that is characterized by the abnormal rearrangement of two genes, MYC gene and either BCL2 or BCL6 genes."@en ;
    oboInOwl:hasDbXref "NCI:C125904" ;
    oboInOwl:hasExactSynonym "HGBL-DH/TH"@en,
        "High Grade B-Cell Lymphoma with MYC and BCL2 or BCL6 Rearrangements"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
