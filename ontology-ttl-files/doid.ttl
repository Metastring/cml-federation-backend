obo:DOID_11289 a owl:Class ;
    rdfs:label "ventilation pneumonitis"@en ;
    obo:IAO_0000115 "An extrinsic allergic alveolitis caused by inhalation of antigens from thermophilic actinomycetes species growing in air conditioners and humidifiers. Fungi like Aureobasidium sp and Candida albicans that survive in the contaminated water in humidifiers and air conditioners are also known to cause the disease."@en ;
    oboInOwl:hasDbXref "ICD10CM:J67.7",
        "ICD9CM:495.7",
        "NCI:C196790",
        "SNOMEDCT_US_2025_09_01:48347002",
