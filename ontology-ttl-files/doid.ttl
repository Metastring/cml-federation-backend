obo:DOID_0050152 a owl:Class ;
    rdfs:label "aspiration pneumonia"@en ;
    obo:IAO_0000115 "A bacterial pneumonia which is an acute pulmonary inflammatory response that develops after the inhalation of colonized oropharyngeal material containing bacteria. It is seen in individuals with dysphagia and gastric dysmotility. The disease has_symptom tachypnea and has_symptom cough."@en ;
