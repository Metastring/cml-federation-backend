obo:DOID_0081028 a owl:Class ;
    rdfs:label "glycogen-rich carcinoma"@en ;
    obo:IAO_0000115 "A breast adenocarcinoma characterized by the presence of malignant epithelial cells with abundant clear cytoplasm which contains glycogen."@en ;
    oboInOwl:hasDbXref "ICDO:8315/3",
        "NCI:C4153",
        "SNOMEDCT_US_2025_09_01:189656007",
        "UMLS_CUI:C0334319" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
