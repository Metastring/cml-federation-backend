obo:DOID_13601 a owl:Class ;
    rdfs:label "obsolete enteropathogenic Escherichia coli infectious disease"@en ;
    obo:IAO_0000115 "An Escherichia coli intestinal infectious disease that involves infection of the intestine caused by a serological subgroup of Escherichia coli called enteropathogenic Escherichia coli (EPEC), which has a plasmid-encoded protein referred to as EPEC adherence factor that enables localized adherence of bacteria to intestinal cells and a non fimbrial adhesin designated intimin, which is an outer membrane protein that mediates the final stages of adherence. EPEC induce a profuse watery (sometimes bloody) diarrhea."@en ;
    oboInOwl:hasExactSynonym "Enteropathogenic Escherichia coli gastrointestinal tract infection"@en,
        "Enteropathogenic Escherichia coli gastrointestinal tract infection (disorder)"@en,
        "intestinal infection due to enteropathogenic E. coli"@en ;
