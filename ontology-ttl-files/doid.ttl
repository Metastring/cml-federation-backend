obo:DOID_10556 a owl:Class ;
    rdfs:label "supine hypotensive syndrome"@en ;
    obo:IAO_0000115 "A vascular disease that is characterized by severe supine hypotension in late pregnancy, whose clinical presentation ranges from minimal cardiovascular alterations to severe shock, resulting from inferior vena cava compression by gravid uterus."@en ;
    oboInOwl:hasAlternativeId "DOID:10555",
        "DOID:12413" ;
    oboInOwl:hasDbXref "ICD9CM:669.20",
