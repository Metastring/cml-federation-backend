obo:DOID_1388 a owl:Class ;
    rdfs:label "Tangier disease"@en ;
    obo:IAO_0000115 "A hypolipoproteinemia that is characterized by markedly reduced levels of plasma high density lipoproteins resulting in tissue accumulation of cholesterol esters and that has_material_basis_in homozygous or compound heterozygous mutation in the ABCA1 gene on chromosome 9q31."@en ;
    oboInOwl:hasDbXref "GARD:7731",
