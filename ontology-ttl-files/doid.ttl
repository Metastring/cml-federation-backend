obo:DOID_0060337 a owl:Class ;
    rdfs:label "CEDNIK syndrome"@en ;
    obo:IAO_0000115 "A syndrome that has_material_basis_in homozygous mutation in the SNAP29 gene and characterized by a unique constellation of clinical manifestations including microcephaly, severe neurologic impairment, psychomotor retardation, failure to thrive, facial dysmoprhism, palmoplantar keratoderma and late-onset ichthyosis."@en ;
