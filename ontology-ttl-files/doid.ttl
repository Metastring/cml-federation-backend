obo:DOID_0050156 a owl:Class ;
    rdfs:label "idiopathic pulmonary fibrosis"@en ;
    obo:IAO_0000115 "A pulmonary fibrosis that is characterized by scarring of the lung characterized by stiffness in the lungs and makes it difficult to breathe."@en ;
    oboInOwl:hasDbXref "EFO:0000768",
