obo:DOID_0050186 a owl:Class ;
    rdfs:label "obsolete Cytomegalovirus encephalitis"@en ;
    obo:IAO_0000115 "A Cytomegalovirus infectious disease that results_in inflammation, located_in brain, has_material_basis_in Human herpesvirus 5, has_symptom confusional syndrome, has_symptom seizures, has_symptom coma, has_symptom dysphasia, and has_symptom cranial nerve palsies."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
