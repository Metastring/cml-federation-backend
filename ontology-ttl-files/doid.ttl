obo:DOID_12096 a owl:Class ;
    rdfs:label "sodoku disease"@en ;
    obo:IAO_0000115 "A primary bacterial infectious disease that results_in infection, has_material_basis_in Spirillum minus, which is transmitted_by contact with urine or secretions from the mouth, eye, or nose of an infected animal or transmitted_by bite of an infected animal, especially rat. The infection has_symptom chills, has_symptom relapsing fever, has_symptom rash and has_symptom joint pain."@en ;
    oboInOwl:hasDbXref "ICD10CM:A25.0",
