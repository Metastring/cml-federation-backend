obo:DOID_0081320 a owl:Class ;
    rdfs:label "multiple synostoses syndrome 4"@en ;
    obo:IAO_0000115 "A multiple synostoses syndrome that is characterized by fusion of carpal and tarsal bones, as well as conductive hearing loss and that has_material_basis_in heterozygous mutation in the GDF6 gene on chromosome 8q22."@en ;
    oboInOwl:hasDbXref "MIM:617898" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
