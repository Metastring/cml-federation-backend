obo:DOID_0080990 a owl:Class ;
    rdfs:label "King Denborough syndrome"@en ;
    obo:IAO_0000115 "A myopathy that is characterized by distinctive facies, ptosis, downslanted palpebral fissures, widely spaced eyes, epicanthal folds, low-set ears, malar hypoplasia, micrognathia, high-arched palate, clinodactyly, single palmar crease, pectus excavatum, winging of the scapulae, lumbar lordosis, and mild thoracic scoliosis. Pathogenic variants in RYR1 have been found in some individuals with King-Denborough syndrome."@en ;
    oboInOwl:hasDbXref "GARD:8433",
        "MESH:C536883",
        "MIM:619542",
        "ORDO:99741" ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
