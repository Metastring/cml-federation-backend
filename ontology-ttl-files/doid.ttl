obo:DOID_0050153 a owl:Class ;
    rdfs:label "pulmonary aspergilloma"@en ;
    obo:IAO_0000115 "An aspergillosis that presents as a clump of tangled mass of Aspergillus fungus fibres, blood clots, and white blood cells, which exists in the cavities of the lungs that develop in an area of previous lung disease or lung scarring."@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
