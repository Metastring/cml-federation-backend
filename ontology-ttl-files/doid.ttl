obo:DOID_0081339 a owl:Class ;
    rdfs:label "congenital myopathy 2B"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by severe hypotonia with lack of spontaneous movements and respiratory insufficiency, usually leading to death in infancy or early childhood and that has_material_basis_in homozygous or compound heterozygous mutation in the ACTA1 gene on chromosome 1q42."@en ;
    oboInOwl:hasDbXref "MIM:620265" ;
    oboInOwl:hasExactSynonym "autosomal recessive congenital myopathy 2B"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081339" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:GENO_0000148 ],
        obo:DOID_0050737,
        obo:DOID_0081337 .

obo:DOID_0081340 a owl:Class ;
    rdfs:label "congenital myopathy 2C"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by severe congenital weakness usually resulting in death from respiratory failure in the first year or so of life and that has_material_basis_in heterozygous mutation in the ACTA1 gene on chromosome 1q42. Heterozygous mutation in the ACTA1 gene can also cause autosomal dominant typical congenital myopathy-2A (CMYP2A). Biallelic mutation in the ACTA1 gene causes autosomal recessive severe infantile congenital myopathy-2B (CMYP2B)."@en ;
    oboInOwl:hasDbXref "MIM:620278" ;
    oboInOwl:hasExactSynonym "autosomal dominant severe infantile congenital myopathy 2C"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081340" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IDO_0000664 ;
            owl:someValuesFrom obo:GENO_0000147 ],
        obo:DOID_0050736,
        obo:DOID_0081337 .

obo:DOID_0081341 a owl:Class ;
    rdfs:label "congenital myopathy 5"@en ;
    obo:IAO_0000115 "A congenital myopathy that is characterized by the onset of muscle weakness in infancy manifest as neonatal hypotonia, delayed motor development, and often distal contractures and that has_material_basis_in homozygous or compound heterozygous mutation in the gene encoding titin (TTN) on chromosome 2q31."@en ;
    oboInOwl:hasDbXref "MIM:611705",
        "ORDO:289377" ;
    oboInOwl:hasExactSynonym "Salih myopathy"@en,
        "congenital myopathy-5 with cardiomyopathy"@en ;
    oboInOwl:hasOBONamespace "disease_ontology" ;
    oboInOwl:id "DOID:0081341" ;
    oboInOwl:inSubset doid:DO_rare_slim ;
