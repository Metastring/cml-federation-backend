obo:DOID_1562 a owl:Class ;
    rdfs:label "chromoblastomycosis"@en ;
    obo:IAO_0000115 "A subcutaneous mycosis that is a chronic subcutaneous fungal infection, which presents as nodular or verrucoid, ulcerated, or crusted skin lesions on exposed areas of skin caused by Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii or Phialophora verrucosa. Histological examination reveals muriform cells (with perpendicular septations) or thick walled, dark-colored, rounded forms (copper pennies) that are characteristic of this infection."@en ;
    oboInOwl:hasDbXref "GARD:1319",
