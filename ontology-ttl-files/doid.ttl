obo:DOID_14444 a owl:Class ;
    rdfs:label "sclerosing keratitis"@en ;
    obo:IAO_0000115 "A deep keratitis that is characterized by inflammation of the anterior sclera and subsequent inflammation of the adjacent cornea with opacification of the corneal stroma and has_symptom pain, red eyes, photophobia, tearing, and blurry vision. Sclerosing keratitis is caused by severe anterior scleritis that causes inflammation and injury to the adjacent corneal layer. Anterior scleritis can be caused by autoimmune diseases, connective tissue diseases, and infection."@en ;
    oboInOwl:hasDbXref "ICD10CM:H16.33",
        "ICD9CM:370.54",
        "SNOMEDCT_US_2025_09_01:27886001",
        "UMLS_CUI:C0155090" ;
