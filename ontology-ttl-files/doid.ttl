obo:DOID_1306 a owl:Class ;
    rdfs:label "obsolete HIV encephalopathy"@en ;
    obo:IAO_0000115 "An acquired immunodeficiency syndrome that results_in infection located_in brain, has_material_basis_in Human immunodeficiency virus 1 or has_material_basis_in Human immunodeficiency virus 2. The infection has_symptom cognitive impairment, has_symptom motor dysfunction, and has_symptom behavioral change."@en ;
    oboInOwl:hasExactSynonym "AIDS Encephalopathy"@en,
