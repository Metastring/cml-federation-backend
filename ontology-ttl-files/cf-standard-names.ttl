<http://vocab.nerc.ac.uk/collection/P07/current/SYLZJDPO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::SYLZJDPO";
        dc:date                "2026-09-15 05:36:52.0";
        dc:identifier          "SDN:P07::SYLZJDPO";
        pav:authoredOn         "2026-09-15 05:36:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/SYLZJDPO/1/>;
        pav:version            "1";
