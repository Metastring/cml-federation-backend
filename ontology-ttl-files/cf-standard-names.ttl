<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0688/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0688";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0688";
