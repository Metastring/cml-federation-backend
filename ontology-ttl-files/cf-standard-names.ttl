        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Sn\" means the element \"tin\" and \"127Sn\" is the isotope \"tin-127\" with a half-life of 8.84e-02 days."@en;
        skos:notation          "SDN:P07::UDFA4QV0";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_127Sn"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/U37R9YL0/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::U37R9YL0";
        dc:date                "2024-09-04 12:51:23.0";
        dc:identifier          "SDN:P07::U37R9YL0";
        pav:authoredOn         "2024-09-04 12:51:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/U37R9YL0/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_pm10_bromide_dry_aerosol_particles_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"Pm10 aerosol\" means atmospheric particulate compounds with an aerodynamic diameter of less than or equal to 10 micrometers. The chemical formula for the bromide anion is Br-."@en;
        skos:notation          "SDN:P07::U37R9YL0";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_pm10_bromide_dry_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N457/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N457";
        dc:date                "2009-07-06 15:41:29.0";
