        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_concentration_of_particulate_organic_matter_dry_aerosol_in_air> , <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_particulate_organic_matter_dry_aerosol_in_air/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AORG/> , <http://vocab.nerc.ac.uk/collection/P64/current/H316/> , <http://vocab.nerc.ac.uk/collection/P04/current/H316/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets).  Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. \"Dry aerosol\" means aerosol without water. The term \"particulate_organic_matter_dry_aerosol\" means all particulate organic matter dry aerosol except black carbon. It is the sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol."@en;
        skos:notation          "SDN:P07::CF12N306";
        skos:note              "deprecated"@en;
        skos:prefLabel         "mass_concentration_of_particulate_organic_matter_dry_aerosol_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/V5PECPJW/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::V5PECPJW";
        dc:date                "2024-11-11 15:22:42.0";
        dc:identifier          "SDN:P07::V5PECPJW";
        pav:authoredOn         "2024-11-11 15:22:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/V5PECPJW/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/eastward_friction_velocity_at_sea_water_surface/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A velocity is a vector quantity. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). Friction velocity is a reference ocean velocity derived from the relationship between ocean density and downward stress and is usually applied at a level close to the surface where stress is assumed to be independent of height and approximately proportional to the square of mean velocity."@en;
        skos:notation          "SDN:P07::V5PECPJW";
        skos:note              "accepted"@en;
        skos:prefLabel         "eastward_friction_velocity_at_sea_water_surface"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N43/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N43";
        dc:date                "2018-12-17 17:17:12.0";
        dc:identifier          "SDN:P07::CFV7N43";
        pav:authoredOn         "2018-12-17 17:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N43/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N43/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_gaseous_elemental_mercury_due_to_wet_deposition> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_gaseous_elemental_mercury_due_to_wet_deposition/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Wet deposition\" means deposition by precipitation."@en;
        skos:notation          "SDN:P07::CFV7N43";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_gaseous_elemental_mercury_due_to_wet_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G130/> , <http://vocab.nerc.ac.uk/collection/P64/current/G130/> .

<http://vocab.nerc.ac.uk/collection/P07/current/U7QVYEYD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::U7QVYEYD";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::U7QVYEYD";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/U7QVYEYD/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_249Cf_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_249Cf_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cf\" means the element \"californium\" and \"249Cf\" is the isotope \"californium-249\" with a half-life of 1.32e+05 days."@en;
        skos:notation          "SDN:P07::U7QVYEYD";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_249Cf_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/HAAN5RSL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HAAN5RSL";
        dc:date                "2021-09-20 14:41:46.0";
        dc:identifier          "SDN:P07::HAAN5RSL";
        pav:authoredOn         "2021-09-20 14:41:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HAAN5RSL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_organic_matter_in_soil/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_organic_matter_in_soil>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass fraction\" is used in the construction \"mass_fraction_of_X_in_Y\", where X is a material constituent of Y. It is evaluated as the mass of X divided by the mass of Y (including X). It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction."@en;
        skos:notation          "SDN:P07::HAAN5RSL";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_organic_matter_in_soil"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0144/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0144";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0144";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0144/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_northward_wind> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_northward_wind/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/> , <http://vocab.nerc.ac.uk/collection/P64/current/G259/> , <http://vocab.nerc.ac.uk/collection/P04/current/G259/>;
        skos:definition        "'tendency_of_X' means derivative of X with respect to time. 'Northward' indicates a vector component which is positive when directed northward (negative southward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.)"@en;
        skos:notation          "SDN:P07::CFSN0144";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_northward_wind"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MPS2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N62/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N62";
        dc:date                "2010-07-26 08:27:36.0";
        dc:identifier          "SDN:P07::CF14N62";
        pav:authoredOn         "2010-07-26 08:27:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N62/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF14N62/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sinking_mole_flux_of_particulate_organic_phosphorus_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/sinking_mole_flux_of_particulate_organic_phosphorus_in_sea_water>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OPFX/>;
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics.   'Sinking' is the gravitational settling of particulate matter suspended in a liquid. A sinking flux is positive downwards and is calculated relative to the movement of the surrounding fluid."@en;
        skos:notation          "SDN:P07::CF14N62";
        skos:note              "accepted"@en;
        skos:prefLabel         "sinking_mole_flux_of_particulate_organic_phosphorus_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2MS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/TG5KHI3E/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::TG5KHI3E";
        dc:date                "2021-09-20 14:41:46.0";
        dc:identifier          "SDN:P07::TG5KHI3E";
        pav:authoredOn         "2021-09-20 14:41:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/TG5KHI3E/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/depth_at_base_of_unfrozen_ground/> , <http://mmisw.org/ont/cf/parameter/depth_at_base_of_unfrozen_ground>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase depth_at_base_of_unfrozen_ground is the instantaneous depth of the downward penetration of thaw from the ground surface at a given time. Permafrost is soil or rock that has remained at a temperature at or below zero degrees Celsius throughout the seasonal cycle for two or more consecutive years. The maximum measurable depth_at_base_of_unfrozen_ground value as recorded at the end of a thawing season corresponds to the permafrost_active_layer_thickness."@en;
        skos:notation          "SDN:P07::TG5KHI3E";
        skos:note              "accepted"@en;
        skos:prefLabel         "depth_at_base_of_unfrozen_ground"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1SO3598I/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1SO3598I";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::1SO3598I";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N27/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1SO3598I/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/1SO3598I/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles.  Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"particulate_organic_matter_dry_aerosol\" means all particulate organic matter dry aerosol except elemental carbon. It is the sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Dry deposition\" is the sum of turbulent deposition and gravitational settling. \"tendency_of_X\" means derivative of X  with respect to time."@en;
        skos:notation          "SDN:P07::1SO3598I";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N27/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N27";
        dc:date                "2015-01-07 15:23:08.0";
        dc:identifier          "SDN:P07::CFV7N27";
