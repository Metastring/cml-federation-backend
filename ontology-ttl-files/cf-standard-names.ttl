        dc:identifier          "SDN:P07::CF12N353";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N353/3/>;
