<http://vocab.nerc.ac.uk/collection/P07/current/0M1ZD0AP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0M1ZD0AP";
        dc:date                "2026-06-08 13:55:32.0";
        dc:identifier          "SDN:P07::0M1ZD0AP";
        pav:authoredOn         "2026-06-08 13:55:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0M1ZD0AP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_suspended_matter_in_sea_water_at_sea_water_surface/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Suspended matter may also be called suspended sediment. Suspended sediment means undissolved solid particles. The phrase \"sea water surface\" means the upper boundary of the liquid portion of an ocean or sea, including the boundary to floating ice if present."@en;
        skos:notation          "SDN:P07::0M1ZD0AP";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_suspended_matter_in_sea_water_at_sea_water_surface"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N116/>
        rdf:type               skos:Concept;
