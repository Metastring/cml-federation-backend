<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0777/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0777";
        dc:date                "2017-07-24 14:36:59.0";
        dc:identifier          "SDN:P07::CFSN0777";
