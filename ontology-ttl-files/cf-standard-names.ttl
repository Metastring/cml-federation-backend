        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Po\" means the element \"polonium\" and \"214Po\" is the isotope \"polonium-214\" with a half-life of 1.90e-09 days."@en;
        skos:notation          "SDN:P07::H6K6J0KZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_214Po_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

