        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P25/current/TURB/> , <http://vocab.nerc.ac.uk/collection/P04/current/G910/> , <http://vocab.nerc.ac.uk/collection/P02/current/TSED/> , <http://vocab.nerc.ac.uk/collection/P04/current/G692/> , <http://vocab.nerc.ac.uk/collection/P04/current/G863/> , <http://vocab.nerc.ac.uk/collection/P64/current/G863/> , <http://vocab.nerc.ac.uk/collection/P64/current/G910/>;
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Suspended matter may also be called suspended sediment. Suspended sediment means undissolved solid particles."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/> , <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/>;
