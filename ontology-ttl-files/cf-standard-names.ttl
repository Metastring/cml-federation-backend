        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G288/> , <http://vocab.nerc.ac.uk/collection/P64/current/G288/>;
        skos:definition        "In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0596";
        skos:note              "deprecated"@en;
        skos:prefLabel         "large_scale_rainfall_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV15A17/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV15A17";
        dc:date                "2010-07-26 09:49:03.0";
