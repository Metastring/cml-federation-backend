        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Bk\" means the element \"berkelium\" and \"249Bk\" is the isotope \"berkelium-249\" with a half-life of 3.15e+02 days."@en;
        skos:notation          "SDN:P07::W9CRDFEL";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_249Bk_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/9GPDHML0/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::9GPDHML0";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::9GPDHML0";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A26/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/9GPDHML0/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/9GPDHML0/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/number_concentration_of_ambient_aerosol_particles_in_air/> , <http://mmisw.org/ont/cf/parameter/number_concentration_of_ambient_aerosol_particles_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Number concentration\" means the number of particles or other specified objects per unit volume. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. \"Ambient_aerosol\" means that the aerosol is measured or modelled at the ambient state of pressure, temperature and relative humidity that exists in its immediate environment. \"Ambient aerosol particles\" are aerosol particles that have taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the particles."@en;
        skos:notation          "SDN:P07::9GPDHML0";
        skos:note              "accepted"@en;
        skos:prefLabel         "number_concentration_of_ambient_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PCUM/> .

