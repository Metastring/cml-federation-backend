        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pr\" means the element \"praseodymium\" and \"142Pr\" is the isotope \"praseodymium-142\" with a half-life of 7.94e-01 days."@en;
        skos:notation          "SDN:P07::7VYRN0BJ";
        skos:note              "accepted"@en;
