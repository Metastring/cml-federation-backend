        skos:definition        "Sea surface density is the density of sea water near the surface (including the part under sea-ice, if any)."@en;
        skos:notation          "SDN:P07::CF12N579";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_density"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N323/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N323";
        dc:date                "2015-01-07 15:23:06.0";
        dc:identifier          "SDN:P07::CF12N323";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/DEFTZ0HG/>;
        pav:authoredOn         "2015-01-07 15:23:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N323/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N323/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_concentration_of_water_in_ambient_aerosol_in_air> , <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_water_in_ambient_aerosol_in_air/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/H316/> , <http://vocab.nerc.ac.uk/collection/P04/current/H316/>;
        skos:definition        "\"Water\" means water in all phases.  Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets).  \"Ambient aerosol\" is aerosol that has taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the aerosol."@en;
        skos:notation          "SDN:P07::CF12N323";
        skos:note              "deprecated"@en;
        skos:prefLabel         "mass_concentration_of_water_in_ambient_aerosol_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DEFTZ0HG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DEFTZ0HG";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::DEFTZ0HG";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CF12N323/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/DEFTZ0HG/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/DEFTZ0HG/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_water_in_ambient_aerosol_particles_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_water_in_ambient_aerosol_particles_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. \"Ambient_aerosol\" means that the aerosol is measured or modelled at the ambient state of pressure, temperature and relative humidity that exists in its immediate environment. \"Ambient aerosol particles\" are aerosol particles that have taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the particles."@en;
        skos:notation          "SDN:P07::DEFTZ0HG";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_water_in_ambient_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CIT63QB5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CIT63QB5";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::CIT63QB5";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CIT63QB5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_145Pr_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_145Pr_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pr\" means the element \"praseodymium\" and \"145Pr\" is the isotope \"praseodymium-145\" with a half-life of 2.49e-01 days."@en;
        skos:notation          "SDN:P07::CIT63QB5";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_145Pr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/2LD5TKFV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::2LD5TKFV";
        dc:date                "2024-05-20 20:39:48.0";
        dc:identifier          "SDN:P07::2LD5TKFV";
        pav:authoredOn         "2024-05-20 20:39:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/2LD5TKFV/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/volume_scattering_coefficient_of_radiative_flux_in_air_due_to_dry_aerosol_particles_at_standard_temperature_and_pressure/> , <http://mmisw.org/ont/cf/parameter/volume_scattering_coefficient_of_radiative_flux_in_air_due_to_dry_aerosol_particles_at_standard_temperature_and_pressure>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The volume scattering/absorption/attenuation coefficient is the fractional change of radiative flux per unit path length due to the stated process. Coefficients with canonical units of m2 s-1 i.e. multiplied by density have standard names with specific_ instead of volume_. A scattering_angle should not be specified with this quantity. The scattering/absorption/attenuation coefficient is assumed to be an integral over all wavelengths, unless a coordinate of radiation_wavelength is included to specify the wavelength. Radiative flux is the sum of shortwave and longwave radiative fluxes. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Standard_temperature_and_pressure\" refer to a reference volume at 273.15 K temperature and 1013.25 hPa pressure."@en;
        skos:notation          "SDN:P07::2LD5TKFV";
        skos:note              "accepted"@en;
        skos:prefLabel         "volume_scattering_coefficient_of_radiative_flux_in_air_due_to_dry_aerosol_particles_at_standard_temperature_and_pressure"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPRM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZXDAMK75/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZXDAMK75";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::ZXDAMK75";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZXDAMK75/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_105Rh/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_105Rh>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Rh\" means the element \"rhodium\" and \"105Rh\" is the isotope \"rhodium-105\" with a half-life of 1.48e+00 days."@en;
        skos:notation          "SDN:P07::ZXDAMK75";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_105Rh"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/E36YCN7I/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::E36YCN7I";
        dc:date                "2018-05-29 16:57:01.0";
        dc:identifier          "SDN:P07::E36YCN7I";
        pav:authoredOn         "2018-05-29 16:57:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/E36YCN7I/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/change_over_time_in_thermal_energy_content_of_vegetation_and_litter_and_soil/> , <http://mmisw.org/ont/cf/parameter/change_over_time_in_thermal_energy_content_of_vegetation_and_litter_and_soil>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"change_over_time_in_X\" means change in a quantity X over a time-interval, which should be defined by the bounds of the time coordinate. \"Content\" indicates a quantity per unit area. Thermal energy is the total vibrational energy, kinetic and potential, of all the molecules and atoms in a substance. \"Vegetation\" means any living plants e.g. trees, shrubs, grass. The term \"plants\" refers to the kingdom of plants in the modern classification which excludes fungi. Plants are autotrophs i.e. \"producers\" of biomass using carbon obtained from carbon dioxide. \"Litter\" is dead plant material in or above the soil. It is distinct from coarse wood debris. The precise distinction between \"fine\" and \"coarse\" is model dependent. The \"soil content\" of a quantity refers to the vertical integral from the surface down to the bottom of the soil model. For the content between specified levels in the soil, standard names including \"content_of_soil_layer\" are used."@en;
        skos:notation          "SDN:P07::E36YCN7I";
        skos:note              "accepted"@en;
        skos:prefLabel         "change_over_time_in_thermal_energy_content_of_vegetation_and_litter_and_soil"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/JMSQ/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N701/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N701";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N701";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N701/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_ethene/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_ethene>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AEYN/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for ethene is C2H4. Ethene is a member of the group of hydrocarbons known as alkenes.  There are standard names for the alkene group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::CF12N701";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_ethene"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0266/>
        rdf:type               skos:Concept;
