<http://vocab.nerc.ac.uk/collection/P07/current/XFHIHPTN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XFHIHPTN";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::XFHIHPTN";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/XFHIHPTN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_15O_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_15O_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"O\" means the element \"oxygen\" and \"15O\" is the isotope \"oxygen-15\" with a half-life of 1.41e-03 days."@en;
        skos:notation          "SDN:P07::XFHIHPTN";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_15O_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N618/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N618";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CF12N618";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N618/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N618/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_cfc12_due_to_emission/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_cfc12_due_to_emission>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G146/>;
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. earth's surface). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. The chemical formula for CFC12 is CF2Cl2. The IUPAC name for CFC12 is dichloro(difluoro)methane."@en;
        skos:notation          "SDN:P07::CF12N618";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_cfc12_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/FZAT6UAR/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::FZAT6UAR";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::FZAT6UAR";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CF12N101/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/FZAT6UAR/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/FZAT6UAR/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_sulfate_dry_aerosol_particles/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_sulfate_dry_aerosol_particles>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The chemical formula for the sulfate anion is SO4(2-)."@en;
        skos:notation          "SDN:P07::FZAT6UAR";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_sulfate_dry_aerosol_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N101/>
        rdf:type               skos:Concept;
