<http://vocab.nerc.ac.uk/collection/P07/current/CF12N79/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N79";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N79";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N79/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N79/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrate_radical/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrate_radical>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The chemical formula for nitrate is NO3. In chemistry, a \"radical\" is a highly reactive, and therefore short lived, species."@en;
        skos:notation          "SDN:P07::CF12N79";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_nitrate_radical"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

