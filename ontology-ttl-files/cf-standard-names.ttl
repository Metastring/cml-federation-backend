<http://vocab.nerc.ac.uk/collection/P07/current/T4NL95LO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::T4NL95LO";
        dc:date                "2023-02-06 17:17:13.0";
        dc:identifier          "SDN:P07::T4NL95LO";
        pav:authoredOn         "2023-02-06 17:17:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/T4NL95LO/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_sea_water_y_velocity/> , <http://mmisw.org/ont/cf/parameter/surface_sea_water_y_velocity>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A velocity is a vector quantity. \"y\" indicates a vector component along the grid y-axis, positive with increasing y. Ocean currents are related to phenomena of different nature and processes, such as density currents, currents raised by the wind, tide, wave propagation, mass flow in estuaries, etc. This Standard Name refers to the sum of currents of all origins."@en;
        skos:notation          "SDN:P07::T4NL95LO";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_sea_water_y_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

