<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0293/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0293";
        dc:date                "2018-10-15 12:56:49.0";
        dc:identifier          "SDN:P07::CFSN0293";
        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0293/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0293/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_carbon_dioxide_partial_pressure_difference_between_air_and_sea_water> , <http://vocab.nerc.ac.uk/standard_name/surface_carbon_dioxide_partial_pressure_difference_between_air_and_sea_water/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G674/> , <http://vocab.nerc.ac.uk/collection/P04/current/G883/> , <http://vocab.nerc.ac.uk/collection/P04/current/G132/> , <http://vocab.nerc.ac.uk/collection/P64/current/G883/>;
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. The chemical formula for carbon dioxide is CO2. The partial pressure of a dissolved gas in sea water is the partial pressure in air with which it would be in equilibrium. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged. The partial pressure difference between air and sea water is positive when the partial pressure in air is greater than the partial pressure of the dissolved gas in sea water."@en;
        skos:notation          "SDN:P07::CFSN0293";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_carbon_dioxide_partial_pressure_difference_between_air_and_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> , <http://vocab.nerc.ac.uk/collection/P02/current/ACO2/> , <http://vocab.nerc.ac.uk/collection/P02/current/PCO2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/XW8VAQDP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XW8VAQDP";
        dc:date                "2026-06-08 13:55:32.0";
