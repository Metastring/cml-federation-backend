<http://vocab.nerc.ac.uk/collection/P07/current/OESLPJLG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::OESLPJLG";
        dc:date                "2026-06-08 13:55:32.0";
        dc:identifier          "SDN:P07::OESLPJLG";
        pav:authoredOn         "2026-06-08 13:55:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/OESLPJLG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
