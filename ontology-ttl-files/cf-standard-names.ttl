<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N2";
        dc:date                "2008-10-21 10:00:00.0";
        dc:identifier          "SDN:P07::CFV10N2";
        pav:authoredOn         "2008-10-21 10:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N2/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/altimeter_range_correction_due_to_dry_troposphere> , <http://vocab.nerc.ac.uk/standard_name/altimeter_range_correction_due_to_dry_troposphere/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase.   To apply the altimeter range correction it must be added to the quantity with standard name altimeter_range.  \"Correction_due_to_dry_troposphere\" means a correction for dry gases in the troposphere, i.e. excluding the effect of liquid water.  Additional altimeter range corrections are given by the quantities with standard names altimeter_range_correction_due_to_wet_troposphere, altimeter_range_correction_due_to_ionosphere, sea_surface_height_correction_due_to_air_pressure_at_low_frequency and sea_surface_height_correction_due_to_air_pressure_and_wind_at_high_frequency."@en;
        skos:notation          "SDN:P07::CFV10N2";
        skos:note              "accepted"@en;
        skos:prefLabel         "altimeter_range_correction_due_to_dry_troposphere"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> , <http://vocab.nerc.ac.uk/collection/P02/current/ASLV/> , <http://vocab.nerc.ac.uk/collection/P04/current/H021/> , <http://vocab.nerc.ac.uk/collection/P64/current/H021/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A31/>
        rdf:type               skos:Concept;
