        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pu\" means the element \"plutonium\" and \"236Pu\" is the isotope \"plutonium-236\" with a half-life of 1.04e+03 days."@en;
        skos:notation          "SDN:P07::EVP6UON0";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_236Pu_in_air"@en;
