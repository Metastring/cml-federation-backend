        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_214Pb_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_214Pb_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pb\" means the element \"lead\" and \"214Pb\" is the isotope \"lead-214\" with a half-life of 1.86e-02 days."@en;
        skos:notation          "SDN:P07::Q8VK3QCB";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_214Pb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1126VIXB/>
        rdf:type               skos:Concept;
