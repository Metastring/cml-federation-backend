        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/UBNDM2MJ/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_acetaldehyde_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_acetaldehyde_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Mole fraction is used in the construction \"mole_fraction_of_X_in_Y\", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for acetaldehyde is CH3CHO. The IUPAC name for acetaldehyde is ethanal."@en;
        skos:notation          "SDN:P07::UBNDM2MJ";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_acetaldehyde_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/PTKPZ95L/>
        rdf:type               skos:Concept;
