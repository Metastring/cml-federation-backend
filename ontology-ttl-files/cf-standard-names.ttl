        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::N5S4NYBR";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/N5S4NYBR/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
