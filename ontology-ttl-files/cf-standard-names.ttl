        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sn\" means the element \"tin\" and \"126Sn\" is the isotope \"tin-126\" with a half-life of 3.65e+07 days."@en;
        skos:notation          "SDN:P07::PGFUZ9AW";
