        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Rb\" means the element \"rubidium\" and \"89Rb\" is the isotope \"rubidium-89\" with a half-life of 1.06e-02 days."@en;
        skos:notation          "SDN:P07::JFA82K4S";
