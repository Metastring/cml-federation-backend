        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Y\" means the element \"yttrium\" and \"94Y\" is the isotope \"yttrium-94\" with a half-life of 1.32e-02 days."@en;
        skos:notation          "SDN:P07::5QBGU843";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_94Y"@en;
