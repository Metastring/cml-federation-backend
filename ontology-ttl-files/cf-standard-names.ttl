        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ga\" means the element \"gallium\" and \"72Ga\" is the isotope \"gallium-72\" with a half-life of 5.86e-01 days."@en;
        skos:notation          "SDN:P07::HWYL69EA";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_72Ga_in_air"@en;
