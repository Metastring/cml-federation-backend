        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_139Ba/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_139Ba>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ba\" means the element \"barium\" and \"139Ba\" is the isotope \"barium-139\" with a half-life of 5.77e-02 days."@en;
        skos:notation          "SDN:P07::UPTR5U8R";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_139Ba"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/96Q65MFL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::96Q65MFL";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::96Q65MFL";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/96Q65MFL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_41Ar/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_41Ar>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ar\" means the element \"argon\" and \"41Ar\" is the isotope \"argon-41\" with a half-life of 7.64e-02 days."@en;
        skos:notation          "SDN:P07::96Q65MFL";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_41Ar"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N747/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N747";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::CF12N747";
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N747/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N747/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N747/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_number_content_of_aerosol_particles_due_to_gravitational_settling> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_number_content_of_aerosol_particles_due_to_gravitational_settling/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/H316/> , <http://vocab.nerc.ac.uk/collection/P04/current/H316/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. The sum of turbulent deposition and gravitational settling is dry deposition. \"tendency_of_X\" means derivative of X with respect to time."@en;
        skos:notation          "SDN:P07::CF12N747";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_number_content_of_aerosol_particles_due_to_gravitational_settling"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2S2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/J520JST3/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::J520JST3";
        dc:date                "2024-12-16 16:23:21.0";
        dc:identifier          "SDN:P07::J520JST3";
        pav:authoredOn         "2024-12-16 16:23:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/J520JST3/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/J520JST3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/upwelling_longwave_flux_in_air_assuming_clear_sky_and_reference_mole_fraction_of_ozone_in_air/> , <http://mmisw.org/ont/cf/parameter/upwelling_longwave_flux_in_air_assuming_clear_sky_and_reference_mole_fraction_of_ozone_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The term \"longwave\" means longwave radiation. Upwelling radiation is radiation from below. It does not mean \"net upward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. \"Clear sky\" means in the absence of clouds. This 3D ozone field acts as a reference ozone field in a diagnostic call to the model's radiation scheme. It is expressed in terms of mole fraction of ozone in air. It may be observation-based or model-derived. It may be from any time period. By using the same ozone reference in the diagnostic radiation call in two model simulations and calculating differences between the radiative flux diagnostics from the prognostic call to the radiation scheme and the diagnostic call to the radiation scheme with the ozone reference, an instantaneous radiative forcing for ozone can be calculated."@en;
        skos:notation          "SDN:P07::J520JST3";
        skos:note              "accepted"@en;
        skos:prefLabel         "upwelling_longwave_flux_in_air_assuming_clear_sky_and_reference_mole_fraction_of_ozone_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CAEP7HDI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CAEP7HDI";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::CAEP7HDI";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CAEP7HDI/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CAEP7HDI/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_biological_taxon_expressed_as_wet_weight_in_sea_water/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Total biomass or biomass per age group in years (standard birth date January 1) of various fish species as identified by their taxonomic name (e.g. Sardina pilchardus) in gram per m3. \"Biological taxon\" is a name or other label identifying an organism or a group of organisms as belonging to a unit of classification in a hierarchical taxonomy. There must be an auxiliary coordinate variable with standard name biological_taxon_name to identify the taxon in human readable format and optionally an auxiliary coordinate variable with standard name biological_taxon_identifier to provide a machine-readable identifier. See Section 6.1.2 of the CF convention (version 1.8 or later) for information about biological taxon auxiliary coordinate variables. Wet weight is the weight of a material, organism, or sample including its water (moisture) content, measured before drying."@en;
        skos:notation          "SDN:P07::CAEP7HDI";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_biological_taxon_expressed_as_wet_weight_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UGMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/R3Z9T14A/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::R3Z9T14A";
        dc:date                "2018-06-11 18:10:05.0";
        dc:identifier          "SDN:P07::R3Z9T14A";
        pav:authoredOn         "2018-06-11 18:10:05.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/R3Z9T14A/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_mole_concentration_of_ox_in_air_due_to_chemical_and_photolytic_production/> , <http://mmisw.org/ont/cf/parameter/tendency_of_mole_concentration_of_ox_in_air_due_to_chemical_and_photolytic_production>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction \"mole_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The term \"ox\" means a combination of three radical species containing 1 or 3 oxygen atoms: O + O1d + O3. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. The phrase \"chemical and photolytic production\" means the result of all chemical and photolytic reactions within the medium (here, atmosphere) that produce a certain amount of the particular species."@en;
        skos:notation          "SDN:P07::R3Z9T14A";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_mole_concentration_of_ox_in_air_due_to_chemical_and_photolytic_production"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MM3S/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0553/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0553";
        dc:date                "2018-04-16 15:20:51.0";
        dc:identifier          "SDN:P07::CFSN0553";
        pav:authoredOn         "2018-04-16 15:20:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0553/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0553/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/litter_carbon_flux> , <http://vocab.nerc.ac.uk/standard_name/litter_carbon_flux/> , <http://vocab.nerc.ac.uk/collection/P07/current/MGOP5BFS/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G431/> , <http://vocab.nerc.ac.uk/collection/P64/current/G431/>;
        skos:definition        "'Litter carbon' is dead inorganic material in or above the soil quantified as the mass of carbon which it contains. The litter carbon flux is the rate of production of litter. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0553";
        skos:note              "deprecated"@en;
        skos:prefLabel         "litter_carbon_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/MGOP5BFS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MGOP5BFS";
        dc:date                "2018-04-16 15:20:49.0";
        dc:identifier          "SDN:P07::MGOP5BFS";
        pav:authoredOn         "2018-04-16 15:20:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/MGOP5BFS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0553/> , <http://vocab.nerc.ac.uk/standard_name/mass_flux_of_carbon_into_litter_from_vegetation/> , <http://mmisw.org/ont/cf/parameter/mass_flux_of_carbon_into_litter_from_vegetation>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. \"Vegetation\" means any living plants e.g. trees, shrubs, grass. \"Litter\" is dead plant material in or above the soil. It is distinct from coarse wood debris. The precise distinction between \"fine\" and \"coarse\" is model dependent. The sum of the quantities with standard names mass_flux_of_carbon_into_litter_from_vegetation_due_to_mortality and mass_flux_of_carbon_into_litter_from_vegetation_due_to_senescence is mass_flux_of_carbon_into_litter_from_vegetation."@en;
        skos:notation          "SDN:P07::MGOP5BFS";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_flux_of_carbon_into_litter_from_vegetation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Y5UYGUUV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Y5UYGUUV";
        dc:date                "2017-07-24 14:37:00.0";
        dc:identifier          "SDN:P07::Y5UYGUUV";
        pav:authoredOn         "2017-07-24 14:37:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Y5UYGUUV/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/Y5UYGUUV/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/thermosteric_change_in_sea_surface_height/> , <http://mmisw.org/ont/cf/parameter/thermosteric_change_in_sea_surface_height>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Sea surface height\" is a time-varying quantity. The thermosteric change in sea surface height is the change in height that a water column having standard temperature zero degrees Celsius would undergo when its temperature is changed to the observed value. The sum of the quantities with standard names thermosteric_change_in_sea_surface_height and halosteric_change_in_sea_surface_height is the total steric change in the water column height, which has the standard name of steric_change_in_sea_surface_height."@en;
        skos:notation          "SDN:P07::Y5UYGUUV";
        skos:note              "accepted"@en;
        skos:prefLabel         "thermosteric_change_in_sea_surface_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BUFYQE5C/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BUFYQE5C";
        dc:date                "2018-03-13 13:56:23.0";
        dc:identifier          "SDN:P07::BUFYQE5C";
        pav:authoredOn         "2018-03-13 13:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/BUFYQE5C/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/soil_mass_content_of_14C/> , <http://mmisw.org/ont/cf/parameter/soil_mass_content_of_14C>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"soil content\" of a quantity refers to the vertical integral from the surface down to the bottom of the soil model. For the content between specified levels in the soil, standard names including \"content_of_soil_layer\" are used. \"C\" means the element carbon and \"14C\" is the radioactive isotope \"carbon-14\", having six protons and eight neutrons and used in radiocarbon dating."@en;
        skos:notation          "SDN:P07::BUFYQE5C";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil_mass_content_of_14C"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/197B7AHO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::197B7AHO";
        dc:date                "2018-10-15 12:56:49.0";
        dc:identifier          "SDN:P07::197B7AHO";
        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/197B7AHO/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/platform_sway/> , <http://mmisw.org/ont/cf/parameter/platform_sway>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Sway is a displacement along an axis that is perpendicular to both the local vertical axis and the nominal forward motion direction of the platform. Sway is relative to the \"at rest\" position of the platform with respect to the axis of displacement. The \"at rest\" position of the platform may change over time. The standard name platform_sway should be chosen only if the sign convention of the data is unknown. For cases where the sign convention of the sway is known, a standard name of platform_sway_starboard or platform_sway_port should be chosen, as appropriate. A \"platform\" is a structure or vehicle that serves as a base for mounting sensors. Platforms include, but are not limited to, satellites, aeroplanes, ships, buoys, instruments, ground stations, and masts."@en;
        skos:notation          "SDN:P07::197B7AHO";
        skos:note              "accepted"@en;
        skos:prefLabel         "platform_sway"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/KXO1F55H/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::KXO1F55H";
        dc:date                "2018-04-16 15:20:49.0";
        dc:identifier          "SDN:P07::KXO1F55H";
        pav:authoredOn         "2018-04-16 15:20:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/KXO1F55H/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/EV1FU5HF/> , <http://vocab.nerc.ac.uk/standard_name/surface_downward_mass_flux_of_14C_dioxide_abiotic_analogue_expressed_as_carbon/> , <http://mmisw.org/ont/cf/parameter/surface_downward_mass_flux_of_14C_dioxide_abiotic_analogue_expressed_as_carbon>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. In ocean biogeochemistry models, an \"abiotic analogue\" is used to simulate the effect on a modelled variable when biological effects on ocean carbon concentration and alkalinity are ignored. The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. \"C\" means the element carbon and \"14C\" is the radioactive isotope \"carbon-14\", having six protons and eight neutrons and used in radiocarbon dating."@en;
        skos:notation          "SDN:P07::KXO1F55H";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_downward_mass_flux_of_14C_dioxide_abiotic_analogue_expressed_as_carbon"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/EV1FU5HF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::EV1FU5HF";
        dc:date                "2018-04-16 15:20:52.0";
        dc:identifier          "SDN:P07::EV1FU5HF";
        pav:authoredOn         "2018-04-16 15:20:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/EV1FU5HF/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/EV1FU5HF/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_downward_mass_flux_of_carbon14_dioxide_abiotic_analogue_expressed_as_carbon/> , <http://mmisw.org/ont/cf/parameter/surface_downward_mass_flux_of_carbon14_dioxide_abiotic_analogue_expressed_as_carbon> , <http://vocab.nerc.ac.uk/collection/P07/current/KXO1F55H/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. In ocean biogeochemistry models, an \"abiotic analogue\" is used to simulate the effect on a modelled variable when biological effects on ocean carbon concentration and alkalinity are ignored. The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Carbon14 is a radioactive isotope of carbon having six protons and eight neutrons, used in radiocarbon dating."@en;
        skos:notation          "SDN:P07::EV1FU5HF";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_downward_mass_flux_of_carbon14_dioxide_abiotic_analogue_expressed_as_carbon"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12S7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12S7";
        dc:date                "2019-05-14 17:27:20.0";
        dc:identifier          "SDN:P07::CF12S7";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N53/>;
