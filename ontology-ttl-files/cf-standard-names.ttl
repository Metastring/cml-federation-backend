        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/A05/current/EV_WAVES/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVST/>;
        skos:definition        "Wave height is defined as the vertical distance from a wave trough to the following wave crest. The maximum wave height is the greatest trough to crest distance measured during the observation period."@en;
        skos:notation          "SDN:P07::JNQS0CMX";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_wave_maximum_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/3H3VKAS4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::3H3VKAS4";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::3H3VKAS4";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/3H3VKAS4/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_83mSe/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_83mSe>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Se\" means the element \"selenium\" and \"83mSe\" is the metastable state of the isotope \"selenium-83\" with a half-life of 8.10e-04 days."@en;
        skos:notation          "SDN:P07::3H3VKAS4";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_83mSe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ESRRFP5B/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ESRRFP5B";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::ESRRFP5B";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ESRRFP5B/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_230Pa_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_230Pa_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pa\" means the element \"protactinium\" and \"230Pa\" is the isotope \"protactinium-230\" with a half-life of 1.77e+01 days."@en;
        skos:notation          "SDN:P07::ESRRFP5B";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_230Pa_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/JG2RKJSF/>
        rdf:type               skos:Concept;
