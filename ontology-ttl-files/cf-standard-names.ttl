        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P64/current/G238/> , <http://vocab.nerc.ac.uk/collection/P04/current/G238/>;
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. Transpiration is the process by which liquid water in plant stomata is transferred as water vapor into the atmosphere."@en;
        skos:notation          "SDN:P07::CFSN0095";
        skos:note              "accepted"@en;
        skos:prefLabel         "transpiration_flux"@en;
