        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/H018/> , <http://vocab.nerc.ac.uk/collection/P64/current/G521/> , <http://vocab.nerc.ac.uk/collection/P04/current/H018/> , <http://vocab.nerc.ac.uk/collection/P25/current/ICESPD/> , <http://vocab.nerc.ac.uk/collection/P02/current/ICEM/> , <http://vocab.nerc.ac.uk/collection/P04/current/G521/>;
        skos:definition        "The phrase \"[horizontal_]divergence_of_X\" means [horizontal] divergence of a vector X; if X does not have a vertical component then \"horizontal\" should be omitted. A velocity is a vector quantity. Sea ice velocity is defined as a two-dimensional vector, with no vertical component. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/> , <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/>;
        skos:notation          "SDN:P07::CFSN0700";
        skos:note              "accepted"@en;
        skos:prefLabel         "divergence_of_sea_ice_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

