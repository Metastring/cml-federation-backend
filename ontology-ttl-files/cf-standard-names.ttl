<http://vocab.nerc.ac.uk/collection/P07/current/HUU4N8QB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HUU4N8QB";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::HUU4N8QB";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HUU4N8QB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_222Fr_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_222Fr_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Fr\" means the element \"francium\" and \"222Fr\" is the isotope \"francium-222\" with a half-life of 1.03e-02 days."@en;
        skos:notation          "SDN:P07::HUU4N8QB";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_222Fr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/13WGHAZA/>
        rdf:type               skos:Concept;
