        skos:note              "deprecated"@en;
        skos:prefLabel         "river_water_volume_transport_out_of_cell"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/CMPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/MHHDT9VU/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MHHDT9VU";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::MHHDT9VU";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/MHHDT9VU/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_250Cm_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_250Cm_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cm\" means the element \"curium\" and \"250Cm\" is the isotope \"curium-250\" with a half-life of 2.52e+06 days."@en;
        skos:notation          "SDN:P07::MHHDT9VU";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_250Cm_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZL5S3XRE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZL5S3XRE";
        dc:date                "2024-09-04 12:51:22.0";
        dc:identifier          "SDN:P07::ZL5S3XRE";
        pav:authoredOn         "2024-09-04 12:51:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZL5S3XRE/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_pm10_sodium_dry_aerosol_particles_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"Pm10 aerosol\" means atmospheric particulate compounds with an aerodynamic diameter of less than or equal to 10 micrometers. The chemical formula for the sodium cation is Na+."@en;
        skos:notation          "SDN:P07::ZL5S3XRE";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_pm10_sodium_dry_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/H12YUA8Y/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::H12YUA8Y";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::H12YUA8Y";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/H12YUA8Y/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_nanophytoplankton_expressed_as_chlorophyll_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_nanophytoplankton_expressed_as_chlorophyll_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Chlorophylls are the green pigments found in most plants, algae and cyanobacteria; their presence is essential for photosynthesis to take place. There are several different forms of chlorophyll that occur naturally. All contain a chlorin ring (chemical formula C20H16N4) which gives the green pigment and a side chain whose structure varies. The naturally occurring forms of chlorophyll contain between 35 and 55 carbon atoms. Nanophytoplankton are phytoplankton between 2 and 20 micrometers in size. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis."@en;
        skos:notation          "SDN:P07::H12YUA8Y";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_nanophytoplankton_expressed_as_chlorophyll_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/EVP6UON0/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::EVP6UON0";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::EVP6UON0";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/EVP6UON0/1/>;
        pav:version            "1";
