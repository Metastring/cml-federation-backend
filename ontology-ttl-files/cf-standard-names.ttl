        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_specific_humidity> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_specific_humidity/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "'tendency_of_X' means derivative of X with respect to time. 'specific' means per unit mass. Specific humidity is the mass fraction of water vapor in (moist) air."@en;
        skos:notation          "SDN:P07::CFSN0152";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_specific_humidity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A17/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A17";
        dc:date                "2010-10-11 13:13:32.0";
        dc:identifier          "SDN:P07::CFV16A17";
