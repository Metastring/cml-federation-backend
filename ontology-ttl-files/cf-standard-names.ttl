        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"In\" means the element \"indium\" and \"117mIn\" is the metastable state of the isotope \"indium-117\" with a half-life of 8.08e-02 days."@en;
        skos:notation          "SDN:P07::0YFCOD6R";
