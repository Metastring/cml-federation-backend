        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pu\" means the element \"plutonium\" and \"241Pu\" is the isotope \"plutonium-241\" with a half-life of 4.83e+03 days."@en;
        skos:notation          "SDN:P07::JX6F9PUV";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_241Pu_in_air"@en;
