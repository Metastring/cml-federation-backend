<http://vocab.nerc.ac.uk/collection/P07/current/EKV6A6ZU/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::EKV6A6ZU";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::EKV6A6ZU";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/EKV6A6ZU/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/fractional_saturation_of_calcite_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Fractional saturation is the ratio of some measure of concentration to the saturated value of the same quantity. Above 1 the solution is supersaturated, below 1 the solution is undersaturated, at 1 it is at the equilibrium. Calcite is a mineral that is a polymorph of calcium carbonate. The chemical formula of calcite is CaCO3. Standard names also exist for aragonite, another polymorph of calcium carbonate. This variable is also referred to as calcite saturation state."@en;
        skos:notation          "SDN:P07::EKV6A6ZU";
        skos:note              "accepted"@en;
        skos:prefLabel         "fractional_saturation_of_calcite_in_sea_water"@en .

