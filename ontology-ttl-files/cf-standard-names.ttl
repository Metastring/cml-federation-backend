        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1F90YEDV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1F90YEDV";
        dc:date                "2023-07-05 16:51:32.0";
        dc:identifier          "SDN:P07::1F90YEDV";
        pav:authoredOn         "2023-07-05 16:51:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1F90YEDV/1/>;
