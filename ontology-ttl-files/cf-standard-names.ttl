<http://vocab.nerc.ac.uk/collection/P07/current/DVVYBJYV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DVVYBJYV";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::DVVYBJYV";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/DVVYBJYV/1/>;
