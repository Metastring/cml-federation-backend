<http://vocab.nerc.ac.uk/collection/P07/current/77WJMSK1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::77WJMSK1";
        dc:date                "2025-05-13 08:28:41.0";
        dc:identifier          "SDN:P07::77WJMSK1";
        pav:authoredOn         "2025-05-13 08:28:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/77WJMSK1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/stratiform_solid_precipitation_flux/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Stratiform precipitation, whether liquid or frozen, is precipitation that formed in stratiform cloud. Solid precipitation refers to the precipitation of water in the solid phase. Water in the atmosphere exists in one of three phases: solid, liquid or vapor. The solid phase can exist as snow, hail, graupel, cloud ice, or as a component of aerosol. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::77WJMSK1";
        skos:note              "accepted"@en;
        skos:prefLabel         "stratiform_solid_precipitation_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BBAH2149/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BBAH2149";
