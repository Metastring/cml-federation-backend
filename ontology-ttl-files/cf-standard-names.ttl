        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G254/> , <http://vocab.nerc.ac.uk/collection/P04/current/G985/> , <http://vocab.nerc.ac.uk/collection/P04/current/G254/> , <http://vocab.nerc.ac.uk/collection/P64/current/G985/>;
        skos:definition        "Absolute vorticity is the sum of relative vorticity and the upward component of vorticity due to the Earth's rotation."@en;
