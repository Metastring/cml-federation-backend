        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_137mBa/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_137mBa>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ba\" means the element \"barium\" and \"137mBa\" is the metastable state of the isotope \"barium-137\" with a half-life of 1.77e-03 days."@en;
        skos:notation          "SDN:P07::TXVBVX0A";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_137mBa"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DE12EGZX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DE12EGZX";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::DE12EGZX";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/DE12EGZX/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/DE12EGZX/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_solid_precipitation_falling_onto_surface_snow/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_solid_precipitation_falling_onto_surface_snow>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The quantity with standard name mass_fraction_of_solid_precipitation_falling_onto_surface_snow is the mass of solid precipitation falling onto snow as a fraction of the mass of solid precipitation falling within the area of interest. Solid precipitation refers to the precipitation of water in the solid phase. Water in the atmosphere exists in one of three phases: solid, liquid or vapor. The solid phase can exist as snow, hail, graupel, cloud ice, or as a component of aerosol. Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants. Unless indicated in the cell_methods attribute, a quantity is assumed to apply to the whole area of each horizontal grid box."@en;
        skos:notation          "SDN:P07::DE12EGZX";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_solid_precipitation_falling_onto_surface_snow"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/J1DE5RG2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::J1DE5RG2";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::J1DE5RG2";
