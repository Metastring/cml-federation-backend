        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hypobromous acid is HOBr."@en;
        skos:notation          "SDN:P07::CF12N476";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_hypobromous_acid_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/6JIASUY6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::6JIASUY6";
        dc:date                "2017-01-24 16:10:06.0";
        dc:identifier          "SDN:P07::6JIASUY6";
        pav:authoredOn         "2017-01-24 16:10:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/6JIASUY6/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_petroleum_hydrocarbons_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_petroleum_hydrocarbons_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Petroleum hydrocarbons are compounds containing just carbon and hydrogen originating from the fossil fuel crude oil."@en;
        skos:notation          "SDN:P07::6JIASUY6";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_petroleum_hydrocarbons_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N30/>
        rdf:type               skos:Concept;
