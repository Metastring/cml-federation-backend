<http://vocab.nerc.ac.uk/collection/P07/current/QFH8H7WY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::QFH8H7WY";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::QFH8H7WY";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/QFH8H7WY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
