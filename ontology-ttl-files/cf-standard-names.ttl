<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N36/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N36";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::CFV10N36";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N36/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N36/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N36/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/sea_surface_height_amplitude_due_to_equilibrium_ocean_tide> , <http://vocab.nerc.ac.uk/standard_name/sea_surface_height_amplitude_due_to_equilibrium_ocean_tide/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/H026/> , <http://vocab.nerc.ac.uk/collection/P02/current/ASLV/> , <http://vocab.nerc.ac.uk/collection/P04/current/H026/> , <http://vocab.nerc.ac.uk/collection/P04/current/H021/> , <http://vocab.nerc.ac.uk/collection/P64/current/H021/>;
        skos:definition        "\"Sea surface height\" is a time-varying quantity. Amplitude is the magnitude of a periodic variation modeled by a sinusoidal function. A coordinate variable of harmonic_period should be used to specify the period of the sinusoidal function. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. Tides are a significant contributor to the observed sea surface height; equilibrium ocean tide refers to the long period ocean tide."@en;
        skos:notation          "SDN:P07::CFV10N36";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_height_amplitude_due_to_equilibrium_ocean_tide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/SKKKZ5IE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::SKKKZ5IE";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::SKKKZ5IE";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/SKKKZ5IE/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_86mRb/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_86mRb>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Rb\" means the element \"rubidium\" and \"86mRb\" is the metastable state of the isotope \"rubidium-86\" with a half-life of 7.04e-04 days."@en;
        skos:notation          "SDN:P07::SKKKZ5IE";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_86mRb"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Y7DOPPZ1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Y7DOPPZ1";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::Y7DOPPZ1";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Y7DOPPZ1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_130mSb_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_130mSb_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sb\" means the element \"antimony\" and \"130mSb\" is the metastable state of the isotope \"antimony-130\" with a half-life of 4.58e-03 days."@en;
        skos:notation          "SDN:P07::Y7DOPPZ1";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_130mSb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N798/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N798";
        dc:date                "2018-05-29 16:57:01.0";
        dc:identifier          "SDN:P07::CF12N798";
        pav:authoredOn         "2018-05-29 16:57:01.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N798/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N798/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/virtual_salt_flux_into_sea_water_from_rivers> , <http://vocab.nerc.ac.uk/standard_name/virtual_salt_flux_into_sea_water_from_rivers/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The virtual_salt_flux_into_sea_water_due_to_process is the salt flux that would have the same effect on the sea surface salinity as water_flux_out_of_sea_water_due_to_process. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. \"River\" refers to water in the fluvial system (stream and floodplain)."@en;
        skos:notation          "SDN:P07::CF12N798";
        skos:note              "accepted"@en;
        skos:prefLabel         "virtual_salt_flux_into_sea_water_from_rivers"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P04/current/G996/> , <http://vocab.nerc.ac.uk/collection/P64/current/G996/> , <http://vocab.nerc.ac.uk/collection/P02/current/VDFC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Q3F950J9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Q3F950J9";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::Q3F950J9";
        pav:authoredOn         "2018-02-12 16:53:18.0";
