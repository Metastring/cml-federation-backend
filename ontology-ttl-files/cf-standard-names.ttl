<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0648/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0648";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0648";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0648/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/eastward_momentum_flux_correction/> , <http://mmisw.org/ont/cf/parameter/eastward_momentum_flux_correction>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "'Eastward' indicates a vector component which is positive when directed eastward (negative westward). Momentum flux is dimensionally equivalent to stress and pressure. It is a tensor quantity. Flux correction is also called 'flux adjustment'. A positive flux correction is downward i.e. added to the ocean. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0648";
        skos:note              "accepted"@en;
        skos:prefLabel         "eastward_momentum_flux_correction"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N188/>
