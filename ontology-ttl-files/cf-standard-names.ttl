        pav:authoredOn         "2018-08-06 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV13A10/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV13A10/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV13A10/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_specific_humidity_due_to_stratiform_precipitation> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_specific_humidity_due_to_stratiform_precipitation/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0825/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G239/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/>;
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. Specific humidity is the mass fraction of water vapor in (moist) air. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes). \"Precipitation\" in the earth's atmosphere means precipitation of water in all phases."@en;
        skos:notation          "SDN:P07::CFV13A10";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_specific_humidity_due_to_stratiform_precipitation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/C78TD60O/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::C78TD60O";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::C78TD60O";
