<http://vocab.nerc.ac.uk/collection/P07/current/QC18UPHB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::QC18UPHB";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::QC18UPHB";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/QC18UPHB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_roughness_length_for_humidity_in_air/> , <http://mmisw.org/ont/cf/parameter/surface_roughness_length_for_humidity_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The height above the surface where the mean value of humidity assumes its surface value when extrapolated along a logarithmic profile downward towards the surface. The surface called \"surface\" means the lower boundary of the atmosphere."@en;
        skos:notation          "SDN:P07::QC18UPHB";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_roughness_length_for_humidity_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

