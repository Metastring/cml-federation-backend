        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Zr\" means the element \"zirconium\" and \"93Zr\" is the isotope \"zirconium-93\" with a half-life of 3.47e+08 days."@en;
        skos:notation          "SDN:P07::2DHX2I5G";
        skos:note              "accepted"@en;
