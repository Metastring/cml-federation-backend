        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Se\" means the element \"selenium\" and \"81Se\" is the isotope \"selenium-81\" with a half-life of 1.28e-02 days."@en;
        skos:notation          "SDN:P07::FLOU27N7";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_81Se_in_air"@en;
