        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"I\" means the element \"iodine\" and \"133mI\" is the metastable state of the isotope \"iodine-133\" with a half-life of 1.04e-04 days."@en;
        skos:notation          "SDN:P07::X2UNXGGP";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_133mI"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N68/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N68";
        dc:date                "2008-06-10 23:59:00.0";
        dc:identifier          "SDN:P07::CFV8N68";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/CFV9S3/>;
        pav:authoredOn         "2008-06-10 23:59:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N68/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV9S3/> , <http://vocab.nerc.ac.uk/standard_name/northward_heat_flux_due_to_eddy_advection/> , <http://mmisw.org/ont/cf/parameter/northward_heat_flux_due_to_eddy_advection>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Northward\" indicates a vector component which is positive when directed northward (negative southward).  In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFV8N68";
        skos:note              "deprecated"@en;
        skos:prefLabel         "northward_heat_flux_due_to_eddy_advection"@en .

