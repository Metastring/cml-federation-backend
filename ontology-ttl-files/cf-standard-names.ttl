<http://vocab.nerc.ac.uk/collection/P07/current/5D4D7YMF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::5D4D7YMF";
        dc:date                "2019-12-09 17:20:23.0";
        dc:identifier          "SDN:P07::5D4D7YMF";
