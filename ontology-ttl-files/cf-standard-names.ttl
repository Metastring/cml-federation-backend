        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Am\" means the element \"americium\" and \"241Am\" is the isotope \"americium-241\" with a half-life of 1.67e+05 days."@en;
        skos:notation          "SDN:P07::LWFJPDBL";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_241Am_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0362/>
        rdf:type               skos:Concept;
