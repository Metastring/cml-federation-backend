        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G287/> , <http://vocab.nerc.ac.uk/collection/P64/current/G287/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G284/> , <http://vocab.nerc.ac.uk/collection/P64/current/G284/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_RAIN/>;
        skos:definition        "\"Precipitation\" in the earth's atmosphere means precipitation of water in all phases. The abbreviation \"lwe\" means liquid water equivalent. \"Precipitation rate\" means the depth or thickness of the layer formed by precipitation per unit time."@en;
        skos:notation          "SDN:P07::CFSN0559";
        skos:note              "accepted"@en;
        skos:prefLabel         "lwe_precipitation_rate"@en;
