        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Th\" means the element \"thorium\" and \"232Th\" is the isotope \"thorium-232\" with a half-life of 5.14e+12 days."@en;
        skos:notation          "SDN:P07::9WCH2TYI";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_232Th"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N50/>
        rdf:type               skos:Concept;
