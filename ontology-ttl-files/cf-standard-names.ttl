        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N40/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_ethane/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_ethane>;
