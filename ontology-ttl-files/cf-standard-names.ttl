        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G499/> , <http://vocab.nerc.ac.uk/collection/P04/current/G498/> , <http://vocab.nerc.ac.uk/collection/P04/current/G614/> , <http://vocab.nerc.ac.uk/collection/P04/current/G615/> , <http://vocab.nerc.ac.uk/collection/P64/current/G499/> , <http://vocab.nerc.ac.uk/collection/P64/current/G498/>;
        skos:definition        "\"Land ice\" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  Specific mass balance means the net rate at which ice is added per unit area at the land ice surface.  \"lwe\" means liquid water equivalent."@en;
