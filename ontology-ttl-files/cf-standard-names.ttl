        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_115Cd_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_115Cd_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cd\" means the element \"cadmium\" and \"115Cd\" is the isotope \"cadmium-115\" with a half-life of 2.23e+00 days."@en;
        skos:notation          "SDN:P07::WUA4S6BY";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_115Cd_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

