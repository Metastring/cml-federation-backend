        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Number concentration\" means the number of particles or other specified objects per unit volume. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself."@en;
        skos:notation          "SDN:P07::TEHBIMF8";
        skos:note              "accepted"@en;
        skos:prefLabel         "number_concentration_of_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPMM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/MF0NXXIX/>
