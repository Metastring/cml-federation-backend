        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_mass_content_of_water_vapor_in_atmosphere_layer_due_to_turbulence> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_mass_content_of_water_vapor_in_atmosphere_layer_due_to_turbulence/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0136/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
