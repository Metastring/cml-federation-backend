        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Te\" means the element \"tellurium\" and \"132Te\" is the isotope \"tellurium-132\" with a half-life of 3.25e+00 days."@en;
        skos:notation          "SDN:P07::LXDNXW01";
        skos:note              "accepted"@en;
