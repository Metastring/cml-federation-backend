        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Br\" means the element \"bromine\" and \"84Br\" is the isotope \"bromine-84\" with a half-life of 2.21e-02 days."@en;
        skos:notation          "SDN:P07::QQI00BDI";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_84Br_in_air"@en;
