        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sb\" means the element \"antimony\" and \"128mSb\" is the metastable state of the isotope \"antimony-128\" with a half-life of 7.23e-03 days."@en;
        skos:notation          "SDN:P07::A5P9XBT8";
