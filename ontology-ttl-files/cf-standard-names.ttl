        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Te\" means the element \"tellurium\" and \"127Te\" is the isotope \"tellurium-127\" with a half-life of 3.91e-01 days."@en;
        skos:notation          "SDN:P07::LKOOYMTP";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_127Te_in_air"@en;
