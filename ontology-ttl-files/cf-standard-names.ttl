        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/reference_sea_water_density_for_boussinesq_approximation> , <http://vocab.nerc.ac.uk/standard_name/reference_sea_water_density_for_boussinesq_approximation/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G990/> , <http://vocab.nerc.ac.uk/collection/P64/current/G990/>;
        skos:definition        "Sea water density is the in-situ density (not the potential density). For a rigid lid Boussinesq geopotential ocean model the density of the sea water is maintained at a constant reference density.  In a model using the rigid lid Boussinesq approximation , the vertical grid coordinates (and hence the grid cell volumes) are time invariant."@en;
        skos:notation          "SDN:P07::CF12N577";
        skos:note              "accepted"@en;
        skos:prefLabel         "reference_sea_water_density_for_boussinesq_approximation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> , <http://vocab.nerc.ac.uk/collection/P02/current/SIGT/> .

