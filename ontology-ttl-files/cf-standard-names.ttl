        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/K88UQGUS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/dry_soil_density/> , <http://mmisw.org/ont/cf/parameter/dry_soil_density>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The density of the soil after oven drying until constant mass is reached. Volume is determined from the field sample volume. The density of a substance is its mass per unit volume."@en;
        skos:notation          "SDN:P07::K88UQGUS";
        skos:note              "accepted"@en;
        skos:prefLabel         "dry_soil_density"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Z4JJUOOO/>
        rdf:type               skos:Concept;
