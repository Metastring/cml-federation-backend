        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Mercury means mercury in all chemical forms, commonly referred to as \"total mercury\". \"Sea floor sediment\" is sediment deposited at the sea bed."@en;
        skos:notation          "SDN:P07::S0T41QA6";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_mercury_in_sea_floor_sediment"@en;
