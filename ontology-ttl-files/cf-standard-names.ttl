        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_alpha_pinene/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_alpha_pinene>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OHAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G140/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for alpha_pinene is C10H16. The IUPAC name for alpha-pinene is (1S,5S)-2,6,6-trimethylbicyclo[3.1.1]hept-2-ene."@en;
        skos:notation          "SDN:P07::CF12N112";
