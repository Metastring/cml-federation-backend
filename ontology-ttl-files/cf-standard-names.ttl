<http://vocab.nerc.ac.uk/collection/P07/current/HWVJLD32/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::HWVJLD32";
        dc:date                "2023-04-24 17:39:19.0";
        dc:identifier          "SDN:P07::HWVJLD32";
        pav:authoredOn         "2023-04-24 17:39:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/HWVJLD32/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/volume_extinction_angstrom_exponent_in_air_due_to_ambient_aerosol_particles/> , <http://mmisw.org/ont/cf/parameter/volume_extinction_angstrom_exponent_in_air_due_to_ambient_aerosol_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The volume extinction Angstrom exponent is the Angstrom exponent obtained for the aerosol extinction instead that for the aerosol optical thickness. It is alpha in the following equation relating aerosol extinction (ext) at the wavelength lambda to aerosol extinction at a different wavelength lambda0: ext(lambda) = ext(lambda0) * [lambda/lambda0] ** (-1 * alpha). \"Ambient_aerosol\" means that the aerosol is measured or modelled at the ambient state of pressure, temperature and relative humidity that exists in its immediate environment. \"Ambient aerosol particles\" are aerosol particles that have taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the particles. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::HWVJLD32";
        skos:note              "accepted"@en;
        skos:prefLabel         "volume_extinction_angstrom_exponent_in_air_due_to_ambient_aerosol_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N699/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N699";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N699";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N699/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_ethane/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_ethane>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AALK/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for ethane is C2H6. Ethane is a member of the group of hydrocarbons known as alkanes.  There are standard names for the alkane group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::CF12N699";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_ethane"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/AUZF4N4K/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::AUZF4N4K";
        dc:date                "2018-02-12 16:53:18.0";
