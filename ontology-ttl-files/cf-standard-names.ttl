<http://vocab.nerc.ac.uk/collection/P07/current/FKH485EY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::FKH485EY";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::FKH485EY";
