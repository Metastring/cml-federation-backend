<http://vocab.nerc.ac.uk/collection/P07/current/KFMFX4NW/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::KFMFX4NW";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::KFMFX4NW";
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/KFMFX4NW/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/KFMFX4NW/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_acetaldehyde_due_to_dry_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_acetaldehyde_due_to_dry_deposition>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Dry deposition\" is the sum of turbulent deposition and gravitational settling. \"tendency_of_X\" means derivative of X with respect to time. The chemical formula for acetaldehyde is CH3CHO. The IUPAC name for acetaldehyde is ethanal."@en;
        skos:notation          "SDN:P07::KFMFX4NW";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_acetaldehyde_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

