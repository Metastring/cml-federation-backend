        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"C\" means the element \"carbon\" and \"11C\" is the isotope \"carbon-11\" with a half-life of 1.41e-02 days."@en;
        skos:notation          "SDN:P07::8RAJNMMQ";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_11C_in_air"@en;
