        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Eu\" means the element \"europium\" and \"155Eu\" is the isotope \"europium-155\" with a half-life of 1.75e+03 days."@en;
        skos:notation          "SDN:P07::3AHMBQ1P";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_155Eu_in_air"@en;
