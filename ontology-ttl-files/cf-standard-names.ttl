        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/PHOS/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. \"tendency_of_X\" means derivative of X with respect to time. \"Dissolved inorganic phosphorus\" means the sum of all inorganic phosphorus in solution (including phosphate, hydrogen phosphate, dihydrogen phosphate, and phosphoric acid)."@en;
        skos:notation          "SDN:P07::CF14N111";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_ocean_mole_content_of_dissolved_inorganic_phosphorus"@en;
