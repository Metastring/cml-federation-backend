<http://vocab.nerc.ac.uk/collection/P07/current/3EBOF2CK/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::3EBOF2CK";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::3EBOF2CK";
        pav:authoredOn         "2018-02-12 16:53:18.0";
