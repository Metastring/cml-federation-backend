        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_moles_of_cfc12_in_atmosphere> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12S43/> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_moles_of_cfc12_in_atmosphere/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G146/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"moles_of_X_in_atmosphere\" means the total number of moles of X contained in the entire atmosphere, i.e, summed over the atmospheric column and over the entire globe.    The chemical formula of CFC12 is CF2Cl2.  The IUPAC name for CFC12 is dichloro-difluoro-methane."@en;
        skos:notation          "SDN:P07::CFV8N95";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_moles_of_cfc12_in_atmosphere"@en;
