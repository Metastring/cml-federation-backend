<http://vocab.nerc.ac.uk/collection/P07/current/CF12S53/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12S53";
        dc:date                "2009-07-06 16:21:17.0";
        dc:identifier          "SDN:P07::CF12S53";
