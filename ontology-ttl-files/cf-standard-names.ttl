        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"233U\" is the isotope \"uranium-233\" with a half-life of 5.90e+07 days."@en;
        skos:notation          "SDN:P07::7W9ONFK7";
