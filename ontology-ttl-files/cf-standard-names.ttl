        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::7Y2S1MBH";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CF12N666/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV15A24/>;
