        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_atomic_bromine_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_atomic_bromine_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/H321/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical symbol for atomic bromine is Br."@en;
        skos:notation          "SDN:P07::CF12N222";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_atomic_bromine_in_air"@en;
