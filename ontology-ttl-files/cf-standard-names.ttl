        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_218At/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_218At>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"At\" means the element \"astatine\" and \"218At\" is the isotope \"astatine-218\" with a half-life of 2.31e-05 days."@en;
        skos:notation          "SDN:P07::EPEHJBCO";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_218At"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

