<http://vocab.nerc.ac.uk/collection/P07/current/93K16JTG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::93K16JTG";
        dc:date                "2019-12-09 17:20:23.0";
        dc:identifier          "SDN:P07::93K16JTG";
        pav:authoredOn         "2019-12-09 17:20:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/93K16JTG/1/>;
        pav:version            "1";
