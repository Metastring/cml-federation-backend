        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::IZNL5VNA";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::IZNL5VNA";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/IZNL5VNA/1/>;
        pav:version            "1";
