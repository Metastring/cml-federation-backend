<http://vocab.nerc.ac.uk/collection/P07/current/CF12N570/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N570";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::CF12N570";
        pav:authoredOn         "2019-02-04 14:52:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N570/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N570/1/>;
        pav:version            "2";
