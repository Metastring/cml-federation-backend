<http://vocab.nerc.ac.uk/collection/P07/current/7IQMB8XJ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::7IQMB8XJ";
        dc:date                "2021-09-20 14:41:47.0";
        dc:identifier          "SDN:P07::7IQMB8XJ";
        pav:authoredOn         "2021-09-20 14:41:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/7IQMB8XJ/2/>;
