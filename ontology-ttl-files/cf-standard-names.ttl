<http://vocab.nerc.ac.uk/collection/P07/current/MA6ZA2GF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MA6ZA2GF";
        dc:date                "2016-06-13 14:19:51.0";
        dc:identifier          "SDN:P07::MA6ZA2GF";
        pav:authoredOn         "2016-06-13 14:19:51.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/MA6ZA2GF/1/>;
        pav:version            "1";
