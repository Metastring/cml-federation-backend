        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0224/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_specific_humidity> , <http://vocab.nerc.ac.uk/standard_name/surface_specific_humidity/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "The surface called 'surface' means the lower boundary of the atmosphere. 'specific' means per unit mass. Specific humidity is the mass fraction of water vapor in (moist) air."@en;
        skos:notation          "SDN:P07::CFSN0224";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_specific_humidity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N113/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N113";
