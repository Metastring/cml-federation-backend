        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_ocean_mole_content_of_dissolved_inorganic_silicon/> , <http://mmisw.org/ont/cf/parameter/tendency_of_ocean_mole_content_of_dissolved_inorganic_silicon>;
