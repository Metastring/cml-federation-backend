        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/land_ice_surface_upward_velocity/> , <http://mmisw.org/ont/cf/parameter/land_ice_surface_upward_velocity>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Land ice\" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves. A velocity is a vector quantity. \"Upward\" indicates a vector component which is positive when directed upward (negative downward). The surface called \"surface\" means the lower boundary of the atmosphere."@en;
        skos:notation          "SDN:P07::XZ7V7UUA";
        skos:note              "accepted"@en;
        skos:prefLabel         "land_ice_surface_upward_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/17YDB182/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::17YDB182";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::17YDB182";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/17YDB182/1/>;
