        skos:definition        "Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y.  The chemical symbol of atomic nitrogen is N."@en;
        skos:notation          "SDN:P07::CFV8N12";
        skos:note              "accepted"@en;
