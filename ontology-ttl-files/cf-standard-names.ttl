<http://vocab.nerc.ac.uk/collection/P07/current/UZ0ESYPD/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::UZ0ESYPD";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::UZ0ESYPD";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/UZ0ESYPD/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_stratiform_cloud_rain_particles/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N202/> , <http://mmisw.org/ont/cf/parameter/effective_radius_of_stratiform_cloud_rain_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes)."@en;
        skos:notation          "SDN:P07::UZ0ESYPD";
        skos:note              "accepted"@en;
        skos:prefLabel         "effective_radius_of_stratiform_cloud_rain_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

