<http://vocab.nerc.ac.uk/collection/P07/current/WHO84Y9V/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WHO84Y9V";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::WHO84Y9V";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/WHO84Y9V/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_88Rb_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_88Rb_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Rb\" means the element \"rubidium\" and \"88Rb\" is the isotope \"rubidium-88\" with a half-life of 1.25e-02 days."@en;
        skos:notation          "SDN:P07::WHO84Y9V";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_88Rb_in_air"@en;
