        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nd\" means the element \"neodymium\" and \"152Nd\" is the isotope \"neodymium-152\" with a half-life of 7.94e-03 days."@en;
        skos:notation          "SDN:P07::K3QWPGJ4";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_152Nd"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N55/>
        rdf:type               skos:Concept;
