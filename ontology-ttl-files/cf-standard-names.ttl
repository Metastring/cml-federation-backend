        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Kr\" means the element \"krypton\" and \"88Kr\" is the isotope \"krypton-88\" with a half-life of 1.17e-01 days."@en;
        skos:notation          "SDN:P07::5J2SNT8A";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_88Kr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/KAYPE48I/>
        rdf:type               skos:Concept;
