<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0449/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0449";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0449";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0449/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/potential_energy_content_of_atmosphere_layer/> , <http://mmisw.org/ont/cf/parameter/potential_energy_content_of_atmosphere_layer>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "'Content' indicates a quantity per unit area. 'Layer' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Potential energy is the sum of the gravitational potential energy relative to the geoid and the centripetal potential energy. (The geopotential is the specific potential energy.)"@en;
        skos:notation          "SDN:P07::CFSN0449";
        skos:note              "accepted"@en;
        skos:prefLabel         "potential_energy_content_of_atmosphere_layer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/JMSQ/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N66/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N66";
        dc:date                "2010-05-12 12:47:52.0";
