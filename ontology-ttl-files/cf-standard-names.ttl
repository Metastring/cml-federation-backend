        skos:prefLabel         "solar_zenith_angle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UAAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/US3N6FMX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::US3N6FMX";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::US3N6FMX";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/US3N6FMX/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_stratiform_cloud_snow_particles/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N203/> , <http://mmisw.org/ont/cf/parameter/effective_radius_of_stratiform_cloud_snow_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes)."@en;
        skos:notation          "SDN:P07::US3N6FMX";
        skos:note              "accepted"@en;
        skos:prefLabel         "effective_radius_of_stratiform_cloud_snow_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N203/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N203";
        dc:date                "2019-05-14 17:27:21.0";
        dc:identifier          "SDN:P07::CF12N203";
        pav:authoredOn         "2019-05-14 17:27:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N203/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N203/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/effective_radius_of_stratiform_cloud_snow_particle> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_stratiform_cloud_snow_particle/> , <http://vocab.nerc.ac.uk/collection/P07/current/US3N6FMX/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G280/> , <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G280/>;
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes)."@en;
        skos:notation          "SDN:P07::CF12N203";
        skos:note              "deprecated"@en;
        skos:prefLabel         "effective_radius_of_stratiform_cloud_snow_particle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N631/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N631";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CF12N631";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N631/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N631/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N631/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_halon1301_due_to_emission/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_halon1301_due_to_emission>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G147/>;
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. earth's surface). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. The chemical formula for Halon1301 is CBrF3. The IUPAC name for Halon1301 is bromo(trifluoro)methane."@en;
        skos:notation          "SDN:P07::CF12N631";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_halon1301_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/LHHQBDOU/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::LHHQBDOU";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::LHHQBDOU";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/LHHQBDOU/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_73Ga/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_73Ga>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ga\" means the element \"gallium\" and \"73Ga\" is the isotope \"gallium-73\" with a half-life of 2.03e-01 days."@en;
        skos:notation          "SDN:P07::LHHQBDOU";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_73Ga"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N72/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N72";
        dc:date                "2008-04-15 14:00:00.0";
        dc:identifier          "SDN:P07::CFV8N72";
        pav:authoredOn         "2008-04-15 14:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N72/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/sea_surface_swell_wave_mean_period_from_variance_spectral_density_second_frequency_moment> , <http://vocab.nerc.ac.uk/standard_name/sea_surface_swell_wave_mean_period_from_variance_spectral_density_second_frequency_moment/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G970/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVST/> , <http://vocab.nerc.ac.uk/collection/P64/current/G976/> , <http://vocab.nerc.ac.uk/collection/P04/current/G976/> , <http://vocab.nerc.ac.uk/collection/P64/current/G970/>;
        skos:definition        "The swell wave directional spectrum can be written as a  five dimensional function S(t,x,y,f,theta) where t is time, x and y are horizontal coordinates (such as longitude and latitude), f is frequency and theta is direction.  S can be integrated over direction to give S1= integral(S dtheta).  Frequency moments, M(n) of S1 can then be calculated as follows: M(n) = integral(S1 f^n df), where f^n is f to the power of n.  The second wave period, T(m2), is calculated as the square root of the ratio M(0)/M(2)."@en;
        skos:notation          "SDN:P07::CFV8N72";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_swell_wave_mean_period_from_variance_spectral_density_second_frequency_moment"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UTBB/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0619/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0619";
        dc:date                "2013-01-11 16:56:43.0";
        dc:identifier          "SDN:P07::CFSN0619";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSNA004/>;
        pav:authoredOn         "2013-01-11 16:56:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0619/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0619/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/equivalent_thickness_at_stp_of_atmosphere_ozone_content> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSNA004/> , <http://vocab.nerc.ac.uk/standard_name/equivalent_thickness_at_stp_of_atmosphere_ozone_content/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OZON/> , <http://vocab.nerc.ac.uk/collection/P04/current/G164/>;
        skos:definition        "\"stp\" means standard temperature (0 degC) and pressure (101325 Pa). \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The equivalent thickness at STP of a particular constituent of the atmosphere is the thickness of the layer that the gas would occupy if it was separated from the other constituents and gathered together at STP. equivalent_thickness_at_stp_of_atmosphere_ozone_content is usually measured in Dobson Units which are equivalent to 446.2 micromoles m-2 or an equivalent thickness at STP of 10 micrometers. N.B. Data variables containing column content of ozone can be given the standard name of either equivalent_thickness_at_stp_of_atmosphere_ozone_content or atmosphere_mole_content_of_ozone. The latter name is recommended for consistency with mole content names for chemical species other than ozone."@en;
        skos:notation          "SDN:P07::CFSN0619";
        skos:note              "accepted"@en;
        skos:prefLabel         "equivalent_thickness_at_stp_of_atmosphere_ozone_content"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

