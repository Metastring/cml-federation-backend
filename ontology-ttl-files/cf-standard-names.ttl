        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CXAA/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for formic acid is HCOOH.  The IUPAC name for formic acid is methanoic acid."@en;
        skos:notation          "SDN:P07::CF12N45";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_formic_acid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

