        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0534/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0534/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_convective_cloud_ice_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_convective_cloud_ice_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/>;
        skos:definition        "Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
        skos:notation          "SDN:P07::CFSN0534";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_convective_cloud_ice_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N197/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N197";
        dc:date                "2019-05-14 17:27:21.0";
        dc:identifier          "SDN:P07::CF12N197";
        pav:authoredOn         "2019-05-14 17:27:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N197/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N197/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/effective_radius_of_convective_cloud_rain_particle> , <http://vocab.nerc.ac.uk/collection/P07/current/79GTEIUB/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_convective_cloud_rain_particle/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G280/> , <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G280/>;
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
        skos:notation          "SDN:P07::CF12N197";
        skos:note              "deprecated"@en;
        skos:prefLabel         "effective_radius_of_convective_cloud_rain_particle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/79GTEIUB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::79GTEIUB";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::79GTEIUB";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/79GTEIUB/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CF12N197/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_convective_cloud_rain_particles/> , <http://mmisw.org/ont/cf/parameter/effective_radius_of_convective_cloud_rain_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
        skos:notation          "SDN:P07::79GTEIUB";
        skos:note              "accepted"@en;
        skos:prefLabel         "effective_radius_of_convective_cloud_rain_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N547/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N547";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N547";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N547/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/ocean_kinetic_energy_dissipation_per_unit_area_due_to_xy_friction/> , <http://mmisw.org/ont/cf/parameter/ocean_kinetic_energy_dissipation_per_unit_area_due_to_xy_friction>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Friction, leading to the dissipation of kinetic energy, arises in ocean models as a result of the viscosity of sea water.  Generally, the  lateral (xy) viscosity is given a large value to maintain the numerical stability of the model.  In contrast, the vertical viscosity is usually much smaller. The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase."@en;
        skos:notation          "SDN:P07::CF12N547";
        skos:note              "accepted"@en;
        skos:prefLabel         "ocean_kinetic_energy_dissipation_per_unit_area_due_to_xy_friction"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> , <http://vocab.nerc.ac.uk/collection/P02/current/VDFC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BDD8PD4T/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BDD8PD4T";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::BDD8PD4T";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/BDD8PD4T/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_250Cm/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_250Cm>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Cm\" means the element \"curium\" and \"250Cm\" is the isotope \"curium-250\" with a half-life of 2.52e+06 days."@en;
        skos:notation          "SDN:P07::BDD8PD4T";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_250Cm"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Q8JPIQBO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Q8JPIQBO";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::Q8JPIQBO";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N8/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Q8JPIQBO/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/Q8JPIQBO/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_particles_due_to_wet_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_particles_due_to_wet_deposition>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"Primary particulate organic matter \" means all organic matter emitted directly to the atmosphere as particles except elemental carbon. The sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol is particulate_organic_matter_dry_aerosol. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Wet deposition\" means deposition by precipitation."@en;
        skos:notation          "SDN:P07::Q8JPIQBO";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_particles_due_to_wet_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N8";
        dc:date                "2015-01-07 15:23:09.0";
        dc:identifier          "SDN:P07::CFV7N8";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/Q8JPIQBO/>;
        pav:authoredOn         "2015-01-07 15:23:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N8/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N8/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_due_to_wet_deposition> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_due_to_wet_deposition/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets). Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. \"Dry aerosol\" means aerosol without water. \"Primary particulate organic matter \" means all organic matter emitted directly to the atmosphere as particles except black carbon. The sum of primary_particulate_organic_matter_dry_aerosol and secondary_particulate_organic_matter_dry_aerosol is particulate_organic_matter_dry_aerosol. \"Wet deposition\" means deposition by precipitation."@en;
        skos:notation          "SDN:P07::CFV7N8";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_primary_particulate_organic_matter_dry_aerosol_due_to_wet_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P02/current/AORG/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G109/> , <http://vocab.nerc.ac.uk/collection/P64/current/G109/> .

