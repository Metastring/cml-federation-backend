        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cs\" means the element \"cesium\" and \"137Cs\" is the isotope \"cesium-137\" with a half-life of 1.10e+04 days."@en;
        skos:notation          "SDN:P07::2AUPDSFH";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_137Cs_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

