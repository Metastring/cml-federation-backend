<http://vocab.nerc.ac.uk/collection/P07/current/TZVGZL6S/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::TZVGZL6S";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::TZVGZL6S";
        pav:authoredOn         "2018-02-12 16:53:18.0";
