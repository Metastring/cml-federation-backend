<http://vocab.nerc.ac.uk/collection/P07/current/W1A22MZN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::W1A22MZN";
        dc:date                "2017-01-24 16:10:06.0";
        dc:identifier          "SDN:P07::W1A22MZN";
        pav:authoredOn         "2017-01-24 16:10:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/W1A22MZN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
