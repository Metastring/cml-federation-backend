        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_140Ba_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_140Ba_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ba\" means the element \"barium\" and \"140Ba\" is the isotope \"barium-140\" with a half-life of 1.28e+01 days."@en;
        skos:notation          "SDN:P07::NB19OEWL";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_140Ba_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

