        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Te\" means the element \"tellurium\" and \"131Te\" is the isotope \"tellurium-131\" with a half-life of 1.74e-02 days."@en;
        skos:notation          "SDN:P07::8N4KDJFO";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_131Te_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N612/>
        rdf:type               skos:Concept;
