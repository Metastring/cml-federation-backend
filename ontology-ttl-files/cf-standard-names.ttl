        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"In\" means the element \"indium\" and \"117In\" is the isotope \"indium-117\" with a half-life of 3.05e-02 days."@en;
        skos:notation          "SDN:P07::8VMYLXAQ";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_117In_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/5T1Z3024/>
        rdf:type               skos:Concept;
