        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/land_condensed_water_amount/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Condensed water on land (e.g. terrestrial water storage) includes groundwater, surface water (rivers, lakes, flora, and fauna), surface snow and ice, soil moisture, and canopy water storage. The phrase \"condensed_water\" means liquid and ice. \"Amount\" means mass per unit area."@en;
        skos:notation          "SDN:P07::6V2B6VGV";
        skos:note              "accepted"@en;
        skos:prefLabel         "land_condensed_water_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/362WBEIL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::362WBEIL";
        dc:date                "2017-11-28 06:51:05.0";
        dc:identifier          "SDN:P07::362WBEIL";
        pav:authoredOn         "2017-11-28 06:51:05.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/362WBEIL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/graupel_fall_amount/> , <http://mmisw.org/ont/cf/parameter/graupel_fall_amount>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Amount\" means mass per unit area. Graupel consists of heavily rimed snow particles, often called snow pellets; often indistinguishable from very small soft hail except for the size convention that hail must have a diameter greater than 5 mm. Reference: American Meteorological Society Glossary http://glossary.ametsoc.org/wiki/Graupel."@en;
        skos:notation          "SDN:P07::362WBEIL";
        skos:note              "accepted"@en;
        skos:prefLabel         "graupel_fall_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

