        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N126/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_carbon_dioxide> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_carbon_dioxide/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ACO2/> , <http://vocab.nerc.ac.uk/collection/P04/current/G132/> , <http://rdfdata.eionet.europa.eu/airquality/components/71>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for carbon dioxide is CO2."@en;
        skos:notation          "SDN:P07::CF12N126";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_carbon_dioxide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0125/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0125";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0125";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0125/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/toa_net_downward_shortwave_flux_assuming_clear_sky> , <http://vocab.nerc.ac.uk/standard_name/toa_net_downward_shortwave_flux_assuming_clear_sky/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G210/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G207/> , <http://vocab.nerc.ac.uk/collection/P64/current/G214/> , <http://vocab.nerc.ac.uk/collection/P04/current/G214/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P04/current/G207/>;
        skos:definition        "A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. 'shortwave' means shortwave radiation. 'toa' means top of atmosphere. 'Downward' indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0125";
        skos:note              "accepted"@en;
        skos:prefLabel         "toa_net_downward_shortwave_flux_assuming_clear_sky"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/RQFW8V8Q/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::RQFW8V8Q";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::RQFW8V8Q";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/RQFW8V8Q/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_243Am_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_243Am_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Am\" means the element \"americium\" and \"243Am\" is the isotope \"americium-243\" with a half-life of 2.91e+06 days."@en;
        skos:notation          "SDN:P07::RQFW8V8Q";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_243Am_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/NHT5ZZH7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::NHT5ZZH7";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::NHT5ZZH7";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/NHT5ZZH7/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
