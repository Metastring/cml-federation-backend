        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G495/> , <http://vocab.nerc.ac.uk/collection/P64/current/G495/> , <http://vocab.nerc.ac.uk/collection/P04/current/G611/>;
        skos:definition        "A velocity is a vector quantity. \"x\" indicates a vector component along the grid x-axis, positive with increasing x. \"Land ice\" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves."@en;
        skos:notation          "SDN:P07::CFSN0590";
        skos:note              "accepted"@en;
        skos:prefLabel         "land_ice_x_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N117/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N117";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::CF14N117";
        pav:authoredOn         "2019-02-04 14:52:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N117/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF14N117/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_ocean_mole_content_of_elemental_nitrogen_due_to_fixation/> , <http://mmisw.org/ont/cf/parameter/tendency_of_ocean_mole_content_of_elemental_nitrogen_due_to_fixation>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/NTUP/>;
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"ocean content\" of a quantity refers to the vertical integral from the surface to the bottom of the ocean. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Nitrogen fixation\" means the production of ammonia from nitrogen gas. Organisms that fix nitrogen are termed \"diazotrophs\". Diazotrophic phytoplankton can fix atmospheric nitrogen, thus increasing the content of nitrogen in the ocean."@en;
        skos:notation          "SDN:P07::CF14N117";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_ocean_mole_content_of_elemental_nitrogen_due_to_fixation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2MS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/4ON8W6GG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::4ON8W6GG";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::4ON8W6GG";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/4ON8W6GG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_229Ac_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_229Ac_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ac\" means the element \"actinium\" and \"229Ac\" is the isotope \"actinium-229\" with a half-life of 4.58e-02 days."@en;
        skos:notation          "SDN:P07::4ON8W6GG";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_229Ac_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12S26/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12S26";
        dc:date                "2015-01-07 15:23:07.0";
        dc:identifier          "SDN:P07::CF12S26";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/GFVM4F3K/>;
        pav:authoredOn         "2015-01-07 15:23:07.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12S26/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12S26/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_fraction_of_pm2p5_ambient_aerosol_in_air> , <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_pm2p5_ambient_aerosol_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0796/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G103/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P64/current/H316/> , <http://vocab.nerc.ac.uk/collection/P04/current/H316/> , <http://vocab.nerc.ac.uk/collection/P64/current/G103/>;
        skos:definition        "Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X).  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets).  \"Ambient aerosol\" is aerosol that has taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the aerosol. \"Pm2p5 aerosol\" is an air pollutant with an aerodynamic diameter of less than or equal to 2.5 micrometers. To specify the relative humidity and temperature at which the particle size applies, provide scalar coordinate variables with the standard names of, respectively, \"relative_humidity\" and \"air_temperature\"."@en;
        skos:notation          "SDN:P07::CF12S26";
        skos:note              "deprecated"@en;
        skos:prefLabel         "mass_fraction_of_pm2p5_ambient_aerosol_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/GFVM4F3K/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::GFVM4F3K";
        dc:date                "2017-06-26 15:24:29.0";
        dc:identifier          "SDN:P07::GFVM4F3K";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0796/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12S26/>;
        pav:authoredOn         "2017-06-26 15:24:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/GFVM4F3K/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/GFVM4F3K/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/GFVM4F3K/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_pm2p5_ambient_aerosol_particles_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_pm2p5_ambient_aerosol_particles_in_air>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. \"Ambient_aerosol\" means that the aerosol is measured or modelled at the ambient state of pressure, temperature and relative humidity that exists in its immediate environment. \"Ambient aerosol particles\" are aerosol particles that have taken up ambient water through hygroscopic growth. The extent of hygroscopic growth depends on the relative humidity and the composition of the particles. \"Pm2p5 aerosol\" means atmospheric particulate compounds with an aerodynamic diameter of less than or equal to 2.5 micrometers. To specify the relative humidity and temperature at which the particle size applies, provide scalar coordinate variables with the standard names of \"relative_humidity\" and \"air_temperature\"."@en;
        skos:notation          "SDN:P07::GFVM4F3K";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_pm2p5_ambient_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0796/>
        rdf:type               skos:Concept;
