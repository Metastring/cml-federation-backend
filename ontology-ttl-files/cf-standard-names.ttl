        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/virtual_salt_flux_into_sea_water_due_to_newtonian_relaxation/> , <http://mmisw.org/ont/cf/parameter/virtual_salt_flux_into_sea_water_due_to_newtonian_relaxation>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G996/> , <http://vocab.nerc.ac.uk/collection/P64/current/G996/>;
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. The virtual_salt_flux_into_sea_water_due_to_newtonian_relaxation is the salt flux that would have the same effect on the sea surface salinity as water_flux_out_of_sea_water_due_to_newtonian_relaxation. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFV10N48";
        skos:note              "accepted"@en;
        skos:prefLabel         "virtual_salt_flux_into_sea_water_due_to_newtonian_relaxation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/OFEJXA57/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::OFEJXA57";
