        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Np\" means the element \"neptunium\" and \"240mNp\" is the metastable state of the isotope \"neptunium-240\" with a half-life of 5.08e-03 days."@en;
        skos:notation          "SDN:P07::E7GCDPGE";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_240mNp_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/4B8E7WCW/>
        rdf:type               skos:Concept;
