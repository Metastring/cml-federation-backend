        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The Y-component of the surface outward normal unit vector at a specified location, indicating the orientation of the surface at that point. \"y\" indicates a vector component along the grid y-axis, positive with increasing y."@en;
        skos:notation          "SDN:P07::RFAH69ZA";
