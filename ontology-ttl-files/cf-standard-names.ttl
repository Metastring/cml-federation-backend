        skos:note              "accepted"@en;
        skos:prefLabel         "incoming_water_volume_transport_along_river_channel"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/CMPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/162XLWW7/>
        rdf:type               skos:Concept;
