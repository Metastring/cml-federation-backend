        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"In\" means the element \"indium\" and \"117In\" is the isotope \"indium-117\" with a half-life of 3.05e-02 days."@en;
        skos:notation          "SDN:P07::D0CRZHK9";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_117In_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

