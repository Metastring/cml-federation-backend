<http://vocab.nerc.ac.uk/collection/P07/current/Q8VK3QCB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Q8VK3QCB";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::Q8VK3QCB";
        pav:authoredOn         "2018-02-12 16:53:18.0";
