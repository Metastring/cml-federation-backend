        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0244/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0244/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0244/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_partial_pressure_of_carbon_dioxide_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/surface_partial_pressure_of_carbon_dioxide_in_sea_water/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/PCO2/> , <http://vocab.nerc.ac.uk/collection/P64/current/G883/> , <http://vocab.nerc.ac.uk/collection/P04/current/G883/> , <http://vocab.nerc.ac.uk/collection/P04/current/G674/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_CO2/>;
        skos:definition        "The partial pressure of a dissolved gas in sea water is the partial pressure in air with which it would be in equilibrium. The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged. The chemical formula for carbon dioxide is CO2."@en;
        skos:notation          "SDN:P07::CFSN0244";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_partial_pressure_of_carbon_dioxide_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N551/>
        rdf:type               skos:Concept;
