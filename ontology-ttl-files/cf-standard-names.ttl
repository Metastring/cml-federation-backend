        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/water_volume_transport_into_sea_water_from_rivers> , <http://vocab.nerc.ac.uk/standard_name/water_volume_transport_into_sea_water_from_rivers/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0034/>;
        owl:versionInfo        "2";
