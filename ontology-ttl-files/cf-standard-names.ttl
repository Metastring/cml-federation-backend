        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Rn\" means the element \"radon\" and \"223Rn\" is the isotope \"radon-223\" with a half-life of 2.98e-02 days."@en;
        skos:notation          "SDN:P07::LYQ9GOF9";
