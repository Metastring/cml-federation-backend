        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pr\" means the element \"praseodymium\" and \"143Pr\" is the isotope \"praseodymium-143\" with a half-life of 1.36e+01 days."@en;
        skos:notation          "SDN:P07::B3FH1TYA";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_143Pr_in_air"@en;
