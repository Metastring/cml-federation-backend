        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Th\" means the element \"thorium\" and \"227Th\" is the isotope \"thorium-227\" with a half-life of 1.82e+01 days."@en;
        skos:notation          "SDN:P07::YLZAJFVS";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_227Th"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

