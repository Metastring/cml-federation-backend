<http://vocab.nerc.ac.uk/collection/P07/current/TEHQ4X3K/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::TEHQ4X3K";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::TEHQ4X3K";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/TEHQ4X3K/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/TEHQ4X3K/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_mesopelagic_fish_expressed_as_wet_weight_in_sea_water/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Mesopelagic fish live in the mesopelagic or \"Twilight Zone\" at depths of about 200-1000 m, where light is limited. The phrase \"expressed_as\" is used in the construction \"A_expressed_as_B\", where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Wet weight is the weight of a material, organism, or sample including its water (moisture) content, measured before drying."@en;
        skos:notation          "SDN:P07::TEHQ4X3K";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_mesopelagic_fish_expressed_as_wet_weight_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UGMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N42/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N42";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N42";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N42/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_ethene/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_ethene>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AEYN/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for ethene is C2H4. Ethene is a member of the group of hydrocarbons known as alkenes.  There are standard names for the alkene group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::CF12N42";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_ethene"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N375/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N375";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N375";
