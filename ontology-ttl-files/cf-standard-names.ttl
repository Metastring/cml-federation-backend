        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/aerosol_angstrom_exponent> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12S1/> , <http://vocab.nerc.ac.uk/standard_name/aerosol_angstrom_exponent/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G103/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G103/>;
        skos:definition        "'Aerosol' means the suspended liquid or solid particles in air (except cloud droplets)."@en;
        skos:notation          "SDN:P07::CFSN0012";
        skos:note              "deprecated"@en;
        skos:prefLabel         "aerosol_angstrom_exponent"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/JMY2YFAI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::JMY2YFAI";
        dc:date                "2025-05-13 08:28:41.0";
        dc:identifier          "SDN:P07::JMY2YFAI";
        pav:authoredOn         "2025-05-13 08:28:41.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/JMY2YFAI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_calcareous_phytoplankton_expressed_as_phosphorus_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. \"Calcareous phytoplankton\" are phytoplankton that produce calcite. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis. Calcite is a mineral that is a polymorph of calcium carbonate. The chemical formula of calcite is CaCO3. Standard names also exist for aragonite, another polymorph of calcium carbonate."@en;
        skos:notation          "SDN:P07::JMY2YFAI";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_calcareous_phytoplankton_expressed_as_phosphorus_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0708/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0708";
        dc:date                "2024-09-04 12:51:23.0";
        dc:identifier          "SDN:P07::CFSN0708";
        pav:authoredOn         "2024-09-04 12:51:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0708/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0708/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0708/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/convective_cloud_area_fraction_in_atmosphere_layer> , <http://vocab.nerc.ac.uk/standard_name/convective_cloud_area_fraction_in_atmosphere_layer/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G260/> , <http://vocab.nerc.ac.uk/collection/P04/current/G260/>;
        skos:definition        "\"Area fraction\" is the fraction of a grid cell's horizontal area that has some characteristic of interest. It is evaluated as the area of interest divided by the grid cell area, or if the cell_methods restricts the evaluation to some portion of that grid cell (e.g. \"where sea_ice\"), then it is the area of interest divided by the area of the identified portion. It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction. \"Layer\" means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Standard names referring only to \"cloud_area_fraction\" should be used for quantities for the whole atmosphere column. Standard names also exist for high, medium and low cloud types. Convective cloud is that produced by the convection schemes in an atmosphere model. Cloud area fraction is also called \"cloud amount\" and \"cloud cover\"."@en;
        skos:notation          "SDN:P07::CFSN0708";
        skos:note              "accepted"@en;
        skos:prefLabel         "convective_cloud_area_fraction_in_atmosphere_layer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> , <http://vocab.nerc.ac.uk/collection/P02/current/CHEX/> , <http://vocab.nerc.ac.uk/collection/P02/current/CLTY/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0827";
        dc:date                "2017-06-26 15:24:30.0";
        dc:identifier          "SDN:P07::CFSN0827";
        pav:authoredOn         "2017-06-26 15:24:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/3/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/1/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_geostrophic_sea_water_x_velocity_assuming_sea_level_for_geoid> , <http://vocab.nerc.ac.uk/standard_name/surface_geostrophic_sea_water_x_velocity_assuming_sea_level_for_geoid/> , <http://vocab.nerc.ac.uk/collection/P07/current/R33VVM5P/>;
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/RFVL/> , <http://vocab.nerc.ac.uk/collection/P04/current/G920/> , <http://vocab.nerc.ac.uk/collection/P64/current/G920/>;
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. A velocity is a vector quantity. \"x\" indicates a vector component along the grid x-axis, positive with increasing x. \"Geostrophic\" indicates that geostrophic balance is assumed, i.e. that the pressure gradient force and the Coriolis force are balanced and the large scale fluid flow is parallel to the isobars. \"sea_level\" means mean sea level. The geoid is a surface of constant geopotential with which mean sea level would coincide if the ocean were at rest. (The volume enclosed between the geoid and the sea floor equals the mean volume of water in the ocean.) In an ocean GCM the geoid is the surface of zero depth, or the rigid lid if the model uses that approximation. surface_geostrophic_sea_water_x_velocity_assuming_sea_level_for_geoid is the variable part of surface_geostrophic_sea_water_x_velocity. The assumption that sea level is equal to the geoid means that the stationary component of ocean circulation is equal to zero."@en;
        skos:notation          "SDN:P07::CFSN0827";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_geostrophic_sea_water_x_velocity_assuming_sea_level_for_geoid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/R33VVM5P/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::R33VVM5P";
        dc:date                "2017-06-26 15:24:29.0";
        dc:identifier          "SDN:P07::R33VVM5P";
        pav:authoredOn         "2017-06-26 15:24:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/R33VVM5P/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_geostrophic_sea_water_x_velocity_assuming_mean_sea_level_for_geoid/> , <http://mmisw.org/ont/cf/parameter/surface_geostrophic_sea_water_x_velocity_assuming_mean_sea_level_for_geoid> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0827/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. A velocity is a vector quantity. \"x\" indicates a vector component along the grid x-axis, positive with increasing x. \"Geostrophic\" indicates that geostrophic balance is assumed, i.e. that the pressure gradient force and the Coriolis force are balanced and the large scale fluid flow is parallel to the isobars. \"Mean sea level\" means the time mean of sea surface elevation at a given location over an arbitrary period sufficient to eliminate the tidal signals. The geoid is a surface of constant geopotential with which mean sea level would coincide if the ocean were at rest. (The volume enclosed between the geoid and the sea floor equals the mean volume of water in the ocean.) In an ocean GCM the geoid is the surface of zero depth, or the rigid lid if the model uses that approximation. The quantity with standard name surface_geostrophic_sea_water_x_velocity_assuming_mean_sea_level_for_geoid is the variable part of surface_geostrophic_sea_water_x_velocity. The assumption that sea level is equal to the geoid means that the stationary component of ocean circulation is equal to zero."@en;
        skos:notation          "SDN:P07::R33VVM5P";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_geostrophic_sea_water_x_velocity_assuming_mean_sea_level_for_geoid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/G353241Q/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::G353241Q";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::G353241Q";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/G353241Q/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_240mNp/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_240mNp>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Np\" means the element \"neptunium\" and \"240mNp\" is the metastable state of the isotope \"neptunium-240\" with a half-life of 5.08e-03 days."@en;
        skos:notation          "SDN:P07::G353241Q";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_240mNp"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CADJBCCG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CADJBCCG";
        dc:date                "2012-04-27 15:14:48.0";
        dc:identifier          "SDN:P07::CADJBCCG";
        pav:authoredOn         "2012-04-27 15:14:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CADJBCCG/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_hydrogen_sulfide_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_hydrogen_sulfide_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as &amp;apos;nitrogen&amp;apos; or a phrase such as &amp;apos;nox_expressed_as_nitrogen&amp;apos;. The chemical formula of hydrogen sulfide is H2S."@en;
        skos:notation          "SDN:P07::CADJBCCG";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_hydrogen_sulfide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N82/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N82";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N82";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N82/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrogen_dioxide> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrogen_dioxide/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G160/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for nitrogen dioxide is NO2."@en;
        skos:notation          "SDN:P07::CF12N82";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_nitrogen_dioxide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N560/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N560";
        dc:date                "2013-01-11 16:56:43.0";
        dc:identifier          "SDN:P07::CF12N560";
        pav:authoredOn         "2013-01-11 16:56:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N560/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N560/1/>;
        pav:version            "2";
