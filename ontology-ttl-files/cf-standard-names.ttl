<http://vocab.nerc.ac.uk/collection/P07/current/AH2MSSNC/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::AH2MSSNC";
        dc:date                "2021-09-20 14:41:46.0";
        dc:identifier          "SDN:P07::AH2MSSNC";
        pav:authoredOn         "2021-09-20 14:41:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/AH2MSSNC/1/>;
