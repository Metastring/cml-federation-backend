        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/H322/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hydrogen peroxide is H2O2."@en;
        skos:notation          "SDN:P07::CF12N274";
