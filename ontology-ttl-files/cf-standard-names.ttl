        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/water_flux_into_sea_water_due_to_flux_adjustment/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0055/> , <http://mmisw.org/ont/cf/parameter/water_flux_into_sea_water_due_to_flux_adjustment>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Water\" means water in all phases. Flux correction is also called \"flux adjustment\". A positive flux correction is downward i.e. added to the ocean. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::G882GYEQ";
        skos:note              "accepted"@en;
        skos:prefLabel         "water_flux_into_sea_water_due_to_flux_adjustment"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

