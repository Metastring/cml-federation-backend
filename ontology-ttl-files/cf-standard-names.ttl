        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/HFT351PS/> , <http://vocab.nerc.ac.uk/standard_name/number_concentration_of_stratiform_cloud_liquid_water_particle_at_stratiform_liquid_water_cloud_top/> , <http://mmisw.org/ont/cf/parameter/number_concentration_of_stratiform_cloud_liquid_water_particle_at_stratiform_liquid_water_cloud_top>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Number concentration\" means the number of particles or other specified objects per unit volume. The phrase \"stratiform_liquid_water_cloud_top\" refers to the top of the highest stratiform liquid water cloud. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes)."@en;
        skos:notation          "SDN:P07::IDWENXCE";
        skos:note              "deprecated"@en;
        skos:prefLabel         "number_concentration_of_stratiform_cloud_liquid_water_particle_at_stratiform_liquid_water_cloud_top"@en;
