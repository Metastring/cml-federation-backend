        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Xe\" means the element \"xenon\" and \"134mXe\" is the metastable state of the isotope \"xenon-134\" with a half-life of 3.36e-06 days."@en;
        skos:notation          "SDN:P07::2S0BBV0F";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_134mXe"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CCLBHMYW/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CCLBHMYW";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::CCLBHMYW";
