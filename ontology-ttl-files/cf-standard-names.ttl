        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_hypochlorous_acid_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_hypochlorous_acid_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
