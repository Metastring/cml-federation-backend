        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sb\" means the element \"antimony\" and \"131Sb\" is the isotope \"antimony-131\" with a half-life of 1.60e-02 days."@en;
        skos:notation          "SDN:P07::3NV1LAFR";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_131Sb_in_air"@en;
