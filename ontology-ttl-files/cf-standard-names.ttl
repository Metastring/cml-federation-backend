        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV11N3/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/convective_precipitation_rate> , <http://vocab.nerc.ac.uk/standard_name/convective_precipitation_rate/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P64/current/G287/> , <http://vocab.nerc.ac.uk/collection/P04/current/G287/>;
        skos:definition        "\"Precipitation rate\" means the depth or thickness of the layer formed by precipitation per unit time. Convective precipitation is that produced by the convection schemes in an atmosphere model. \"Precipitation\" in the earth's atmosphere means precipitation of water in all phases."@en;
        skos:notation          "SDN:P07::CFV11N3";
        skos:note              "accepted"@en;
        skos:prefLabel         "convective_precipitation_rate"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N235/>
        rdf:type               skos:Concept;
