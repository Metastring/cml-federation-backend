        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A variable with the standard name of quality_flag contains an indication of assessed quality information of another data variable. The linkage between the data variable and the variable or variables with the standard_name of quality_flag is achieved using the ancillary_variables attribute."@en;
