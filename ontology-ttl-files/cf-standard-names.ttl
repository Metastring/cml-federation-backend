<http://vocab.nerc.ac.uk/collection/P07/current/DZ3BYFZL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DZ3BYFZL";
        dc:date                "2015-01-07 16:23:38.0";
