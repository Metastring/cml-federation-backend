        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  \"moles_of_X_in_middle_atmosphere\" means the total number of moles of X contained in the troposphere and stratosphere, i.e, summed over that part of the atmospheric column and over the entire globe.  The chemical formula of molecular hydrogen is H2."@en;
        skos:notation          "SDN:P07::CFV8N115";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_moles_of_molecular_hydrogen_in_middle_atmosphere"@en;
