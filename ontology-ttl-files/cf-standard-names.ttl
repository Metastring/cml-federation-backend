        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"At\" means the element \"astatine\" and \"219At\" is the isotope \"astatine-219\" with a half-life of 6.27e-04 days."@en;
        skos:notation          "SDN:P07::EGG6Z1YM";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_219At_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/F07IYNBF/>
        rdf:type               skos:Concept;
