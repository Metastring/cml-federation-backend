        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G546/> , <http://vocab.nerc.ac.uk/collection/P64/current/G546/> , <http://vocab.nerc.ac.uk/collection/P04/current/G650/>;
        skos:definition        "Snow temperature is the bulk temperature of the snow, not the surface (skin) temperature."@en;
        skos:notation          "SDN:P07::CFSN0341";
        skos:note              "deprecated"@en;
