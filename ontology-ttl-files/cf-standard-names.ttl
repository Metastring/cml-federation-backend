        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ga\" means the element \"gallium\" and \"73Ga\" is the isotope \"gallium-73\" with a half-life of 2.03e-01 days."@en;
        skos:notation          "SDN:P07::4ODRBT4L";
