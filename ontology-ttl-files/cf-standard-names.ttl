<http://vocab.nerc.ac.uk/collection/P07/current/5K9B4N9L/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::5K9B4N9L";
        dc:date                "2023-10-16 17:23:15.0";
        dc:identifier          "SDN:P07::5K9B4N9L";
        pav:authoredOn         "2023-10-16 17:23:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/5K9B4N9L/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0637/> , <http://vocab.nerc.ac.uk/standard_name/heat_flux_into_sea_water_due_to_flux_adjustment/> , <http://mmisw.org/ont/cf/parameter/heat_flux_into_sea_water_due_to_flux_adjustment>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A positive flux adjustment is downward i.e. added to the ocean. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::5K9B4N9L";
        skos:note              "accepted"@en;
        skos:prefLabel         "heat_flux_into_sea_water_due_to_flux_adjustment"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

