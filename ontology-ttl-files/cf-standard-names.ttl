        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G197/> , <http://vocab.nerc.ac.uk/collection/P64/current/G197/> , <http://vocab.nerc.ac.uk/collection/P64/current/G206/> , <http://vocab.nerc.ac.uk/collection/P04/current/G206/>;
        skos:definition        "'longwave' means longwave radiation. Net absorbed radiation is the difference between absorbed and emitted radiation."@en;
        skos:notation          "SDN:P07::CFSN0760";
