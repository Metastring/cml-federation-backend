        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Pm\" means the element \"promethium\" and \"150Pm\" is the isotope \"promethium-150\" with a half-life of 1.12e-01 days."@en;
        skos:notation          "SDN:P07::1RFM07BV";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_150Pm"@en;
