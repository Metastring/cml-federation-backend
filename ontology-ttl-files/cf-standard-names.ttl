        skos:prefLabel         "atmosphere_relative_vorticity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/5JOLMO70/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::5JOLMO70";
        dc:date                "2020-09-14 20:42:12.0";
        dc:identifier          "SDN:P07::5JOLMO70";
        pav:authoredOn         "2020-09-14 20:42:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/5JOLMO70/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_upward_relative_vorticity/> , <http://mmisw.org/ont/cf/parameter/atmosphere_upward_relative_vorticity> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0765/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Atmosphere upward relative vorticity is the vertical component of the 3D air vorticity vector. The vertical component arises from horizontal velocity only. \"Relative\" in this context means the vorticity of the air relative to the rotating solid earth reference frame, i.e. excluding the Earth's own rotation. In contrast, the quantity with standard name atmosphere_upward_absolute_vorticity includes the Earth's rotation. \"Upward\" indicates a vector component which is positive when directed upward (negative downward). A positive value of atmosphere_upward_relative_vorticity indicates anticlockwise rotation when viewed from above."@en;
        skos:notation          "SDN:P07::5JOLMO70";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_upward_relative_vorticity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/QMZP5V9M/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::QMZP5V9M";
        dc:date                "2023-10-16 17:23:15.0";
        dc:identifier          "SDN:P07::QMZP5V9M";
        pav:authoredOn         "2023-10-16 17:23:15.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/QMZP5V9M/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/moles_of_particulate_matter_expressed_as_nitrogen_per_unit_mass_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/moles_of_particulate_matter_expressed_as_nitrogen_per_unit_mass_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The construction \"moles_of_X_per_unit_mass_in_Y\" is also called \"molality\" of X in Y, where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Particulate means suspended solids of all sizes. The equivalent term in the NERC P01 Parameter Usage Vocabulary may be found at http://vocab.nerc.ac.uk/collection/P01/current/MDMAP013/4/."@en;
        skos:notation          "SDN:P07::QMZP5V9M";
        skos:note              "accepted"@en;
        skos:prefLabel         "moles_of_particulate_matter_expressed_as_nitrogen_per_unit_mass_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLKG/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N302/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N302";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N302";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N302/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EXUV/> , <http://vocab.nerc.ac.uk/collection/P64/current/G901/> , <http://vocab.nerc.ac.uk/collection/P04/current/G901/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The phrase 'expressed_as' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Organic detritus are particles of debris from decaying plants and animals."@en;
        skos:notation          "SDN:P07::CF12N302";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N327/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N327";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N327";
