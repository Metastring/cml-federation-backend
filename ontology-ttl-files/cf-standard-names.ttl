        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Ag\" means the element \"silver\" and \"111mAg\" is the metastable state of the isotope \"silver-111\" with a half-life of 8.56e-04 days."@en;
        skos:notation          "SDN:P07::T0FQXBIC";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_111mAg"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/WSOOVDAH/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WSOOVDAH";
