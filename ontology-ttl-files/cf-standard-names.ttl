        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N276/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N276/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_hydroxyl_radical_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_hydroxyl_radical_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G154/>;
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for the hydroxyl radical is OH. In chemistry, a \"radical\" is a highly reactive, and therefore short lived, species."@en;
        skos:notation          "SDN:P07::CF12N276";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hydroxyl_radical_in_air"@en;
