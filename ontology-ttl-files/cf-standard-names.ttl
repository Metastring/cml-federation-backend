        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mass_fraction_of_seasalt_dry_aerosol_in_air> , <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_seasalt_dry_aerosol_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/1IRVLFFX/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/>;
        skos:definition        "Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets). Aerosol takes up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the aerosol. \"Dry aerosol\" means aerosol without water."@en;
        skos:notation          "SDN:P07::CFSN0798";
        skos:note              "deprecated"@en;
        skos:prefLabel         "mass_fraction_of_seasalt_dry_aerosol_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1IRVLFFX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1IRVLFFX";
        dc:date                "2017-06-26 15:24:29.0";
        dc:identifier          "SDN:P07::1IRVLFFX";
        pav:authoredOn         "2017-06-26 15:24:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1IRVLFFX/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_sea_salt_dry_aerosol_particles_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0798/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_sea_salt_dry_aerosol_particles_in_air> , <http://vocab.nerc.ac.uk/collection/P07/current/GMFCAI5Q/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mass fraction is used in the construction mass_fraction_of_X_in_Y, where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake."@en;
        skos:notation          "SDN:P07::1IRVLFFX";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_sea_salt_dry_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/UEQZP5D9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::UEQZP5D9";
        dc:date                "2024-11-11 15:22:42.0";
        dc:identifier          "SDN:P07::UEQZP5D9";
        pav:authoredOn         "2024-11-11 15:22:42.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/UEQZP5D9/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_mole_concentration_of_particulate_organic_matter_expressed_as_carbon_in_sea_water_due_to_net_primary_production_by_algae/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. Particulate means suspended solids of all sizes. Net primary production is the excess of gross primary production (the rate of synthesis of biomass from inorganic precursors) by autotrophs (\"producers\"), for example, photosynthesis in plants or phytoplankton, over the rate at which the autotrophs themselves respire some of this biomass. In the oceans, carbon production per unit volume is often found at a number of depths at a given horizontal location. That quantity can then be integrated to calculate production per unit area at the location. Standard names for production per unit area use the term \"productivity\". \"Production of carbon\" means the production of biomass expressed as the mass of carbon which it contains. The phrase \"expressed_as\" is used in the construction \"A_expressed_as_B\", where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Mole concentration\" means number of moles per unit volume, also called \"molarity\", and is used in the construction \"mole_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\"."@en;
        skos:notation          "SDN:P07::UEQZP5D9";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_mole_concentration_of_particulate_organic_matter_expressed_as_carbon_in_sea_water_due_to_net_primary_production_by_algae"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MM3S/> .

<http://vocab.nerc.ac.uk/collection/P07/current/GQ3HGVX5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::GQ3HGVX5";
        dc:date                "2018-10-15 12:56:49.0";
        dc:identifier          "SDN:P07::GQ3HGVX5";
        pav:authoredOn         "2018-10-15 12:56:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/GQ3HGVX5/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_surface_mean_square_upwave_slope_direction/> , <http://mmisw.org/ont/cf/parameter/sea_surface_mean_square_upwave_slope_direction>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Wave slope describes an aspect of sea surface wave geometry related to sea surface roughness. Mean square slope describes a derivation over multiple waves within a sea-state, for example calculated from moments of the wave directional spectrum. The phrase \"upwave_slope_direction\" is used to assign a primary directional axis along which wave energy associated with the slope calculation is travelling; \"upwave\" is equivalent to \"from_direction\" which is used in some standard names."@en;
        skos:notation          "SDN:P07::GQ3HGVX5";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_mean_square_upwave_slope_direction"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UAAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N449/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N449";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N449";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N449/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_dichlorine_peroxide_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_dichlorine_peroxide_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for dichlorine peroxide is Cl2O2."@en;
        skos:notation          "SDN:P07::CF12N449";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_dichlorine_peroxide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/PUXTY984/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::PUXTY984";
        dc:date                "2024-05-20 20:39:48.0";
        dc:identifier          "SDN:P07::PUXTY984";
        pav:authoredOn         "2024-05-20 20:39:48.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/PUXTY984/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/volume_absorption_coefficient_of_radiative_flux_in_air_due_to_aerosol_particles/> , <http://mmisw.org/ont/cf/parameter/volume_absorption_coefficient_of_radiative_flux_in_air_due_to_aerosol_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The volume scattering/absorption/attenuation coefficient is the fractional change of radiative flux per unit path length due to the stated process. Coefficients with canonical units of m2 s-1 i.e. multiplied by density have standard names with specific_ instead of volume_. A scattering_angle should not be specified with this quantity. The scattering/absorption/attenuation coefficient is assumed to be an integral over all wavelengths, unless a coordinate of radiation_wavelength is included to specify the wavelength. Radiative flux is the sum of shortwave and longwave radiative fluxes. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. To specify the relative humidity at which the sample was measured, provide a scalar coordinate variable with the standard name of \"relative_humidity\". The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::PUXTY984";
        skos:note              "accepted"@en;
        skos:prefLabel         "volume_absorption_coefficient_of_radiative_flux_in_air_due_to_aerosol_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPRM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N19";
        dc:date                "2019-05-14 17:27:21.0";
        dc:identifier          "SDN:P07::CFV7N19";
        pav:authoredOn         "2019-05-14 17:27:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/3/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_due_to_emission> , <http://vocab.nerc.ac.uk/collection/P07/current/LE4PB3MS/> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_due_to_emission/>;
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. the surface of the earth). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. \"tendency_of_X\" means derivative of X with respect to time."@en;
        skos:notation          "SDN:P07::CFV7N19";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G130/> , <http://vocab.nerc.ac.uk/collection/P64/current/G130/> .

<http://vocab.nerc.ac.uk/collection/P07/current/LE4PB3MS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::LE4PB3MS";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::LE4PB3MS";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/LE4PB3MS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N19/> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_particles_due_to_emission/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_particles_due_to_emission>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. the surface of the earth). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names."@en;
        skos:notation          "SDN:P07::LE4PB3MS";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_mercury_dry_aerosol_particles_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/919O9Z29/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::919O9Z29";
        dc:date                "2022-03-18 12:42:55.0";
        dc:identifier          "SDN:P07::919O9Z29";
        pav:authoredOn         "2022-03-18 12:42:55.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/919O9Z29/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_dissolved_phosphorus_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_dissolved_phosphorus_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mole concentration\" means number of moles per unit volume, also called \"molarity\", and is used in the construction \"mole_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Phosphorus means phosphorus in all chemical forms, commonly referred to as \"total phosphorus\". The equivalent term in the NERC P01 Parameter Usage Vocabulary may be found at http://vocab.nerc.ac.uk/collection/P01/current/TPHSDSZZ/6/."@en;
        skos:notation          "SDN:P07::919O9Z29";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_dissolved_phosphorus_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0671/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0671";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0671";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0671/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/dry_energy_content_of_atmosphere_layer/> , <http://mmisw.org/ont/cf/parameter/dry_energy_content_of_atmosphere_layer>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "'Content' indicates a quantity per unit area. 'Layer' means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. Dry energy is the sum of dry static energy and kinetic energy. Dry static energy is the sum of enthalpy and potential energy (itself the sum of gravitational and centripetal potential energy). Enthalpy can be written either as (1) CpT, where Cp is heat capacity at constant pressure, T is absolute temperature, or (2) U+pV, where U is internal energy, p is pressure and V is volume."@en;
        skos:notation          "SDN:P07::CFSN0671";
        skos:note              "accepted"@en;
        skos:prefLabel         "dry_energy_content_of_atmosphere_layer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/JMSQ/> .

<http://vocab.nerc.ac.uk/collection/P07/current/63TOGZFP/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::63TOGZFP";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::63TOGZFP";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/63TOGZFP/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_147Nd_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_147Nd_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Nd\" means the element \"neodymium\" and \"147Nd\" is the isotope \"neodymium-147\" with a half-life of 1.10e+01 days."@en;
        skos:notation          "SDN:P07::63TOGZFP";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_147Nd_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0471/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0471";
        dc:date                "2018-06-11 18:10:06.0";
        dc:identifier          "SDN:P07::CFSN0471";
        pav:authoredOn         "2018-06-11 18:10:06.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0471/4/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0471/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0471/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0471/3/>;
        pav:version            "4";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/ocean_mixed_layer_thickness_defined_by_temperature> , <http://vocab.nerc.ac.uk/standard_name/ocean_mixed_layer_thickness_defined_by_temperature/>;
        owl:versionInfo        "4";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G921/> , <http://vocab.nerc.ac.uk/collection/P04/current/G959/> , <http://vocab.nerc.ac.uk/collection/P02/current/HBEX/> , <http://vocab.nerc.ac.uk/collection/P64/current/G921/> , <http://vocab.nerc.ac.uk/collection/P02/current/MXLM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G959/>;
        skos:definition        "The ocean mixed layer is the upper part of the ocean, regarded as being well-mixed. The base of the mixed layer defined by \"temperature\", \"sigma\", \"sigma_theta\", \"sigma_t\" or vertical diffusivity is the level at which the quantity indicated differs from its surface value by a certain amount. A coordinate variable or scalar coordinate variable with standard name sea_water_temperature_difference can be used to specify the temperature criterion that determines the layer thickness. Sea water temperature is the in situ temperature of the sea water. \"Thickness\" means the vertical extent of a layer."@en;
        skos:notation          "SDN:P07::CFSN0471";
        skos:note              "accepted"@en;
        skos:prefLabel         "ocean_mixed_layer_thickness_defined_by_temperature"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/PSFINQ3E/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::PSFINQ3E";
        dc:date                "2026-06-08 13:55:32.0";
        dc:identifier          "SDN:P07::PSFINQ3E";
        pav:authoredOn         "2026-06-08 13:55:32.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/PSFINQ3E/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_ice_internal_pressure/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Sea ice internal pressure is the effective pressure associated with the internal stress field of the sea ice cover, representing the instantaneous internal mechanical state of the ice and not its material strength. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs."@en;
        skos:notation          "SDN:P07::PSFINQ3E";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_ice_internal_pressure"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/NTPM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0521/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0521";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0521";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0521/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/net_downward_longwave_flux_in_air_assuming_clear_sky> , <http://vocab.nerc.ac.uk/standard_name/net_downward_longwave_flux_in_air_assuming_clear_sky/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G207/> , <http://vocab.nerc.ac.uk/collection/P64/current/G206/> , <http://vocab.nerc.ac.uk/collection/P02/current/LWRD/> , <http://vocab.nerc.ac.uk/collection/P04/current/G206/> , <http://vocab.nerc.ac.uk/collection/P04/current/G207/>;
        skos:definition        "A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. 'longwave' means longwave radiation. 'Downward' indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0521";
        skos:note              "accepted"@en;
        skos:prefLabel         "net_downward_longwave_flux_in_air_assuming_clear_sky"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

