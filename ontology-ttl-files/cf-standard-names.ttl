<http://vocab.nerc.ac.uk/collection/P07/current/8C3CFSYC/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::8C3CFSYC";
        dc:date                "2018-03-13 13:56:23.0";
        dc:identifier          "SDN:P07::8C3CFSYC";
        pav:authoredOn         "2018-03-13 13:56:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/8C3CFSYC/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_flux_of_carbon_out_of_soil_due_to_leaching_and_runoff/> , <http://mmisw.org/ont/cf/parameter/mass_flux_of_carbon_out_of_soil_due_to_leaching_and_runoff>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Leaching\" means the loss of water soluble chemical species from soil. Runoff is the liquid water which drains from land. If not specified, \"runoff\" refers to the sum of surface runoff and subsurface drainage."@en;
        skos:notation          "SDN:P07::8C3CFSYC";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_flux_of_carbon_out_of_soil_due_to_leaching_and_runoff"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/OBDP98IE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::OBDP98IE";
        dc:date                "2024-09-04 12:51:22.0";
        dc:identifier          "SDN:P07::OBDP98IE";
        pav:authoredOn         "2024-09-04 12:51:22.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/OBDP98IE/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/OBDP98IE/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/OBDP98IE/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/clear_sky_area_fraction/> , <http://mmisw.org/ont/cf/parameter/clear_sky_area_fraction>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "\"Area fraction\" is the fraction of a grid cell's horizontal area that has some characteristic of interest. It is evaluated as the area of interest divided by the grid cell area, or if the cell_methods restricts the evaluation to some portion of that grid cell (e.g. \"where sea_ice\"), then it is the area of interest divided by the area of the identified portion. It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction. The clear_sky area fraction is for the whole atmosphere column, as seen from the surface or the top of the atmosphere. \"Clear sky\" means in the absence of clouds."@en;
        skos:notation          "SDN:P07::OBDP98IE";
        skos:note              "accepted"@en;
        skos:prefLabel         "clear_sky_area_fraction"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N383/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N383";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N383";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N383/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N383/1/>;
        pav:version            "2";
