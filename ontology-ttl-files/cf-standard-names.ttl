        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N46/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/vertical_component_of_ocean_xy_tracer_diffusivity/> , <http://mmisw.org/ont/cf/parameter/vertical_component_of_ocean_xy_tracer_diffusivity>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G915/> , <http://vocab.nerc.ac.uk/collection/P64/current/G915/>;
        skos:definition        "The vertical_component_of_ocean_xy_tracer_diffusivity means the vertical component of the diffusivity of tracers in the ocean due to lateral mixing. This quantity could appear in formulations of lateral diffusivity in which \"lateral\" does not mean \"iso-level\", e.g. it would not be used for isopycnal diffusivity. \"Tracer diffusivity\" means the diffusivity of heat and salinity due to motion which is not resolved on the grid scale of the model."@en;
        skos:notation          "SDN:P07::CFV10N46";
        skos:note              "accepted"@en;
        skos:prefLabel         "vertical_component_of_ocean_xy_tracer_diffusivity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/SQMS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N49/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N49";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CF12N49";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N49/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N49/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N49/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_halon1211/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_halon1211>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G147/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The mass is the total mass of the molecules. The chemical formula for Halon1211 is CBrClF2. The IUPAC name for Halon1211 is bromo-chloro-difluoromethane."@en;
        skos:notation          "SDN:P07::CF12N49";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_halon1211"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/00DLLYK5/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::00DLLYK5";
