        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hypobromous acid is HOBr."@en;
        skos:notation          "SDN:P07::CF12N277";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hypobromous_acid_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZCTV5X1C/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZCTV5X1C";
        dc:date                "2024-01-18 09:01:44.0";
        dc:identifier          "SDN:P07::ZCTV5X1C";
        pav:authoredOn         "2024-01-18 09:01:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZCTV5X1C/1/>;
        pav:version            "1";
