<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A33/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A33";
        dc:date                "2010-10-11 13:13:32.0";
        dc:identifier          "SDN:P07::CFV16A33";
