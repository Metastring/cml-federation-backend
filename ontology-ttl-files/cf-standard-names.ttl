        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/SUAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G166/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for dimethyl sulfide is (CH3)2S.  Dimethyl sulfide is sometimes referred to as DMS."@en;
        skos:notation          "SDN:P07::CF12N133";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_dimethyl_sulfide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/43VJT7LA/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::43VJT7LA";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::43VJT7LA";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/43VJT7LA/1/>;
        pav:version            "1";
