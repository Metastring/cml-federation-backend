        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_241Cm/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_241Cm>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Cm\" means the element \"curium\" and \"241Cm\" is the isotope \"curium-241\" with a half-life of 3.50e+01 days."@en;
        skos:notation          "SDN:P07::ALE90AK9";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_241Cm"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0774/>
        rdf:type               skos:Concept;
