        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Es\" means the element \"einsteinium\" and \"254mEs\" is the metastable state of the isotope \"einsteinium-254\" with a half-life of 1.63e+00 days."@en;
        skos:notation          "SDN:P07::IK0VOVON";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_254mEs_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

