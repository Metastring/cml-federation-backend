        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"C\" means the element \"carbon\" and \"11C\" is the isotope \"carbon-11\" with a half-life of 1.41e-02 days."@en;
        skos:notation          "SDN:P07::8YU5J8HW";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_11C"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BBAH2134/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BBAH2134";
        dc:date                "2011-07-21 17:13:25.0";
        dc:identifier          "SDN:P07::BBAH2134";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0177/>;
        pav:authoredOn         "2011-07-21 17:13:25.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/BBAH2134/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_water_vapor_due_to_turbulence> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_water_vapor_due_to_turbulence/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0177/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"tendency_of_X\" means derivative of X with respect to time. \"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. Atmosphere water vapor content is sometimes referred to as \"precipitable water\", although this term does not imply the water could all be precipitated."@en;
        skos:notation          "SDN:P07::BBAH2134";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_water_vapor_due_to_turbulence"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0177/>
