<http://vocab.nerc.ac.uk/collection/P07/current/MSGLVHVF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MSGLVHVF";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::MSGLVHVF";
