        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AALK/> , <http://vocab.nerc.ac.uk/collection/P04/current/G138/>;
        skos:definition        "The construction \"moles_of_X_in_atmosphere\" means the total number of moles of X contained in the entire atmosphere, i.e, summed over the atmospheric column and over the entire globe.  The chemical formula of methane is CH4."@en;
