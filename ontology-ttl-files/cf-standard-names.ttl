        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G242/> , <http://vocab.nerc.ac.uk/collection/P04/current/G242/>;
        skos:definition        "Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y.  The chemical formula of water vapor is H2O."@en;
