        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"H\" means the element \"hydrogen\" and \"3H\" is the isotope \"hydrogen-3\" with a half-life of 4.51e+03 days."@en;
        skos:notation          "SDN:P07::HU47W0MR";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_3H_in_air"@en;
