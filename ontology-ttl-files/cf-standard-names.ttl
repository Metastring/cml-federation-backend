        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_nitrogen_monoxide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N83/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N83";
