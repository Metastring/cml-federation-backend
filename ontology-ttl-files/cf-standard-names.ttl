        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/isotropic_shortwave_radiance_in_air> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSNA006/> , <http://vocab.nerc.ac.uk/standard_name/isotropic_shortwave_radiance_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G214/> , <http://vocab.nerc.ac.uk/collection/P04/current/G214/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/>;
        skos:definition        "'shortwave' means shortwave radiation. Radiance is the radiative flux in a particular direction, per unit of solid angle. If radiation is isotropic, the radiance is independent of direction, so the direction should not be specified. If the radiation is directionally dependent, a standard name of upwelling or downwelling radiance should be chosen instead."@en;
        skos:notation          "SDN:P07::CFSN0613";
        skos:note              "accepted"@en;
        skos:prefLabel         "isotropic_shortwave_radiance_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/WMSS/> .

