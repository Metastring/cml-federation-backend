        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/thickness_of_stratiform_rainfall_amount> , <http://vocab.nerc.ac.uk/standard_name/thickness_of_stratiform_rainfall_amount/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0141/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G288/> , <http://vocab.nerc.ac.uk/collection/P04/current/G288/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G285/> , <http://vocab.nerc.ac.uk/collection/P64/current/G285/>;
        skos:definition        "\"Amount\" means mass per unit area.  The construction thickness_of_[X_]rainfall_amount means the accumulated \"depth\" of rainfall i.e. the thickness of a layer of liquid water having the same mass per unit area as the rainfall amount.  Stratiform precipitation, whether liquid or frozen, is precipitation that formed in stratiform cloud."@en;
        skos:notation          "SDN:P07::CFV15A31";
        skos:note              "accepted"@en;
        skos:prefLabel         "thickness_of_stratiform_rainfall_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

