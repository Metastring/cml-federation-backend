<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0798/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0798";
        dc:date                "2015-01-07 15:23:08.0";
        dc:identifier          "SDN:P07::CFSN0798";
