<http://vocab.nerc.ac.uk/collection/P07/current/CF12N186/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N186";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N186";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N186/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_optical_thickness_due_to_stratiform_cloud> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_optical_thickness_due_to_stratiform_cloud/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ATVS/> , <http://vocab.nerc.ac.uk/collection/P04/current/G271/> , <http://vocab.nerc.ac.uk/collection/P64/current/G271/>;
        skos:definition        "The optical thickness is the integral along the path of radiation of a volume scattering/absorption/attenuation coefficient. The radiative flux is reduced by a factor exp(-optical_thickness) on traversing the path.  A coordinate variable of radiation_wavelength or radiation_frequency can be specified to indicate that the optical thickness applies at specific wavelengths or frequencies. The atmosphere optical thickness applies to radiation passing through the entire atmosphere.  In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes).  The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase."@en;
        skos:notation          "SDN:P07::CF12N186";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_optical_thickness_due_to_stratiform_cloud"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N268/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N268";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CF12N268";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N268/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N268/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_hcfc22_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_hcfc22_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G148/>;
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for HCFC22 is CHClF2. The IUPAC name for HCFC22 is chloro(difluoro)methane."@en;
        skos:notation          "SDN:P07::CF12N268";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hcfc22_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N34/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N34";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::CFV10N34";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N34/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV10N34/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/sea_ice_albedo> , <http://vocab.nerc.ac.uk/standard_name/sea_ice_albedo/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G628/> , <http://vocab.nerc.ac.uk/collection/P64/current/G524/> , <http://vocab.nerc.ac.uk/collection/P04/current/G524/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P02/current/IPHY/> , <http://vocab.nerc.ac.uk/collection/P04/current/G199/> , <http://vocab.nerc.ac.uk/collection/P64/current/G199/>;
        skos:definition        "The albedo of sea ice. Albedo is the ratio of outgoing to incoming shortwave irradiance, where 'shortwave irradiance' means that both the incoming and outgoing radiation are integrated across the solar spectrum. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs."@en;
        skos:notation          "SDN:P07::CFV10N34";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_ice_albedo"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/NLFOFQF4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::NLFOFQF4";
