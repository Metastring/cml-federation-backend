<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N84/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N84";
        dc:date                "2008-04-15 14:00:00.0";
        dc:identifier          "SDN:P07::CFV8N84";
        pav:authoredOn         "2008-04-15 14:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N84/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/> , <http://vocab.nerc.ac.uk/collection/P64/current/G259/> , <http://vocab.nerc.ac.uk/collection/P04/current/G259/>;
        skos:definition        "The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).  The total tendency of the eastward wind due to gravity waves has the standard name tendency_of_eastward_wind_due_to_gravity_wave_drag.  It is the sum of the tendencies due to orographic gravity waves and nonorographic waves.  The tendency of eastward wind due to orographic gravity waves has the standard name tendency_of_eastward_wind_due_to_orographic_gravity_wave_drag."@en;
        skos:notation          "SDN:P07::CFV8N84";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_eastward_wind_due_to_nonorographic_gravity_wave_drag"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MPS2/> .

