<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0295/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0295";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::CFSN0295";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0295/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0295/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0295/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_diffuse_downwelling_photosynthetic_radiative_flux_in_air> , <http://vocab.nerc.ac.uk/standard_name/surface_diffuse_downwelling_photosynthetic_radiative_flux_in_air/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G436/> , <http://vocab.nerc.ac.uk/collection/P02/current/VSRA/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G436/>;
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. Downwelling radiation is radiation from above. It does not mean \"net downward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. \"Photosynthetic\" radiation is the part of the spectrum which is used in photosynthesis e.g. 400-700 nm. \"Diffuse\" radiation is radiation that has been scattered by gas molecules in the atmosphere and by particles such as cloud droplets and aerosols. The range of wavelengths could be specified precisely by the bounds of a coordinate of radiation_wavelength. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFSN0295";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_diffuse_downwelling_photosynthetic_radiative_flux_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

