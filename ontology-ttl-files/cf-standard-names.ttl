        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N87/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_carbon_monoxide> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_carbon_monoxide/>;
        owl:versionInfo        "2";
