        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical symbol for radon is Rn."@en;
        skos:notation          "SDN:P07::CF12N176";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_radon"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

