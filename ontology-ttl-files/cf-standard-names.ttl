        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sn\" means the element \"tin\" and \"121Sn\" is the isotope \"tin-121\" with a half-life of 1.12e+00 days."@en;
        skos:notation          "SDN:P07::52LGTG1X";
