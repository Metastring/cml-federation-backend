        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G284/> , <http://vocab.nerc.ac.uk/collection/P64/current/G290/> , <http://vocab.nerc.ac.uk/collection/P04/current/G290/> , <http://vocab.nerc.ac.uk/collection/P04/current/G284/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G285/> , <http://vocab.nerc.ac.uk/collection/P64/current/G285/>;
        skos:definition        "\"Amount\" means mass per unit area.  \"lwe\" means liquid water equivalent.  The construction lwe_thickness_of_X_amount or _content means the vertical extent of a layer of liquid water having the same mass per unit area.  Stratiform precipitation, whether liquid or frozen, is precipitation that formed in stratiform cloud."@en;
