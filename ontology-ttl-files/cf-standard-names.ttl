<http://vocab.nerc.ac.uk/collection/P07/current/WC485N1Y/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WC485N1Y";
        dc:date                "2015-07-08 15:41:36.0";
        dc:identifier          "SDN:P07::WC485N1Y";
        pav:authoredOn         "2015-07-08 15:41:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/WC485N1Y/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/solar_irradiance/> , <http://mmisw.org/ont/cf/parameter/solar_irradiance>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The quantity with standard name solar_irradiance, often called Total Solar Irradiance (TSI), is the radiation from the sun integrated over the whole electromagnetic spectrum and over the entire solar disk. The quantity applies outside the atmosphere, by default at a distance of one astronomical unit from the sun, but a coordinate or scalar coordinate variable of distance_from_sun can be used to specify a value other than the default. \"Irradiance\" means the power per unit area (called radiative flux in other standard names), the area being normal to the direction of flow of the radiant energy."@en;
        skos:notation          "SDN:P07::WC485N1Y";
        skos:note              "accepted"@en;
        skos:prefLabel         "solar_irradiance"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/EILJT68W/>
        rdf:type               skos:Concept;
