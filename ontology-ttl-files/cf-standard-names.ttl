        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pd\" means the element \"palladium\" and \"107mPd\" is the metastable state of the isotope \"palladium-107\" with a half-life of 2.47e-04 days."@en;
        skos:notation          "SDN:P07::OHAYRBX1";
