        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/7O14UQ0Z/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_95Nb_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_95Nb_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Nb\" means the element \"niobium\" and \"95Nb\" is the isotope \"niobium-95\" with a half-life of 3.52e+01 days."@en;
        skos:notation          "SDN:P07::7O14UQ0Z";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_95Nb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N711/>
        rdf:type               skos:Concept;
