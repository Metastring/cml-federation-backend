        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N9/> , <http://mmisw.org/ont/cf/parameter/eastward_transformed_eulerian_mean_air_velocity> , <http://vocab.nerc.ac.uk/standard_name/eastward_transformed_eulerian_mean_air_velocity/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/> , <http://vocab.nerc.ac.uk/collection/P64/current/H332/> , <http://vocab.nerc.ac.uk/collection/P04/current/H332/>;
        skos:definition        "\"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). The \"Transformed Eulerian Mean\" refers to a formulation of the mean equations which incorporates some eddy terms into the definition of the mean, described in Andrews et al (1987): Middle Atmospheric Dynamics. Academic Press."@en;
        skos:notation          "SDN:P07::CFV9S1";
