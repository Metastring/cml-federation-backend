        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Permafrost is soil or rock that has remained at a temperature at or below zero degrees Celsius throughout the seasonal cycle for two or more years. \"Thickness\" means the vertical extent of a layer."@en;
        skos:notation          "SDN:P07::CFV16A33";
        skos:note              "accepted"@en;
        skos:prefLabel         "permafrost_layer_thickness"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/98PAWYYW/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::98PAWYYW";
        dc:date                "2018-05-15 09:59:16.0";
        dc:identifier          "SDN:P07::98PAWYYW";
        pav:authoredOn         "2018-05-15 09:59:16.0";
