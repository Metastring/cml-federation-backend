<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0320/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0320";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0320";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0320/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/square_of_geopotential_height> , <http://vocab.nerc.ac.uk/standard_name/square_of_geopotential_height/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G124/> , <http://vocab.nerc.ac.uk/collection/P64/current/G124/> , <http://vocab.nerc.ac.uk/collection/P02/current/AHGT/>;
        skos:definition        "'square_of_X' means X*X. Geopotential is the sum of the specific gravitational potential energy relative to the geoid and the specific centripetal potential energy. Geopotential height is the geopotential divided by the standard acceleration due to gravity. It is numerically similar to the altitude (or geometric height) and not to the quantity with standard name height, which is relative to the surface."@en;
        skos:notation          "SDN:P07::CFSN0320";
        skos:note              "accepted"@en;
        skos:prefLabel         "square_of_geopotential_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UMSQ/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A27/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A27";
        dc:date                "2020-03-09 15:56:08.0";
        dc:identifier          "SDN:P07::CFV16A27";
        pav:authoredOn         "2020-03-09 15:56:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A27/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A27/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/number_concentration_of_cloud_liquid_water_particles_in_air/> , <http://mmisw.org/ont/cf/parameter/number_concentration_of_cloud_liquid_water_particles_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Number concentration\" means the number of particles or other specified objects per unit volume. \"Cloud liquid water\" refers to the liquid phase of cloud water. A diameter of 0.2 mm has been suggested as an upper limit to the size of drops that shall be regarded as cloud drops; larger drops fall rapidly enough so that only very strong updrafts can sustain them. Any such division is somewhat arbitrary, and active cumulus clouds sometimes contain cloud drops much larger than this. Reference: AMS Glossary http://glossary.ametsoc.org/wiki/Cloud_drop."@en;
        skos:notation          "SDN:P07::CFV16A27";
        skos:note              "accepted"@en;
        skos:prefLabel         "number_concentration_of_cloud_liquid_water_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PCUM/> .

