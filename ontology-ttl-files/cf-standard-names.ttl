<http://vocab.nerc.ac.uk/collection/P07/current/MYE6LV8Y/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::MYE6LV8Y";
        dc:date                "2013-11-08 14:08:46.0";
        dc:identifier          "SDN:P07::MYE6LV8Y";
        pav:authoredOn         "2013-11-08 14:08:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/MYE6LV8Y/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_convective_inhibition_wrt_surface/> , <http://mmisw.org/ont/cf/parameter/atmosphere_convective_inhibition_wrt_surface>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Convective inhibition is the amount of energy per unit mass required to overcome the negatively buoyant energy exerted by the environment on a parcel of air.  Convective inhibition is often abbreviated as \"CIN\" or \"CINH\".  It is calculated by integrating the negative temperature difference between the surrounding atmosphere and a parcel of air lifted adiabatically from the surface to its equilibrium level."@en;
        skos:notation          "SDN:P07::MYE6LV8Y";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_convective_inhibition_wrt_surface"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/JPKG/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N439/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N439";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::CF12N439";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N439/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N439/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_cfc11_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_cfc11_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G146/>;
        skos:definition        "\"Mole concentration\" means number of moles per unit volume, also called \"molarity\", and is used in the construction \"mole_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula of CFC11 is CFCl3. The IUPAC name for CFC11 is trichloro(fluoro)methane."@en;
        skos:notation          "SDN:P07::CF12N439";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_cfc11_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N605/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N605";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N605";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N605/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_benzene_due_to_emission> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_benzene_due_to_emission/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OHAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATEM/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase.  \"tendency_of_X\" means derivative of X with respect to time.  \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. earth's surface). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. The chemical formula for benzene is C6H6.  Benzene is the simplest aromatic hydrocarbon and has a ring structure consisting of six carbon atoms joined by alternating single and double chemical bonds. Each carbon atom is additionally bonded to one hydrogen atom. There are standard names that refer to aromatic_compounds as a group, as well as those for individual species."@en;
        skos:notation          "SDN:P07::CF12N605";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_benzene_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0BANM54Q/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0BANM54Q";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::0BANM54Q";
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0BANM54Q/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/0BANM54Q/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_acetone_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_acetone_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Mole fraction is used in the construction \"mole_fraction_of_X_in_Y\", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". Acetone is an organic molecule with the chemical formula CH3CH3CO. The IUPAC name for acetone is propan-2-one. Acetone is a member of the group of organic compounds known as ketones. There are standard names for the ketone group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::0BANM54Q";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_acetone_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV10N48/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV10N48";
        dc:date                "2008-10-21 10:00:00.0";
