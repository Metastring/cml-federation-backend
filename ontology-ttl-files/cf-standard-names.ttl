<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0062/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0062";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0062";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0062/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/volume_absorption_coefficient_of_radiative_flux_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/volume_absorption_coefficient_of_radiative_flux_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G940/> , <http://vocab.nerc.ac.uk/collection/P64/current/G940/> , <http://vocab.nerc.ac.uk/collection/P02/current/PPAB/>;
        skos:definition        "Radiative flux is the sum of shortwave and longwave radiative fluxes. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics. The volume scattering/absorption/attenuation coefficient is the fractional change of radiative flux per unit path length due to the stated process. Coefficients with canonical units of m2 s-1 i.e. multiplied by density have standard names with specific_ instead of volume_. The scattering/absorption/attenuation coefficient is assumed to be an integral over all wavelengths, unless a coordinate of radiation_wavelength is included to specify the wavelength."@en;
        skos:notation          "SDN:P07::CFSN0062";
        skos:note              "accepted"@en;
        skos:prefLabel         "volume_absorption_coefficient_of_radiative_flux_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPRM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/DDAEDBBI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::DDAEDBBI";
        dc:date                "2012-09-19 14:08:40.0";
        dc:identifier          "SDN:P07::DDAEDBBI";
