        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sn\" means the element \"tin\" and \"128Sn\" is the isotope \"tin-128\" with a half-life of 4.09e-02 days."@en;
        skos:notation          "SDN:P07::TSAYF33R";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_128Sn_in_air"@en;
