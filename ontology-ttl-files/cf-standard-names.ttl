        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_sulfate_dry_aerosol> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_sulfate_dry_aerosol/>;
        owl:versionInfo        "2";
