        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_roughness_length_for_heat_in_air/> , <http://mmisw.org/ont/cf/parameter/surface_roughness_length_for_heat_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G794/> , <http://vocab.nerc.ac.uk/collection/P04/current/G794/>;
