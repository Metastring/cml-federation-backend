        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N505/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_radon_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_radon_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical symbol for radon is Rn."@en;
        skos:notation          "SDN:P07::CF12N505";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_radon_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

