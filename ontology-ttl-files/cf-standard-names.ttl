        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cf\" means the element \"californium\" and \"253Cf\" is the isotope \"californium-253\" with a half-life of 1.76e+01 days."@en;
        skos:notation          "SDN:P07::R0NVONFW";
