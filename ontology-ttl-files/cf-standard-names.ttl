        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_nitrite_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_nitrite_in_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/NTRI/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as &amp;apos;nitrogen&amp;apos; or a phrase such as &amp;apos;nox_expressed_as_nitrogen&amp;apos;. The chemical formula for the nitrite anion is NO2-."@en;
        skos:notation          "SDN:P07::DDAEDBBI";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_nitrite_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

