        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A."@en;
        skos:notation          "SDN:P07::OVA1CJTZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "ocean_mass_content_of_particulate_organic_matter_expressed_as_carbon"@en;
