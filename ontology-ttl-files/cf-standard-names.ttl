        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/BBAH2134/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_water_vapor_content_due_to_turbulence> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_water_vapor_content_due_to_turbulence/>;
