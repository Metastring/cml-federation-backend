        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"237U\" is the isotope \"uranium-237\" with a half-life of 6.74e+00 days."@en;
        skos:notation          "SDN:P07::JQHNLRWP";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_237U_in_air"@en;
