<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A10/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A10";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::CFV16A10";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A10/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A10/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/diffuse_downwelling_shortwave_flux_in_air_assuming_clear_sky/> , <http://mmisw.org/ont/cf/parameter/diffuse_downwelling_shortwave_flux_in_air_assuming_clear_sky>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/>;
        skos:definition        "\"Diffuse\" radiation is radiation that has been scattered by gas molecules in the atmosphere and by particles such as cloud droplets and aerosols. Downwelling radiation is radiation from above. It does not mean \"net downward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. The term \"shortwave\" means shortwave radiation. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. A phrase assuming_condition indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. \"Clear sky\" means in the absence of clouds."@en;
        skos:notation          "SDN:P07::CFV16A10";
        skos:note              "accepted"@en;
        skos:prefLabel         "diffuse_downwelling_shortwave_flux_in_air_assuming_clear_sky"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0L1IA5Z9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0L1IA5Z9";
        dc:date                "2017-06-26 15:24:29.0";
        dc:identifier          "SDN:P07::0L1IA5Z9";
        pav:authoredOn         "2017-06-26 15:24:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0L1IA5Z9/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_sea_salt_dry_aerosol_particles_due_to_dry_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_sea_salt_dry_aerosol_particles_due_to_dry_deposition>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Dry deposition\" is the sum of turbulent deposition and gravitational settling. \"tendency_of_X\" means derivative of X with respect to time."@en;
        skos:notation          "SDN:P07::0L1IA5Z9";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_sea_salt_dry_aerosol_particles_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N9";
        dc:date                "2015-01-07 15:23:09.0";
        dc:identifier          "SDN:P07::CFV7N9";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/>;
        pav:authoredOn         "2015-01-07 15:23:09.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_due_to_dry_deposition> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_due_to_dry_deposition/> , <http://vocab.nerc.ac.uk/collection/P07/current/0L1IA5Z9/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  \"Aerosol\" means the suspended liquid or solid particles in air (except cloud droplets).  The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase.  \"tendency_of_X\" means derivative of X  with respect to time.  \"Dry deposition\" is the sum of turbulent deposition and gravitational settling."@en;
        skos:notation          "SDN:P07::CFV7N9";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> , <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/> .

<http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::C4AGSXHQ";
        dc:date                "2017-06-26 15:24:30.0";
        dc:identifier          "SDN:P07::C4AGSXHQ";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N9/>;
        pav:authoredOn         "2017-06-26 15:24:30.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/C4AGSXHQ/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_particles_due_to_dry_deposition/> , <http://vocab.nerc.ac.uk/collection/P07/current/0L1IA5Z9/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_particles_due_to_dry_deposition>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Dry deposition\" is the sum of turbulent deposition and gravitational settling. \"tendency_of_X\" means derivative of X with respect to time."@en;
        skos:notation          "SDN:P07::C4AGSXHQ";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_seasalt_dry_aerosol_particles_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N194/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N194";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::CF12N194";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N194/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N194/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/downwelling_shortwave_flux_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/downwelling_shortwave_flux_in_sea_water/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/VSRW/> , <http://vocab.nerc.ac.uk/collection/P04/current/G950/> , <http://vocab.nerc.ac.uk/collection/P64/current/G950/>;
        skos:definition        "Downwelling radiation is radiation from above. It does not mean \"net downward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. The term \"shortwave\" means shortwave radiation. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CF12N194";
        skos:note              "accepted"@en;
        skos:prefLabel         "downwelling_shortwave_flux_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/P9XAB8CM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::P9XAB8CM";
        dc:date                "2021-09-20 14:41:46.0";
        dc:identifier          "SDN:P07::P9XAB8CM";
        pav:authoredOn         "2021-09-20 14:41:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/P9XAB8CM/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_clay_in_soil/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_clay_in_soil>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass fraction\" is used in the construction \"mass_fraction_of_X_in_Y\", where X is a material constituent of Y. It is evaluated as the mass of X divided by the mass of Y (including X). It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction. Grain-size class distribution is based on the Udden-Wentworth scale."@en;
        skos:notation          "SDN:P07::P9XAB8CM";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_clay_in_soil"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/YMC52OKZ/>
        rdf:type               skos:Concept;
