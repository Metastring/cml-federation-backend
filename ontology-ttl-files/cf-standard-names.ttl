        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula of lutein is C40H56O2."@en;
        skos:notation          "SDN:P07::WXYTUBAM";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_lutein_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/GOF95M8G/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::GOF95M8G";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::GOF95M8G";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/GOF95M8G/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/GOF95M8G/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/ocean_mass_content_of_mesopelagic_fish_expressed_as_wet_weight/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. Mesopelagic fish live in the mesopelagic or \"Twilight Zone\" at depths of about 200-1000 m, where light is limited. The phrase \"expressed_as\" is used in the construction \"A_expressed_as_B\", where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Wet weight is the weight of a material, organism, or sample including its water (moisture) content, measured before drying."@en;
        skos:notation          "SDN:P07::GOF95M8G";
        skos:note              "accepted"@en;
        skos:prefLabel         "ocean_mass_content_of_mesopelagic_fish_expressed_as_wet_weight"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UGMS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0541/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0541";
