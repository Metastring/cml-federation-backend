<http://vocab.nerc.ac.uk/collection/P07/current/VKBFPUCH/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VKBFPUCH";
        dc:date                "2018-08-06 12:15:46.0";
        dc:identifier          "SDN:P07::VKBFPUCH";
        pav:authoredOn         "2018-08-06 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/VKBFPUCH/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_surface_tertiary_swell_wave_significant_height/> , <http://mmisw.org/ont/cf/parameter/sea_surface_tertiary_swell_wave_significant_height>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Swell waves are waves on the ocean surface and are the low frequency portion of a bimodal wave frequency spectrum. The tertiary swell wave is the third most energetic swell wave. Significant wave height is a statistic computed from wave measurements and corresponds to the mean height of the highest one third of the waves, where the height is defined as the vertical distance from a wave trough to the following wave crest."@en;
        skos:notation          "SDN:P07::VKBFPUCH";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_tertiary_swell_wave_significant_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N130/>
        rdf:type               skos:Concept;
