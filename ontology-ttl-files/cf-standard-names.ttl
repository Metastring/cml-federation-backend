        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Y-component of the unit vector describing the direction from the sensor to a point of interest, relative to the sensor. \"y\" indicates a vector component along the grid y-axis, positive with increasing y."@en;
