        owl:sameAs             <http://mmisw.org/ont/cf/parameter/liquid_water_content_of_surface_snow> , <http://vocab.nerc.ac.uk/standard_name/liquid_water_content_of_surface_snow/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0602/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G648/> , <http://vocab.nerc.ac.uk/collection/P02/current/CRYS/> , <http://vocab.nerc.ac.uk/collection/P64/current/G544/> , <http://vocab.nerc.ac.uk/collection/P04/current/G544/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants."@en;
