        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"I\" means the element \"iodine\" and \"134mI\" is the metastable state of the isotope \"iodine-134\" with a half-life of 2.50e-03 days."@en;
        skos:notation          "SDN:P07::388CZE5O";
