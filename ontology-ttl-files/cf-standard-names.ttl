        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G511/> , <http://vocab.nerc.ac.uk/collection/P04/current/G500/> , <http://vocab.nerc.ac.uk/collection/P64/current/G500/> , <http://vocab.nerc.ac.uk/collection/P64/current/G511/> , <http://vocab.nerc.ac.uk/collection/P04/current/G616/> , <http://vocab.nerc.ac.uk/collection/P04/current/G499/> , <http://vocab.nerc.ac.uk/collection/P04/current/G498/> , <http://vocab.nerc.ac.uk/collection/P04/current/G614/> , <http://vocab.nerc.ac.uk/collection/P04/current/G615/> , <http://vocab.nerc.ac.uk/collection/P64/current/G499/> , <http://vocab.nerc.ac.uk/collection/P64/current/G498/>;
        skos:definition        "\"Land ice\" means glaciers, ice-caps and ice-sheets resting on bedrock and also includes ice-shelves.  The land ice calving rate is the rate at which ice is lost per unit area through calving into the ocean."@en;
