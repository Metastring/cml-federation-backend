        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G920/> , <http://vocab.nerc.ac.uk/collection/P64/current/G920/> , <http://vocab.nerc.ac.uk/collection/P02/current/LRZA/>;
        skos:definition        "Bolus velocity in an ocean model means the velocity due to a scheme representing eddy-induced effects which are not resolved on the grid scale of the model.  \"Upward\" indicates a vector component which is positive when directed upward (negative downward)."@en;
        skos:notation          "SDN:P07::CFV8N6";
        skos:note              "deprecated"@en;
        skos:prefLabel         "bolus_upward_sea_water_velocity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

