        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Bi\" means the element \"bismuth\" and \"209Bi\" is the isotope \"bismuth-209\" with a half-life of 7.29e+20 days."@en;
        skos:notation          "SDN:P07::1R3TWUI7";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_209Bi"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/GE91C5LF/>
        rdf:type               skos:Concept;
