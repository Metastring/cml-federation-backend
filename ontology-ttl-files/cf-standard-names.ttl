        skos:notation          "SDN:P07::4PLWQDF6";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_78Ge_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/D4JW3DUD/>
