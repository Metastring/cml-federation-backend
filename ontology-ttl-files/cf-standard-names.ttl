        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_dichlorine_peroxide_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_dichlorine_peroxide_in_air>;
