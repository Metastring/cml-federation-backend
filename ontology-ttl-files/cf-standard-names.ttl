        owl:sameAs             <http://mmisw.org/ont/cf/parameter/soot_content_of_surface_snow> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0340/> , <http://vocab.nerc.ac.uk/standard_name/soot_content_of_surface_snow/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/IPHY/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants."@en;
        skos:notation          "SDN:P07::CFV15A11";
        skos:note              "accepted"@en;
        skos:prefLabel         "soot_content_of_surface_snow"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

