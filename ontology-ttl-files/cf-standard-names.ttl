<http://vocab.nerc.ac.uk/collection/P07/current/N3GAS3T7/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::N3GAS3T7";
        dc:date                "2024-01-18 09:01:44.0";
        dc:identifier          "SDN:P07::N3GAS3T7";
        pav:authoredOn         "2024-01-18 09:01:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/N3GAS3T7/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/silicate_mass_transport_in_river_channel/> , <http://mmisw.org/ont/cf/parameter/silicate_mass_transport_in_river_channel>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The amount of silicate mass transported in the river channels from land into the ocean. This quantity can be provided at a certain location within the river network and floodplain (over land) or at the river mouth (over ocean) where the river enters the ocean. \"River\" refers to water in the fluvial system (stream and floodplain)."@en;
        skos:notation          "SDN:P07::N3GAS3T7";
        skos:note              "accepted"@en;
        skos:prefLabel         "silicate_mass_transport_in_river_channel"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KGPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N277/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N277";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N277";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N277/1/>;
