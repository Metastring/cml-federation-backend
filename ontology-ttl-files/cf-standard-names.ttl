        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0789/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0789/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0789/3/>;
