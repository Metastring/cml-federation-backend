        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G917/> , <http://vocab.nerc.ac.uk/collection/P64/current/G917/>;
        skos:definition        "The water flux into sea water is the freshwater entering as a result of precipitation, evaporation, river inflow, sea ice effects and water flux correction (if applied).  The water flux into sea water from icebergs is due to the melting of the iceberg. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CF12N803";
        skos:note              "accepted"@en;
        skos:prefLabel         "water_flux_into_sea_water_from_icebergs"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

