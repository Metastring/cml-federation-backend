<http://vocab.nerc.ac.uk/collection/P07/current/P9IY6NIQ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::P9IY6NIQ";
        dc:date                "2018-08-06 12:15:46.0";
        dc:identifier          "SDN:P07::P9IY6NIQ";
        pav:authoredOn         "2018-08-06 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/P9IY6NIQ/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_surface_wave_directional_spread/> , <http://mmisw.org/ont/cf/parameter/sea_surface_wave_directional_spread>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Directional spread is the (one-sided) directional width within a given sub-domain of the wave directional spectrum, S(t,x,y,f,theta) where t is time, x and y are horizontal coordinates (such as longitude and latitude), f is frequency and theta is direction. For a given mean wave (beam) direction the quantity approximates half the root mean square width about the beam axis, as derived either directly from circular moments or via the Fourier components of the wave directional spectrum."@en;
        skos:notation          "SDN:P07::P9IY6NIQ";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_wave_directional_spread"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UAAA/> .

