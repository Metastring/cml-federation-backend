        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pa\" means the element \"protactinium\" and \"234Pa\" is the isotope \"protactinium-234\" with a half-life of 2.81e-01 days."@en;
        skos:notation          "SDN:P07::YRO3HBU4";
