        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_dinitrogen_pentoxide> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_dinitrogen_pentoxide/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/> , <http://vocab.nerc.ac.uk/collection/P04/current/G156/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for dinitrogen pentoxide is N2O5."@en;
        skos:notation          "SDN:P07::CF12N134";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_dinitrogen_pentoxide"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/388CZE5O/>
