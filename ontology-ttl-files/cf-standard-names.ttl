        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G935/> , <http://vocab.nerc.ac.uk/collection/P04/current/G935/> , <http://vocab.nerc.ac.uk/collection/P04/current/G866/> , <http://vocab.nerc.ac.uk/collection/P64/current/G866/>;
        skos:definition        "\"Upward\" indicates a vector component which is positive when directed upward (negative downward).  In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CF12N792";
        skos:note              "accepted"@en;
        skos:prefLabel         "upward_geothermal_heat_flux_at_sea_floor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/31IY1T9C/>
        rdf:type               skos:Concept;
