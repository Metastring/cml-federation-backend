<http://vocab.nerc.ac.uk/collection/P07/current/CF12N201/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N201";
        dc:date                "2019-05-14 17:27:21.0";
        dc:identifier          "SDN:P07::CF12N201";
        pav:authoredOn         "2019-05-14 17:27:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N201/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N201/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/effective_radius_of_stratiform_cloud_liquid_water_particle> , <http://vocab.nerc.ac.uk/collection/P07/current/VVZRYOE6/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_stratiform_cloud_liquid_water_particle/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/>;
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes)."@en;
        skos:notation          "SDN:P07::CF12N201";
        skos:note              "deprecated"@en;
        skos:prefLabel         "effective_radius_of_stratiform_cloud_liquid_water_particle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/VVZRYOE6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VVZRYOE6";
        dc:date                "2020-03-09 15:56:08.0";
        dc:identifier          "SDN:P07::VVZRYOE6";
        pav:authoredOn         "2020-03-09 15:56:08.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/VVZRYOE6/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/VVZRYOE6/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CF12N201/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_stratiform_cloud_liquid_water_particles/> , <http://mmisw.org/ont/cf/parameter/effective_radius_of_stratiform_cloud_liquid_water_particles>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. In an atmosphere model, stratiform cloud is that produced by large-scale convergence (not the convection schemes). \"Cloud liquid water\" refers to the liquid phase of cloud water. A diameter of 0.2 mm has been suggested as an upper limit to the size of drops that shall be regarded as cloud drops; larger drops fall rapidly enough so that only very strong updrafts can sustain them. Any such division is somewhat arbitrary, and active cumulus clouds sometimes contain cloud drops much larger than this. Reference: AMS Glossary http://glossary.ametsoc.org/wiki/Cloud_drop."@en;
        skos:notation          "SDN:P07::VVZRYOE6";
        skos:note              "accepted"@en;
        skos:prefLabel         "effective_radius_of_stratiform_cloud_liquid_water_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/BHMHISG2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::BHMHISG2";
        dc:date                "2016-05-17 15:31:00.0";
        dc:identifier          "SDN:P07::BHMHISG2";
        pav:authoredOn         "2016-05-17 15:31:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/BHMHISG2/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/water_volume_transport_in_river_channel/> , <http://mmisw.org/ont/cf/parameter/water_volume_transport_in_river_channel>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The water flux or volume transport in rivers is the amount of water flowing in the river channel and flood plain. \"Water\" means water in all phases."@en;
        skos:notation          "SDN:P07::BHMHISG2";
        skos:note              "accepted"@en;
        skos:prefLabel         "water_volume_transport_in_river_channel"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/CMPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZSDAR2KM";
        dc:date                "2026-09-15 05:36:52.0";
        dc:identifier          "SDN:P07::ZSDAR2KM";
        pav:authoredOn         "2026-09-15 05:36:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/5/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/4/> , <http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/ZSDAR2KM/3/>;
        pav:version            "5";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/amplitude_of_global_average_sea_level_change/> , <http://mmisw.org/ont/cf/parameter/amplitude_of_global_average_sea_level_change>;
        owl:versionInfo        "5";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ASLV/>;
        skos:definition        "Global average sea level change is due to change in volume of the water in the ocean, caused by mass and/or density change, or to change in the volume of the ocean basins, caused by tectonics etc. It is sometimes called \"eustatic\", which is a term that also has other definitions. It differs from the change in the global average sea surface height relative to the centre of the Earth by the global average vertical movement of the ocean floor. Zero sea level change is an arbitrary level. Amplitude is the magnitude of a periodic variation modeled by a sinusoidal function. A coordinate variable of harmonic_period should be used to specify the period of the sinusoidal function. Because global average sea level change quantifies the change in volume of the world ocean, it is not calculated necessarily by considering local changes in mean sea level."@en;
        skos:notation          "SDN:P07::ZSDAR2KM";
        skos:note              "accepted"@en;
        skos:prefLabel         "amplitude_of_global_average_sea_level_change"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0459/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0459";
        dc:date                "2024-05-20 20:39:49.0";
        dc:identifier          "SDN:P07::CFSN0459";
        pav:authoredOn         "2024-05-20 20:39:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0459/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0459/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/product_of_eastward_wind_and_air_temperature/> , <http://mmisw.org/ont/cf/parameter/product_of_eastward_wind_and_air_temperature>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The phrase \"product_of_X_and_Y\" means X*Y. Air temperature is the bulk temperature of the air, not the surface (skin) temperature. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) It is strongly recommended that a variable with this standard name should have a units_metadata attribute, with one of the values \"on-scale\" or \"difference\", whichever is appropriate for the data, because it is essential to know whether the temperature is on-scale (meaning relative to the origin of the scale indicated by the units) or refers to temperature differences (implying that the origin of the temperature scale is irrevelant), in order to convert the units correctly (cf. https://cfconventions.org/cf-conventions/cf-conventions.html#temperature-units)."@en;
        skos:notation          "SDN:P07::CFSN0459";
        skos:note              "accepted"@en;
        skos:prefLabel         "product_of_eastward_wind_and_air_temperature"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMTS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/04GMJ115/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::04GMJ115";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::04GMJ115";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/04GMJ115/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_162Gd_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_162Gd_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Gd\" means the element \"gadolinium\" and \"162Gd\" is the isotope \"gadolinium-162\" with a half-life of 6.92e-03 days."@en;
        skos:notation          "SDN:P07::04GMJ115";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_162Gd_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0092/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0092";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0092";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0092/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/toa_outgoing_shortwave_flux> , <http://vocab.nerc.ac.uk/standard_name/toa_outgoing_shortwave_flux/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G214/> , <http://vocab.nerc.ac.uk/collection/P04/current/G214/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/>;
        skos:definition        "'shortwave' means shortwave radiation. 'toa' means top of atmosphere. The TOA outgoing shortwave flux is the reflected and scattered solar radiative flux i.e. the 'upwelling' TOA shortwave flux, sometimes called the 'outgoing shortwave radiation' or 'OSR'. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0092";
        skos:note              "accepted"@en;
        skos:prefLabel         "toa_outgoing_shortwave_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0PILY4M8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0PILY4M8";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::0PILY4M8";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0PILY4M8/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_253Es/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_253Es>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Es\" means the element \"einsteinium\" and \"253Es\" is the isotope \"einsteinium-253\" with a half-life of 2.05e+01 days."@en;
        skos:notation          "SDN:P07::0PILY4M8";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_253Es"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N47/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N47";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N47";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N47/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_gaseous_elemental_mercury/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_gaseous_elemental_mercury>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical symbol for mercury is Hg."@en;
        skos:notation          "SDN:P07::CF12N47";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_gaseous_elemental_mercury"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N110/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N110";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N110";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N110/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_aceto_nitrile/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_aceto_nitrile>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for aceto-nitrile is CH3CN. The IUPAC name for aceto-nitrile is ethanenitrile."@en;
        skos:notation          "SDN:P07::CF12N110";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_aceto_nitrile"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/VCC2L73C/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VCC2L73C";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::VCC2L73C";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/VCC2L73C/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_144mPr_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_144mPr_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pr\" means the element \"praseodymium\" and \"144mPr\" is the metastable state of the isotope \"praseodymium-144\" with a half-life of 4.98e-03 days."@en;
        skos:notation          "SDN:P07::VCC2L73C";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_144mPr_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/AW3W63S6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::AW3W63S6";
        dc:date                "2018-05-15 09:59:16.0";
        dc:identifier          "SDN:P07::AW3W63S6";
        pav:authoredOn         "2018-05-15 09:59:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/AW3W63S6/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_content_of_methane_in_atmosphere_layer/> , <http://mmisw.org/ont/cf/parameter/mole_content_of_methane_in_atmosphere_layer>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"content_of_X_in_atmosphere_layer\" refers to the vertical integral between two specified levels in the atmosphere. \"Layer\" means any layer with upper and lower boundaries that have constant values in some vertical coordinate. There must be a vertical coordinate variable indicating the extent of the layer(s). If the layers are model layers, the vertical coordinate can be model_level_number, but it is recommended to specify a physical coordinate (in a scalar or auxiliary coordinate variable) as well. For the mole content integrated from the surface to the top of the atmosphere, standard names including \"atmosphere_mole_content_of_X\" are used. The chemical formula for methane is CH4. Methane is a member of the group of hydrocarbons known as alkanes. There are standard names for the alkane group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::AW3W63S6";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_content_of_methane_in_atmosphere_layer"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/2AUPDSFH/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::2AUPDSFH";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::2AUPDSFH";
        pav:authoredOn         "2018-02-12 16:53:18.0";
