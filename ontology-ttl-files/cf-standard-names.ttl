        pav:authoredOn         "2010-07-26 09:53:35.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0032/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV15A33/> , <http://mmisw.org/ont/cf/parameter/water_vapor_pressure> , <http://vocab.nerc.ac.uk/standard_name/water_vapor_pressure/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "Vapor pressure is the partial pressure of a constituent of air, such as water, which exists as liquid or solid under 'normal' conditions. 'Water' is specified when the term is being applied to water."@en;
        skos:notation          "SDN:P07::CFSN0032";
        skos:note              "deprecated"@en;
        skos:prefLabel         "water_vapor_pressure"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV15A33/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV15A33";
        dc:date                "2018-12-17 17:17:12.0";
        dc:identifier          "SDN:P07::CFV15A33";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0032/>;
        pav:authoredOn         "2018-12-17 17:17:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV15A33/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV15A33/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV15A33/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/water_vapor_partial_pressure_in_air> , <http://vocab.nerc.ac.uk/standard_name/water_vapor_partial_pressure_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0032/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G239/> , <http://vocab.nerc.ac.uk/collection/P04/current/G239/>;
        skos:definition        "The partial pressure of a gaseous constituent of air is the pressure that it would exert if all other gaseous constituents were removed, assuming the volume, the temperature, and its number of moles remain unchanged."@en;
        skos:notation          "SDN:P07::CFV15A33";
        skos:note              "accepted"@en;
        skos:prefLabel         "water_vapor_partial_pressure_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/WH0SX7G4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WH0SX7G4";
        dc:date                "2015-01-07 16:23:38.0";
        dc:identifier          "SDN:P07::WH0SX7G4";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFV7N12/>;
        pav:authoredOn         "2015-01-07 16:23:38.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/WH0SX7G4/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/WH0SX7G4/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_secondary_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_secondary_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The mass is the total mass of the particles. \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Dry deposition\" is the sum of turbulent deposition and gravitational settling. \"tendency_of_X\" means derivative of X with respect to time."@en;
        skos:notation          "SDN:P07::WH0SX7G4";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_secondary_particulate_organic_matter_dry_aerosol_particles_due_to_dry_deposition"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N12/>
        rdf:type               skos:Concept;
