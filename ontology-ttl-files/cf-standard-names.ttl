        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Rn\" means the element \"radon\" and \"218Rn\" is the isotope \"radon-218\" with a half-life of 4.05e-07 days."@en;
        skos:notation          "SDN:P07::XHA2F1JL";
