        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula of violaxanthin is C40H56O4."@en;
        skos:notation          "SDN:P07::OFEJXA57";
