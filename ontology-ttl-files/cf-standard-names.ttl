<http://vocab.nerc.ac.uk/collection/P07/current/CF12N270/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N270";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N270";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N270/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_hox_expressed_as_hydrogen_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_hox_expressed_as_hydrogen_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/H322/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. \"HOx\" means a combination of two radical species containing hydrogen and oxygen: OH and HO2. The phrase 'expressed_as' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A."@en;
        skos:notation          "SDN:P07::CF12N270";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_hox_expressed_as_hydrogen_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0036/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0036";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0036";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0036/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/wind_from_direction> , <http://vocab.nerc.ac.uk/collection/I01/current/0.2.0/> , <http://vocab.nerc.ac.uk/collection/B39/current/truewinddir/> , <http://vocab.nerc.ac.uk/standard_name/wind_from_direction/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P25/current/WINDF/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_WDIR/> , <http://vocab.nerc.ac.uk/collection/P02/current/EWSB/>;
        skos:definition        "Wind is defined as a two-dimensional (horizontal) air velocity vector, with no vertical component. (Vertical motion in the atmosphere has the standard name upward_air_velocity.) In meteorological reports, the direction of the wind vector is usually (but not always) given as the direction from which it is blowing (wind_from_direction) (westerly, northerly, etc.). In other contexts, such as atmospheric modelling, it is often natural to give the direction in the usual manner of vectors as the heading or the direction to which it is blowing (wind_to_direction) (eastward, southward, etc.) 'from_direction' is used in the construction X_from_direction and indicates the direction from which the velocity vector of X is coming."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/> , <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/>;
        skos:notation          "SDN:P07::CFSN0036";
        skos:note              "accepted"@en;
        skos:prefLabel         "wind_from_direction"@en;
