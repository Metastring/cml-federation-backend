        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/LWRD/> , <http://vocab.nerc.ac.uk/collection/P02/current/VSRA/> , <http://vocab.nerc.ac.uk/collection/P06/current/WM2S/> .

