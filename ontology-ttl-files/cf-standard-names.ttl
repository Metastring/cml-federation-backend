<http://vocab.nerc.ac.uk/collection/P07/current/VGXTAJQ9/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::VGXTAJQ9";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::VGXTAJQ9";
