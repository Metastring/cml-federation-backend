        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"I\" means the element \"iodine\" and \"130I\" is the isotope \"iodine-130\" with a half-life of 5.18e-01 days."@en;
        skos:notation          "SDN:P07::TBK8EI6R";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_130I"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/R0DL8DZL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::R0DL8DZL";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::R0DL8DZL";
