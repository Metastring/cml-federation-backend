        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Q41TRR91/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
