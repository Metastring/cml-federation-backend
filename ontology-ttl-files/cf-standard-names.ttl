        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ag\" means the element \"silver\" and \"115Ag\" is the isotope \"silver-115\" with a half-life of 1.46e-02 days."@en;
        skos:notation          "SDN:P07::YUR5UUHC";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_115Ag_in_air"@en;
