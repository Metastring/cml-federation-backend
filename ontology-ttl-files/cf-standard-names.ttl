<http://vocab.nerc.ac.uk/collection/P07/current/1KV13021/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1KV13021";
        dc:date                "2017-06-26 15:24:29.0";
        dc:identifier          "SDN:P07::1KV13021";
        pav:authoredOn         "2017-06-26 15:24:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1KV13021/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/halosteric_change_in_sea_surface_height/> , <http://mmisw.org/ont/cf/parameter/halosteric_change_in_sea_surface_height>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Sea surface height\" is a time-varying quantity. The halosteric change in sea surface height is the change in height that a water column of standard practical salinity S=35.0 would undergo when its salinity is changed to the observed value. The sum of the quantities with standard names thermosteric_change_in_sea_surface_height and halosteric_change_in_sea_surface_height is the total steric change in the water column height, which has the standard name of steric_change_in_sea_surface_height."@en;
        skos:notation          "SDN:P07::1KV13021";
        skos:note              "accepted"@en;
        skos:prefLabel         "halosteric_change_in_sea_surface_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/T3GXY9EZ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::T3GXY9EZ";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::T3GXY9EZ";
