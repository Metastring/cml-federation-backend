        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Pu\" means the element \"plutonium\" and \"242Pu\" is the isotope \"plutonium-242\" with a half-life of 1.38e+08 days."@en;
        skos:notation          "SDN:P07::CBQIGZYO";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_242Pu_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N267/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N267";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N267";
        pav:authoredOn         "2009-07-06 15:41:29.0";
