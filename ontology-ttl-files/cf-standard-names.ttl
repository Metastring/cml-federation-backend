        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/water_flux_into_sea_water_from_icebergs/> , <http://mmisw.org/ont/cf/parameter/water_flux_into_sea_water_from_icebergs>;
