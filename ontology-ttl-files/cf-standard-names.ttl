<http://vocab.nerc.ac.uk/collection/P07/current/7OOYYKZS/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::7OOYYKZS";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::7OOYYKZS";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/7OOYYKZS/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/reduced_gaussian_index/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Reduced Gaussian indices indicate the latitude and longitude location of cells, including their cell bounds, of a reduced Gaussian grid on a sphere. The relationship between reduced gaussian indices and latitude and longitude is described by the grid_mapping variable with a grid_mapping_name of \"reduced_gaussian\", that must be attached to the data variable as described in Chapter 5.6 of the CF Convention. A reduced gaussian index variable must have an integer data type."@en;
        skos:notation          "SDN:P07::7OOYYKZS";
        skos:note              "accepted"@en;
        skos:prefLabel         "reduced_gaussian_index"@en .

