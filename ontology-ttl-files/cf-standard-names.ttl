<http://vocab.nerc.ac.uk/collection/P07/current/CF12N365/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N365";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N365";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N365/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N365/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
