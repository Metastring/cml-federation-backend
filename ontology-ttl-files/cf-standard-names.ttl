        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0142/> , <http://mmisw.org/ont/cf/parameter/thickness_of_stratiform_snowfall_amount> , <http://vocab.nerc.ac.uk/standard_name/thickness_of_stratiform_snowfall_amount/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G290/> , <http://vocab.nerc.ac.uk/collection/P04/current/G290/> , <http://vocab.nerc.ac.uk/collection/P02/current/CRYS/> , <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/> , <http://vocab.nerc.ac.uk/collection/P04/current/G285/> , <http://vocab.nerc.ac.uk/collection/P64/current/G285/>;
        skos:definition        "\"Amount\" means mass per unit area.  The construction thickness_of_[X_]snowfall_amount means the accumulated \"depth\" of snow which fell i.e. the thickness of the layer of snow at its own density. There are corresponding standard names for liquid water equivalent (lwe) thickness.  Stratiform precipitation, whether liquid or frozen, is precipitation that formed in stratiform cloud."@en;
        skos:notation          "SDN:P07::CFV15A32";
        skos:note              "accepted"@en;
        skos:prefLabel         "thickness_of_stratiform_snowfall_amount"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

