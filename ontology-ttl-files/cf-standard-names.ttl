<http://vocab.nerc.ac.uk/collection/P07/current/XMJXPB8L/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XMJXPB8L";
        dc:date                "2024-09-04 12:51:23.0";
        dc:identifier          "SDN:P07::XMJXPB8L";
        pav:authoredOn         "2024-09-04 12:51:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/XMJXPB8L/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_pm10_magnesium_dry_aerosol_particles_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"Pm10 aerosol\" means atmospheric particulate compounds with an aerodynamic diameter of less than or equal to 10 micrometers. The chemical formula for the magnesium dication is Mg(2+)."@en;
        skos:notation          "SDN:P07::XMJXPB8L";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_pm10_magnesium_dry_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N2/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N2";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::CF14N2";
        pav:authoredOn         "2019-02-04 14:52:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N2/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF14N2/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/downward_eastward_momentum_flux_in_air_due_to_diffusion/> , <http://mmisw.org/ont/cf/parameter/downward_eastward_momentum_flux_in_air_due_to_diffusion>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). \"Downward\" indicates a vector component which is positive when directed downward (negative upward). \"Downward eastward\" indicates the ZX component of a tensor. Momentum flux is dimensionally equivalent to stress and pressure. It is a tensor quantity. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::CF14N2";
        skos:note              "accepted"@en;
        skos:prefLabel         "downward_eastward_momentum_flux_in_air_due_to_diffusion"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N534/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N534";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N534";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N534/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N534/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_fraction_of_nox_expressed_as_nitrogen_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_fraction_of_nox_expressed_as_nitrogen_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/> , <http://vocab.nerc.ac.uk/collection/P04/current/G161/>;
        skos:definition        "\"Mole fraction\" is used in the construction \"mole_fraction_of_X_in_Y\", where X is a material constituent of Y. A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. \"Nox\" means a combination of two radical species containing nitrogen and oxygen: NO+NO2."@en;
        skos:notation          "SDN:P07::CF12N534";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_nox_expressed_as_nitrogen_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ADPEI7N1/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ADPEI7N1";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::ADPEI7N1";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ADPEI7N1/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_133mI_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_133mI_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"I\" means the element \"iodine\" and \"133mI\" is the metastable state of the isotope \"iodine-133\" with a half-life of 1.04e-04 days."@en;
        skos:notation          "SDN:P07::ADPEI7N1";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_133mI_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/1TR26LC4/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1TR26LC4";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::1TR26LC4";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1TR26LC4/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_253Cf_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_253Cf_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Cf\" means the element \"californium\" and \"253Cf\" is the isotope \"californium-253\" with a half-life of 1.76e+01 days."@en;
        skos:notation          "SDN:P07::1TR26LC4";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_253Cf_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/V3K6HFXT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::V3K6HFXT";
        dc:date                "2018-07-10 09:28:29.0";
        dc:identifier          "SDN:P07::V3K6HFXT";
        pav:authoredOn         "2018-07-10 09:28:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/V3K6HFXT/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/V3K6HFXT/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/V3K6HFXT/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_surface_snow_amount_due_to_sublimation/> , <http://mmisw.org/ont/cf/parameter/tendency_of_surface_snow_amount_due_to_sublimation>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. The phrase \"surface_snow\" means snow lying on the surface. \"Amount\" means mass per unit area. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. Sublimation is the conversion of solid into vapor. Unless indicated in the cell_methods attribute, a quantity is assumed to apply to the whole area of each horizontal grid box."@en;
        skos:notation          "SDN:P07::V3K6HFXT";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_surface_snow_amount_due_to_sublimation"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N94/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N94";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N94";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N94/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_peroxynitric_acid/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_peroxynitric_acid>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for peroxynitric acid, sometimes referred to as PNA, is HO2NO2."@en;
        skos:notation          "SDN:P07::CF12N94";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_peroxynitric_acid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

