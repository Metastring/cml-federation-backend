        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N167/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_moles_of_nitrous_acid/> , <http://mmisw.org/ont/cf/parameter/atmosphere_moles_of_nitrous_acid>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for nitrous acid is HNO2."@en;
        skos:notation          "SDN:P07::CF12N167";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_nitrous_acid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MOLE/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N692/>
        rdf:type               skos:Concept;
