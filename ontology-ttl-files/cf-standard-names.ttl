        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_water_speed_shear/> , <http://mmisw.org/ont/cf/parameter/sea_water_speed_shear>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Speed is the magnitude of velocity. Sea water speed shear is the derivative of sea water speed with respect to depth."@en;
        skos:notation          "SDN:P07::6E9SGKVA";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_water_speed_shear"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0802/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0802";
        dc:date                "2007-05-15 11:55:00.0";
        dc:identifier          "SDN:P07::CFSN0802";
        pav:authoredOn         "2007-05-15 11:55:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0802/1/>;
        pav:version            "1";
