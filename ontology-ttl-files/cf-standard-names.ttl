        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/specific_turbulent_kinetic_energy_of_sea_water/> , <http://mmisw.org/ont/cf/parameter/specific_turbulent_kinetic_energy_of_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
