        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_water_in_ambient_aerosol> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_water_in_ambient_aerosol/>;
