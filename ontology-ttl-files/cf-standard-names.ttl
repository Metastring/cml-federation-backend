        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mole_concentration_of_water_vapor_in_air> , <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_water_vapor_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CHUM/> , <http://vocab.nerc.ac.uk/collection/P64/current/G242/> , <http://vocab.nerc.ac.uk/collection/P04/current/G242/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'."@en;
        skos:notation          "SDN:P07::CF12N508";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_water_vapor_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0068/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0068";
        dc:date                "2019-09-17 07:06:50.0";
        dc:identifier          "SDN:P07::CFSN0068";
        pav:authoredOn         "2019-09-17 07:06:50.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0068/3/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0068/2/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0068/1/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/volume_fraction_of_frozen_water_in_soil> , <http://vocab.nerc.ac.uk/standard_name/volume_fraction_of_frozen_water_in_soil/>;
        owl:versionInfo        "3";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/LWET/> , <http://vocab.nerc.ac.uk/collection/P64/current/G773/> , <http://vocab.nerc.ac.uk/collection/P04/current/G773/>;
        skos:definition        "\"Volume fraction\" is used in the construction \"volume_fraction_of_X_in_Y\", where X is a material constituent of Y. It is evaluated as the volume of X divided by the volume of Y (including X). It may be expressed as a fraction, a percentage, or any other dimensionless representation of a fraction. The phrase \"frozen_water\" means ice."@en;
        skos:notation          "SDN:P07::CFSN0068";
        skos:note              "accepted"@en;
        skos:prefLabel         "volume_fraction_of_frozen_water_in_soil"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N217/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N217";
