<http://vocab.nerc.ac.uk/collection/P07/current/CF12N31/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N31";
        dc:date                "2019-05-14 17:27:20.0";
        dc:identifier          "SDN:P07::CF12N31";
        pav:authoredOn         "2019-05-14 17:27:20.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N31/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N31/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_cfc12/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_cfc12>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G146/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including \"content_of_atmosphere_layer\" are used. The chemical formula for CFC12 is CF2Cl2. The IUPAC name for CFC12 is dichloro(difluoro)methane."@en;
        skos:notation          "SDN:P07::CF12N31";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_cfc12"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N316/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N316";
