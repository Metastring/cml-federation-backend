<http://vocab.nerc.ac.uk/collection/P07/current/CFV13A10/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV13A10";
        dc:date                "2018-08-06 12:15:46.0";
        dc:identifier          "SDN:P07::CFV13A10";
