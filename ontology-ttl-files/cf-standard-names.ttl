<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N82/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N82";
        dc:date                "2008-04-15 14:00:00.0";
        dc:identifier          "SDN:P07::CFV8N82";
