        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "This ozone field acts as a reference ozone field in a diagnostic call to the model's radiation scheme. \"Mole fraction\" is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y. The chemical formula for ozone is O3. The IUPAC name for ozone is trioxygen."@en;
        skos:notation          "SDN:P07::HR5LDNVI";
        skos:note              "accepted"@en;
        skos:prefLabel         "reference_mole_fraction_of_ozone_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MPMX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/SHL2LO1H/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::SHL2LO1H";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::SHL2LO1H";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/SHL2LO1H/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/radioactivity_concentration_of_156Eu_in_air/> , <http://mmisw.org/ont/cf/parameter/radioactivity_concentration_of_156Eu_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Eu\" means the element \"europium\" and \"156Eu\" is the isotope \"europium-156\" with a half-life of 1.52e+01 days."@en;
        skos:notation          "SDN:P07::SHL2LO1H";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_156Eu_in_air"@en;
