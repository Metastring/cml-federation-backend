        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G965/> , <http://vocab.nerc.ac.uk/collection/P64/current/G965/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_WAVES/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVST/> , <http://vocab.nerc.ac.uk/collection/P64/current/G976/> , <http://vocab.nerc.ac.uk/collection/P04/current/G976/>;
        skos:definition        "A period is an interval of time, or the time-period of an oscillation. The zero upcrossing period is defined as the time interval between consecutive occasions on which the surface height passes upward above the mean level."@en;
