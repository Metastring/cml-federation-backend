        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ACO2/> , <http://rdfdata.eionet.europa.eu/airquality/components/10> , <http://vocab.nerc.ac.uk/collection/P04/current/G133/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula of carbon monoxide is CO."@en;
        skos:notation          "SDN:P07::CF12N235";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_carbon_monoxide_in_air"@en;
