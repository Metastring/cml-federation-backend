<http://vocab.nerc.ac.uk/collection/P07/current/AGBEDAAB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::AGBEDAAB";
        dc:date                "2012-09-19 14:08:40.0";
        dc:identifier          "SDN:P07::AGBEDAAB";
