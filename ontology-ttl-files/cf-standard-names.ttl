<http://vocab.nerc.ac.uk/collection/P07/current/6JPVYO44/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::6JPVYO44";
        dc:date                "2020-09-14 20:42:12.0";
        dc:identifier          "SDN:P07::6JPVYO44";
        pav:authoredOn         "2020-09-14 20:42:12.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/6JPVYO44/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0003/> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_upward_absolute_vorticity/> , <http://mmisw.org/ont/cf/parameter/atmosphere_upward_absolute_vorticity>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Atmosphere upward absolute vorticity is the sum of the atmosphere upward relative vorticity and the vertical component of vorticity due to the Earth’s rotation. In contrast, the quantity with standard name atmosphere_upward_relative_vorticity excludes the Earth's rotation. Vorticity is a vector quantity. \"Upward\" indicates a vector component which is positive when directed upward (negative downward). A positive value of atmosphere_upward_absolute_vorticity indicates anticlockwise rotation when viewed from above."@en;
        skos:notation          "SDN:P07::6JPVYO44";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_upward_absolute_vorticity"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N64/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N64";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::CF12N64";
        pav:authoredOn         "2019-02-04 14:52:10.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N64/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N64/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
