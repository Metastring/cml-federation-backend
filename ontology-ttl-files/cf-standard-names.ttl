        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Downward\" indicates a vector component which is positive when directed downward (negative upward). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs."@en;
        skos:notation          "SDN:P07::7XZLO2SJ";
        skos:note              "accepted"@en;
        skos:prefLabel         "basal_downward_heat_flux_in_sea_ice"@en;
