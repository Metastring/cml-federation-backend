        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N629/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12N629/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_halon1202_due_to_emission/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_halon1202_due_to_emission>;
