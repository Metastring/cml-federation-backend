        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Sm\" means the element \"samarium\" and \"148Sm\" is the isotope \"samarium-148\" with a half-life of 2.92e+18 days."@en;
        skos:notation          "SDN:P07::4KYNIHSD";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_148Sm"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/W2UCETWV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::W2UCETWV";
        dc:date                "2026-06-08 13:55:32.0";
