        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Po\" means the element \"polonium\" and \"217Po\" is the isotope \"polonium-217\" with a half-life of 1.16e-04 days."@en;
        skos:notation          "SDN:P07::GWPLAQQ1";
