        skos:notation          "SDN:P07::490B6UTG";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_87Rb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZYUGY6RG/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZYUGY6RG";
        dc:date                "2022-03-18 12:42:55.0";
