        skos:broader           <http://vocab.nerc.ac.uk/collection/P25/current/NO3/> , <http://vocab.nerc.ac.uk/collection/P64/current/G892/> , <http://vocab.nerc.ac.uk/collection/P02/current/NTRA/> , <http://vocab.nerc.ac.uk/collection/A05/current/EV_NUTS/> , <http://vocab.nerc.ac.uk/collection/P04/current/G892/>;
        skos:definition        "moles_of_X_per_unit_mass_inY is also called 'molality' of X in Y, where X is a material constituent of Y."@en;
        skos:inScheme          <http://vocab.nerc.ac.uk/scheme/NETOC_PARAM/current/> , <http://vocab.nerc.ac.uk/scheme/NETMAR_OCEAN/current/>;
        skos:notation          "SDN:P07::CFSN0515";
        skos:note              "accepted"@en;
        skos:prefLabel         "moles_of_nitrate_per_unit_mass_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLKG/> .

<http://vocab.nerc.ac.uk/collection/P07/current/KPKG01HC/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::KPKG01HC";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::KPKG01HC";
