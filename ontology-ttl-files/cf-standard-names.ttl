<http://vocab.nerc.ac.uk/collection/P07/current/RHK1DYZX/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::RHK1DYZX";
        dc:date                "2017-11-28 06:51:05.0";
        dc:identifier          "SDN:P07::RHK1DYZX";
