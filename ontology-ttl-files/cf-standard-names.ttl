        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_ocean_mole_content_of_dissolved_inorganic_phosphorus/> , <http://mmisw.org/ont/cf/parameter/tendency_of_ocean_mole_content_of_dissolved_inorganic_phosphorus>;
