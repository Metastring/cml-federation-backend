        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ag\" means the element \"silver\" and \"115Ag\" is the isotope \"silver-115\" with a half-life of 1.46e-02 days."@en;
        skos:notation          "SDN:P07::EAINXD8V";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_115Ag_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/YIZJ5GAI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::YIZJ5GAI";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::YIZJ5GAI";
