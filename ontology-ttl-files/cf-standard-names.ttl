        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Np\" means the element \"neptunium\" and \"240Np\" is the isotope \"neptunium-240\" with a half-life of 4.38e-02 days."@en;
        skos:notation          "SDN:P07::7IOAPTCJ";
