        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/acoustic_proportion_occupied_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Acoustic proportion occupied is occupied volume divided by the volume sampled. Occupied volume is the integral of the ratio of acoustic_volume_backscattering_strength_in_sea_water above -90 dB to the reference value, 1 m2 m-2. For further details see Urmy et. al (2012) doi:10.1093/icesjms/fsr205."@en;
        skos:notation          "SDN:P07::07RO7YIE";
        skos:note              "accepted"@en;
        skos:prefLabel         "acoustic_proportion_occupied_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

