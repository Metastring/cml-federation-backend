        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N607/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N607/1/>;
        pav:version            "2";
