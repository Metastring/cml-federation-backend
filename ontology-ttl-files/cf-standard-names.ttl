        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CIEIIDJF/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_water_pressure_due_to_sea_water/> , <http://mmisw.org/ont/cf/parameter/sea_water_pressure_due_to_sea_water>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/PREX/> , <http://vocab.nerc.ac.uk/collection/P02/current/AHGT/>;
        skos:definition        "The pressure that exists in the medium of sea water due to overlying sea water. Excludes the pressure due to sea ice, air and any other medium that may be present. For sea water pressure including the pressure due to overlying media other than sea water, the standard name sea_water_pressure should be used."@en;
        skos:notation          "SDN:P07::CIEIIDJF";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_water_pressure_due_to_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UPDB/> .

