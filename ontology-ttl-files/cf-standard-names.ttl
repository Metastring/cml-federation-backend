        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mole_concentration_of_ammonia_in_air> , <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_ammonia_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://rdfdata.eionet.europa.eu/airquality/components/35> , <http://vocab.nerc.ac.uk/collection/P04/current/G155/> , <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for ammonia is NH3."@en;
        skos:notation          "SDN:P07::CF12N423";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_ammonia_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0389/>
