<http://vocab.nerc.ac.uk/collection/P07/current/CF12N656/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N656";
        dc:date                "2015-01-07 15:23:07.0";
        dc:identifier          "SDN:P07::CF12N656";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/N0WSPN8I/>;
        pav:authoredOn         "2015-01-07 15:23:07.0";
