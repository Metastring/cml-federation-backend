<http://vocab.nerc.ac.uk/collection/P07/current/CF14N10/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N10";
        dc:date                "2019-02-04 14:52:10.0";
        dc:identifier          "SDN:P07::CF14N10";
