        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0628/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/geopotential_height> , <http://vocab.nerc.ac.uk/standard_name/geopotential_height/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G124/> , <http://vocab.nerc.ac.uk/collection/P64/current/G124/> , <http://vocab.nerc.ac.uk/collection/P02/current/AHGT/>;
        skos:definition        "Geopotential is the sum of the specific gravitational potential energy relative to the geoid and the specific centripetal potential energy. Geopotential height is the geopotential divided by the standard acceleration due to gravity. It is numerically similar to the altitude (or geometric height) and not to the quantity with standard name height, which is relative to the surface."@en;
        skos:notation          "SDN:P07::CFSN0628";
        skos:note              "accepted"@en;
        skos:prefLabel         "geopotential_height"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

