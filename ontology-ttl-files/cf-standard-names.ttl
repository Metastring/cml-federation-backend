        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tropopause_adjusted_radiative_forcing/> , <http://mmisw.org/ont/cf/parameter/tropopause_adjusted_radiative_forcing>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G211/> , <http://vocab.nerc.ac.uk/collection/P64/current/G211/>;
        skos:definition        "Adjusted forcing is the radiative flux change caused by an imposed change in radiative forcing agent (greenhouse gases, aerosol, solar radiation, etc.) after allowance for stratospheric temperature adjustment. A positive radiative forcing or radiative effect is equivalent to a downward radiative flux and contributes to a warming of the earth system."@en;
        skos:notation          "SDN:P07::CFSN0097";
        skos:note              "accepted"@en;
        skos:prefLabel         "tropopause_adjusted_radiative_forcing"@en;
