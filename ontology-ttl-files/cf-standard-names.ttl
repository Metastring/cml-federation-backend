        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Se\" means the element \"selenium\" and \"81mSe\" is the metastable state of the isotope \"selenium-81\" with a half-life of 3.97e-02 days."@en;
        skos:notation          "SDN:P07::WV5QWE7F";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_81mSe_in_air"@en;
