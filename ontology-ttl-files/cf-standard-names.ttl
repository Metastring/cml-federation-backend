        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sb\" means the element \"antimony\" and \"125Sb\" is the isotope \"antimony-125\" with a half-life of 9.97e+02 days."@en;
        skos:notation          "SDN:P07::DVVYBJYV";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_125Sb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0499/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0499";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0499";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0499/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/net_upward_shortwave_flux_in_air> , <http://vocab.nerc.ac.uk/standard_name/net_upward_shortwave_flux_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G210/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G207/> , <http://vocab.nerc.ac.uk/collection/P64/current/G214/> , <http://vocab.nerc.ac.uk/collection/P04/current/G214/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P04/current/G207/>;
        skos:definition        "'shortwave' means shortwave radiation. 'Upward' indicates a vector component which is positive when directed upward (negative downward). Net upward radiation is the difference between radiation from below (upwelling) and radiation from above (downwelling). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0499";
        skos:note              "accepted"@en;
        skos:prefLabel         "net_upward_shortwave_flux_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CYH3A3PE/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CYH3A3PE";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::CYH3A3PE";
        pav:authoredOn         "2018-02-12 16:53:18.0";
