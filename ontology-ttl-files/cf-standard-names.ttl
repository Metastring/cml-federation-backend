        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Sb\" means the element \"antimony\" and \"130mSb\" is the metastable state of the isotope \"antimony-130\" with a half-life of 4.58e-03 days."@en;
        skos:notation          "SDN:P07::17YDB182";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_130mSb_in_air"@en;
