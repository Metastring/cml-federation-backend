<http://vocab.nerc.ac.uk/collection/P07/current/1R1EPJXY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1R1EPJXY";
        dc:date                "2015-07-08 15:41:36.0";
        dc:identifier          "SDN:P07::1R1EPJXY";
        pav:authoredOn         "2015-07-08 15:41:36.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1R1EPJXY/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection/> , <http://mmisw.org/ont/cf/parameter/distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The great circle distance measured from the tropical cyclone center to the leading edge of displaced convection, which is defined as the closest point that exceeds a threshold brightness temperature at top of atmosphere limit. The threshold applied should be recorded in a coordinate variable having the standard name of toa_brightness_temperature. A coordinate variable with standard name of radiation_wavelength, sensor_band_central_radiation_wavelength, or radiation_frequency may be specified to indicate that the brightness temperature applies at specific wavelengths or frequencies."@en;
        skos:notation          "SDN:P07::1R1EPJXY";
        skos:note              "accepted"@en;
        skos:prefLabel         "distance_from_tropical_cyclone_center_to_leading_edge_of_displaced_convection"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N331/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N331";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N331";
