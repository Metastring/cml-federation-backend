        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"U\" means the element \"uranium\" and \"240U\" is the isotope \"uranium-240\" with a half-life of 5.99e-01 days."@en;
        skos:notation          "SDN:P07::0580KMBR";
        skos:note              "accepted"@en;
