<http://vocab.nerc.ac.uk/collection/P07/current/CF12N74/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N74";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N74";
        pav:authoredOn         "2009-07-06 15:41:29.0";
