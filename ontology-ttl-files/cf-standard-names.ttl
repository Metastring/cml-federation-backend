<http://vocab.nerc.ac.uk/collection/P07/current/1MBRS65A/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::1MBRS65A";
        dc:date                "2024-09-04 12:51:24.0";
        dc:identifier          "SDN:P07::1MBRS65A";
        pav:authoredOn         "2024-09-04 12:51:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/1MBRS65A/1/>;
        pav:version            "1";
