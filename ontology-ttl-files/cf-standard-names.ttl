<http://vocab.nerc.ac.uk/collection/P07/current/F9MFZ76N/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::F9MFZ76N";
        dc:date                "2018-08-06 12:15:46.0";
        dc:identifier          "SDN:P07::F9MFZ76N";
        pav:authoredOn         "2018-08-06 12:15:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/F9MFZ76N/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/sea_surface_primary_swell_wave_directional_spread/> , <http://mmisw.org/ont/cf/parameter/sea_surface_primary_swell_wave_directional_spread>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The quantity with standard name sea_surface_primary_swell_wave_directional_spread is the directional width of the primary swell wave component of a sea. Swell waves are waves on the ocean surface and are the low frequency portion of a bimodal wave frequency spectrum. The primary swell wave is the most energetic swell wave. Directional spread is the (one-sided) directional width within a given sub-domain of the wave directional spectrum, S(t,x,y,f,theta) where t is time, x and y are horizontal coordinates (such as longitude and latitude), f is frequency and theta is direction. For a given mean wave (beam) direction the quantity approximates half the root mean square width about the beam axis, as derived either directly from circular moments or via the Fourier components of the wave directional spectrum."@en;
        skos:notation          "SDN:P07::F9MFZ76N";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_primary_swell_wave_directional_spread"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UAAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0532/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0532";
        dc:date                "2008-04-15 14:00:00.0";
        dc:identifier          "SDN:P07::CFSN0532";
        pav:authoredOn         "2008-04-15 14:00:00.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0532/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0532/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
