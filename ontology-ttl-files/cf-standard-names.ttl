        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A velocity is a vector quantity. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward). The velocity at the sea floor is that adjacent to the ocean bottom, which would be the deepest grid cell in an ocean model and within the benthic boundary layer for measurements."@en;
        skos:notation          "SDN:P07::TZDE16MA";
        skos:note              "accepted"@en;
        skos:prefLabel         "eastward_sea_water_velocity_at_sea_floor"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

