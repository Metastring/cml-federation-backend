        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Nb\" means the element \"niobium\" and \"96Nb\" is the isotope \"niobium-96\" with a half-life of 9.75e-01 days."@en;
        skos:notation          "SDN:P07::YA3JXPLK";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_96Nb"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

