        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Zr\" means the element \"zirconium\" and \"97Zr\" is the isotope \"zirconium-97\" with a half-life of 6.98e-01 days."@en;
        skos:notation          "SDN:P07::C0SVKACE";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_97Zr_in_air"@en;
