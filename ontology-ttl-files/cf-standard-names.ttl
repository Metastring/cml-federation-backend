        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/MTAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G130/> , <http://vocab.nerc.ac.uk/collection/P64/current/G130/>;
        skos:definition        "Mole fraction is used in the construction mole_fraction_of_X_in_Y, where X is a material constituent of Y. \"Divalent mercury\" means all compounds in which the mercury has two binding sites to other ion(s) in a salt or to other atom(s) in a molecule."@en;
        skos:notation          "SDN:P07::CFV7N52";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_fraction_of_gaseous_divalent_mercury_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A46/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A46";
        dc:date                "2018-04-16 15:20:52.0";
        dc:identifier          "SDN:P07::CFV16A46";
        pav:authoredOn         "2018-04-16 15:20:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A46/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A46/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_litter_carbon_content/> , <http://vocab.nerc.ac.uk/collection/P07/current/2MY21HA6/> , <http://mmisw.org/ont/cf/parameter/surface_litter_carbon_content>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "\"Content\" indicates a quantity per unit area.  \"Litter carbon\" is dead plant material in or above the soil quantified as the mass of carbon which it contains.  The surface called \"surface\" means the lower boundary of the atmosphere."@en;
        skos:notation          "SDN:P07::CFV16A46";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_litter_carbon_content"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/2MY21HA6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::2MY21HA6";
        dc:date                "2018-04-16 15:20:49.0";
        dc:identifier          "SDN:P07::2MY21HA6";
        pav:authoredOn         "2018-04-16 15:20:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/2MY21HA6/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A46/> , <http://vocab.nerc.ac.uk/standard_name/surface_litter_mass_content_of_carbon/> , <http://mmisw.org/ont/cf/parameter/surface_litter_mass_content_of_carbon>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Litter\" is dead plant material in or above the soil. It is distinct from coarse wood debris. The precise distinction between \"fine\" and \"coarse\" is model dependent. \"Surface litter\" means the part of the litter resting above the soil surface. \"Content\" indicates a quantity per unit area. The sum of the quantities with standard names surface_litter_mass_content_of_carbon and subsurface_litter_mass_content_of_carbon has the standard name litter_mass_content_of_carbon."@en;
        skos:notation          "SDN:P07::2MY21HA6";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_litter_mass_content_of_carbon"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/EPEHJBCO/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::EPEHJBCO";
