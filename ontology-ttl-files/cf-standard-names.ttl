        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "A velocity is a vector quantity. \"Eastward\" indicates a vector component which is positive when directed eastward (negative westward).The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::W2YRLZ9N";
        skos:note              "accepted"@en;
        skos:prefLabel         "eastward_sea_water_velocity_due_to_ekman_drift"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

