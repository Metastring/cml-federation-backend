        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::PNGZN8J0";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/PNGZN8J0/1/>;
        pav:version            "1";
