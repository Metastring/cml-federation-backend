<http://vocab.nerc.ac.uk/collection/P07/current/CF12N253/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N253";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N253";
