        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G967/> , <http://vocab.nerc.ac.uk/collection/P04/current/G967/> , <http://vocab.nerc.ac.uk/collection/P04/current/G965/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVST/> , <http://vocab.nerc.ac.uk/collection/P64/current/G965/> , <http://vocab.nerc.ac.uk/collection/P64/current/G970/> , <http://vocab.nerc.ac.uk/collection/P04/current/G970/>;
        skos:definition        "Height is the vertical distance above the surface. Swell waves are waves on the ocean surface."@en;
        skos:notation          "SDN:P07::CFSNA014";
        skos:note              "deprecated"@en;
        skos:prefLabel         "significant_height_of_swell_waves"@en .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0378/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0378";
        dc:date                "2016-07-19 15:18:51.0";
        dc:identifier          "SDN:P07::CFSN0378";
