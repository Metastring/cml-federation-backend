<http://vocab.nerc.ac.uk/collection/P07/current/CFV8N99/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV8N99";
        dc:date                "2009-07-06 16:30:47.0";
        dc:identifier          "SDN:P07::CFV8N99";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/CF12S47/>;
