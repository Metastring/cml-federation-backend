        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G917/> , <http://vocab.nerc.ac.uk/collection/P64/current/G917/> , <http://vocab.nerc.ac.uk/collection/P02/current/RVDS/>;
        skos:definition        "\"Water\" means water in all phases. The water flux or volume transport into sea water from rivers is the inflow to the ocean, often applied to the surface in ocean models. \"River\" refers to water in the fluvial system (stream and floodplain)."@en;
        skos:notation          "SDN:P07::CFV10S3";
        skos:note              "accepted"@en;
        skos:prefLabel         "water_volume_transport_into_sea_water_from_rivers"@en;
