        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mole_concentration_of_microzooplankton_in_sea_water_expressed_as_nitrogen> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12S29/> , <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_microzooplankton_in_sea_water_expressed_as_nitrogen/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G312/> , <http://vocab.nerc.ac.uk/collection/P04/current/G455/> , <http://vocab.nerc.ac.uk/collection/P04/current/G328/> , <http://vocab.nerc.ac.uk/collection/P04/current/G392/>;
        skos:definition        "Mole concentration means moles (amount of substance) per unit volume and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  The construction expressed_as_nitrogen means that the mole concentration is that of nitrogen atoms due to the microzooplankton.  Microzooplankton are protozoans (single-celled organisms) sized between 2x10-5 m and 2x10-4 m that feed on other plankton and telonemia."@en;
        skos:notation          "SDN:P07::CFSN0805";
        skos:note              "deprecated"@en;
        skos:prefLabel         "mole_concentration_of_microzooplankton_in_sea_water_expressed_as_nitrogen"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12S29/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12S29";
        dc:date                "2009-07-06 16:21:17.0";
        dc:identifier          "SDN:P07::CF12S29";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0805/>;
        pav:authoredOn         "2009-07-06 16:21:17.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12S29/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mole_concentration_of_microzooplankton_expressed_as_nitrogen_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_microzooplankton_expressed_as_nitrogen_in_sea_water/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0805/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G312/> , <http://vocab.nerc.ac.uk/collection/P04/current/G455/> , <http://vocab.nerc.ac.uk/collection/P04/current/G328/> , <http://vocab.nerc.ac.uk/collection/P04/current/G392/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The phrase 'expressed_as' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated in terms of B alone, neglecting all other chemical constituents of A."@en;
        skos:notation          "SDN:P07::CF12S29";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_microzooplankton_expressed_as_nitrogen_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

