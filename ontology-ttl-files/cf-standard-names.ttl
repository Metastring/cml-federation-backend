        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G523/> , <http://vocab.nerc.ac.uk/collection/P64/current/G523/> , <http://vocab.nerc.ac.uk/collection/P04/current/G646/>;
        skos:definition        "Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants. The surface called \"surface\" means the lower boundary of the atmosphere. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFSN0254";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_snow_melt_flux"@en;
