        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/VXU53AOW/1/> , <http://vocab.nerc.ac.uk/collection/P07/current/VXU53AOW/2/>;
        pav:version            "3";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
