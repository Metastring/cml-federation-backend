<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0780/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0780";
        dc:date                "2008-11-11 15:25:45.0";
        dc:identifier          "SDN:P07::CFSN0780";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0830/>;
        pav:authoredOn         "2008-11-11 15:25:45.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0780/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_net_downward_radiative_flux_where_land> , <http://vocab.nerc.ac.uk/standard_name/surface_net_downward_radiative_flux_where_land/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0830/> , <http://vocab.nerc.ac.uk/collection/P04/current/G207/> , <http://vocab.nerc.ac.uk/collection/P64/current/G207/> , <http://vocab.nerc.ac.uk/collection/P04/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G210/>;
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Downward\" indicates a vector component which is positive when directed downward (negative upward). Net downward radiation is the difference between radiation from above (downwelling) and radiation from below (upwelling). Radiative flux is the sum of shortwave and longwave radiative fluxes. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. Unless indicated, a quantity is assumed to apply to the whole area of each horizontal grid box. The qualifier where_type specifies instead that the quantity applies only to the part of the grid box of the named type."@en;
        skos:notation          "SDN:P07::CFSN0780";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_net_downward_radiative_flux_where_land"@en .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0830/>
