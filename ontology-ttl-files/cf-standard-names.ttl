        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ag\" means the element \"silver\" and \"111Ag\" is the isotope \"silver-111\" with a half-life of 7.50e+00 days."@en;
        skos:notation          "SDN:P07::PEZG1L1O";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_111Ag_in_air"@en;
