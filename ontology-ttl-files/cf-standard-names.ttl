        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/northward_transformed_eulerian_mean_air_velocity> , <http://vocab.nerc.ac.uk/standard_name/northward_transformed_eulerian_mean_air_velocity/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV8N69/>;
