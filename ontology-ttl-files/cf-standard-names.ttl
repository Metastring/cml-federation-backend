        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_methyl_chloride> , <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_methyl_chloride/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G147/> , <http://vocab.nerc.ac.uk/collection/P04/current/G134/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for methyl chloride is CH3Cl. The IUPAC name for methyl chloride is chloromethane."@en;
