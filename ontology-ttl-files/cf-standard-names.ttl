        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The slope angle is the angle (in degrees) measured between the ground (earth) surface plane and a flat, horizontal surface."@en;
        skos:notation          "SDN:P07::GZCFTK5R";
