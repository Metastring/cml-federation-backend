<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0497/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0497";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0497";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0497/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/net_upward_longwave_flux_in_air> , <http://vocab.nerc.ac.uk/standard_name/net_upward_longwave_flux_in_air/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G209/> , <http://vocab.nerc.ac.uk/collection/P64/current/G209/> , <http://vocab.nerc.ac.uk/collection/P64/current/G207/> , <http://vocab.nerc.ac.uk/collection/P64/current/G206/> , <http://vocab.nerc.ac.uk/collection/P02/current/LWRD/> , <http://vocab.nerc.ac.uk/collection/P04/current/G206/> , <http://vocab.nerc.ac.uk/collection/P04/current/G207/>;
        skos:definition        "'longwave' means longwave radiation. 'Upward' indicates a vector component which is positive when directed upward (negative downward). Net upward radiation is the difference between radiation from below (upwelling) and radiation from above (downwelling). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0497";
        skos:note              "accepted"@en;
        skos:prefLabel         "net_upward_longwave_flux_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF14N36/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N36";
        dc:date                "2010-05-12 12:47:52.0";
        dc:identifier          "SDN:P07::CF14N36";
        pav:authoredOn         "2010-05-12 12:47:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N36/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/mole_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water> , <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical or biological species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The phrase 'expressed_as' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. Organic detritus are particles of debris from decaying plants and animals."@en;
        skos:notation          "SDN:P07::CF14N36";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_organic_detritus_expressed_as_carbon_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> , <http://vocab.nerc.ac.uk/collection/P02/current/CNTX/> , <http://vocab.nerc.ac.uk/collection/P02/current/ZCTC/> , <http://vocab.nerc.ac.uk/collection/P02/current/MZBC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/GM5YDTAL/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::GM5YDTAL";
        dc:date                "2026-09-15 05:36:53.0";
        dc:identifier          "SDN:P07::GM5YDTAL";
        pav:authoredOn         "2026-09-15 05:36:53.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/GM5YDTAL/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_oxidized_mercury_in_phytoplankton/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mole concentration\" means number of moles per unit volume, also called \"molarity\", and is used in the construction \"mole_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Oxidized mercury\" refers to mercury in its ionic form, which may be directly emitted to the environment or formed through the oxidation of elemental mercury. Phytoplankton are algae that grow where there is sufficient light to support photosynthesis."@en;
        skos:notation          "SDN:P07::GM5YDTAL";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_oxidized_mercury_in_phytoplankton"@en .

<http://vocab.nerc.ac.uk/collection/P07/current/RUYKFXTZ/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::RUYKFXTZ";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::RUYKFXTZ";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/RUYKFXTZ/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/shallow_convective_cloud_base_altitude/> , <http://mmisw.org/ont/cf/parameter/shallow_convective_cloud_base_altitude>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"cloud_base\" refers to the base of the lowest cloud. Altitude is the (geometric) height above the geoid, which is the reference geopotential surface. The geoid is similar to mean sea level. Shallow convective cloud is nonprecipitating cumulus cloud with a cloud top below 3000m above the surface produced by the convection schemes in an atmosphere model. Some atmosphere models differentiate between shallow and deep convection."@en;
        skos:notation          "SDN:P07::RUYKFXTZ";
        skos:note              "accepted"@en;
        skos:prefLabel         "shallow_convective_cloud_base_altitude"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

