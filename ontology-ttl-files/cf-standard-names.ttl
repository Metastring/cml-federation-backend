        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G192/> , <http://vocab.nerc.ac.uk/collection/P04/current/G192/> , <http://vocab.nerc.ac.uk/collection/P02/current/CAPH/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time. Air pressure is the force per unit area which would be exerted when the moving gas molecules of which the air is composed strike a theoretical surface of any orientation."@en;
