        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_water_content_due_to_advection> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_water_content_due_to_advection/> , <http://vocab.nerc.ac.uk/collection/P07/current/BBAH2142/>;
