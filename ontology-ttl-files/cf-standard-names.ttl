<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0571/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0571";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0571";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0571/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/lwe_thickness_of_soil_moisture_content> , <http://vocab.nerc.ac.uk/standard_name/lwe_thickness_of_soil_moisture_content/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/LWET/> , <http://vocab.nerc.ac.uk/collection/P64/current/G773/> , <http://vocab.nerc.ac.uk/collection/P04/current/G773/>;
        skos:definition        "'lwe' means liquid water equivalent. 'moisture' means water in all phases contained in soil. The construction lwe_thickness_of_X_amount or _content means the vertical extent of a layer of liquid water having the same mass per unit area. 'Content' indicates a quantity per unit area. The 'soil content' of a quantity refers to the vertical integral from the surface down to the bottom of the soil model. For the content between specified levels in the soil, standard names including content_of_soil_layer are used."@en;
        skos:notation          "SDN:P07::CFSN0571";
        skos:note              "accepted"@en;
        skos:prefLabel         "lwe_thickness_of_soil_moisture_content"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N470/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N470";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N470";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N470/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mole_concentration_of_hydrogen_bromide_in_air/> , <http://mmisw.org/ont/cf/parameter/mole_concentration_of_hydrogen_bromide_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/HLAT/>;
        skos:definition        "Mole concentration means number of moles per unit volume, also called \"molarity\", and is used in the construction mole_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for hydrogen bromide is HBr."@en;
        skos:notation          "SDN:P07::CF12N470";
        skos:note              "accepted"@en;
        skos:prefLabel         "mole_concentration_of_hydrogen_bromide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/65PHTU2D/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::65PHTU2D";
        dc:date                "2018-04-16 15:20:49.0";
        dc:identifier          "SDN:P07::65PHTU2D";
        pav:authoredOn         "2018-04-16 15:20:49.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/65PHTU2D/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_upward_mass_flux_of_carbon_dioxide_expressed_as_carbon_due_to_plant_respiration_for_biomass_growth/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A50/> , <http://mmisw.org/ont/cf/parameter/surface_upward_mass_flux_of_carbon_dioxide_expressed_as_carbon_due_to_plant_respiration_for_biomass_growth>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Upward\" indicates a vector component which is positive when directed upward (negative downward). In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. The chemical formula for carbon dioxide is CO2. The phrase \"expressed_as\" is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. The specification of a physical process by the phrase \"due_to_\" process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. Plant respiration is the sum of respiration by parts of plants both above and below the soil. It is assumed that all the respired carbon dioxide is emitted to the atmosphere. The term \"plants\" refers to the kingdom of plants in the modern classification which excludes fungi. Plants are autotrophs i.e. \"producers\" of biomass using carbon obtained from carbon dioxide."@en;
        skos:notation          "SDN:P07::65PHTU2D";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_upward_mass_flux_of_carbon_dioxide_expressed_as_carbon_due_to_plant_respiration_for_biomass_growth"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A50/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A50";
        dc:date                "2018-04-16 15:20:52.0";
        dc:identifier          "SDN:P07::CFV16A50";
        pav:authoredOn         "2018-04-16 15:20:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A50/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A50/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/65PHTU2D/> , <http://vocab.nerc.ac.uk/standard_name/surface_upward_carbon_mass_flux_due_to_plant_respiration_for_biomass_growth/> , <http://mmisw.org/ont/cf/parameter/surface_upward_carbon_mass_flux_due_to_plant_respiration_for_biomass_growth>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/ATEM/>;
        skos:definition        "\"Upward\" indicates a vector component which is positive when directed upward (negative downward).  Plant respiration is the sum of respiration by parts of plants both above and below the soil. Plants which photosynthesise are autotrophs i.e. \"producers\" of the biomass which they respire from inorganic precursors using sunlight for energy.  In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics.  The surface called \"surface\" means the lower boundary of the atmosphere.  The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase."@en;
        skos:notation          "SDN:P07::CFV16A50";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_upward_carbon_mass_flux_due_to_plant_respiration_for_biomass_growth"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0255";
        dc:date                "2021-01-18 16:23:44.0";
        dc:identifier          "SDN:P07::CFSN0255";
        pav:authoredOn         "2021-01-18 16:23:44.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0255/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_snow_melt_heat_flux/> , <http://mmisw.org/ont/cf/parameter/surface_snow_melt_heat_flux>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G523/> , <http://vocab.nerc.ac.uk/collection/P64/current/G523/>;
        skos:definition        "Surface snow refers to the snow on the solid ground or on surface ice cover, but excludes, for example, falling snowflakes and snow on plants. The snow melt heat flux is the supply of latent heat which is melting snow at freezing point. In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics."@en;
        skos:notation          "SDN:P07::CFSN0255";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_snow_melt_heat_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/Y6UY9WZV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::Y6UY9WZV";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::Y6UY9WZV";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/Y6UY9WZV/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/integral_wrt_time_of_radioactivity_concentration_of_210Bi_in_air/> , <http://mmisw.org/ont/cf/parameter/integral_wrt_time_of_radioactivity_concentration_of_210Bi_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"integral_wrt_X_of_Y\" means int Y dX. The data variable should have an axis for X specifying the limits of the integral as bounds. The phrase \"wrt\" means \"with respect to\". \"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Bi\" means the element \"bismuth\" and \"210Bi\" is the isotope \"bismuth-210\" with a half-life of 5.01e+00 days."@en;
        skos:notation          "SDN:P07::Y6UY9WZV";
        skos:note              "accepted"@en;
        skos:prefLabel         "integral_wrt_time_of_radioactivity_concentration_of_210Bi_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BSM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/I9GLGOPV/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::I9GLGOPV";
        dc:date                "2021-09-20 14:41:47.0";
        dc:identifier          "SDN:P07::I9GLGOPV";
        pav:authoredOn         "2021-09-20 14:41:47.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/I9GLGOPV/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/I9GLGOPV/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/indicative_error_from_multibeam_acoustic_doppler_velocity_profiler_in_sea_water/> , <http://mmisw.org/ont/cf/parameter/indicative_error_from_multibeam_acoustic_doppler_velocity_profiler_in_sea_water>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "Sea water velocity is a vector quantity that is the speed at which water travels in a specified direction. The \"indicative error\" is an estimate of the quality of a sea water velocity profile measured using an ADCP (acoustic doppler current profiler). It is determined by the difference between the vertical velocity calculated from two 3-beam solutions. The parameter is frequently referred to as the \"error velocity\"."@en;
        skos:notation          "SDN:P07::I9GLGOPV";
        skos:note              "accepted"@en;
        skos:prefLabel         "indicative_error_from_multibeam_acoustic_doppler_velocity_profiler_in_sea_water"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UVAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/3LRQADLT/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::3LRQADLT";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::3LRQADLT";
        dc:replaces            <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0088/>;
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/3LRQADLT/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/3LRQADLT/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/upwelling_radiative_flux_per_unit_wavelength_in_air> , <http://vocab.nerc.ac.uk/standard_name/upwelling_radiative_flux_per_unit_wavelength_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0088/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/VSRA/>;
        skos:definition        "Upwelling radiation is radiation from below. It does not mean \"net upward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. A coordinate variable for radiation wavelength should be given the standard name radiation_wavelength."@en;
        skos:notation          "SDN:P07::3LRQADLT";
        skos:note              "accepted"@en;
        skos:prefLabel         "upwelling_radiative_flux_per_unit_wavelength_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/WM2M/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0088/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0088";
        dc:date                "2013-06-27 14:07:56.0";
        dc:identifier          "SDN:P07::CFSN0088";
        dc:isReplacedBy        <http://vocab.nerc.ac.uk/collection/P07/current/3LRQADLT/>;
        pav:authoredOn         "2013-06-27 14:07:56.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0088/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0088/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/upwelling_spectral_radiative_flux_in_air> , <http://vocab.nerc.ac.uk/standard_name/upwelling_spectral_radiative_flux_in_air/> , <http://vocab.nerc.ac.uk/collection/P07/current/3LRQADLT/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G210/> , <http://vocab.nerc.ac.uk/collection/P64/current/G210/>;
        skos:definition        "Upwelling radiation is radiation from below. It does not mean 'net upward'. 'spectral' means per unit wavelength or as a function of wavelength; spectral quantities are sometimes called 'monochromatic'. Radiation wavelength has standard name radiation_wavelength. When thought of as being incident on a surface, a radiative flux is sometimes called 'irradiance'. In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called 'vector irradiance'. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0088";
        skos:note              "deprecated"@en;
        skos:prefLabel         "upwelling_spectral_radiative_flux_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P02/current/VSRA/> , <http://vocab.nerc.ac.uk/collection/P06/current/WM2M/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0371/>
        rdf:type               skos:Concept;
