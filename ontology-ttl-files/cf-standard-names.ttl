<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0231/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0231";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0231";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0231/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/surface_upward_latent_heat_flux> , <http://vocab.nerc.ac.uk/standard_name/surface_upward_latent_heat_flux/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G204/> , <http://vocab.nerc.ac.uk/collection/P64/current/G204/>;
        skos:definition        "The surface called 'surface' means the lower boundary of the atmosphere. 'Upward' indicates a vector component which is positive when directed upward (negative downward). The surface latent heat flux is the exchange of heat between the surface and the air on account of evaporation (including sublimation). In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0231";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_upward_latent_heat_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> , <http://vocab.nerc.ac.uk/collection/P02/current/HFLX/> .

