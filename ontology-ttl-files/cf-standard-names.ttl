        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Ag\" means the element \"silver\" and \"112Ag\" is the isotope \"silver-112\" with a half-life of 1.30e-01 days."@en;
        skos:notation          "SDN:P07::5O2I8TX2";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_112Ag_in_air"@en;
