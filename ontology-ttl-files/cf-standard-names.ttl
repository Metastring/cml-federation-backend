        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_moles_of_cfc114_in_atmosphere> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_moles_of_cfc114_in_atmosphere/> , <http://vocab.nerc.ac.uk/collection/P07/current/CF12S41/>;
        owl:versionInfo        "1";
