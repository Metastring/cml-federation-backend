        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_dimethyl_sulfide_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_dimethyl_sulfide_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/SUAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G166/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction mass_concentration_of_X_in_Y, where X is a material constituent of Y.  A chemical species denoted by X may be described by a single term such as 'nitrogen' or a phrase such as 'nox_expressed_as_nitrogen'. The chemical formula for dimethyl sulfide is (CH3)2S.  Dimethyl sulfide is sometimes referred to as DMS."@en;
        skos:notation          "SDN:P07::CF12N250";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_dimethyl_sulfide_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N27/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N27";
        dc:date                "2019-05-14 17:27:20.0";
        dc:identifier          "SDN:P07::CF12N27";
        pav:authoredOn         "2019-05-14 17:27:20.0";
