        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G977/> , <http://vocab.nerc.ac.uk/collection/P02/current/WVSP/> , <http://vocab.nerc.ac.uk/collection/P64/current/G977/>;
        skos:definition        "Sea surface wave variance spectral density is the variance of wave amplitude within a range of wave frequency."@en;
        skos:notation          "SDN:P07::CFSN0387";
        skos:note              "accepted"@en;
        skos:prefLabel         "sea_surface_wave_variance_spectral_density"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2SX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/TTE2HM2Q/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::TTE2HM2Q";
        dc:date                "2013-03-23 09:22:59.0";
        dc:identifier          "SDN:P07::TTE2HM2Q";
        pav:authoredOn         "2013-03-23 09:22:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/TTE2HM2Q/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/troposphere_mole_content_of_ozone/> , <http://mmisw.org/ont/cf/parameter/troposphere_mole_content_of_ozone>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OZON/>;
        skos:definition        "\"Content\" indicates a quantity per unit area. The \"troposphere content\" of a quantity refers to the vertical integral from the surface to the tropopause. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used. The chemical formula for ozone is O3. The IUPAC name for ozone is trioxygen."@en;
        skos:notation          "SDN:P07::TTE2HM2Q";
        skos:note              "accepted"@en;
        skos:prefLabel         "troposphere_mole_content_of_ozone"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLM2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/ZEQML5PB/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::ZEQML5PB";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::ZEQML5PB";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/ZEQML5PB/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/ZEQML5PB/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/3691THAI/> , <http://vocab.nerc.ac.uk/standard_name/surface_upwelling_shortwave_flux_in_air_assuming_clear_sky_and_no_aerosol/> , <http://mmisw.org/ont/cf/parameter/surface_upwelling_shortwave_flux_in_air_assuming_clear_sky_and_no_aerosol>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. Upwelling radiation is radiation from below. It does not mean \"net upward\". The sign convention is that \"upwelling\" is positive upwards and \"downwelling\" is positive downwards. The term \"shortwave\" means shortwave radiation. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. A phrase \"assuming_condition\" indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. \"Clear sky\" means in the absence of clouds."@en;
        skos:notation          "SDN:P07::ZEQML5PB";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_upwelling_shortwave_flux_in_air_assuming_clear_sky_and_no_aerosol"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/3691THAI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::3691THAI";
        dc:date                "2018-05-30 12:41:11.0";
        dc:identifier          "SDN:P07::3691THAI";
        pav:authoredOn         "2018-05-30 12:41:11.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/3691THAI/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/3691THAI/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_upwelling_shortwave_flux_in_air_assuming_clean_clear_sky/> , <http://mmisw.org/ont/cf/parameter/surface_upwelling_shortwave_flux_in_air_assuming_clean_clear_sky> , <http://vocab.nerc.ac.uk/collection/P07/current/ZEQML5PB/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. Upwelling radiation is radiation from below. It does not mean \"net upward\". The term \"shortwave\" means shortwave radiation. When thought of as being incident on a surface, a radiative flux is sometimes called \"irradiance\". In addition, it is identical with the quantity measured by a cosine-collector light-meter and sometimes called \"vector irradiance\". In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. A phrase \"assuming_condition\" indicates that the named quantity is the value which would obtain if all aspects of the system were unaltered except for the assumption of the circumstances specified by the condition. \"Clean sky\" means in the absence of atmospheric aerosol. \"Clear sky\" means in the absence of clouds."@en;
        skos:notation          "SDN:P07::3691THAI";
        skos:note              "deprecated"@en;
        skos:prefLabel         "surface_upwelling_shortwave_flux_in_air_assuming_clean_clear_sky"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UFAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/IAT04RTI/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::IAT04RTI";
        dc:date                "2018-05-15 09:59:16.0";
        dc:identifier          "SDN:P07::IAT04RTI";
        pav:authoredOn         "2018-05-15 09:59:16.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/IAT04RTI/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/hail_fall_flux/> , <http://mmisw.org/ont/cf/parameter/hail_fall_flux>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. Hail is precipitation in the form of balls or irregular lumps of ice, often restricted by a size convention to diameters of 5 mm or more. Reference: American Meteorological Society Glossary http://glossary.ametsoc.org/wiki/Hail. For diameters of less than 5 mm standard names for \"graupel\" should be used. Standard names for \"graupel_and_hail\" should be used to describe data produced by models that do not distinguish between hail and graupel."@en;
        skos:notation          "SDN:P07::IAT04RTI";
        skos:note              "accepted"@en;
        skos:prefLabel         "hail_fall_flux"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV15A15/>
        rdf:type               skos:Concept;
