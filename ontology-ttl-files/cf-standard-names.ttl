        skos:note              "accepted"@en;
        skos:prefLabel         "quality_flag"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N676/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N676";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N676";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N676/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_alpha_pinene/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_alpha_pinene>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/OHAT/> , <http://vocab.nerc.ac.uk/collection/P04/current/G140/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for alpha_pinene is C10H16. The IUPAC name for alpha-pinene is (1S,5S)-2,6,6-trimethylbicyclo[3.1.1]hept-2-ene."@en;
        skos:notation          "SDN:P07::CF12N676";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_alpha_pinene"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/0R0JQ51G/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::0R0JQ51G";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::0R0JQ51G";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/0R0JQ51G/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
