        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CAPH/> , <http://vocab.nerc.ac.uk/collection/P04/current/G191/> , <http://vocab.nerc.ac.uk/collection/P64/current/G191/>;
        skos:definition        "The term \"anomaly\" means difference from climatology. Air pressure is the force per unit area which would be exerted when the moving gas molecules of which the air is composed strike a theoretical surface of any orientation."@en;
        skos:notation          "SDN:P07::CFSN0016";
        skos:note              "accepted"@en;
        skos:prefLabel         "air_pressure_anomaly"@en;
