        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:definition        "In accordance with common usage in geophysical disciplines, \"flux\" implies per unit area, called \"flux density\" in physics. \"River\" refers to water in the fluvial system (stream and floodplain)."@en;
        skos:notation          "SDN:P07::MRZBZIAU";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_flux_of_carbon_into_sea_water_from_rivers"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

