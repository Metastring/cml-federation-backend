        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Eu\" means the element \"europium\" and \"155Eu\" is the isotope \"europium-155\" with a half-life of 1.75e+03 days."@en;
        skos:notation          "SDN:P07::RVR8AJ1G";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_155Eu"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0686/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0686";
        dc:date                "2006-09-26 18:12:43.0";
        dc:identifier          "SDN:P07::CFSN0686";
        pav:authoredOn         "2006-09-26 18:12:43.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0686/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/downward_eastward_momentum_flux_in_air/> , <http://mmisw.org/ont/cf/parameter/downward_eastward_momentum_flux_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "'Eastward' indicates a vector component which is positive when directed eastward (negative westward). 'Downward' indicates a vector component which is positive when directed downward (negative upward). 'Downward eastward' indicates the ZX component of a tensor. Momentum flux is dimensionally equivalent to stress and pressure. It is a tensor quantity. In accordance with common usage in geophysical disciplines, 'flux' implies per unit area, called 'flux density' in physics."@en;
        skos:notation          "SDN:P07::CFSN0686";
        skos:note              "accepted"@en;
        skos:prefLabel         "downward_eastward_momentum_flux_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

