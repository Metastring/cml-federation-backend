        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_drizzle_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_drizzle_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CPRP/>;
        skos:definition        "Mass concentration means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Drizzle\" means drops of water falling through the atmosphere that have a diameter typically in the range 0.2-0.5 mm."@en;
        skos:notation          "SDN:P07::BBAD2117";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_drizzle_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N198/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N198";
        dc:date                "2019-05-14 17:27:21.0";
        dc:identifier          "SDN:P07::CF12N198";
        pav:authoredOn         "2019-05-14 17:27:21.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N198/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N198/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/effective_radius_of_convective_cloud_snow_particle> , <http://vocab.nerc.ac.uk/collection/P07/current/9M3C9WFF/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_convective_cloud_snow_particle/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G280/> , <http://vocab.nerc.ac.uk/collection/P64/current/G269/> , <http://vocab.nerc.ac.uk/collection/P04/current/G269/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATPC/> , <http://vocab.nerc.ac.uk/collection/P04/current/G280/>;
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
        skos:notation          "SDN:P07::CF12N198";
        skos:note              "deprecated"@en;
        skos:prefLabel         "effective_radius_of_convective_cloud_snow_particle"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/9M3C9WFF/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::9M3C9WFF";
        dc:date                "2019-05-14 17:27:19.0";
        dc:identifier          "SDN:P07::9M3C9WFF";
        pav:authoredOn         "2019-05-14 17:27:19.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/9M3C9WFF/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/CF12N198/> , <http://vocab.nerc.ac.uk/standard_name/effective_radius_of_convective_cloud_snow_particles/> , <http://mmisw.org/ont/cf/parameter/effective_radius_of_convective_cloud_snow_particles>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The effective radius of a size distribution of particles, such as aerosols, cloud droplets or ice crystals, is the area weighted mean radius of particle size. It is calculated as the ratio of the third to the second moment of the particle size distribution. Convective cloud is that produced by the convection schemes in an atmosphere model."@en;
        skos:notation          "SDN:P07::9M3C9WFF";
        skos:note              "accepted"@en;
        skos:prefLabel         "effective_radius_of_convective_cloud_snow_particles"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/ULAA/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N702/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N702";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N702";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N702/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_moles_of_ethyne/> , <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_moles_of_ethyne>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AEYN/>;
        skos:definition        "\"tendency_of_X\" means derivative of X with respect to time.  The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for ethyne is HC2H.  Ethyne is the IUPAC name for this species, which is also commonly known as acetylene."@en;
        skos:notation          "SDN:P07::CF12N702";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_moles_of_ethyne"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/MLPS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N659/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N659";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N659";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N659/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/tendency_of_atmosphere_mass_content_of_propane_due_to_emission> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_atmosphere_mass_content_of_propane_due_to_emission/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/G140/> , <http://vocab.nerc.ac.uk/collection/P02/current/AALK/> , <http://vocab.nerc.ac.uk/collection/P02/current/ATEM/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase.  \"tendency_of_X\" means derivative of X with respect to time.  \"Emission\" means emission from a primary source located anywhere within the atmosphere, including at the lower boundary (i.e. earth's surface). \"Emission\" is a process entirely distinct from \"re-emission\" which is used in some standard names. The chemical formula for propane is C3H8. Propane is a member of the group of hydrocarbons known as alkanes.  There are standard names for the alkane group as well as for some of the individual species."@en;
        skos:notation          "SDN:P07::CF12N659";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_atmosphere_mass_content_of_propane_due_to_emission"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CF12N415/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N415";
        dc:date                "2019-03-04 17:29:46.0";
        dc:identifier          "SDN:P07::CF12N415";
        pav:authoredOn         "2019-03-04 17:29:46.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N415/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CF12N415/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_fraction_of_sulfuric_acid_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_fraction_of_sulfuric_acid_in_air>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/SUAT/>;
        skos:definition        "\"Mass fraction\" is used in the construction \"mass_fraction_of_X_in_Y\", where X is a material constituent of Y. It means the ratio of the mass of X to the mass of Y (including X). A chemical or biological species denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". The chemical formula for sulfuric acid is H2SO4."@en;
        skos:notation          "SDN:P07::CF12N415";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_fraction_of_sulfuric_acid_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/4MODYAJ8/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::4MODYAJ8";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::4MODYAJ8";
        pav:authoredOn         "2018-02-12 16:53:18.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/4MODYAJ8/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/surface_radioactivity_content_of_134Te/> , <http://mmisw.org/ont/cf/parameter/surface_radioactivity_content_of_134Te>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The surface called \"surface\" means the lower boundary of the atmosphere. \"Content\" indicates a quantity per unit area. \"Radioactivity\" means the number of radioactive decays of a material per second. \"Te\" means the element \"tellurium\" and \"134Te\" is the isotope \"tellurium-134\" with a half-life of 2.92e-02 days."@en;
        skos:notation          "SDN:P07::4MODYAJ8";
        skos:note              "accepted"@en;
        skos:prefLabel         "surface_radioactivity_content_of_134Te"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQSM/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV16A62/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV16A62";
        dc:date                "2018-07-03 16:09:24.0";
        dc:identifier          "SDN:P07::CFV16A62";
        pav:authoredOn         "2018-07-03 16:09:24.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A62/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A62/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "true";
        owl:sameAs             <http://vocab.nerc.ac.uk/collection/P07/current/9GNSLLJN/> , <http://vocab.nerc.ac.uk/standard_name/tendency_of_sea_ice_amount_due_to_snow_conversion/> , <http://mmisw.org/ont/cf/parameter/tendency_of_sea_ice_amount_due_to_snow_conversion>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CRYS/>;
        skos:definition        "\"Amount\" means mass per unit area.  The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase.  \"tendency_of_X\" means derivative of X with respect to time.  \"Snow to sea ice conversion\" occurs when the mass of snow accumulated on an area of sea ice is sufficient to cause the ice to become mostly submerged.  Waves can then wash over the ice and snow surface and freeze into a layer that becomes \"snow ice\"."@en;
        skos:notation          "SDN:P07::CFV16A62";
        skos:note              "deprecated"@en;
        skos:prefLabel         "tendency_of_sea_ice_amount_due_to_snow_conversion"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/9GNSLLJN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::9GNSLLJN";
        dc:date                "2018-07-03 16:09:23.0";
        dc:identifier          "SDN:P07::9GNSLLJN";
        pav:authoredOn         "2018-07-03 16:09:23.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/9GNSLLJN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_sea_ice_amount_due_to_conversion_of_snow_to_sea_ice/> , <http://mmisw.org/ont/cf/parameter/tendency_of_sea_ice_amount_due_to_conversion_of_snow_to_sea_ice> , <http://vocab.nerc.ac.uk/collection/P07/current/CFV16A62/>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "The phrase \"tendency_of_X\" means derivative of X with respect to time. \"Amount\" means mass per unit area. \"Sea ice\" means all ice floating in the sea which has formed from freezing sea water, rather than by other processes such as calving of land ice to form icebergs. The specification of a physical process by the phrase due_to_process means that the quantity named is a single term in a sum of terms which together compose the general quantity named by omitting the phrase. \"Conversion of snow to sea ice\" occurs when the mass of snow accumulated on an area of sea ice is sufficient to cause the ice to become mostly submerged. Waves can then wash over the ice and snow surface and freeze into a layer that becomes \"snow ice\"."@en;
        skos:notation          "SDN:P07::9GNSLLJN";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_sea_ice_amount_due_to_conversion_of_snow_to_sea_ice"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KSP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/XFANJ2GN/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::XFANJ2GN";
        dc:date                "2023-02-06 17:17:13.0";
        dc:identifier          "SDN:P07::XFANJ2GN";
        pav:authoredOn         "2023-02-06 17:17:13.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/XFANJ2GN/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/mass_concentration_of_absorption_equivalent_black_carbon_of_pm1_dry_aerosol_particles_in_air/> , <http://mmisw.org/ont/cf/parameter/mass_concentration_of_absorption_equivalent_black_carbon_of_pm1_dry_aerosol_particles_in_air>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Mass concentration\" means mass per unit volume and is used in the construction \"mass_concentration_of_X_in_Y\", where X is a material constituent of Y. A chemical species or biological group denoted by X may be described by a single term such as \"nitrogen\" or a phrase such as \"nox_expressed_as_nitrogen\". \"Aerosol\" means the system of suspended liquid or solid particles in air (except cloud droplets) and their carrier gas, the air itself. Aerosol particles take up ambient water (a process known as hygroscopic growth) depending on the relative humidity and the composition of the particles. \"Dry aerosol particles\" means aerosol particles without any water uptake. \"Pm1 aerosol\" means atmospheric particulate compounds with an aerodynamic diameter of less than or equal to 1 micrometer. The absorption equivalent black carbon mass concentration is obtained by conversion from the particle light absorption coefficient with a suitable mass absorption cross-section. Reference: Petzold, A., Ogren, J. A., Fiebig, M., Laj, P., Li, S.-M., Baltensperger, U., Holzer-Popp, T., Kinne, S., Pappalardo, G., Sugimoto, N., Wehrli, C., Wiedensohler, A., and Zhang, X.-Y.: Recommendations for reporting \"black carbon\" measurements, Atmos. Chem. Phys., 13, 8365-8379, https://doi.org/10.5194/acp-13-8365-2013, 2013."@en;
        skos:notation          "SDN:P07::XFANJ2GN";
        skos:note              "accepted"@en;
        skos:prefLabel         "mass_concentration_of_absorption_equivalent_black_carbon_of_pm1_dry_aerosol_particles_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UKMC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0724/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0724";
        dc:date                "2017-07-24 14:36:59.0";
        dc:identifier          "SDN:P07::CFSN0724";
        pav:authoredOn         "2017-07-24 14:36:59.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0724/2/>;
        pav:hasVersion         <http://vocab.nerc.ac.uk/collection/P07/current/CFSN0724/1/>;
        pav:version            "2";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://mmisw.org/ont/cf/parameter/difference_of_air_pressure_from_model_reference> , <http://vocab.nerc.ac.uk/standard_name/difference_of_air_pressure_from_model_reference/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CAPH/> , <http://vocab.nerc.ac.uk/collection/P04/current/G191/> , <http://vocab.nerc.ac.uk/collection/P64/current/G191/>;
        skos:definition        "In some atmosphere models, the difference of air pressure from model reference is a prognostic variable, instead of the air pressure itself. The model reference air pressure is a model-dependent constant. Air pressure is the force per unit area which would be exerted when the moving gas molecules of which the air is composed strike a theoretical surface of any orientation."@en;
        skos:notation          "SDN:P07::CFSN0724";
        skos:note              "accepted"@en;
        skos:prefLabel         "difference_of_air_pressure_from_model_reference"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PASX/> .

<http://vocab.nerc.ac.uk/collection/P07/current/WUA4S6BY/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::WUA4S6BY";
        dc:date                "2018-02-12 16:53:18.0";
