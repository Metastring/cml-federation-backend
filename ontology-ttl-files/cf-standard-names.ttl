        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Tb\" means the element \"terbium\" and \"161Tb\" is the isotope \"terbium-161\" with a half-life of 6.92e+00 days."@en;
        skos:notation          "SDN:P07::98JGWI26";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_161Tb_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

<http://vocab.nerc.ac.uk/collection/P07/current/QVNFG5G6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::QVNFG5G6";
