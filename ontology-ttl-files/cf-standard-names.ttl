        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:definition        "\"Radioactivity\" means the number of radioactive decays of a material per second. \"Radioactivity concentration\" means radioactivity per unit volume of the medium. \"Tb\" means the element \"terbium\" and \"162mTb\" is the metastable state of the isotope \"terbium-162\" with a half-life of 9.30e-02 days."@en;
        skos:notation          "SDN:P07::CYH3A3PE";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_162mTb_in_air"@en;
