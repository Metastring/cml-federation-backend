<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0049/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0049";
        dc:date                "2018-08-06 12:15:46.0";
        dc:identifier          "SDN:P07::CFSN0049";
