        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P04/current/H322/>;
        skos:definition        "The construction \"atmosphere_moles_of_X\" means the total number of moles of X in the entire atmosphere, i.e. summed over the atmospheric column and over the entire globe. The chemical formula for methyl hydroperoxide is CH3OOH."@en;
        skos:notation          "SDN:P07::CF12N160";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_moles_of_methyl_hydroperoxide"@en;
