        owl:sameAs             <http://mmisw.org/ont/cf/parameter/soil_albedo> , <http://vocab.nerc.ac.uk/standard_name/soil_albedo/>;
        owl:versionInfo        "2";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P64/current/G787/> , <http://vocab.nerc.ac.uk/collection/P02/current/CSLR/> , <http://vocab.nerc.ac.uk/collection/P04/current/G199/> , <http://vocab.nerc.ac.uk/collection/P64/current/G199/> , <http://vocab.nerc.ac.uk/collection/P04/current/G787/>;
        skos:definition        "Soil albedo is the albedo of the soil surface assuming no snow. Albedo is the ratio of outgoing to incoming shortwave irradiance, where 'shortwave irradiance' means that both the incoming and outgoing radiation are integrated across the solar spectrum."@en;
        skos:notation          "SDN:P07::CFSN0345";
        skos:note              "accepted"@en;
        skos:prefLabel         "soil_albedo"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/UUUU/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0243/>
