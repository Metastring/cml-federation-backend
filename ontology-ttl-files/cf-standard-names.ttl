        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/PRSC/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFV7N6/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFV7N6";
        dc:date                "2015-01-07 15:23:09.0";
        dc:identifier          "SDN:P07::CFV7N6";
