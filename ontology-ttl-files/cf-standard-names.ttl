<http://vocab.nerc.ac.uk/collection/P07/current/CF12N84/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF12N84";
        dc:date                "2009-07-06 15:41:29.0";
        dc:identifier          "SDN:P07::CF12N84";
        pav:authoredOn         "2009-07-06 15:41:29.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF12N84/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/atmosphere_mass_content_of_nitrous_acid/> , <http://mmisw.org/ont/cf/parameter/atmosphere_mass_content_of_nitrous_acid>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/AAMN/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The \"atmosphere content\" of a quantity refers to the vertical integral from the surface to the top of the atmosphere. For the content between specified levels in the atmosphere, standard names including content_of_atmosphere_layer are used.  The chemical formula for nitrous acid is HNO2."@en;
        skos:notation          "SDN:P07::CF12N84";
        skos:note              "accepted"@en;
        skos:prefLabel         "atmosphere_mass_content_of_nitrous_acid"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/KMP2/> .

<http://vocab.nerc.ac.uk/collection/P07/current/CFSN0666/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CFSN0666";
