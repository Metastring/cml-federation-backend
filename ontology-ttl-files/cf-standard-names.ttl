<http://vocab.nerc.ac.uk/collection/P07/current/CF14N101/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::CF14N101";
        dc:date                "2010-05-12 12:47:52.0";
        dc:identifier          "SDN:P07::CF14N101";
        pav:authoredOn         "2010-05-12 12:47:52.0";
        pav:hasCurrentVersion  <http://vocab.nerc.ac.uk/collection/P07/current/CF14N101/1/>;
        pav:version            "1";
        void:inDataset         <http://vocab.nerc.ac.uk/.well-known/void>;
        owl:deprecated         "false";
        owl:sameAs             <http://vocab.nerc.ac.uk/standard_name/tendency_of_ocean_mole_content_of_aragonite_expressed_as_carbon_due_to_biological_production/> , <http://mmisw.org/ont/cf/parameter/tendency_of_ocean_mole_content_of_aragonite_expressed_as_carbon_due_to_biological_production>;
        owl:versionInfo        "1";
        skos:altLabel          "";
        skos:broader           <http://vocab.nerc.ac.uk/collection/P02/current/CING/>;
        skos:definition        "\"Content\" indicates a quantity per unit area.  The phrase 'expressed_as' is used in the construction A_expressed_as_B, where B is a chemical constituent of A. It means that the quantity indicated by the standard name is calculated solely with respect to the B contained in A, neglecting all other chemical constituents of A. The specification of a physical process by the phrase due_to_process means that the quantity named is a  single term in a sum of terms which together compose the general quantity  named by omitting the phrase.  \"tendency_of_X\" means derivative of X with respect to time.  Aragonite is a mineral that is a polymorph of calcium carbonate. The chemical formula of aragonite is CaCO3. Standard names also exist for calcite, another polymorph of calcium carbonate."@en;
        skos:notation          "SDN:P07::CF14N101";
        skos:note              "accepted"@en;
        skos:prefLabel         "tendency_of_ocean_mole_content_of_aragonite_expressed_as_carbon_due_to_biological_production"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/M2MS/> .

<http://vocab.nerc.ac.uk/collection/P07/current/FT5FU78M/>
        rdf:type               skos:Concept;
        dce:identifier         "SDN:P07::FT5FU78M";
        dc:date                "2018-02-12 16:53:18.0";
        dc:identifier          "SDN:P07::FT5FU78M";
