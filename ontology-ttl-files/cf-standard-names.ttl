        skos:notation          "SDN:P07::ZY44123F";
        skos:note              "accepted"@en;
        skos:prefLabel         "radioactivity_concentration_of_207Tl_in_air"@en;
        skos:related           <http://vocab.nerc.ac.uk/collection/P06/current/BQM3/> .

