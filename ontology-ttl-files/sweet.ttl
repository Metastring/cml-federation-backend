    rdfs:label "interaction"@en ;
    rdfs:subClassOf soproc:Process .

soprocc:Acidification a owl:Class ;
    rdfs:label "acidification"@en ;
    rdfs:comment "Any process that decreases the pH value of a subtance."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Bioluminescence a owl:Class ;
    rdfs:label "bioluminescence"@en ;
    rdfs:subClassOf soprocc:Luminescence .

soprocc:Bond a owl:Class ;
    rdfs:label "bond"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Burning a owl:Class ;
    rdfs:label "burning"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Calcification a owl:Class ;
    rdfs:label "calcification"@en ;
    rdfs:comment "Any process that increases the calcium concentration of a subtance."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Calcination a owl:Class ;
    rdfs:label "calcination"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:ChargeExchange a owl:Class ;
    rdfs:label "charge exchange"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Combustion a owl:Class ;
    rdfs:label "combustion"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Corrosion a owl:Class ;
    rdfs:label "corrosion"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Dehydration a owl:Class ;
    rdfs:label "dehydration"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess ;
    owl:disjointWith soprocc:Hydration .

soprocc:Desalinization a owl:Class ;
    rdfs:label "desalinization"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Dilution a owl:Class ;
    rdfs:label "dilution"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Dissolution a owl:Class ;
    rdfs:label "dissolution"@en ;
    rdfs:comment "Dissolution or solvation is the process of dissolving a solid substance into a solvent to yield a solution. [Wikipedia]"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess ;
    owl:equivalentClass soprocc:Solvation .

soprocc:Electrolysis a owl:Class ;
    rdfs:label "electrolysis"@en ;
    rdfs:comment "Electrolysis is a method of using an electric current to drive an otherwise non-spontaneous chemical reaction."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Enrichment a owl:Class ;
    rdfs:label "enrichment"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Fixation a owl:Class ;
    rdfs:label "fixation"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Hydrolysis a owl:Class ;
    rdfs:label "hydrolysis"@en ;
    rdfs:comment "Hydrolysis is a chemical reaction during which molecules of water (H2O) are split into hydrogen (H) and hydroxide anions (OH−) in the process of a chemical mechanism."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Leaching a owl:Class ;
    rdfs:label "leaching"@en ;
    rdfs:comment "In general, leaching is the extraction of certain materials from a carrier into a liquid (usually, but not always a solvent)."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Neutralization a owl:Class ;
    rdfs:label "neutralization"@en ;
    rdfs:comment "In chemistry, neutralization is a chemical reaction (also called a water forming reaction since a water molecule is formed during the process) in which an acid and a base or alkali (soluble base) react to produce salt and water (H2O). During the process, hydrogen ions H+ (a bare proton) from the acid (proton donor) or a hydronium ion H3O+ and hydroxide ions OH_ or oxide ions O2_ from the base (proton acceptor) react together to form a water molecule H2O. [Wikipedia]"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Nitrification a owl:Class ;
    rdfs:label "nitrification"@en ;
    rdfs:subClassOf soprocc:Reaction .

soprocc:Nucleation a owl:Class ;
    rdfs:label "nucleation"@en ;
    rdfs:comment "Nucleation is the extremely localized budding of a distinct thermodynamic phase. Some examples of phases that may form via nucleation in liquids are gaseous bubbles, crystals, or glassy regions."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Outgas a owl:Class ;
    rdfs:label "outgas"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Oxidation a owl:Class ;
    rdfs:label "oxidation"@en ;
    rdfs:comment "Reaction of a substance with oxygen or incorporation of oxygen into a molecule."@en ;
    rdfs:subClassOf soprocc:Reaction ;
    owl:disjointWith soprocc:Reduction .

soprocc:Phosphorescence a owl:Class ;
    rdfs:label "phosphorescence"@en ;
    rdfs:comment "Continues to glow after light source is removed"@en ;
    rdfs:subClassOf soprocc:Fluorescence .

soprocc:Photodecomposition a owl:Class ;
    rdfs:label "photodecomposition"@en ;
    owl:equivalentClass soprocc:Photolysis .

soprocc:Photodissociation a owl:Class ;
    rdfs:label "photodissociation"@en ;
    owl:equivalentClass soprocc:Photolysis .

soprocc:Recrystalization a owl:Class ;
    rdfs:label "recrystalization"@en ;
    rdfs:subClassOf soprocc:Crystallization .

soprocc:Sorption a owl:Class ;
    rdfs:label "sorption"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( soprocc:Absorption soprocc:Adsorption ) ] .

soprocc:Thermoluminescence a owl:Class ;
    rdfs:label "thermoluminescence"@en ;
    rdfs:comment "Glows when heated"@en ;
    rdfs:subClassOf soprocc:Luminescence .

soprocc:Titration a owl:Class ;
    rdfs:label "titration"@en ;
    rdfs:comment "Titration is a common laboratory method of quantitative chemical analysis that is used to determine the unknown concentration of a known reactant."@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Transmutation a owl:Class ;
    rdfs:label "transmutation"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Triboluminescence a owl:Class ;
    rdfs:label "triboluminescence"@en ;
    rdfs:comment "Glows when struck"@en ;
    rdfs:subClassOf soprocc:Luminescence .

soprocp:Abrasion a owl:Class ;
    rdfs:label "abrasion"@en ;
    rdfs:subClassOf soproc:Force .

