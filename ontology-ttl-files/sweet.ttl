        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/reprMathOperation>,
        <http://sweetontology.net/reprSpaceGeometry3D> ;
    owl:versionInfo "3.6.0" .

soprope:PotentialEnergy a owl:Class ;
    rdfs:label "potential energy"@en ;
    rdfs:subClassOf soprope:Energy .

sopropfr:Correlation a owl:Class ;
    rdfs:label "correlation"@en ;
    rdfs:subClassOf sopropfr:BivariateStatisticalSummary .

sopropfu:Average a owl:Class ;
    rdfs:label "average"@en ;
    owl:equivalentClass sopropfu:Mean .

sopropi:DroughtIndex a owl:Class ;
    rdfs:label "drought index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophpc:Drought ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:ClimateIndicator .

sopropi:GeomagneticIndex a owl:Class ;
    rdfs:label "geomagnetic index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropi:GeomagneticForce ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:Index ;
    owl:equivalentClass sopropi:GeophysicalIndex .

sopropmf:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:subClassOf sopropmf:MassFlux .

soprops:SpatialMeasure a owl:Class ;
    rdfs:label "spatial measure"@en ;
    rdfs:subClassOf soprop:Measure,
        soprops:SpatialProperty .

sopropsdis:Wavelength a owl:Class ;
    rdfs:label "wavelength"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropsdis:Distance .

sopropsm:Volume a owl:Class ;
    rdfs:label "volume"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterCubed ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        [ a owl:Restriction ;
            owl:hasValue 3 ;
            owl:onProperty sorelm:hasDimension ],
        soprops:SpatialMeasure .

sopropst:Precipitation a owl:Class ;
    rdfs:label "precipitation"@en ;
    rdfs:subClassOf sopropst:WaterContent .

<http://sweetontology.net/propTemperatureGradient> a owl:Ontology ;
    rdfs:label "SWEET Ontology Property Temperature Gradient" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propQuantity>,
        <http://sweetontology.net/propSpaceHeight>,
        <http://sweetontology.net/propTemperature>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/reprMathFunction>,
        <http://sweetontology.net/reprSciUnits>,
        <http://sweetontology.net/stateThermodynamic> ;
    owl:versionInfo "3.6.0" .

sorea:Realm a owl:Class ;
    rdfs:label "realm"@en .

soreaah:Ionosphere a owl:Class ;
    rdfs:label "ionosphere"@en ;
    rdfs:subClassOf sorea:PlanetaryLayer .

soreaas:StellarInterior a owl:Class ;
    rdfs:label "stellar interior"@en ;
    rdfs:subClassOf soreaas:StellarRealm .

soreaas:StellarRealm a owl:Class ;
    rdfs:label "stellar realm"@en ;
    rdfs:subClassOf sorea:Realm .

soreaabl:BoundaryLayer a owl:Class ;
    rdfs:label "boundary layer"@en ;
    owl:equivalentClass soreaabl:PlanetaryBoundaryLayer .

soreabb:AquaticEcosystem a owl:Class ;
    rdfs:label "aquatic ecosystem"@en ;
    rdfs:comment "An aquatic ecosystem is an ecosystem located in a body of water. Communities of organisms that are dependent on each other and on their environment live in aquatic ecosystems. The two main types of aquatic ecosystems are marine ecosystems and freshwater ecosystems."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Hydrosphere ;
            owl:onProperty sorel:hasRealm ],
        soreabb:Ecosystem .

soreabb:Forest a owl:Class ;
    rdfs:label "forest"@en ;
    rdfs:comment "A forest is an area with a high density of trees. There are many definitions of a forest, based on various criteria. These plant communities cover large areas of the globe and function as habitats for organisms, hydrologic flow modulators, and soil conservers, constituting one of the most important aspects of the Earth's biosphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapl:Vegetation ;
            owl:onProperty sorelsc:hasSpecies ],
        soreabb:TerrestrialEcosystem .

<http://sweetontology.net/realmClimateZone> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Climate Zone" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenPlanetClimate>,
        <http://sweetontology.net/propCategorical>,
        <http://sweetontology.net/propTemperature>,
        <http://sweetontology.net/propTime>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmRegion>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaClimate>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/reprMath>,
        <http://sweetontology.net/reprTimeSeason> ;
    owl:versionInfo "3.6.0" .

<http://sweetontology.net/realmCryo> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Cryosphere" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/humanResearch>,
        <http://sweetontology.net/matrWater>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/statePhysical> ;
    owl:versionInfo "3.6.0" .

soreag:GeologicStructure a owl:Class ;
    rdfs:label "geologic structure"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Geosphere ;
            owl:onProperty sorel:hasRealm ],
        sorea:Geosphere .

soreagcons:Matrix a owl:Class ;
    rdfs:label "matrix"@en ;
    rdfs:comment "Constituent forms finer-grained material interstitial to a framework constituent. ‘The finer-grained material enclosing, or filling the interstices between, the larger grains or particles of a sediment or sedimentary rock....The term refers to the relative size and disposition of the particles, and no particular particle size is implied’ (Jackson, 1997, p. 393).  May be classifiable into orthomatrix, protomatrix, epimatrix, pseudomatrix, and unclassified matrix."@en ;
    rdfs:subClassOf soreagcons:RockConstituent .

soreagcont:ContinentalLithosphere a owl:Class ;
    rdfs:label "continental lithosphere"@en ;
    rdfs:comment "[Mechanical or Seismic Definition of Structure] In the Earth, the lithosphere includes the crust and the uppermost mantle, which constitute the hard and rigid outer layer of the planet. The [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:Craton ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        soreag:Continental,
        soreag:Lithosphere .

soreagor:Arc a owl:Class ;
    rdfs:label "arc"@en ;
    rdfs:subClassOf soreag:GeologicFeature,
        sorepsg:Arc .

soreah:Aquifer a owl:Class ;
    rdfs:label "aquifer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreah:SaturatedZone ;
            owl:onProperty sorel:partOf ],
        soreah:HydrosphereFeature .

soreahb:Wetland a owl:Class ;
    rdfs:label "wetland"@en ;
    rdfs:comment "In physical geography, a wetland is an environment at the interface between truly terrestrial ecosystems and aquatic systems making them inherently different from each other yet highly dependent on both. In essence, wetlands are ecotones. Wetlands often host considerable biodiversity and endemism. The US Army Corps of Engineers and the US Environmental Protection Agency jointly define wetlands as: Those areas that are inundated or saturated by surface or ground water at a frequency and duration sufficient to support, and that under normal circumstances do support, a prevalence of vegetation typically adapted for life in saturated soil conditions. Wetlands generally include swamps, marshes, bogs, and similar areas."@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

<http://sweetontology.net/realmLandFluvial> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Fluvial" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenGeol>,
        <http://sweetontology.net/phenGeolGeomorphology>,
        <http://sweetontology.net/realmLandform>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/reprSpaceGeometry3D> ;
    owl:versionInfo "3.6.0" .

sorealf:Canyon a owl:Class ;
    rdfs:label "canyon"@en ;
    rdfs:comment "A canyon, or gorge, is a deep valley between cliffs often carved from the landscape by a river. Most canyons were formed by a process of long-time erosion from a plateau level. [Wikipedia]"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealf:PiedmontSlope a owl:Class ;
    rdfs:label "piedmont slope"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealo:Hill a owl:Class ;
    rdfs:label "hill"@en ;
    rdfs:comment "A hill is a landform that extends above the surrounding terrain, in a limited area. Hills often have a distinct summit, although in areas with scarp/dip topography a hill may refer to a particular section of scarp slope without a well-defined summit (e.g. Box Hill). A hillock is a small hill. [Wikipedia]"@en ;
    rdfs:subClassOf soreal:Landform .

sorealp:Park a owl:Class ;
    rdfs:label "park"@en ;
    rdfs:subClassOf sorealp:LandReserve ;
    owl:equivalentClass sorealp:Parkland .

<http://sweetontology.net/realmLandTectonic> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Tectonic" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/matrRockIgneous>,
        <http://sweetontology.net/phenGeolTectonic>,
        <http://sweetontology.net/phenSolid>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmGeolBasin>,
        <http://sweetontology.net/realmGeolContinental>,
        <http://sweetontology.net/realmGeolOrogen>,
        <http://sweetontology.net/realmLandOrographic>,
        <http://sweetontology.net/realmLandform>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

sorealt:PlateBoundary a owl:Class ;
    rdfs:label "plate boundary"@en ;
    rdfs:comment "The location where two plates meet is called a plate boundary. it is often a broad zone where the plate interactions are not well understood. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasGeomorphologicalType ;
            owl:someValuesFrom sorealt:TectonicLandform ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorealt:TripleJunction ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        soreag:GeologicBoundary .

soreaofe:EarthEasternBoundaryCurrent a owl:Class ;
    rdfs:label "earth eastern boundary current"@en ;
    rdfs:subClassOf sophod:EasternBoundaryCurrent,
        soreaofe:EarthOceanCurrent .

sorelch:hasChemical a owl:ObjectProperty ;
    rdfs:label "has chemical"@en ;
    rdfs:range soma:Chemical ;
    owl:equivalentProperty sorelch:hasMaterial,
        sorelch:hasSubstance .

sorelm:averageOver a owl:ObjectProperty ;
    rdfs:label "average over"@en ;
    rdfs:domain sopropfu:Average .

sorelm:ordinalRelation a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "ordinal relation"@en ;
    rdfs:subPropertyOf sorelm:relation .

sorelph:dTdh a owl:ObjectProperty ;
    rdfs:label "dtdh"@en .

sorelph:hasEnergyProduct a owl:ObjectProperty ;
    rdfs:label "has energy product"@en ;
    rdfs:range sophen:EnergyForm .

sorelph:hasRestoringForce a owl:ObjectProperty ;
    rdfs:label "has restoring force"@en ;
    rdfs:domain sophw:Wave ;
    rdfs:range soph:Phenomena .

sorelsc:decrease a owl:ObjectProperty ;
    rdfs:label "decrease"@en ;
    rdfs:domain sophsy:Decrease ;
    owl:equivalentProperty sorelsc:decreaseIn,
        sorelsc:decreasing,
        sorelsc:drop,
        sorelsc:dropping,
        sorelsc:fall,
        sorelsc:falling,
        sorelsc:reduce,
        sorelsc:reducing,
        sorelsc:reduction .

sorelsc:hasCause a owl:ObjectProperty ;
    rdfs:label "has cause"@en ;
    owl:equivalentProperty sorelsc:impactedBy ;
    owl:inverseOf sorelsc:hasEffect .

sorelsc:hasSource a owl:ObjectProperty ;
    rdfs:label "has source"@en .

sorelsp:clusterOf a owl:ObjectProperty ;
    rdfs:label "cluster of"@en ;
    rdfs:domain sorepsg:Cluster .

sorelsp:hasBoundary a owl:ObjectProperty ;
    rdfs:label "has boundary"@en .

sorelt:hasEndTime a owl:ObjectProperty ;
    rdfs:label "has end time"@en ;
    rdfs:range sopropti:EndTime ;
    rdfs:subPropertyOf sorelt:hasTime .

sorepdf:ByteOrder a owl:Class ;
    rdfs:label "byte order"@en ;
    rdfs:subClassOf sorep:Representation .

