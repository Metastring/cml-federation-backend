sostf:Buoyant a sostf:FluidState,
        owl:NamedIndividual ;
    rdfs:label "buoyant"@en .

sostf:Convective a sostf:FluidState,
        owl:NamedIndividual ;
    rdfs:label "convective"@en .

sostf:Ekman a sostf:FluidEquilibriumState,
        owl:NamedIndividual ;
    rdfs:label "ekman"@en ;
    rdfs:comment "Motions describing an equlibrium between pressure gradient force, Coriolis force and the turbulent drag force."@en .

sostf:Halosteric a sostf:FluidEquilibriumState,
        owl:NamedIndividual ;
    rdfs:label "halosteric"@en .

sostf:Miscible a sostf:FluidState,
        owl:NamedIndividual ;
    rdfs:label "miscible"@en ;
    rdfs:comment "Said of two or more liquids that are mutually soluble (i.e. they will dissolve in each other) (McGraw-Hill, 1974).  The chemical property of two or more phases that, when brought together, have the ability to mix and form one phase (after AGI, 1980)."@en .

sostf:QuasiGeostrophic a sostf:FluidEquilibriumState,
        owl:NamedIndividual ;
    rdfs:label "quasi geostrophic"@en ;
    sorelm:approximates sostf:Geostrophic ;
    rdfs:comment "A system or flow that evolves slowly in time compared to the rotation period of the earth, has a length scale of the deformation radius or larger, and undergoes only limited vertical excursions."@en .

sostf:QuasiHydrostatic a sostf:FluidEquilibriumState,
        owl:NamedIndividual ;
    rdfs:label "quasi hydrostatic"@en ;
    sorelm:approximates sostf:Hydrostatic .

sostf:Rareified a sostf:FluidState,
