    rdfs:subClassOf sorepm:NumericalEntity ;
    owl:disjointWith sorepm:Vector .

sorepm:Variable a owl:Class ;
    rdfs:label "variable"@en ;
    rdfs:subClassOf sorepm:NumericalEntity .

sorepmf:DistributionFunction a owl:Class ;
