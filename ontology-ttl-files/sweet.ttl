    rdfs:subClassOf soreaa:AtmosphereLayer ;
    owl:equivalentClass soreaabl:BoundaryLayer .

soreacz:C a owl:Class ;
    rdfs:label "c"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropt:TemperatureRange ] ;
            owl:onProperty sorelcl:hasAverageColdestMonthTemperature ],
        [ a owl:Restriction ;
            owl:hasValue [ a sopropt:TemperatureRange ] ;
            owl:onProperty sorelcl:hasAverageWarmestMonthTemperature ],
        soreacz:ClimateClassification ;
