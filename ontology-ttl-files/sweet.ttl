        owl:NamedIndividual ;
    rdfs:label "earth upper mantle"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:IGRF a sophel:GeomagneticField,
        owl:NamedIndividual ;
    rdfs:label "igrf"@en ;
    owl:sameAs soreaer:InternationalGeomagneticReferenceField .

soreag:Asthenosphere a owl:Class ;
    rdfs:label "asthenosphere"@en ;
    rdfs:comment "The asthenosphere is a portion of the upper mantle just below the lithosphere.  Seismic waves pass relatively slowly through the asthenosphere, compared to the overlying lithospheric mantle, thus it has been called the low-velocity zone. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:UpperMantle ;
    owl:equivalentClass soreag:UpperMantleFlowing .

soreag:Basement a owl:Class ;
    rdfs:label "basement"@en ;
    rdfs:subClassOf soreag:GeologicStructure .

soreag:Batholith a owl:Class ;
    rdfs:label "batholith"@en ;
    rdfs:comment "A batholith is a large emplacement of igneous intrusive (also called plutonic) rock that forms from cooled magma deep in the Earth's crust. Batholiths are almost always made mostly of felsic or intermediate rock-types, such as granite, quartz monzonite, or diorite (see also granite dome).There is also an important geographic usage of the term batholith. For a geographer, a batholith is an exposed area of mostly continuous plutonic rock that covers an area larger than 100 square kilometers. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:PlutonicStructure .

soreag:Bedrock a owl:Class ;
    rdfs:label "bedrock"@en ;
    rdfs:subClassOf soreag:GeosphereLayer .

soreag:BrittleDuctileTransitionZone a owl:Class ;
    rdfs:label "brittle ductile transition zone"@en ;
    rdfs:comment "D layer is the layer which separates the mantle from the core. D may consist of material from subducted slabs that descended and came to rest at the core-mantle boundary and/or from a new mineral polymorph discovered in perovskite called post-perovskite.[Wikipedia]"@en ;
    rdfs:subClassOf soreag:Crust .

soreag:CoreMantleBoundary a owl:Class ;
    rdfs:label "core mantle boundary"@en ;
    owl:equivalentClass soreag:GuttenburgDiscontinuity .

soreag:Cover a owl:Class ;
    rdfs:label "cover"@en ;
    rdfs:subClassOf soreag:GeologicStructure .

soreag:CrustMantleBoundary a owl:Class ;
    rdfs:label "crust mantle boundary"@en ;
    owl:equivalentClass soreag:Moho .

soreag:DLayer a owl:Class ;
    rdfs:label "d layer"@en ;
    rdfs:comment "D layer is the layer which separates the mantle from the core. D may consist of material from subducted slabs that descended and came to rest at the core-mantle boundary and/or from a new mineral polymorph discovered in perovskite called post-perovskite.[Wikipedia]"@en ;
    rdfs:subClassOf soreag:Mantle .

soreag:Fabric a owl:Class ;
    rdfs:label "fabric"@en ;
    rdfs:subClassOf soprops:Configuration .

soreag:GiantDikeSwarm a owl:Class ;
    rdfs:label "giant dike swarm"@en ;
    rdfs:comment "A dike swarm or dyke swarm in geology is a major group of parallel, linear, or radially oriented dikes intruded within continental crust. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:Dike .

soreag:InnerCore a owl:Class ;
    rdfs:label "inner core"@en ;
    rdfs:comment "The solid inner core was discovered in 1936 by Inge Lehmann and is generally believed to be composed primarily of iron and some nickel.[Wikipedia]"@en ;
    rdfs:subClassOf soreag:Mantle ;
    owl:disjointWith soreag:OuterCore .

soreag:Laccolith a owl:Class ;
    rdfs:label "laccolith"@en ;
    rdfs:comment "#Aseismic"@en ;
    rdfs:subClassOf soreag:PlutonicStructure .

soreag:LehmannDiscontinuity a owl:Class ;
    rdfs:label "lehmann discontinuity"@en ;
    rdfs:comment "Boundary between Asthenosphere and Lithosphere. It is the discontinuity in seismic velocity near a depth of 220 km. It appears beneath continents, but not usually beneath oceans, and does not readily appear in globally-averaged studies [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicBoundary .

soreag:Lopolith a owl:Class ;
    rdfs:label "lopolith"@en ;
    rdfs:comment "[Pluton] Igneous intrusion - A lopolith is a large igneous intrusion which is lenticular in shape with a depressed central region. Lopoliths are generally concordant with the intruded strata with dike or funnel-shaped feeder bodies below the body. Lopoliths typically consist of large ultramafic to mafic layered intrusions that range in age from Archean to Eocene. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:PlutonicStructure .

soreag:LowerMantle a owl:Class ;
    rdfs:label "lower mantle"@en ;
    rdfs:comment "Very little is known about the lower mantle apart from that it appears to be relatively seismically homogeneous. The lower mantle is under tremendous pressure and therefore has a higher viscosity than the upper mantle.[Wikipedia]"@en ;
    rdfs:subClassOf soreag:Mantle .

soreag:Mesosphere a owl:Class ;
    rdfs:label "mesosphere"@en ;
    rdfs:comment "The mesosphere refers to the mantle in the region between the asthenosphere and the outer core. The upper boundary is defined as the sharp increase in seismic wave velocities and density at a depth of 660 km. [Wikipedia]"@en ;
    owl:equivalentClass soreag:UpperMantleRigid .

soreag:SeismicZone a owl:Class ;
    rdfs:label "seismic zone"@en ;
    rdfs:comment "Seismic Zones are broad elongated regions along a fault line where earthquakes take place. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

soreag:Sill a owl:Class ;
    rdfs:label "sill"@en ;
    rdfs:comment "[Pluton] Igneous intrusion - A sill is a tabular pluton that has intruded between older layers of sedimentary rock, beds of volcanic lava or tuff, or even along the direction of foliation in metamorphic rock. The term sill is synonymous with concordant intrusive sheet. This means that the sill does not cut across preexisting rocks, in contrast to dikes, which do cut across older rocks. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:PlutonicStructure .

soreag:TransitionalLithosphere a owl:Class ;
    rdfs:label "transitional lithosphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom soreag:TransitionalCrust ],
        soreag:GeosphereLayer .

soreagb:BackArcBasin a owl:Class ;
    rdfs:label "back arc basin"@en ;
    rdfs:comment "Back-arc basins (or retro-arc basins) are geologic features, submarine basins associated with island arcs and subduction zones. They are found at some convergent plate boundaries, presently concentrated in the Western Pacific ocean. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:ForeArcBasin a owl:Class ;
    rdfs:label "fore arc basin"@en ;
    rdfs:comment "A forearc is a depression (basin) in the sea floor located between a subduction zone and an associated volcanic arc. It is typically filled with sediments from the adjacent landmass and the island arc in addition to trapped oceanic crustal material. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:IntraArcBasin a owl:Class ;
    rdfs:label "intra arc basin"@en ;
    rdfs:comment "Intra-arc basins are basins that occur between Fore-arc basins and back-arc basins [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:PeripheralForelandBasin a owl:Class ;
    rdfs:label "peripheral foreland basin"@en ;
    rdfs:comment "Peripheral (Pro) foreland basins occur on the plate that is subducted or underthrust during plate collision (i.e. the outer arc of the orogen)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Molasse ;
            owl:onProperty sorelch:hasSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagb:FlyschBasin ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        soreagb:Basin .

soreagb:RetroarcForelandBasin a owl:Class ;
    rdfs:label "retroarc foreland basin"@en ;
    rdfs:comment "Retroarc (Retro) foreland basins occur on the plate that overrides during plate convergence or collision (i.e. situated behind the magmatic arc that is linked with the subduction of oceanic lithosphere). [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:TranstensionalBasin a owl:Class ;
    rdfs:label "transtensional basin"@en ;
    rdfs:comment "Transtension basins are oblique tensional environments where stretching takes place. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagcons:ArmoredRelictInclusion a owl:Class ;
    rdfs:label "armored relict inclusion"@en ;
    rdfs:comment "An inclusion of an earlier rock that is prevented from further reaction in a later rock by a rim of reaction products."@en ;
    rdfs:subClassOf soreagcons:Inclusion .

soreagcons:ArmouredRelictCrystal a owl:Class ;
    rdfs:label "armoured relict crystal"@en ;
    rdfs:comment "a crystal of an earlier rock that is prevented from further reaction in a later rock by a rim of reaction products"@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:Chadacryst a owl:Class ;
    rdfs:label "chadacryst"@en ;
    rdfs:comment "the enclosed crystal in a poikolitic texture"@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:ClastSupportingOrthomatrix a owl:Class ;
    rdfs:label "clast supporting orthomatrix"@en ;
    rdfs:comment "Orthomatrix in matrix supported sedimentary rock."@en ;
    rdfs:subClassOf soreagcons:Orthomatrix .

soreagcons:Clot a owl:Class ;
    rdfs:label "clot"@en ;
    rdfs:comment "A cluster of ferromagnesian minerals in an igneous rock, from several centimeters to decimeters in diameter, that may be a segregation or an altered xenolith."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:CorrosionRim a owl:Class ;
    rdfs:label "corrosion rim"@en ;
    rdfs:comment "A corona formed by a secondary mineral around an orginal igneous crystal, formed by modification of the crystal by the corrosive action of its parent magma."@en ;
    rdfs:subClassOf soreagcons:Corona .

soreagcons:CrystallineFramework a owl:Class ;
    rdfs:label "crystalline framework"@en ;
    rdfs:comment "Constituent forms an interconnected network of discernible crystals."@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:Dropstone a owl:Class ;
    rdfs:label "dropstone"@en ;
    rdfs:comment "An oversized stone in laminated sediment that depresses the underlying laminae and may be covered by -draped laminae.  Most dropstones originate through ice-rafting; other sources are floating tree roots and kelp holdfasts...."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Epimatrix a owl:Class ;
    rdfs:label "epimatrix"@en ;
    rdfs:comment "A type of matrix consisting of inhomogeneous interstitial materials grown in originally open interstices during diagenesis, but lacking the homogeneity and clear textural evidence of pore-filling needed to classify as phyllosilicate cement."@en ;
    rdfs:subClassOf soreagcons:Matrix .

soreagcons:FloatingClast a owl:Class ;
    rdfs:label "floating clast"@en ;
    rdfs:comment "Constituent is a clast that has no visible contacts with other clasts. Interpreted to be largely or completly immersed in matrix or cement."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:GranularFramework a owl:Class ;
    rdfs:label "granular framework"@en ;
    rdfs:comment "Constituent forms a rigid arrangement of particles that support one another at their points of contact...constituting a mechanically firm structure capable of supporting open pore spaces, although interstices may be occupied by cement or matrix"@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:Groundmass a owl:Class ;
    rdfs:label "groundmass"@en ;
    rdfs:comment "Constituent forms an interconnected network of material enclosing other constituents that are disguished by larger grain size."@en ;
    rdfs:subClassOf soreagcons:RockConstituent .

soreagcons:InterstitialConstituent a owl:Class ;
    rdfs:label "interstitial constituent"@en ;
    rdfs:comment "Constituent is distributed through the material between other constituent particles"@en ;
    rdfs:subClassOf soreagcons:RockConstituent .

soreagcons:Irregular a owl:Class ;
    rdfs:label "irregular"@en ;
    rdfs:comment "A constituent with irregular distribution and geometry, as in pseudobreccia or patch migmatite."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:KelyphiticRim a owl:Class ;
    rdfs:label "kelyphitic rim"@en ;
    rdfs:comment "Corona that consists of concentric bands with radial fibrous texture."@en ;
    rdfs:subClassOf soreagcons:Corona .

soreagcons:Layer a owl:Class ;
    rdfs:label "layer"@en ;
    rdfs:comment "A thin sheet compositionally distinct from the surrounding material, related to primary genesis of rock, e.g. sedimentary layers, metamorphic segregation."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Oikocryst a owl:Class ;
    rdfs:label "oikocryst"@en ;
    rdfs:comment "Constituent occurs as crystals that poikilitically enclose crystals of other phases in an igneous rock."@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:Overgrowth a owl:Class ;
    rdfs:label "overgrowth"@en ;
    rdfs:comment "Constituent crystallized in crystallographic continuity with some other mineral constituent, typically quartz or calcite. In a clastic rock, commonly forms cement as well, but this should be represented using two role attribute links, 'overgrowth' and cement, because overgrowth does not necessarily imply cement."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Phenoclast a owl:Class ;
    rdfs:label "phenoclast"@en ;
    rdfs:comment "a relatively large and conspicuous fragment in a sediment or sedimentary rock"@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

soreagcons:Phenocryst a owl:Class ;
    rdfs:label "phenocryst"@en ;
    rdfs:comment "A phenocryst is a relatively large and usually conspicuous crystal distinctly larger than the grains of the rock groundmass of a porphyritic igneous rock. Phenocrysts often have euhedral forms either due to early growth within a magma or by post-emplacement recrystallization. [Wikipedia]"@en ;
    rdfs:subClassOf soreagcons:Megacryst .

soreagcons:Porphyroblast a owl:Class ;
    rdfs:label "porphyroblast"@en ;
    rdfs:comment "Constituent occurs as crystals formed by metamorphic crystallization, set in a finer-grained groundmass."@en ;
    rdfs:subClassOf soreagcons:Megacryst .

soreagcons:Porphyroclast a owl:Class ;
    rdfs:label "porphyroclast"@en ;
    rdfs:comment "Relict crystal in metamorphic rock, in groundmass of relatively finer-grained material. Connotes that groundmass is result of tectonic reduction in grain size."@en ;
    rdfs:subClassOf soreagcons:Megacryst .

soreagcons:Protomatrix a owl:Class ;
    rdfs:label "protomatrix"@en ;
    rdfs:comment "A type of matrix consisting of un-recrystallized detrital clayey lutum  (clay fraction, less than 2 micron) in weakly consolidated rocks."@en ;
    rdfs:subClassOf soreagcons:Matrix .

soreagcons:Pseudomatrix a owl:Class ;
    rdfs:label "pseudomatrix"@en ;
    rdfs:comment "A type of matrix consisting of soft deformable framework grains that are squeezed and flattened between stronger framework grains."@en ;
    rdfs:subClassOf soreagcons:Matrix .

soreagcons:SedimentaryRockCement a owl:Class ;
    rdfs:label "sedimentary rock cement"@en ;
    rdfs:comment "A constituent that occupies space between individual grains of a consolidated sedimentary rock, and binds the grains together as a rigid, coherent mass; it may be derived from the sediment or its entrapped waters, or it may be brought in by solution from outside sources. Material is usually chemically precipitated (Jackson, 1997, p. 103). Distinguished from matrix by clearly secondary origin and generally monomineralic charactera"@en ;
    rdfs:subClassOf soreagcons:RockConstituent .

soreagcons:SmallConcretion a owl:Class ;
    rdfs:label "small concretion"@en ;
    rdfs:comment "A hard, compact mass or aggregate of mineral matter, normally subsperical but commonly oblate, disc-shaped or irregular.  Formed by precipitation of mineral from solution in the pores of a granular rock, localized around a nucleus or center, to define a discrete, sharply separated object. Size ranges from cm to decimeter for application as a compoundMaterialConstituentPart; larger concretions should be considered GeologicUnit parts."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Vein a owl:Class ;
    rdfs:label "vein"@en ;
    rdfs:comment "Thin sheet of material intruded into the rock. May be hydrothermal, magmatic, or sedimentary."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Vug a owl:Class ;
    rdfs:label "vug"@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration,
        sorepsg3:Cavity .

soreagcont:ActiveContinent a owl:Class ;
    rdfs:label "active continent"@en ;
    rdfs:comment "A distinction of whether the continental margins are active (subducting).  [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalLithosphere ;
            owl:onProperty sorel:partOf ],
        soreag:GeologicProvince .

soreagcont:ContinentalMargin a owl:Class ;
    rdfs:label "continental margin"@en ;
    rdfs:comment "The continental margin is the zone of the ocean floor that separates the thin oceanic crust from thick continental crust. [Wikipedia]"@en ;
    rdfs:subClassOf sostrg:Margin .

soreagcont:StableContinent a owl:Class ;
    rdfs:label "stable continent"@en ;
    rdfs:comment "A distinction of whether the continental is on a stable paltform, i.e., over millions of years. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalLithosphere ;
            owl:onProperty sorel:partOf ],
        soreag:GeologicProvince .

soreagcont:Supercontinent a owl:Class ;
    rdfs:label "supercontinent"@en ;
    rdfs:comment "In geology, a supercontinent is a land mass comprising more than one continental core, or craton. The assembly of cratons and accreted terranes that form Eurasia qualifies as a supercontinent today."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalLithosphere ;
            owl:onProperty sorel:hasRealm ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:Craton ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        soreag:GeologicProvince .

<http://sweetontology.net/realmGeolOceanic> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Geologic Oceanic" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmOcean>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical> ;
    owl:versionInfo "3.6.0" .

soreagoc:AccretionaryPrism a owl:Class ;
    rdfs:label "accretionary prism"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Melange ;
            owl:onProperty sorelch:hasSubstance ],
        soma:Mixture,
        soreag:GeologicStructure .

soreagoc:OceanicCrust a owl:Class ;
    rdfs:label "oceanic crust"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagoc:OceanicLithosphere ;
            owl:onProperty sorel:partOf ],
        soreag:Crust,
        soreao:OceanRegion .

soreagor:BackArc a owl:Class ;
    rdfs:label "back arc"@en ;
    rdfs:comment "Back-arc basins (or retro-arc basins) are geologic features, submarine basins associated with island arcs and subduction zones. They are found at some convergent plate boundaries, presently concentrated in the Western Pacific ocean. [Wikipedia]"@en ;
    rdfs:subClassOf soreagor:Arc ;
    owl:equivalentClass soreagor:RearArc,
        soreagor:RetroArc .

soreagor:MagmaticArc a owl:Class ;
    rdfs:label "magmatic arc"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom soreagor:ForeArc ],
        [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom soreagor:RearArc ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagor:ArcAxis ;
            owl:onProperty sorelsp:hasAxis ],
        soreagor:Arc .

soreagor:RemnantArc a owl:Class ;
    rdfs:label "remnant arc"@en ;
    rdfs:comment "The remnant arc is what is left on the rear side of the speading zone as athe basin broadens. [Wikipedia]"@en ;
    rdfs:subClassOf soreagor:Arc .

soreah:Aquiclude a owl:Class ;
    rdfs:label "aquiclude"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:Aquifuge a owl:Class ;
    rdfs:label "aquifuge"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:Aquitard a owl:Class ;
    rdfs:label "aquitard"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:CascadingWater a owl:Class ;
    rdfs:label "cascading water"@en ;
    rdfs:subClassOf somaw:Groundwater,
        soreah:HydrosphereFeature .

soreah:ConeOfDepression a owl:Class ;
    rdfs:label "cone of depression"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature,
        sorepsg:Trough .

soreah:ConeOfImpression a owl:Class ;
    rdfs:label "cone of impression"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature,
        sorepsg:Ridge .

soreah:ConfinedAquifer a owl:Class ;
    rdfs:label "confined aquifer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Confined ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreah:Aquifer .

soreah:ConfinedBed a owl:Class ;
    rdfs:label "confined bed"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Confined ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreah:HydrosphereFeature .

soreah:ConfinedUnit a owl:Class ;
    rdfs:label "confined unit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Confined ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreah:HydrosphereFeature .

soreah:ConfinedZone a owl:Class ;
    rdfs:label "confined zone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Confined ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreah:HydrosphereFeature .

soreah:Dike a owl:Class ;
    rdfs:label "dike"@en ;
    rdfs:subClassOf soreah:Bank ;
    owl:equivalentClass soreah:Dyke,
        soreah:Embankment,
        soreah:FloodBank,
        soreah:Levee,
        soreah:RaisedBank .

soreah:GroundwaterLevel a owl:Class ;
    rdfs:label "groundwater level"@en ;
    rdfs:subClassOf sorea:PlanetarySurfaceLevel,
        soreah:HydrosphereFeature .

soreah:PotentiometricSurface a owl:Class ;
    rdfs:label "potentiometric surface"@en ;
    rdfs:comment "An imaginary surface representing the static head of groundwater and defined by the level to which water will rise in a tightly cased well."@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:SeepageFace a owl:Class ;
    rdfs:label "seepage face"@en ;
    rdfs:comment " A boundary between the saturated flow field and the atmosphere along which groundwater discharges, either by evaporation or movement ‘downhill’ along the land surface or in a well as a thin film in response to the force of gravity."@en ;
    rdfs:subClassOf sostrg:Boundary .

soreah:SurfaceWater a owl:Class ;
    rdfs:label "surface water"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:UnconfinedAquifer a owl:Class ;
    rdfs:label "unconfined aquifer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Unconfined ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreah:Aquifer ;
    owl:equivalentClass soreah:WaterTableAquifer .

soreah:UnsaturatedZone a owl:Class ;
    rdfs:label "unsaturated zone"@en ;
    owl:equivalentClass soreah:VadoseZone .

soreah:WarmPool a owl:Class ;
    rdfs:label "warm pool"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:WaterColumn a owl:Class ;
    rdfs:label "water column"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:WaterTable a owl:Class ;
    rdfs:label "water table"@en ;
    rdfs:comment "The water table or phreatic surface is the surface where the water pressure is equal to atmospheric pressure. A sustainable amount of water within a unit of sediment or rock, below the water table, in the phreatic zone is called an aquifer. The ability of the aquifer to store groundwater is dependent on the primary and secondary porosity and permeability"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreahb:Aqueduct a owl:Class ;
    rdfs:label "aqueduct"@en ;
    rdfs:subClassOf soreahb:Channel .

soreahb:Arroyo a owl:Class ;
    rdfs:label "arroyo"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:BarrierLagoon a owl:Class ;
    rdfs:label "barrier lagoon"@en ;
    rdfs:subClassOf soreahb:Lagoon .

soreahb:Bay a owl:Class ;
    rdfs:label "bay"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:BlanketBog a owl:Class ;
    rdfs:label "blanket bog"@en ;
    rdfs:subClassOf soreahb:Bog .

soreahb:Bolson a owl:Class ;
    rdfs:label "bolson"@en ;
    rdfs:subClassOf soreahb:Basin .

soreahb:Canal a owl:Class ;
    rdfs:label "canal"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:CarbonateCompensationLevel a owl:Class ;
    rdfs:label "carbonate compensation level"@en ;
    owl:equivalentClass soreahb:WaterBodyBoundary .

soreahb:CheckDam a owl:Class ;
    rdfs:label "check dam"@en ;
    dcterms:contributor <http://orcid.org/0000-0003-2185-928X> ;
    rdfs:subClassOf soreahb:Dam ;
    skos:definition [ dcterms:created "2019-08-18"^^xsd:date ;
            dcterms:source <http://dbpedia.org/resource/Check_dam> ;
            rdfs:comment "A check dam is a small, sometimes temporary, dam constructed across a swale, drainage ditch, or waterway to counteract erosion by reducing water flow velocity. Check dams themselves are not a type of new technology; rather, they are an ancient technique dating all the way back to the second century A.D. Check dams are typically, though not always, implemented as a system of several check dams situated at regular intervals across the area of interest."@en ] .

soreahb:Creek a owl:Class ;
    rdfs:label "creek"@en ;
    rdfs:subClassOf soreahb:Stream .

soreahb:Fiord a owl:Class ;
    rdfs:label "fiord"@en ;
    owl:equivalentClass soreahb:Fjord .

soreahb:FramStrait a soreahb:Strait,
        owl:NamedIndividual ;
    rdfs:label "fram strait"@en .

soreahb:FreshwaterLake a owl:Class ;
    rdfs:label "freshwater lake"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:FreshWater ;
            owl:onProperty sorelch:hasSubstance ],
        soreahb:Lake .

soreahb:HotSpring a owl:Class ;
    dcterms:created "2019-07-19"^^xsd:date ;
    dcterms:creator <http://orcid.org/0000-0001-6238-3498> ;
    dcterms:source <https://en.wikipedia.org/wiki/Hot_spring> ;
    rdfs:subClassOf soreahb:Spring ;
    skos:altLabel "geothermal spring"@en ;
    skos:definition "A hot spring is a spring produced by the emergence of geothermally heated groundwater that rises from the Earth's crust. While some of these springs contain water that is a safe temperature for bathing, others are so hot that immersion can result in injury or death."@en ;
    skos:prefLabel "hot spring"@en .

soreahb:Inlet a owl:Class ;
    rdfs:label "inlet"@en ;
    rdfs:comment "An inlet is a narrow body between islands or leading inland from a larger body of water, often leading to an enclosed body of water, such as a sound, bay, lagoon or marsh. In sea coasts an inlet usually refers to the actual connection between a bay and the ocean and is often called an entrance."@en ;
    rdfs:subClassOf soreahb:Estuary .

soreahb:Marsh a owl:Class ;
    rdfs:label "marsh"@en ;
    rdfs:comment "In geography, a marsh, or morass, is a type of wetland which is subject to frequent or continuous inundation. Typically a marsh features grasses, rushes, reeds, typhas, sedges, and other herbaceous plants (possibly with low-growing woody plants) in a context of shallow water. A marsh is different from a swamp, which has a greater proportion of open water surface, and is generally deeper than a marsh. In North America, the term swamp is used for wetland dominated by trees rather than grasses and low herbs"@en ;
    rdfs:subClassOf soreahb:Wetland .

soreahb:Mouth a owl:Class ;
    rdfs:label "mouth"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:Peatland a owl:Class ;
    rdfs:label "peatland"@en ;
    rdfs:comment "Peat forms in wetlands or peatlands, variously called bogs, moors, muskegs, pocosins, mires, and peat swamp forests"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somas:Peat ;
            owl:onProperty sorelch:hasSubstance ],
        soreahb:Wetland .

soreahb:Pond a owl:Class ;
    rdfs:label "pond"@en ;
    rdfs:subClassOf soreahb:BodyOfWater,
        soreahb:Channel .

soreahb:RaisedBog a owl:Class ;
    rdfs:label "raised bog"@en ;
    rdfs:subClassOf soreahb:Bog .

soreahb:Reservoir a owl:Class ;
    rdfs:label "reservoir"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:SeaSurface a owl:Class ;
    rdfs:label "sea surface"@en ;
    rdfs:subClassOf sorea:PlanetarySurface,
        soreahb:WaterBodyBoundary .

soreahb:Sound a owl:Class ;
    rdfs:label "sound"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:Swamp a owl:Class ;
    rdfs:label "swamp"@en ;
    rdfs:comment "A swamp is a wetland that features temporary or permanent inundation of large areas of land by shallow bodies of water, generally with a substantial number of hammocks, or dry-land protrusions, and covered by aquatic vegetation, or vegetation that tolerates periodical inundation.The water of a swamp may be fresh water or salt water. A swamp is also generally defined as having no substantial peat deposits."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Saturation ;
            owl:onProperty sorel:hasState ],
        [ a owl:Restriction ;
            owl:allValuesFrom somapl:Vegetation ;
            owl:onProperty sorelsc:hasSpecies ],
        soreahb:Wetland .

soreahb:ValleyBog a owl:Class ;
    rdfs:label "valley bog"@en ;
    rdfs:subClassOf soreahb:Bog .

soreala:Aeolian a owl:Class ;
    rdfs:label "aeolian"@en ;
    rdfs:comment "Aeolian (or Eolian or Æolian) processes pertain to the activity of the winds and more specifically, to the winds' ability to shape the surface of the Earth and other planets. Winds may erode, transport, and deposit materials, and are effective agents in regions with sparse vegetation and a large supply of unconsolidated sediments. [Wikipedia]"@en ;
    rdfs:subClassOf sophgg:Weathering ;
    owl:equivalentClass soreala:Eolian .

soreala:Barchan a owl:Class ;
    rdfs:label "barchan"@en ;
    rdfs:subClassOf soreala:Dune .

soreala:Erg a owl:Class ;
    rdfs:label "erg"@en ;
    rdfs:subClassOf soreala:AeolianLandform .

soreala:HighDesert a owl:Class ;
    rdfs:label "high desert"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropsh:Elevation ;
            owl:onProperty sorelsp:hasSpatialExtent ],
        soreala:Desert .

soreala:Seif a owl:Class ;
    rdfs:label "seif"@en ;
    rdfs:subClassOf soreala:Dune .

soreala:Slack a owl:Class ;
    rdfs:label "slack"@en ;
    rdfs:subClassOf soreala:AeolianLandform .

soreala:SlipFace a owl:Class ;
    rdfs:label "slip face"@en ;
    rdfs:subClassOf soreala:AeolianLandform .

soreala:Yardang a owl:Class ;
    rdfs:label "yardang"@en ;
    rdfs:subClassOf soreala:AeolianLandform .

sorealc:Atoll a owl:Class ;
    rdfs:label "atoll"@en ;
    rdfs:subClassOf sorealc:Island .

sorealc:BarrierIsland a owl:Class ;
    rdfs:label "barrier island"@en ;
    rdfs:subClassOf sorealc:Island .

sorealc:Beach a owl:Class ;
    rdfs:label "beach"@en ;
    rdfs:comment "A beach, or strand, is a geological landform consisting of loose rock particles - such as sand, gravel, shingle, pebbles, cobble - or even shell fragments, along the shoreline of a body of water. Beaches occur along coastal areas, where wave or current action deposits and reworks sediments, or at the margin of land along a lake or river subject to erosion caused by rainfall. Beaches are not necessarily found in conjunction with salt water, such as the ocean, in all instances. A seashore beach is merely one type of beach but it is the most commonly associated with the perception of the word beach."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreahb:BodyOfWater ;
            owl:onProperty sorelsp:isAdjacentTo ],
        soreal:Landform .

sorealc:CoastalMargin a owl:Class ;
    rdfs:label "coastal margin"@en ;
    rdfs:subClassOf sorealc:CoastalRegion,
        sostrg:Margin .

sorealc:CoastalPlain a owl:Class ;
    rdfs:label "coastal plain"@en ;
    rdfs:subClassOf sorealc:CoastalRegion,
        soreal:Plain .

sorealc:Cove a owl:Class ;
    rdfs:label "cove"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Harbor a owl:Class ;
    rdfs:label "harbor"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Hinterland a owl:Class ;
    rdfs:label "hinterland"@en ;
    rdfs:subClassOf soreal:LandRegion .

sorealc:Intertidal a owl:Class ;
    rdfs:label "intertidal"@en ;
    owl:equivalentClass sorealc:IntertidalZone .

sorealc:IslandArc a owl:Class ;
    rdfs:label "island arc"@en ;
    rdfs:subClassOf sorealc:CoastalLandform .

sorealc:Isthmus a owl:Class ;
    rdfs:label "isthmus"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Key a owl:Class ;
    rdfs:label "key"@en ;
    rdfs:subClassOf sorealc:Island .

sorealc:MudFlat a owl:Class ;
    rdfs:label "mud flat"@en ;
    rdfs:subClassOf sorealc:CoastalLandform .

sorealc:Riparian a owl:Class ;
    rdfs:label "riparian"@en ;
    rdfs:comment "A riparian zone is the interface between land and a flowing surface water body. Plant communities along the river margins are called riparian vegetation, characterized by hydrophilic plants. Riparian zones are significant in ecology, environmental management, and civil engineering due to their role in soil conservation, their biodiversity, and the influence they have on aquatic ecosystems. Riparian zones occur in many forms including grassland, woodland, wetland or even non-vegetative. In some regions the terms riparian woodland, riparian forest, riparian buffer zone or riparian strip are used to characterize a riparian zone."@en ;
    rdfs:subClassOf sorealc:CoastalRegion ;
    owl:equivalentClass sorealc:RiparianZone .

sorealc:Shoal a owl:Class ;
    rdfs:label "shoal"@en ;
    rdfs:comment "A shoal is a somewhat linear landform within or extending into a body of water, typically comprised of sand, silt or small pebbles. Alternatively termed sandbar or sandbank, a bar is characteristically long and narrow (linear) and develops where a stream or ocean current promote deposition of granular material, resulting in localized shallowing (shoaling) of the water. Bars can appear in the sea, in a lake, or in a river. Alternatively a bar may separate a lake from the sea, as in the case of an ayre. They are typically composed of sand, although could be of any granular matter that the moving water has access to and is capable of shifting around (for example, soil, silt, gravel, cobble, shingle, or even boulders). The grain size of the material comprising a bar is related to the size of the waves or the strength of the currents moving the material, but the availability of material to be worked by waves and currents is also important."@en ;
    rdfs:subClassOf sorealc:CoastalLandform .

sorealc:Shore a owl:Class ;
    rdfs:label "shore"@en ;
    rdfs:comment "A shore or shoreline is the fringe of land at the edge of a large body of water, such as an ocean, sea, or lake."@en ;
    rdfs:subClassOf sorealc:CoastalRegion,
        soreal:Land ;
    owl:equivalentClass sorealc:Shoreline .

sorealc:ShorePlatform a owl:Class ;
    rdfs:label "shore platform"@en ;
    owl:equivalentClass sorealc:WaveCutPlatform .

sorealc:Supratidal a owl:Class ;
    rdfs:label "supratidal"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Terracette a owl:Class ;
    rdfs:label "terracette"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Tidal a owl:Class ;
    rdfs:label "tidal"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:Tombolo a owl:Class ;
    rdfs:label "tombolo"@en ;
    rdfs:subClassOf sorealc:Bar .

sorealc:Updrift a owl:Class ;
    rdfs:label "updrift"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:WaveAttackZone a owl:Class ;
    rdfs:label "wave attack zone"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealf:Alluvial a owl:Class ;
    rdfs:label "alluvial"@en ;
    rdfs:comment "The process of depositing soil or sediments by a river or other running water. [Wikipedia]"@en ;
    rdfs:subClassOf sophgg:SedimentFormation .

sorealf:AlluvialFan a owl:Class ;
    rdfs:label "alluvial fan"@en ;
    rdfs:subClassOf sorealf:PiedmontSlope .

sorealf:AlluvialPlain a owl:Class ;
    rdfs:label "alluvial plain"@en ;
    rdfs:subClassOf sorealf:FluvialPlain,
        sorealf:PiedmontSlope .

sorealf:Bajada a owl:Class ;
    rdfs:label "bajada"@en ;
    rdfs:subClassOf sorealf:PiedmontSlope .

sorealf:Catchment a owl:Class ;
    rdfs:label "catchment"@en ;
    rdfs:comment "A catchment, or drainage basin, is an extent of land where water from precipitation drains into a body of water [Wikipedia]"@en ;
    rdfs:subClassOf sorealf:Watershed .

sorealf:Cave a owl:Class ;
    rdfs:label "cave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:contains ;
            owl:someValuesFrom sorealf:Tunnel ],
        sorealf:FluvialLandform,
        sorepsg3:Cavity .

sorealf:DrainageBasin a owl:Class ;
    rdfs:label "drainage basin"@en ;
    owl:equivalentClass sorealf:Watershed .

sorealf:DryLake a owl:Class ;
    rdfs:label "dry lake"@en ;
    owl:equivalentClass sorealf:Playa .

sorealf:FloodPlain a owl:Class ;
    rdfs:label "flood plain"@en ;
    rdfs:subClassOf sorealf:FluvialPlain .

sorealf:Gulley a owl:Class ;
    rdfs:label "gulley"@en,
        "gully"@en ;
    dcterms:contributor <https://orcid.org/0000-0002-0337-8610> ;
    rdfs:seeAlso sorealf:Gully ;
    rdfs:subClassOf sorealf:FluvialLandform ;
    owl:deprecated true .

sorealf:KarstLandform a owl:Class ;
    rdfs:label "karst landform"@en ;
    rdfs:comment "Karst topography is a landscape shaped by the dissolution of a layer or layers of soluble bedrock, usually carbonate rock such as limestone or dolomite. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophgg:Karst ],
        soreal:Landform .

sorealf:LacustrinePlain a owl:Class ;
    rdfs:label "lacustrine plain"@en ;
    rdfs:subClassOf sorealf:FluvialPlain .

sorealf:Ripple a owl:Class ;
    rdfs:label "ripple"@en ;
    rdfs:subClassOf sorealf:Bedform .

sorealf:RiverBed a owl:Class ;
    rdfs:label "river bed"@en ;
    rdfs:subClassOf sorealf:Bedform .

sorealf:Sabkha a owl:Class ;
    rdfs:label "sabkha"@en ;
    rdfs:subClassOf sorealf:SaltFlat .

sorealf:ScrollPlain a owl:Class ;
    rdfs:label "scroll plain"@en ;
    rdfs:subClassOf sorealf:FluvialPlain .

sorealf:Turbidite a owl:Class ;
    rdfs:label "turbidite"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealf:Wall a owl:Class ;
    rdfs:label "wall"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealf:Wash a owl:Class ;
    rdfs:label "wash"@en ;
    rdfs:subClassOf sorealf:PiedmontSlope .

sorealg:Arete a owl:Class ;
    rdfs:label "arete"@en ;
    rdfs:comment "A thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:Cirque a owl:Class ;
    rdfs:label "cirque"@en ;
    rdfs:comment "An amphitheatre-like valley head, formed at the head of a valley glacier by erosion."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:Esker a owl:Class ;
    rdfs:label "esker"@en ;
    rdfs:comment "A long winding ridge of stratified sand and gravel, examples of which occur in glaciated and formerly glaciated regions."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:GlacialMoraine a owl:Class ;
    rdfs:label "glacial moraine"@en ;
    owl:equivalentClass sorealg:Moraine .

sorealg:Kame a owl:Class ;
    rdfs:label "kame"@en ;
    rdfs:comment "An irregularly shaped hill or mound composed of sand, gravel and till that accumulates in a depresson on a retreating glacier, and is then deposited with further melting.[Wikipedia]"@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:OutwashFan a owl:Class ;
    rdfs:label "outwash fan"@en ;
    rdfs:comment "A fan-shaped body of sediments deposited by braided streams from a melting glacier. Sediment locked within the ice of the glacier gets transported by the streams of meltwater and deposits on the outwash plain at the terminus of the glacier."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:RockGlacier a owl:Class ;
    rdfs:label "rock glacier"@en ;
    rdfs:comment "Rock glaciers are distinctive geomorphological landforms of blocky detritus which may extend outward and downslope from talus cones or from glaciers or the terminal moraines of glaciers. [Wikipedia]"@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:Sandur a owl:Class ;
    rdfs:label "sandur"@en ;
    rdfs:comment "A glacial outwash plain formed of sediments deposited by meltwater at the terminus of a glacier."@en ;
    rdfs:subClassOf sorealg:GlacialOutwashPlain .

sorealg:Thermokarst a owl:Class ;
    rdfs:label "thermokarst"@en ;
    rdfs:comment "A land surface characterised by very irregular surfaces of marshy hollows and small hummocks formed as ice-rich permafrost thaws."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:Till a owl:Class ;
    rdfs:label "till"@en ;
    owl:equivalentClass sorealg:TillPlain .

sorealg:UShapedValley a owl:Class ;
    rdfs:label "u shaped valley"@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealo:Alpine a owl:Class ;
    rdfs:label "alpine"@en ;
    rdfs:comment "Alpine region is one above the tree line. [Wikipedia]"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:Bluff a owl:Class ;
    rdfs:label "bluff"@en ;
    rdfs:subClassOf sorealo:Hill .

sorealo:Butte a owl:Class ;
    rdfs:label "butte"@en ;
    rdfs:subClassOf sorealo:Hill .

sorealo:Cliff a owl:Class ;
    rdfs:label "cliff"@en ;
    rdfs:subClassOf sorealo:Hill .

sorealo:Foothill a owl:Class ;
    rdfs:label "foothill"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:Hummock a owl:Class ;
    rdfs:label "hummock"@en ;
    rdfs:subClassOf soreal:Landform .

sorealo:Mesa a owl:Class ;
    rdfs:label "mesa"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:MountainRange a owl:Class ;
    rdfs:label "mountain range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealo:Mountain ;
            owl:onProperty sorelsp:clusterOf ],
        sorepsg:Cluster .

sorealo:NonOrographic a owl:Class ;
    rdfs:label "non orographic"@en ;
    rdfs:subClassOf soreal:Landform ;
    owl:disjointWith sorealo:Orographic .

sorealo:Pass a owl:Class ;
    rdfs:label "pass"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:Plateau a owl:Class ;
    rdfs:label "plateau"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:Protrusion a owl:Class ;
    rdfs:label "protrusion"@en ;
    rdfs:subClassOf sorealo:Ridge .

sorealo:Summit a owl:Class ;
    rdfs:label "summit"@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:Talus a owl:Class ;
    rdfs:label "talus"@en ;
    rdfs:comment "A slope formed at the base of a steeper slope, made of fallen and disintegrated materials."@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealo:TopographicalRegion a owl:Class ;
    rdfs:label "topographical region"@en ;
    rdfs:subClassOf soreal:SurfaceRegion .

sorealo:Ubac a owl:Class ;
    rdfs:label "ubac"@en ;
    rdfs:comment "The shady (usually poleward) side of a mountain."@en ;
    rdfs:subClassOf sorealo:MountainRegion .

sorealp:CityPark a owl:Class ;
    rdfs:label "city park"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:City ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:Park .

sorealp:CountyPark a owl:Class ;
    rdfs:label "county park"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:County ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:Park .

sorealp:MPA a owl:Class ;
    rdfs:label "mpa"@en ;
    owl:equivalentClass sorealp:MarineProtectedArea .

sorealp:NationalForest a owl:Class ;
    rdfs:label "national forest"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:Country ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:LandReserve .

sorealp:NationalMonument a owl:Class ;
    rdfs:label "national monument"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:Country ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:LandReserve .

sorealp:NationalPark a owl:Class ;
    rdfs:label "national park"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:Country ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:Park .

sorealp:StateForest a owl:Class ;
    rdfs:label "state forest"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:State ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:LandReserve .

sorealp:StatePark a owl:Class ;
    rdfs:label "state park"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:State ;
            owl:onProperty sorelh:hasJurisdiction ],
        sorealp:Park .

sorealp:WildlifeRefuge a owl:Class ;
    rdfs:label "wildlife refuge"@en ;
    rdfs:subClassOf sorealp:LandReserve .

sorealt:AseismicRidge a owl:Class ;
    rdfs:label "aseismic ridge"@en ;
    rdfs:comment "Are neighboring ridges on different tectonic plates which have similar seismic characteristics. ‘Based on similar seismic velocity gradients of the lavas of the Carnegie, Cocos and Malpelos Ridges there is evidence that the hotspot activity has been the result of a single long mantle melt rather than multiple periods of activity and dormancy.’ [Wikipedia]"@en ;
    rdfs:subClassOf sorealo:Ridge .

sorealt:ConvergentBoundary a owl:Class ;
    rdfs:label "convergent boundary"@en ;
    rdfs:comment "In plate tectonics, a convergent boundary or convergent plate boundary, also known as a destructive plate boundary (because of subduction), is an actively deforming region where two (or more) tectonic plates or fragments of lithosphere move toward one another and collide and where crust is being destroyed. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophgt:AsymmetricHeatFlow ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophso:Subsidence ],
        [ a owl:Restriction ;
            owl:onProperty sorelsc:hasGeologicProvince ;
            owl:someValuesFrom soreagor:Orogen ],
        sorealt:PlateBoundary ;
    owl:equivalentClass sorealt:ConvergentMargin,
        sorealt:ConvergentPlateBoundary .

sorealt:Diapir a owl:Class ;
    rdfs:label "diapir"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

sorealt:FaultZone a owl:Class ;
    rdfs:label "fault zone"@en ;
    owl:equivalentClass sorealt:FractureZone .

sorealt:Footwall a owl:Class ;
    rdfs:label "footwall"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealt:FractureZone ;
            owl:onProperty sorel:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophso:Fault ;
            owl:onProperty sorelsp:below ],
        soreag:GeologicFeature ;
    owl:disjointWith sorealt:HangingWall .

sorealt:LIP a owl:Class ;
    rdfs:label "lip"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorealt:FloodBasalt ],
        soreal:SurfaceRegion ;
    owl:equivalentClass sorealt:LargeIgneousProvince .

sorealt:Ophiolite a owl:Class ;
    rdfs:label "ophiolite"@en ;
    rdfs:comment "An Ophiolite is a section of the Earth's oceanic crust and the underlying upper mantle that has been uplifted or emplaced to be exposed within continental crustal rocks. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

sorealt:PairedMetamorphicBelt a owl:Class ;
    rdfs:label "paired metamorphic belt"@en ;
    rdfs:comment "A location where belts of  high pressure, low temperature metamorphism on the oceanic side are associated with belts of high pressure, high temperature metamorphism on the continent side. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgt:AsymmetricHeatFlow ;
            owl:onProperty sorel:hasPhenomena ],
        soreag:GeologicFeature .

sorealt:Plate a owl:Class ;
    rdfs:label "plate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreag:Lithosphere ;
            owl:onProperty sorel:partOf ],
        soreag:GeologicProvince .

sorealt:RiftValley a owl:Class ;
    rdfs:label "rift valley"@en ;
    rdfs:comment "A rift valley is a linear-shaped lowland between highlands or mountain ranges created by the action of a geologic rift or fault. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealt:TectonicLandform ;
            owl:onProperty sorelsc:hasGeomorphologicalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalRift ;
            owl:onProperty sorelsp:hasOuterBoundary ],
        soreag:GeologicFeature .

sorealt:SubductionZone a owl:Class ;
    rdfs:label "subduction zone"@en ;
    rdfs:comment "A subduction zone is an area on Earth where two tectonic plates move towards one another and subduction occurs.  [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

sorealt:TransformBoundary a owl:Class ;
    rdfs:label "transform boundary"@en ;
    rdfs:comment "A transform plate boundary is where two lithospheric plates slide past each other and where crust is neither produced or destroyed. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasBasin ;
            owl:someValuesFrom soreagb:TranspressionalBasin ],
        sorealt:PlateBoundary ;
    owl:equivalentClass sorealt:TransformMargin,
        sorealt:TransformPlateBoundary .

sorealt:TranspressionalStressRegime a owl:Class ;
    rdfs:label "transpressional stress regime"@en ;
    rdfs:comment "Transpression regimes are formed during oblique collision of tectonic plates and during non-orthogonal subduction. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Melange ;
            owl:onProperty sorelch:hasSubstance ],
        sorealt:StressRegime .

sorealt:TranstensionalStressRegime a owl:Class ;
    rdfs:label "transtensional stress regime"@en ;
    rdfs:comment "Transtension regimes are oblique tensional environments where stretching takes place. [Wikipedia]"@en ;
    rdfs:subClassOf sorealt:StressRegime .

sorealv:Caldera a owl:Class ;
    rdfs:label "caldera"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

sorealv:CentralVolcano a owl:Class ;
    rdfs:label "central volcano"@en ;
    rdfs:comment "A volcano constructed by the ejection of debris and lava flows from a central point, forming a more or less symmetrical volcano."@en ;
    rdfs:subClassOf sorealv:Volcano .

sorealv:CompositeVolcano a owl:Class ;
    rdfs:label "composite volcano"@en ;
    owl:equivalentClass sorealv:CompoundVolcano .

sorealv:Fumarole a owl:Class ;
    rdfs:label "fumarole"@en ;
    rdfs:subClassOf sorealv:Vent .

sorealv:Geothermal a owl:Class ;
    rdfs:label "geothermal"@en ;
    rdfs:comment "In geology, geothermal refers to heat sources within the planet. Strictly speaking, geo-thermal necessarily refers to the Earth but the concept may be applied to other planets. Geothermal is technically an adjective (e.g., geothermal energy) but in U.S. English the word has attained frequent use as a noun (otherwise expressed as g. heat, g. source, or geotherm). The planet's internal heat was originally generated during its accretion, due to gravitational binding energy, and since then additional heat has continued to be generated by the radioactive decay of elements such as uranium, thorium, and potassium. The heat flow from the interior to the surface is only 1/20,000 as great as the energy received from the Sun."@en ;
    rdfs:subClassOf soprope:Heat,
        soreag:GeologicFeature .

sorealv:HotSpot a owl:Class ;
    rdfs:label "hot spot"@en ;
    rdfs:comment "In geology, a hotspot is a location on the Earth's surface that has experienced active volcanism for a long period of time. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealv:LinearVolcanicChain ;
            owl:onProperty sorel:hasRealm ],
        [ a owl:Restriction ;
            owl:allValuesFrom somarocki:AnorogenicIgneousRock ;
            owl:onProperty sorelch:hasSubstance ],
        soreag:GeologicFeature .

sorealv:LavaPlain a owl:Class ;
    rdfs:label "lava plain"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

sorealv:Monogenetic a owl:Class ;
    rdfs:label "monogenetic"@en ;
    rdfs:comment "A volcano built by a single eruption."@en ;
    rdfs:subClassOf sorealv:Volcano .

sorealv:ShieldVolcano a owl:Class ;
    rdfs:label "shield volcano"@en ;
    rdfs:subClassOf sorealv:Volcano .

sorealv:Stratovolcano a owl:Class ;
    rdfs:label "stratovolcano"@en ;
    rdfs:comment "A volcano composed of both lava flows and pyroclastic material."@en ;
    rdfs:subClassOf sorealv:Volcano .

sorealv:SubaqueousVolcano a owl:Class ;
    rdfs:label "subaqueous volcano"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Ocean ;
            owl:onProperty sorel:hasRealm ],
        sorealv:Volcano ;
    owl:equivalentClass sorealv:SubmarineVolcano .

sorealv:Tumulus a owl:Class ;
    rdfs:label "tumulus"@en ;
    rdfs:comment "A doming or small mound on the crest of a lava flow caused by pressure due to the difference in the rate of flow between the cooler crust and the more fluid lava below."@en ;
    rdfs:subClassOf soreal:Landform .

sorealv:VolcanicArc a owl:Class ;
    rdfs:label "volcanic arc"@en ;
    owl:equivalentClass sorealv:VolcanicChain .

sorealv:VolcanicSystem a owl:Class ;
    rdfs:label "volcanic system"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

soreal:CentralCreekCrater a owl:Class ;
    rdfs:label "central creek crater"@en ;
    rdfs:subClassOf soreal:Crater .

soreal:ComplexCrater a owl:Class ;
    rdfs:label "complex crater"@en ;
    rdfs:subClassOf soreal:Crater .

soreal:Continent a owl:Class ;
    rdfs:label "continent"@en ;
    rdfs:comment "A continent is one of several large landmasses. [Wikipedia]"@en ;
    rdfs:subClassOf soreal:LandRegion .

soreal:DebrisBasin a owl:Class ;
    rdfs:label "debris basin"@en ;
    rdfs:subClassOf soreal:LandRegion .

soreal:DeflationZone a owl:Class ;
    rdfs:label "deflation zone"@en ;
    rdfs:subClassOf soreal:LandRegion .

soreal:Dryland a owl:Class ;
    rdfs:label "dryland"@en ;
    rdfs:subClassOf soreal:LandRegion .

soreal:Field a owl:Class ;
    rdfs:label "field"@en ;
    rdfs:comment "Field (agriculture), an area of land used to cultivate crops, or to keep livestock [Wikipedia]"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:Highland a owl:Class ;
    rdfs:label "highland"@en ;
    rdfs:subClassOf soreal:Landform ;
    owl:disjointWith soreal:Lowland .

soreal:ImpactBasin a owl:Class ;
    rdfs:label "impact basin"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:ImpactCrater a owl:Class ;
    rdfs:label "impact crater"@en ;
    rdfs:subClassOf soreal:Crater .

soreal:Lamination a owl:Class ;
    rdfs:label "lamination"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:LandCover a owl:Class ;
    rdfs:label "land cover"@en ;
    rdfs:comment "Land cover is the physical material at the surface of the earth. Land covers include grass, asphalt, trees, bare ground, water, etc. [Wikipedia]"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:Landscape a owl:Class ;
    rdfs:label "landscape"@en ;
    rdfs:comment "A landscape comprises the visible features of an area of land, including physical elements such as landforms, living elements of flora and fauna, abstract elements such as lighting and weather conditions, and human elements, for instance human activity or the built environment. Landscape may also signify the objects around one in a building."@en ;
    rdfs:subClassOf soreal:Landform .

soreal:Mare a owl:Class ;
    rdfs:label "mare"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostv:Dark ;
            owl:onProperty sorelph:hasVisibility ],
        soreal:Plain .

soreal:PedestalCrater a owl:Class ;
    rdfs:label "pedestal crater"@en ;
    rdfs:subClassOf soreal:Crater .

soreal:Prarie a owl:Class ;
    rdfs:label "prarie"@en ;
    rdfs:subClassOf soreal:Plain .

soreal:RockyPitFloorCrater a owl:Class ;
    rdfs:label "rocky pit floor crater"@en ;
    rdfs:subClassOf soreal:PitCrater .

soreal:ShatterCone a owl:Class ;
    rdfs:label "shatter cone"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:Spall a owl:Class ;
    rdfs:label "spall"@en ;
    rdfs:subClassOf soreal:Landform .

soreao:Abyss a owl:Class ;
    rdfs:label "abyss"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer ;
    owl:equivalentClass soreao:Abyssal .

soreao:BarrierLayer a owl:Class ;
    rdfs:label "barrier layer"@en ;
    rdfs:comment "The depth range, where it exists, between the bottom of the oceanic surface mixed layer and the thermocline, usually at a depth between 30 and 80 m."@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:Bathyal a owl:Class ;
    rdfs:label "bathyal"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:EuphoticZone a owl:Class ;
    rdfs:label "euphotic zone"@en ;
    owl:equivalentClass soreao:PhoticZone .

soreao:Hadal a owl:Class ;
    rdfs:label "hadal"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:Halocline a owl:Class ;
    rdfs:label "halocline"@en ;
    rdfs:comment "In oceanography, a Halocline is a strong, vertical salinity gradient. Because salinity (in concert with temperature) affects the density of seawater, it can play a role in its vertical stratification."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropche:Salinity ;
            owl:onProperty sorelm:hasGradient ],
        soreao:WaterBodyLayer .

soreao:LimneticZone a owl:Class ;
    rdfs:label "limnetic zone"@en ;
    rdfs:comment "The limnetic zone is the well-lit, open surface waters farther from shore in a lake. It is surrounded by the littoral zone and above the profundal zone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreao:ProfundalZone ;
            owl:onProperty sorelsp:above ],
        soreao:WaterBodyLayer .

soreao:MixedLayer a owl:Class ;
    rdfs:label "mixed layer"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:NeriticZone a owl:Class ;
    rdfs:label "neritic zone"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:OpenOcean a owl:Class ;
    rdfs:label "open ocean"@en ;
    rdfs:subClassOf soreao:OceanRegion .

soreao:PelagicSubZone a owl:Class ;
    rdfs:label "pelagic sub zone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreao:PelagicZone ;
            owl:onProperty sorel:partOf ],
        soreao:OceanRegion .

soreao:Polynya a owl:Class ;
    rdfs:label "polynya"@en ;
    rdfs:comment "A polynya is any non-linear area of open water surrounded by sea ice. It is now used as geographical term for areas of sea in Arctic or Antarctic regions which remain unfrozen for much of the year."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreac:SeaIce ;
            owl:onProperty sorelsp:surroundedBy ],
        soreao:OceanRegion .

soreao:Pycnocline a owl:Class ;
    rdfs:label "pycnocline"@en ;
    rdfs:comment "A pycnocline is a layer across which there is a rapid change in water density with depth. In freshwater environments such as lakes this density change is primarily caused by water temperature, while in seawater environments such as oceans the density change may be caused by changes in water temperature and/or salinity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropche:Salinity ;
            owl:onProperty sorelm:hasGradient ],
        soreao:WaterBodyLayer .

soreao:Thermocline a owl:Class ;
    rdfs:label "thermocline"@en ;
    rdfs:comment "The thermocline (sometimes metalimnion) is a layer within a body of water or air where the temperature changes rapidly with depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soproptg:TemperatureGradient ;
            owl:onProperty sorelsc:hasQuantity ],
        soreao:WaterBodyLayer .

