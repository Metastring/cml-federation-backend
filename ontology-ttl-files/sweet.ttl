sorepmg:Edge a owl:Class ;
    rdfs:label "edge"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty sorelm:hasUnorderedVertexPair ],
        sorepmg:StructuralComponent .

sorepmo:BinaryOperation a owl:Class ;
    rdfs:label "binary operation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepm:OrderedPair ;
            owl:onProperty sorelm:hasInput ],
        sorepmo:Operation .

sorepmo:Integral a owl:Class ;
    rdfs:label "integral"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty sorelm:hasFunction ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty sorelm:withRespectTo ],
        sorepmo:OperationOnFunction ;
    owl:equivalentClass sorepmo:Integration .

