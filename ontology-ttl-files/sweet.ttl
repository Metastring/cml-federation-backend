    rdfs:label "wet summer dry winter climate"@en ;
    rdfs:subClassOf soreacz:DryWinterClimate,
        soreacz:WetSummerClimate .

soreac:GlacialRegion a owl:Class ;
    rdfs:label "glacial region"@en ;
    rdfs:subClassOf sorea:PlanetaryRealm .

soreac:Glacier a owl:Class ;
    rdfs:label "glacier"@en ;
    rdfs:subClassOf somaw:Ice ;
    skos:definition [ dcterms:created "2019-12-10T09:06:36-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "The definition of glacier is highly variable. Two main issues exist: 1) Whether or not a mass of ice must currently show movement to be considered a glacier or not and 2) What is the relationship between ice sheets and glaciers (i.e., which is the parent in a parent/child relationship or whether they are distinct terms)."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_00000133> ] ;
    skos:exactMatch <http://purl.obolibrary.org/obo/ENVO_00000133> .

soreag:Moho a owl:Class ;
    rdfs:label "moho"@en ;
    rdfs:comment "The boundary between the crust and mantle is conventionally placed at the Mohorovi_i_ discontinuity, a boundary defined by a contrast in seismic velocity. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicBoundary ;
    owl:equivalentClass soreag:Mohorovi_i_Discontinuity .

soreag:UpperMantle a owl:Class ;
    rdfs:label "upper mantle"@en ;
    rdfs:comment "The mantle is divided into sections based upon results from seismology. The upper mantle is the region from 33–410 km (20 to 254 miles). The upper part of the mantle is composed mostly of peridotite, a rock denser than rocks common in the overlying crust. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:Mantle .

soreagcons:Megacryst a owl:Class ;
    rdfs:label "megacryst"@en ;
    rdfs:comment "constituent occurs as a collection of particles that are characterized by average properties of the individual particles"@en ;
    rdfs:subClassOf soreagcons:ParticulateConstituent .

