    rdfs:subClassOf sohukd:Science .

sohukd:Neotectonics a owl:Class ;
    rdfs:label "neotectonics"@en ;
    rdfs:comment "Neotectonics is a subdiscipline of tectonics. It is the study of the motions and deformations of the Earth's crust (geological and geomorphological processes) which are current or recent in geologic time.[1] The term may also refer to the motions/deformations in question themselves. The corresponding time frame is referred to as the neotectonic period."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sostti:NeotectonicPeriod ;
            owl:onProperty sorelt:hasTimeReference ],
        sohukd:Tectonics .

