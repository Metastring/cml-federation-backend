        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/reprSciUnits>,
        <http://sweetontology.net/reprSpaceGeometry> ;
    owl:versionInfo "3.6.0" .

sorelcl:hasClimateZone a owl:ObjectProperty ;
    rdfs:label "has climate zone"@en ;
    owl:equivalentProperty sorelcl:hasClimateZoneType .

sorelm:derivativeWithRespectTo a owl:ObjectProperty ;
    rdfs:label "derivative with respect to"@en .

sorelm:hasDegree a owl:DatatypeProperty ;
    rdfs:label "has degree"@en .

sorelm:representationOf a owl:ObjectProperty ;
    rdfs:label "representation of"@en .

sorelph:hasAstronomicalBody a owl:ObjectProperty ;
    rdfs:label "has astronomical body"@en ;
    rdfs:range soreaab:AstronomicalBody .

sorelpr:hasGenesis a owl:ObjectProperty ;
    rdfs:label "has genesis"@en ;
    rdfs:range sorepsp:Genesis .

sorelsp:hasGeometricalObject a owl:ObjectProperty ;
    rdfs:label "has geometrical object"@en ;
    rdfs:range sorepsg:GeometricalObject .

sorelt:hasFrequency a owl:ObjectProperty ;
    rdfs:label "has frequency"@en ;
    rdfs:range soproptf:Frequency .

sorelt:hasStartTime a owl:ObjectProperty ;
    rdfs:label "has start time"@en ;
    rdfs:range sopropti:StartTime ;
    rdfs:subPropertyOf sorelt:hasTime ;
    owl:equivalentProperty sorelt:start .

sorelt:temporalPartOf a owl:ObjectProperty ;
    rdfs:label "temporal part of"@en ;
    rdfs:domain sopropti:Time ;
    rdfs:range sopropti:Time ;
    rdfs:subPropertyOf sorelm:subsetOf .

sorep:MeasurementScale a owl:Class ;
    rdfs:label "measurement scale"@en ;
    owl:equivalentClass sorep:Scale .

sorep:OrdinalScale a owl:Class ;
    rdfs:label "ordinal scale"@en ;
    rdfs:subClassOf sorep:MeasurementScale ;
    owl:disjointWith sorep:QuantitativeScale .

sorep:QuantitativeScale a owl:Class ;
    rdfs:label "quantitative scale"@en ;
    rdfs:subClassOf sorep:MeasurementScale .

sorepdsa:Parameterize a owl:Class ;
    rdfs:label "parameterize"@en ;
    rdfs:subClassOf sorepdsa:DataAnalysisService ;
    owl:equivalentClass sorepsmo:Parameterization .

sorepdsa:Visualization a owl:Class ;
    rdfs:label "visualization"@en ;
    rdfs:subClassOf sorepdsa:DataAnalysisService ;
    owl:equivalentClass sorepdsa:Visualize .

sorepdsr:DataReductionService a owl:Class ;
    rdfs:label "data reduction service"@en ;
    rdfs:subClassOf sorepds:DataService .

sorepdsr:Subset a owl:Class ;
    rdfs:label "subset"@en ;
    rdfs:subClassOf sorepdsr:DataReductionService .

sorepm:Seq a owl:Class ;
    rdfs:label "seq"@en ;
    rdfs:subClassOf sorepm:Container ;
    owl:equivalentClass sorepm:Sequence .

sorepmg:Vertex a owl:Class ;
    rdfs:label "vertex"@en ;
    rdfs:subClassOf sorepm:Point,
        sorepmg:StructuralComponent ;
    owl:equivalentClass sorepmg:Vertice .

sorepmo:Product a owl:Class ;
    rdfs:label "product"@en .

sorepmo:UnaryOperation a owl:Class ;
    rdfs:label "unary operation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepm:Scalar ;
            owl:onProperty sorelm:hasInput ],
        sorepmo:Operation .

sorepmst:HypothesisTest a owl:Class ;
    rdfs:label "hypothesis test"@en ;
    rdfs:subClassOf sorepmst:StatisticalInference .

