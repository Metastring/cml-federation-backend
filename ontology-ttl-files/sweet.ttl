            owl:allValuesFrom sophst:SolarActivity ;
            owl:onProperty sorel:hasPhenomena ],
        sophcy:GlobalCycle .

sophcm:MaterialCycle a owl:Class ;
    rdfs:label "material cycle"@en ;
    rdfs:subClassOf sorepmg:Cycle .

