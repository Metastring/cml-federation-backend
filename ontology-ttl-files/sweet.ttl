        <http://sweetontology.net/stateChemical>,
        <http://sweetontology.net/stateRoleBiological>,
        <http://sweetontology.net/stateRoleImpact> ;
    owl:versionInfo "3.6.0" .

sophfd:Cell a owl:Class ;
    rdfs:label "cell"@en ;
    rdfs:comment "In radar usage, a local maximum in radar reflectivity that undergoes a life cycle of growth and decay. The rising portion of the reflectivity maximum is indicative of updraft, and the later descending portion is indicative of a precipitation downdraft. Cells in ordinary convective storms last from 20 to 30 min, but often form longer-lasting multicell convective storms. Cells in supercell storms are more steady and last considerably longer. See also thunderstorm cell."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasProcess ;
            owl:someValuesFrom soprocp:Rotation ],
        soph:Phenomena .

sophfd:CellCluster a owl:Class ;
    rdfs:label "cell cluster"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfd:Cell ;
            owl:onProperty sorelsp:clusterOf ],
        sorepsg:Cluster .

sophfd:Eddy a owl:Class ;
    rdfs:label "eddy"@en ;
    rdfs:comment "In fluid dynamics, an eddy is the swirling of a fluid and the reverse current created when the fluid flows past an obstacle. The moving fluid creates a space devoid of downstream-flowing water on the downstream side of the object. Fluid behind the obstacle flows into the void creating a swirl of fluid on each edge of the obstacle, followed by a short reverse flow of fluid behind the obstacle flowing upstream, toward the back of the obstacle. This phenomenon is most visible behind large emergent rocks in swift-flowing rivers."@en ;
    rdfs:subClassOf sophfd:FluidPhenomena .

sophfd:HighPressure a owl:Class ;
    rdfs:label "high pressure"@en ;
    rdfs:subClassOf sopropp:Pressure ;
    owl:equivalentClass sophfd:Ridge .

sophfd:Vortex a owl:Class ;
    rdfs:label "vortex"@en ;
    rdfs:comment "More often the term refers to a flow with closed streamlines or to the idealized case in which all vorticity is concentrated in a vortex filament."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Rotation ;
            owl:onProperty sorel:hasProcess ],
        sophfd:Flow .

sophfi:Lifting a owl:Class ;
    rdfs:label "lifting"@en .

sophfi:StaticStability a owl:Class ;
    rdfs:label "static stability"@en ;
    rdfs:comment "The ability of a fluid at rest to become turbulent or laminar due to the effects of buoyancy."@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophgf:StrikeSlip a owl:Class ;
    rdfs:label "strike slip"@en ;
    rdfs:comment "The net slip of the fault (slip vector) is parallel to the strike of the fault."@en ;
    rdfs:subClassOf sophgf:StrikeSeparationSense .

sophgg:SedimentFormation a owl:Class ;
    rdfs:label "sediment formation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somas:Sediment ;
            owl:onProperty sorelch:hasSubstance ],
        sophgg:MaterialDisplacement .

sophgg:Slide a owl:Class ;
    rdfs:label "slide"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        soph:Phenomena,
        sophgg:MaterialDisplacement .

sophgg:Weathering a owl:Class ;
    rdfs:label "weathering"@en ;
    rdfs:comment "Weathering is the decomposition of rocks, soils and their minerals through direct contact with the Earth's atmosphere. Weathering occurs in situ, or with no movement, and thus should not to be confused with erosion, which involves the movement and disintegration of rocks and minerals by agents such as water, ice, wind and gravity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Rock ;
            owl:onProperty sorelch:hasSubstance ],
        sophgg:MaterialDisplacement ;
    owl:disjointWith sophso:Erosion .

sophgv:VolcanicActivity a owl:Class ;
    rdfs:label "volcanic activity"@en ;
    rdfs:comment "A geophysical phenomena involving the extrusion of rock that tends to form mountains or features like mountains over a period of time. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophgv:Volcanism ],
        sophg:GeospherePhenomena,
        sophgv:VolcanicActivity ;
    owl:equivalentClass sophgv:VolcanicPhenomena .

sophgv:VolcanicPhenomena a owl:Class ;
    rdfs:label "volcanic phenomena"@en .

sophhe:AtmosphericLightEmission a owl:Class ;
    rdfs:label "atmospheric light emission"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocw:Emission ;
            owl:onProperty sorel:hasPhenomena ],
        sophhe:HeliosphericPhenomena .

<http://sweetontology.net/phenOcean> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Ocean" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phen>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela> ;
    owl:versionInfo "3.6.0" .

sophoc:Breaker a owl:Class ;
    rdfs:label "breaker"@en ;
    rdfs:subClassOf sophoc:BreakingWave .

sophoc:OceanTide a owl:Class ;
    rdfs:label "ocean tide"@en ;
    rdfs:comment "The periodic rising and falling of the earth's oceans and atmosphere. It results from the tide-producing forces of the moon and sun acting upon the rotating earth. This disturbance actually propagates as a wave through the atmosphere and along the surface of the waters of the earth. Atmospheric tides are always so designated, whereas the term “tide“ alone commonly implies the oceanic variety. Sometimes, the consequent horizontal movement of water along the coastlines is also called “tide,” but it is preferable to designate the latter as tidal current, reserving the name tide for the vertical wavelike movement."@en ;
    rdfs:subClassOf sophcy:Tide,
        sophoc:CoastalPhenomena .

sophod:BoundaryCurrent a owl:Class ;
    rdfs:label "boundary current"@en ;
    rdfs:subClassOf sophod:OceanCurrent .

sophso:Coalescence a owl:Class ;
    rdfs:label "coalescence"@en .

sophso:Consolidation a owl:Class ;
    rdfs:label "consolidation"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Erosion a owl:Class ;
    rdfs:label "erosion"@en .

sophso:Failure a owl:Class ;
    rdfs:label "failure"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Fault a owl:Class ;
    rdfs:label "fault"@en ;
    rdfs:comment "In geology, a fault or fault line is a planar rock fracture, which shows evidence of relative movement. Large faults within the Earth's crust are the result of shear motion and active fault zones are the causal locations of most earthquakes. Earthquakes are caused by energy release during rapid slippage along faults. The largest examples are at tectonic plate boundaries but many faults occur far from active plate boundaries. Since faults do not usually consist of a single, clean fracture, the term fault zone is used when referring to the zone of complex deformation that is associated with the fault plane."@en ;
    rdfs:subClassOf sophso:Fracture ;
    owl:equivalentClass sophso:FaultLine .

sophsy:Oscillation a owl:Class ;
    rdfs:label "oscillation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Trend a owl:Class ;
    rdfs:label "trend"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsy:Variation a owl:Class ;
    rdfs:label "variation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophw:InternalWave a owl:Class ;
    rdfs:label "internal wave"@en ;
    owl:disjointWith sophw:SurfaceWave .

sophw:PlasmaWave a owl:Class ;
    rdfs:label "plasma wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Plasma ;
            owl:onProperty sorel:hasState ],
        sophw:Wave .

sophw:SolidWave a owl:Class ;
    rdfs:label "solid wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        sophw:Wave .

