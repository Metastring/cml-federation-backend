        owl:NamedIndividual ;
    rdfs:label "earth atmosphere mesoscale"@en .

soreaer:EarthAtmosphereSynopticScale a sopropsdis:DistanceRange_km,
        owl:NamedIndividual ;
    rdfs:label "earth atmosphere synoptic scale"@en .

soreaer:EarthBathypelagicZone a soreao:BathypelagicZone,
        owl:NamedIndividual ;
    rdfs:label "earth bathypelagic zone"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

