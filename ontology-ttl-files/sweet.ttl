    rdfs:label "SWEET Ontology Relationships Space" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenWave>,
        <http://sweetontology.net/propOrdinal>,
        <http://sweetontology.net/propSpace>,
        <http://sweetontology.net/propSpaceDirection>,
        <http://sweetontology.net/propSpaceDistance>,
        <http://sweetontology.net/propSpaceHeight>,
        <http://sweetontology.net/propSpaceLocation>,
        <http://sweetontology.net/propSpaceMultidimensional>,
        <http://sweetontology.net/realmRegion>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/reprSpaceDirection>,
        <http://sweetontology.net/reprSpaceGeometry>,
        <http://sweetontology.net/reprSpaceGeometry3D>,
        <http://sweetontology.net/stateSpaceScale> ;
    owl:versionInfo "3.6.0" .

soprops:SpatialConfiguration a owl:Class ;
    rdfs:label "spatial configuration"@en ;
    rdfs:subClassOf soprops:SpatialProperty .

somaoc:OrganicCompound a owl:Class ;
    rdfs:label "organic compound"@en ;
    rdfs:subClassOf somac:Compound,
        somaoc:OrganicSubstance .

sorepsu:UnitDefinedByProduct a owl:Class ;
    rdfs:label "unit defined by product"@en ;
    rdfs:subClassOf sorepmo:Product,
        sorepsu:ComplexUnit .

sopropo:Trust a owl:Class ;
    rdfs:label "trust"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sorel:hasState a owl:ObjectProperty ;
    rdfs:label "has state"@en ;
    rdfs:range sost:State .

sorelch:hasSubstance a owl:ObjectProperty ;
    rdfs:label "has substance"@en .

<http://sweetontology.net/relaSci> a owl:Ontology ;
    rdfs:label "SWEET Ontology Relationships Scientific" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrBiomass>,
        <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/phenGeolSeismicity>,
        <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/prop>,
        <http://sweetontology.net/propOrdinal>,
        <http://sweetontology.net/propQuantity>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmGeolBasin>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/repr>,
        <http://sweetontology.net/reprMath>,
        <http://sweetontology.net/reprSciUnits> ;
    owl:versionInfo "3.6.0" .

sorel:hasRealm a owl:ObjectProperty ;
    rdfs:label "has realm"@en ;
    rdfs:range sorea:Realm .

sopropef:EnergyFlux_Wm2 a owl:Class ;
    rdfs:label "energy flux wm2"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:wattPerMeterSquared ;
            owl:onProperty sorelsc:hasUnit ],
        sopropef:EnergyFlux .

somac:InorganicCompound a owl:Class ;
    rdfs:label "inorganic compound"@en ;
    rdfs:subClassOf somac:Compound .

somael:Element a owl:Class ;
    rdfs:label "element"@en ;
    rdfs:comment "A chemical element is a pure chemical substance consisting of one type of atom distinguished by its atomic number, which is the number of protons in its nucleus. The term is also used to refer to a pure chemical substance composed of atoms with the same number of protons. [Wikipedia]"@en ;
    rdfs:subClassOf soma:Chemical .

sorelsc:hasDefaultUnit a owl:ObjectProperty ;
    rdfs:label "has default unit"@en ;
    rdfs:domain sopropq:Quantity ;
    rdfs:range sorepsu:Unit .

sostti:Age a owl:Class ;
    rdfs:label "age"@en ;
    rdfs:comment "Epochs are divided into ages [millions of years] [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelt:temporalPartOf ;
            owl:someValuesFrom sostti:Epoch ],
        sostti:GeologicTimeUnit .

sorel:hasPhenomena a owl:ObjectProperty ;
    rdfs:label "has phenomena"@en ;
    rdfs:range soph:Phenomena .

<http://sweetontology.net/rela> a owl:Ontology ;
    rdfs:label "SWEET Ontology Relationships" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phen>,
        <http://sweetontology.net/proc>,
        <http://sweetontology.net/prop>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/state> ;
    owl:versionInfo "3.6.0" .

owlt:Instant a owl:Class ;
    rdfs:subClassOf sorepm:Point,
        sorept:Time .

somamin:Mineral a owl:Class ;
    rdfs:label "mineral"@en ;
    rdfs:comment "A mineral is a naturally occurring solid formed through geological processes that has a characteristic chemical composition, a highly ordered atomic structure, and specific physical properties [Wikipedia]"@en ;
    rdfs:subClassOf soma:SolidSubstance .

