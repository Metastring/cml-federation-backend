sophwn:Distortion a owl:Class ;
    rdfs:label "distortion"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:Flicker a owl:Class ;
    rdfs:label "flicker"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:Hiss a owl:Class ;
    rdfs:label "hiss"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:PulseSpreading a owl:Class ;
    rdfs:label "pulse spreading"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:Scintillation a owl:Class ;
    rdfs:label "scintillation"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:SideLobe a owl:Class ;
    rdfs:label "side lobe"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:Vibration a owl:Class ;
    rdfs:label "vibration"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:WhiteNoise a owl:Class ;
    rdfs:label "white noise"@en ;
    rdfs:subClassOf sophwn:Noise .

