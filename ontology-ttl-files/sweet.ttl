            owl:hasValue sostss:PlanetaryScale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        soph:Phenomena .

sophatmopc:AtmosphericPrecipitation a owl:Class ;
    rdfs:label "atmospheric precipitation"@en ;
    rdfs:subClassOf soph:Precipitation,
        sophatmo:AtmosphericPhenomena .

sophatmopc:Rainfall a owl:Class ;
    rdfs:label "rainfall"@en .

sophec:EcologicalPhenomena a owl:Class ;
    rdfs:label "ecological phenomena"@en ;
    rdfs:subClassOf soph:Phenomena .

sophfd:Flow a owl:Class ;
    rdfs:label "flow"@en ;
    rdfs:subClassOf sophfd:FluidPhenomena,
        soprocp:Motion .

sophg:GeologicalPhenomena a owl:Class ;
    rdfs:label "geological phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreag:SolidEarth ;
            owl:onProperty sorel:hasRealm ],
        soph:PlanetaryPhenomena ;
    owl:equivalentClass sophg:GeospherePhenomena .

sophgs:Earthquake a owl:Class ;
    rdfs:label "earthquake"@en ;
    rdfs:comment "Earthquakes are caused by energy release during rapid slippage along a fault. [Wikipedia]"@en ;
    rdfs:subClassOf sophgs:SeismicPhenomena .

sophgt:TectonicProcess a owl:Class ;
    rdfs:label "tectonic process"@en .

sophgv:VolcanicEruption a owl:Class ;
    rdfs:label "volcanic eruption"@en ;
    rdfs:comment "Moderate to violent ejection of solid or very viscous hot fragments of new lava in short-lived, cannon-like bursts. Ash and fine ash are emitted with gases and ascend to form a cauliflower-like eruption cloud."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasTransport ;
            owl:someValuesFrom soprope:Heat ],
        [ a owl:Restriction ;
            owl:onProperty sorelph:hasTransport ;
            owl:someValuesFrom sopropm:Mass ],
        sophgv:VolcanicActivity,
        sophr:Eruption .

sophhe:HeliosphericPhenomena a owl:Class ;
    rdfs:label "heliospheric phenomena"@en ;
    rdfs:subClassOf soph:Phenomena .

sophod:OceanCirculation a owl:Class ;
    rdfs:label "ocean circulation"@en ;
    rdfs:subClassOf sophfd:Circulation,
        sopho:OceanPhenomena .

soprop:ChemicalProperty a owl:Class ;
    rdfs:label "chemical property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelh:studyOf ;
            owl:someValuesFrom sohukd:Chemistry ],
        soprop:Property .

soprop:MotionProperty a owl:Class ;
    rdfs:label "motion property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelh:studyOf ;
            owl:someValuesFrom sohukd:Dynamics ],
        soprop:PhysicalProperty .

soprope:Heat a owl:Class ;
    rdfs:label "heat"@en ;
    rdfs:subClassOf soprope:Energy,
        sopropq:ThermodynamicQuantity ;
    owl:equivalentClass soprope:HeatEnergy,
        soprope:ThermalEnergy .

sopropi:EnvironmentalIndex a owl:Class ;
    rdfs:label "environmental index"@en ;
    rdfs:subClassOf sopropi:Index .

sopropm:Density a owl:Class ;
    rdfs:label "density"@en ;
    rdfs:comment "1. The ratio of the mass of any substance to the volume occupied by it (usually expressed in kilograms per cubic meter, but any other unit system may be used); the reciprocal of specific volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogramPerMeterCubed ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:IntensiveProperty ;
    owl:equivalentClass sopropm:MassConcentration .

sopropm:MassConcentration a owl:Class ;
    rdfs:label "mass concentration"@en .

sopropsh:Depth a owl:Class ;
    rdfs:label "depth"@en ;
    rdfs:subClassOf sopropsdis:Distance,
        sopropsh:VerticalExtent .

sopropsl:Location a owl:Class ;
