    rdfs:subClassOf sorepmso:Solution .

sorepmso:Expansion a owl:Class ;
    rdfs:label "expansion"@en ;
    rdfs:subClassOf sorepmso:Solution .

sorepmso:HeuristicAlgorithm a owl:Class ;
