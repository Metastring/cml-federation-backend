soreaofe:AgulhasCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "agulhas current"@en .

soreaofe:AntarcticCircumpolarCurrent a soreaofe:EarthOceanCurrent,
        owl:NamedIndividual ;
    rdfs:label "antarctic circumpolar current"@en .

soreaofe:ArcticOcean a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "arctic ocean"@en .

soreaofe:BenguelaCurrent a soreaofe:EarthEasternBoundaryCurrent,
        soreaofe:EarthOceanCurrent,
        owl:NamedIndividual ;
    rdfs:label "benguela current"@en .

soreaofe:BrazilCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "brazil current"@en .

soreaofe:CaliforniaCurrent a soreaofe:EarthEasternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "california current"@en .

soreaofe:CanaryCurrent a soreaofe:EarthEasternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "canary current"@en .

soreaofe:CaribbeanSea a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "caribbean sea"@en .

soreaofe:DeepOceanCurrent a soreaofe:EarthOceanCurrent,
        owl:NamedIndividual ;
    rdfs:label "deep ocean current"@en .

soreaofe:EastAustraliaCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "east australia current"@en .

soreaofe:GulfStream a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "gulf stream"@en .

soreaofe:IndianOcean a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "indian ocean"@en .

soreaofe:IndianOceanGyre a sophod:OceanGyre,
        owl:NamedIndividual ;
    rdfs:label "indian ocean gyre"@en .

soreaofe:KamchatkaCurrent a owl:Class ;
    rdfs:label "kamchatka current"@en ;
    rdfs:comment "The western part of the subpolar gyre in the deep (western) part of the Bering Sea."@en ;
    rdfs:subClassOf sophod:OceanCurrent .

soreaofe:KurishioCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "kurishio current"@en .

soreaofe:LabradorCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "labrador current"@en .

soreaofe:NorthAtlanticCurrent a soreaofe:EarthWesternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "north atlantic current"@en .

soreaofe:NorthAtlanticGyre a sophod:OceanGyre,
        owl:NamedIndividual ;
    rdfs:label "north atlantic gyre"@en .

soreaofe:NorthPacificGyre a sophod:OceanGyre,
        owl:NamedIndividual ;
    rdfs:label "north pacific gyre"@en .

soreaofe:PeruCurrent a soreaofe:EarthEasternBoundaryCurrent,
        owl:NamedIndividual ;
    rdfs:label "peru current"@en .

soreaofe:SouthAtlanticGyre a sophod:OceanGyre,
        owl:NamedIndividual ;
    rdfs:label "south atlantic gyre"@en .

soreaofe:SouthPacificGyre a sophod:OceanGyre,
        owl:NamedIndividual ;
    rdfs:label "south pacific gyre"@en .

soreaofe:SouthernOcean a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "southern ocean"@en .

soreaofe:YellowSeaWarmCurrent a owl:Class ;
    rdfs:label "yellow sea warm current"@en ;
    rdfs:comment "A surface current flowing northward along the central axis of the Yellow Sea."@en ;
    rdfs:subClassOf sophod:OceanCurrent .

soreaofe:m a soreaofe:OceanDepth,
        owl:NamedIndividual .

soreaofe:pt0million_km3 a soreaofe:OceanVolume,
        owl:NamedIndividual .

soreaofe:pt1million_km2 a soreaofe:OceanArea,
        owl:NamedIndividual .

soreaofe:pt2million_km2 a soreaofe:OceanArea,
        owl:NamedIndividual .

soreaofe:pt3million_km2 a soreaofe:OceanArea,
        owl:NamedIndividual .

soreaofe:pt4million_km2 a soreaofe:OceanArea,
        owl:NamedIndividual .

soreaofe:pt6million_km3 a soreaofe:OceanVolume,
        owl:NamedIndividual .

soreaofe:pt8million_km2 a soreaofe:OceanArea,
        owl:NamedIndividual .

soreaofl:AbyssalHill a owl:Class ;
    rdfs:label "abyssal hill"@en ;
    rdfs:subClassOf sorealo:Hill,
        soreaofl:SeaFloor .

soreaofl:AbyssalPlain a owl:Class ;
    rdfs:label "abyssal plain"@en ;
    rdfs:subClassOf soreal:Plain,
        soreaofl:SeaFloor .

soreaofl:AbyssalTrench a owl:Class ;
    rdfs:label "abyssal trench"@en ;
    owl:equivalentClass soreaofl:DeepSeaTrench .

