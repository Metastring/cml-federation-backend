sorepscd:Colatitude a sorepscd:HorizontalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "colatitude"@en ;
    sorelsp:hasDirection sorepsd:South .

sorepscd:Depth a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "depth"@en ;
    sorelsp:hasDirection sorepsd:Down .

sorepscd:Elevation a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "elevation"@en ;
    sorelsp:hasDirection sorepsd:Up ;
    owl:sameAs sorepscd:Height .

sorepscd:Equator a owl:Class ;
    rdfs:label "equator"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepscd:Pole ;
            owl:onProperty sorelsp:perpendicularTo ],
        sopropsdir:Direction .

sorepscd:HybridHeight a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "hybrid height"@en ;
    sorelsp:hasDirection sorepsd:Up .

sorepscd:HybridSigma a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "hybrid sigma"@en .

sorepscd:Latitude a sorepscd:HorizontalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "latitude"@en ;
    sorelsp:hasDirection sorepsd:North .

sorepscd:Level a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "level"@en .

sorepscd:NorthMagneticPole a sorepscd:MagneticPole,
        owl:NamedIndividual ;
    rdfs:label "north magnetic pole"@en ;
    sorelsp:hasDirection sorepsd:North .

sorepscd:NorthPole a sorepscd:Pole,
        owl:NamedIndividual ;
    rdfs:label "north pole"@en ;
    sorelsp:hasDirection sorepsd:North .

sorepscd:PotentialDensity a sorepscd:VerticalCoordinate,
