sorepsl:WalthersLaw a owl:Class ;
    rdfs:label "walthers law"@en ;
    rdfs:subClassOf sorepsl:EmpiricalLaw .

sorepsl:Z_RRelation a owl:Class ;
    rdfs:label "z-r relation"@en ;
    rdfs:comment "A relationship between radar reflectivity factor Z (mm6 m-3) and rain rate R (mm h-1)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Rainfall ;
            owl:onProperty sorel:hasPhenomena ],
        sorepsl:EmpiricalLaw .

