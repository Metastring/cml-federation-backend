    rdfs:label "organism"@en ;
    rdfs:subClassOf somab:LivingEntity .

somac:Compound a owl:Class ;
    rdfs:label "compound"@en ;
    rdfs:comment "A chemical compound is a pure chemical substance consisting of two or more different chemical elements[1][2][3] that can be separated into simpler substances by chemical reactions[4] and that have a unique and defined chemical structure. Chemical compounds consist of a fixed ratio of atoms[3] that are hold together in a defined spatial arrangement by chemical bonds. [Wikipedia]"@en ;
    rdfs:subClassOf soma:Chemical .

somael:H a somael:Element,
        somael:Nonmetal,
        owl:NamedIndividual ;
    rdfs:label "h"@en ;
    owl:sameAs somael:Hydrogen .

somael:NobleGas a owl:Class ;
    rdfs:label "noble gas"@en ;
    rdfs:subClassOf somael:Element .

somael:Nonmetal a owl:Class ;
    rdfs:label "nonmetal"@en ;
    rdfs:subClassOf somael:Element .

somael:Prictogen a owl:Class ;
    rdfs:label "prictogen"@en ;
    rdfs:subClassOf somael:Element .

somaeq:Communication a owl:Class ;
    rdfs:label "communication"@en ;
    rdfs:subClassOf sohu:HumanActivity ;
    owl:equivalentClass somaeq:Communications .

somaeq:CommunicationMethod a owl:Class ;
    rdfs:label "communication method"@en ;
    rdfs:subClassOf somaeq:Communication .

somanr:Coal a owl:Class ;
    rdfs:label "coal"@en ;
    rdfs:comment "Coal is a readily combustible black or brownish-black sedimentary rock. The harder forms, such as anthracite coal, can be regarded as metamorphic rock because of later exposure to elevated temperature and pressure. It is composed primarily of carbon along with variable quantities of other elements, chiefly sulfur, hydrogen, oxygen and nitrogen. [Wikipedia]"@en ;
    rdfs:subClassOf somanr:FossilFuel .

somaoc:Alkane a owl:Class ;
    rdfs:label "alkane"@en ;
    rdfs:subClassOf somaoc:Hydrocarbon .

<http://sweetontology.net/matrPlant> a owl:Ontology ;
    rdfs:label "SWEET Ontology Material Plant" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrBiomass>,
        <http://sweetontology.net/relaSci> ;
