sohukd:Mechanics a owl:Class ;
    rdfs:label "mechanics"@en ;
    rdfs:comment "Mechanics is the branch of physics concerned with the behaviour of physical bodies when subjected to forces or displacements, and the subsequent effect of the bodies on their environment."@en ;
    rdfs:subClassOf sohukd:Physics .

sohukd:Meteorology a owl:Class ;
    rdfs:label "meteorology"@en ;
