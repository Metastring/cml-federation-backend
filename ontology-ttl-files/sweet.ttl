sopropcha:ExchangeCapacity a owl:Class ;
    rdfs:label "exchange capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:perKilogramMole ;
            owl:onProperty sorelsc:hasDefaultUnit ],
