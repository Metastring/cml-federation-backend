sorepsp:ProvenanceElement a owl:Class ;
    rdfs:label "provenance element"@en ;
    rdfs:subClassOf sohur:ExperimentActivity .

sorepsu:ComplexUnit a owl:Class ;
    rdfs:label "complex unit"@en ;
    rdfs:subClassOf sorepsu:Unit .

sorepsu:candela a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "candela"@en ;
    sorelsc:hasSymbol "cd" ;
    skos:notation "cd"^^qudt:UCUMcs .

sorepsu:coulomb a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "coulomb"@en ;
    sorelm:hasOperand sorepsu:ampere,
        sorepsu:second ;
    sorelsc:hasSymbol "C" ;
    skos:notation "C"^^qudt:UCUMcs .

sorepsu:hertz a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "hertz"@en ;
    sorelsc:hasSymbol "Hz" ;
    owl:sameAs sorepsu:perSecond ;
    skos:notation "Hz"^^qudt:UCUMcs .

sorepsu:kelvin a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "kelvin"@en ;
    sorelsc:hasSymbol "K" ;
    skos:notation "K"^^qudt:UCUMcs .

sorepsu:meterCubed a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "meter cubed"@en ;
    sorelm:toThePower 3.0 ;
    sorelsc:hasBaseUnit sorepsu:meter ;
    skos:notation "m3"^^qudt:UCUMcs .

sorepsu:wattPerMeterSquared a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "watt per meter squared"@en ;
    sorelm:hasOperand sorepsu:perMeterSquared,
        sorepsu:watt ;
    skos:notation "W/m2"^^qudt:UCUMcs .

soreps:Space a owl:Class ;
    rdfs:label "space"@en ;
    rdfs:comment "This concept is of space as an independent variable"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sorep:Dimension .

sorepsd:Down a sopropsdir:VerticalDirection,
        owl:NamedIndividual ;
    rdfs:label "down"@en ;
    owl:sameAs sorepsd:Downward .

sorepsg:Cluster a owl:Class ;
    rdfs:label "cluster"@en ;
    rdfs:subClassOf sorepm:Collection ;
    owl:equivalentClass sorepsg:Family,
        sorepsg:Swarm .

sorepsg:ConicSection a owl:Class ;
    rdfs:label "conic section"@en .

sostc:Acid a sostc:ChemicalState,
        owl:NamedIndividual ;
    rdfs:label "acid"@en ;
    rdfs:comment "An acid as a compound which donates a hydrogen ion (H+) to another compound (called a base). [Wikipedia]"@en .

<http://sweetontology.net/stateRoleGeographic> a owl:Ontology ;
    rdfs:label "SWEET Ontology State Role Geographic" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/humanCommerce>,
        <http://sweetontology.net/prop> ;
    owl:versionInfo "3.6.0" .

sostri:Strong a sopropo:Impact,
        owl:NamedIndividual ;
    rdfs:label "strong"@en ;
    sorelph:strongerThan sostri:Moderate .

sostss:Microscale a sopropo:SpatialScale,
        owl:NamedIndividual ;
    rdfs:label "microscale"@en ;
    sorelsp:largerScaleThan sostss:AtomicScale .

sostst:SaffirSimpsonScale a owl:Class ;
    rdfs:label "saffir simpson scale"@en ;
    rdfs:subClassOf sostst:HurricaneScale .

<http://sweetontology.net/stateTime> a owl:Ontology ;
    rdfs:label "SWEET Ontology State Time" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propOrdinal>,
        <http://sweetontology.net/propTime>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/relaTime>,
        <http://sweetontology.net/reprSciUnits>,
        <http://sweetontology.net/reprTime> ;
    owl:versionInfo "3.6.0" .

sostti:Eon a owl:Class ;
    rdfs:label "eon"@en ;
    rdfs:comment "Supereons are divided into eons.  [billions of years] [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelt:temporalPartOf ;
            owl:someValuesFrom sostti:Supereon ],
        sostti:GeologicTimeUnit .

sostv:Opaque a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "opaque"@en .

sohuc:Management a owl:Class ;
    rdfs:label "management"@en ;
    rdfs:subClassOf sohu:HumanActivity .

sohues:EnvironmentalStandardsBody a owl:Class ;
    rdfs:label "environmental standards body"@en ;
    rdfs:subClassOf sohuj:StandardsBody .

sohukd:Geology a owl:Class ;
    rdfs:label "geology"@en ;
    rdfs:subClassOf sohukd:Science .

sohukd:Physics a owl:Class ;
    rdfs:label "physics"@en ;
    rdfs:subClassOf sohukd:Science .

sohukd:Science a owl:Class ;
    rdfs:label "science"@en ;
    rdfs:subClassOf sohukd:KnowledgeDomain .

sohur:ResearchSetting a owl:Class ;
    rdfs:label "research setting"@en ;
    rdfs:subClassOf sohur:Research .

soma:ChemicalSubstance a owl:Class ;
    rdfs:label "chemical substance"@en .

soma:SuspendedSubstance a owl:Class ;
    rdfs:label "suspended substance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Suspended ;
            owl:onProperty sorel:hasState ],
        soma:Substance .

soman:MarineAnimal a owl:Class ;
    rdfs:label "marine animal"@en ;
    rdfs:subClassOf soman:Animal .

somaf:AirportFacility a owl:Class ;
    rdfs:label "airport facility"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohut:AirTraffic ;
            owl:onProperty sorelh:hasHumanActivity ],
        somaf:Facility .

<http://sweetontology.net/matrParticle> a owl:Ontology ;
    rdfs:label "SWEET Ontology Material Particle" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/statePhysical>,
        <http://sweetontology.net/stateSpaceScale> ;
    owl:versionInfo "3.6.0" .

somapl:PlantPart a owl:Class ;
    rdfs:label "plant part"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapl:Plant ;
            owl:onProperty sorelsc:componentOf ],
        somab:LivingEntity .

sophatmol:Lightning a owl:Class ;
    rdfs:label "lightning"@en ;
    rdfs:comment "Lightning is a transient, high-current electric discharge with pathlengths measured in kilometers. The most common source of lightning is the electric charge separated in ordinary thunderstorm clouds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sopropcha:ElectricPotential ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophatmol:Thunder ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmo:MeteorologicalPhenomena .

<http://sweetontology.net/phenAtmoWind> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Wind" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrAerosol>,
        <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/phenFluidDynamics>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/propPressure>,
        <http://sweetontology.net/propSpaceDirection>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaSci> ;
    owl:versionInfo "3.6.0" .

sophb:Disease a owl:Class ;
    rdfs:label "disease"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophcm:BiogeochemicalCycle a owl:Class ;
    rdfs:label "biogeochemical cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophec:EcologicalPhenomena ;
            owl:onProperty sorel:hasPhenomena ],
        sophcm:MaterialCycle .

sophei:OceanEnvironmentalImpact a owl:Class ;
    rdfs:label "ocean environmental impact"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasImpactOn ;
            owl:someValuesFrom sorea:Ocean ],
        sophei:EnvironmentalImpact .

sophgf:Slip a owl:Class ;
    rdfs:label "slip"@en ;
    rdfs:subClassOf soprocp:Motion .

sophhy:HydrospherePhenomena a owl:Class ;
    rdfs:label "hydrosphere phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Hydrosphere ;
            owl:onProperty sorel:hasRealm ],
        soph:PlanetaryPhenomena .

sophhy:WaterFlow a owl:Class ;
    rdfs:label "water flow"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:Water ;
            owl:onProperty sorelch:hasSubstance ],
        sophfd:Flow .

<http://sweetontology.net/phenMixing> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Mixing" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/phen>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/procStateChange>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical> ;
    owl:versionInfo "3.6.0" .

sophst:CoronalPhenomena a owl:Class ;
    rdfs:label "coronal phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaas:Corona ;
            owl:onProperty sorel:hasRealm ],
        sophst:StellarPhenomena .

sophst:SolarPhenomena a owl:Class ;
    rdfs:label "solar phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sophst:Sun ;
            owl:onProperty sorelph:hasAstronomicalBody ],
        sophst:StellarPhenomena .

<http://sweetontology.net/procStateChange> a owl:Ontology ;
    rdfs:label "SWEET Ontology Process State Change" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
