soprocp:ElectromagneticInduction a owl:Class ;
    rdfs:label "electromagnetic induction"@en ;
    rdfs:subClassOf soprocp:ElectromagneticProcess ;
    owl:equivalentClass soprocp:Induction .

soprocp:Expanding a owl:Class ;
