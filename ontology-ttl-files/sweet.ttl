    rdfs:subClassOf soprocp:Orbit .

soprocp:Insulation a owl:Class ;
    rdfs:label "insulation"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:IonizingRadiation a owl:Class ;
