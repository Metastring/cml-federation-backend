        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/stateRole>,
        <http://sweetontology.net/stateRoleImpact> ;
    owl:versionInfo "3.6.0" .

sophr:Emission a owl:Class ;
    rdfs:label "emission"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostro:ByProduct ;
            owl:onProperty sorel:hasRole ],
        soprocc:ChemicalReaction .

sophr:Leak a owl:Class ;
    rdfs:label "leak"@en ;
    rdfs:subClassOf sophr:Release .

sophso:PoreSpace a owl:Class ;
    rdfs:label "pore space"@en .

sophso:Stretch a owl:Class ;
    rdfs:label "stretch"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Subsidence a owl:Class ;
    rdfs:label "subsidence"@en .

sophst:SolarActivity a owl:Class ;
    rdfs:label "solar activity"@en ;
    rdfs:subClassOf sophst:SolarPhenomena .

sophsy:Accumulation a owl:Class ;
    rdfs:label "accumulation"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsy:Decrease a owl:Class ;
    rdfs:label "decrease"@en ;
    rdfs:subClassOf sophsy:SystemStateChange ;
    owl:equivalentClass sophsy:Drop,
        sophsy:Fall,
        sophsy:Reduction .

sophsy:Displacement a owl:Class ;
    rdfs:label "displacement"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Exchange a owl:Class ;
    rdfs:label "exchange"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Removal a owl:Class ;
    rdfs:label "removal"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Evolution a owl:Class ;
    rdfs:label "evolution"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Feedback a owl:Class ;
    rdfs:label "feedback"@en ;
    rdfs:subClassOf sophsyc:SelfRegulation .

sophw:FluidWave a owl:Class ;
    rdfs:label "fluid wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Fluid ;
            owl:onProperty sorel:hasState ],
        sophw:Wave .

sophw:InertialWave a owl:Class ;
    rdfs:label "inertial wave"@en .

sophw:LongitudinalWave a owl:Class ;
    rdfs:label "longitudinal wave"@en ;
    rdfs:comment "Longitudinal waves are waves that have vibrations along or parallel to their direction of travel. They include waves in which the motion of the medium is in the same direction as the motion of the wave. Mechanical longitudinal waves have been also referred to as compressional waves or pressure waves"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Parallel ;
            owl:onProperty sorelph:hasOscillationDirection ],
        sophw:Wave .

sophw:Sound a owl:Class ;
    rdfs:label "sound"@en .

sophw:SoundWave a owl:Class ;
    rdfs:label "sound wave"@en .

sophw:WavePhenomena a owl:Class ;
    rdfs:label "wave phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophw:Wave ],
        soph:Phenomena .

soprocc:Absorption a owl:Class ;
    rdfs:label "absorption"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:NuclearFusion a owl:Class ;
    rdfs:label "nuclear fusion"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Photolysis a owl:Class ;
    rdfs:label "photolysis"@en ;
    rdfs:comment "Photodissociation, photolysis, or photodecomposition is a chemical reaction in which a chemical compound is broken down by photons. It is defined as the interaction of one or more photons with one target molecule. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocc:Absorption ;
            owl:onProperty sorel:hasProcess ],
        soprocc:ChemicalProcess .

soprocp:CoriolisForce a owl:Class ;
    rdfs:label "coriolis force"@en ;
    rdfs:subClassOf soproc:Force,
        soprocp:Deflection .

soprocp:ElectricCurrent a owl:Class ;
    rdfs:label "electric current"@en .

soprocp:Expansion a owl:Class ;
    rdfs:label "expansion"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Magnetism a owl:Class ;
    rdfs:label "magnetism"@en ;
    rdfs:subClassOf soprocp:ElectromagneticProcess .

soprocp:Motion a owl:Class ;
    rdfs:label "motion"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:RadiativeTransfer a owl:Class ;
    rdfs:label "radiative transfer"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:ViscousForce a owl:Class ;
    rdfs:label "viscous force"@en ;
    rdfs:comment "The transport of mass motion momentum solely by the random motions of individual molecules not moving together in coherent groups."@en ;
    rdfs:subClassOf soprocp:Friction .

soprocsc:Evaporation a owl:Class ;
    rdfs:label "evaporation"@en ;
    rdfs:subClassOf soprocsc:Vaporization .

soprocsc:Vaporization a owl:Class ;
    rdfs:label "vaporization"@en ;
    rdfs:comment "The physical process by which a liquid is transformed to the gaseous state; the opposite of condensation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Liquid ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocw:WavePropagation a owl:Class ;
    rdfs:label "wave propagation"@en .

sopropb:BinaryProperty a owl:Class ;
    rdfs:label "binary property"@en ;
    rdfs:subClassOf soprop:Property,
        sorepmf:BinaryFunction .

sopropcat:Classification a owl:Class ;
    rdfs:label "classification"@en .

sopropcha:MagneticMoment a owl:Class ;
    rdfs:label "magnetic moment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerTesla ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:VectorQuantity .

sopropche:BiologicalOxygenDemand a owl:Class ;
    rdfs:label "biological oxygen demand"@en ;
    rdfs:subClassOf sopropche:OxygenDemand .

sopropche:Composition a owl:Class ;
    rdfs:label "composition"@en ;
    rdfs:subClassOf soprop:ChemicalProperty .

sopropche:Moisture a owl:Class ;
    rdfs:label "moisture"@en ;
    rdfs:subClassOf sopropche:WaterConcentration .

sopropche:OxygenDemand a owl:Class ;
    rdfs:label "oxygen demand"@en ;
    rdfs:subClassOf sopropm:Density .

sopropcon:ElectricalConductivity a owl:Class ;
    rdfs:label "electrical conductivity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:siemensPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcon:Conductivity,
        sopropq:ElectromagneticQuantity .

<http://sweetontology.net/propCount> a owl:Ontology ;
    rdfs:label "SWEET Ontology Property Count" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
