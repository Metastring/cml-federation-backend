soreaer:EarthCrust a soreag:Crust,
        owl:NamedIndividual ;
    rdfs:label "earth crust"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthDLayer a soreaah:DLayer,
        owl:NamedIndividual ;
    rdfs:label "earth d layer"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthELayer a soreaah:ELayer,
        owl:NamedIndividual ;
    rdfs:label "earth e layer"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthExosphere a soreaah:Exosphere,
        owl:NamedIndividual ;
    rdfs:label "earth exosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthFLayer a soreaah:FLayer,
        owl:NamedIndividual ;
    rdfs:label "earth f layer"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthGeosphere a sorea:Geosphere,
        owl:NamedIndividual ;
    rdfs:label "earth geosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthIonosphere a soreaah:Ionosphere,
        owl:NamedIndividual ;
    rdfs:label "earth ionosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthLithosphere a soreag:Lithosphere,
        owl:NamedIndividual ;
    rdfs:label "earth lithosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthMesopelagicZone a soreao:MesopelagicZone,
        owl:NamedIndividual ;
    rdfs:label "earth mesopelagic zone"@en ;
