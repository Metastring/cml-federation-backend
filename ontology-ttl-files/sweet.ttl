soreaer:EarthPhoticZone a soreao:PhoticZone,
        owl:NamedIndividual ;
    rdfs:label "earth photic zone"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthStratosphere a soreaa:Stratosphere,
        owl:NamedIndividual ;
    rdfs:label "earth stratosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthThermosphere a soreaa:Thermosphere,
        owl:NamedIndividual ;
    rdfs:label "earth thermosphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

soreaer:EarthTroposphere a soreaa:Troposphere,
        owl:NamedIndividual ;
    rdfs:label "earth troposphere"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

