sosttc:ElNino a owl:Class ;
    rdfs:label "el nino"@en ;
    rdfs:comment "A significant increase in sea surface temperature over the eastern and central equatorial Pacific that occurs at irregular intervals, generally ranging between two and seven years."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
            owl:someValuesFrom sophcy:ENSO ],
        sosttc:OscillationState .

sosttc:IceAge a owl:Class ;
    rdfs:label "ice age"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
            owl:someValuesFrom sophcy:IceAgeCycle ],
        sosttc:OscillationState .

sosttc:Interglacial a owl:Class ;
    rdfs:label "interglacial"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:minimumOf ;
            owl:someValuesFrom sophcy:IceAgeCycle ],
        sosttc:OscillationState .

sosttc:LaNina a owl:Class ;
    rdfs:label "la nina"@en ;
    rdfs:comment "The most common of several names given toa significant decrease in sea surface temperature (‘cold events’) in the central and eastern equatorial Pacific.  La Nina is the counterpart to the El Nino ‘warm event,’ and its spatial and temporal evolution in the equatorial Pacific is, to a considerable extent, the mirror image of El Nino, although La Nina events tend to be somewhat less regular in their behavior and duration."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:minimumOf ;
            owl:someValuesFrom sophcy:ENSO ],
        sosttc:OscillationState .

sosttc:MaunderMinimum a owl:Class ;
    rdfs:label "maunder minimum"@en ;
    rdfs:subClassOf sosttc:SolarMinimum .

sosttc:NeapTide a owl:Class ;
    rdfs:label "neap tide"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
            owl:someValuesFrom sosttc:LowTide ],
        [ a owl:Restriction ;
            owl:onProperty sorelm:minimumOf ;
            owl:someValuesFrom sosttc:HighTide ],
        sosttc:OscillationState .

sosttc:SolarMaximum a owl:Class ;
    rdfs:label "solar maximum"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
            owl:someValuesFrom sophcy:SolarCycle ],
        sosttc:OscillationState .

sosttc:SpringTide a owl:Class ;
    rdfs:label "spring tide"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
            owl:someValuesFrom sosttc:HighTide ],
        [ a owl:Restriction ;
            owl:onProperty sorelm:minimumOf ;
            owl:someValuesFrom sosttc:LowTide ],
        sosttc:OscillationState .

sosttf:Accidental a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "accidental"@en .

sosttf:Biweekly a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "biweekly"@en ;
    sorelt:hasPeriod sostti:week .

sosttf:Common a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "common"@en ;
    sorelt:moreFrequentThan sosttf:Rare .

sosttf:Consistent a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "consistent"@en .

sosttf:Episodic a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "episodic"@en .

