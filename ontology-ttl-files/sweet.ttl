        owl:NamedIndividual ;
    rdfs:label "erratic"@en .

sosttf:Frequent a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "frequent"@en ;
    sorelt:moreFrequentThan sosttf:Infrequent,
        sosttf:Rare .

sosttf:Hourly a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "hourly"@en ;
    sorelt:hasPeriod sostti:hour .

sosttf:Monthly a soproptf:Frequency,
        owl:NamedIndividual ;
