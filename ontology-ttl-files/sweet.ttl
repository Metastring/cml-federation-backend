sorepsp:InferenceRule a owl:Class ;
    rdfs:label "inference rule"@en ;
    rdfs:subClassOf sorepsp:ProvenanceElement .

sorepsu:kilometer a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "kilometer"@en ;
    sorelm:hasScalingNumber 1000.0 ;
    sorelsc:hasBaseUnit sorepsu:meter ;
    sorelsc:hasPrefix sorepsu:kilo ;
    skos:notation "km"^^qudt:UCUMcs .

sorepsu:meterPerSecond a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "meter per second"@en ;
    sorelm:hasOperand sorepsu:meter,
        sorepsu:perSecond ;
    skos:notation "m/s"^^qudt:UCUMcs .

sorepsu:newton a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "newton"@en ;
    sorelm:hasOperand sorepsu:kilogram,
        sorepsu:meter,
        sorepsu:perSecondSquared ;
    sorelsc:hasSymbol "N" ;
    skos:notation "N"^^qudt:UCUMcs .

sorepsu:pascal a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "pascal"@en ;
    sorelm:hasOperand sorepsu:newton,
        sorepsu:perMeterSquared ;
    sorelsc:hasSymbol "Pa" ;
    skos:notation "Pa"^^qudt:UCUMcs .

sorepsu:perMeterCubed a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per meter cubed"@en ;
    sorelm:toThePower -3.0 ;
    sorelsc:hasBaseUnit sorepsu:meter ;
    skos:notation "/m3"^^qudt:UCUMcs .

sorepscd:Pole a owl:Class ;
    rdfs:label "pole"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sorepsd:North a sopropsdir:HorizontalDirection,
        owl:NamedIndividual ;
    rdfs:label "north"@en ;
    sorelsp:oppositeTo sorepsd:South ;
    owl:sameAs sorepsd:Northward .

sorepsd:South a sopropsdir:HorizontalDirection,
        owl:NamedIndividual ;
    rdfs:label "south"@en ;
    owl:sameAs sorepsd:Southward .

sorepsg:Point a owl:Class ;
    rdfs:label "point"@en ;
    rdfs:subClassOf sorepsg:GeometricalObject_0D .

sorepsg:Surface a owl:Class ;
    rdfs:label "surface"@en ;
