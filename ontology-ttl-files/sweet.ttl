<http://sweetontology.net/humanJurisdiction> a owl:Ontology ;
    rdfs:label "SWEET Ontology Human Jurisdiction" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/human>,
        <http://sweetontology.net/relaHuman>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/repr>,
        <http://sweetontology.net/reprSpaceGeometry> ;
    owl:versionInfo "3.6.0" .

sohukd:PlanetaryScience a owl:Class ;
    rdfs:label "planetary science"@en ;
    rdfs:comment "Planetary science, also known as planetology and closely related to planetary astronomy, is the science of planets, or planetary systems, and the solar system. [Wikipedia]"@en ;
    rdfs:subClassOf sohukd:Science ;
    owl:equivalentClass sohukd:Planetology .

soma:DissolvedSubstance a owl:Class ;
    rdfs:label "dissolved substance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Dissolved ;
            owl:onProperty sorel:hasState ],
        soma:Substance .

somaae:Particulate a owl:Class ;
    rdfs:label "particulate"@en ;
    rdfs:comment "The term for solid or liquid particles found in a gas.   Some particles are large or dark enough to be seen as soot or smoke."@en ;
    rdfs:subClassOf soma:SuspendedSubstance .

somab:Species a owl:Class ;
    rdfs:label "species"@en ;
    rdfs:subClassOf somab:Organism .

somael:Halogen a owl:Class ;
    rdfs:label "halogen"@en ;
    rdfs:subClassOf somael:Element .

<http://sweetontology.net/matrElementalMolecule> a owl:Ontology ;
    rdfs:label "SWEET Ontology Material Elemental Molecule" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrElement>,
        <http://sweetontology.net/relaChemical> ;
    owl:versionInfo "3.6.0" .

somaen:EnergyCollector a owl:Class ;
    rdfs:label "energy collector"@en ;
    rdfs:subClassOf somaeq:Infrastructure .

somaen:EnergyStorage a owl:Class ;
    rdfs:label "energy storage"@en ;
    rdfs:subClassOf sorepsc:Storage .

somaeq:CommunicationsEquipment a owl:Class ;
    rdfs:label "communications equipment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaeq:Communications ;
            owl:onProperty sorelh:hasHumanActivity ],
        somaeq:Equipment .

somaf:Structure a owl:Class ;
    rdfs:label "structure"@en ;
    rdfs:subClassOf somaeq:Infrastructure .

somaind:Product a owl:Class ;
    rdfs:label "product"@en ;
    rdfs:subClassOf somaeq:MaterialThing .

somamic:Bacteria a owl:Class ;
    rdfs:label "bacteria"@en ;
    rdfs:subClassOf somamic:MicrobiotaTaxonomy .

somaoc:HCFC a owl:Class ;
    rdfs:label "hcfc"@en ;
    rdfs:subClassOf somaoc:CFC ;
    owl:equivalentClass somaoc:Hydrochlorofluorocarbon .

somarocki:Lava a owl:Class ;
    rdfs:label "lava"@en ;
    rdfs:comment "Magma that extrudes onto the surface of earth is called lava.  [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:VolcanicRock .

somaw:SaltWater a owl:Class ;
    rdfs:label "salt water"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Saline ;
            owl:onProperty sorel:hasState ],
        somaw:WaterSubstance .

sophatmo:AtmosphericWave a owl:Class ;
    rdfs:label "atmospheric wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Atmosphere ;
            owl:onProperty sorel:hasRealm ],
        sophw:FluidWave .

sophatmoc:Stratiform a owl:Class ;
    rdfs:label "stratiform"@en ;
    rdfs:subClassOf sophatmoc:Cloud .

<http://sweetontology.net/phenAtmoFog> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Fog" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrCompound>,
        <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/matrWater>,
        <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenAtmoCloud>,
        <http://sweetontology.net/phenAtmoFront>,
        <http://sweetontology.net/phenAtmoPrecipitation>,
        <http://sweetontology.net/phenAtmoWindMesoscale>,
        <http://sweetontology.net/phenFluidTransport>,
        <http://sweetontology.net/phenMixing>,
        <http://sweetontology.net/procStateChange>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmLandCoastal>,
        <http://sweetontology.net/realmLandOrographic>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

sophatmopc:Snowfall a owl:Class ;
    rdfs:label "snowfall"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:Snow ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmopc:AtmosphericPrecipitation .

sophatmopc:Tornado a owl:Class ;
    rdfs:label "tornado"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        sophatmopc:Storm .

sophatmops:AtmosphericCyclone a owl:Class ;
    rdfs:label "atmospheric cyclone"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:Cyclone .

sophatmops:AtmosphericLowPressure a owl:Class ;
    rdfs:label "atmospheric low pressure"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:LowPressure .

sophatmowm:Foehn a owl:Class ;
    rdfs:label "foehn"@en ;
    rdfs:comment "A warm, dry, downslope wind descending the lee side of the Alps as a result of synoptic-scale, cross-barrier flow over the mountain range."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Heating ;
            owl:onProperty sorel:hasProcess ],
        sophatmowm:MountainWind .

sophatmowm:SeaBreeze a owl:Class ;
    rdfs:label "sea breeze"@en ;
    rdfs:comment "A coastal local wind that blows from sea to land, caused by the temperature difference when the sea surface is colder than the adjacent land."@en ;
    rdfs:subClassOf sophatmowm:OnshoreWind .

sophcy:Tide a owl:Class ;
    rdfs:label "tide"@en ;
    rdfs:subClassOf sophcy:PlanetaryOscillation .

sophen:RenewableEnergySource a owl:Class ;
    rdfs:label "renewable energy source"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuecons:Sustainability ;
            owl:onProperty sorel:hasRole ],
        sophen:EnergySource .

sophei:LandEnvironmentalImpact a owl:Class ;
    rdfs:label "land environmental impact"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasImpactOn ;
            owl:someValuesFrom sorea:Land ],
        sophei:EnvironmentalImpact .

sophfd:Circulation a owl:Class ;
    rdfs:label "circulation"@en ;
    rdfs:subClassOf sophfd:Flow .

sophft:Advection a owl:Class ;
    rdfs:label "advection"@en ;
    rdfs:comment "The process of transport solely by the mass motion (velocity field); also, the rate of change of the value of the advected property at a given point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophft:Transport ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Fluid ;
            owl:onProperty sorel:hasState ],
        soph:Phenomena .

sophft:Plume a owl:Class ;
    rdfs:label "plume"@en ;
    rdfs:comment "Buoyant jet in which the buoyancy is supplied from a point source; the buoyant region is continuous. 2. A mostly horizontal (sometimes initially vertical) stream of pollutant that is being blown downwind from a smokestack."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Fluid ;
            owl:onProperty sorel:hasState ],
        soma:SuspendedSubstance .

<http://sweetontology.net/phenGeolGeomorphology> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Geologic Geomorphology" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrCompound>,
