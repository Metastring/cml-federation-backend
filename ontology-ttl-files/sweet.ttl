sophsy:System a owl:Class ;
    rdfs:label "system"@en ;
    rdfs:comment "System is a set of interacting or interdependent entities, real or abstract, forming an integrated whole."@en ;
    rdfs:subClassOf sorepsmo:Model .

sophsy:Vacillation a owl:Class ;
    rdfs:label "vacillation"@en ;
    rdfs:comment "Oscillation, usually of a small amplitude, about a reference state."@en ;
    rdfs:subClassOf sophsy:Oscillation .

sophsy:Variability a owl:Class ;
    rdfs:label "variability"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Cascade a owl:Class ;
    rdfs:label "cascade"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsyc:Decay a owl:Class ;
    rdfs:label "decay"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Decouple a owl:Class ;
    rdfs:label "decouple"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Development a owl:Class ;
    rdfs:label "development"@en ;
    rdfs:subClassOf sophsyc:Evolution .

sophsyc:Dissipate a owl:Class ;
    rdfs:label "dissipate"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Emergence a owl:Class ;
    rdfs:label "emergence"@en ;
    owl:equivalentClass sophsyc:Emergent .

sophsyc:ErrorPropagation a owl:Class ;
    rdfs:label "error propagation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Maturation a owl:Class ;
    rdfs:label "maturation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:NegativeFeedback a owl:Class ;
    rdfs:label "negative feedback"@en ;
    rdfs:subClassOf sophsyc:Feedback ;
    owl:disjointWith sophsyc:PositiveFeedback .

sophsyc:Recharge a owl:Class ;
    rdfs:label "recharge"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Resilience a owl:Class ;
    rdfs:label "resilience"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsyc:Signature a owl:Class ;
    rdfs:label "signature"@en ;
    rdfs:subClassOf sophsyc:Pattern .

sophsyc:Synergy a owl:Class ;
    rdfs:label "synergy"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsyc:SystemDynamics a owl:Class ;
    rdfs:label "system dynamics"@en ;
    rdfs:comment "System dynamics is an approach to understanding the behaviour of complex systems over time. It deals with internal feedback loops and time delays that affect the behaviour of the entire system. What makes using system dynamics different from other approaches to studying complex systems is the use of feedback loops and stocks and flows. These elements help describe how even seemingly simple systems display baffling nonlinearity"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsyc:Transformation a owl:Class ;
    rdfs:label "transformation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange ;
    owl:equivalentClass sophsyc:Transforming .

sophw:Acoustic a owl:Class ;
    rdfs:label "acoustic"@en ;
    owl:equivalentClass sophw:AcousticWave .

sophw:AcousticGravityWave a owl:Class ;
    rdfs:label "acoustic gravity wave"@en ;
    rdfs:comment "A wave disturbance with restoring forces that include buoyancy and the elastic compressibility of the fluid medium."@en ;
    rdfs:subClassOf sophw:AcousticWave,
        sophw:GravityWave .

sophw:AlfvenWave a owl:Class ;
    rdfs:label "alfven wave"@en ;
    rdfs:subClassOf sophw:PlasmaWave .

sophw:CapillaryWave a owl:Class ;
    rdfs:label "capillary wave"@en ;
    rdfs:subClassOf sophw:Wave .

sophw:CompressionWave a owl:Class ;
    rdfs:label "compression wave"@en ;
    rdfs:subClassOf sophw:LongitudinalWave .

sophw:GravitationalWave a owl:Class ;
    rdfs:label "gravitational wave"@en ;
    owl:equivalentClass sophw:GravityWave .

sophw:HelmholtzWave a owl:Class ;
    rdfs:label "helmholtz wave"@en ;
    rdfs:comment "An unstable wave in a system of two homogeneous fluids with a velocity discontinuity at the interface."@en ;
    rdfs:subClassOf sophw:GravityWave .

sophw:InertiaWave a owl:Class ;
    rdfs:label "inertia wave"@en ;
    rdfs:comment "1. Any wave motion in which no form of energy other than kinetic energy is present. In this general sense, Helmholtz waves, barotropic disturbances, Rossby waves, etc., are inertia waves. 2. More restrictedly, a wave motion in which the source of kinetic energy of the disturbance is the rotation of the fluid about some given axis. In the atmosphere a westerly wind system is such a source, the inertia waves here being, in general, stable. A similar analysis has been applied to smaller vortices, such as the hurricane. See inertial instability"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasRestoringForce ;
            owl:someValuesFrom soprocp:CoriolisForce ],
        sophw:InternalWave ;
    owl:equivalentClass sophw:InertialWave .

sophw:InternalGravityWave a owl:Class ;
    rdfs:label "internal gravity wave"@en ;
    rdfs:comment "A wave that propagates in density-stratified fluid under the influence of buoyancy forces."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasState ;
            owl:someValuesFrom sophfi:StaticStability ],
        sophw:GravityWave,
        sophw:InternalWave ;
    owl:equivalentClass sophw:InternalWave .

sophw:KelvinHelmholtzWave a owl:Class ;
    rdfs:label "kelvin helmholtz wave"@en ;
    rdfs:comment "A waveform disturbance that arises from Kelvin?Helmholtz instability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:KelvinHelmholtzInstability ;
            owl:onProperty sorel:hasState ],
        sophw:GravityWave .

sophw:KelvinWave a owl:Class ;
    rdfs:label "kelvin wave"@en ;
    rdfs:comment "A type of low-frequency gravity wave trapped to a vertical boundary, or the equator, which propagates anticlockwise (in the Northerm Hemisphere) around a basin."@en ;
    rdfs:subClassOf sophw:GravityWave .

sophw:LongCrestedWave a owl:Class ;
    rdfs:label "long crested wave"@en ;
    rdfs:comment "Ocean surface waves that are nearly two-dimensional, in that the crests appear very long in comparison with the wavelength, and the energy propagation is concentrated in a narrow band around the mean wave direction."@en ;
    rdfs:subClassOf sophw:SurfaceWave .

sophw:MagnetohydrodynamicWave a owl:Class ;
    rdfs:label "magnetohydrodynamic wave"@en ;
    rdfs:subClassOf sophw:PlasmaWave .

sophw:PlanetaryWave a owl:Class ;
    rdfs:label "planetary wave"@en ;
    owl:equivalentClass sophw:RossbyWave .

sophw:RayleighWave a owl:Class ;
    rdfs:label "rayleigh wave"@en ;
    rdfs:comment "Rayleigh waves, also called ground roll, are surface waves that travel as ripples similar to those on the surface of water. The existence of these waves was predicted by John William Strutt, Lord Rayleigh, in 1885. They are slower than body waves, roughly 70% of the velocity of S waves, and have been asserted to be visible during an earthquake in an open space like a parking lot where the cars move up and down with the waves. Reports among seismologists suggest that the apparent motion may be due to distortion of the human eye during shaking. Anecdotally, placing people on shake tables causes the room to appear to ripple. In any case, waves of the reported amplitude, wavelength, and velocity of the visible waves have never been recorded instrumentally."@en ;
    rdfs:subClassOf sophw:AcousticWave,
        sophw:SolidWave,
        sophw:SurfaceWave .

sophw:Seiche a owl:Class ;
    rdfs:label "seiche"@en ;
    rdfs:comment "A seiche is a standing wave in an enclosed or partially enclosed body of water. Seiches and seiche-related phenomena have been observed on lakes, reservoirs, bays and seas. The key requirement for formation of a seiche is that the body of water be at least partially bounded, allowing natural phenomena to form a standing wave."@en ;
    rdfs:subClassOf sophw:StandingWave .

sophw:ShallowWaterWave a owl:Class ;
    rdfs:label "shallow water wave"@en ;
    rdfs:comment "An ocean wave with its length sufficiently large compared to the water depth (i.e., 25 or more times the depth)"@en ;
    rdfs:subClassOf sophw:GravityWave .

sophw:ShockWave a owl:Class ;
    rdfs:label "shock wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophsyc:Shock ;
            owl:onProperty sorel:hasPhenomena ],
        sophw:Wave .

sophw:ShortWave a owl:Class ;
    rdfs:label "short wave"@en ;
    rdfs:comment "With regard to atmospheric circulation, a progressive wave in the horizontal pattern of air motion with dimensions of cyclonic scale, as distinguished from a long wave."@en ;
    rdfs:subClassOf sophw:Wave .

sophw:TopographicWave a owl:Class ;
    rdfs:label "topographic wave"@en ;
    rdfs:comment "Waves with a restoring force arising from variations in depth. The stretching or compression of displaced columns of water generates anomalous vorticity tending to drive them back to their original position."@en ;
    rdfs:subClassOf sophw:GravityWave .

sophw:Whistler a owl:Class ;
    rdfs:label "whistler"@en ;
    rdfs:subClassOf sophw:PlasmaWave,
        sophw:SoundWave .

sophwn:AmbientNoise a owl:Class ;
    rdfs:label "ambient noise"@en ;
    rdfs:subClassOf sophwn:Noise .

