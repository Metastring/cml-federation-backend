somanr:Oil a owl:Class ;
    rdfs:label "oil"@en ;
    rdfs:comment "An oil is a substance that is in a viscous liquid statel (‘oily’) at ambient temperatures or slightly warmer, and is both hydrophobic (immiscible with water) and lipophilic (miscible with other oils, literally). This generag definition includes compound classes with otherwise unrelated chemical structures, properties, and uses, including vegetable oils, resochemical oils, and volatile essential oils. Oil is a nonpolar substance. [Wikipedia]"@en ;
    rdfs:subClassOf somanr:FossilFuel .

somaoc:Alkene a owl:Class ;
    rdfs:label "alkene"@en ;
    rdfs:subClassOf somaoc:Hydrocarbon .

somaoc:C6H6 a somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "c6h6"@en .

somaoc:Chlorophyll a owl:Class ;
    rdfs:label "chlorophyll"@en ;
    rdfs:comment "Chlorophyll is a green pigment found in most plants, algae, and cyanobacteria. Chlorophyll absorbs light most strongly in the blue and red but poorly in the green portions of the electromagnetic spectrum, hence the green color of chlorophyll-containing tissues like plant leaves."@en ;
    rdfs:subClassOf somaoc:OrganicCompound .

somaoc:OrganicSubstance a owl:Class ;
    rdfs:label "organic substance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somael:C ;
            owl:onProperty sorelch:hasChemical ],
        soma:Substance .

somapa:CosmicRay a owl:Class ;
    rdfs:label "cosmic ray"@en ;
    rdfs:subClassOf somapa:EnergeticParticle .

somarock:Fossil a owl:Class ;
    rdfs:label "fossil"@en ;
    rdfs:comment "Fossils  are the preserved remains or traces of animals, plants, and other organisms from the remote past. Fossils vary in size from microscopic, such as single bacterial cells [2] only one micrometer in diameter, to gigantic (macroscopic), such as dinosaurs and trees many meters long and weighing many tons. [Wikipedia]"@en ;
    rdfs:subClassOf sostp:SubstanceForm .

somarocki:IntrusiveRock a owl:Class ;
    rdfs:label "intrusive rock"@en ;
    rdfs:comment "Beneath the surface magma tends to cool slowly which allows for the growth of large crystals within the rock. Rocks formed in this way are intrusive or plutonic rocks. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somas:Gravel a owl:Class ;
    rdfs:label "gravel"@en ;
    rdfs:subClassOf somas:Sediment .

somaw:Effluent a owl:Class ;
    rdfs:label "effluent"@en ;
    rdfs:subClassOf somaw:WaterMixture .

somaw:Groundwater a owl:Class ;
    rdfs:label "groundwater"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:below ],
        somaw:LiquidWater .

soph:Event a owl:Class ;
    rdfs:label "event"@en ;
    rdfs:subClassOf soph:Phenomena ;
    owl:equivalentClass soph:Occurrence .

soph:ExtremeEvent a owl:Class ;
    rdfs:label "extreme event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sosttf:Infrequent ;
            owl:onProperty sorelt:hasFrequency ],
        soph:Event .

soph:RadiationalCooling a owl:Class ;
    rdfs:label "radiational cooling"@en ;
    owl:equivalentClass soph:RadiativeCooling .

sophatmo:CappingInversion a owl:Class ;
    rdfs:label "capping inversion"@en ;
    rdfs:comment "A statically stable layer at the top of the atmospheric boundary layer."@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmofo:Haze a owl:Class ;
    rdfs:label "haze"@en ;
    rdfs:comment "Particles suspended, reducing visibility by scattering light; often a mixture of aerosols and photochemical smog."@en ;
    rdfs:subClassOf sophatmofo:Fog .

sophatmopc:ConvectiveStorm a owl:Class ;
    rdfs:label "convective storm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophft:Convection ],
        sophatmopc:Storm .

sophatmopc:HeavyRainfall a owl:Class ;
    rdfs:label "heavy rainfall"@en ;
    rdfs:comment "Rain with a rate of accumulation exceeding a specific value that is geographically dependent."@en ;
    rdfs:subClassOf sophatmopc:Rainfall .

sophatmopc:Hurricane a owl:Class ;
    rdfs:label "hurricane"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        [ a owl:Restriction ;
            owl:hasValue soreaofe:AtlanticOcean ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:TropicalCyclone .

sophatmops:AtmosphericAnticyclone a owl:Class ;
    rdfs:label "atmospheric anticyclone"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:Anticyclone .

sophatmot:ScavengingByPrecipitation a owl:Class ;
    rdfs:label "scavenging by precipitation"@en ;
    rdfs:comment "Removal of pollutants from the air by either rain or snow.  Rainout (or snowout), which is the in-cloud capture of particulates as condensation nuclei, is one form of scavenging."@en ;
    rdfs:subClassOf sophatmot:WetDeposition .

sophatmot:WetDeposition a owl:Class ;
    rdfs:label "wet deposition"@en ;
    rdfs:comment "The removal of atmospheric gases or particles through their incorporation into hydrometeors, which are then lost by precipitation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soph:Precipitation ;
            owl:onProperty sorel:hasPhenomena ],
        soph:AtmosphereLandExchange .

sophatmow:JetStream a owl:Class ;
    rdfs:label "jet stream"@en ;
    rdfs:comment "Relatively strong winds concentrated within a narrow stream in the atmosphere."@en ;
    rdfs:subClassOf sophatmo:AtmosphericWave,
        sophatmow:GlobalWindCirculation ;
    owl:equivalentClass sophatmow:JetStreamWind .

sophb:Sense a owl:Class ;
    rdfs:label "sense"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophcy:ENSO a owl:Class ;
    rdfs:label "enso"@en ;
    owl:equivalentClass sophcy:ElNinoSouthernOscillation,
        sophcy:SouthernOscillation .

sophcy:IceAgeCycle a owl:Class ;
    rdfs:label "ice age cycle"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:PlanetaryOscillation a owl:Class ;
