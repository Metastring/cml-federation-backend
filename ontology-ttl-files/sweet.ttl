    owl:versionInfo "3.6.0" .

sohuecons:LandManagement a owl:Class ;
    rdfs:label "land management"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorea:Land ],
        sohuc:Management .

sohueccont:Treatment a owl:Class ;
    rdfs:label "treatment"@en ;
    rdfs:subClassOf sohueccont:EnvironmentalControlStrategy .

sohuj:FederalGoverningBody a owl:Class ;
    rdfs:label "federal governing body"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:Country ;
            owl:onProperty sorelh:hasJurisdiction ],
        sohuj:GoverningBody .

sohuj:GoverningBodyProduct a owl:Class ;
    rdfs:label "governing body product"@en ;
