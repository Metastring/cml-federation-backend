soproptf:FrequencyBand_MHz a owl:Class ;
    rdfs:label "frequency band mhz"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:MHz ;
            owl:onProperty sorelsc:hasUnit ],
        soproptf:FrequencyBand .

sorea:Land a owl:Class ;
    rdfs:label "land"@en ;
    rdfs:comment "The part of a planetary surface that is a solid"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        sorea:Geosphere .

sorea:PlanetaryBoundary a owl:Class ;
    rdfs:label "planetary boundary"@en ;
    owl:equivalentClass sorea:PlanetarySurfaceLevel .

sorea:PlanetaryRealm a owl:Class ;
    rdfs:label "planetary realm"@en ;
    rdfs:subClassOf sorea:Realm .

soreacz:B a owl:Class ;
    rdfs:label "b"@en ;
    rdfs:comment "Potential evapotranspiration (POTET) exceeds precipitation in all B climates. Subdivisions are based on precipitation timing and amount and mean annual temperature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropst:PrecipitationRange ] ;
            owl:onProperty sorelcl:hasAverageAnnualPrecipitation ],
        soreacz:ClimateClassification ;
    owl:equivalentClass soreacz:DryClimate .

soreag:GeologicProvince a owl:Class ;
    rdfs:label "geologic province"@en ;
    rdfs:comment " A geologic or geomorphic province is a spatial entity with common geologic/geomorphic attributes. A province may include a single dominant structural element such as a basin or a fold belt, or a number of contiguous related elements. Most commonly, provinces are classified by age, origin, or mineral resource.    [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

soreas:SoilOrder a owl:Class ;
    rdfs:label "soil order"@en ;
    rdfs:subClassOf sopropcat:Classification .

sorel:partOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of"@en .

sorelm:greaterThan a owl:ObjectProperty ;
    rdfs:label "greater than"@en ;
    rdfs:subPropertyOf sorelm:inequality,
        sorelm:ordinalRelation ;
    owl:inverseOf sorelm:lessThanOrEqual .

sorepmso:Solution a owl:Class ;
    rdfs:label "solution"@en ;
    rdfs:subClassOf sorepm:NumericalEntity .

sorepsc:Component a owl:Class ;
    rdfs:label "component"@en ;
    rdfs:subClassOf sorep:Dimension ;
    owl:equivalentClass sorepsc:SystemComponent .

sorepsmo:Model a owl:Class ;
    rdfs:label "model"@en ;
    rdfs:subClassOf sorep:Representation ;
    owl:equivalentClass sorepsmo:ScientificModel .

sorepsu:Prefix a owl:Class ;
    rdfs:label "prefix"@en ;
    rdfs:subClassOf sorep:Measurement .

sorepsu:kilogram a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "kilogram"@en ;
    sorelsc:hasSymbol "kg" ;
    skos:notation "kg"^^qudt:UCUMcs .

sostst:BeaufortScale a owl:Class ;
    rdfs:label "beaufort scale"@en ;
    rdfs:subClassOf sostst:WindScale .

somains:Instrument a owl:Class ;
    rdfs:label "instrument"@en ;
    rdfs:subClassOf somaeq:Equipment .

somamic:MicrobiotaTaxonomy a owl:Class ;
    rdfs:label "microbiota taxonomy"@en ;
    rdfs:subClassOf somamic:Microbiota .

somarock:Rock a owl:Class ;
    rdfs:label "rock"@en ;
    rdfs:comment "Rock is a naturally occurring solid aggregate of minerals and/or mineraloids.  In general rocks are of three types, namely, igneous, sedimentary, and metamorphic. [Wikipedia]"@en ;
    rdfs:subClassOf soma:Mixture,
        soma:SolidSubstance .

<http://sweetontology.net/phenSystem> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena System" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phen>,
        <http://sweetontology.net/reprSciModel> ;
    owl:versionInfo "3.6.0" .

soprop:StatisticalSummary a owl:Class ;
    rdfs:label "statistical summary"@en ;
    rdfs:subClassOf soprop:Property .

sopropq:ThermodynamicQuantity a owl:Class ;
    rdfs:label "thermodynamic quantity"@en ;
    rdfs:subClassOf soprop:ThermodynamicProperty,
        sopropq:Quantity .

soprops:Connectivity a owl:Class ;
    rdfs:label "connectivity"@en ;
    rdfs:subClassOf soprops:SpatialConfiguration .

sopropsdir:HorizontalDirection a owl:Class ;
    rdfs:label "horizontal direction"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsh:Height a owl:Class ;
    rdfs:label "height"@en ;
    rdfs:subClassOf sopropsdis:Distance,
        sopropsh:VerticalExtent .

sopropsp:Velocity a owl:Class ;
    rdfs:label "velocity"@en ;
    rdfs:comment "The time rate of change of a position vector; that is, a change of position expressed in terms of speed and direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:MotionProperty,
        sopropq:PhysicalQuantity,
        sorepm:Vector .

<http://sweetontology.net/realmGeol> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Geologic" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/propSpace>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

soreaofl:SeaFloor a owl:Class ;
    rdfs:label "sea floor"@en ;
    rdfs:subClassOf soreahb:WaterBodyBoundary ;
    owl:equivalentClass soreaofl:Seabed .

sorepsu:BaseUnit a owl:Class ;
    rdfs:label "base unit"@en ;
    rdfs:subClassOf sorepsu:Unit ;
    owl:disjointWith sorepsu:ComplexUnit .

sorepscd:VerticalCoordinate a owl:Class ;
    rdfs:label "vertical coordinate"@en .

soma:Mixture a owl:Class ;
    rdfs:label "mixture"@en ;
    rdfs:comment "In chemistry, a mixture is when two or more different substances are mixed together but not combined chemically. The molecules of two or more different substances are mixed in the form of solutions, suspensions, and colloids. [Wikipedia]"@en ;
    rdfs:subClassOf soma:ChemicalSubstance .

sophft:Convection a owl:Class ;
    rdfs:label "convection"@en ;
    rdfs:comment "In general, mass motions within a fluid resulting in transport and mixing of the properties of that fluid.  Convection, along with conduction and radiation, is a principal means of energy transfer."@en ;
    rdfs:subClassOf soph:Phenomena .

sorea:Ocean a owl:Class ;
    rdfs:label "ocean"@en ;
    rdfs:comment "An ocean is a major body of saline water, and a principal component of the hydrosphere. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Liquid ;
            owl:onProperty sorel:hasState ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        sorea:Hydrosphere .

sorear:LatitudeBand a owl:Class ;
    rdfs:label "latitude band"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:degrees ;
            owl:onProperty sorelsc:hasUnit ],
        sopropq:PhysicalQuantity,
        sorepsg:Region .

sorelph:hasPlanetaryStructure a owl:ObjectProperty ;
    rdfs:label "has planetary structure"@en ;
    rdfs:range sorea:PlanetaryStructure .

sorelsp:hasDirection a owl:ObjectProperty ;
    rdfs:label "has direction"@en ;
    rdfs:range sopropsdir:Direction .

sorelsp:hasSpatialScale a owl:ObjectProperty ;
    rdfs:label "has spatial scale"@en ;
    rdfs:range sopropo:SpatialScale ;
    rdfs:subPropertyOf sorelm:hasScale .

<http://sweetontology.net/relaTime> a owl:Ontology ;
    rdfs:label "SWEET Ontology Relationships Time" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propTime>,
        <http://sweetontology.net/propTimeFrequency>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/reprTime> ;
    owl:versionInfo "3.6.0" .

sorepsg:GeometricalObject a owl:Class ;
    rdfs:label "geometrical object"@en ;
    rdfs:subClassOf sorepm:NumericalEntity .

sostti:Era a owl:Class ;
    rdfs:label "era"@en ;
    rdfs:comment "Eons are divided into eras [several hundred million years] [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelt:temporalPartOf ;
            owl:someValuesFrom sostti:Eon ],
        sostti:GeologicTimeUnit .

soma:Substance a owl:Class ;
    rdfs:label "substance"@en .

somarocki:VolcanicRock a owl:Class ;
    rdfs:label "volcanic rock"@en ;
    rdfs:comment "Volcanic rock is an igneous rock produced by extrusion from a volcano. It has various subtypes based on chemical composition and whether the extrusion was violent (pyroclastic) or slow (laval). [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock .

sophatmofr:Front a owl:Class ;
    rdfs:label "front"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena,
        sorepmf:Discontinuity .

soproc:Process a owl:Class ;
    rdfs:label "process"@en .

sopropo:OrdinalProperty a owl:Class ;
    rdfs:label "ordinal property"@en ;
    rdfs:subClassOf soprop:Property,
        sorep:OrdinalScale .

sopropsdis:Size a owl:Class ;
    rdfs:label "size"@en ;
    rdfs:subClassOf soprops:SpatialExtent .

sorelsc:hasImpact a owl:ObjectProperty ;
    rdfs:label "has impact"@en ;
    rdfs:range sopropo:Impact .

sorepds:DataService a owl:Class ;
    rdfs:label "data service"@en ;
    rdfs:subClassOf sohu:Service .

<http://sweetontology.net/reprMathOperation> a owl:Ontology ;
    rdfs:label "SWEET Ontology Representation Mathematics Operation" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/proc>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/reprMath>,
        <http://sweetontology.net/reprMathFunction> ;
    owl:versionInfo "3.6.0" .

sostf:FluidState a owl:Class ;
    rdfs:label "fluid state"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Fluid ;
            owl:onProperty sorel:hasState ],
        sostp:PhysicalState .

sostth:ThermodynamicState a owl:Class ;
    rdfs:label "thermodynamic state"@en ;
    rdfs:subClassOf sostp:PhysicalState .

sophgt:TectonicPhenomena a owl:Class ;
    rdfs:label "tectonic phenomena"@en ;
    rdfs:comment "The tectonic phenomena is the observable motions of the tectonic plates in the Earth's Lithosphere. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophso:Deformation ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreag:Crust ;
            owl:onProperty sorel:hasRealm ],
        sophg:GeospherePhenomena .

sorea:PlanetaryLayer a owl:Class ;
    rdfs:label "planetary layer"@en ;
    rdfs:subClassOf sorepsg3:Layer .

soreag:GeologicFeature a owl:Class ;
    rdfs:label "geologic feature"@en ;
    dcterms:contributor [ a sdo:Organization ;
            sdo:identifier <http://linked.data.gov.au/org/gsq> ;
            sdo:name "Geological Survey of Queensland" ] ;
    rdfs:comment " or Surface Feature is a distinct recognizable structure within a larger context such as a stream bed, fissure, dike, etc."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Geosphere ;
            owl:onProperty sorel:hasRealm ] ;
    skos:altLabel "Geologic Feature",
        "Geological Feature" ;
    skos:definition "A geologic feature is a conceptual feature a that is hypothesized to exist coherently in the Earth that results from geological processes"@en ;
    skos:example "Individuals: Lake Eyre Basin, Sarmatian Craton, Victoria Point Sandbar, Mount Erebus Volcano. Subclasses: Basin, Craton, Shield, Province, Sub-Province."@en ;
    skos:scopeNote "Geologic Features include sedimentary basins, stratigraphic units, non-stratigraphic (lithodemic) units, stratigraphic event features, provinces, tectonic and structural features, georesource accumulations, and geologically significant sites, among others"@en .

<http://sweetontology.net/reprMathFunction> a owl:Ontology ;
    rdfs:label "SWEET Ontology Representation Mathematics Function" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propQuantity>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/repr>,
        <http://sweetontology.net/reprMath>,
        <http://sweetontology.net/reprMathOperation> ;
    owl:versionInfo "3.6.0" .

sostp:Gas a sostp:StateOfMatter,
        owl:NamedIndividual ;
    rdfs:label "gas"@en ;
    owl:sameAs sostp:Vapor .

sostp:SubstanceForm a owl:Class ;
    rdfs:label "substance form"@en ;
    rdfs:subClassOf sostp:PhysicalState .

sostro:ProvenanceRole a owl:Class ;
    rdfs:label "provenance role"@en ;
    rdfs:subClassOf soprop:Role .

somapl:Plant a owl:Class ;
    rdfs:label "plant"@en ;
    rdfs:subClassOf somab:Organism .

somaw:Ice a owl:Class ;
    rdfs:label "ice"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        somaw:WaterSubstance .

sopropo:Qualifier a owl:Class ;
    rdfs:label "qualifier"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sorealc:CoastalRegion a owl:Class ;
    rdfs:label "coastal region"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsp:hasCommon2DBorderWith ;
            owl:someValuesFrom sorea:Land ],
        [ a owl:Restriction ;
            owl:onProperty sorelsp:hasCommon2DBorderWith ;
            owl:someValuesFrom soreao:OceanRegion ],
        sorea:PlanetaryRealm .

soreao:WaterBodyLayer a owl:Class ;
    rdfs:label "water body layer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Ocean ;
            owl:onProperty sorel:hasRealm ],
        sorea:PlanetaryLayer .

sorepsu:second a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "second"@en ;
    sorelsc:hasSymbol "s" ;
    skos:notation "s"^^qudt:UCUMcs .

<http://sweetontology.net/reprSpaceGeometry> a owl:Ontology ;
    rdfs:label "SWEET Ontology Representation Space Geometry" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
