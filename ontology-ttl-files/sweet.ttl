soprocp:Trapping a owl:Class ;
    rdfs:label "trapping"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Washing a owl:Class ;
    rdfs:label "washing"@en ;
    rdfs:subClassOf soproc:Force .

soprocsc:Boiling a owl:Class ;
    rdfs:label "boiling"@en ;
    rdfs:subClassOf soprocsc:Vaporization .

soprocsc:Condensation a owl:Class ;
    rdfs:label "condensation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Liquid ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:Deionization a owl:Class ;
    rdfs:label "deionization"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:IonizedState ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:hasValue sostp:NeutralState ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:Deposition a owl:Class ;
    rdfs:label "deposition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:Gasification a owl:Class ;
    rdfs:label "gasification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:Liquiefaction a owl:Class ;
    rdfs:label "liquiefaction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Liquid ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:PhaseTransition a owl:Class ;
    rdfs:label "phase transition"@en ;
    owl:equivalentClass soprocsc:StateChange .

soprocsc:Photoionization a owl:Class ;
    rdfs:label "photoionization"@en ;
    rdfs:subClassOf soprocsc:Ionization .

soprocsc:Refreezing a owl:Class ;
    rdfs:label "refreezing"@en ;
    rdfs:subClassOf soprocsc:Freezing .

soprocsc:Sublimation a owl:Class ;
    rdfs:label "sublimation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocsc:Thawing a owl:Class ;
    rdfs:label "thawing"@en ;
    rdfs:subClassOf soprocsc:Melting .

soprocw:Absorption a owl:Class ;
    rdfs:label "absorption"@en ;
    rdfs:comment "The process in which incident radiant energy is retained by a substance."@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:AcousticBackScattering a owl:Class ;
    rdfs:label "acoustic back scattering"@en ;
    rdfs:comment "Scattering of sound or ultrasound in the direction of the source."@en ;
    rdfs:subClassOf soprocw:Backscattering .

soprocw:BraggDiffraction a owl:Class ;
    rdfs:label "bragg diffraction"@en ;
    rdfs:subClassOf soprocw:Diffraction .

soprocw:Damping a owl:Class ;
    rdfs:label "damping"@en ;
    rdfs:subClassOf soprocw:WaveProcess .

soprocw:Dispersion a owl:Class ;
    rdfs:label "dispersion"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:Dissipation a owl:Class ;
    rdfs:label "dissipation"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:Echo a owl:Class ;
    rdfs:label "echo"@en ;
    rdfs:comment "In radar, a general term for the appearance, on a radar display, of the radio signal scattered or reflected from a target. The characteristics of a radar echo are determined by 1) the waveform, frequency, and power of the incident wave; 2) the range and velocity of the target with respect to the radar; and 3) the size, shape, and composition of the target."@en ;
    rdfs:subClassOf soprocw:Reflection .

soprocw:ElectromagneticRadiation a owl:Class ;
    rdfs:label "electromagnetic radiation"@en ;
    rdfs:subClassOf sophw:Wave,
        soprocp:PhysicalProcess ;
    owl:equivalentClass soprocw:ElectromagneticWave .

soprocw:Excitation a owl:Class ;
    rdfs:label "excitation"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:FraunhoferDiffraction a owl:Class ;
    rdfs:label "fraunhofer diffraction"@en ;
    rdfs:subClassOf soprocw:Diffraction .

soprocw:FresnelDiffraction a owl:Class ;
    rdfs:label "fresnel diffraction"@en ;
    rdfs:subClassOf soprocw:Diffraction .

soprocw:Interference a owl:Class ;
    rdfs:label "interference"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:LineEmission a owl:Class ;
    rdfs:label "line emission"@en ;
    rdfs:subClassOf soprocw:Emission .

soprocw:LineOfSightPropagation a owl:Class ;
    rdfs:label "line of sight propagation"@en ;
    rdfs:comment "Line-of-sight propagation refers to electromagnetic radiation or electromagnetic waves travelling in a straight line. The rays or waves are deviated or reflected by obstructions and cannot travel over the horizon or behind obstacles. Beyond that, material disperses the rays respectively the energy of the waves."@en ;
    rdfs:subClassOf soprocw:WavePropagation .

soprocw:MieScattering a owl:Class ;
    rdfs:label "mie scattering"@en ;
    rdfs:comment "scattering of waves (photons) that reverse the direction of propagation"@en ;
    rdfs:subClassOf soprocw:Scattering .

soprocw:Polarization a owl:Class ;
    rdfs:label "polarization"@en ;
    rdfs:subClassOf soprocw:WaveProcess .

soprocw:Propagation a owl:Class ;
    rdfs:label "propagation"@en ;
    rdfs:comment "Wave propagation is any of the ways in which waves travel through a medium (waveguide). With respect to the direction of the oscillation relative to the propagation direction, we can distinguish between longitudinal wave and transverse waves. Another useful parameter for describing the propagation is the wave velocity that mostly depends on some kind of density of the medium. For electromagnetic waves, propagation may occur in a vacuum as well as in a material medium."@en ;
    rdfs:subClassOf soprocw:WaveProcess ;
    owl:equivalentClass soprocw:WavePropagation .

soprocw:RayleighScattering a owl:Class ;
    rdfs:label "rayleigh scattering"@en ;
    rdfs:subClassOf soprocw:Scattering .

soprocw:Refraction a owl:Class ;
    rdfs:label "refraction"@en ;
    rdfs:comment "A change of direction and possibly amplitude of an electromagnetic, acoustic, or any other wave propagating in a material medium, homogeneous on the scale of the wavelength, as a consequence of spatial variation in the properties of the medium."@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:SchaeferBergmannDiffraction a owl:Class ;
    rdfs:label "schaefer bergmann diffraction"@en ;
    rdfs:subClassOf soprocw:Diffraction .

soprocw:Transmission a owl:Class ;
    rdfs:label "transmission"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprocw:WaveDrag a owl:Class ;
    rdfs:label "wave drag"@en ;
    rdfs:subClassOf soprocw:WaveProcess .

soprop:Accuracy a owl:Class ;
    rdfs:label "accuracy"@en ;
    rdfs:subClassOf soprop:Metric .

soprop:Distortion a owl:Class ;
    rdfs:label "distortion"@en ;
    rdfs:subClassOf soprop:Error .

soprop:Efficiency a owl:Class ;
    rdfs:label "efficiency"@en ;
    rdfs:subClassOf soprop:Measure .

soprop:ElectromagneticProperty a owl:Class ;
    rdfs:label "electromagnetic property"@en ;
    rdfs:subClassOf soprop:PhysicalProperty .

soprop:Fideltiy a owl:Class ;
    rdfs:label "fideltiy"@en ;
    rdfs:subClassOf soprop:Measure .

soprop:FlowProperty a owl:Class ;
    rdfs:label "flow property"@en ;
    rdfs:subClassOf soprop:SystemProperty .

soprop:Precision a owl:Class ;
    rdfs:label "precision"@en ;
    rdfs:subClassOf soprop:Metric .

soprop:Sensitivity a owl:Class ;
    rdfs:label "sensitivity"@en ;
    rdfs:subClassOf soprop:Measure .

soprop:StockProperty a owl:Class ;
    rdfs:label "stock property"@en ;
    rdfs:subClassOf soprop:SystemProperty .

sopropb:Free a owl:Class ;
    rdfs:label "free"@en ;
    rdfs:subClassOf sopropb:BinaryProperty .

sopropb:Polarity a owl:Class ;
    rdfs:label "polarity"@en ;
    rdfs:subClassOf soprop:ChemicalProperty,
        sopropb:BinaryProperty .

sopropcap:CoefficientOfHeatTransfer a owl:Class ;
    rdfs:label "coefficient of heat transfer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:wattPerMeterSquaredPerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropm:MaterialProperty,
        sopropq:ThermodynamicQuantity .

sopropcap:HeatCapacity a owl:Class ;
    rdfs:label "heat capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcap:Capacity,
        sopropq:ThermodynamicQuantity .

sopropcap:LinearThermalExpansion a owl:Class ;
    rdfs:label "linear thermal expansion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterPerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ThermodynamicQuantity .

sopropcap:MolarHeatCapacity a owl:Class ;
    rdfs:label "molar heat capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerMolePerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcap:Capacity,
        sopropq:ThermodynamicQuantity .

sopropcap:SpecificHeat a owl:Class ;
    rdfs:label "specific heat"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerKilogramPerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcap:Capacity,
        sopropq:ThermodynamicQuantity ;
    owl:equivalentClass sopropcap:SpecificHeatCapacity .

sopropcap:VolumetricHeatCapacity a owl:Class ;
    rdfs:label "volumetric heat capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerMeterCubedPerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcap:Capacity,
        sopropq:ThermodynamicQuantity .

sopropcap:VolumetricThermalExpansion a owl:Class ;
    rdfs:label "volumetric thermal expansion"@en ;
    rdfs:subClassOf sopropcap:CoefficientOfThermalExpansion .

sopropcat:Characteristics a owl:Class ;
    rdfs:label "characteristics"@en ;
    rdfs:subClassOf sopropcat:CategoricalProperty ;
    owl:equivalentClass sopropcat:Description .

sopropcat:Community a owl:Class ;
    rdfs:label "community"@en ;
    rdfs:comment "A community is a social group of organisms sharing an environment, normally with shared interests."@en ;
    rdfs:subClassOf sopropcat:Group .

sopropcat:Name a owl:Class ;
    rdfs:label "name"@en ;
    rdfs:subClassOf sopropcat:CategoricalProperty .

sopropcat:SIC a owl:Class ;
    rdfs:label "sic"@en ;
    owl:equivalentClass sopropcat:StandardIndustrialClassification .

sopropcat:Type a owl:Class ;
    rdfs:label "type"@en ;
    rdfs:subClassOf sopropcat:CategoricalProperty .

sopropcha:Capacitance a owl:Class ;
    rdfs:label "capacitance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:farad ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:CationExchangeCapacity a owl:Class ;
    rdfs:label "cation exchange capacity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaio:Cation ;
            owl:onProperty sorelch:hasSubstance ],
        sopropcha:ExchangeCapacity .

sopropcha:DielectricConstant a owl:Class ;
    rdfs:label "dielectric constant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:dimensionlessUnit ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:PhysicalConstant .

sopropcha:ElectricCharge a owl:Class ;
    rdfs:label "electric charge"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:coulomb ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:ElectricChargeDensity a owl:Class ;
    rdfs:label "electric charge density"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:coulombPerMeterCubed ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:ElectricCurrent a owl:Class ;
    rdfs:label "electric current"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:ampere ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:ElectricCurrentDensity a owl:Class ;
    rdfs:label "electric current density"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:amperePerMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:ElectricDipoleMoment a owl:Class ;
    rdfs:label "electric dipole moment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:coulombMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:VectorQuantity .

sopropcha:ElectricFieldStrength a owl:Class ;
    rdfs:label "electric field strength"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:voltPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:ElectricFluxDensity a owl:Class ;
    rdfs:label "electric flux density"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:coulombPerMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:Flux .

sopropcha:Inductance a owl:Class ;
    rdfs:label "inductance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Magnetism ;
            owl:onProperty sorel:hasProcess ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:henry ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:MagnetiGradient a owl:Class ;
    rdfs:label "magneti gradient"@en ;
    rdfs:subClassOf sopropq:ElectromagneticQuantity .

sopropcha:MagneticDipoleMoment a owl:Class ;
    rdfs:label "magnetic dipole moment"@en ;
    rdfs:subClassOf sopropcha:MagneticMoment .

sopropcha:MagneticFieldStrength a owl:Class ;
    rdfs:label "magnetic field strength"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:amperePerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:MagneticFlux a owl:Class ;
    rdfs:label "magnetic flux"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:weber ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:Flux .

sopropcha:MagneticFluxDensity a owl:Class ;
    rdfs:label "magnetic flux density"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:tesla ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity,
        sopropq:Flux .

sopropcha:Permeability a owl:Class ;
    rdfs:label "permeability"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:henryPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcha:Permittivity a owl:Class ;
    rdfs:label "permittivity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:faradPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropche:Abundance a owl:Class ;
    rdfs:label "abundance"@en ;
    rdfs:subClassOf sopropche:Composition .

sopropche:Acidity a owl:Class ;
    rdfs:label "acidity"@en ;
    rdfs:subClassOf soprop:ChemicalProperty .

sopropche:Alkalic a owl:Class ;
    rdfs:label "alkalic"@en ;
    owl:equivalentClass sopropche:Alkalinity .

sopropche:Alkaline a owl:Class ;
    rdfs:label "alkaline"@en ;
    owl:equivalentClass sopropche:Alkalinity .

sopropche:BOD a owl:Class ;
    rdfs:label "bod"@en ;
    owl:equivalentClass sopropche:BiologicalOxygenDemand .

sopropche:BedLoad a owl:Class ;
    rdfs:label "bed load"@en ;
    rdfs:subClassOf sopropche:Load ;
    owl:disjointWith sopropche:SuspendedLoad .

sopropche:BiochemicalOxygenDemand a owl:Class ;
    rdfs:label "biochemical oxygen demand"@en ;
    owl:equivalentClass sopropche:BiologicalOxygenDemand .

sopropche:COD a owl:Class ;
    rdfs:label "cod"@en ;
    owl:equivalentClass sopropche:ChemicalOxygenDemand .

sopropche:CarbonateAlkalinity a owl:Class ;
    rdfs:label "carbonate alkalinity"@en ;
    rdfs:subClassOf sopropche:Alkalinity .

sopropche:DissolvedLoad a owl:Class ;
    rdfs:label "dissolved load"@en ;
    rdfs:subClassOf soma:DissolvedSolid,
        sopropche:Load .

sopropche:HplusConcentration a owl:Class ;
    rdfs:label "hplus concentration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somaio:Hplus ;
            owl:onProperty sorelch:hasSubstance ],
        sopropq:ChemicalQuantity .

sopropche:IonComposition a owl:Class ;
    rdfs:label "ion composition"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:IonizedState ;
            owl:onProperty sorel:hasState ],
        sopropche:Composition .

sopropche:Purity a owl:Class ;
    rdfs:label "purity"@en ;
    rdfs:subClassOf soprop:ChemicalProperty .

sopropche:Reactivity a owl:Class ;
    rdfs:label "reactivity"@en ;
    rdfs:subClassOf soprop:ReactionProperty .

sopropche:SAR a owl:Class ;
    rdfs:label "sar"@en ;
    owl:equivalentClass sopropche:SodiumAdsorptionRatio .

sopropche:SaturationPoint a owl:Class ;
    rdfs:label "saturation point"@en ;
    rdfs:subClassOf sopropche:SaturationProperty .

sopropche:Solubility a owl:Class ;
    rdfs:label "solubility"@en ;
    rdfs:comment "The total amount of solute species that will remain indefinitely in a solution maintained at constant temperature and pressure in contact with the solid crystals from which the solutes were derived."@en ;
    rdfs:subClassOf soprop:ReactionProperty .

sopropche:TotalAlkalinity a owl:Class ;
    rdfs:label "total alkalinity"@en ;
    rdfs:subClassOf sopropche:Alkalinity .

sopropche:TotalDissolvedSolids a owl:Class ;
    rdfs:label "total dissolved solids"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soma:DissolvedSolid ;
            owl:onProperty sorelch:hasSubstance ],
        sopropm:Density .

sopropche:TotalSuspendedSolids a owl:Class ;
    rdfs:label "total suspended solids"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soma:SuspendedSolid ;
            owl:onProperty sorelch:hasSubstance ],
        sopropm:Density .

sopropche:Zoomass a owl:Class ;
    rdfs:label "zoomass"@en ;
    rdfs:subClassOf sopropm:DryWeight .

sopropche:pH a owl:Class ;
    rdfs:label "ph"@en ;
    rdfs:comment "pH is a measure of the acidity or basicity of a solution. It is defined as the cologarithm of the activity of dissolved hydrogen ions (H+). Hydrogen ion activity coefficients cannot be measured experimentally, so they are based on theoretical calculations. The pH scale is not an absolute scale; it is relative to a set of standard solutions whose pH is established by international agreement. [Wikipedia]"@en ;
    rdfs:subClassOf sopropq:ChemicalQuantity .

sopropcon:Conductance a owl:Class ;
    rdfs:label "conductance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:siemens ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticQuantity .

sopropcon:HallConductivity a owl:Class ;
    rdfs:label "hall conductivity"@en ;
    rdfs:subClassOf sopropcon:ElectricalConductivity .

sopropcon:HydraulicConductivity a owl:Class ;
    rdfs:label "hydraulic conductivity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcon:Conductivity,
        sopropm:ConsistenceProperty .

sopropcon:PedersenConductivity a owl:Class ;
    rdfs:label "pedersen conductivity"@en ;
    rdfs:subClassOf sopropcon:ElectricalConductivity .

sopropcon:Resistance a owl:Class ;
    rdfs:label "resistance"@en ;
    rdfs:subClassOf sopropcon:Impedance .

sopropcon:Resistivity a owl:Class ;
    rdfs:label "resistivity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:ohmMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:PhysicalQuantity .

sopropcon:SpecificConductance a owl:Class ;
    rdfs:label "specific conductance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:siemensPerKilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:PhysicalQuantity .

sopropcon:ThermalConductivity a owl:Class ;
    rdfs:label "thermal conductivity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:wattPerMeterPerKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropcon:Conductivity,
        sopropq:ThermodynamicQuantity .

sopropcou:AtomicNeutralNumberDensity a owl:Class ;
    rdfs:label "atomic neutral number density"@en ;
    rdfs:subClassOf sopropcou:NeutralNumberDensity .

sopropcou:CarryingCapacity a owl:Class ;
    rdfs:label "carrying capacity"@en ;
    rdfs:subClassOf sopropcou:Population .

sopropcou:EnergyLevel a owl:Class ;
    rdfs:label "energy level"@en ;
    rdfs:subClassOf sopropcou:Count .

sopropcou:Fluence a owl:Class ;
    rdfs:label "fluence"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:perMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:Quantity .

sopropcou:MolecularNeutralNumberDensity a owl:Class ;
    rdfs:label "molecular neutral number density"@en ;
    rdfs:subClassOf sopropcou:NeutralNumberDensity .

sopropcou:SunspotNumber a owl:Class ;
    rdfs:label "sunspot number"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophst:SolarActivity ;
            owl:onProperty sorelsc:measureOf ],
        sopropcou:Count .

sopropcou:TotalElectronContent a owl:Class ;
    rdfs:label "total electron content"@en ;
    rdfs:subClassOf sopropcou:NumberDensity .

sopropdife:Amplitude a owl:Class ;
    rdfs:label "amplitude"@en ;
    rdfs:comment "Often the greatest magnitude at a given point of any spatially and temporally varying physical quantity governed by a wave equation; can also mean the spatial part of a time-harmonic wave function."@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropdife:Deviation .

sopropdife:Bias a owl:Class ;
    rdfs:label "bias"@en ;
    rdfs:subClassOf soprop:Error,
        sopropdife:Deviation .

sopropdife:NDVI a sopropdife:Difference,
        owl:NamedIndividual ;
    rdfs:label "ndvi"@en ;
    owl:sameAs sopropdife:NormalizedDifferenceVegetationIndex .

sopropdife:SaturationDeficit a owl:Class ;
    rdfs:label "saturation deficit"@en ;
    rdfs:comment "The amount by which the water vapor in the air must be increased to achieve saturation without changing the environmental temperature and pressure."@en ;
    rdfs:subClassOf sopropche:SaturationProperty .

sopropdife:Tolerance a owl:Class ;
    rdfs:label "tolerance"@en ;
    rdfs:subClassOf soprop:Error,
        sopropdife:Deviation .

sopropdife:Undulation a owl:Class ;
    rdfs:label "undulation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropsh:Geoid ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorepsg3:ReferenceEllipsoid ;
            owl:onProperty sorelm:hasSecondOperand ],
        sorepmo:Difference .

sopropdifu:Confluence a owl:Class ;
    rdfs:label "confluence"@en ;
    rdfs:comment "The rate at which adjacent flow is converging along an axis oriented normal to the flow at the point in question."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom soproptf:Convergence ],
        sopropdifu:DiffusivityQuantity .

sopropdifu:Diffluence a owl:Class ;
    rdfs:label "diffluence"@en ;
    rdfs:comment "The rate at which adjacent flow diverges along an axis oriented normal to the flow at the point in question; the opposite of confluence."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom soproptf:Divergence ],
        sopropdifu:DiffusivityQuantity .

sopropdifu:EddyDiffusivity a owl:Class ;
    rdfs:label "eddy diffusivity"@en ;
    rdfs:comment "The exchange coefficient for the diffusion of a conservative property by eddies in a turbulent flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophfd:Eddy ],
        sopropdifu:Diffusivity .

sopropdifu:KinematicViscosity a owl:Class ;
    rdfs:label "kinematic viscosity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:ViscousForce ;
            owl:onProperty sorelsc:measureOf ],
        sopropdifu:DiffusivityQuantity .

sopropdifu:MeridionalOvertuningStreamfunction a owl:Class ;
    rdfs:label "meridional overtuning streamfunction"@en ;
    rdfs:subClassOf sopropdifu:Streamfunction .

sopropdifu:ThermalDiffusivity a owl:Class ;
    rdfs:label "thermal diffusivity"@en ;
    rdfs:subClassOf sopropdifu:Diffusivity,
        sopropq:ThermodynamicQuantity .

sopropdifu:Transmissivity a owl:Class ;
    rdfs:label "transmissivity"@en ;
    rdfs:subClassOf sopropdifu:DiffusivityQuantity .

sopropdifu:VelocityPotential a owl:Class ;
    rdfs:label "velocity potential"@en ;
    rdfs:subClassOf sopropdifu:DiffusivityQuantity,
        sorepmf:VectorQuantity .

sopropdr:AngstromExponent a sopropdr:DimensionlessRatio,
        sopropq:RadiationMediumInteractionQuantity,
        owl:NamedIndividual ;
    rdfs:label "angstrom exponent"@en .

sopropdr:AspectRatio a sopropdr:DimensionlessRatio,
        soprops:Shape,
        owl:NamedIndividual ;
    rdfs:label "aspect ratio"@en .

sopropdr:BowenRatio a owl:Class ;
    rdfs:label "bowen ratio"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:SensibleHeat ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom soprope:LatentHeat ;
            owl:onProperty sorelm:hasSecondOperand ],
        sorepmo:Ratio .

sopropdr:BulkRichardsonNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "bulk richardson number"@en ;
    rdfs:comment "An approximation to the gradient Richardson number formed by approximating local gradients by finite difference across layers."@en .

sopropdr:CriticalRichardsonNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "critical richardson number"@en .

sopropdr:DarcySlope a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "darcy slope"@en ;
    owl:sameAs sopropdr:HydraulicGradient .

sopropdr:DepolarizationRatio a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "depolarization ratio"@en ;
    rdfs:comment "In Raman spectroscopy, the depolarization ratio is the intensity ratio between the perpendicular component and the parallel component of the Raman scattered light."@en .

sopropdr:DragCoefficient a soprop:FluidProperty,
        sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "drag coefficient"@en .

sopropdr:Electronegativity a sopropdr:DimensionlessRatio,
        sopropq:ElectromagneticQuantity,
        owl:NamedIndividual ;
    rdfs:label "electronegativity"@en .

sopropdr:FroudeNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "froude number"@en .

sopropdr:GradientRichardsonNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "gradient richardson number"@en .

sopropdr:IsotopeRatio a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "isotope ratio"@en .

sopropdr:LeafAreaIndex a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "leaf area index"@en .

sopropdr:PecletNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "peclet number"@en ;
    rdfs:comment "A relationship between the advective and diffusive components of solute transport expressed as the ratio of the product of the average interstitial velocity, times the characteristic length, divided by the coefficient of molecular diffusion; small values indicate diffusion dominance, large values indicate advection dominance."@en .

sopropdr:PlasmaParameter a sopropdr:DimensionlessRatio,
        sopropq:ElectromagneticQuantity,
        owl:NamedIndividual ;
    rdfs:label "plasma parameter"@en .

sopropdr:ReducedChiSquareValue a owl:Class ;
    rdfs:label "reduced chi square value"@en ;
    rdfs:subClassOf sopropdr:ChiSquareValue .

sopropdr:RefractiveIndex a sopropdr:DimensionlessRatio,
        sopropq:ElectromagneticQuantity,
        owl:NamedIndividual ;
    rdfs:label "refractive index"@en .

sopropdr:RelativePermeability a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "relative permeability"@en ;
    rdfs:comment " The ratio of the effective permeability for a given flow phase to the intrinsic permeability of the porous medium (WMO, 1974). The ratio of the effective and specific permeabilities."@en .

sopropdr:RetardationFactor a soprop:HydrogeologicalProperty,
        sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "retardation factor"@en ;
    rdfs:comment "The ratio of the average linear velocity of groundwater to the velocity of the retarded constituent at C/Co=0.5."@en .

sopropdr:ReynoldsNumber a soprop:FluidProperty,
        sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "reynolds number"@en ;
    rdfs:comment "The dimensionless ratio of the inertial force (∼U2/L) to the viscous force (∼ νU/L2) in the Navier–Stokes equations, where U is a characteristic velocity, L is a characteristic length, and ν is the kinematic viscosity of the fluid; thus, Re=ULv. The Reynolds number is of great importance in the theory of hydrodynamic stability and the origin of turbulence. The inertia force generates vortex stretching and nonlinear interactions and hence creates randomness. Turbulence occurs when the inertia term dominates the viscous term, that is, when the Reynolds number is large. For many engineering flows, turbulence occurs when Re > Rec, where the critical Reynolds number is roughly Rec = 2100."@en .

sopropdr:RichardsonNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "richardson number"@en .

sopropdr:RossbyNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "rossby number"@en ;
    rdfs:comment "A dimensionless number relating the ratio of inertial to Coriolis forces for a given flow of a rotating fluid."@en .

sopropdr:RouseNumber a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "rouse number"@en .

sopropdr:SignalToNoiseRatio a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "signal to noise ratio"@en .

sopropdr:SpecificRetention a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "specific retention"@en ;
    rdfs:comment "The ratio of the Volume of water which the porous medium, after being saturated, will retain against the pull of gravity to the volume of the porous medium."@en .

sopropdr:SpecificStorage a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "specific storage"@en ;
    rdfs:comment "The volume of water released from or taken into storage per unit volume of the porous medium per unit change in head."@en .

sopropdr:SpecificYield a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "specific yield"@en ;
    rdfs:comment "The ratio of the volume of water which the porous medium after being saturated, will yield by gravity to the volume of the porous medium."@en .

sopropdr:VoidRatio a sopropdr:DimensionlessRatio,
        sopropm:ConsistenceProperty,
        owl:NamedIndividual ;
    rdfs:label "void ratio"@en .

sopropdr:VonKarmanConstant a sopropdr:DimensionlessRatio,
        sopropq:PhysicalConstant,
        owl:NamedIndividual ;
    rdfs:label "von karman constant"@en .

sopropdr:WaterCirculationCoefficient a sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "water circulation coefficient"@en ;
    rdfs:comment "The ratio of a region's total precipitation to its external precipitation originating as evaporation from the oceans as opposed to evapotranspiration from the land."@en .

sopropdr:ZScore a owl:Class ;
    rdfs:label "z score"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepmst:ZTest ;
            owl:onProperty sorelm:hasTest ],
        sopropdr:StatisticalScore .

sopropdr:tScore a owl:Class ;
    rdfs:label "t score"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepmst:tTest ;
            owl:onProperty sorelm:hasTest ],
        sopropdr:StatisticalScore .

soprope:BindingEnergy a owl:Class ;
    rdfs:label "binding energy"@en ;
    rdfs:subClassOf soprope:ChemicalEnergy,
        soprope:PotentialEnergy .

soprope:ConvectiveInhibition a owl:Class ;
    rdfs:label "convective inhibition"@en ;
    rdfs:comment "The energy needed to lift an air parcel vertically and pseudoadiabatically from its originating level to its level of free convection (LFC)."@en ;
    rdfs:subClassOf soprope:Energy .

soprope:EnergyDensity a owl:Class ;
    rdfs:label "energy density"@en ;
    rdfs:comment "Energy per unit area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Energy ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sopropsm:Area ;
            owl:onProperty sorelm:hasSecondOperand ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:IntensiveProperty,
        sorepmo:Ratio .

soprope:Enthalpy a owl:Class ;
    rdfs:label "enthalpy"@en ;
    rdfs:subClassOf soprope:ChemicalEnergy .

soprope:EvaporativeAvailablePotentialEnergy a owl:Class ;
    rdfs:label "evaporative available potential energy"@en ;
    rdfs:comment "Analogous to convective available potential energy, except that it is related to the negative buoyancy associated with evaporative cooling of liquid water within a sinking cloudy air parcel."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Evaporation ;
            owl:onProperty sorelph:hasStateChange ],
        soprope:AvailablePotentialEnergy .

soprope:Geopotential a owl:Class ;
    rdfs:label "geopotential"@en ;
    rdfs:subClassOf soprope:GravitationalPotential .

soprope:GibbsFreeEnergy a owl:Class ;
    rdfs:label "gibbs free energy"@en ;
    rdfs:subClassOf soprope:ChemicalEnergy .

soprope:Hamiltonian a owl:Class ;
    rdfs:label "hamiltonian"@en ;
    rdfs:subClassOf soprope:Energy .

soprope:HeatBudget a owl:Class ;
    rdfs:label "heat budget"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Heat ;
            owl:onProperty sorel:hasProperty ],
        soprope:EnergyBudget .

soprope:InternalEnergy a owl:Class ;
    rdfs:label "internal energy"@en ;
    rdfs:subClassOf soprope:Energy .

soprope:IonizationEnergy a owl:Class ;
    rdfs:label "ionization energy"@en ;
    rdfs:subClassOf soprope:ChemicalEnergy,
        soprope:PotentialEnergy ;
    owl:equivalentClass soprope:IonizationPotential .

soprope:KineticEnergy a owl:Class ;
    rdfs:label "kinetic energy"@en ;
    rdfs:subClassOf soprop:MotionProperty,
        soprope:Energy .

soprope:Lagrangian a owl:Class ;
    rdfs:label "lagrangian"@en ;
    rdfs:subClassOf soprope:Energy .

soprope:Luminosity a owl:Class ;
    rdfs:label "luminosity"@en ;
    rdfs:subClassOf soprope:Power,
        sopropq:ElectromagneticRadiationQuantity .

soprope:MatricPotential a owl:Class ;
    rdfs:label "matric potential"@en ;
    rdfs:comment "The energy required to extract water from a porous medium to overcome the capillary and adsorptive forces."@en ;
    rdfs:subClassOf soprope:Energy,
        sopropm:ConsistenceProperty .

soprope:RadiantEnergy a owl:Class ;
    rdfs:label "radiant energy"@en ;
    rdfs:comment "Infrequently, any energy propagated by a physical quantity governed by a wave equation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Radiation ;
            owl:onProperty sorel:hasProcess ],
        soprope:Energy .

soprope:SpecificPotentialEnergy a owl:Class ;
    rdfs:label "specific potential energy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:PotentialEnergy ;
            owl:onProperty sorelm:hasFirstOperand ],
        soprope:SpecificEnergy .

soprope:ThermochemicalEnergy a owl:Class ;
    rdfs:label "thermochemical energy"@en ;
    rdfs:subClassOf soprope:ChemicalEnergy .

soprope:TotalSoilWaterPotential a owl:Class ;
    rdfs:label "total soil water potential"@en ;
    rdfs:comment " The sum of the energy-related components of a soil-water system; i.e., the sum of the gravitational, matric, and osmotic components."@en ;
    rdfs:subClassOf soprop:HydrogeologicalProperty .

soprope:Work a owl:Class ;
    rdfs:label "work"@en ;
    rdfs:comment "A form of energy arising from the motion of a system against a force, existing only in the process of energy conversion."@en ;
    rdfs:subClassOf soprope:Energy .

sopropef:AbsorbedSolarRadiation a owl:Class ;
    rdfs:label "absorbed solar radiation"@en ;
    rdfs:comment "Solar radiation absorbed by the atmosphere's constituent gases, suspended material, clouds, or by the earth's surface."@en ;
    rdfs:subClassOf sopropef:SolarRadiation .

sopropef:AbsorptionCoefficient a owl:Class ;
    rdfs:label "absorption coefficient"@en ;
    owl:equivalentClass sopropef:Opacity .

sopropef:Brightness a owl:Class ;
    rdfs:label "brightness"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:wattPerMeterSquaredPerSteradianPerWavelength ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropef:Luminance ;
    owl:equivalentClass sopropef:SpecificIntensity .

sopropef:BulkHeatFlux a owl:Class ;
    rdfs:label "bulk heat flux"@en ;
    rdfs:comment ">Heat flux averaged over a layer of air, such as the boundary layer; heat-flux divergence or difference between the top and bottom of a layer."@en ;
    rdfs:subClassOf sopropef:ThermalFlux .

sopropef:CloudForcing a owl:Class ;
    rdfs:label "cloud forcing"@en ;
    rdfs:subClassOf sopropef:RadiativeForcing .

sopropef:HeatFlow a owl:Class ;
    rdfs:label "heat flow"@en ;
    owl:equivalentClass sopropef:ThermalFlux .

sopropef:HeatFlux a owl:Class ;
    rdfs:label "heat flux"@en ;
    owl:equivalentClass sopropef:ThermalFlux .

sopropef:Illuminance a owl:Class ;
    rdfs:label "illuminance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:lux ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropef:EnergyFlux .

sopropef:Insolation a owl:Class ;
    rdfs:label "insolation"@en ;
    rdfs:subClassOf sopropef:SolarRadiation .

sopropef:Irradiance a owl:Class ;
    rdfs:label "irradiance"@en ;
    rdfs:subClassOf sopropef:FluxDensity,
        sopropq:ElectromagneticRadiationQuantity .

sopropef:LuminousFlux a owl:Class ;
    rdfs:label "luminous flux"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:lumen ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropef:EnergyFlux .

sopropef:LuminousIntensity a owl:Class ;
    rdfs:label "luminous intensity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:candela ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticRadiationQuantity .

sopropef:PoyntingVector a owl:Class ;
    rdfs:label "poynting vector"@en ;
    rdfs:subClassOf sopropef:FluxDensity .

sopropef:RichterScale a owl:Class ;
    rdfs:label "richter scale"@en ;
    rdfs:subClassOf sopropef:EarthquakeScale .

sopropef:SolarConstant a sopropef:RadiativeFlux,
        sopropq:PhysicalConstant,
        owl:NamedIndividual ;
    rdfs:label "solar constant"@en ;
    sorelsc:hasSource sophst:Sun .

sopropef:SolarFlux a owl:Class ;
    rdfs:label "solar flux"@en ;
    rdfs:subClassOf sopropef:RadiativeFlux .

sopropef:SolarForcing a owl:Class ;
    rdfs:label "solar forcing"@en ;
    rdfs:subClassOf sopropef:RadiativeForcing .

sopropef:SpectralRadiance a owl:Class ;
    rdfs:label "spectral radiance"@en ;
    rdfs:comment "The radiance per unit wavelength or wavenumber interval."@en ;
    rdfs:subClassOf sopropef:Radiance .

sopropef:TerrestrialRadiation a owl:Class ;
    rdfs:label "terrestrial radiation"@en ;
    rdfs:comment "Longwave radiation originating by thermal emission from a planetary surface and/or its atmosphere"@en ;
    rdfs:subClassOf sopropef:RadiativeFlux .

sopropfr:Absorptance a owl:Class ;
    rdfs:label "absorptance"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:Absorptivity a owl:Class ;
    rdfs:label "absorptivity"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:AirSpaceRatio a owl:Class ;
    rdfs:label "air space ratio"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropm:ConsistenceProperty .

sopropfr:AvailableWaterCapacity a owl:Class ;
    rdfs:label "available water capacity"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropm:ConsistenceProperty .

sopropfr:Bioavailability a owl:Class ;
    rdfs:label "bioavailability"@en ;
    rdfs:subClassOf soprop:BiologicalProperty,
        sopropfr:FractionalQuantity .

sopropfr:BondAlbedo a owl:Class ;
    rdfs:label "bond albedo"@en ;
    rdfs:subClassOf sopropfr:Albedo .

sopropfr:CapacityFactor a owl:Class ;
    rdfs:label "capacity factor"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:CloudCover a owl:Class ;
    rdfs:label "cloud cover"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:Coherence a owl:Class ;
    rdfs:label "coherence"@en ;
    rdfs:subClassOf sopropfr:BivariateStatisticalSummary .

sopropfr:ConditionalProbability a owl:Class ;
    rdfs:label "conditional probability"@en ;
    rdfs:subClassOf sopropfr:Probability .

sopropfr:Covariance a owl:Class ;
    rdfs:label "covariance"@en ;
    rdfs:subClassOf sopropfr:BivariateStatisticalSummary .

sopropfr:CrossCorrelation a owl:Class ;
    rdfs:label "cross correlation"@en ;
    rdfs:subClassOf sopropfr:Correlation .

sopropfr:DegreeOfIonization a owl:Class ;
    rdfs:label "degree of ionization"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:DifferentialWaterCapacity a owl:Class ;
    rdfs:label "differential water capacity"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropm:ConsistenceProperty .

sopropfr:EffectivePorosity a owl:Class ;
    rdfs:label "effective porosity"@en ;
    rdfs:subClassOf sopropfr:Porosity .

sopropfr:Efficiency a owl:Class ;
    rdfs:label "efficiency"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:Emissivity a owl:Class ;
    rdfs:label "emissivity"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropq:ElectromagneticRadiationQuantity ;
    owl:equivalentClass sopropfr:Emittance .

sopropfr:FPAR a owl:Class ;
    rdfs:label "fpar"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity ;
    owl:equivalentClass sopropfr:FractionPhotosyntheticActiveRadiation .

sopropfr:FieldCapacity a owl:Class ;
    rdfs:label "field capacity"@en ;
    rdfs:subClassOf sopropche:WaterConcentration,
        sopropfr:FractionalQuantity .

sopropfr:JointProbability a owl:Class ;
    rdfs:label "joint probability"@en ;
    rdfs:subClassOf sopropfr:Probability .

sopropfr:Likelihood a owl:Class ;
    rdfs:label "likelihood"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:MarketShare a owl:Class ;
    rdfs:label "market share"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:MassFraction a owl:Class ;
    rdfs:label "mass fraction"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:Metallicity a owl:Class ;
    rdfs:label "metallicity"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:MolarConcentration a owl:Class ;
    rdfs:label "molar concentration"@en ;
    owl:equivalentClass sopropfr:MoleConcentration .

sopropfr:MoleFraction a owl:Class ;
    rdfs:label "mole fraction"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:MoleRatio a owl:Class ;
    rdfs:label "mole ratio"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:PartialCorrelation a owl:Class ;
    rdfs:label "partial correlation"@en ;
    rdfs:subClassOf sopropfr:Correlation .

sopropfr:PearsonProductMomentCorrelation a owl:Class ;
    rdfs:label "pearson product moment correlation"@en ;
    rdfs:subClassOf sopropfr:Correlation .

sopropfr:RankCorrelation a owl:Class ;
    rdfs:label "rank correlation"@en ;
    rdfs:subClassOf sopropfr:Correlation .

sopropfr:Reflectance a owl:Class ;
    rdfs:label "reflectance"@en ;
    rdfs:comment "A general term referring to the radiation reflected from, or scattered back through, a given surface in response to radiation incident on the surface with the same wavelength or wavelength range."@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:Reflectivity a owl:Class ;
    rdfs:label "reflectivity"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:Refractivity a owl:Class ;
    rdfs:label "refractivity"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:RelativeHumidity a owl:Class ;
    rdfs:label "relative humidity"@en ;
    rdfs:subClassOf sopropfr:Humidity .

sopropfr:SaturationMixingRatio a owl:Class ;
    rdfs:label "saturation mixing ratio"@en ;
    rdfs:comment "A thermodynamic function of state; the value of the mixing ratio of saturated air at the given temperature and pressure."@en ;
    rdfs:subClassOf sopropche:SaturationProperty,
        sopropfr:MixingRatio .

sopropfr:SpecificHumidity a owl:Class ;
    rdfs:label "specific humidity"@en ;
    rdfs:comment "In a system of moist air, the (dimensionless) ratio of the mass of water vapor to the total mass of the system."@en ;
    rdfs:subClassOf sopropfr:Humidity .

sopropfr:Transmittance a owl:Class ;
    rdfs:label "transmittance"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropfr:FractionalQuantity .

sopropfr:Transparency a owl:Class ;
    rdfs:label "transparency"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropq:RadiationMediumInteractionQuantity .

sopropfr:VolumeFraction a owl:Class ;
    rdfs:label "volume fraction"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:VolumeMixingRatio a owl:Class ;
    rdfs:label "volume mixing ratio"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity .

sopropfr:WaterHoldingCapacity a owl:Class ;
    rdfs:label "water holding capacity"@en ;
    rdfs:subClassOf sopropfr:FractionalQuantity,
        sopropm:ConsistenceProperty .

sopropfr:pValue a owl:Class ;
    rdfs:label "p value"@en ;
    rdfs:subClassOf sopropfr:Probability .

sopropfu:CriticalLevel a owl:Class ;
    rdfs:label "critical level"@en ;
    owl:equivalentClass sopropfu:CriticalPoint .

sopropfu:Decile a owl:Class ;
    rdfs:label "decile"@en ;
    rdfs:subClassOf sopropfu:Percentile .

sopropfu:Disturbance a owl:Class ;
    rdfs:label "disturbance"@en ;
    rdfs:subClassOf soprop:Error .

sopropfu:ErrorBar a owl:Class ;
    rdfs:label "error bar"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprop:Error ;
            owl:onProperty sorelsc:rangeOf ],
        sopropq:IntervalQuantity .

sopropfu:FlippingPoint a owl:Class ;
    rdfs:label "flipping point"@en ;
    owl:equivalentClass sopropfu:TippingPoint .

sopropfu:Kurtosis a owl:Class ;
    rdfs:label "kurtosis"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:Median a owl:Class ;
    rdfs:label "median"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:MidRange a owl:Class ;
    rdfs:label "mid range"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:Mode a owl:Class ;
    rdfs:label "mode"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:Peak a owl:Class ;
    rdfs:label "peak"@en ;
    rdfs:subClassOf sopropfu:Maximum .

sopropfu:Quartile a owl:Class ;
    rdfs:label "quartile"@en ;
    rdfs:subClassOf sopropfu:Percentile .

sopropfu:Quintile a owl:Class ;
    rdfs:label "quintile"@en ;
    rdfs:subClassOf sopropfu:Percentile .

sopropfu:Skewness a owl:Class ;
    rdfs:label "skewness"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:StandardError a owl:Class ;
    rdfs:label "standard error"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropfu:StandardDeviation ;
            owl:onProperty sorelm:estimateOf ],
        sorepsmo:Estimate .

sopropfu:TemporalMean a owl:Class ;
    rdfs:label "temporal mean"@en ;
    owl:equivalentClass sopropfu:TimeMean .

sopropfu:TimeAverage a owl:Class ;
    rdfs:label "time average"@en ;
    owl:equivalentClass sopropfu:TimeMean .

sopropfu:Variance a owl:Class ;
    rdfs:label "variance"@en ;
    rdfs:subClassOf soprop:StatisticalSummary,
        sopropfu:Spread .

sopropi:AdaptiveCapacity a owl:Class ;
    rdfs:label "adaptive capacity"@en ;
    rdfs:subClassOf soprop:Metric .

sopropi:AkasofuEpsilon a owl:Class ;
    rdfs:label "akasofu epsilon"@en ;
    owl:equivalentClass sopropi:GeomagneticIndex .

sopropi:AuroralBoundaryIndex a owl:Class ;
    rdfs:label "auroral boundary index"@en ;
    rdfs:subClassOf sopropi:GeomagneticIndex .

sopropi:BIBI a owl:Class ;
    rdfs:label "bibi"@en ;
    owl:equivalentClass sopropi:BenthicIndex .

sopropi:BlockingIndex a owl:Class ;
    rdfs:label "blocking index"@en ;
    rdfs:subClassOf sopropi:Index .

sopropi:BoydenIndex a owl:Class ;
    rdfs:label "boyden index"@en ;
    rdfs:comment "A measure of the mean thermodynamic stability in a layer beneath 700 mb."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:StaticStability ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:Index .

sopropi:COH a owl:Class ;
    rdfs:label "coh"@en ;
    owl:equivalentClass sopropi:CoefficientOfHaze .

sopropi:CirculationIndex a owl:Class ;
    rdfs:label "circulation index"@en ;
    rdfs:subClassOf sopropi:Index .

sopropi:CommonSenseClimateIndex a owl:Class ;
    rdfs:label "common sense climate index"@en ;
    rdfs:comment "The Common Sense Climate Index is a simple measure of the degree (if any) to which practical climate change is occurring. The index is a composite of several everyday climate indicators. It is expected to have positive values when warming occurs and negative values for cooling. If the Index reaches and consistently maintains a value of 1 or more, the climate change should be noticeable to most people who have lived at that location for a few decades."@en ;
    rdfs:subClassOf sopropi:ClimateIndicator .

sopropi:ComputationalComplexity a owl:Class ;
    rdfs:label "computational complexity"@en ;
    rdfs:subClassOf soprop:Metric .

sopropi:CropMoistureIndex a owl:Class ;
    rdfs:label "crop moisture index"@en ;
    rdfs:subClassOf sopropi:HealthIndex .

sopropi:EPI a owl:Class ;
    rdfs:label "epi"@en ;
    owl:equivalentClass sopropi:EnvironmentalPerformanceIndex .

sopropi:ESI a owl:Class ;
    rdfs:label "esi"@en ;
    owl:equivalentClass sopropi:EnvironmentalSustainabilityIndex .

sopropi:FireWeatherIndex a owl:Class ;
    rdfs:label "fire weather index"@en ;
    rdfs:subClassOf sopropi:EnvironmentalIndex .

sopropi:ForestFireDangerIndex a owl:Class ;
    rdfs:label "forest fire danger index"@en ;
    rdfs:subClassOf sopropi:EnvironmentalIndex .

sopropi:Hydropattern a owl:Class ;
    rdfs:label "hydropattern"@en ;
    rdfs:comment "The full range of hydrologic parameters, which include the depth of water, duration of inundation, and the timing and distribution of freshwater flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Hydrosphere ;
            owl:onProperty sorel:hasRealm ],
        sopropi:Index .

sopropi:KaplanSSTIndex a owl:Class ;
    rdfs:label "kaplan sst index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:Temperature ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:Index .

sopropi:Kp a owl:Class ;
    rdfs:label "kp"@en ;
    rdfs:subClassOf sopropi:GeomagneticIndex .

sopropi:NRMI a owl:Class ;
    rdfs:label "nrmi"@en ;
    owl:equivalentClass sopropi:NaturalResourceManagementIndex .

sopropi:NorthAtlanticOscillationIndex a owl:Class ;
    rdfs:label "north atlantic oscillation index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophcy:NAO ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:IndexDefinedByDifference .

sopropi:NorthPacificOscillationIndex a owl:Class ;
    rdfs:label "north pacific oscillation index"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophcy:PDO ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:IndexDefinedByDifference .

sopropi:PC a owl:Class ;
    rdfs:label "pc"@en ;
    owl:equivalentClass sopropi:PolarCapIndex .

sopropi:PDI a owl:Class ;
    rdfs:label "pdi"@en ;
    owl:equivalentClass sopropi:PalmerDroughtSeverityIndex .

sopropi:PDSI a owl:Class ;
    rdfs:label "pdsi"@en ;
    owl:equivalentClass sopropi:PalmerDroughtSeverityIndex .

sopropi:PHDI a owl:Class ;
    rdfs:label "phdi"@en ;
    owl:equivalentClass sopropi:PalmerHydrologicalDroughtIndex .

sopropi:PalmerDroughtIndex a owl:Class ;
    rdfs:label "palmer drought index"@en ;
    owl:equivalentClass sopropi:PalmerDroughtSeverityIndex .

sopropi:PhysiologicalParameter a owl:Class ;
    rdfs:label "physiological parameter"@en ;
    rdfs:subClassOf sopropi:HealthIndex .

sopropi:PsychologicalParameter a owl:Class ;
    rdfs:label "psychological parameter"@en ;
    rdfs:subClassOf sopropi:HealthIndex .

sopropi:RingelmannChart a owl:Class ;
    rdfs:label "ringelmann chart"@en ;
    rdfs:subClassOf sopropi:AirQualityIndex .

sopropi:SMI a owl:Class ;
    rdfs:label "smi"@en ;
    owl:equivalentClass sopropi:SurfaceMoistureIndex .

sopropi:ShallowConvectionParameter a owl:Class ;
    rdfs:label "shallow convection parameter"@en ;
    rdfs:comment "The representation in a numerical model of the turbulent transports of heat and moisture by nonprecipitating cumulus clouds with cloud tops below 3000 m above the surface."@en ;
    rdfs:subClassOf sophft:Transport,
        sopropq:PhysicalConstant .

sopropi:StandardizedPrecipitationIndex a owl:Class ;
    rdfs:label "standardized precipitation index"@en ;
    rdfs:subClassOf sopropi:DroughtIndex .

sopropi:StorageCoefficient a owl:Class ;
    rdfs:label "storage coefficient"@en ;
    rdfs:comment "The volume of water an aquifer releases from or takes into storage per unit surface area of the aquifer per unit change in head (virtually equal to the specific yield in an unconfined aquifer)."@en ;
    rdfs:subClassOf soprop:HydrogeologicalProperty ;
    owl:equivalentClass sopropi:Storativity .

sopropi:UVIndex a owl:Class ;
    rdfs:label "u v index"@en ;
    rdfs:subClassOf sopropi:AirQualityIndex .

sopropi:Virulence a owl:Class ;
    rdfs:label "virulence"@en ;
    rdfs:subClassOf sopropi:HealthIndex .

sopropi:VitalStatistics a owl:Class ;
    rdfs:label "vital statistics"@en ;
    rdfs:subClassOf sopropi:HealthIndex .

sopropi:ZonalIndex a owl:Class ;
    rdfs:label "zonal index"@en ;
    rdfs:comment "A measure of strength of the middle-latitude westerlies, usually expressed as the horizontal pressure difference between 35 and 55N latitude, or as the corresponding geostrophic wind."@en ;
    rdfs:subClassOf sopropi:IndexDefinedByDifference .

sopropm:BulkDensity a owl:Class ;
    rdfs:label "bulk density"@en ;
    rdfs:subClassOf sopropm:Density .

sopropm:Consistence a owl:Class ;
    rdfs:label "consistence"@en ;
    rdfs:subClassOf sopropm:ConsistenceProperty ;
    owl:equivalentClass sopropm:Consistency .

sopropm:DissolvedConcentration a owl:Class ;
    rdfs:label "dissolved concentration"@en ;
    rdfs:subClassOf sopropm:MassConcentration .

sopropm:Dosage a owl:Class ;
    rdfs:label "dosage"@en ;
    rdfs:subClassOf sopropm:Mass ;
    owl:equivalentClass sopropm:Dose .

sopropm:Ductibility a owl:Class ;
    rdfs:label "ductibility"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Elasticity a owl:Class ;
    rdfs:label "elasticity"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Flexure a owl:Class ;
    rdfs:label "flexure"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Grade a owl:Class ;
    rdfs:label "grade"@en ;
    rdfs:subClassOf sopropm:MassConcentration .

sopropm:Hardness a owl:Class ;
    rdfs:label "hardness"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Malleability a owl:Class ;
    rdfs:label "malleability"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:MassContent a owl:Class ;
    rdfs:label "mass content"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropm:Mass ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogramPerMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropm:Content .

sopropm:MeanMolecularWeight a owl:Class ;
    rdfs:label "mean molecular weight"@en ;
    rdfs:subClassOf sopropm:MolecularWeight .

sopropm:Moles a owl:Class ;
    rdfs:label "moles"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:mole ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:Quantity .

sopropm:OpticalMass a owl:Class ;
    rdfs:label "optical mass"@en ;
    rdfs:comment "The vertical integral of the density of absorbers between two altitudes; used mainly in determining the transmission through an absorbing gas."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:RadiationMediumInteractionQuantity .

sopropm:Plasticity a owl:Class ;
    rdfs:label "plasticity"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:PotentialDensity a owl:Class ;
    rdfs:label "potential density"@en ;
    rdfs:comment "The density of a unit of water after it is raised by an adiabatic process to the surface, i.e., determined from in-situ salinity and potential temperature (AGI, 1980). Density that would be reached by a compressible fluid if it were adiabatically compressed or expanded to a standard pressure."@en ;
    rdfs:subClassOf sopropm:Density .

sopropm:Roughness a owl:Class ;
    rdfs:label "roughness"@en ;
    rdfs:subClassOf sopropm:MaterialProperty .

sopropm:SigmaT a owl:Class ;
    rdfs:label "sigma t"@en ;
    rdfs:subClassOf sopropm:Density .

sopropm:Softness a owl:Class ;
    rdfs:label "softness"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Solidity a owl:Class ;
    rdfs:label "solidity"@en ;
    rdfs:subClassOf sopropm:StrengthProperty ;
    owl:equivalentClass sopropm:Solidness .

sopropm:SpecificVolume a owl:Class ;
    rdfs:label "specific volume"@en ;
    rdfs:comment "1. The ratio of the mass of any substance to the volume occupied by it (usually expressed in kilograms per cubic meter, but any other unit system may be used); the reciprocal of specific volume."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterCubedPerKilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:IntensiveProperty .

sopropm:Structure a owl:Class ;
    rdfs:label "structure"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropm:Texture a owl:Class ;
    rdfs:label "texture"@en ;
    rdfs:subClassOf sopropm:ConsistenceProperty .

sopropmf:DarcyFlux a owl:Class ;
    rdfs:label "darcy flux"@en ;
    rdfs:subClassOf sopropmf:MassFlux .

sopropmf:DifferentialFlux a owl:Class ;
    rdfs:label "differential flux"@en ;
    rdfs:subClassOf sopropmf:MassFlux .

sopropmf:EffectivePermeability a owl:Class ;
    rdfs:label "effective permeability"@en ;
    rdfs:comment "The observed permeability of a porous medium to one fluid phase under conditions of physical interaction between this phase and other fluid phases present."@en ;
    rdfs:subClassOf sopropmf:Permeability .

sopropmf:GPP a owl:Class ;
    rdfs:label "gpp"@en ;
    owl:equivalentClass sopropmf:GrossPrimaryProductivity .

sopropmf:IntrinsicPermeability a owl:Class ;
    rdfs:label "intrinsic permeability"@en ;
    rdfs:comment "A measure of the relative ease with which a porous medium can transmit a fluid under a potential gradient and is a property of the medium alone (after Lohman and others, 1972). The property of a porous medium itself that expresses the ease with which gases, liquids, or other substances can pass through it."@en ;
    rdfs:subClassOf sopropmf:Permeability .

sopropmf:NPP a owl:Class ;
    rdfs:label "npp"@en ;
    owl:equivalentClass sopropmf:NetPrimaryProductivity .

sopropmf:PermeabilityCoefficent a owl:Class ;
    rdfs:label "permeability coefficent"@en ;
    rdfs:comment "The rate of flow of water through a unit cross-sectional area under a unit hydraulic gradient at the prevailing temperature (field permeability coefficient) or adjusted to a temperature of 150C (60-F)."@en ;
    rdfs:subClassOf sopropmf:Permeability .

sopropmf:SpecificCapacity a owl:Class ;
    rdfs:label "specific capacity"@en ;
    rdfs:comment "The rate of discharge of water from the well divided by the drawdown of the water level within the well."@en ;
    rdfs:subClassOf sopropmf:MassFlux .

sopropmf:SpecificDischarge a owl:Class ;
    rdfs:label "specific discharge"@en ;
    rdfs:comment " The rate of discharge of groundwater per unit area of a porous medium measured at right angle to the direction of flow."@en ;
    rdfs:subClassOf sopropmf:MassFlux .

sopropmf:SpecificPermeability a owl:Class ;
    rdfs:label "specific permeability"@en ;
    rdfs:comment "The permeability measured when the rock contains only one fluid."@en ;
    rdfs:subClassOf sopropmf:Permeability .

sopropo:Belief a owl:Class ;
    rdfs:label "belief"@en ;
    owl:equivalentClass sopropo:Trust .

sopropo:Condition a owl:Class ;
    rdfs:label "condition"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropo:EducationalLevel a owl:Class ;
    rdfs:label "educational level"@en ;
    rdfs:subClassOf sopropo:Level .

sopropo:ElectromagneticSpectrum a owl:Class ;
    rdfs:label "electromagnetic spectrum"@en ;
    rdfs:comment "The electromagnetic (EM) spectrum is the range of all possible electromagnetic radiation. The electromagnetic spectrum (usually just spectrum) of an object is the characteristic distribution of electromagnetic radiation from that object."@en ;
    rdfs:subClassOf sopropo:SpectralBand .

sopropo:Gradation a owl:Class ;
    rdfs:label "gradation"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropo:Luster a owl:Class ;
    rdfs:label "luster"@en ;
    rdfs:subClassOf sopropo:Color .

sopropo:Pigment a owl:Class ;
    rdfs:label "pigment"@en ;
    rdfs:subClassOf sopropo:Color .

sopropo:Quality a owl:Class ;
    rdfs:label "quality"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropo:Streak a owl:Class ;
    rdfs:label "streak"@en ;
    rdfs:comment "Color of the powder of a substance."@en ;
    rdfs:subClassOf sopropo:Color .

sopropo:TrophicLevel a owl:Class ;
    rdfs:label "trophic level"@en ;
    rdfs:subClassOf sopropo:Level .

sopropp:AirPressure a owl:Class ;
    rdfs:label "air pressure"@en ;
    owl:equivalentClass sopropp:BarometricPressure .

sopropp:BarometricTendency a owl:Class ;
    rdfs:label "barometric tendency"@en ;
    rdfs:comment "The character and amount of atmospheric pressure change during a specified period of time, often a three-hour period preceding an observation."@en ;
    rdfs:subClassOf sopropp:PressureTendency .

sopropp:BulkModulus a owl:Class ;
    rdfs:label "bulk modulus"@en ;
    rdfs:subClassOf sopropq:PhysicalQuantity .

sopropp:Compressibility a owl:Class ;
    rdfs:label "compressibility"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:perPascal ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:PhysicalQuantity .

sopropp:CompressiveStrength a owl:Class ;
    rdfs:label "compressive strength"@en ;
    rdfs:subClassOf sopropp:Strength .

sopropp:DifferentialPressure a owl:Class ;
    rdfs:label "differential pressure"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:DynamicViscosity a owl:Class ;
    rdfs:label "dynamic viscosity"@en ;
    owl:equivalentClass sopropp:Viscosity .

sopropp:ExnerFunction a owl:Class ;
    rdfs:label "exner function"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:HydrostaticPressure a owl:Class ;
    rdfs:label "hydrostatic pressure"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:ModulusOfElasticity a owl:Class ;
    rdfs:label "modulus of elasticity"@en ;
    owl:equivalentClass sopropp:YoungsModulus .

sopropp:MomentumFlux a owl:Class ;
    rdfs:label "momentum flux"@en ;
    rdfs:subClassOf sopropp:Pressure,
        sopropq:Flux .

sopropp:NormalStress a owl:Class ;
    rdfs:label "normal stress"@en ;
    owl:equivalentClass sopropp:TensileStress .

sopropp:PartialPressure a owl:Class ;
    rdfs:label "partial pressure"@en ;
    rdfs:comment "The pressure that a component of a gaseous mixture would have if it alone occupied the same volume at the same temperature as the mixture."@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:SeaLevelPressure a owl:Class ;
    rdfs:label "sea level pressure"@en ;
    rdfs:comment "The atmospheric pressure at mean sea level, either directly measured or, most commonly, empirically determined from the observed station pressure."@en ;
    rdfs:subClassOf sopropp:AtmosphericPressure .

sopropp:ShearModulus a owl:Class ;
    rdfs:label "shear modulus"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Shear ;
            owl:onProperty sorelsp:hasDirection ],
        sopropm:MaterialProperty,
        sopropq:PhysicalQuantity .

sopropp:ShearStress a owl:Class ;
    rdfs:label "shear stress"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Shear ;
            owl:onProperty sorelsp:hasDirection ],
        sopropp:Stress ;
    owl:disjointWith sopropp:TensileStress .

sopropp:StaticPressure a owl:Class ;
    rdfs:label "static pressure"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:Stiffness a owl:Class ;
    rdfs:label "stiffness"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:newtonPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropm:StrengthProperty,
        sopropq:PhysicalQuantity .

sopropp:Suction a owl:Class ;
    rdfs:label "suction"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:SurfaceTension a owl:Class ;
    rdfs:label "surface tension"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:newtonPerMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprocp:Tension,
        soprop:FluidProperty,
        sopropq:PhysicalQuantity .

sopropp:TensileStrength a owl:Class ;
    rdfs:label "tensile strength"@en ;
    rdfs:subClassOf sopropp:Strength .

sopropp:TotalPressure a owl:Class ;
    rdfs:label "total pressure"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropq:BalanceEquation a owl:Class ;
    rdfs:label "balance equation"@en ;
    owl:equivalentClass sopropq:BudgetEquation .

sopropq:BiologicalQuantity a owl:Class ;
    rdfs:label "biological quantity"@en ;
    rdfs:subClassOf soprop:BiologicalProperty,
        sopropq:Quantity .

sopropq:FieldStrength a owl:Class ;
    rdfs:label "field strength"@en ;
    rdfs:subClassOf sopropq:PhysicalQuantity .

sopropq:QuantitativeProperty a owl:Class ;
    rdfs:label "quantitative property"@en ;
    owl:equivalentClass sopropq:Quantity .

sopropq:StokesParameters a owl:Class ;
    rdfs:label "stokes parameters"@en ;
    rdfs:subClassOf sopropq:VectorQuantity .

sopropq:VectorPotential a owl:Class ;
    rdfs:label "vector potential"@en ;
    rdfs:subClassOf sopropq:Potential,
        sopropq:VectorQuantity .

sopropr:AbsoluteVorticity a owl:Class ;
    rdfs:label "absolute vorticity"@en ;
    rdfs:subClassOf sopropr:Vorticity .

sopropr:AngularAcceleration a owl:Class ;
    rdfs:label "angular acceleration"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:radianPerSecondSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:AngularMotionProperty,
        sopropq:VectorQuantity .

sopropr:AngularMomentum a owl:Class ;
    rdfs:label "angular momentum"@en ;
    rdfs:comment "In physics, the angular momentum of an object rotating about some reference point is the measure of the extent to which the object will continue to rotate about that point unless acted upon by an external torque. In particular, if a point mass rotates about an axis, then the angular momentum with respect to a point on the axis is related to the mass of the object, the velocity and the distance of the mass to the axis. While the motion associated with linear momentum has no absolute frame of reference, the rotation associated with angular momentum is sometimes spoken of as being measured relative to the fixed stars."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogramRadianPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropsp:Momentum .

sopropr:AngularVelocity a owl:Class ;
    rdfs:label "angular velocity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:radianPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:AngularMotionProperty,
        sopropq:VectorQuantity .

sopropr:Circulation a owl:Class ;
    rdfs:label "circulation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepmf:VectorField ;
            owl:onProperty sorelm:hasInput ],
        sorepmo:LineIntegral .

sopropr:CoriolisParameter a owl:Class ;
    rdfs:label "coriolis parameter"@en ;
    rdfs:subClassOf sopropq:PhysicalConstant,
        soproptf:Frequency .

sopropr:Curl a owl:Class ;
    rdfs:label "curl"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepmf:VectorField ;
            owl:onProperty sorelm:hasOutput ],
        sorepmo:VectorFieldOperation .

sopropr:CyclotronFrequency a owl:Class ;
    rdfs:label "cyclotron frequency"@en ;
    owl:equivalentClass sopropr:Gyrofrequency .

sopropr:Enstrophy a owl:Class ;
    rdfs:label "enstrophy"@en ;
    rdfs:subClassOf soprop:AngularMotionProperty,
        sopropq:PhysicalQuantity .

sopropr:ErtelPotentialVorticity a owl:Class ;
    rdfs:label "ertel potential vorticity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:perKilogramMeterSquaredPerSecondKelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropr:PotentialVorticity .

sopropr:Helicity a owl:Class ;
    rdfs:label "helicity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterPerSecondSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sorepmo:VectorFieldOperation .

sopropr:MomentOfInertia a owl:Class ;
    rdfs:label "moment of inertia"@en ;
    rdfs:subClassOf soprop:AngularMotionProperty,
        sopropq:PhysicalQuantity .

sopropr:RelativeVorticity a owl:Class ;
    rdfs:label "relative vorticity"@en ;
    rdfs:comment "The vorticity as measured in a system of coordinates fixed on the earth's surface.  Usually, only the vertical component of the vorticity is meant."@en ;
    rdfs:subClassOf sopropr:Vorticity .

sopropr:Spin a owl:Class ;
    rdfs:label "spin"@en ;
    rdfs:subClassOf soprop:AngularMotionProperty .

sopropr:Torque a owl:Class ;
    rdfs:label "torque"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:newtonMeter ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:AngularMotionProperty,
        sopropq:VectorQuantity .

soprops:AngularDistribution a owl:Class ;
    rdfs:label "angular distribution"@en ;
    rdfs:subClassOf soprops:SpatialDistribution .

soprops:Containment a owl:Class ;
    rdfs:label "containment"@en ;
    rdfs:subClassOf soprops:SpatialConfiguration .

soprops:Curvature a owl:Class ;
    rdfs:label "curvature"@en ;
    rdfs:subClassOf soprops:SpatialProperty .

soprops:Morphology a owl:Class ;
    rdfs:label "morphology"@en ;
    rdfs:subClassOf soprops:SpatialProperty .

sopropsdir:Angle a owl:Class ;
    rdfs:label "angle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:radian ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        [ a owl:Restriction ;
            owl:cardinality "2"^^xsd:nonNegativeInteger ;
            owl:onProperty sorelsp:hasDirection ],
        sopropq:Quantity .

sopropsdir:Attitude a owl:Class ;
    rdfs:label "attitude"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Azimuth a owl:Class ;
    rdfs:label "azimuth"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:AzimuthalDirection a owl:Class ;
    rdfs:label "azimuthal direction"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Bearing a owl:Class ;
    rdfs:label "bearing"@en ;
    owl:equivalentClass sopropsdir:Direction .

sopropsdir:Incidence a owl:Class ;
    rdfs:label "incidence"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Lateral a owl:Class ;
    rdfs:label "lateral"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Orientation a owl:Class ;
    rdfs:label "orientation"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Outgoing a owl:Class ;
    rdfs:label "outgoing"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropsdir:Incoming ;
            owl:onProperty sorelsp:oppositeTo ],
        sopropsdir:Direction ;
    owl:equivalentClass sopropsdir:Outward .

sopropsdir:PolarDirection a owl:Class ;
    rdfs:label "polar direction"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Radial a owl:Class ;
    rdfs:label "radial"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:SolidAngle a owl:Class ;
    rdfs:label "solid angle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepsg3:Cone ;
            owl:onProperty sorelsp:hasGeometricalObject ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:steradian ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:Quantity .

sopropsdir:Tilt a owl:Class ;
    rdfs:label "tilt"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdir:Zenith a owl:Class ;
    rdfs:label "zenith"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sopropsdis:AttenuationCoefficient a owl:Class ;
    rdfs:label "attenuation coefficient"@en ;
    owl:equivalentClass sopropsdis:ExtinctionCoefficient .

sopropsdis:CompactionCoefficient a owl:Class ;
    rdfs:label "compaction coefficient"@en ;
    rdfs:subClassOf sopropsdis:PerMeterQuantity .

sopropsdis:CyclotronRadius a owl:Class ;
    rdfs:label "cyclotron radius"@en ;
    owl:equivalentClass sopropsdis:Gyroradius .

sopropsdis:DebyeLength a owl:Class ;
    rdfs:label "debye length"@en ;
    rdfs:subClassOf sopropsdis:Distance ;
    owl:equivalentClass sopropsdis:DebyeScreeningLength .

sopropsdis:DispersionCoeffienct a owl:Class ;
    rdfs:label "dispersion coeffienct"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:measureOf ;
            owl:someValuesFrom sopropsdis:Dispersivity ],
        sopropm:MaterialProperty .

sopropsdis:Fetch a owl:Class ;
    rdfs:label "fetch"@en ;
    rdfs:subClassOf sopropsdis:Distance .

sopropsdis:GrainSize a owl:Class ;
    rdfs:label "grain size"@en ;
    rdfs:subClassOf sopropm:ConsistenceProperty .

sopropsdis:MeanFreePath a owl:Class ;
    rdfs:label "mean free path"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasProcess ;
            owl:someValuesFrom soprocp:Collision ],
        soprop:MotionProperty,
        sopropsdis:Distance .

sopropsdis:MixingLength a owl:Class ;
    rdfs:label "mixing length"@en ;
    rdfs:subClassOf sopropsdis:Distance .

sopropsdis:ObukhovLength a owl:Class ;
    rdfs:label "obukhov length"@en ;
    rdfs:subClassOf sopropsdis:Distance .

sopropsdis:PulseLength a owl:Class ;
    rdfs:label "pulse length"@en ;
    rdfs:subClassOf sopropsdis:Length .

sopropsdis:Range a owl:Class ;
    rdfs:label "range"@en ;
    rdfs:subClassOf sopropsdis:Distance .

sopropsdis:RossbyRadiusOfDeformation a owl:Class ;
    rdfs:label "rossby radius of deformation"@en ;
    rdfs:subClassOf sopropsdis:Distance .

sopropsdis:ScatteringCoefficient a owl:Class ;
    rdfs:label "scattering coefficient"@en ;
    rdfs:comment "A measure of the extinction due to scattering of monochromatic radiation as it traverses a medium containing scattering particles."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocw:Scattering ;
            owl:onProperty sorel:hasProcess ],
        sopropsdis:SpatialFrequency .

sopropsdis:Visibility a owl:Class ;
    rdfs:label "visibility"@en ;
    rdfs:comment "The greatest distance in a given direction at which it is just possible to see and identify with the unaided eye"@en ;
    rdfs:subClassOf soprop:RadiationMediumInteractionProperty,
        sopropsdis:Distance .

sopropsdis:WaveNumber a owl:Class ;
    rdfs:label "wave number"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropsdis:PerMeterQuantity .

sopropsh:BarometricAltitude a owl:Class ;
    rdfs:label "barometric altitude"@en ;
    rdfs:subClassOf sopropsh:Altitude .

sopropsh:Bathymetry a owl:Class ;
    rdfs:label "bathymetry"@en ;
    rdfs:subClassOf sorea:PlanetarySurfaceLevel .

sopropsh:Crest a owl:Class ;
    rdfs:label "crest"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:DampingDepth a owl:Class ;
    rdfs:label "damping depth"@en ;
    rdfs:subClassOf sopropsh:Depth .

sopropsh:Drawdown a owl:Class ;
    rdfs:label "drawdown"@en ;
    rdfs:subClassOf sopropsh:Depth .

sopropsh:DynamicTopography a owl:Class ;
    rdfs:label "dynamic topography"@en ;
    rdfs:subClassOf sopropsh:Topography .

sopropsh:EstimatedCeiling a owl:Class ;
    rdfs:label "estimated ceiling"@en ;
    rdfs:comment "After U.S.weather observing practice, the ceiling classification applied to a ceiling height that is determined in any of the following ways: 1) by means of a convective-cloud height diagram or dewpoint formula; 2) from the known heights of unobscured portions of natural landmarks, or objects more than one and one-half nautical miles from any runway of the airport; 3) on the basis of observational experience, provided the sky is not obscured by surface-based hydrometeors or lithometeors, and other guides are lacking or considered unreliable; or 4) determined by ceilometer or ceiling light when the penetration of the light beam is in excess of normal for the particular height and type of layer, or when the elevation angle of the clinometer or ceilometer-detector scanner exceeds 84?."@en ;
    rdfs:subClassOf sopropsh:Ceiling .

sopropsh:FlightLevel a owl:Class ;
    rdfs:label "flight level"@en ;
    rdfs:comment "In aviation, a Flight Level (FL) is a standard nominal altitude of an aircraft, referenced to a world-wide fixed pressure datum of 1013.25 hPa or the equivalent setting, 29.921 inHg (the average sea-level pressure). It is not necessarily the same as the aircraft's true altitude above mean sea level."@en ;
    rdfs:subClassOf sopropsh:Altitude .

sopropsh:Freeboard a owl:Class ;
    rdfs:label "freeboard"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:GeopotentialHeight a owl:Class ;
    rdfs:label "geopotential height"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:MixingHeight a owl:Class ;
    rdfs:label "mixing height"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:ScaleHeight a owl:Class ;
    rdfs:label "scale height"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:SeaState a owl:Class ;
    rdfs:label "sea state"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Ocean ;
            owl:onProperty sorel:hasRealm ],
        sopropsh:Height .

sopropsh:SecchiDepth a owl:Class ;
    rdfs:label "secchi depth"@en ;
    rdfs:comment "The Secchi disk is a device used to measure water transparency in open waters of lakes, bays, and the ocean. A pattern is drawn or painted onto a card or acrylic, mounted on a pole or line, and lowered slowly in the water. The depth at which the pattern on the disk is no longer visible is taken as a measure of the transparency of the water. This measure is known as the Secchi depth and is related to water turbidity."@en ;
    rdfs:subClassOf sopropq:RadiationMediumInteractionQuantity,
        sopropsh:Depth .

sopropsh:SignificantHeight a owl:Class ;
    rdfs:label "significant height"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:SkinDepth a owl:Class ;
    rdfs:label "skin depth"@en ;
    rdfs:subClassOf sopropsh:Depth .

sopropsh:TopographicProminence a owl:Class ;
    rdfs:label "topographic prominence"@en ;
    rdfs:comment "In topography, prominence, also known as autonomous height, relative height or shoulder drop (in America) or prime factor (in Europe), is a concept used in the categorization of hills and mountains, also known as peaks. It is a measure of the independent stature of a summit."@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:UpperLevel a owl:Class ;
    rdfs:label "upper level"@en ;
    rdfs:subClassOf sopropsh:Level .

sopropsl:CenterOfMass a owl:Class ;
    rdfs:label "center of mass"@en ;
    rdfs:subClassOf sopropsl:Center .

sopropsl:ControlPoint a owl:Class ;
    rdfs:label "control point"@en ;
    rdfs:subClassOf sopropsl:Location .

sopropsl:Epicenter a owl:Class ;
    rdfs:label "epicenter"@en ;
    rdfs:subClassOf sopropsl:Center .

sopropsl:Focii a owl:Class ;
    rdfs:label "focii"@en ;
    owl:equivalentClass sopropsl:Focus .

sopropsl:LagrangianPoint a owl:Class ;
    rdfs:label "lagrangian point"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsy:Equilibrium ;
            owl:onProperty sorel:hasState ],
        sopropsl:Location .

sopropsl:MirrorPoint a owl:Class ;
    rdfs:label "mirror point"@en ;
    rdfs:subClassOf sopropsl:Location .

sopropsl:Nadir a owl:Class ;
    rdfs:label "nadir"@en ;
    rdfs:subClassOf sopropsl:Location .

sopropsl:SubsolarPoint a owl:Class ;
    rdfs:label "subsolar point"@en ;
    rdfs:subClassOf sopropsl:Location .

sopropsm:Capacity a owl:Class ;
    rdfs:label "capacity"@en ;
    rdfs:subClassOf sopropsm:Volume .

sopropsm:CarbonFootprint a owl:Class ;
    rdfs:label "carbon footprint"@en ;
    rdfs:subClassOf sopropsm:Footprint .

sopropsm:FieldOfView a owl:Class ;
    rdfs:label "field of view"@en ;
    rdfs:subClassOf sopropsm:AngularExtent .

sopropsm:RadarCrossSection a owl:Class ;
    rdfs:label "radar cross section"@en ;
    rdfs:comment "Radar cross section (RCS) describes the extent to which an object reflects an incident electromagnetic wave. It is a measure of the strength of the radar signal backscattered from a target object for a given incident wave power.."@en ;
    rdfs:subClassOf sopropq:RadiationMediumInteractionQuantity,
        sopropsm:CrossSection .

sopropsm:Resolution a owl:Class ;
    rdfs:label "resolution"@en ;
    rdfs:subClassOf sopropsm:AngularExtent .

sopropst:AnnualHalfPotentialEvapotranspiration a sopropst:HalfPotentialEvapotranspiration,
        owl:NamedIndividual ;
    rdfs:label "annual half potential evapotranspiration"@en .

sopropst:AnnualPotentialEvapotranspiration a sopropst:PotentialEvapotranspiration,
        owl:NamedIndividual ;
    rdfs:label "annual potential evapotranspiration"@en .

sopropst:EquivalentThickness a owl:Class ;
    rdfs:label "equivalent thickness"@en ;
    rdfs:subClassOf sopropst:Thickness .

sopropst:GaugeHeight a owl:Class ;
    rdfs:label "gauge height"@en ;
    rdfs:subClassOf sopropst:WaterHeight .

sopropst:HydraulicHead a owl:Class ;
    rdfs:label "hydraulic head"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Liquid ;
            owl:onProperty sorel:hasState ],
        sopropst:FluidHead .

sopropst:LWE a owl:Class ;
    rdfs:label "lwe"@en ;
    owl:equivalentClass sopropst:LiquidWaterEquivalent .

sopropst:LakeStage a owl:Class ;
    rdfs:label "lake stage"@en ;
    rdfs:subClassOf sopropst:StageHeight .

sopropst:OpticalDepth a owl:Class ;
    rdfs:label "optical depth"@en ;
    rdfs:comment "The optical thickness measured vertically above some given altitude.  Optical depth is dimensionless and may be used to specify many different radiative characteristics of the atmosphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:dimensionlessUnit ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:RadiationMediumInteractionQuantity ;
    owl:equivalentClass sopropst:OpticalThickness .

sopropst:PrecipitableWater a owl:Class ;
    rdfs:label "precipitable water"@en ;
    rdfs:comment "The total atmospheric water vapor contained in a vertical column of unit cross-sectional area extending between any two specified levels."@en ;
    rdfs:subClassOf sopropst:WaterContent .

sopropst:PressureThickness a owl:Class ;
    rdfs:label "pressure thickness"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropp:Pressure ;
            owl:onProperty sorel:hasProcess ],
        sopropst:Thickness .

sopropst:SWE a owl:Class ;
    rdfs:label "swe"@en ;
    owl:equivalentClass sopropst:SnowWaterEquivalent .

sopropst:Snowpack a owl:Class ;
    rdfs:label "snowpack"@en ;
    rdfs:subClassOf sopropst:SnowCover .

sopropst:StaticHead a owl:Class ;
    rdfs:label "static head"@en ;
    rdfs:subClassOf sopropst:FluidHead .

sopropst:StreamStage a owl:Class ;
    rdfs:label "stream stage"@en ;
    rdfs:subClassOf sopropst:StageHeight .

sopropst:TotalHead a owl:Class ;
    rdfs:label "total head"@en ;
    rdfs:subClassOf sopropst:FluidHead .

sopropsp:Airspeed a owl:Class ;
    rdfs:label "airspeed"@en ;
    rdfs:comment "Airspeed is the speed of an aircraft relative to the air. There are several different measures of airspeed: indicated airspeed, calibrated airspeed, equivalent airspeed and true airspeed."@en ;
    rdfs:subClassOf sopropsp:Speed .

sopropsp:AlfvenVelocity a owl:Class ;
    rdfs:label "alfven velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:DopplerVelocity a owl:Class ;
    rdfs:label "doppler velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:EscapeVelocity a owl:Class ;
    rdfs:label "escape velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:GroundSpeed a owl:Class ;
    rdfs:label "ground speed"@en ;
    rdfs:comment "Ground speed is the speed of an aircraft relative to the ground. It is the sum of the aircraft's true airspeed and the current wind and weather conditions; a headwind subtracts from the ground speed, while a tailwind adds to it. Winds at other angles to the heading will have components of either headwind or tailwind as well as a crosswind component."@en ;
    rdfs:subClassOf sopropsp:Speed .

sopropsp:GroupVelocity a owl:Class ;
    rdfs:label "group velocity"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropsp:Velocity .

sopropsp:Inertia a owl:Class ;
    rdfs:label "inertia"@en ;
    rdfs:subClassOf sopropsp:Momentum .

sopropsp:IonVelocity a owl:Class ;
    rdfs:label "ion velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:MagnetiCurvatureDrift a owl:Class ;
    rdfs:label "magneti curvature drift"@en ;
    rdfs:subClassOf sopropq:ElectromagneticQuantity,
        sopropsp:Drift .

sopropsp:NeutralVelocity a owl:Class ;
    rdfs:label "neutral velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:Omega a owl:Class ;
    rdfs:label "omega"@en ;
    rdfs:subClassOf sopropsp:VerticalVelocity .

sopropsp:PhaseVelocity a owl:Class ;
    rdfs:label "phase velocity"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        sopropsp:Velocity .

sopropsp:ProperMotion a owl:Class ;
    rdfs:label "proper motion"@en ;
    rdfs:subClassOf sopropsp:Speed .

sopropsp:RadialVelocity a owl:Class ;
    rdfs:label "radial velocity"@en ;
    rdfs:comment "The component of a three-dimensional velocity vector oriented along the radial direction from the origin point or axis in polar, cylindrical, or spherical coordinates.  In connection with Doppler radar, the radial velocity component is called Doppler velocity."@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:SeepageVelocity a owl:Class ;
    rdfs:label "seepage velocity"@en ;
    rdfs:subClassOf soprop:HydrogeologicalProperty,
        sopropsp:Velocity .

sopropsp:TangentialAcceleration a owl:Class ;
    rdfs:label "tangential acceleration"@en ;
    rdfs:comment "The component of the acceleration directed along the velocity vector (streamline), with magnitude equal to the rate of change of speed of the parcel dV/dt, where V is the speed."@en ;
    rdfs:subClassOf sopropsp:Acceleration .

sopropsp:TerminalVelocity a owl:Class ;
    rdfs:label "terminal velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:ThermalVelocity a owl:Class ;
    rdfs:label "thermal velocity"@en ;
    rdfs:subClassOf sopropsp:Velocity .

sopropsp:WindShear a owl:Class ;
    rdfs:label "wind shear"@en ;
    rdfs:subClassOf soprop:FluidProperty .

sopropt:AntennaTemperature a owl:Class ;
    rdfs:label "antenna temperature"@en ;
    rdfs:comment "Antenna temperature is a way of expressing the brightness of a radiation source - it is proportional to the power per unit area emitted by the source. In most cases where it is used it corresponds to the thermodynamic or physical temperature of the source being observed. It thus relates the power emitted by the source to an interesting physical property of that source."@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:BoilingPoint a owl:Class ;
    rdfs:label "boiling point"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:BrightnessTemperature a owl:Class ;
    rdfs:label "brightness temperature"@en ;
    rdfs:comment "A descriptive measure of radiation in terms of the temperature of a hypothetical blackbody emitting an identical amount of radiation at the same wavelength."@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:DewPoint a owl:Class ;
    rdfs:label "dew point"@en ;
    rdfs:comment "The temperature to which a given air parcel must be cooled at constant pressure and constant water vapor content in order for saturation to occur."@en ;
    rdfs:subClassOf sopropt:Temperature ;
    owl:equivalentClass sopropt:DewPointTemperature .

sopropt:DewPointDepression a owl:Class ;
    rdfs:label "dew point depression"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:DryBulbTemperature ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sopropt:DewPointTemperature ;
            owl:onProperty sorelm:hasSecondOperand ],
        sopropt:Temperature,
        sorepmo:Subtraction .

sopropt:EffectiveTemperature a owl:Class ;
    rdfs:label "effective temperature"@en ;
    rdfs:comment "The temperature at which motionless saturated air would induce, in a sedentary worker wearing ordinary indoor clothing, the same sensation of comfort as that induced by the actual conditions of temperature, humidity, and air movement. Effective temperature is used as a guide in air-conditioning practice, and, on the comfort chart (American Society of Heating and Air Conditioning Engineers), it appears as a family of curves that serves as one coordinate in defining comfort zones."@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:ElectronTemperature a owl:Class ;
    rdfs:label "electron temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapa:Electron ;
            owl:onProperty sorelch:hasSubstance ],
        sopropt:Temperature .

sopropt:GlobalWarmingPotential a owl:Class ;
    rdfs:label "global warming potential"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:IonTemperature a owl:Class ;
    rdfs:label "ion temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:IonizedState ;
            owl:onProperty sorel:hasState ],
        sopropt:Temperature .

sopropt:KineticTemperature a owl:Class ;
    rdfs:label "kinetic temperature"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:MeltingPoint a owl:Class ;
    rdfs:label "melting point"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:NeutralTemperature a owl:Class ;
    rdfs:label "neutral temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:NeutralState ;
            owl:onProperty sorel:hasState ],
        sopropt:Temperature .

sopropt:PseudoEquivalentPotentialTemperature a owl:Class ;
    rdfs:label "pseudo equivalent potential temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:EquivalentPotentialTemperature ;
            owl:onProperty sorelm:approximates ],
        sopropt:Temperature .

sopropt:PseudoEquivalentTemperature a owl:Class ;
    rdfs:label "pseudo equivalent temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:EquivalentTemperature ;
            owl:onProperty sorelm:approximates ],
        sopropt:Temperature .

sopropt:StaticTemperature a owl:Class ;
    rdfs:label "static temperature"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:TotalTemperature a owl:Class ;
    rdfs:label "total temperature"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:TriplePoint a owl:Class ;
    rdfs:label "triple point"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:VirtualPotentialTemperature a owl:Class ;
    rdfs:label "virtual potential temperature"@en ;
    rdfs:subClassOf sopropt:PotentialTemperature .

sopropt:VirtualTemperature a owl:Class ;
    rdfs:label "virtual temperature"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:WetBulbPotentialTemperature a owl:Class ;
    rdfs:label "wet bulb potential temperature"@en ;
    rdfs:comment "The temperature an air parcel would have if cooled from its initial state adiabatically to saturation, and thence brought to 1000 mb by a moist-adiabatic process."@en ;
    rdfs:subClassOf sopropt:PotentialTemperature .

sopropt:WetBulbTemperature a owl:Class ;
    rdfs:label "wet bulb temperature"@en ;
    rdfs:subClassOf sopropt:Temperature .

sopropt:WindChill a owl:Class ;
    rdfs:label "wind chill"@en ;
    owl:equivalentClass sopropt:WindChillIndex .

soproptg:AutoConvectiveLapseRate a owl:Class ;
    rdfs:label "auto convective lapse rate"@en ;
    rdfs:comment "The environmental lapse rate of temperature in an atmosphere in which the density is constant with height (homogeneous atmosphere), equal to g/R, where g is the acceleration of gravity and R the gas constant."@en ;
    rdfs:subClassOf soproptg:EnvironmentalLapseRate .

soproptg:DryAdiabaticLapseRate a owl:Class ;
    rdfs:label "dry adiabatic lapse rate"@en ;
    rdfs:comment "A process lapse rate of temperature, the rate of decrease of temperature with height of a parcel of dry air lifted by a reversible adiabatic process through an atmosphere in hydrostatic equilibrium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostth:DryAdiabatic ;
            owl:onProperty sorel:hasState ],
        soproptg:LapseRate .

soproptg:TemperatureDepthDerivative a owl:Class ;
    rdfs:label "temperature depth derivative"@en ;
    rdfs:comment "The derivative of temperature with respect to depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropsh:Depth ;
            owl:onProperty sorelm:derivativeWithRespectTo ],
        soproptg:TemperatureGradient .

soproptg:ThermalProfile a owl:Class ;
    rdfs:label "thermal profile"@en ;
    rdfs:subClassOf sopropq:ThermodynamicQuantity,
        sorepmf:Profile .

sopropti:Age a owl:Class ;
    rdfs:label "age"@en ;
    rdfs:subClassOf owlt:ProperInterval .

sopropti:CurrentTime a owl:Class ;
    rdfs:label "current time"@en ;
    rdfs:subClassOf owlt:Instant .

sopropti:Cycle a owl:Class ;
    rdfs:label "cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropti:Period ;
            owl:onProperty sorelt:hasTime ],
        owlt:ProperInterval .

sopropti:DoublingTime a owl:Class ;
    rdfs:label "doubling time"@en ;
    rdfs:subClassOf sopropti:Duration .

sopropti:EFoldingTime a owl:Class ;
    rdfs:label "e folding time"@en ;
    rdfs:subClassOf sopropti:Duration .

sopropti:Episode a owl:Class ;
    rdfs:label "episode"@en ;
    rdfs:subClassOf sopropti:Exposure ;
    owl:equivalentClass sopropti:Episodic .

sopropti:GeologicTime a owl:Class ;
    rdfs:label "geologic time"@en ;
    rdfs:comment "The geologic time scale is a chronologic schema (or idealized model) relating stratigraphy to time that is used by geologists, paleontologists and other earth scientists to describe the timing and relationships between events that have occurred during the history of the Earth.  [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:MYA ;
            owl:onProperty sorelsc:hasUnit ],
        sorept:TimeReference .

sopropti:Hydroperiod a owl:Class ;
    rdfs:label "hydroperiod"@en ;
    rdfs:subClassOf sopropti:Period .

sopropti:Latency a owl:Class ;
    rdfs:label "latency"@en ;
    rdfs:subClassOf sopropti:Delay .

sopropti:Repose a owl:Class ;
    rdfs:label "repose"@en ;
    rdfs:comment "The interval of time between volcanic eruptions."@en ;
    rdfs:subClassOf owlt:Interval .

sopropti:ResidenceTime a owl:Class ;
    rdfs:label "residence time"@en ;
    rdfs:subClassOf sopropti:Duration .

sopropti:TemporalExtent a owl:Class ;
    rdfs:label "temporal extent"@en ;
    rdfs:subClassOf sorept:TemporalEntity .

sopropti:TimePeriod a owl:Class ;
    rdfs:label "time period"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorept:Time ;
            owl:onProperty sorelt:hasEndTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom sopropti:Time ;
            owl:onProperty sorelt:hasStartTime ],
        sopropti:Duration .

sopropti:TimeStep a owl:Class ;
    rdfs:label "time step"@en ;
    rdfs:subClassOf sopropti:Duration .

sopropti:Timestamp a owl:Class ;
    rdfs:label "timestamp"@en ;
    rdfs:subClassOf owlt:Instant .

soproptf:Bandwidth a owl:Class ;
    rdfs:label "bandwidth"@en ;
    rdfs:subClassOf soprop:WaveProperty,
        soproptf:Frequency .

soproptf:BruntVaisalaFrequency a owl:Class ;
    rdfs:label "brunt vaisala frequency"@en ;
    rdfs:comment "The frequency at which a displaced parcel will oscillate when displaced vertically within a statically stable environment."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:StaticStability ;
            owl:onProperty sorelsc:measureOf ],
        soproptf:Frequency .

soproptf:Cadence a owl:Class ;
    rdfs:label "cadence"@en ;
    rdfs:subClassOf soproptf:Frequency .

soproptf:Fertility a owl:Class ;
    rdfs:label "fertility"@en ;
    rdfs:subClassOf soproptf:Rate .

soproptf:Incidence a owl:Class ;
    rdfs:label "incidence"@en ;
    rdfs:subClassOf soproptf:Frequency .

soproptf:SpreadingRate a owl:Class ;
    rdfs:label "spreading rate"@en ;
    rdfs:comment "The spreading rate is a measure of how fast plate divergence is occurring. [Wikipedia]"@en ;
    rdfs:subClassOf soproptf:Rate .

sorea:Cryosphere a owl:Class ;
    rdfs:label "cryosphere"@en ;
    rdfs:comment "The cryosphere collectively describes the portions of a planetary surface in frozen form, including sea ice, lake ice, river ice, snow cover, glaciers, ice caps and ice sheets, and frozen ground (which includes permafrost).  [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:Ice ;
            owl:onProperty sorelch:hasSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        sorea:Hydrosphere .

sorea:GlobalPlanetaryLayer a owl:Class ;
    rdfs:label "global planetary layer"@en ;
    owl:equivalentClass sorea:PlanetaryLayer .

sorea:Ring a owl:Class ;
    rdfs:label "ring"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        sorea:PlanetaryRealm .

soreaab:Asteroid a owl:Class ;
    rdfs:label "asteroid"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

soreaab:Comet a owl:Class ;
    rdfs:label "comet"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

soreaab:Extraterrestrial a owl:Class ;
    rdfs:label "extraterrestrial"@en ;
    rdfs:comment "A body or substance which does not originate from Earth. [Wikipedia]"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

soreaab:Galaxy a owl:Class ;
    rdfs:label "galaxy"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

soreaab:Moon a owl:Class ;
    rdfs:label "moon"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaab:Planet ;
            owl:onProperty sorelph:revolvesAround ],
        soreaab:AstronomicalBody .

soreaab:Satellite a owl:Class ;
    rdfs:label "satellite"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

soreaah:Heliopause a owl:Class ;
    rdfs:label "heliopause"@en ;
    rdfs:subClassOf sorea:PlanetarySurfaceLevel .

soreaah:Magnetosphere a owl:Class ;
    rdfs:label "magnetosphere"@en ;
    rdfs:subClassOf sorea:PlanetaryLayer .

soreaah:Plasmasphere a owl:Class ;
    rdfs:label "plasmasphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Plasma ;
            owl:onProperty sorel:hasState ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom soreaah:LowerHeliosphere ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreaah:Plasmapause ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        sorea:PlanetaryLayer .

soreaah:RadiationBelt a owl:Class ;
    rdfs:label "radiation belt"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaah:Heliosphere ;
            owl:onProperty sorel:hasRealm ],
        sorea:PlanetaryLayer ;
    owl:equivalentClass soreaah:VanAllenBelt .

soreaah:UpperHeliosphere a owl:Class ;
    rdfs:label "upper heliosphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaah:Heliosphere ;
            owl:onProperty sorel:hasRealm ],
        sorea:PlanetaryLayer .

soreaas:ActiveRegion a owl:Class ;
    rdfs:label "active region"@en ;
    rdfs:subClassOf soreaas:StellarRealm .

soreaas:Chromosphere a owl:Class ;
    rdfs:label "chromosphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Plasma ;
            owl:onProperty sorel:hasState ],
        soreaas:StellarAtmosphere .

soreaas:ConvectionZone a owl:Class ;
    rdfs:label "convection zone"@en ;
    rdfs:subClassOf soreaas:StellarInterior ;
    owl:disjointWith soreaas:StellarCore .

soreaas:Photosphere a owl:Class ;
    rdfs:label "photosphere"@en ;
    rdfs:subClassOf soreaas:StellarAtmosphere .

soreaas:RadiativeZone a owl:Class ;
    rdfs:label "radiative zone"@en ;
    rdfs:subClassOf soreaas:StellarInterior .

soreaas:Tacocline a owl:Class ;
    rdfs:label "tacocline"@en ;
    rdfs:subClassOf soreaas:StellarInterior .

soreaa:FreeTroposphere a owl:Class ;
    rdfs:label "free troposphere"@en ;
    rdfs:subClassOf soreaa:Troposphere .

soreaa:InversionLayer a owl:Class ;
    rdfs:label "inversion layer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophfi:Inversion ],
        soreaa:AtmosphereLayer ;
    owl:equivalentClass soreaa:TemperatureInversionLayer .

soreaa:JungeAerosolLayer a owl:Class ;
    rdfs:label "junge aerosol layer"@en ;
    rdfs:comment "A maximum in large-particle concentrations observed in the lower stratosphere between 15 and 25 km."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaae:Aerosol ;
            owl:onProperty sorelch:hasSubstance ],
        soreaa:AtmosphereLayer .

soreaa:LowerAtmosphere a owl:Class ;
    rdfs:label "lower atmosphere"@en ;
    rdfs:subClassOf soreaa:AtmosphereLayer .

soreaa:MiddleAtmosphere a owl:Class ;
    rdfs:label "middle atmosphere"@en ;
    rdfs:subClassOf soreaa:AtmosphereLayer ;
    owl:equivalentClass soreaa:OzoneLayer .

soreaa:UpperAtmosphere a owl:Class ;
    rdfs:label "upper atmosphere"@en ;
    rdfs:subClassOf soreaa:AtmosphereLayer .

soreaabl:Cap a owl:Class ;
    rdfs:label "cap"@en ;
    rdfs:comment "A region of negative buoyancy below an existing level of free convection (LFC) where energy must be supplied to the parcel to maintain its ascent."@en ;
    rdfs:subClassOf sopropsh:Level .

soreaabl:ConstantFluxLayer a owl:Class ;
    rdfs:label "constant flux layer"@en ;
    rdfs:comment "A layer of air tens of meters thick at the bottom of the atmosphere where the variation of vertical turbulent flux with altitude is less than 10% of its magnitude."@en ;
    rdfs:subClassOf soreaabl:AtmosphericBoundaryLayer .

soreaabl:MechanicalInternalBoundaryLayer a owl:Class ;
    rdfs:label "mechanical internal boundary layer"@en ;
    rdfs:comment "(Abbreviated MIBL.) An internal boundary layer caused by advection of air across a discontinuity in surface roughness. When the new surface is rougher than the old one, the MIBL depth grows roughly as the 0.8 power of the ratio of the two roughness lengths. In this example, the MIBL grows to include the whole surface layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophft:Advection ;
            owl:onProperty sorel:hasPhenomena ],
        soreaabl:InternalBoundaryLayer .

soreaabl:NocturnalBoundaryLayer a owl:Class ;
    rdfs:label "nocturnal boundary layer"@en ;
    rdfs:comment "The cool layer of air adjacent to the ground that forms at night. At night under clear skies, radiation to space cools the land surface, which in turn cools the adjacent air through processes of molecular conduction, turbulence, and radiative transfer. This causes a stable boundary layer to form and grow to depths of a few hundreds of meters, depending on the season. Many interacting processes can occur within the statically stable nocturnal boundary layer: patchy sporadic turbulence, internal gravity waves, drainage flows, inertial oscillations, and nocturnal jets."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophatmo:NocturnalCooling ],
        soreaabl:BoundaryLayer .

soreaabl:OuterLayer a owl:Class ;
    rdfs:label "outer layer"@en ;
    rdfs:comment "For flow over a hill, the top layer in the boundary layer that accelerates relative to its upstream value due to the Bernoulli effect."@en ;
    rdfs:subClassOf soreaabl:BoundaryLayer .

soreaabl:ResidualLayer a owl:Class ;
    rdfs:label "residual layer"@en ;
    rdfs:comment "The middle portion of the nocturnal atmospheric boundary layer characterized by weak sporadic turbulence and initially uniformly mixed potential temperature and pollutants remaining from the mixed layer of the previous day."@en ;
    rdfs:subClassOf soreaabl:AtmosphericBoundaryLayer .

soreaabl:RoughnessSublayer a owl:Class ;
    rdfs:label "roughness sublayer"@en ;
    rdfs:comment "Same as transition layer. The lowest atmospheric layer immediately adjacent to a surface covered with relatively large roughness elements such as stones, vegetation, trees, or buildings."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostso:Rough ;
            owl:onProperty sorel:hasState ],
        soreaabl:AtmosphericBoundaryLayer .

soreaabl:SkinLayer a owl:Class ;
    rdfs:label "skin layer"@en ;
    rdfs:subClassOf soreaabl:AtmosphericBoundaryLayer .

soreaabl:StableBoundaryLayer a owl:Class ;
    rdfs:label "stable boundary layer"@en ;
    rdfs:subClassOf soreaabl:AtmosphericBoundaryLayer .

soreaabl:WellMixedLayer a owl:Class ;
    rdfs:label "well mixed layer"@en ;
    rdfs:comment "A type of atmospheric boundary layer characterized by vigorous turbulence tending to stir and uniformly mix, primarily in the vertical, quantities such as conservative tracer concentrations, potential temperature, and momentum or wind speed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophm:Mixing ;
            owl:onProperty sorel:hasPhenomena ],
        soreaabl:AtmosphericBoundaryLayer .

soreaaw:AdiabaticCondensationLevel a owl:Class ;
    rdfs:label "adiabatic condensation level"@en ;
    rdfs:subClassOf soreaaw:CondensationLevel .

soreaaw:CloudBase a owl:Class ;
    rdfs:label "cloud base"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaaw:CloudTop a owl:Class ;
    rdfs:label "cloud top"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaaw:ConvectiveCloudBase a owl:Class ;
    rdfs:label "convective cloud base"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaaw:ConvectiveCloudTop a owl:Class ;
    rdfs:label "convective cloud top"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaaw:ConvectiveCondensationLevel a owl:Class ;
    rdfs:label "convective condensation level"@en ;
    rdfs:comment "On a thermodynamic diagram, the point of intersection of a sounding curve (representing the vertical distribution of temperature in an atmospheric column) with the saturation mixing ratio line corresponding to the average mixing ratio in the surface layer."@en ;
    rdfs:subClassOf soreaaw:CondensationLevel .

soreaaw:FreeConvectiveLayer a owl:Class ;
    rdfs:label "free convective layer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:FreeInstability ;
            owl:onProperty sorel:hasPhenomena ],
        soreaa:AtmosphereLayer .

soreaaw:FreezingLevel a owl:Class ;
    rdfs:label "freezing level"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena,
        sorea:PlanetarySurfaceLevel .

soreaaw:LFC a owl:Class ;
    rdfs:label "lfc"@en ;
    rdfs:comment "Level of free convection"@en ;
    rdfs:subClassOf sorea:PlanetarySurfaceLevel ;
    owl:equivalentClass soreaaw:LevelOfFreeConvection .

soreaaw:MaximumWindSpeedLevel a owl:Class ;
    rdfs:label "maximum wind speed level"@en ;
    rdfs:subClassOf sorea:PlanetarySurfaceLevel .

soreaaw:MeltingLayer a owl:Class ;
    rdfs:label "melting layer"@en ;
    rdfs:comment "The altitude interval throughout which ice-phase precipitation melts as it descends. The top of the melting layer is the melting level. The melting layer may be several hundred meters deep, reflecting the time it takes for all the hydrometeors to undergo the transition from solid to liquid phase. The temperature of the melting layer is typically 0?C or slightly warmer. See bright band."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Melting ;
            owl:onProperty sorelph:hasStateChange ],
        sorea:PlanetaryLayer .

soreaaw:MeltingLevel a owl:Class ;
    rdfs:label "melting level"@en ;
    rdfs:comment "The altitude at which ice crystals and snowflakes begin to melt as they descend through the atmosphere. In cloud physics and in radar meteorology, this is the accepted term for the 0?C constant-temperature surface (see bright band). It is physically more apt than the corresponding operational term, freezing level, for melting of pure ice must begin very near 0?C, but freezing of liquid water can occur over a broad range of temperatures (between 0? and -40?C; see supercooling). See also freezing point, ice point, melting point."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Melting ;
            owl:onProperty sorelph:hasStateChange ],
        sorea:PlanetarySurfaceLevel .

soreaaw:SnowGeneratingLevel a owl:Class ;
    rdfs:label "snow generating level"@en ;
    rdfs:comment "A layer in the middle or upper troposphere in widespread precipitation in which ice crystals form in small convective cells and fall to lower altitudes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Snowfall ;
            owl:onProperty sorel:hasPhenomena ],
        sorea:PlanetarySurfaceLevel .

soreaaw:ZoneOfMaximumPrecipitation a owl:Class ;
    rdfs:label "zone of maximum precipitation"@en ;
    rdfs:comment "The elevation band on a mountain or orographic barrier that receives the greatest precipitation for a seasonal or annual average."@en ;
    rdfs:subClassOf soreaa:AtmosphereLayer .

soreabb:Anthromes a owl:Class ;
    rdfs:label "anthromes"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostb:Anthropogenic ;
            owl:onProperty sorelh:hasLandUse ],
        soreabb:TerrestrialBiome .

soreabb:Barren a owl:Class ;
    rdfs:label "barren"@en ;
    rdfs:subClassOf soreabb:Wildlands .

soreabb:Biota a owl:Class ;
    rdfs:label "biota"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:BorealForest a owl:Class ;
    rdfs:label "boreal forest"@en ;
    rdfs:subClassOf soreabb:Taiga .

soreabb:CaveEcosystem a owl:Class ;
    rdfs:label "cave ecosystem"@en ;
    rdfs:subClassOf soreabb:TerrestrialEcosystem .

soreabb:CoralReef a owl:Class ;
    rdfs:label "coral reef"@en ;
    rdfs:comment "The term coral reef generally refers to a marine ecosystem in which the main organisms are corals that house algal symbionts within their tissues. These ecosystems require: 1) fully marine waters; 2) warm temperatures; and 3) ample sunlight. They are therefore restricted to shallow waters of tropical and subtropical regions. Corals that do not have algal symbionts can also form significant reef communities in deeper, darker, and colder waters, but these communities are distinguished as cold-water coral bioherms. The more technical definition of coral reef includes an additional geological requirement that the reef organisms produce enough calcium carbonate to build the physical reef structure. The coral reef community lives only on the surface veneer of the reef, on top of already existing skeletal material left behind by previous reef-builders. Many processes act to break down the skeletal material and reef as soon it is laid down by organisms. These include mechanical processes such as waves and currents, and a wide array of biological processes (e.g., bioerosion). Some of the best known bioeroders are large organisms such as parrotfish and sponges, but much of the bioerosion occurs at the microscopic scale by organisms such as algae and fungi. A coral reef is produced only if the coral reef community produces more calcium carbonate than is removed. Indeed, some coral reef communities grow too slowly to build a reef."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soman:Coral ;
            owl:onProperty sorelsc:hasSpecies ],
        soreabb:MarineEcosystem .

soreabb:Croplands a owl:Class ;
    rdfs:label "croplands"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:DenseSettlements a owl:Class ;
    rdfs:label "dense settlements"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:EmergentLayer a owl:Class ;
    rdfs:label "emergent layer"@en ;
    rdfs:comment "An irregular zone of extremely tall trees, rising above the mean canopy"@en ;
    rdfs:subClassOf soreabb:TerrestrialEcosystem .

soreabb:Fishery a owl:Class ;
    rdfs:label "fishery"@en ;
    rdfs:subClassOf soreabb:AquaticEcosystem .

soreabb:Forested a owl:Class ;
    rdfs:label "forested"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:FreshwaterEcosystem a owl:Class ;
    rdfs:label "freshwater ecosystem"@en ;
    rdfs:subClassOf soreabb:AquaticEcosystem ;
    owl:disjointWith soreabb:MarineEcosystem .

soreabb:Montane a owl:Class ;
    rdfs:label "montane"@en ;
    rdfs:comment "Montane is a biogeographic term which refers to highland areas located below the subalpine zone.[1] Montane regions generally have cooler temperatures and often have higher rainfall than the adjacent lowland regions, and are frequently home to distinct communities of plants and animals. [Wikipedia]"@en ;
    rdfs:subClassOf soreabb:TerrestrialEcosystem .

soreabb:Pasture a owl:Class ;
    rdfs:label "pasture"@en ;
    rdfs:subClassOf soreabb:TerrestrialEcosystem .

soreabb:Rangelands a owl:Class ;
    rdfs:label "rangelands"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:Savanna a owl:Class ;
    rdfs:label "savanna"@en ;
    rdfs:comment "A savanna or savannah is a tropical or subtropical woodland ecosystem. Savannas are characterised by the trees being sufficiently small or widely spaced so that the canopy does not close. It is often believed that savannas are characterized by widely spaced, scattered trees, however in many savanna communities tree densities are higher and trees are more regularly spaced than in forest communities. The open canopy allows sufficient light to reach the ground to support an unbroken herbaceous layer consisting primarily of C4 grasses. Savannas are also characterised by seasonal water availability, with the majority of rainfall being confined to one season of the year. Savannas can be associated with several types of biomes. Savannas are frequently seen as a transitional zone, occurring between forest regions and desert regions."@en ;
    rdfs:subClassOf soreabb:TerrestrialEcosystem .

soreabb:Scrubland a owl:Class ;
    rdfs:label "scrubland"@en ;
    rdfs:comment "Scrubland is plant community characterized by scrub vegetation. Scrub consists of low shrubs, mixed with grasses, herbs, and geophytes. Scrublands are sometimes known as heathlands. Scrublands may be either naturally occurring or the result of human activity. They may be the mature vegetation type in a particular region and remain stable over time, or a transitional community that occurs temporarily as the result of a disturbance, such as a major fire. Many people do not live in scrubland because of the fires that can easily occur."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapl:Scrub ;
            owl:onProperty sorelsc:hasSpecies ],
        soreabb:TerrestrialEcosystem .

soreabb:SeaGrass a owl:Class ;
    rdfs:label "sea grass"@en ;
    rdfs:subClassOf soreabb:AquaticEcosystem .

soreabb:SparseTrees a owl:Class ;
    rdfs:label "sparse trees"@en ;
    rdfs:subClassOf soreabb:Wildlands .

soreabb:Steppe a owl:Class ;
    rdfs:label "steppe"@en ;
    rdfs:subClassOf soreabb:Grassland .

soreabb:TemperateForest a owl:Class ;
    rdfs:label "temperate forest"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreacz:C ;
            owl:onProperty sorelcl:hasClimateZone ],
        soreabb:Forest .

soreabb:Terrain a owl:Class ;
    rdfs:label "terrain"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:TropicalForest a owl:Class ;
    rdfs:label "tropical forest"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue soreacz:TropicalRainForestClimate ;
            owl:onProperty sorelcl:hasClimateZone ],
        soreabb:Forest .

soreabb:Villages a owl:Class ;
    rdfs:label "villages"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreabb:Woodland a owl:Class ;
    rdfs:label "woodland"@en ;
    rdfs:subClassOf soreabb:Forest .

soreacz:Af a soreacz:A,
        owl:NamedIndividual ;
    rdfs:label "af"@en ;
    rdfs:comment "The Af climate classification, also known as the tropical rain forest climate classification, is characterized by monthly precipitation in excess of 6 cm all months out of year."@en ;
    owl:sameAs soreacz:TropicalRainForestClimate .

soreacz:Am a soreacz:A,
        owl:NamedIndividual ;
    rdfs:label "am"@en ;
    rdfs:comment "The Am climate classification, also known as Tropical Monsoon Climate, is characterized by a short marked dry season with 1 or more months receiving less than 6 cm of precipitation, an otherwise excessively wet rainy season, and ITCZ dominance for 6 - 12 months out of the year."@en ;
    owl:sameAs soreacz:TropicalMonsoonClimate .

soreacz:Arid a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "arid"@en ;
    owl:sameAs soreacz:BW .

soreacz:AridClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "arid climate"@en ;
    owl:sameAs soreacz:BW .

soreacz:Aw a soreacz:A,
        soreacz:WetSummerDryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "aw"@en ;
    rdfs:comment "The Aw climate classification, also known as Tropical Savanna climate classification, is characterized by a summer wet season, winter dry season, and ITCZ dominance for 6 months or less."@en ;
    owl:sameAs soreacz:TropicalSavannaClimate .

soreacz:BS a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bs"@en ;
    rdfs:comment "The BS climate classification, also known as semiarid climate classification, is characterized by having precipitation amounts greater than 1/2 potential evapotranspiration (POTET), but not equal to it."@en ;
    owl:sameAs soreacz:SemiAridClimate .

soreacz:BSh a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bsh"@en ;
    rdfs:comment "The BSh climate classification, also known as the hot low-latitude steppe, is characterized by having mean annual temperatures greater than 18 degree C."@en ;
    owl:sameAs soreacz:HotLowLatitudeSteppeClimate .

soreacz:BSk a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bsk"@en ;
    rdfs:comment "The BSk climate classification, also known as cold midlatitude steppe climate classification, is characterized by having mean annual temperatures less than 18 degree C."@en ;
    owl:sameAs soreacz:ColdMidlatitudeSteppeClimate .

soreacz:BWh a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bwh"@en ;
    rdfs:comment "the BWh climate classification, also known as the hot low-latitude desert, is characterized by having mean annual temperatures greater than 18 degree C."@en ;
    owl:sameAs soreacz:HotLowLatitudeDesertClimate .

soreacz:BWk a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bwk"@en ;
    rdfs:comment "The BWk climate classification, also known as the cold midlatitude desert, is characterized by having mean annual temperatures less than 18 degree C."@en ;
    owl:sameAs soreacz:ColdMidlatitudeDesertClimate .

soreacz:Cfa a soreacz:C,
        owl:NamedIndividual ;
    rdfs:label "cfa"@en ;
    rdfs:comment "The Cfa climate classification is characterized by year-round precipitation, hot summers, and having the warmest month above 22 degree C."@en .

soreacz:Cfb a soreacz:C,
        owl:NamedIndividual ;
    rdfs:label "cfb"@en ;
    rdfs:comment "The Cfb climate classfication receives year-round precipitation, its warmest month is below 22 degree C and has 4 months above 10 degree C."@en .

soreacz:Csa a soreacz:C,
        owl:NamedIndividual ;
    rdfs:label "csa"@en ;
    rdfs:comment "The Csa climate classification is characterized by pronounced summer droughts with 70% of precipitation in the winter and hot summers with its warmest month above 22 degree C."@en .

soreacz:Csb a soreacz:C,
        soreacz:WetSummerDryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "csb"@en .

soreacz:Cwa a soreacz:C,
        soreacz:WetSummerDryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "cwa"@en ;
    rdfs:comment "the Cwa climate classification is characterized by winter drought, summer's wettest month getting 10 times more precipitation than driest winter month, and the warmest month being above 22 degree C."@en .

soreacz:DesertClimateZone a owl:Class ;
    rdfs:label "desert climate zone"@en ;
    rdfs:subClassOf soreacz:ClimateZoneType .

soreacz:Dfa a soreacz:D,
        owl:NamedIndividual ;
    rdfs:label "dfa"@en ;
    rdfs:comment "The Dfa climate classification is characterized by having year-round precipitation and warmest month temperatures above 22 degree C."@en .

soreacz:Doldrums a owl:Class ;
    rdfs:label "doldrums"@en ;
    rdfs:comment "A nautical term for the equatorial trough, with special reference to the light and variable nature of the winds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorear:LowLatitude ;
            owl:onProperty sorel:hasRealm ],
        soreacz:ClimateZoneType .

soreacz:Dwa a soreacz:D,
        soreacz:DryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "dwa"@en ;
    rdfs:comment "The Dwa climate classification is characterized by winter drought and warmest month temperatures above 22 degree C."@en .

soreacz:Dwb a soreacz:D,
        soreacz:DryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "dwb"@en ;
    rdfs:comment "The Dwb climate classification is characterized by winter drought and warmest month temperatures below 22 degree C."@en .

soreacz:Dwc a soreacz:D,
        soreacz:DryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "dwc"@en ;
    rdfs:comment "The Dwc climate classification is characterized by winter drought and haviong 1 - 4 months with temperatures above 10 degrees C."@en .

soreacz:Dwd a soreacz:D,
        soreacz:DryWinterClimate,
        owl:NamedIndividual ;
    rdfs:label "dwd"@en ;
    rdfs:comment "The Dwd climate classification is characterized by winter drought and having coldest month temperatures below -38 degree C (in Siberia only)."@en .

soreacz:EF a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "ef"@en ;
    rdfs:comment "The EF climate classification, also known as the Ice Cap climate classification, is characterized by having warmest month temperatures below 0 degrees C and having precipitation exceeding very small potential evapotranspiration (POTET)."@en ;
    owl:sameAs soreacz:IceCapClimate .

soreacz:EM a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "em"@en ;
    rdfs:comment "The EM climate classification, also known as the polar marine climate classification, is characterized by all months having temperatures above -7 degree C, warmest month above 0 degree C, and annual temperatures less than 17 degree C."@en ;
    owl:sameAs soreacz:PolarMarineClimate .

soreacz:ET a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "et"@en ;
    rdfs:comment "The ET climate classification, also known as the tundra climate classification, is characterizex by warmest month temperatures between 0 - 10 degree C, precipitation exceeds small potential evapotranspiration demand, and has snow cover 8 - 10 months out of the year."@en ;
    owl:sameAs soreacz:TundraClimate .

soreacz:MarineClimate a owl:Class ;
    rdfs:label "marine climate"@en ;
    rdfs:comment "(Also called maritime climate, oceanic climate.) A regional climate under the predominant influence of the sea, characterized by relatively small seasonal variations and high atmospheric moisture content; the antithesis of a continental climate."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorea:Ocean ],
        soreacz:ClimateClassification .

soreacz:RainShadow a owl:Class ;
    rdfs:label "rain shadow"@en ;
    rdfs:comment "A region of sharply reduced precipitation on the lee side of an orographic barrier, as compared with regions upwind of the barrier."@en ;
    rdfs:subClassOf soreacz:ClimateZoneType .

soreacz:SubtropicalClimateZone a owl:Class ;
    rdfs:label "subtropical climate zone"@en ;
    rdfs:subClassOf soreacz:ClimateZoneType .

soreac:AblationZone a owl:Class ;
    rdfs:label "ablation zone"@en ;
    rdfs:subClassOf soreac:GlacialRegion ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01000914> ;
    skos:definition [ dcterms:created "2019-12-10T06:11:13-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://en.wikipedia.org/wiki/Ablation_zone> ;
            rdfs:comment "An environmental zone which overlaps a glacier or an ice sheet, and in which ice loss exceeds ice gain."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01000914> ] .

soreac:AccumulationZone a owl:Class ;
    rdfs:label "accumulation zone"@en ;
    rdfs:comment "This zone usually occurs at higher elevations and generally overlaps the conversion of snow to glacial ice."@en ;
    rdfs:subClassOf soreac:GlacialRegion ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001352> ;
    skos:definition [ dcterms:created "2019-12-10T06:11:13-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice accumulation zone which overlaps part of a glacier."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001352> ] .

soreac:AlpineTundra a owl:Class ;
    rdfs:label "alpine tundra"@en ;
    rdfs:comment "Alpine tundra is an ecozone that does not contain trees because it has high altitude. Alpine tundra occurs at high enough altitude at any latitude on Earth. Alpine tundra also lacks trees, but the lower part does not have permafrost, and alpine soils are generally better drained than permafrost soils. Alpine tundra transitions to subalpine forests below the tree line; stunted forests occurring at the forest-tundra ecotone are known as Krummholz. Alpine tundra occurs in an alpine zone"@en ;
    rdfs:subClassOf soreac:Tundra ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001371> ;
    skos:definition [ dcterms:created "2019-12-10T06:11:13-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A tundra ecosystem which exists at high altitudes and where vegetation is stunted due to low temperatures and high winds."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001371> ] .

soreac:Calf a owl:Class ;
    rdfs:label "ice calf"@en ;
    rdfs:subClassOf somaw:Ice ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001506> ;
    skos:definition [ dcterms:created "2019-12-10T06:11:13-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which has calved off an larger mass of ice."@en,
                "This definition is intentionally broad to include the multiple existing and used definitions of ice calfs."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001506> ] .

soreac:CongelationIce a owl:Class ;
    rdfs:label "congelation ice"@en ;
    rdfs:comment "Congelation ice usually forms through the fusion/coalescence of platelets into solid ice."@en ;
    rdfs:subClassOf somaw:Ice ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001512> ;
    skos:definition [ dcterms:created "2019-12-10T08:05:43-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "Sea ice which 1) has formed on the submerged surface (i.e. the base) of an existing mass of sea ice and 2) is composed of columnar crystals due to the downward growth of the crystals into the water."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001512> ] .

soreac:Floe a owl:Class ;
    rdfs:label "sea ice floe"@en ;
    rdfs:subClassOf soreac:SeaIce ;
    owl:equivalentClass soreac:IceFloe ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_03000066> ;
    skos:definition [ dcterms:created "2019-12-10T08:54:28-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://nsidc.org/cryosphere/glossary/term/ice-floe> ;
            rdfs:comment "An ice floe which is formed from frozen sea water, and floats upon the surface of a marine water body."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_03000066> ] .

soreac:FrazilIce a owl:Class ;
    rdfs:label "frazil ice"@en ;
    rdfs:comment "Typically 3 to 4 millimeters in diameter. These new ice classes refer to both marine water and fresh water ice. If using this term for annotation, use it in conjunction with another envo term to express whether the ice is in a marine, freshwater, or other system."@en ;
    rdfs:subClassOf soreac:SeaIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_03000046> ;
    skos:definition [ dcterms:created "2019-12-10T08:57:38-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://nsidc.org/cryosphere/glossary/term/frazil> ;
            rdfs:comment "New ice which is composed frazil which has congealed into a thin sheet."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_03000046> ] .

soreac:GlacierTerminus a owl:Class ;
    rdfs:label "glacier terminus"@en ;
    rdfs:subClassOf soreac:GlacialRegion ;
    owl:equivalentClass soreac:Snout ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001529> ;
    skos:definition [ dcterms:created "2019-12-10T09:09:25-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which constitutes that part of a glacier which has the lowest elevation."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001529> ] .

soreac:IceBase a owl:Class ;
    rdfs:label "ice base"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreac:IceCap a owl:Class ;
    rdfs:label "ice cap"@en ;
    rdfs:subClassOf sorea:PlanetaryRealm ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000145> ;
    skos:definition [ dcterms:created "2019-12-10T09:12:52-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://en.wikipedia.org/wiki/Ice_cap> ;
            rdfs:comment "A dome-shaped ice mass that covers less than 50,000 km2 of land area (usually covering a highland area)."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_00000145> ] .

soreac:IceCore a owl:Class ;
    rdfs:label "ice core"@en ;
    rdfs:comment "The composition of an ice core can be used to reconstruct past climates and climate change; typically removed from an ice sheet (Antarctica and Greenland) or from high mountain glaciers elsewhere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsp:inside ;
            owl:someValuesFrom somaw:Ice ],
        sorepsmo:Sample ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001530> ;
    skos:definition [ dcterms:created "2019-12-13T13:58:24-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which has been drilled from an accumulation of snow and ice that has built up over many years and that has recrystallized and has trapped air bubbles from previous time periods."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001530> ] .

soreac:IceField a owl:Class ;
    rdfs:label "ice field"@en ;
    rdfs:subClassOf soreac:SeaIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001531> ;
    skos:definition [ dcterms:created "2019-12-13T14:02:20-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice field which is primarily composoed of sea ice floes greater than 10 kilometers across."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001531> ] .

soreac:IceSheet a owl:Class ;
    rdfs:label "ice sheet"@en ;
    rdfs:comment "An ice sheet is a mass of glacier ice that covers surrounding terrain and is greater than 50,000 square km (19,305 square mile)."@en ;
    rdfs:subClassOf soreac:Glacier ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000132> ;
    skos:definition [ dcterms:created "2020-02-12T12:45:11-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A glacier which covers an area of greater than 50,000 square kilometers."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_00000132> ] .

soreac:IceShelf a owl:Class ;
    rdfs:label "ice shelf"@en ;
    rdfs:comment "An ice shelf may grow hundreds of miles out to sea.  Usually of great horizontal extent and with a level or gently undulating surface. Nourished by annual snow accumulation and also by the seaward extension of land glaciers. Limited areas may be aground. Ice shelves are much thicker than sea ice often filling embayments in the coastline of an ice sheet.. Currently, nearly all ice shelves are in Antarctica, where most of the ice discharged into the ocean flows via ice shelves. The mass balance of an ice shelf may have significant components of both gain and loss at the base. The seaward edge is termed an ice front.  The calving of an ice shelf forms tabular icebergs and ice islands."@en ;
    rdfs:subClassOf somaw:Ice ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000380> ;
    skos:definition [ dcterms:created "2020-02-12T12:52:35-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which 1) is attached to the coast 2) at least 2 meters in thickness 3) forms where a glacier or ice mass flows down to a coastline and onto the ocean surface and 4) grows by annual snow accumulation or by the seaward extension of land glaciers."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_00000380> ] .

soreac:IceSnowInterface a owl:Class ;
    rdfs:label "ice snow interface"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreac:IceStream a owl:Class ;
    rdfs:label "ice stream"@en ;
    rdfs:subClassOf somaw:Ice .

soreac:IceSurface a owl:Class ;
    rdfs:label "ice surface"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001545> ;
    skos:definition [ dcterms:created "2020-02-12T13:05:30-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A two-dimensional fiat ice surface which is composed primarily of water ice."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001545> ] .

soreac:Lead a owl:Class ;
    rdfs:label "lead"@en ;
    rdfs:comment "Generally, leads are wide enough (and deep enough) for navigation by surface vessels. The term is generally applied to linear features. If the open area is very large it may be called a polynya, although the application of these terms is under debate."@en ;
    rdfs:subClassOf soreac:SeaIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001551> ;
    skos:definition [ dcterms:created "2020-02-12T13:21:01-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A surface layer of a water body which has been formed as the result of surface ice fracturing and moving apart."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001551> ] .

soreac:PackIce a owl:Class ;
    rdfs:label "pack ice"@en ;
    rdfs:comment "Has related synonym drift ice. Prior to approximately 2014, pack ice was used for all ranges of drift ice concentrations, thus the terms were in close synonymy." ;
    rdfs:subClassOf soreac:DriftIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001556> ;
    skos:definition [ dcterms:created "2020-02-12T13:39:40-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A drift ice mass which has an ice concentration above or equal to 7/10: which covers 70% or more of a given area of a water body."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001556> ] .

soreac:SeasonalIce a owl:Class ;
    rdfs:label "seasonal ice"@en ;
    rdfs:comment "Sea ice develops from young ice; thickness from 0.3 to 2 meters (1 to 6.6 feet).  Sea ice be subdivided into thin first-year ice (white ice), medium first-year ice, and thick first-year ice.  First-year ice is distinguished from older ice primarily by having a higher salinity. Undeformed first-year ice differs from older ice in that it is smoother and lacks refrozen melt ponds. Characteristically level where undisturbed by pressure, but where ridges occur, they  distinguished by being larger, more angular, and more porous than multiyear ridges."@en ;
    rdfs:subClassOf soreac:SeaIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_03000071> ;
    skos:definition [ dcterms:created "2020-02-12T13:45:28-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "Sea ice which has formed over a single freezing season."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_03000071> ] .

soreac:TabularIceberg a owl:Class ;
    rdfs:label "tabular iceberg"@en ;
    rdfs:comment "Newly formed tabular icebergs have nearly vertical sides and flat tops. In the Antarctic, they may be tens of kilometers wide, up to 160 km (100 miles) long, and as much as 300 m (1000 ft) thick, with about 30 m (100 ft) exposed above the sea surface. In the Arctic, large icebergs of this type are called ice islands, but they are considerably smaller than the largest of the antarctic variety. Has synonyms tabular berg, table iceberg. Formerly called barrier iceberg."@en ;
    rdfs:subClassOf soreac:Iceberg ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001534> ;
    skos:definition [ dcterms:created "2020-02-12T13:50:16-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An iceberg which 1) has a flat upper surface, 2) is derived from an ice shelf, ice tongue, or floating tidewater glacier via detachment."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001534> ] .

soreaer:AbyssopelagicZone a soreao:AbyssopelagicZone,
        owl:NamedIndividual ;
    rdfs:label "abyssopelagic zone"@en ;
    sorelph:hasAstronomicalBody sorea:Earth .

