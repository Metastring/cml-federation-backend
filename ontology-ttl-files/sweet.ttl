        sorep:Component .

sopropche:Sodicity a owl:Class ;
    rdfs:label "sodicity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somael:Sodium ;
            owl:onProperty sorelch:hasSubstance ],
