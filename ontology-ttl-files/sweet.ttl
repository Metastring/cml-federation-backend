    rdfs:label "halting"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Interruption a owl:Class ;
    rdfs:label "interruption"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

