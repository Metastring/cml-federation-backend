sohuj:MetropolitanArea a owl:Class ;
    rdfs:label "metropolitan area"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohuj:Country ;
            owl:onProperty sorelsp:inside ],
        sohuj:AdministrativeRegion .

