    rdfs:label "fungi taxonomy"@en ;
    rdfs:subClassOf somapl:Fungi .

somapl:Tree a owl:Class ;
    rdfs:label "tree"@en ;
    rdfs:subClassOf somapl:Vegetation .

somas:Ejecta a owl:Class ;
    rdfs:label "ejecta"@en ;
    rdfs:comment "In volcanology, particles that came out of a volcanic vent, traveled through the air or under water, and fell back on the ground surface or on the ocean floor. [Wikipedia]"@en ;
    rdfs:subClassOf soma:Mixture .

somaw:IceCrystal a owl:Class ;
    rdfs:label "ice crystal"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostso:Crystal ;
            owl:onProperty sorel:hasState ],
        somaw:Ice ;
    owl:equivalentClass somaw:IceParticle .

somaw:WaterMixture a owl:Class ;
    rdfs:label "water mixture"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:H2O ;
            owl:onProperty sorelch:hasChemical_1 ],
        soma:Mixture .

