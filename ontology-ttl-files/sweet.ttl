sophei:HabitatFragmentation a owl:Class ;
    rdfs:label "habitat fragmentation"@en ;
    rdfs:comment "Habitat fragmentation is a process of environmental change important in evolution and conservation biology. As the name implies, it describes the emergence of discontinuities (fragmentation) in an organism's preferred environment (habitat). Habitat fragmentation can be caused by geological processes that slowly alter the layout of the physical environment or by human activity such as land conversion, which can alter the environment on a much faster time scale. The former is suspected of being one of the major causes of speciation. The latter is causative in extinctions of many species. Habitat fragmentation is frequently caused by humans when native vegetation is cleared for human activities such as agriculture, rural development or urbanization. Habitats which were once continuous become divided into separate fragments. After intensive clearing, the separate fragments tend to be very small islands isolated from each other by crop land, pasture, pavement, or even barren land. The latter is often the result of slash and burn farming in tropical forests. The term habitat fragmentation can be considered to include six discrete processes: Reduction in the total area of the habitat, increase in the amount of edge, decrease in the amount of interior habitat, isolation of one habitat fragment from other areas of habitat, breaking up of one patch of habitat into several smaller patches, and Decrease in the average size of each patch of habitat."@en ;
    rdfs:subClassOf sophei:HabitatConversion .

sophei:IndoorAirQuality a owl:Class ;
    rdfs:label "indoor air quality"@en ;
    rdfs:subClassOf sophei:AirQuality .

sophei:InvasiveSpecies a owl:Class ;
    rdfs:label "invasive species"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact .

sophei:LandDegradation a owl:Class ;
    rdfs:label "land degradation"@en ;
    rdfs:subClassOf sophei:LandEnvironmentalImpact .

sophei:MassExtinctionEvent a owl:Class ;
    rdfs:label "mass extinction event"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasImpact ;
            owl:someValuesFrom sophei:Extinction ],
        soph:ExtremeEvent,
        sophei:EnvironmentalImpact .

sophei:NoisePollution a owl:Class ;
    rdfs:label "noise pollution"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasImpactOn ;
            owl:someValuesFrom sophwn:Noise ],
        sophei:Pollution .

sophei:NutrientLoading a owl:Class ;
    rdfs:label "nutrient loading"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact .

sophei:OceanAcidification a owl:Class ;
    rdfs:label "ocean acidification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Acid ;
            owl:onProperty sorel:hasState ],
        sophei:OceanEnvironmentalImpact .

sophei:OilSpill a owl:Class ;
    rdfs:label "oil spill"@en ;
    rdfs:subClassOf sophei:Spill .

sophei:OzoneDepletion a owl:Class ;
    rdfs:label "ozone depletion"@en ;
    owl:equivalentClass sophei:OzoneHole .

sophei:PhotochemicalAirPollution a owl:Class ;
    rdfs:label "photochemical air pollution"@en ;
    rdfs:comment "Type of air pollution, such as Los Angeles smog, associated with the buildup of oxidation products formed from the degradation of hydrocarbons, etc."@en ;
    rdfs:subClassOf sophei:AirPollution .

sophei:RangeChange a owl:Class ;
    rdfs:label "range change"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact .

sophei:SeaLevelRise a owl:Class ;
    rdfs:label "sea level rise"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropsh:SeaLevel ;
            owl:onProperty sorelsc:rise ],
        sophei:OceanEnvironmentalImpact .

sophei:SoilLoss a owl:Class ;
    rdfs:label "soil loss"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:decrease ;
            owl:someValuesFrom somas:Soil ],
        sophei:LandEnvironmentalImpact .

sophei:Toxicity a owl:Class ;
    rdfs:label "toxicity"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact .

sophei:Upconing a owl:Class ;
    rdfs:label "upconing"@en ;
    rdfs:comment "Process by which saline water underlying freshwater in an aquifer rises upward into the freshwater zone as a result of pumping water from the freshwater zone."@en ;
    rdfs:subClassOf sophei:SaltWaterIntrusion .

sophei:WaterQuality a owl:Class ;
    rdfs:label "water quality"@en ;
    rdfs:subClassOf sophei:WaterPollution .

sophfd:Capillary a owl:Class ;
    rdfs:label "capillary"@en ;
    owl:equivalentClass sophfd:CapillaryAction .

sophfd:Depression a owl:Class ;
    rdfs:label "depression"@en ;
    rdfs:subClassOf sophfd:LowPressure,
        sorepsg:Depression .

sophfd:LaminarSublayer a owl:Class ;
    rdfs:label "laminar sublayer"@en ;
    rdfs:comment "A layer in which the fluid undergoes smooth, nonturbulent flow. It is found between any surface and a turbulent layer above. See laminar boundary layer, laminar flow."@en ;
    rdfs:subClassOf sophfd:LaminarBoundaryLayer .

sophfd:Overturning a owl:Class ;
    rdfs:label "overturning"@en ;
    rdfs:subClassOf sophfd:Circulation .

sophfd:PointVortex a owl:Class ;
    rdfs:label "point vortex"@en ;
    rdfs:comment "A straight line vortex, the flow of which can be modeled in two dimensions, with a point concentration of vorticity surrounded by irrotational flow."@en ;
    rdfs:subClassOf sophfd:Vortex .

sophfd:Recirculation a owl:Class ;
    rdfs:label "recirculation"@en ;
    rdfs:subClassOf sophfd:Circulation .

sophfd:StationaryEddy a owl:Class ;
    rdfs:label "stationary eddy"@en ;
    rdfs:comment "In studies of the general circulation, the eddies are the departures of a field from the zonal mean of that field; the stationary eddies are the time-averaged, or time-invariant, component of the eddy field."@en ;
    rdfs:subClassOf sophfd:Eddy .

sophfd:ViscousFlow a owl:Class ;
    rdfs:label "viscous flow"@en ;
    rdfs:subClassOf sophfd:Flow .

sophfi:AbsoluteInstability a owl:Class ;
    rdfs:label "absolute instability"@en ;
    rdfs:comment "state of a layer of atmosphere when it has superadiabatic lapse rate of temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostth:Superadiabatic ;
            owl:onProperty sorel:hasState ],
        sophfi:FluidInstability .

sophfi:ConditionalInstability a owl:Class ;
    rdfs:label "conditional instability"@en ;
    rdfs:comment "The state of a layer of unsaturated air when its lapse rate of temperature is less than the dry-adiabatic lapse rate but greater than the moist-adiabatic lapse rate."@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophfi:ConvectiveInstability a owl:Class ;
    rdfs:label "convective instability"@en ;
    rdfs:comment "An instability due to the buoyancy force of heavy fluid over light fluid overcoming the stabilizing influence of viscous forces."@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophfi:FrontalInversion a owl:Class ;
    rdfs:label "frontal inversion"@en ;
    rdfs:comment "A temperature inversion (temperature rising with height) in the atmosphere, encountered upon vertical ascent through a sloping front (or frontal zone)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmofr:Front ;
            owl:onProperty sorel:hasPhenomena ],
        sophfi:Inversion .

sophfi:LargeReynoldsNumberFlow a owl:Class ;
    rdfs:label "large reynolds number flow"@en ;
    rdfs:comment "The behavior of a fluid with a Reynolds number typically greater than 1E4 to 1E6, which usually occurs within the atmosphere. The main property of such flows is a constant friction stress within the surface layer that depends only on relative roughness but not on the Reynolds number itself. Thus, molecular viscosity and qualities occurring in flow descriptions that are dependent on the Reynolds number may be totally ignored."@en ;
    rdfs:subClassOf sophfd:Flow .

sophfi:Lift a owl:Class ;
    rdfs:label "lift"@en ;
    rdfs:subClassOf sophfd:FluidPhenomena ;
    owl:equivalentClass sophfi:Lifting .

sophfi:MechanicalTurbulence a owl:Class ;
    rdfs:label "mechanical turbulence"@en ;
    rdfs:comment "Turbulence produced by shear flow."@en ;
    rdfs:subClassOf sophfi:Turbulence .

sophfi:RayleighTaylorInstability a owl:Class ;
    rdfs:label "rayleigh taylor instability"@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophfi:TearingMode a owl:Class ;
    rdfs:label "tearing mode"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Plasma ;
            owl:onProperty sorel:hasState ],
        sostsy:Instability .

sophfi:Wake a owl:Class ;
    rdfs:label "wake"@en ;
    rdfs:comment "The region of turbulence immediately to the rear of a solid body in motion relative to a fluid"@en ;
    rdfs:subClassOf sophfi:Turbulence .

sophfi:ZombieTurbulence a owl:Class ;
    rdfs:label "zombie turbulence"@en ;
    rdfs:comment "The turbulent perturbations of temperature remaining in a stable boundary layer after all turbulent motions have died out."@en ;
    rdfs:subClassOf sophfi:Turbulence,
        sophsy:Perturbation .

sophft:BolusAdvection a owl:Class ;
    rdfs:label "bolus advection"@en ;
    rdfs:subClassOf sophft:Advection .

sophft:Coning a owl:Class ;
    rdfs:label "coning"@en ;
    rdfs:subClassOf sophft:Plume .

sophft:ConvectivePlume a owl:Class ;
    rdfs:label "convective plume"@en ;
    rdfs:comment "A buoyant jet stream in which the buoyancy is supplied steadily from a point source; the buoyant region is continuous."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophft:Convection ;
            owl:onProperty sorel:hasPhenomena ],
        sophft:Plume .

sophft:CounterGradientFlux a owl:Class ;
    rdfs:label "counter gradient flux"@en ;
    rdfs:subClassOf sopropq:Flux .

sophft:Fanning a owl:Class ;
    rdfs:label "fanning"@en ;
    rdfs:comment "A pattern of smokestack plume dispersion in a statically stable atmosphere, in which the plume spreads out in the horizontal like an oriental fan and meanders about at a fixed height with little vertical spread."@en ;
    rdfs:subClassOf sophft:Plume .

sophft:HTAP a owl:Class ;
    rdfs:label "htap"@en ;
    owl:equivalentClass sophft:HemisphericTransportOfAirPollutants .

sophft:Lofting a owl:Class ;
    rdfs:label "lofting"@en ;
    rdfs:comment "The phenomenon where the upper part of a smoke plume diffuses more rapidly upward than the bottom part diffuses downward. This generally occurs when the boundary layer near the ground is more stable than it is aloft. Compare coning, fanning, looping."@en ;
    rdfs:subClassOf sophft:Convection .

sophft:LongRangeTransport a owl:Class ;
    rdfs:label "long range transport"@en ;
    rdfs:subClassOf sophft:Transport .

sophft:Puff a owl:Class ;
    rdfs:label "puff"@en ;
    rdfs:subClassOf sophft:Plume .

sophft:SlantWiseConvection a owl:Class ;
    rdfs:label "slant wise convection"@en ;
    rdfs:comment "A form of convection driven by a combination of gravitational and centrifugal forces."@en ;
    rdfs:subClassOf sophft:Convection .

sophft:StackEffect a owl:Class ;
    rdfs:label "stack effect"@en ;
    rdfs:comment "An effect due to heat sources within a local exhaust enclosure (stack) producing convective air currents with vertical velocities proportional to the rate of heat transferred to the surrounding air and to the height of rise of the heated air."@en ;
    rdfs:subClassOf sophft:Convection .

sophft:Surge a owl:Class ;
    rdfs:label "surge"@en ;
    rdfs:subClassOf sopropq:Flux .

sophft:Uptake a owl:Class ;
    rdfs:label "uptake"@en ;
    rdfs:subClassOf sophft:Transport .

sophft:VorticityAdvection a owl:Class ;
    rdfs:label "vorticity advection"@en ;
    rdfs:comment "Advection of vorticity by the total wind or force."@en ;
    rdfs:subClassOf sophft:Advection .

sophft:WestEastTransport a owl:Class ;
    rdfs:label "west east transport"@en ;
    rdfs:comment "The eastward flux of mass, momentum, heat, moisture or any other property of a fluid by mean motion or by correlation with the eastward component of motion, that is, eddy flux."@en ;
    rdfs:subClassOf sophft:Transport .

sophg:CompositeProcess a owl:Class ;
    rdfs:label "composite process"@en ;
    rdfs:subClassOf sorepsp:Genesis .

sophg:Differentiation a owl:Class ;
    rdfs:label "differentiation"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena .

sophg:Fluvial a owl:Class ;
    rdfs:label "fluvial"@en ;
    rdfs:comment "Fluvial is used in geography and earth science to refer to the processes associated with rivers and streams and the deposits and landforms created by them [Wikipedia]"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena .

sophg:IntraplateProcess a owl:Class ;
    rdfs:label "intraplate process"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophg:Orogenesis a owl:Class ;
    rdfs:label "orogenesis"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena .

sophg:Paleomagnetism a owl:Class ;
    rdfs:label "paleomagnetism"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena .

sophg:Pedogenesis a owl:Class ;
    rdfs:label "pedogenesis"@en ;
    rdfs:subClassOf sorepsp:Genesis .

sophg:StratigraphicSequence a owl:Class ;
    rdfs:label "stratigraphic sequence"@en ;
    rdfs:subClassOf sorepsp:History .

sophg:Unconformity a owl:Class ;
    rdfs:label "unconformity"@en ;
    rdfs:comment "A substantial break or gap in the geologic record where a rock unit is overlain by another that is not next in stratigraphic sucession, such as an interruption in continuity of a depositional sequence of sedimentary rocks or a break between eroded igneous rocks and younger sedimentary strata. It results from a change that caused deposition to cease for a considerable time, and it normally implies uplift and erosion with loss of the previous formed record."@en ;
    rdfs:subClassOf sorepsp:History .

sophg:WilsonCycle a owl:Class ;
    rdfs:label "wilson cycle"@en ;
    rdfs:comment "The Wilson cycle (a plate tectonics based rock cycle) was developed by J. Tuzo Wilson during the 1960s and 1970s. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:RockCycle .

sophgf:Detachment a owl:Class ;
    rdfs:label "detachment"@en ;
    rdfs:comment "A regional-scale low-angle normal fault."@en ;
    rdfs:subClassOf sophgf:Normal .

sophgf:Dextral a owl:Class ;
    rdfs:label "dextral"@en ;
    rdfs:comment "Right-lateral separation sense; in plan view, the side opposite the observer appears displaced to the right."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:DipSlip a owl:Class ;
    rdfs:label "dip slip"@en ;
    rdfs:comment "The net slip of the fault lies in the dip direction of the fault"@en ;
    rdfs:subClassOf sophgf:DipSeparationSense .

sophgf:GenericDecollement a owl:Class ;
    rdfs:label "generic decollement"@en ;
    rdfs:comment "A large-displacement (kilometers or tens of kilometers) shallowly dipping to subhorizontal fault or shear zone."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:Heave a owl:Class ;
    rdfs:label "heave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgf:Horizontal ;
            owl:onProperty sorelsp:hasDirection ],
        sophsy:Displacement .

sophgf:MixedExtraction a owl:Class ;
    rdfs:label "mixed extraction"@en ;
    rdfs:comment "An extraction fault with some displacement within the fault plane."@en ;
    rdfs:subClassOf sophgf:Extraction .

sophgf:NoMovementSense a owl:Class ;
    rdfs:label "no movement sense"@en ;
    rdfs:comment "The fault-parallel displacement is effectively zero, as in an extraction fault."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:PureExtraction a owl:Class ;
    rdfs:label "pure extraction"@en ;
    rdfs:comment "An extraction fault with no discernible displacement within the fault plane."@en ;
    rdfs:subClassOf sophgf:Extraction .

sophgf:Reverse a owl:Class ;
    rdfs:label "reverse"@en ;
    rdfs:comment "The hanging wall appears to have moved down relative to the footwall; dip of fault usually greater than 45 degrees."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:Scissor a owl:Class ;
    rdfs:label "scissor"@en ;
    rdfs:comment "A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with reverse offset in the opposite direction."@en ;
    rdfs:subClassOf sophgf:Slip .

sophgf:Sense a owl:Class ;
    rdfs:label "sense"@en ;
    rdfs:subClassOf sopropsdir:Direction .

sophgf:Sinistral a owl:Class ;
    rdfs:label "sinistral"@en ;
    rdfs:comment "Left-lateral separation sense; in plan view, the side opposite the observer appears displaced to the right."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:Throw a owl:Class ;
    rdfs:label "throw"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Vertical ;
            owl:onProperty sorelsp:hasDirection ],
        sophsy:Displacement .

sophgf:ThrustDecollement a owl:Class ;
    rdfs:label "thrust decollement"@en ;
    rdfs:comment "A regional-scale low-angle thrust fault."@en ;
    rdfs:subClassOf sophgf:Thrust .

sophgf:Transcurrent a owl:Class ;
    rdfs:label "transcurrent"@en ;
    rdfs:comment "A large scale strike-slip fault in which the fault surface is steeply inclined."@en ;
    rdfs:subClassOf sophgf:StrikeSlip .

sophgf:Transform a owl:Class ;
    rdfs:label "transform"@en ;
    rdfs:comment "A variety of strike-slip fault along which the displacement suddenly stops or changes form; typically associated with mid-ocean ridges."@en ;
    rdfs:subClassOf sophgf:StrikeSlip .

sophgf:Transpressional a owl:Class ;
    rdfs:label "transpressional"@en ;
    rdfs:comment "A fault along which strike-slip deformation is accompanied by a component of shortening transverse to the fault."@en ;
    rdfs:subClassOf sophgf:ObliqueSlip .

sophgf:Transtensional a owl:Class ;
    rdfs:label "transtensional"@en ;
    rdfs:comment "A fault along which strike-slip deformation is accompanied by a component of extension transverse to the fault."@en ;
    rdfs:subClassOf sophgf:ObliqueSlip .

sophgf:Wrench a owl:Class ;
    rdfs:label "wrench"@en ;
    rdfs:comment "A strike slip fault in which the faut plane is more or less vertical."@en ;
    rdfs:subClassOf sophgf:StrikeSlip .

sophgg:Abrasion a owl:Class ;
    rdfs:label "abrasion"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Compaction a owl:Class ;
    rdfs:label "compaction"@en ;
    rdfs:comment "Compaction, part of the process of lithification involving mechanical dewatering of a sediment by progressive loading under several km of geomaterial [Wikipedia]"@en ;
    rdfs:subClassOf sophgg:SedimentFormation .

sophgg:Creep a owl:Class ;
    rdfs:label "creep"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement ;
    owl:equivalentClass sophgg:Reptation .

sophgg:Denundation a owl:Class ;
    rdfs:label "denundation"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Diagenesis a owl:Class ;
    rdfs:label "diagenesis"@en ;
    rdfs:comment "In geology and oceanography, diagenesis is any chemical, physical, or biological change undergone by a sediment after its initial deposition and during and after its lithification, exclusive of surface alteration (weathering) and metamorphism. These changes happen at relatively low temperatures and pressures and result in changes to the rock's original mineralogy and texture. The boundary between diagenesis and metamorphism, which occurs under conditions of higher temperature and pressure, is gradational. After deposition, sediments are compacted as they are buried beneath successive layers of sediment and cemented by minerals that precipitate from solution. Grains of sediment, rock fragments and fossils can be replaced by other minerals during diagenesis. Porosity usually decreases during diagenesis, except in rare cases such as dissolution of minerals and dolomitization."@en ;
    rdfs:subClassOf sophgg:SedimentFormation .

sophgg:Exfoliation a owl:Class ;
    rdfs:label "exfoliation"@en ;
    rdfs:subClassOf sophgg:Weathering .

sophgg:Haloclasty a owl:Class ;
    rdfs:label "haloclasty"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:Salt ;
            owl:onProperty sorel:hasPhenomena ],
        sophgg:Weathering .

sophgg:Landslide a owl:Class ;
    rdfs:label "landslide"@en ;
    rdfs:comment "A landslide (or landslip) is a geological phenomenon which includes a wide range of ground movement, such as rock falls, deep solidure of slopes and shallow debris flows, which can occur in offshore, coastal and onshore environments. [Wikpedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Land ;
            owl:onProperty sorel:hasRealm ],
        sophgg:Slide .

sophgg:MassWasting a owl:Class ;
    rdfs:label "mass wasting"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Mudslide a owl:Class ;
    rdfs:label "mudslide"@en ;
    rdfs:subClassOf sophgg:Slide .

sophgg:RockSlopeFailure a owl:Class ;
    rdfs:label "rock slope failure"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Saltation a owl:Class ;
    rdfs:label "saltation"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Sedimentation a owl:Class ;
    rdfs:label "sedimentation"@en ;
    rdfs:comment "The process of depositing material by water, wind, or glaciers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophft:Deposition ;
            owl:onProperty sorel:hasPhenomena ],
        sophg:GeologicalPhenomena .

sophgg:Slump a owl:Class ;
    rdfs:label "slump"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Solifluction a owl:Class ;
    rdfs:label "solifluction"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgg:Subsidence a owl:Class ;
    rdfs:label "subsidence"@en ;
    rdfs:comment "Subsidence is the motion of a surface (usually, the Earth's surface) as it shifts downward relative to a datum such as sea-level. [Wikipedia]"@en ;
    rdfs:subClassOf sophgg:MaterialDisplacement .

sophgs:Aftershock a owl:Class ;
    rdfs:label "aftershock"@en ;
    rdfs:subClassOf sophgs:Earthquake ;
    owl:disjointWith sophgs:Foreshock .

sophgs:DeepFocusEarthquake a owl:Class ;
    rdfs:label "deep focus earthquake"@en ;
    rdfs:subClassOf sophgs:Earthquake ;
    owl:disjointWith sophgs:ShallowFocusEarthquake .

sophgs:LoveWave a owl:Class ;
    rdfs:label "love wave"@en ;
    rdfs:comment "A type of seismic surface wave having a horizontal motion that is shear or transverse to the direction of propagation. Its velocity depends only on density and rigidity modulus, and not on bulk modulus. It is named after A. E. H. Love, the English mathematician who discovered it."@en ;
    rdfs:subClassOf sophw:SurfaceWave ;
    owl:equivalentClass sophgs:Lwave .

sophgs:MegathrustEarthquake a owl:Class ;
    rdfs:label "megathrust earthquake"@en ;
    rdfs:subClassOf sophgs:Earthquake .

sophgs:PWave a owl:Class ;
    rdfs:label "p wave"@en ;
    rdfs:comment "P waves are longitudinal or compressional waves, which means that the ground is alternately compressed and dilated in the direction of propagation. In solids these waves generally travel slightly less than twice as fast as S waves and can travel through any type of material. In air, these pressure waves take the form of sound waves, hence they travel at the speed of sound. Typical speeds are 330 m/s in air, 1450 m/s in water and about 5000 m/s in granite. P waves are sometimes called primary waves. When generated by an earthquake they are less destructive than the S waves and surface waves that follow them, due to their lesser amplitudes."@en ;
    rdfs:subClassOf sophgs:SeismicBodyWave,
        sophw:LongitudinalWave ;
    owl:equivalentClass sophgs:PrimaryWave .

sophgs:SWave a owl:Class ;
    rdfs:label "s wave"@en ;
    rdfs:comment "S waves are transverse or shear waves, which means that the ground is displaced perpendicularly to the direction of propagation. In the case of horizontally polarized S waves, the ground moves alternately to one side and then the other. S waves can travel only through solids, as fluids (liquids and gases) do not support shear stresses. Their speed is about 60% of that of P waves in a given material. S waves are sometimes called secondary waves, and are several times larger in amplitude than P waves for earthquake sources."@en ;
    rdfs:subClassOf sophgs:SeismicBodyWave,
        sophw:ShearWave ;
    owl:equivalentClass sophgs:SecondaryWave .

sophgs:SeismicSurfaceWave a owl:Class ;
    rdfs:label "seismic surface wave"@en ;
    rdfs:comment "Surface waves are analogous to water waves and travel just under the Earth's surface. They travel more slowly than body waves. Because of their low frequency, long duration, and large amplitude, they can be the most destructive type of seismic wave. There are two types of surface waves: Rayleigh waves and Love waves. Theoretically, surface waves can be understood as systems of interacting P and/or S waves."@en ;
    rdfs:subClassOf sophgs:SeismicWave,
        sophw:SurfaceWave .

sophgs:Tremor a owl:Class ;
    rdfs:label "tremor"@en ;
    rdfs:comment "Low amplitude, continuous earthquake activity often associated with magma movement."@en ;
    rdfs:subClassOf sophgs:Earthquake .

sophgt:CompositeProcess a owl:Class ;
    rdfs:label "composite process"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:ContinenetalDrift a owl:Class ;
    rdfs:label "continenetal drift"@en ;
    rdfs:comment "Continental drift is the movement of the Earth's continents relative to each other. [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:ContinentalBreakup a owl:Class ;
    rdfs:label "continental breakup"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:ContinentalCollision a owl:Class ;
    rdfs:label "continental collision"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:Creep a owl:Class ;
    rdfs:label "creep"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:ExtensionEvent a owl:Class ;
    rdfs:label "extension event"@en ;
    rdfs:comment "An extension event occurs when a seismic event causes an extension in the crust.   [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:IsostaticAdjustment a owl:Class ;
    rdfs:label "isostatic adjustment"@en ;
    owl:equivalentClass sophgt:IsostaticRebound .

sophgt:PlateConvergence a owl:Class ;
    rdfs:label "plate convergence"@en ;
    rdfs:comment "Plate convergence is the phenomena of two plates moving toward one another. [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena ;
    owl:disjointWith sophgt:PlateDivergence .

sophgt:Spreading a owl:Class ;
    rdfs:label "spreading"@en ;
    rdfs:comment "A spreading event occurs whenever plates drift apart (Plate Divergence). [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:Subduction a owl:Class ;
    rdfs:label "subduction"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:TectonicForce a owl:Class ;
    rdfs:label "tectonic force"@en ;
    rdfs:comment "The tectonic force is the force created by one tectonic plate pushing against another due to upwellings of the mantle, [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgt:TectonicPhenomena ;
            owl:onProperty sorel:hasPhenomena ],
        soproc:Force ;
    owl:equivalentClass sophgt:TectonicProcess .

sophgt:TectonicUplift a owl:Class ;
    rdfs:label "tectonic uplift"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:TransformFaulting a owl:Class ;
    rdfs:label "transform faulting"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealt:TransformFault ;
            owl:onProperty sorel:hasRealm ],
        sophgt:TectonicPhenomena .

sophgv:EruptionCloud a owl:Class ;
    rdfs:label "eruption cloud"@en ;
    rdfs:comment "The column of gases, ash, and larger rock fragments rising from a crater or other vent. If it is of sufficient volume and velocity, this gaseous column may reach many miles into the stratosphere, where high winds will carry it long distances."@en ;
    rdfs:subClassOf somas:Ejecta,
        sophgv:VolcanicPhenomena .

sophgv:FlankEruption a owl:Class ;
    rdfs:label "flank eruption"@en ;
    rdfs:comment "An eruption from the side of a volcano (in contrast to a summit eruption.)"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:LavaOfTephra a owl:Class ;
    rdfs:label "lava of tephra"@en ;
    rdfs:comment "Tephra is air-fall material (of any size) produced by a volcanic eruption regardless of composition or fragment size. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:Lava .

sophgv:MagmaMotion a owl:Class ;
    rdfs:label "magma motion"@en ;
    rdfs:subClassOf sophgv:VolcanicActivity .

sophgv:Magmatic a owl:Class ;
    rdfs:label "magmatic"@en ;
    rdfs:comment "Eruption Type 1 - produce juvenile clasts during explosive decompression from gas release. [Wikipedia]"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:MantlePlume a owl:Class ;
    rdfs:label "mantle plume"@en ;
    rdfs:comment "A mantle plume is an upwelling of abnormally hot rock within the Earth's mantle. As the heads of mantle plumes can partly melt when they reach shallow depths, they are thought to be the cause of volcanic centers known as hotspots and probably also to have caused flood basalts. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreag:Mantle ;
            owl:onProperty sorel:hasRealm ],
        sophgv:VolcanicPlume ;
    owl:equivalentClass sophgv:MantleThermalPlume .

sophgv:NueeArdenteEruption a owl:Class ;
    rdfs:label "nuee ardente eruption"@en ;
    owl:equivalentClass sophgv:PeleeanEruption .

sophgv:PhreaticEruption a owl:Class ;
    rdfs:label "phreatic eruption"@en ;
    rdfs:comment "Phreatic eruption is an explosion that follows the transformation of groundwater into steam. No incandescent or juvenile material is erupted."@en ;
    rdfs:subClassOf sophgv:VolcanicEruption ;
    owl:equivalentClass sophgv:SteamBlastEruption .

sophgv:PhreatomagmaticEruption a owl:Class ;
    rdfs:label "phreatomagmatic eruption"@en ;
    rdfs:comment "Eruption Type 2 - Ejection of entrained particles during steam eruptions. [Wikipedia]"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:PlinianEruption a owl:Class ;
    rdfs:label "plinian eruption"@en ;
    rdfs:comment "Plinian eruptions are characterized by paroxysmal ejection of large volume of ash and pumice as a well-defined eruption column or ‘jet;’ often precedes caldera collapse. The resulting tephra fallout covers an area of more than 500 square kilometers."@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:StrombolianEruption a owl:Class ;
    rdfs:label "strombolian eruption"@en ;
    rdfs:comment "Strombolian Eruptions are characterised by huge clots of molten lava bursting from the summit crater to form luminous arcs through the sky. Collecting on the flanks of the cone, lava clots combine to stream down the slopes in molten rivulets. The explosions are driven by bursts of gas slugs that rise faster than surrounding magma"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:SummitEruption a owl:Class ;
    rdfs:label "summit eruption"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:Surge a owl:Class ;
    rdfs:label "surge"@en ;
    rdfs:comment "A ring-shaped cloud of gas and suspended solid debris that moves radially outward at high velocity as a density flow from the base of a vertical eruption column accompanying a volcanic eruption or crater formation."@en ;
    rdfs:subClassOf sophgv:VolcanicPlume .

sophhe:Airglow a owl:Class ;
    rdfs:label "airglow"@en ;
    rdfs:subClassOf sophhe:AtmosphericLightEmission .

sophhe:Aurora a owl:Class ;
    rdfs:label "aurora"@en ;
    rdfs:comment "The sporadic radiant emission from the upper atmosphere over the middle and high latitudes."@en ;
    rdfs:subClassOf sophhe:AtmosphericLightEmission .

sophhe:AuroralSubstorm a owl:Class ;
    rdfs:label "auroral substorm"@en ;
    rdfs:subClassOf sophhe:AtmosphericLightEmission ;
    owl:equivalentClass sophhe:MagneticSubstorm .

sophhe:BowShock a owl:Class ;
    rdfs:label "bow shock"@en ;
    rdfs:comment "The bow shock is a discontinuity that forms in the solar wind when the supersonic solar wind encounters the magnetic field of a planet, very similar to the shock wave that forms upstream of an aircraft moving at a supersonic speed."@en ;
    rdfs:subClassOf sophhe:BowShockCrossing .

sophhe:Geomagnetism a owl:Class ;
    rdfs:label "geomagnetism"@en ;
    rdfs:subClassOf soprocp:Magnetism .

sophhe:Heliosheath a owl:Class ;
    rdfs:label "heliosheath"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:InterplanetaryShock a owl:Class ;
    rdfs:label "interplanetary shock"@en ;
    rdfs:subClassOf sophhe:InterplanetaryPhenomena .

sophhe:MagnetopauseCrossing a owl:Class ;
    rdfs:label "magnetopause crossing"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:Magnetosheath a owl:Class ;
    rdfs:label "magnetosheath"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:Magnetotail a owl:Class ;
    rdfs:label "magnetotail"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:ProtonPrecipitation a owl:Class ;
    rdfs:label "proton precipitation"@en ;
    rdfs:subClassOf soph:Precipitation,
        sophhe:GeomagneticStorm .

sophhe:SchumannResonance a owl:Class ;
    rdfs:label "schumann resonance"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:SolarParticleEvent a owl:Class ;
    rdfs:label "solar particle event"@en ;
    rdfs:subClassOf sophhe:GeomagneticStorm .

sophhe:SolarWind a owl:Class ;
    rdfs:label "solar wind"@en ;
    rdfs:comment "The solar wind is a stream of charged particles (i.e., a plasma) which are ejected from the upper atmosphere of the sun. It consists mostly of high-energy electrons and protons (about 1 keV) that are able to escape the sun's gravity in part because of the high temperature of the corona and the high kinetic energy particles gain through a process that is not well understood at this time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sophst:Sun ;
            owl:onProperty sorelph:hasAstronomicalBody ],
        sophst:StellarWind .

sophhe:SolarWindExtreme a owl:Class ;
    rdfs:label "solar wind extreme"@en ;
    rdfs:subClassOf sophhe:InterplanetaryPhenomena .

sophhe:Substorm a owl:Class ;
    rdfs:label "substorm"@en ;
    rdfs:subClassOf sophhe:InterplanetaryPhenomena .

sophhe:SunEarthInteraction a owl:Class ;
    rdfs:label "sun earth interaction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sophst:Sun ;
            owl:onProperty sorelsc:hasCause ],
        [ a owl:Restriction ;
            owl:hasValue sorea:Earth ;
            owl:onProperty sorelsc:hasEffect ],
        sophsy:Interaction .

sophhe:TelluricCurrent a owl:Class ;
    rdfs:label "telluric current"@en ;
    rdfs:subClassOf soprocp:ElectricCurrent .

sophhy:BaseFlow a owl:Class ;
    rdfs:label "base flow"@en ;
    rdfs:subClassOf sophhy:Streamflow .

sophhy:Debouche a owl:Class ;
    rdfs:label "debouche"@en ;
    rdfs:subClassOf sophhy:StreamDischarge .

sophhy:DeepPercolation a owl:Class ;
    rdfs:label "deep percolation"@en ;
    rdfs:subClassOf sophhy:Percolation .

sophhy:Drain a owl:Class ;
    rdfs:label "drain"@en ;
    rdfs:subClassOf sophhy:WaterFlow .

sophhy:Drainage a owl:Class ;
    rdfs:label "drainage"@en ;
    rdfs:subClassOf sophsy:Removal .

sophhy:FlashFlood a owl:Class ;
    rdfs:label "flash flood"@en ;
    rdfs:subClassOf soph:ExtremeEvent,
        sophhy:Flood .

sophhy:GroundwaterStorage a owl:Class ;
    rdfs:label "groundwater storage"@en ;
    rdfs:subClassOf sophhy:HydrospherePhenomena,
        sorepsc:Storage .

sophhy:HydrothermalAlteration a owl:Class ;
    rdfs:label "hydrothermal alteration"@en ;
    rdfs:subClassOf sophhy:HydrospherePhenomena .

sophhy:Infiltration a owl:Class ;
    rdfs:label "infiltration"@en ;
    rdfs:subClassOf sophhy:LandWaterCirculation .

sophhy:Intrusion a owl:Class ;
    rdfs:label "intrusion"@en ;
    rdfs:subClassOf sophhy:LandWaterCirculation .

sophhy:OpenChannelFlow a owl:Class ;
    rdfs:label "open channel flow"@en ;
    rdfs:comment "Flow of a fluid with its surface exposed to the atmosphere."@en ;
    rdfs:subClassOf sophhy:WaterFlow .

sophhy:Outflow a owl:Class ;
    rdfs:label "outflow"@en ;
    rdfs:subClassOf sophhy:WaterFlow .

sophhy:OverlandFlow a owl:Class ;
    rdfs:label "overland flow"@en ;
    rdfs:subClassOf sophhy:Runoff .

sophhy:Percolate a owl:Class ;
    rdfs:label "percolate"@en ;
    owl:equivalentClass sophhy:Percolation .

sophhy:RadionucleiRetardation a owl:Class ;
    rdfs:label "radionuclei retardation"@en ;
    rdfs:comment "The process or processes that cause the time required for a given radionuclide to move between two locations to be greater than the groundwater travel time, because of physical and chemical interactions between the radionuclide and the geohydrologic unit through which the radionuclide travels."@en ;
    rdfs:subClassOf sophhy:HydrospherePhenomena .

sophhy:Recharge a owl:Class ;
    rdfs:label "recharge"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreah:Aquifer ;
            owl:onProperty sorel:hasRealm ],
        sophft:Transport .

sophhy:Snowslide a owl:Class ;
    rdfs:label "snowslide"@en ;
    rdfs:subClassOf sophgg:Avalanche .

sophhy:Torrent a owl:Class ;
    rdfs:label "torrent"@en ;
    rdfs:subClassOf sophhy:Discharge .

sophm:Aeration a owl:Class ;
    rdfs:label "aeration"@en ;
    rdfs:comment "Aeration (also called aerification) is the process by which air is circulated through, mixed with or dissolved in a liquid or substance. [Wikipedia]"@en ;
    rdfs:subClassOf sophm:Mixing .

sophm:Bioturbation a owl:Class ;
    rdfs:label "bioturbation"@en ;
    rdfs:comment "Bioturbation is the displacement and mixing of sediment particles by benthic fauna (animals) or flora (plants). The mediators of bioturbation are typically annelid worms (e.g. polychaetes, oligochaetes), bivalves (e.g. mussels, clams), gastropods, holothurians, or any other infaunal or epifaunal organisms. Faunal activities, such as burrowing, ingestion and defecation of sediment grains, construction and maintenance of galleries, and infilling of abandoned dwellings, displace sediment grains and mix the sediment matrix. In soil science, bioturbation is the physical rearrangement of the soil profile by soil life."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somas:Sediment ;
            owl:onProperty sorelch:hasSubstance ],
        sophm:Mixing .

sophm:Diffuse a owl:Class ;
    rdfs:label "diffuse"@en ;
    owl:equivalentClass sophm:Diffusion .

sophm:EddyDiffusion a owl:Class ;
    rdfs:label "eddy diffusion"@en ;
    rdfs:subClassOf sophm:Diffusion .

sophm:Entrainment a owl:Class ;
    rdfs:label "entrainment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophm:Mixing ;
            owl:onProperty sorel:hasPhenomena ],
        soprocp:PhysicalProcess .

sophm:FickianDiffusion a owl:Class ;
    rdfs:label "fickian diffusion"@en ;
    rdfs:subClassOf sophm:Diffusion .

sophm:Mix a owl:Class ;
    rdfs:label "mix"@en ;
    owl:equivalentClass sophm:Mixing .

sophm:Settling a owl:Class ;
    rdfs:label "settling"@en ;
    rdfs:subClassOf soph:DynamicalPhenomena .

sophm:TurbulentDiffusion a owl:Class ;
    rdfs:label "turbulent diffusion"@en ;
    rdfs:comment "Diffusion or dispersion due to the effects of turbulent motions."@en ;
    rdfs:subClassOf sophm:Diffusion .

sophoc:Attrition a owl:Class ;
    rdfs:label "attrition"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:Backwash a owl:Class ;
    rdfs:label "backwash"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:BeachDepletion a owl:Class ;
    rdfs:label "beach depletion"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:LittoralDrift a owl:Class ;
    rdfs:label "littoral drift"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena ;
    owl:equivalentClass sophoc:LongshoreDrift .

sophoc:PlungingBreaker a owl:Class ;
    rdfs:label "plunging breaker"@en ;
    rdfs:subClassOf sophoc:Breaker .

sophoc:SpillingBreaker a owl:Class ;
    rdfs:label "spilling breaker"@en ;
    rdfs:subClassOf sophoc:Breaker .

sophoc:StormSurge a owl:Class ;
    rdfs:label "storm surge"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:SurfBeat a owl:Class ;
    rdfs:label "surf beat"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:SurgingBreaker a owl:Class ;
    rdfs:label "surging breaker"@en ;
    rdfs:subClassOf sophoc:Breaker .

sophoc:Swell a owl:Class ;
    rdfs:label "swell"@en ;
    rdfs:comment "Surface gravity waves on the ocean that are not growing or being sustained any longer by the wind."@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena,
        sophw:GravityWave .

sophod:CircumpolarCurrent a owl:Class ;
    rdfs:label "circumpolar current"@en ;
    rdfs:subClassOf sophod:OceanCurrent .

sophod:ColdCoreCell a owl:Class ;
    rdfs:label "cold core cell"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostth:Cool ;
            owl:onProperty sorelph:hasTemperatureRange ],
        sophod:OceanGyre .

sophod:Downwelling a owl:Class ;
    rdfs:label "downwelling"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Down ;
            owl:onProperty sorelsp:hasDirection ],
        sophod:OceanCirculation .

sophod:LangmuirCirculation a owl:Class ;
    rdfs:label "langmuir circulation"@en ;
    rdfs:comment "Roll circulations approximately aligned with the surface stress vector that frequently occur in the upper boundary layer of oceans or lakes. Although similar in form to atmospheric longitudinal roll vortices, Langmuir circulations are thought to be driven by nonlinear interactions between the surface gravity wave field and the larger-scale turbulent motions within the mixed layer. They are sometimes called windrows because they form lines of surface debris or bubbles in their surface convergence zones. Their spatial scale is related to the depth of the mixed layer and their characteristic velocity is on the order of 8u*, where u* is the friction velocity in water. As a result of this scaling, Langmuir circulations generally require surface winds of at least 8 m s-1 in order to form. See coherent structures, longitudinal rolls."@en ;
    rdfs:subClassOf sophod:OceanCirculation .

sophod:LittoralCurrent a owl:Class ;
    rdfs:label "littoral current"@en ;
    owl:equivalentClass sophod:LongshoreCurrent .

sophod:LoopCurrent a owl:Class ;
    rdfs:label "loop current"@en ;
    rdfs:subClassOf sophod:OceanCurrent .

sophod:MesoscaleEddy a owl:Class ;
    rdfs:label "mesoscale eddy"@en ;
    rdfs:comment "In oceanography, densely packed, irregularly oval- shaped high and low pressure centers roughly 400 km (240 miles) in diameter in which current intensities are typically tenfold greater than the local means."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophfd:Eddy ;
    owl:equivalentClass sophod:ModeEddy .

sophod:OceanConveyorBelt a owl:Class ;
    rdfs:label "ocean conveyor belt"@en ;
    rdfs:comment "The global recirculation of water masses that determines today's climate."@en ;
    rdfs:subClassOf sophod:OceanCirculation .

sophod:OceanMixing a owl:Class ;
    rdfs:label "ocean mixing"@en ;
    rdfs:comment "Any process or series of processes by which parcels of ocean water with different properties are brought into intimate small-scale contact, so that molecular diffusion erases the differences between them."@en ;
    rdfs:subClassOf sophm:Mixing,
        sopho:OceanPhenomena .

sophod:SecondaryCirculation a owl:Class ;
    rdfs:label "secondary circulation"@en ;
    rdfs:subClassOf sophod:OceanCirculation .

sophod:ThermohalineCirculation a owl:Class ;
    rdfs:label "thermohaline circulation"@en ;
    rdfs:subClassOf sophod:OceanCirculation .

sophod:TidalCurrent a owl:Class ;
    rdfs:label "tidal current"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophoc:OceanTide ;
            owl:onProperty sorel:hasPhenomena ],
        sophod:OceanCurrent .

sophod:TidalWave a owl:Class ;
    rdfs:label "tidal wave"@en ;
    owl:equivalentClass sophod:Tsunami .

sophod:TurbidityCurrent a owl:Class ;
    rdfs:label "turbidity current"@en ;
    rdfs:subClassOf sophod:OceanCurrent .

sophod:Upwelling a owl:Class ;
    rdfs:label "upwelling"@en ;
    rdfs:comment "An ascending motion of subsurface water by which water from deeper layers is brought into the surface layer and is removed from the area of upwelling by divergent horizontal flow."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Up ;
            owl:onProperty sorelsp:hasDirection ],
        sophod:OceanCirculation .

sophod:WarmCoreCell a owl:Class ;
    rdfs:label "warm core cell"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostth:Warm ;
            owl:onProperty sorelph:hasTemperatureRange ],
        sophod:OceanGyre .

sophod:WesternIntensification a owl:Class ;
    rdfs:label "western intensification"@en ;
    rdfs:subClassOf sophod:BoundaryCurrent .

sophod:WindDrivenCirculation a owl:Class ;
    rdfs:label "wind driven circulation"@en ;
    rdfs:subClassOf sophod:OceanCirculation .

sophpc:ClimateChange a owl:Class ;
    rdfs:label "climate change"@en ;
    rdfs:subClassOf sophpc:GlobalChange .

sophpc:GlobalClimate a owl:Class ;
    rdfs:label "global climate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:averageOver ;
            owl:someValuesFrom soreps:Space ],
        [ a owl:Restriction ;
            owl:hasValue sostss:Global ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:Climate,
        sopropfu:Average .

sophpc:HeatIsland a owl:Class ;
    rdfs:label "heat island"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Microscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:ClimatePhenomena .

sophpc:LocalClimate a owl:Class ;
    rdfs:label "local climate"@en ;
    rdfs:subClassOf sophpc:Climate .

sophpc:Mesoclimate a owl:Class ;
    rdfs:label "mesoclimate"@en ;
    rdfs:comment "The climate of a natural region of small extent, for example, valley, forest, plantation, and park. Because of subtle differences in elevation and exposure, the climate may not be representative of the general climate of the region."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:Climate .

sophpc:Microclimate a owl:Class ;
    rdfs:label "microclimate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Microscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:Climate .

sophpc:MoistureClimate a owl:Class ;
    rdfs:label "moisture climate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasQuantity ;
            owl:someValuesFrom sopropche:Moisture ],
        sophpc:Climate .

sophpc:NuclearWinter a owl:Class ;
    rdfs:label "nuclear winter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Global ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:ClimatePhenomena .

sophpc:Paleoclimate a owl:Class ;
    rdfs:label "paleoclimate"@en ;
    rdfs:comment "Climate for periods prior to the development of measuring instruments, including historic and geologic time, for which only proxy climate records are available."@en ;
    rdfs:subClassOf sophpc:Climate .

sophpc:RegionalClimate a owl:Class ;
    rdfs:label "regional climate"@en ;
    rdfs:subClassOf sophpc:Climate .

sophpc:ThermalClimate a owl:Class ;
    rdfs:label "thermal climate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasQuantity ;
            owl:someValuesFrom sopropt:Temperature ],
        sophpc:Climate .

sophr:Activation a owl:Class ;
    rdfs:label "activation"@en ;
    rdfs:subClassOf soprocc:ChemicalReaction .

sophr:BiochemicalRelease a owl:Class ;
    rdfs:label "biochemical release"@en ;
    rdfs:subClassOf sophr:Release .

sophr:Explosion a owl:Class ;
    rdfs:label "explosion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophwn:Noise ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        soprocc:ChemicalReaction .

sophr:Flare a owl:Class ;
    rdfs:label "flare"@en ;
    rdfs:subClassOf soprocc:ChemicalReaction ;
    owl:equivalentClass sophr:Flaring .

sophr:FluidLeak a owl:Class ;
    rdfs:label "fluid leak"@en ;
    rdfs:subClassOf sophr:Leak .

sophr:GasFlare a owl:Class ;
    rdfs:label "gas flare"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        soprocc:ChemicalReaction .

sophr:GasLeak a owl:Class ;
    rdfs:label "gas leak"@en ;
    rdfs:subClassOf sophr:Leak .

sophr:IndustrialEmission a owl:Class ;
    rdfs:label "industrial emission"@en ;
    rdfs:subClassOf sophr:Emission .

sophr:Leach a owl:Class ;
    rdfs:label "leach"@en ;
    rdfs:subClassOf sophr:Release .

sophr:RadioactivityRelease a owl:Class ;
    rdfs:label "radioactivity release"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somais:RadioactiveSubstance ;
            owl:onProperty sorelch:hasSubstance ],
        sophr:Release .

sophr:Wildfire a owl:Class ;
    rdfs:label "wildfire"@en ;
    rdfs:subClassOf sophr:Fire .

sophso:Ablation a owl:Class ;
    rdfs:label "ablation"@en ;
    rdfs:comment "all processes that remove material from an object, such as a glacier"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Bend a owl:Class ;
    rdfs:label "bend"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:BergeronFindeisenProcess a owl:Class ;
    rdfs:label "bergeron findeisen process"@en ;
    rdfs:comment "A theoretical explanation of the process by which precipitation particles may form within a mixed cloud (composed of both ice crystals and liquid water drops)."@en ;
    rdfs:subClassOf sophso:Coalescence .

sophso:Break a owl:Class ;
    rdfs:label "break"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Buckle a owl:Class ;
    rdfs:label "buckle"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Cataclasis a owl:Class ;
    rdfs:label "cataclasis"@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Cementation a owl:Class ;
    rdfs:label "cementation"@en ;
    rdfs:subClassOf sophso:Consolidation .

sophso:Cleavage a owl:Class ;
    rdfs:label "cleavage"@en ;
    rdfs:subClassOf sophso:Crack .

sophso:Clump a owl:Class ;
    rdfs:label "clump"@en ;
    rdfs:subClassOf sophso:Accretion ;
    owl:equivalentClass sophso:Clumping .

sophso:Comminution a owl:Class ;
    rdfs:label "comminution"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Compaction a owl:Class ;
    rdfs:label "compaction"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Conchoidal a owl:Class ;
    rdfs:label "conchoidal"@en ;
    rdfs:comment "The most common fracture type is conchoidal. This is a smoothly curved fracture that is familiar to people who have examined broken glass."@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Congelation a owl:Class ;
    rdfs:label "congelation"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Deform a owl:Class ;
    rdfs:label "deform"@en ;
    owl:equivalentClass sophso:Deformation .

sophso:Diagenesis a owl:Class ;
    rdfs:label "diagenesis"@en ;
    rdfs:subClassOf sophso:Consolidation .

sophso:Disintegrate a owl:Class ;
    rdfs:label "disintegrate"@en ;
    rdfs:subClassOf sophso:Failure ;
    owl:equivalentClass sophso:Disintegration .

sophso:Dislocation a owl:Class ;
    rdfs:label "dislocation"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Distortion a owl:Class ;
    rdfs:label "distortion"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Earthy a owl:Class ;
    rdfs:label "earthy"@en ;
    rdfs:comment "a fracture that produces a texture similar to broken children's clay. It is found in minerals that are generally massive and loosely consolidated."@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Elongate a owl:Class ;
    rdfs:label "elongate"@en ;
    owl:equivalentClass sophso:Stretch .

sophso:Elongation a owl:Class ;
    rdfs:label "elongation"@en ;
    owl:equivalentClass sophso:Stretch .

sophso:Erode a owl:Class ;
    rdfs:label "erode"@en ;
    rdfs:comment "Erosion is displacement of solids (soil, mud, rock and other particles) usually by the agents of currents such as, wind, water, or ice by downward or down-slope movement in response to gravity or by living organisms (in the case of bioerosion)."@en ;
    rdfs:subClassOf sophso:SolidPhenomena ;
    owl:equivalentClass sophso:Erosion .

sophso:Extension a owl:Class ;
    rdfs:label "extension"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Fold a owl:Class ;
    rdfs:label "fold"@en ;
    rdfs:comment "The term fold is used in geology when one or a stack of originally flat and planar surfaces, such as sedimentary strata, are bent or curved as a result of plastic (i.e. permanent) deformation."@en ;
    rdfs:subClassOf sophso:Deformation .

sophso:GrainSizeSorting a owl:Class ;
    rdfs:label "grain size sorting"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Harden a owl:Class ;
    rdfs:label "harden"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Jagged a owl:Class ;
    rdfs:label "jagged"@en ;
    rdfs:comment "Jagged has sharp points or edges that catch on a finger that's rubbed across the surface."@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Joint a owl:Class ;
    rdfs:label "joint"@en ;
    rdfs:subClassOf sophso:Crack .

sophso:Metamorphism a owl:Class ;
    rdfs:label "metamorphism"@en ;
    rdfs:subClassOf sophso:Consolidation .

sophso:Microfracture a owl:Class ;
    rdfs:label "microfracture"@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Pore a owl:Class ;
    rdfs:label "pore"@en ;
    rdfs:subClassOf sostrg:Separation ;
    owl:equivalentClass sophso:PoreSpace .

sophso:Ridging a owl:Class ;
    rdfs:label "ridging"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Rip a owl:Class ;
    rdfs:label "rip"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Rupture a owl:Class ;
    rdfs:label "rupture"@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Shatter a owl:Class ;
    rdfs:label "shatter"@en ;
    rdfs:subClassOf sophso:Failure .

sophso:Slip a owl:Class ;
    rdfs:label "slip"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Solidification a owl:Class ;
    rdfs:label "solidification"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Solidify a owl:Class ;
    rdfs:label "solidify"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Spintery a owl:Class ;
    rdfs:label "spintery"@en ;
    rdfs:comment "Splintery is a fracture type that occurs in fibrous or finely acicular minerals and in minerals that have a relatively stronger structure in one direction than the other two."@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Strain a owl:Class ;
    rdfs:label "strain"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Subconchoidal a owl:Class ;
    rdfs:label "subconchoidal"@en ;
    rdfs:comment "Similar to conchoidal, just not as curved, but still smooth."@en ;
    rdfs:subClassOf sophso:Fracture .

sophso:Subside a owl:Class ;
    rdfs:label "subside"@en ;
    rdfs:subClassOf sophso:SolidPhenomena ;
    owl:equivalentClass sophso:Subsidence .

sophso:Thinning a owl:Class ;
    rdfs:label "thinning"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophso:Wasting a owl:Class ;
    rdfs:label "wasting"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophst:CME a owl:Class ;
    rdfs:label "cme"@en ;
    owl:equivalentClass sophst:CoronalMassEjection .

sophst:CoronalDimming a owl:Class ;
    rdfs:label "coronal dimming"@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:CoronalHole a owl:Class ;
    rdfs:label "coronal hole"@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:CoronalJet a owl:Class ;
    rdfs:label "coronal jet"@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:CoronalLoop a owl:Class ;
    rdfs:label "coronal loop"@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:CoronalRain a owl:Class ;
    rdfs:label "coronal rain"@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:FMode a owl:Class ;
    rdfs:label "f mode"@en ;
    rdfs:subClassOf sophst:SolarPhenomena,
        sophw:GravityWave,
        sophw:SurfaceWave .

sophst:Filament a owl:Class ;
    rdfs:label "filament"@en ;
    rdfs:comment "If a solar prominence occurs on the disc of the sun it appears darker than its background (due to the lower temperature of the plasma). These are referred to as solar filaments."@en ;
    rdfs:subClassOf sophst:Prominence .

sophst:Flare a owl:Class ;
    rdfs:label "flare"@en ;
    rdfs:comment "A flare is a violent explosion in the atmosphere of a star. Flares take place in the corona and chromosphere, heating plasma to tens of millions of kelvins and accelerating electrons, protons and heavier ions to near the speed of light. They produce electromagnetic radiation across the electromagnetic spectrum at all wavelengths from long-wave radio to the shortest wavelength gamma rays  Most flares occur in active regions around sunspots, where intense magnetic fields emerge from the surface into the corona. Flares are powered by the sudden (timescales of minutes to tens of minutes) release of magnetic energy stored in the corona."@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophst:GMode a owl:Class ;
    rdfs:label "g mode"@en ;
    rdfs:subClassOf sophst:SolarPhenomena,
        sophw:GravityWave .

sophst:Granulation a owl:Class ;
    rdfs:label "granulation"@en ;
    owl:disjointWith sophst:Supergranulation ;
    owl:equivalentClass sophst:Granule .

sophst:Helioseismology a owl:Class ;
    rdfs:label "helioseismology"@en ;
    rdfs:subClassOf sophst:Asteroseismology .

sophst:PMode a owl:Class ;
    rdfs:label "p mode"@en ;
    rdfs:subClassOf sophst:SolarPhenomena,
        sophw:AcousticWave .

sophst:Plage a owl:Class ;
    rdfs:label "plage"@en ;
    rdfs:subClassOf sophst:SolarPhenomena .

sophst:Spicule a owl:Class ;
    rdfs:label "spicule"@en ;
    rdfs:subClassOf sophfd:Jet,
        sophst:StellarPhenomena .

sophst:StellarFusion a owl:Class ;
    rdfs:label "stellar fusion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelch:hasReactionProduct ;
            owl:someValuesFrom somapa:Neutrino ],
        soprocc:NuclearFusion .

sophst:Sunspot a owl:Class ;
    rdfs:label "sunspot"@en ;
    rdfs:subClassOf sophst:SolarPhenomena .

sophst:TerminationShock a owl:Class ;
    rdfs:label "termination shock"@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophsy:Collection a owl:Class ;
    rdfs:label "collection"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Comeback a owl:Class ;
    rdfs:label "comeback"@en ;
    rdfs:subClassOf sophsy:Return .

sophsy:Conversion a owl:Class ;
    rdfs:label "conversion"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Decline a owl:Class ;
    rdfs:label "decline"@en ;
