sorepsme:Optics a owl:Class ;
    rdfs:label "optics"@en ;
    rdfs:comment "Optics is a branch of physics that describes the behavior and properties of light and the interaction of light with matter. Optics explains optical phenomena"@en ;
    rdfs:subClassOf sorepsme:ResearchExploration .

sorepsme:Passive a sorepsme:RetrievalApproach,
        owl:NamedIndividual ;
    rdfs:label "passive"@en .

sorepsme:Photometry a owl:Class ;
    rdfs:label "photometry"@en ;
    rdfs:subClassOf sorepsme:Methodology .

sorepsme:Polarimetry a owl:Class ;
    rdfs:label "polarimetry"@en ;
    rdfs:subClassOf sorepsme:Methodology .

sorepsme:RadioactiveDating a owl:Class ;
    rdfs:label "radioactive dating"@en ;
    rdfs:subClassOf sorepsme:Methodology .

sorepsme:RemoteSensing a owl:Class ;
    rdfs:label "remote sensing"@en ;
    rdfs:subClassOf sorepsme:ResearchExploration .

sorepsme:Spectroscopy a owl:Class ;
    rdfs:label "spectroscopy"@en ;
    rdfs:subClassOf sorepsme:Methodology .

sorepsme:Tomography a owl:Class ;
    rdfs:label "tomography"@en ;
    rdfs:subClassOf sorepsme:ResearchExploration .

sorepsme:XRayDiffraction a owl:Class ;
    rdfs:label "x ray diffraction"@en ;
    rdfs:subClassOf sorepsme:ResearchExploration .

sorepsmo:BoussinesqApproximation a owl:Class ;
    rdfs:label "boussinesq approximation"@en ;
    rdfs:comment "An approximation to the dynamical equations of motion whereby density is assumed to be constant except in the buoyancy term of the vertical velocity equation."@en ;
    rdfs:subClassOf sorepsmo:PhysicalApproximation .

sorepsmo:ClimateModel a owl:Class ;
    rdfs:label "climate model"@en ;
    rdfs:subClassOf sorepsmo:Model .

sorepsmo:EnsembleForecast a owl:Class ;
    rdfs:label "ensemble forecast"@en ;
    rdfs:comment "A set of different forecasts all valid at the same forecast time(s)."@en ;
    rdfs:subClassOf sorepsmo:Forecast .

sorepsmo:ExtendedForecast a owl:Class ;
    rdfs:label "extended forecast"@en ;
    rdfs:comment "A forecast of weather conditions for a period extending beyond three or more days from the day of issuance."@en ;
    rdfs:subClassOf sorepsmo:WeatherForecast .

sorepsmo:FiniteElement a owl:Class ;
    rdfs:label "finite element"@en ;
    rdfs:subClassOf sorepsmo:Model .

sorepsmo:FluxCorrection a owl:Class ;
    rdfs:label "flux correction"@en ;
    rdfs:subClassOf sorepsmo:PhysicalApproximation .

sorepsmo:GCM a owl:Class ;
    rdfs:label "gcm"@en ;
    owl:equivalentClass sorepsmo:GeneralCirculationModel .

sorepsmo:Hypothesis a owl:Class ;
    rdfs:label "hypothesis"@en ;
    rdfs:subClassOf sohur:ExperimentActivity .

sorepsmo:MixingScheme a owl:Class ;
    rdfs:label "mixing scheme"@en ;
    rdfs:subClassOf sorepsmo:Parameterization .

sorepsmo:Observation a owl:Class ;
    rdfs:label "obervation"@en ;
    dcterms:created "2021-03-09"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-3884-3420> ;
    rdfs:comment """Act to generate an estimate of the value of a property of a thing in the world at a known time.

Implements a procedure at a known time, which might be different to the time the value applies to the thing in the world. 
The procedure uses an instrument, sensor or observer. 
An act of observation generates a piece of information

bco:ObservingProcess (from OBO) is a sub-class.
sohur:Observation (SWEET) is a sub-class.

See https://www.w3.org/TR/vocab-ssn/#SOSAObservation
                     """@en ;
    rdfs:subClassOf soproc:Process .

sorepsmo:Parcel a owl:Class ;
    rdfs:label "parcel"@en ;
    rdfs:comment "An imaginary volume of fluid to which may be assigned various thermodynamic and kinematic quantities."@en ;
    rdfs:subClassOf sorepsmo:Model .

sorepsmo:Predict a owl:Class ;
    rdfs:label "predict"@en ;
    rdfs:subClassOf sohur:ExperimentActivity ;
    owl:equivalentClass sorepsmo:Prediction .

sorepsmo:ReactionPathModel a owl:Class ;
    rdfs:label "reaction path model"@en ;
    rdfs:comment "A simulation approach to studying the chemical evolution of a (natural) system."@en ;
    rdfs:subClassOf sorepsmo:Model .

sorepsmo:RigidLidApproximation a owl:Class ;
    rdfs:label "rigid lid approximation"@en ;
    rdfs:subClassOf sorepsmo:PhysicalApproximation .

sorepsmo:Spectral a owl:Class ;
    rdfs:label "spectral"@en ;
