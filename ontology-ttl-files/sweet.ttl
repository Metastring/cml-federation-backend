sorepscd:SouthPole a sorepscd:Pole,
        owl:NamedIndividual ;
    rdfs:label "south pole"@en ;
    sorelsp:hasDirection sorepsd:South .

sorepscd:Theta a sorepscd:AngularCoordinate,
        owl:NamedIndividual ;
    rdfs:label "theta"@en .

sorepscd:Vertical a owl:Class ;
    rdfs:label "vertical"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Up ;
            owl:onProperty sorelsp:hasDirection ],
        sorep:Coordinate ;
    owl:equivalentClass sorepscd:VerticalCoordinate .

sorepscd:ZoneCode a sorepscd:HorizontalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "zone code"@en .

sorepsd:Diffuse a sopropsdir:AngularDirection,
        owl:NamedIndividual ;
    rdfs:label "diffuse"@en .

