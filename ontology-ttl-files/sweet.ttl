    rdfs:label "complex"@en ;
    rdfs:comment "A complex system is a system composed of interconnected parts that as a whole exhibit one or more properties (behavior among the possible properties) not obvious from the properties"@en ;
    rdfs:subClassOf sostsy:SystemState .

