    rdfs:label "stratosphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaa:Tropopause ;
            owl:onProperty sorelsp:hasLowerBoundary ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreaa:Stratopause ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        [ a owl:Restriction ;
            owl:hasValue soproptg:PositiveSlope ;
            owl:onProperty sorelph:dTdh ],
        soreaa:AtmosphereLayer .

soreaa:TemperatureInversionLayer a owl:Class ;
    rdfs:label "temperature inversion layer"@en .

soreaa:Thermosphere a owl:Class ;
    rdfs:label "thermosphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaa:Mesopause ;
            owl:onProperty sorelsp:hasLowerBoundary ],
        [ a owl:Restriction ;
            owl:hasValue soproptg:PositiveSlope ;
            owl:onProperty sorelph:dTdh ],
        soreaa:AtmosphereLayer .

soreaabl:InternalBoundaryLayer a owl:Class ;
    rdfs:label "internal boundary layer"@en ;
    rdfs:comment "A layer within the atmosphere bounded below by the surface, and above by a more or less sharp discontinuity in some atmospheric property. Internal boundary layers are associated with the horizontal advection of air across a discontinuity in some property of the surface (e.g., aerodynamic roughness length or surface heat flux) and can be viewed as layers in which the atmosphere is adjusting to new surface properties. See thermal internal boundary layer, mechanical internal boundary layer."@en ;
    rdfs:subClassOf soreaabl:AtmosphericBoundaryLayer .

soreaabl:PlanetaryBoundaryLayer a owl:Class ;
    rdfs:label "planetary boundary layer"@en ;
    rdfs:comment "The bottom layer of the troposphere that is in contact with the surface of the earth.   It is often turbulent and is capped by a statically stable layer of air or temperature inversion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorea:Atmosphere ] .

<http://sweetontology.net/realmAtmoWeather> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Atmospheric Weather" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/phenAtmoPrecipitation>,
        <http://sweetontology.net/phenFluidInstability>,
        <http://sweetontology.net/procStateChange>,
        <http://sweetontology.net/propSpaceHeight>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmAtmo>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical> ;
    owl:versionInfo "3.6.0" .

soreaaw:LevelOfFreeConvection a owl:Class ;
    rdfs:label "level of free convection"@en .

<http://sweetontology.net/realmBiolBiome> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Biologic Biome" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/humanCommerce>,
        <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrAnimal>,
        <http://sweetontology.net/matrBiomass>,
        <http://sweetontology.net/matrPlant>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmClimateZone>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaClimate>,
        <http://sweetontology.net/relaHuman>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/reprSciComponent>,
        <http://sweetontology.net/stateBiological> ;
    owl:versionInfo "3.6.0" .

soreabb:Biome a owl:Class ;
    rdfs:label "biome"@en ;
    rdfs:subClassOf sorepsc:Environment .

soreabb:Grassland a owl:Class ;
    rdfs:label "grassland"@en ;
    rdfs:comment "Grasslands are areas where the vegetation is dominated by grasses (Poaceae) and other herbaceous (non-woody) plants (forbs). Plants of the sedge (Cyperacae) and rush (Juncaceae) families can also be frequent in grasslands. Grasslands occur naturally on all continents except Antarctica, and in many other areas they have replaced the natural vegetation due to human influence. In temperate latitudes, such as north-west Europe, grasslands are dominated by perennial species, whereas in warmer climates annual species form a greater component of the vegetation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapl:Grass ;
            owl:onProperty sorelsc:hasSpecies ],
        soreabb:TerrestrialEcosystem .

soreabb:Taiga a owl:Class ;
    rdfs:label "taiga"@en ;
    rdfs:comment "biome characterized by coniferous forests"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue soreacz:Cfc ;
            owl:onProperty sorelcl:hasClimateZone ],
        [ a owl:Restriction ;
            owl:hasValue soreacz:Dfb ;
            owl:onProperty sorelcl:hasClimateZone ],
        [ a owl:Restriction ;
            owl:hasValue soreacz:Dfc ;
            owl:onProperty sorelcl:hasClimateZone ],
        soreabb:Forest .

soreacz:Cfc a soreacz:C,
        owl:NamedIndividual ;
    rdfs:label "cfc"@en ;
    rdfs:comment "The Cfc climate classification is charactericized by year-round precipitation and having 1 - 3 months with temperatures above 10 degree C."@en .

soreacz:ColdMidlatitudeDesertClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "cold midlatitude desert climate"@en .

soreacz:ColdMidlatitudeSteppeClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "cold midlatitude steppe climate"@en .

soreacz:Dfb a soreacz:D,
        owl:NamedIndividual ;
    rdfs:label "dfb"@en ;
    rdfs:comment "The Dfb climate classifcation is characterized by having year-round precipitation and warmest month temperatures below 22 degree C."@en .

soreacz:Dfc a soreacz:D,
        owl:NamedIndividual ;
    rdfs:label "dfc"@en ;
    rdfs:comment "The Dfc climate classification is characterized by having year-round precipitation and having 1 - 4 months above 10 degree C."@en .

soreacz:DryClimate a owl:Class ;
    rdfs:label "dry climate"@en .

soreacz:Equator a owl:Class ;
    rdfs:label "equator"@en ;
    rdfs:subClassOf soreacz:TropicalClimateZone .

soreacz:HotLowLatitudeDesertClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "hot low latitude desert climate"@en .

soreacz:HotLowLatitudeSteppeClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "hot low latitude steppe climate"@en .

soreacz:ITCZ a owl:Class ;
    rdfs:label "itcz"@en ;
    owl:equivalentClass soreacz:IntertropicalConvergenceZone .

soreacz:IceCapClimate a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "ice cap climate"@en .

soreacz:IntertropicalConvergenceZone a owl:Class ;
    rdfs:label "intertropical convergence zone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreacz:Equator ;
            owl:onProperty sorel:hasRealm ],
        soreacz:ClimateZoneType .

soreacz:PolarMarineClimate a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "polar marine climate"@en .

soreacz:SemiAridClimate a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "semi arid climate"@en .

soreacz:TemperateClimate a owl:Class ;
    rdfs:label "temperate climate"@en .

soreacz:TropicalClimate a owl:Class ;
    rdfs:label "tropical climate"@en .

soreacz:TropicalClimateZone a owl:Class ;
    rdfs:label "tropical climate zone"@en ;
    rdfs:subClassOf soreacz:ClimateZoneType .

soreacz:TropicalMonsoonClimate a soreacz:A,
        owl:NamedIndividual ;
    rdfs:label "tropical monsoon climate"@en .

soreacz:TropicalSavannaClimate a soreacz:A,
        owl:NamedIndividual ;
    rdfs:label "tropical savanna climate"@en .

soreacz:TundraClimate a soreacz:E,
        owl:NamedIndividual ;
    rdfs:label "tundra climate"@en .

soreacz:WetSummerClimate a owl:Class ;
    rdfs:label "wet summer climate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepts:Summer ;
            owl:onProperty sorelcl:hasWetSeason ],
        soreacz:ClimateClassification .

soreac:DriftIce a owl:Class ;
    rdfs:label "drift ice"@en ;
    rdfs:comment "Prior to approximately 2014, drift ice was synonymous with the various grades of pack ice, described as very open (with an ice concentration of 1/10 to 3/10), open (4/10 to 6/10, with many leads and polynyas and the floes generally not in contact with one another), close (7/10 to 8/10, composed of floes mostly in contact), very close (9/10 to less than 10/10), and compact (10/10, with no water visible, called consolidated pack ice if the floes are frozen together). This is deprecated, with pack ice now referring to drift ice with a concentration equal to or above 7/10; however, other usages are still common."@en ;
    rdfs:subClassOf soreac:SeaIce ;
    owl:disjointWith soreac:FastIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001517> ;
    skos:definition [ dcterms:created "2019-12-10T08:45:12-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A floating mass of ice which is 1) unattached to land or land-fast ice and 2) moved by the action of winds or currents."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001517> ] .

soreac:FastIce a owl:Class ;
    rdfs:label "fast ice"@en ;
    rdfs:comment "Fast ice is central to the livelihoods of Arctic coastal communities who use it to access fishing and hunting grounds. Vertical fluctuations may be observed during changes of sea level. Fast ice may be formed on site from sea water or by freezing of pack ice of any age to the shore, and it may extend a few yards (meters) or several hundred miles (kilometers) from the coast. Fast ice may be more than one year old and may then be prefixed with appropriate age category (old, second- year, or multiyear). If it is thicker than about 7 ft (2 m) above sea level, it is called an ice shelf."@en ;
    rdfs:subClassOf soreac:SeaIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001522> ;
    skos:definition [ dcterms:created "2019-12-10T08:50:11-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A mass of sea ice which 1) is less than 2 meters in thickness and 2) forms along the coast, where it is attached to the shore, to an ice wall, to an ice front, or between shoals or grounded icebergs."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001522> ] .

soreac:FrozenGround a owl:Class ;
    rdfs:label "frozen ground"@en ;
    rdfs:comment "Perennially and seasonally frozen ground can vary from being partially to extensively frozen depending on the extent of the phase change. It may be described as hard frozen ground, plastic frozen ground, or dry frozen ground, depending on the pore ice and unfrozen water contents and its compressibility under load."@en,
        "Soil within which the moisture has predominantly changed to ice, the unfrozen portion being in vapor phase. Ice within the soil bonds (adfreezes) adjacent soil particles and renders frozen ground very hard. Permanently frozen ground is called permafrost. Dry frozen ground is relatively loose and crumbly because of the lack of bonding ice. Frozen ground is sometimes inadvisedly called frost or ground frost."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Frozen ;
            owl:onProperty sorel:hasState ],
        sorea:Land ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001524> ;
    skos:definition [ dcterms:created "2019-12-10T09:00:09-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "Land which is below the freezing point of water."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001524> ] .

soreac:IceFloe a owl:Class ;
    rdfs:label "ice floe"@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_03000066> ;
    skos:definition [ dcterms:created "2019-12-10T08:54:28-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://nsidc.org/cryosphere/glossary/term/ice-floe> ;
            rdfs:comment "An ice floe which is formed from frozen sea water, and floats upon the surface of a marine water body."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_03000066> ] .

soreac:Iceberg a owl:Class ;
    rdfs:label "iceberg"@en ;
    rdfs:comment "The greater part of an iceberg's mass (4/5 to 8/9) is below sea level, which makes them dangerous to shipping in high and mid-latitude regions of the ocean. The top of an ice berg usually protrudes more than 5 m above water-level and typically extends from tens of meters to many tens of kilometres across. Icebergs may be described as tabular, dome-shaped, sloping, pinnacled, dry-docked, blocky, weathered or glacier bergs in addition to having a size qualifier. Icebergs are not sea ice, when they melt they add fresh water to the ocean.  The unmodified term iceberg usually refers to the irregular masses of ice formed by the calving of glaciers along an orographically rough coast, whereas tabular icebergs and ice islands are calved from an ice shelf, while bergs formed from sea ice are called floebergs. In decreasing size, they are classified as: ice island (few thousand square meters to 500 km^2 in area); tabular iceberg; iceberg; bergy bit (less than 5 m above sea level, between 1 and 200 m^2 in area); and growler (less than 1 m above sea level, about 20 m^2 in area). Alaskan icebergs rarely exceed 500 feet in maximum dimension.  Antarctic icebergs originate from the ice mass of the Antarctic continent that has accumulated over many thousands of years."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorea:Ocean ],
        soreac:LandIce ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001546> ;
    skos:definition [ dcterms:created "2020-02-12T13:16:09-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which has broken away from a larger ice mass on land, such as a glacier or ice shelf, and may be either afloat or aground."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001546> ] .

soreac:LandIce a owl:Class ;
    rdfs:label "land ice"@en ;
    rdfs:comment "Land ice is any part of the Earth's seasonal or perennial ice cover that has formed over land as the result, principally, of the freezing of precipitation; opposed to sea ice formed by the freezing of seawater.  Thus, an iceberg or tabular iceberg is land ice as well as its parent glacier, ice sheet, or ice shelf. The two major concentrations of land ice are the ice sheets of Greenland and Antarctica. Glaciers and ice caps are the other important forms; however, some members of the glaciology community hold that glaciers (i.e. rock glaciers) need not have any ice."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorea:Land ],
        somaw:Ice ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001547> ;
    skos:definition [ dcterms:created "2020-02-12T13:18:57-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which has formed over land."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001547> ] .

soreac:Snout a owl:Class ;
    rdfs:label "snout"@en ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001529> ;
    skos:definition [ dcterms:created "2020-02-12T13:48:09-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An ice mass which constitutes that part of a glacier which has the lowest elevation."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001529> ] .

soreac:Tundra a owl:Class ;
    rdfs:label "tundra"@en ;
    rdfs:comment "In physical geography, tundra is an area where the tree growth is hindered by low temperatures and short growing seasons. There are two types of tundra: Arctic tundra (which also occurs in Antarctica), and alpine tundra. In tundra, the vegetation is composed of dwarf shrubs, sedges and grasses, mosses, and lichens. Scattered trees grow in some tundra. The ecotone (or ecological boundary region) between the tundra and the forest is known as the tree line or timberline."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom soreac:FrozenGround ],
        sorea:Land ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_00000112> ;
    skos:definition [ dcterms:created "2020-02-12T13:52:08-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A vegetated area which is part of a tundra ecosystem."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_00000112> ] .

<http://sweetontology.net/realmEarthReference> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Earth Reference" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenElecMag>,
        <http://sweetontology.net/propSpaceDistance>,
        <http://sweetontology.net/propSpaceHeight>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmAstroHelio>,
        <http://sweetontology.net/realmAtmo>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmOcean>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

soreaer:InternationalGeomagneticReferenceField a sophel:GeomagneticField,
        owl:NamedIndividual ;
    rdfs:label "international geomagnetic reference field"@en .

soreag:Core a owl:Class ;
    rdfs:label "core"@en ;
    rdfs:comment "The central most structure inside the earth. The core does not allow shear waves to pass through it, while the speed of travel (seismic velocity) is different in the other layers. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeosphereLayer .

soreag:Dike a owl:Class ;
    rdfs:label "dike"@en ;
    rdfs:comment "Dikes, long, planar (sheet) igneous intrusions, enter along cracks, and therefore often form in large numbers in areas that are being actively deformed. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:PlutonicStructure .

soreag:GuttenburgDiscontinuity a owl:Class ;
    rdfs:label "guttenburg discontinuity"@en ;
    rdfs:comment "The core-mantle boundary. This discontinuity is due to the differences between the acoustic impedances of the solid mantle and the molten outer core. P-wave velocities are much slower in the outer core than in the deep mantle while S-waves do not exist at all in the liquid portion of the core. Corresponds to top of D``. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicBoundary .

soreag:Mohorovi_i_Discontinuity a owl:Class ;
    rdfs:label "mohorovicic discontinuity"@en .

soreag:OuterCore a owl:Class ;
    rdfs:label "outer core"@en ;
    rdfs:comment "The liquid outer core surrounds the inner core and is believed to be composed of iron mixed with nickel and trace amounts of lighter elements. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:Mantle .

soreag:SkinLayer a owl:Class ;
    rdfs:label "skin layer"@en .

soreag:TransitionalCrust a owl:Class ;
    rdfs:label "transitional crust"@en ;
    rdfs:comment "Transitional crust is crust that is thinned by the upwelling of mantle.  [Wikipedia]"@en ;
    rdfs:subClassOf soreag:Crust .

soreag:UpperMantleFlowing a owl:Class ;
    rdfs:label "upper mantle flowing"@en .

soreag:UpperMantleRigid a owl:Class ;
    rdfs:label "upper mantle rigid"@en ;
    rdfs:comment "The uppermost mantle plus overlying crust are relatively rigid and form the lithosphere, an irregular layer with a maximum thickness of perhaps 200 km. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:UpperMantle .

soreagb:FlyschBasin a owl:Class ;
    rdfs:label "flysch basin"@en ;
    rdfs:comment "Flysch is a sequence of sedimentary rocks that is deposited in a deep marine facies in the foreland basin of a developing orogen. Flysch is formed under deep marine circumstances, in a quiet and low-energetic depositional environment. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:ForelandBasin a owl:Class ;
    rdfs:label "foreland basin"@en ;
    rdfs:comment "A foreland basin is a depression that develops adjacent and parallel to a mountain belt. Foreland basins form because the immense mass created by crustal thickening associated with the evolution of a mountain belt causes the lithosphere to bend, by a process known as lithospheric flexure. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:IntracratonicBasin a owl:Class ;
    rdfs:label "intracratonic basin"@en ;
    rdfs:comment "Intracratonic basins are formed by fluvial sedimentation of an intracratonic area which has undergone sediment sag-loading. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:SuccessorBasin a owl:Class ;
    rdfs:label "successor basin"@en ;
    rdfs:comment "Successor basins arise from shifting and merging of fore arc, back-arc and intra-arc basins. Basins or sequences that overlap terrane boundaries. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

soreagb:TranspressionalBasin a owl:Class ;
    rdfs:label "transpressional basin"@en ;
    rdfs:comment "Transpression basins are formed during oblique collision of tectonic plates and during non-orthogonal subduction. [Wikipedia]"@en ;
    rdfs:subClassOf soreagb:Basin .

<http://sweetontology.net/realmGeolConstituent> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Geologic Constituent" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/propChemical>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/reprSpaceGeometry3D> ;
    owl:versionInfo "3.6.0" .

soreagcons:Inclusion a owl:Class ;
    rdfs:label "inclusion"@en ;
    rdfs:comment "A fragment of older material within an igneous rock to which it may or may not be genetically related."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

soreagcons:Orthomatrix a owl:Class ;
    rdfs:label "orthomatrix"@en ;
    rdfs:comment "A type of matrix consisting of recrystallized detrital lutum  (clay fraction, less than 2 micron) or protomatrix."@en ;
    rdfs:subClassOf soreagcons:Matrix .

soreagcont:ContinentalCrust a owl:Class ;
    rdfs:label "continental crust"@en ;
    rdfs:comment "The continental crust is typically from 30 km (20 mi) to 50 km (30 mi) thick, and it is mostly composed of less dense rocks, such as granite, than is the oceanic crust. The continental crust has an average composition similar to that of the igneous rock, andesite.[Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasRock ;
            owl:someValuesFrom somarocki:Felsic ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalLithosphere ;
            owl:onProperty sorel:partOf ],
        soreag:Continental,
        soreag:Crust .

soreagcont:ContinentalPlatform a owl:Class ;
    rdfs:label "continental platform"@en ;
    rdfs:comment "The extensive central cratons of continents may consist of both shields and platforms, and the crystalline basement. A platform is that part of the craton for which the basement is overlain by horizontal or subhorizontal sediments. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

soreagcont:ContinentalRift a owl:Class ;
    rdfs:label "continental rift"@en ;
    rdfs:comment "A long, narrow fissure in the Earth marking a zone of the lithosphere that has become thinner due to extensional forces associated with plate teconics. Continental rifts are thousands of kilometers in length and hundreds of kilometers in width, and they are associated with normal faults and with grabens. [FreeDictionary]"@en ;
    rdfs:subClassOf sorealt:DivergentBoundary,
        sorealt:Rift .

soreagcont:Shield a owl:Class ;
    rdfs:label "shield"@en ;
    rdfs:comment "The extensive central cratons of continents may consist of both shields and platforms, and the crystalline basement. A shield is that part of a craton in which the usually Precambrian basement rocks crop out extensively at the surface.  [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

soreagoc:OceanicLithosphere a owl:Class ;
    rdfs:label "oceanic lithosphere"@en ;
    rdfs:subClassOf soreag:Lithosphere,
        soreao:OceanRegion ;
    owl:equivalentClass soreagoc:Submarine .

soreagoc:Submarine a owl:Class ;
    rdfs:label "submarine"@en .

soreagor:ArcAxis a owl:Class ;
    rdfs:label "arc axis"@en ;
    rdfs:comment "In a Back-arc basin the arc axis is the line where spreading occurs on the overlying plate of the subduction zone. [Wikipedia]"@en ;
    rdfs:subClassOf sopropsdir:Axis .

soreagor:ForeArc a owl:Class ;
    rdfs:label "fore arc"@en ;
    rdfs:comment "A forearc is a depression in the sea floor located between a subduction zone and an associated volcanic arc. It is typically filled with sediments from the adjacent landmass and the island arc in addition to trapped oceanic crustal material.  [Wikipedia]"@en ;
    rdfs:subClassOf soreagor:Arc,
        sorealt:SupraSubductionZoneComplex .

soreagor:RetroArc a owl:Class ;
    rdfs:label "retro arc"@en .

soreah:Bank a owl:Class ;
    rdfs:label "bank"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreah:Dyke a owl:Class ;
    rdfs:label "dyke"@en .

soreah:Embankment a owl:Class ;
    rdfs:label "embankment"@en .

soreah:FloodBank a owl:Class ;
    rdfs:label "flood bank"@en .

soreah:Levee a owl:Class ;
    rdfs:label "levee"@en .

soreah:RaisedBank a owl:Class ;
    rdfs:label "raised bank"@en .

soreah:SaturatedZone a owl:Class ;
    rdfs:label "saturated zone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreah:Aquifer ;
            owl:onProperty sorel:partOf ],
        soreah:HydrosphereFeature .

soreah:UndergroundWater a owl:Class ;
    rdfs:label "underground water"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreah:VadoseZone ;
            owl:onProperty sorelsp:inside ],
        somaw:Groundwater .

soreah:WaterTableAquifer a owl:Class ;
    rdfs:label "water table aquifer"@en .

soreahb:Basin a owl:Class ;
    rdfs:label "basin"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:Dam a owl:Class ;
    rdfs:label "dam"@en ;
    dcterms:contributor <http://orcid.org/0000-0003-2185-928X> ;
    rdfs:subClassOf somaf:Structure ;
    skos:definition [ dcterms:created "2019-08-18"^^xsd:date ;
            dcterms:source <http://dbpedia.org/resource/Dam> ;
            rdfs:comment "A dam is a barrier that impounds water or underground streams. Reservoirs created by dams not only suppress floods but also provide water for activities such as irrigation, human consumption, industrial use, aquaculture, and navigability. Hydropower is often used in conjunction with dams to generate electricity. A dam can also be used to collect water or for storage of water which can be evenly distributed between locations. Dams generally serve the primary purpose of retaining water, while other structures such as floodgates or levees (also known as dikes) are used to manage or prevent water flow into specific land regions."@en ] .

soreahb:Fjord a owl:Class ;
    rdfs:label "fjord"@en ;
    rdfs:comment "A fjord (or fiord) is a long, narrow estuary with steep sides, made when a glacial valley is filled by rising sea water levels. The seeds of a fjord are laid when a glacier cuts a U-shaped valley through abrasion of the surrounding bedrock by the sediment it carries. Many such valleys were formed during recent ice age when the sea was at a much lower level than it is today. At the end of the ice age, the climate warmed up again and glaciers retreated. Sea level rose due to an influx of water from melting ice sheets and glaciers around the world (it rose over 100 m after the last ice age), inundating the vacated valleys with seawater to form fjords."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreac:Glacier ;
            owl:onProperty sorel:hasRealm ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorealf:Valley ;
            owl:onProperty sorel:hasRealm ],
        soreahb:Estuary .

soreahb:Lagoon a owl:Class ;
    rdfs:label "lagoon"@en ;
    rdfs:comment "A lagoon is a body of comparatively shallow salt or brackish water separated from the deeper sea by a shallow or exposed sandbank, coral reef, or similar feature. Thus, the enclosed body of water behind a barrier reef or barrier islands or enclosed by an atoll reef is called a lagoon. Lagoon refers to both coastal lagoons formed by the build-up of sandbanks or reefs along shallow coastal waters, and the lagoons in atolls, formed by the growth of coral reefs on slowly sinking central islands. Lagoons that are fed by freshwater streams are also called estuaries"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:River a owl:Class ;
    rdfs:label "river"@en ;
    rdfs:comment "A river is a natural waterway that transits water through a landscape from higher to lower elevations called divides. The divide determines which way a river will flow. It is an integral component of the water cycle. The water within a river is generally collected from precipitation through surface runoff, groundwater recharge (as seen at baseflow conditions / during periods of lack of precipitation) and release of stored water in natural reservoirs, such as a glacier"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:Spring a owl:Class ;
    rdfs:label "spring"@en ;
    rdfs:comment "A spring is a point where groundwater flows out of the ground, and is thus where the aquifer surface meets the ground surface. Dependent upon the constancy of the water source (rainfall or snowmelt that infiltrates the earth), a spring may be ephemeral (intermittent) or perennial (continuous)."@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreahb:Strait a owl:Class ;
    rdfs:label "strait"@en ;
    rdfs:subClassOf soreahb:Channel .

soreahb:Stream a owl:Class ;
    rdfs:label "stream"@en ;
    rdfs:comment "A stream is a body of water with a current, confined within a bed and banks. Streams are important as conduits in the water cycle, instruments in aquifer recharge, and corridors for fish and wildlife migration. The biological habitat in the immediate vicinity of a stream is called a riparian zone. Given the status of the ongoing Holocene extinction event, streams play an important corridor role in connecting fragmented habitats and thus in conserving biodiversity. Stream is also an umbrella term used in the scientific community for all flowing natural waters, regardless of size. The study of streams and waterways in general is known as surface hydrology and is a core element of environmental geography"@en ;
    rdfs:subClassOf soreahb:BodyOfWater .

soreala:SandDune a owl:Class ;
    rdfs:label "sand dune"@en .

sorealc:Bar a owl:Class ;
    rdfs:label "bar"@en ;
    rdfs:subClassOf sorealc:Delta,
        sorealc:Spit ;
    owl:equivalentClass sorealc:DeltaBar .

sorealc:Coastal a owl:Class ;
    rdfs:label "coastal"@en ;
    owl:equivalentClass sorealc:CoastalRegion .

sorealc:Delta a owl:Class ;
    rdfs:label "delta"@en ;
    rdfs:comment "A delta is a landform where the mouth of a river flows into an ocean, sea, desert, estuary, lake or another river. It builds up sediment outwards into the flat area which the river's flow encounters (as a deltaic deposit) transported by the water and set down as the currents slow. Deltaic deposits of larger, heavily-laden rivers are characterized by the main channel dividing amongst often substantial land masses into multiple streams known as distributaries. These divide and come together again to form a maze of active and inactive channels."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom soreahb:River ],
        sorealc:CoastalLandform .

sorealc:DeltaBar a owl:Class ;
    rdfs:label "delta bar"@en .

sorealc:IntertidalZone a owl:Class ;
    rdfs:label "intertidal zone"@en ;
    rdfs:comment "The intertidal zone, also known as the littoral zone, in marine aquatic environments is the area of the foreshore and seabed that is exposed to the air at low tide and submerged at high tide, for example, the area between tide marks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophoc:OceanTide ;
            owl:onProperty sorel:hasPhenomena ],
        sorealc:CoastalRegion ;
    owl:equivalentClass sorealc:Littoral,
        sorealc:LittoralZone,
        sorealc:TidePool .

sorealc:Littoral a owl:Class ;
    rdfs:label "littoral"@en .

sorealc:LittoralZone a owl:Class ;
    rdfs:label "littoral zone"@en .

sorealc:RiparianZone a owl:Class ;
    rdfs:label "riparian zone"@en .

sorealc:Shoreline a owl:Class ;
    rdfs:label "shoreline"@en .

sorealc:Spit a owl:Class ;
    rdfs:label "spit"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealc:TidePool a owl:Class ;
    rdfs:label "tide pool"@en .

sorealc:WaveCutPlatform a owl:Class ;
    rdfs:label "wave cut platform"@en ;
    rdfs:subClassOf sorealc:CoastalRegion .

sorealf:Gorge a owl:Class ;
    rdfs:label "gorge"@en ;
    rdfs:subClassOf sorealf:Canyon .

sorealf:Playa a owl:Class ;
    rdfs:label "playa"@en ;
    rdfs:subClassOf sorealf:FluvialPlain ;
    owl:equivalentClass sorealf:SaltLake .

sorealf:SaltFlat a owl:Class ;
    rdfs:label "salt flat"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealf:SaltLake a owl:Class ;
    rdfs:label "salt lake"@en .

sorealf:Trench a owl:Class ;
    rdfs:label "trench"@en ;
    rdfs:comment "A trench is a type of excavation or depression in the ground. Trenches are generally defined by being deeper than they are wide (as opposed to a wider gully or ditch), and by being narrow compared to their length (as opposed to a simple hole). Trenches are a natural feature in many landscapes. Some are created by rivers in flow (which may have long since fallen dry), others are features created by geological movement, such as oceanic trenches. The latter form is relatively deep, linear and narrow, and is formed by plate subduction. [Wikipedia]"@en ;
    rdfs:subClassOf sorealf:Canyon .

sorealf:Tunnel a owl:Class ;
    rdfs:label "tunnel"@en ;
    rdfs:subClassOf sorealf:FluvialLandform,
        sorepsg3:Tube .

<http://sweetontology.net/realmLandGlacial> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Glacial" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/realmLandform> ;
    owl:versionInfo "3.6.0" .

sorealg:GlacialOutwashPlain a owl:Class ;
    rdfs:label "glacial outwash plain"@en ;
    rdfs:subClassOf sorealg:GlacialPlain .

sorealg:Moraine a owl:Class ;
    rdfs:label "moraine"@en ;
    rdfs:comment "Any glacially formed accumulation of unconsolidated glacial debris (soil and rock) which can occur in currently glaciated and formerly glaciated regions."@en ;
    rdfs:subClassOf sorealg:GlacialLandform .

sorealg:TillPlain a owl:Class ;
    rdfs:label "till plain"@en ;
    rdfs:comment "An extensive flat plain of glacial till that forms when a sheet of ice becomes detached from the main body of a glacier and melts in place depositing the sediments it carried."@en ;
    rdfs:subClassOf sorealg:GlacialPlain .

<http://sweetontology.net/realmLandProtected> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Protected" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/humanJurisdiction>,
        <http://sweetontology.net/matrNaturalResource>,
        <http://sweetontology.net/relaHuman> ;
    owl:versionInfo "3.6.0" .

sorealp:MarineProtectedArea a owl:Class ;
    rdfs:label "marine protected area"@en ;
    rdfs:subClassOf sorealp:WaterReserve .

sorealp:Parkland a owl:Class ;
    rdfs:label "parkland"@en .

sorealp:WaterReserve a owl:Class ;
    rdfs:label "water reserve"@en ;
    rdfs:subClassOf sohuj:AdministrativeRegion,
        somanr:WaterResource .

sorealt:ConvergentMargin a owl:Class ;
    rdfs:label "convergent margin"@en .

sorealt:ConvergentPlateBoundary a owl:Class ;
    rdfs:label "convergent plate boundary"@en .

sorealt:DivergentBoundary a owl:Class ;
    rdfs:label "divergent boundary"@en ;
    rdfs:comment "In plate tectonics, a divergent boundary or divergent plate boundary (also known as a constructive boundary or an extensional boundary) is a linear feature that exists between two tectonic plates that are moving away from each other and new crust is being formed. [Wikipedia]"@en ;
    rdfs:subClassOf sorealt:PlateBoundary ;
    owl:equivalentClass sorealt:DivergentPlateBoundary .

sorealt:DivergentPlateBoundary a owl:Class ;
    rdfs:label "divergent plate boundary"@en .

sorealt:FloodBasalt a owl:Class ;
    rdfs:label "flood basalt"@en ;
    rdfs:comment "A flood basalt or trap basalt is the result of a giant volcanic eruption or series of eruptions that coats large stretches of land or the ocean floor with basalt lava. Flood basalts have occurred on continental scales (large igneous provinces) in prehistory, creating great plateaus and mountain ranges. [Wikipedia]"@en ;
    rdfs:subClassOf soreal:Landform .

sorealt:FossilPlateBoundary a owl:Class ;
    rdfs:label "fossil plate boundary"@en ;
    rdfs:comment "Are where similar plant and animal fossils are found around different continent shores, suggesting that they were once joined. [Wikipedia]"@en ;
    rdfs:subClassOf sorealt:PlateBoundary .

sorealt:HangingWall a owl:Class ;
    rdfs:label "hanging wall"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealt:FractureZone ;
            owl:onProperty sorel:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophso:Fault ;
            owl:onProperty sorelsp:above ],
        soreag:GeologicFeature .

sorealt:LargeIgneousProvince a owl:Class ;
    rdfs:label "large igneous province"@en .

sorealt:Rift a owl:Class ;
    rdfs:label "rift"@en ;
    rdfs:comment "A rift is a place where the Earth's crust and lithosphere are being pulled apart[1] and is an example of extensional tectonics. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarocki:AnorogenicIgneousRock ;
            owl:onProperty sorelch:hasSubstance ],
        soreag:GeologicBoundary,
        sorealt:FractureZone .

sorealt:SupraSubductionZoneComplex a owl:Class ;
    rdfs:label "supra subduction zone complex"@en ;
    rdfs:comment "There is increasing evidence that most ophiolites are generated when subduction begins and thus represent fragments of fore-arc lithosphere. This led to introduction of the term ‘supra-subduction zone’ (SSZ) ophiolite in the 1980s to acknowledge that some ophiolites are more closely related to island arcs than ocean ridges. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

sorealt:Suture a owl:Class ;
    rdfs:label "suture"@en ;
    rdfs:comment "A suture is where a fragment of crustal material is accreted to crust lying on another plate. [Wikipedia]"@en ;
    rdfs:subClassOf sorealt:FossilPlateBoundary,
        sorealt:FractureZone .

sorealt:ThrustSystem a owl:Class ;
    rdfs:label "thrust system"@en ;
    rdfs:comment "A thrust fault system is one in which the higher side of the fault moves upward. [Wikipedia]"@en ;
    rdfs:subClassOf sorealt:FractureZone .

sorealt:TransformFault a owl:Class ;
    rdfs:label "transform fault"@en ;
    rdfs:subClassOf sophso:Fault .

sorealt:TransformMargin a owl:Class ;
    rdfs:label "transform margin"@en .

sorealt:TransformPlateBoundary a owl:Class ;
    rdfs:label "transform plate boundary"@en .

sorealt:TripleJunction a owl:Class ;
    rdfs:label "triple junction"@en ;
    rdfs:comment "The Galapagos Triple Junction is a geological area in the eastern Pacific Ocean several hundred miles west of the Galapagos Islands where three tectonic plates - the Cocos Plate, the Nazca Plate and the Pacific Plate - meet. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicBoundary .

sorealv:CompoundVolcano a owl:Class ;
    rdfs:label "compound volcano"@en ;
    rdfs:comment "A volcano that consists of a complex of two or more vents, or a volcano that has an associated volcanic dome, either in its crater or on its flanks."@en ;
    rdfs:subClassOf sorealv:Volcano .

sorealv:Geyser a owl:Class ;
    rdfs:label "geyser"@en ;
    rdfs:subClassOf sorealv:Vent .

sorealv:LinearVolcanicChain a owl:Class ;
    rdfs:label "linear volcanic chain"@en ;
    rdfs:comment "Where this association of flood basalts with continental rifting is observed, it is not uncommon to find linear chains of volcanic islands  [Wikipedia]"@en ;
    rdfs:subClassOf sorealv:VolcanicChain .

sorealv:SubmarineVolcano a owl:Class ;
    rdfs:label "submarine volcano"@en .

sorealv:VolcanicField a owl:Class ;
    rdfs:label "volcanic field"@en ;
    rdfs:comment "A volcanic field is a spot of the earth's crust that is prone to localized volcanic activity. They usually contain 10 to 100 volcanoes, such as cinder cones and are usually in clusters. Lava flows may also occur. They may occur as a monogenetic volcanic field or a polygenetic volcanic field. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

soreal:LandSurface a owl:Class ;
    rdfs:label "land surface"@en .

soreal:Lowland a owl:Class ;
    rdfs:label "lowland"@en ;
    rdfs:subClassOf soreal:Landform .

soreal:PitCrater a owl:Class ;
    rdfs:label "pit crater"@en ;
    rdfs:subClassOf soreal:Crater .

soreao:Abyssal a owl:Class ;
    rdfs:label "abyssal"@en .

soreao:AbyssopelagicZone a owl:Class ;
    rdfs:label "abyssopelagic zone"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:BathypelagicZone a owl:Class ;
    rdfs:label "bathypelagic zone"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:BenthicZone a owl:Class ;
    rdfs:label "benthic zone"@en ;
    rdfs:comment "Benthic means anything associated with or happening on the bottom of a body of water. The Benthic Zone of the ocean is the bottom ocean zone ranging from the deepest parts of the ocean to the tidal affected areas. The most productive region of the benthic zone is the area over the continental margin, which is unaffected by the tides."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreao:DemersalZone ;
            owl:onProperty sorelsp:below ],
        soreao:WaterBodyLayer .

soreao:DemersalZone a owl:Class ;
    rdfs:label "demersal zone"@en ;
    rdfs:comment "The demersal zone is the part of the sea or ocean (or deep lake) comprising the water column that is near to (and is significantly affected by) the seabed and the benthos. The demersal zone is just above the benthic zone and forms a layer of the larger profundal zone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreao:ProfundalZone ;
            owl:onProperty sorel:hasRealm ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreao:BenthicZone ;
            owl:onProperty sorelsp:above ],
        soreao:WaterBodyLayer .

soreao:MesopelagicZone a owl:Class ;
    rdfs:label "mesopelagic zone"@en ;
    rdfs:subClassOf soreao:WaterBodyLayer .

soreao:PelagicZone a owl:Class ;
    rdfs:label "pelagic zone"@en ;
    rdfs:comment "The pelagic zone is the part of the open sea or ocean that is not near the coast."@en ;
    rdfs:subClassOf soreao:OceanRegion .

soreaofe:AtlanticOcean a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "atlantic ocean"@en .

soreaofe:OceanDepth a owl:Class ;
    rdfs:label "ocean depth"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meter ;
            owl:onProperty sorelsc:hasUnit ],
        sopropsh:Depth .

soreaofe:PacificOcean a soreaofe:EarthOcean,
        owl:NamedIndividual ;
    rdfs:label "pacific ocean"@en .

<http://sweetontology.net/realmOceanFloor> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Ocean Floor" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenSolid>,
        <http://sweetontology.net/propSpaceDistance>,
        <http://sweetontology.net/realmHydroBody>,
        <http://sweetontology.net/realmLandFluvial>,
        <http://sweetontology.net/realmLandOrographic>,
        <http://sweetontology.net/realmLandVolcanic>,
        <http://sweetontology.net/realmLandform>,
        <http://sweetontology.net/rela> ;
    owl:versionInfo "3.6.0" .

soreaofl:DeepSeaTrench a owl:Class ;
    rdfs:label "deep sea trench"@en ;
    rdfs:subClassOf sorealf:Trench,
        soreaofl:SeaFloor .

soreaofl:Seabed a owl:Class ;
    rdfs:label "seabed"@en .

soreaofl:Seamount a owl:Class ;
    rdfs:label "seamount"@en ;
    rdfs:comment "A seamount is a mountain rising from the ocean seafloor that does not reach to the water's surface (sea level), and thus is not an island. These are typically formed from extinct volcanoes, that rise abruptly and are usually found rising from a seafloor of 1,000 - 4,000 meters depth. They are defined by oceanographers as independent features that rise to at least 1,000 meters above the seafloor. The peaks are often found hundreds to thousands of meters below the surface, and are therefore considered to be within the deep sea.[1] An estimated 30,000 seamounts occur across the globe, with only a few having been studied. However, some seamounts are also unusual."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaofl:SeaFloor ;
            owl:onProperty sorel:hasRealm ],
        sorealo:Mountain .

sorear:LowLatitude a sorear:LatitudeBand,
        owl:NamedIndividual ;
    rdfs:label "low latitude"@en ;
    owl:sameAs sorear:Tropical,
        sorear:Tropics .

sorear:NorthLatitudeLine a owl:Class ;
    rdfs:label "north latitude line"@en ;
    rdfs:subClassOf sorear:LatitudeLine .

sorear:NorthernHemisphere a owl:Class ;
    rdfs:label "northern hemisphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 90 ;
            owl:onProperty sorelm:hasUpperBound ],
        sorear:NorthLatitudeBand .

sorear:SouthLatitudeLine a owl:Class ;
    rdfs:label "south latitude line"@en ;
    rdfs:subClassOf sorear:LatitudeLine .

sorear:SouthernHemisphere a owl:Class ;
    rdfs:label "southern hemisphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue -90 ;
            owl:onProperty sorelm:hasLowerBound ],
        sorear:SouthLatitudeBand .

sorear:Tropical a sorear:LatitudeBand,
        owl:NamedIndividual ;
    rdfs:label "tropical"@en .

<http://sweetontology.net/realmSoil> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Soil" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenMixing>,
        <http://sweetontology.net/propCategorical>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/statePhysical> ;
    owl:versionInfo "3.6.0" .

soreas:Gelisol a owl:Class ;
    rdfs:label "gelisol"@en ;
    rdfs:comment "Gelisols are soils of very cold climates which are defined as containing permafrost within two metres of the soil surface. The word Gelisol comes from the Latin gelare meaning to freeze, a reference to the process of cryoturbation that occurs from the alternating thawing and freezing characteristic of Gelisols."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophm:Cryoturbation ;
            owl:onProperty sorel:hasProcess ],
        soreas:SoilOrder .

soreas:OrganicMatter a owl:Class ;
    rdfs:label "organic matter"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsp:above ;
            owl:someValuesFrom soreas:P_Horizon ],
        [ a owl:Restriction ;
            owl:onProperty sorelsp:above ;
            owl:someValuesFrom soreas:Topsoil ],
        soreas:SoilLayer .

soreas:P_Horizon a owl:Class ;
    rdfs:label "p horizon"@en ;
    rdfs:subClassOf soreas:SoilLayer .

soreas:Substratum a owl:Class ;
    rdfs:label "substratum"@en .

sorel:contains a owl:ObjectProperty ;
    rdfs:label "contains"@en .

sorelch:atomicWeight a owl:ObjectProperty ;
    rdfs:label "atomic weight"@en .

sorelch:hasChemical_2 a owl:ObjectProperty ;
    rdfs:label "has chemical 2"@en ;
    rdfs:subPropertyOf sorelch:hasSubstance .

sorelch:hasMaterial a owl:ObjectProperty ;
