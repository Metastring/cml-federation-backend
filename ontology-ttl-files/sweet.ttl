sostv:Bright a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "bright"@en ;
    sorelph:moreVisibleThan sostv:Dark .

sostv:CentralDenseOvercast a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "central dense overcast"@en ;
    rdfs:comment "The region of dense cloud near the core of a tropical cyclone."@en .

sostv:Clear a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "clear"@en ;
    sorelph:moreVisibleThan sostv:Cloudy,
        sostv:Colored,
        sostv:Dark,
        sostv:Dim,
        sostv:Dirty,
        sostv:Dusty,
        sostv:Hazy,
        sostv:Murky,
        sostv:Turbid ;
    owl:sameAs sostv:Sunny .

sostv:Glassy a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "glassy"@en .

sostv:Light a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "light"@en ;
    sorelph:moreVisibleThan sostv:Dark .

sostv:Luminous a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "luminous"@en ;
    sorelph:moreVisibleThan sostv:Opaque .

sostv:Overcast a sopropo:Visibility,
        owl:NamedIndividual ;
    rdfs:label "overcast"@en .

sostv:PartlyCloudy a sopropo:Visibility,
