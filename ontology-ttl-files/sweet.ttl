        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical> ;
    owl:versionInfo "3.6.0" .

<http://sweetontology.net/phenSystemComplexity> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena System Complexity" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/reprMathFunction> ;
    owl:versionInfo "3.6.0" .

<http://sweetontology.net/procChemical> a owl:Ontology ;
    rdfs:label "SWEET Ontology Process Chemical" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrParticle>,
        <http://sweetontology.net/proc>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/stateSystem> ;
    owl:versionInfo "3.6.0" .

soprocp:Rotation a owl:Class ;
    rdfs:label "rotation"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

<http://sweetontology.net/procWave> a owl:Ontology ;
    rdfs:label "SWEET Ontology Process Wave" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/phenWave>,
        <http://sweetontology.net/procPhysical> ;
    owl:versionInfo "3.6.0" .

soprop:HydrogeologicalProperty a owl:Class ;
    rdfs:label "hydrogeological property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelh:studyOf ;
            owl:someValuesFrom sohukd:Hydrology ],
        soprop:GeologicalProperty .

soprop:Measure a owl:Class ;
    rdfs:label "measure"@en ;
    rdfs:subClassOf soprop:Property .

soprop:Metric a owl:Class ;
    rdfs:label "metric"@en ;
    rdfs:subClassOf soprop:Measure .

soprope:ChemicalEnergy a owl:Class ;
    rdfs:label "chemical energy"@en ;
    rdfs:subClassOf soprop:ChemicalProperty,
        soprope:Energy .

<http://sweetontology.net/propEnergyFlux> a owl:Ontology ;
    rdfs:label "SWEET Ontology Property Energy Flux" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenGeolSeismicity>,
        <http://sweetontology.net/phenStar>,
        <http://sweetontology.net/propEnergy>,
        <http://sweetontology.net/propQuantity>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/repr>,
        <http://sweetontology.net/reprSciUnits> ;
    owl:versionInfo "3.6.0" .

sopropfu:TimeMean a owl:Class ;
    rdfs:label "time mean"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:averageOver ;
            owl:someValuesFrom sorept:Time ],
        sopropfu:Average .

sopropi:HealthIndex a owl:Class ;
    rdfs:label "health index"@en ;
    rdfs:subClassOf soprop:BiologicalProperty,
        sopropi:Index .

sopropo:FlareClass a owl:Class ;
    rdfs:label "flare class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropef:EnergyFlux ;
            owl:onProperty sorelsc:measureOf ],
        soprop:PhysicalProperty .

sopropo:ProcessingLevel a owl:Class ;
    rdfs:label "processing level"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropq:PhysicalConstant a owl:Class ;
    rdfs:label "physical constant"@en ;
    rdfs:subClassOf sorepm:Constant .

soprops:SpatialExtent a owl:Class ;
    rdfs:label "spatial extent"@en ;
    rdfs:subClassOf soprops:LinearExtent .

soproptg:TemperatureGradient a owl:Class ;
    rdfs:label "temperature gradient"@en ;
    rdfs:comment "The derivative of temperature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:Temperature ;
            owl:onProperty sorelm:hasGradient ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:kelvinPerMeter ;
            owl:onProperty sorelsc:hasUnit ],
        sopropq:ThermodynamicQuantity ;
    owl:equivalentClass soproptg:ThermalGradient .

<http://sweetontology.net/realmAtmo> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Atmospheric" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrAerosol>,
        <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/phenFluidInstability>,
        <http://sweetontology.net/propTemperatureGradient>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

soreacz:DryWinterClimate a owl:Class ;
    rdfs:label "dry winter climate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepts:Winter ;
            owl:onProperty sorelcl:hasDrySeason ],
        soreacz:ClimateClassification .

soreag:Lithosphere a owl:Class ;
    rdfs:label "lithosphere"@en ;
    rdfs:comment "In the Earth, the lithosphere includes the crust and the uppermost mantle, which constitute the hard and rigid outer layer of the planet. The division of Earth's outer layers into lithosphere and asthenosphere should not be confused with the chemical subdivision of the outer Earth into mantle, and crust. All crust is in the lithosphere, but lithosphere generally contains more mantle than crust. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Rock ;
            owl:onProperty sorelsc:containsMaterial ],
        soreag:GeosphereLayer .

soreag:PlutonicStructure a owl:Class ;
    rdfs:label "plutonic structure"@en ;
    rdfs:subClassOf soreag:GeologicStructure .

sorealc:CoastalLandform a owl:Class ;
    rdfs:label "coastal landform"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorealc:CoastalRegion ],
        soreal:Landform .

sorealf:FluvialPlain a owl:Class ;
    rdfs:label "fluvial plain"@en ;
    rdfs:subClassOf soreal:Plain .

sorealp:LandReserve a owl:Class ;
    rdfs:label "land reserve"@en ;
    rdfs:subClassOf sohuj:AdministrativeRegion,
        somanr:LandResource .

soreal:Crater a owl:Class ;
    rdfs:label "crater"@en ;
    rdfs:subClassOf soreal:Landform,
        sorepsg3:Cavity .

<http://sweetontology.net/realmOcean> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Ocean" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenBiol>,
        <http://sweetontology.net/propChemical>,
        <http://sweetontology.net/propIndex>,
        <http://sweetontology.net/propSpaceDistance>,
        <http://sweetontology.net/propTemperatureGradient>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmCryo>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/reprMathOperation> ;
    owl:versionInfo "3.6.0" .

soreaofe:EarthOceanCurrent a owl:Class ;
    rdfs:label "earth ocean current"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorea:Earth ;
            owl:onProperty sorelph:hasAstronomicalBody ],
        sophod:OceanCurrent .

soreaofe:OceanArea a owl:Class ;
    rdfs:label "ocean area"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:million_km2 ;
            owl:onProperty sorelsc:hasUnit ],
        sopropsm:Area .

<http://sweetontology.net/realmRegion> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Region" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propQuantity>,
