sopropfr:Humidity a owl:Class ;
    rdfs:label "humidity"@en ;
    rdfs:comment "1. Generally, some measure of the water vapor content of air. The multiplicity of humidity measures is partly due to different methods of measurement and partly because the conservative measures (mixing ratio, specific humidity) cover an extremely wide dynamic range, as a result of the rapid variation of saturation vapor pressure with temperature. 2. Popularly, same as relative humidity."@en ;
    rdfs:subClassOf sopropche:WaterConcentration,
        sopropfr:FractionalQuantity .

sopropfu:CriticalPoint a owl:Class ;
    rdfs:label "critical point"@en ;
    rdfs:subClassOf sopropfu:Threshold .

sopropfu:Minimum a owl:Class ;
    rdfs:label "minimum"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropfu:MonthlyAverage a owl:Class ;
    rdfs:label "monthly average"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:month ;
            owl:onProperty sorelm:averageOver ],
        sopropfu:TimeMean .

sopropfu:Spread a owl:Class ;
    rdfs:label "spread"@en ;
    rdfs:subClassOf sopropdife:Deviation .

sopropfu:Threshold a owl:Class ;
    rdfs:label "threshold"@en ;
    rdfs:subClassOf soprop:StatisticalSummary .

sopropi:ClimateIndicator a owl:Class ;
    rdfs:label "climate indicator"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophpc:Climate ;
            owl:onProperty sorelsc:measureOf ],
        sopropi:EnvironmentalIndicator .

sopropi:Turbidity a owl:Class ;
    rdfs:label "turbidity"@en ;
    rdfs:comment "The effect of (primarily) aerosols, through their total optical depth, in reducing the transmission of direct solar radiation to the surface below that through a purely molecular atmosphere. Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles (suspended solids) that are generally invisible to the naked eye, similar to smoke in air."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:FTU ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:RadiationMediumInteractionQuantity .

sopropm:Dose a owl:Class ;
    rdfs:label "dose"@en .

sopropmf:PrimaryProductivity a owl:Class ;
    rdfs:label "primary productivity"@en ;
    rdfs:subClassOf sopropmf:Productivity .

sopropp:BarometricPressure a owl:Class ;
    rdfs:label "barometric pressure"@en ;
    rdfs:comment "The pressure exerted by the atmosphere as a consequence of gravitational attraction exerted upon the column of air lying directly above the point in question."@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:Strength a owl:Class ;
    rdfs:label "strength"@en ;
    rdfs:subClassOf sopropm:StrengthProperty .

sopropp:Stress a owl:Class ;
    rdfs:label "stress"@en ;
    rdfs:subClassOf sopropp:Pressure .

sopropp:TensileStress a owl:Class ;
    rdfs:label "tensile stress"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Perpendicular ;
            owl:onProperty sorelsp:hasDirection ],
        sopropp:Stress .

sopropq:BudgetEquation a owl:Class ;
    rdfs:label "budget equation"@en ;
    rdfs:comment "In general, an equation expressing a balance of quantities in the sense that the local or individual rates of change are zero."@en ;
    rdfs:subClassOf sorepm:Equation .

sopropq:ChemicalQuantity a owl:Class ;
    rdfs:label "chemical quantity"@en ;
    rdfs:subClassOf soprop:ChemicalProperty,
        sopropq:Quantity .

sopropq:Potential a owl:Class ;
    rdfs:label "potential"@en ;
    rdfs:subClassOf sopropq:PhysicalQuantity .

sopropq:ScalarPotential a owl:Class ;
    rdfs:label "scalar potential"@en ;
    rdfs:subClassOf sopropq:Potential .

sopropr:Vorticity a owl:Class ;
    rdfs:label "vorticity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:perSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sorepmo:VectorFieldOperation .

soprops:Configuration a owl:Class ;
    rdfs:label "configuration"@en ;
    owl:equivalentClass soprops:SpatialConfiguration .

sopropsdis:DistanceRange_km a owl:Class ;
    rdfs:label "distance range km"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilometer ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropsdis:DistanceRange .

sopropsdis:SpatialFrequency a owl:Class ;
    rdfs:label "spatial frequency"@en ;
    rdfs:subClassOf sopropq:RadiationMediumInteractionQuantity,
        sopropsdis:PerMeterQuantity .

sopropsdis:Wavelength_cm a owl:Class ;
    rdfs:label "wavelength cm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:centimeter ;
            owl:onProperty sorelsc:hasUnit ],
        sopropsdis:Wavelength .

sopropsh:Altitude a owl:Class ;
    rdfs:label "altitude"@en ;
    rdfs:comment "A measure (or condition) of height, especially of great height, as a mountain top or aircraft flight level."@en,
        "The vertical distance above mean sea level of the ground at the meteorological station."@en ;
    rdfs:subClassOf sopropsh:Height ;
    owl:equivalentClass sopropsh:Elevation .

sopropsh:Elevation a owl:Class ;
    rdfs:label "elevation"@en ;
    rdfs:subClassOf sopropsh:Height .

sopropsh:HeightRange a owl:Class ;
    rdfs:label "height range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:rangeOf ;
            owl:someValuesFrom sopropsh:Height ],
        sopropq:IntervalQuantity .

sopropst:Evapotranspiration a owl:Class ;
    rdfs:label "evapotranspiration"@en ;
    rdfs:subClassOf sopropst:Thickness .

sopropst:LiquidWaterEquivalent a owl:Class ;
    rdfs:label "liquid water equivalent"@en ;
    rdfs:subClassOf sopropst:WaterContent .

sopropst:PrecipitationRange_cm a owl:Class ;
    rdfs:label "precipitation range cm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:centimeter ;
            owl:onProperty sorelsc:hasUnit ],
        sopropst:PrecipitationRange .

sopropst:StageHeight a owl:Class ;
    rdfs:label "stage height"@en ;
    rdfs:subClassOf sopropst:WaterHeight .

sopropst:WaterHeight a owl:Class ;
    rdfs:label "water height"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:LiquidWater ;
            owl:onProperty sorelch:hasSubstance ],
        sopropst:Thickness .

sopropsp:Momentum a owl:Class ;
    rdfs:label "momentum"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogramMeterPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:MotionProperty,
        sopropq:PhysicalQuantity .

sopropt:DewPointTemperature a owl:Class ;
    rdfs:label "dew point temperature"@en .

sopropt:WarmestMonthTemperature a owl:Class ;
    rdfs:label "warmest month temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sorepts:WarmestMonth ],
        sopropt:Temperature .

soproptg:LapseRate a owl:Class ;
    rdfs:label "lapse rate"@en ;
    rdfs:subClassOf soproptg:TemperatureHeightDerivative .

soproptg:NegativeSlope a soproptg:TemperatureGradientRange,
        owl:NamedIndividual ;
    rdfs:label "negative slope"@en .

soproptg:PositiveSlope a soproptg:TemperatureGradientRange,
        owl:NamedIndividual ;
    rdfs:label "positive slope"@en .

soproptg:TemperatureGradientRange a owl:Class ;
    rdfs:label "temperature gradient range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:rangeOf ;
            owl:someValuesFrom soproptg:TemperatureGradient ],
        sopropq:IntervalQuantity .

soproptf:Convergence a owl:Class ;
    rdfs:label "convergence"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepmf:VectorField ;
            owl:onProperty sorelm:hasOutput ],
        sorepmo:VectorFieldOperation .

soproptf:Tendency a owl:Class ;
    rdfs:label "tendency"@en .

soreaab:Planet a owl:Class ;
    rdfs:label "planet"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaab:Star ;
            owl:onProperty sorelph:revolvesAround ],
        soreaab:AstronomicalBody .

soreaab:Star a owl:Class ;
    rdfs:label "star"@en ;
    rdfs:subClassOf soreaab:AstronomicalBody .

<http://sweetontology.net/realmAstroHelio> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Astrophysical Heliosphere" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/propOrdinal>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/statePhysical>,
        <http://sweetontology.net/stateSpectralBand> ;
    owl:versionInfo "3.6.0" .

<http://sweetontology.net/realmAstroStar> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Astrophysical" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/procChemical>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmAstroBody>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/statePhysical> ;
    owl:versionInfo "3.6.0" .

soreaa:Mesopause a owl:Class ;
    rdfs:label "mesopause"@en ;
    rdfs:comment "The top of the mesosphere and the base of the thermosphere. The mesopause is usually located at heights of 85?95 km, and is the site of the coldest temperatures in the atmosphere. Temperatures as low as 100 K (- 173?C) have been measured at the mesopause by rockets. See atmospheric shell."@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaa:Stratopause a owl:Class ;
    rdfs:label "stratopause"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaa:Tropopause a owl:Class ;
    rdfs:label "tropopause"@en ;
    rdfs:subClassOf sorea:PlanetaryBoundary .

soreaa:Troposphere a owl:Class ;
    rdfs:label "troposphere"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:hasLowerBoundary ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreaa:Tropopause ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        [ a owl:Restriction ;
            owl:hasValue soproptg:NegativeSlope ;
            owl:onProperty sorelph:dTdh ],
        soreaa:AtmosphereLayer .

soreaabl:MixedLayer a owl:Class ;
    rdfs:label "mixed layer"@en ;
    rdfs:comment "A type of atmospheric boundary layer characterized by vigorous turbulence tending to stir and uniformly mix, primarily in the vertical, quantities such as conservative tracer concentrations, potential temperature, and momentum or wind speed."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:Turbulence ;
            owl:onProperty sorel:hasPhenomena ],
        soreaabl:BoundaryLayer .

soreaaw:CondensationLevel a owl:Class ;
    rdfs:label "condensation level"@en ;
    rdfs:comment "Level at which water vapor to condense"@en ;
    rdfs:subClassOf sopropsh:Level .

soreabb:Ecosystem a owl:Class ;
    rdfs:label "ecosystem"@en ;
    rdfs:subClassOf sorepsc:Environment .

soreabb:MarineEcosystem a owl:Class ;
    rdfs:label "marine ecosystem"@en ;
    rdfs:subClassOf soreabb:AquaticEcosystem .

soreabb:Wildlands a owl:Class ;
    rdfs:label "wildlands"@en ;
    rdfs:subClassOf soreabb:TerrestrialBiome .

soreacz:BW a soreacz:B,
        owl:NamedIndividual ;
    rdfs:label "bw"@en ;
    rdfs:comment "The BW climate classification, also known as the arid climate classification, is characterized by having precipitation amounts less than 1/2 potential evapotranspiration (POTET)."@en .

soreacz:TropicalRainForestClimate a soreacz:A,
        owl:NamedIndividual ;
    rdfs:label "tropical rain forest climate"@en .

soreag:Continental a owl:Class ;
    rdfs:label "continental"@en ;
    rdfs:subClassOf sorea:PlanetaryRealm .

soreag:SolidEarth a owl:Class ;
    rdfs:label "solid earth"@en .

soreag:Subsurface a owl:Class ;
    rdfs:label "subsurface"@en ;
    rdfs:subClassOf sorea:PlanetaryRealm .

soreagcons:Corona a owl:Class ;
    rdfs:label "corona"@en ;
    rdfs:comment "Constituent occurs as a concentric envelope enclosing another constituent. Corona is a non-genetic term."@en ;
    rdfs:subClassOf soreagcons:StructuralConfiguration .

<http://sweetontology.net/realmGeolContinental> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Geologic Continental" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrRockIgneous>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmGeolBasin>,
        <http://sweetontology.net/realmLandTectonic>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/stateRoleGeographic> ;
    owl:versionInfo "3.6.0" .

soreagcont:Craton a owl:Class ;
    rdfs:label "craton"@en ;
    rdfs:comment "A craton is an old and stable part of the continental crust that has survived the merging and splitting of continents and supercontinents for at least 500 million years. Some are over two billion years old. Cratons are generally found in the interiors of continents and are characteristically composed of ancient crystalline basement crust of lightweight felsic igneous rock such as granite. They have a thick crust and deep roots that extend into the mantle beneath to depths of 200 km. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalCrust ;
            owl:onProperty sorel:partOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom somarocki:Kimberlite ;
            owl:onProperty sorelch:hasSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagb:IntracratonicBasin ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:ContinentalPlatform ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagcont:Shield ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        soreag:GeologicProvince .

soreagor:Orogen a owl:Class ;
    rdfs:label "orogen"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom sorealt:Suture ],
        [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom sorealt:ThrustSystem ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophg:OrogenicCollapse ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophg:Orogeny ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophso:Deformation ],
        [ a owl:Restriction ;
            owl:onProperty sorelch:hasSubstance ;
            owl:someValuesFrom somarock:Melange ],
        [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom sophgt:Terrane ],
        [ a owl:Restriction ;
            owl:onProperty sorelph:hasPlanetaryStructure ;
            owl:someValuesFrom soreagb:ForelandBasin ],
        soreag:GeologicProvince .

soreagor:RearArc a owl:Class ;
    rdfs:label "rear arc"@en .

soreah:VadoseZone a owl:Class ;
    rdfs:label "vadose zone"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

soreahb:Estuary a owl:Class ;
    rdfs:label "estuary"@en ;
    rdfs:comment "An estuary is a semi-enclosed coastal body of water with one or more rivers or streams flowing into it, and with a free connection to the open sea. Estuaries are often associated with high rates of biological productivity. An estuary is where the river meets the sea. An estuary is typically the tidal mouth of a river, and estuaries are often characterized by sedimentation or silt carried in from terrestrial runoff and, frequently, from offshore. They are made up of brackish water. Estuaries are more likely to occur on submerged coasts, where the sea level has risen in relation to the land; this process floods valleys to form rias and fjords. These can become estuaries if there is a stream or river flowing into them."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelch:hasSubstance ;
            owl:someValuesFrom somaw:BrackishWater ],
        [ a owl:Restriction ;
            owl:allValuesFrom somas:Sediment ;
            owl:onProperty sorelch:hasSubstance ],
        soreahb:BodyOfWater .

<http://sweetontology.net/realmLandAeolian> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Aeolian" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenGeolGeomorphology>,
        <http://sweetontology.net/propSpaceHeight>,
        <http://sweetontology.net/realmLandform>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaSpace> ;
    owl:versionInfo "3.6.0" .

soreala:Desert a owl:Class ;
    rdfs:label "desert"@en ;
    rdfs:comment "A desert is a landscape form or region that receives very little precipitation."@en ;
    rdfs:subClassOf soreala:AeolianLandform .

soreala:Dune a owl:Class ;
    rdfs:label "dune"@en ;
    rdfs:comment "A dune is a hill of sand built by eolian processes. Dunes are subject to different forms and sizes based on their interaction with the wind. Most kinds of dune are longer on the windward side where the sand is pushed up the dune, and a shorter slip face in the lee of the wind. The valley or trough between dunes is called a slack. A dune field is an area covered by extensive sand dunes. Large dune fields are known as ergs."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somas:Sand ;
            owl:onProperty sorelch:hasSubstance ],
        soreala:AeolianLandform ;
    owl:equivalentClass soreala:SandDune .

soreala:Eolian a owl:Class ;
    rdfs:label "eolian"@en .

sorealf:Bedform a owl:Class ;
    rdfs:label "bedform"@en ;
    rdfs:subClassOf sorealf:FluvialLandform .

sorealf:Watershed a owl:Class ;
    rdfs:label "watershed"@en ;
    rdfs:comment "A watershed refers to a divide that separates one drainage area from another drainage area. However, in the US and Canada, the term is often used to mean a drainage basin or catchment area itself. [Wikipedia]"@en ;
    rdfs:subClassOf soreal:LandRegion .

sorealg:GlacialPlain a owl:Class ;
    rdfs:label "glacial plain"@en ;
    rdfs:subClassOf sorealg:GlacialLandform,
        soreal:Plain .

sorealt:StressRegime a owl:Class ;
    rdfs:label "stress regime"@en ;
    rdfs:comment "Stress regimes are shear zones. A shear zone or shear is a wide zone of distributed shearing in rock. Typically this is a type of fault but it may be difficult to place a distinct fault plane into the shear zone. Shear zones may form zones of much more intense foliation, deformation, and folding. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicBoundary .

sorealt:TectonicLandform a owl:Class ;
    rdfs:label "tectonic landform"@en ;
    rdfs:subClassOf soreal:Landform .

<http://sweetontology.net/realmLandVolcanic> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Land Volcanic" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrRockIgneous>,
        <http://sweetontology.net/phenGeolVolcano>,
        <http://sweetontology.net/phenSolid>,
        <http://sweetontology.net/propEnergy>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/realmLandform>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical> ;
    owl:versionInfo "3.6.0" .

sorealv:Vent a owl:Class ;
    rdfs:label "vent"@en ;
    rdfs:subClassOf sophso:Crack,
        soreag:GeologicFeature .

sorealv:VolcanicChain a owl:Class ;
    rdfs:label "volcanic chain"@en ;
    rdfs:comment "Island arcs that develop along the edges of a continent (for example, large parts of the Andes/ Central American/ Canadian mountain chain) may be known as a volcanic arc or volcanic chain. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicProvince .

soreal:Land a owl:Class ;
    rdfs:label "land"@en ;
    rdfs:subClassOf sorepsg:Region ;
    owl:equivalentClass soreal:LandRegion,
        soreal:LandSurface,
        soreal:SurfaceRegion .

soreao:AphoticZone a owl:Class ;
    rdfs:label "aphotic zone"@en ;
    rdfs:comment "The aphotic zone is the portion of a lake or ocean where there is little or no sunlight. It is formally defined as the depths beyond which less than 1% of sunlight penetrates. Consequently, bioluminescence is essentially the only light found in this zone. Most food comes from dead organisms sinking to the bottom of the lake or ocean from other zones. The depth of the aphotic zone can be greatly affected by such things as turbidity and the season of the year. The aphotic zone underlies the photic zone, which is that portion of the ocean directly affected by sunlight."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropi:Turbidity ;
            owl:onProperty sorelsc:hasQuantity ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreao:PhoticZone ;
            owl:onProperty sorelsp:below ],
        soreao:WaterBodyLayer .

soreao:ProfundalZone a owl:Class ;
    rdfs:label "profundal zone"@en ;
    rdfs:comment "The profundal zone is a deep zone of a body of water, such as an ocean or a lake, located below the range of effective light penetration. This is typically below the thermocline, the vertical zone in the water through which temperature drops rapidly. The lack of light in the profundal zone determines the type of biological community that can live in this region, which is distinctly different from the community in the overlying waters. The profundal zone is part of the aphotic zone."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreao:AphoticZone ;
            owl:onProperty sorel:hasRealm ],
        soreao:WaterBodyLayer .

<http://sweetontology.net/realmOceanFeature> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Ocean Feature" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
