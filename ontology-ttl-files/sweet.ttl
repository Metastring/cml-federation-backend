        <http://sweetontology.net/reprSpaceDirection>,
        <http://sweetontology.net/stateSpaceScale>,
        <http://sweetontology.net/stateThermodynamic> ;
    owl:versionInfo "3.6.0" .

sophpc:GlobalChange a owl:Class ;
    rdfs:label "global change"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Global ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophpc:ClimatePhenomena .

<http://sweetontology.net/phenReaction> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Reaction" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrIsotope>,
        <http://sweetontology.net/phenWaveNoise>,
