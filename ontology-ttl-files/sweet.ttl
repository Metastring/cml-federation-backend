    rdfs:label "basic"@en .

sopropche:Basicity a owl:Class ;
    rdfs:label "basicity"@en .

sopropche:ChemicalOxygenDemand a owl:Class ;
    rdfs:label "chemical oxygen demand"@en ;
    rdfs:subClassOf sopropche:OxygenDemand .

sopropche:Constituent a owl:Class ;
    rdfs:label "constituent"@en ;
