    owl:sameAs somaoc:Formaldehyde .

somaoc:CH2O2 a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "ch2o2"@en ;
    owl:sameAs somaoc:FormicAcid,
        somaoc:MethanoicAcid .

somaoc:CH3COOH a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "ch3cooh"@en ;
    owl:sameAs somaoc:EthanoicAcid .

somaoc:CH4 a somaoc:Alkane,
        somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "ch4"@en ;
    owl:sameAs somaoc:Methane .

somaoc:CaCO3 a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "caco3"@en ;
    owl:sameAs somaoc:CalciumCarbonate .

somaoc:Carbohydrate a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "carbohydrate"@en .

somaoc:Carbonyl a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "carbonyl"@en .

somaoc:CarbonylSulfide a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "carbonyl sulfide"@en ;
    owl:sameAs somaoc:OCS .

somaoc:ChlorinatedHydrocarbon a owl:Class ;
    rdfs:label "chlorinated hydrocarbon"@en ;
    rdfs:comment "Chlorinated hydrocarbons consist of simple hydrocarbons in which one or more hydrogen atoms have been replaced with chlorine."@en ;
    rdfs:subClassOf somaoc:Organochloride .

somaoc:ChlorophyllA a somaoc:Chlorophyll,
        owl:NamedIndividual ;
    rdfs:label "chlorophyll a"@en .

somaoc:FC a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "fc"@en ;
    owl:sameAs somaoc:Fluorocarbon .

somaoc:HC a owl:Class ;
    rdfs:label "hc"@en ;
    owl:equivalentClass somaoc:Hydrocarbon .

somaoc:HCFC140a a somaoc:HCFC,
        owl:NamedIndividual ;
    rdfs:label "hcfc140a"@en .

somaoc:HCFC141b a somaoc:HCFC,
        owl:NamedIndividual ;
    rdfs:label "hcfc141b"@en .

somaoc:HCFC142b a somaoc:HCFC,
        owl:NamedIndividual ;
    rdfs:label "hcfc142b"@en .

somaoc:HCFC22 a somaoc:HCFC,
        owl:NamedIndividual ;
    rdfs:label "hcfc22"@en .

somaoc:HCH a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "hch"@en ;
    owl:sameAs somaoc:Hexachlorocyclohexane .

somaoc:HCN a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "hcn"@en ;
    owl:sameAs somaoc:HydrogenCyanide .

somaoc:HClFC a somaoc:HCFC,
        owl:NamedIndividual ;
    rdfs:label "hclfc"@en .

somaoc:Hexachlorobiphenyl a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "hexachlorobiphenyl"@en ;
    owl:sameAs somaoc:PCB153 .

somaoc:Hydrofluorocarbon a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "hydrofluorocarbon"@en .

somaoc:Limonene a somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "limonene"@en .

somaoc:MethaneClathrate a owl:Class ;
    rdfs:label "methane clathrate"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somaoc:Methane ;
            owl:onProperty sorelch:hasSubstance ],
        somaoc:ClathrateHydrate ;
    owl:equivalentClass somaoc:MethaneHydrate,
        somaoc:MethaneIce .

somaoc:MethylBromide a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "methyl bromide"@en .

somaoc:MethylChloride a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "methyl chloride"@en .

somaoc:NMVOC a owl:Class ;
    rdfs:label "nmvoc"@en ;
    owl:equivalentClass somaoc:NonMethaneVolatileOrganicCompound .

somaoc:PCB a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "pcb"@en ;
    sorel:hasRole sostrb:Pesticide ;
    owl:sameAs somaoc:PolychlorinatedBiphenyl .

somaoc:Pheophytin a somaoc:Chlorophyll,
        owl:NamedIndividual ;
    rdfs:label "pheophytin"@en .

somaoc:Pinene a somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "pinene"@en .

somaoc:Silk a somaoc:OrganicCompound,
        owl:NamedIndividual ;
    rdfs:label "silk"@en .

somaoc:Terpene a somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "terpene"@en .

somapa:AnomalousEnergeticParticle a owl:Class ;
    rdfs:label "anomalous energetic particle"@en ;
    rdfs:subClassOf somapa:CosmicRay .

somapa:Atom a owl:Class ;
    rdfs:label "atom"@en ;
    rdfs:subClassOf sostp:SubstanceForm .

somapa:GammaRay a owl:Class ;
    rdfs:label "gamma ray"@en ;
    rdfs:comment "Gamma rays are a form of electromagnetic radiation or light emission of frequencies produced by sub-atomic particle interactions, such as electron-positron annihilation or radioactive decay. Gamma rays are generally characterized as electromagnetic radiation having the highest frequency and energy, and also the shortest wavelength, within the electromagnetic spectrum, i.e. high energy photons. Due to their high energy content, they can cause serious damage when absorbed by living cells."@en ;
    rdfs:subClassOf somapa:Photon .

somapa:HeavyNuclei a owl:Class ;
    rdfs:label "heavy nuclei"@en ;
    rdfs:subClassOf somapa:SubatomicParticle .

somapa:Molecule a owl:Class ;
    rdfs:label "molecule"@en ;
    rdfs:subClassOf sostp:SubstanceForm .

somapa:Nucleon a owl:Class ;
    rdfs:label "nucleon"@en ;
    rdfs:comment "A collective name for the two baryons: neutron and the proton."@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( somapa:Neutron somapa:Proton ) ] .

somapa:Particle a owl:Class ;
    rdfs:label "particle"@en ;
    rdfs:subClassOf soma:Substance .

somapa:SolarEnergeticParticle a owl:Class ;
    rdfs:label "solar energetic particle"@en ;
    rdfs:subClassOf somapa:CosmicRay .

somapl:Branch a owl:Class ;
    rdfs:label "branch"@en ;
    rdfs:subClassOf somapl:PlantPart .

somapl:Broadleaf a owl:Class ;
    rdfs:label "broadleaf"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Canopy a owl:Class ;
    rdfs:label "canopy"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Conifer a owl:Class ;
    rdfs:label "conifer"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Crop a owl:Class ;
    rdfs:label "crop"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Crown a owl:Class ;
    rdfs:label "crown"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:DominantSpecies a owl:Class ;
    rdfs:label "dominant species"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:DouglasFir a owl:Class ;
    rdfs:label "douglas fir"@en ;
    rdfs:subClassOf somapl:Tree .

somapl:Evergreen a owl:Class ;
    rdfs:label "evergreen"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Exotic a owl:Class ;
    rdfs:label "exotic"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Fern a owl:Class ;
    rdfs:label "fern"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Flora a owl:Class ;
    rdfs:label "flora"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:FloweringPlant a owl:Class ;
    rdfs:label "flowering plant"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Fruit a owl:Class ;
    rdfs:label "fruit"@en ;
    rdfs:comment "In botany, a fruit is the ripened ovary—together with seeds—of a flowering plant. In many species, the fruit incorporates the ripened ovary and surrounding tissues. Fruits are the means by which flowering plants disseminate seeds."@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Indigenous a owl:Class ;
    rdfs:label "indigenous"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Leaf a owl:Class ;
    rdfs:label "leaf"@en ;
    rdfs:subClassOf somapl:PlantPart .

somapl:Lichen a owl:Class ;
    rdfs:label "lichen"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Liverwort a owl:Class ;
    rdfs:label "liverwort"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Macroalgae a owl:Class ;
    rdfs:label "macroalgae"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Macrophyte a owl:Class ;
    rdfs:label "macrophyte"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Mangrove a owl:Class ;
    rdfs:label "mangrove"@en ;
    rdfs:comment "Mangroves (generally) are trees and shrubs that grow in saline coastal habitats in the tropics and subtropics. The word is used in at least three senses, (1) most broadly to refer to the habitat and entire plant assemblage or mangal, for which the terms mangrove swamp and mangrove forest are also used, (2) to refer to all trees and large shrubs in the mangal, and (3) narrowly to refer to the mangrove family of plants, the Rhizophoraceae, or even more specifically just to mangrove trees of the genus Rhizophora. Mangals are found in depositional coastal environments where fine sediments, often with high organic content, collect in areas protected from high energy wave action."@en ;
    rdfs:subClassOf somapl:Tree .

somapl:Moss a owl:Class ;
    rdfs:label "moss"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:Mushroom a owl:Class ;
    rdfs:label "mushroom"@en ;
    rdfs:subClassOf somapl:FungiTaxonomy .

somapl:Native a owl:Class ;
    rdfs:label "native"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Needleleaf a owl:Class ;
    rdfs:label "needleleaf"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:OldGrowth a owl:Class ;
    rdfs:label "old growth"@en ;
    rdfs:subClassOf somapl:Vegetation ;
    owl:disjointWith somapl:SecondGrowth .

somapl:Paleovegetation a owl:Class ;
    rdfs:label "paleovegetation"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Pollen a owl:Class ;
    rdfs:label "pollen"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:PonderosaPine a owl:Class ;
    rdfs:label "ponderosa pine"@en ;
    rdfs:subClassOf somapl:Tree .

somapl:Root a owl:Class ;
    rdfs:label "root"@en ;
    rdfs:comment "n vascular plants, the root is the organ of a plant body that typically lies below the surface of the soil (compare with stem). However, this is not always the case, since a root can also be aerial (that is, growing above the ground) or aerating (that is, growing up above the ground or especially above water). On the other hand, a stem normally occurring below ground is not exceptional either (see rhizome). So, it is better to define root as a part of a plant body that bears no leaves, and therefore also lacks nodes. There are also important internal structural differences between stems and roots. The two major functions of roots are 1.) absorption of water and inorganic nutrients and 2.) anchoring the plant body to the ground. Roots also function in cytokinin synthesis, which supplies some of shoot needs. They often function in storage of food. The roots of most vascular plant species enter into symbiosis with certain fungi to form mycorrhizas, and a large range of other organisms including bacteria also closely associate with roots."@en ;
    rdfs:subClassOf somapl:PlantPart .

somapl:Sclerophyll a owl:Class ;
    rdfs:label "sclerophyll"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:Thorn a owl:Class ;
    rdfs:label "thorn"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:TreeRing a owl:Class ;
    rdfs:label "tree ring"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somapl:Tree ;
            owl:onProperty sorelsc:componentOf ],
        somapl:PlantPart .

somapl:Trunk a owl:Class ;
    rdfs:label "trunk"@en ;
    rdfs:subClassOf somapl:PlantPart .

somapl:Twig a owl:Class ;
    rdfs:label "twig"@en ;
    rdfs:subClassOf somapl:PlantPart .

somapl:Vegetable a owl:Class ;
    rdfs:label "vegetable"@en ;
    rdfs:subClassOf somapl:Plant .

somapl:VegetationCover a owl:Class ;
    rdfs:label "vegetation cover"@en ;
    rdfs:subClassOf somapl:Vegetation .

somapl:VegetationSpecies a owl:Class ;
    rdfs:label "vegetation species"@en ;
    rdfs:subClassOf somapl:Vegetation .

somarock:Breccia a owl:Class ;
    rdfs:label "breccia"@en ;
    rdfs:subClassOf somarock:Rock .

somarock:Chondrite a owl:Class ;
    rdfs:label "chondrite"@en ;
    rdfs:subClassOf somarock:Meteorite .

somarock:HeterogenousRock a owl:Class ;
    rdfs:label "heterogenous rock"@en ;
    rdfs:comment "A heterogeneous or conglomerate is a rock consisting of individual stones that have become cemented together. Conglomerates are sedimentary rocks consisting of rounded fragments and are thus differentiated from breccias, which consist of angular clasts.[1] Both conglomerates and breccias are characterized by clasts larger than sand (>2 mm). [Wikipedia]"@en ;
    rdfs:subClassOf somarock:SedimentaryRock .

somarock:Macrofossil a owl:Class ;
    rdfs:label "macrofossil"@en ;
    rdfs:comment "Macrofossils are preserved organic remains large enough to be visible without a microscope. [Wikipedia]"@en ;
    rdfs:subClassOf somarock:Fossil .

somarock:Microfossil a owl:Class ;
    rdfs:label "microfossil"@en ;
    rdfs:comment "Fossils which are of microscopic size such as bacteria. [Wikipedia]"@en ;
    rdfs:subClassOf somarock:Fossil .

somarock:Regolith a owl:Class ;
    rdfs:label "regolith"@en ;
    rdfs:comment "Regolith (Greek: ‘blanket rock’) is a layer of loose, heterogeneous material covering solid rock (bedrock). It includes dust, soil, broken rock, and other related materials  [Wikipedia]"@en ;
    rdfs:subClassOf soma:Mixture ;
    owl:disjointWith somarock:Rock .

somarock:RockBody a owl:Class ;
    rdfs:label "rock body"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Rock ;
            owl:onProperty sorelch:hasSubstance ],
        soma:Mixture,
        soma:SolidSubstance .

somarock:Serpentinite a owl:Class ;
    rdfs:label "serpentinite"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Serpentinization ;
            owl:onProperty sorelpr:hasGenesis ],
        somarock:MetamorphicRock .

somarocki:Aa a owl:Class ;
    rdfs:label "aa"@en ;
    rdfs:comment "One of three basic types of flow lava. Aa is basaltic lava characterized by a rough or rubbly surface composed of broken lava blocks called clinker. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:Lava .

somarocki:Andesite a owl:Class ;
    rdfs:label "andesite"@en ;
    rdfs:comment "Volcanic rock (or lava) characteristically medium dark in color and containing 54 to 62 percent silica and moderate amounts of iron and magnesium."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Anorthosite a owl:Class ;
    rdfs:label "anorthosite"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:Aphanite a owl:Class ;
    rdfs:label "aphanite"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:Basalt a owl:Class ;
    rdfs:label "basalt"@en ;
    rdfs:comment "Basalt is the most common extrusive volcanic rock. It is usually grey to black and fine-grained due to rapid cooling of lava at the surface of a planet. It may be porphyritic containing larger crystals in a fine matrix, or vesicular, or frothy scoria. Unweathered basalt is black or grey. On Earth, most basalt magmas have formed by decompression melting of the mantle. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock .

somarocki:CinderCone a owl:Class ;
    rdfs:label "cinder cone"@en ;
    rdfs:comment "A volcanic cone built entirely of loose fragmented material (pyroclastics.)"@en ;
    rdfs:subClassOf somarocki:VolcanicCone .

somarocki:CompositeCone a owl:Class ;
    rdfs:label "composite cone"@en ;
    rdfs:comment "A steep volcanic cone built by both lava flows and pyroclastic eruptions"@en ;
    rdfs:subClassOf somarocki:VolcanicCone .

somarocki:Dacite a owl:Class ;
    rdfs:label "dacite"@en ;
    rdfs:comment "Volcanic rock (or lava) that characteristically is light in color and contains 62% to 69% silica and moderate a mounts of sodium and potassium."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Hypabyssal a owl:Class ;
    rdfs:label "hypabyssal"@en ;
    rdfs:comment "Hypabyssal are igneous rocks formed at a depth in between the plutonic and volcanic rocks. They are characterized by their porphyritic nature (porphyry). They consist of phenocrysts embedded in a fine-grained groundmass. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:Obsidian a owl:Class ;
    rdfs:label "obsidian"@en ;
    rdfs:comment "Obsidian, a type of quenched lava, is a silicic black volcanic glass [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:Lava .

somarocki:Pahoehoe a owl:Class ;
    rdfs:label "pahoehoe"@en ;
    rdfs:comment "Pahoehoe is basaltic lava that has a smooth, billowy, undulating, or ropy surface. These surface features are due to the movement of very fluid lava under a congealing surface crust. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:Lava .

somarocki:Peridotite a owl:Class ;
    rdfs:label "peridotite"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:PillowLava a owl:Class ;
    rdfs:label "pillow lava"@en ;
    rdfs:comment "Pillow lava is the lava structure typically formed when lava emerges from an underwater volcanic vent or subglacial volcano or a lava flow enters the ocean. However, pillow lava can also form when lava is erupted beneath thick glacial ice. The viscous lava gains a solid crust on contact with the water, and this crust cracks and oozes additional large blobs or ‘pillows’ as more lava emerges from the advancing flow. Since water covers the majority of Earth's surface and most volcanoes are situated near or under bodies of water, pillow lava is very common. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:Lava .

somarocki:Pluton a owl:Class ;
    rdfs:label "pluton"@en ;
    rdfs:comment "A pluton is an intrusive igneous rock body that crystallized from a magma slowly cooling below the surface of the Earth. Plutons include batholiths, dikes, sills, laccoliths, lopoliths, and other igneous bodies. In practice, ‘pluton’ usually refers to a distinctive mass of igneous rock, typically kilometers in dimension, without a tabular shape like those of dikes and sills. Batholiths commonly are aggregations of plutons. The most common rock types in plutons are granite, granodiorite, tonalite, and quartz diorite. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IntrusiveRock ;
    owl:equivalentClass somarocki:PlutonicRock .

somarocki:Pumice a owl:Class ;
    rdfs:label "pumice"@en ;
    rdfs:comment "Light-colored, frothy volcanic rock, usually of dacite or rhyolite composition, formed by the expansion of gas in erupting lava. Commonly seen as lumps or fragments of pea-size and larger, but can also occur abundantly as ash-sized particles."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Rhyolite a owl:Class ;
    rdfs:label "rhyolite"@en ;
    rdfs:comment "Volcanic rock (or lava) that characteristically is light in color, contains 69% silica or more, and is rich in potassium and sodium."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:SpatterCone a owl:Class ;
    rdfs:label "spatter cone"@en ;
    rdfs:comment "A low, steep-sided cone of spatter built up on a fissure or vent. It is usually of basaltic material."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Tephra a owl:Class ;
    rdfs:label "tephra"@en ;
    rdfs:comment "Tephra is a collective term (generally plural) used for all material -- regardless of size-- ejected during an explosive volcanic eruption."@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:VolcanicRock .

somarocki:Trachyandesite a owl:Class ;
    rdfs:label "trachyandesite"@en ;
    rdfs:comment "An extrusive rock intermediate in composition between trachyte and andesite."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Trachybasalt a owl:Class ;
    rdfs:label "trachybasalt"@en ;
    rdfs:comment "An extrusive rock intermediate in composition between trachyte and basalt."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Trachyte a owl:Class ;
    rdfs:label "trachyte"@en ;
    rdfs:comment "A group of fine-grained, generally porphyritic, extrusive igneous rocks having alkali feldspar and minor mafic minerals as the main components, and possibly a small amount of sodic plagioclase."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Tuff a owl:Class ;
    rdfs:label "tuff"@en ;
    rdfs:comment "Rock formed of pyroclastic material."@en ;
    rdfs:subClassOf somarocki:Pyroclastic .

somarocki:TuffCone a owl:Class ;
    rdfs:label "tuff cone"@en ;
    rdfs:comment "A type of volcanic cone formed by the interaction of basaltic magma and water. Smaller and steeper than a tuff ring."@en ;
    rdfs:subClassOf somarocki:VolcanicCone .

somarocki:TuffRing a owl:Class ;
    rdfs:label "tuff ring"@en ;
    rdfs:comment "A wide, low-rimmed, well-bedded accumulation of hyalo-clastic debris built around a volcanic vent located in a lake, coastal zone, marsh, or area of abundant ground water."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Ultramaphic a owl:Class ;
    rdfs:label "ultramaphic"@en ;
    rdfs:comment "The mantle is composed mostly of Ultramafic rocks (or see Igneous Primer) such as peridotite and dunite and their metamorphic equivalents (e.g. ecologite). [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:VolcanicRock .

somarocki:VolcanicNeck a owl:Class ;
    rdfs:label "volcanic neck"@en ;
    rdfs:comment "A massive pillar of rock more resistant to erosion than the lavas and pyroclastic rocks of a volcanic cone."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:Xenocryst a owl:Class ;
    rdfs:label "xenocryst"@en ;
    rdfs:comment "A xenocryst is an individual foreign crystal included within an igneous body. Examples of xenocrysts are quartz crystals in a silica-deficient lava and diamonds within kimberlite diatremes. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostso:Crystal ;
            owl:onProperty sorel:hasState ],
        soma:Mixture .

somarocki:Xenolith a owl:Class ;
    rdfs:label "xenolith"@en ;
    rdfs:comment "A xenolith is a rock fragment which becomes enveloped in a larger rock during the latter's development and hardening. The term xenolith is almost exclusively used to describe inclusions in igneous rock during magma emplacement and eruption [Wikipedia]"@en ;
    rdfs:subClassOf somarock:Rock .

somas:Alluvium a owl:Class ;
    rdfs:label "alluvium"@en ;
    rdfs:subClassOf somas:Sediment .

somas:AshFlow a owl:Class ;
    rdfs:label "ash flow"@en ;
    rdfs:comment "A turbulent mixture of gas and rock fragments, most of which are ash-sized particles, ejected violently from a crater or fissure. The mass of pyroclastics is normally of very high temperature and moves rapidly down the slopes or even along a level surface."@en ;
    rdfs:subClassOf somas:DebrisFlow .

somas:Ashfall a owl:Class ;
    rdfs:label "ashfall"@en ;
    rdfs:comment "Volcanic ash that has fallen through the air from an eruption cloud. A deposit so formed is usually well sorted and layered."@en ;
    rdfs:subClassOf somas:Ejecta .

somas:Bentonite a owl:Class ;
    rdfs:label "bentonite"@en ;
    rdfs:subClassOf somas:Clay .

somas:Block a owl:Class ;
    rdfs:label "block"@en ;
    rdfs:comment "Angular chunk of solid rock ejected during an eruption."@en ;
    rdfs:subClassOf somas:Ejecta .

somas:Bomb a owl:Class ;
    rdfs:label "bomb"@en ;
    rdfs:comment "Fragment of molten or semi-molten rock, 2 1/2 inches to many feet in diameter, which is blown out during an eruption. Because of their plastic condition, bombs are often modified in shape during their flight or upon impact."@en ;
    rdfs:subClassOf somas:Ejecta .

somas:Boulder a owl:Class ;
    rdfs:label "boulder"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Clast a owl:Class ;
    rdfs:label "clast"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Cobble a owl:Class ;
    rdfs:label "cobble"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Colluvium a owl:Class ;
    rdfs:label "colluvium"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Debris a owl:Class ;
    rdfs:label "debris"@en ;
    rdfs:subClassOf somas:Sediment .

somas:DebrisAvalanche a owl:Class ;
    rdfs:label "debris avalanche"@en ;
    rdfs:comment "A rapid and unusually sudden sliding or flowage of unsorted masses of rock and other material. As applied to the major avalanche involved in the eruption of Mount St. Helens, a rapid mass movement that included fragmented cold and hot volcanic rock, water, snow, glacier ice, trees, and some hot pyroclastic material. Most of the May 18, 1980 deposits in the upper valley of the North Fork Toutle River and in the vicinity of Spirit Lake are from the debris avalanche."@en ;
    rdfs:subClassOf somas:DebrisFlow .

somas:DrillingMud a owl:Class ;
    rdfs:label "drilling mud"@en ;
    rdfs:subClassOf somas:Mud .

somas:Gibber a owl:Class ;
    rdfs:label "gibber"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Granule a owl:Class ;
    rdfs:label "granule"@en ;
    rdfs:subClassOf somas:Gravel .

somas:HydrogenousSediment a owl:Class ;
    rdfs:label "hydrogenous sediment"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Hypoclastite a owl:Class ;
    rdfs:label "hypoclastite"@en ;
    rdfs:comment "A deposit formed by the flowing or intrusion of lava or magma into water, ice, or water-saturated sediment and its consequent granulation or shattering into small angular fragments."@en ;
    rdfs:subClassOf somas:VolcanicDeposit .

somas:Lahar a owl:Class ;
    rdfs:label "lahar"@en ;
    rdfs:comment "A torrential flow of water-saturated volcanic debris down the slope of a volcano in response to gravity. A type of mudflow."@en ;
    rdfs:subClassOf somas:Mudflow .

somas:Loam a owl:Class ;
    rdfs:label "loam"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Loess a owl:Class ;
    rdfs:label "loess"@en ;
    rdfs:subClassOf somas:Sediment .

somas:MarineSediment a owl:Class ;
    rdfs:label "marine sediment"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Pebble a owl:Class ;
    rdfs:label "pebble"@en ;
    rdfs:subClassOf somas:Gravel .

somas:Silt a owl:Class ;
    rdfs:label "silt"@en ;
    rdfs:subClassOf somas:Sediment .

somas:TerrigenousSediment a owl:Class ;
    rdfs:label "terrigenous sediment"@en ;
    rdfs:comment "In oceanography, terrigenous sediments are those derived from the erosion of rocks on land; that is, that are derived from terrestrial environments. Consisting of sand, mud, and silt carried to sea by rivers, their composition is usually related to their source rocks; deposition of these sediments is largely limited to the continental shelf."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophso:Erosion ;
            owl:onProperty sorelpr:hasGenesis ],
        somas:Sediment .

somas:Varve a owl:Class ;
    rdfs:label "varve"@en ;
    rdfs:comment "A varve is an annual layer of sediment or sedimentary rock."@en ;
    rdfs:subClassOf somas:Sediment .

somaw:BlackWater a owl:Class ;
    rdfs:label "black water"@en ;
    rdfs:subClassOf somaw:WaterMixture .

somaw:Brine a owl:Class ;
    rdfs:label "brine"@en ;
    rdfs:subClassOf somaw:SaltWater ;
    owl:disjointWith somaw:SalineWater .

somaw:CloudDrop a owl:Class ;
    rdfs:label "cloud drop"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropsdis:SizeRange_micron ] ;
            owl:onProperty sorelsp:diameter ],
        somaw:Drop .

somaw:DepthHoar a owl:Class ;
    rdfs:label "depth hoar"@en ;
    rdfs:comment "Depth hoares are large crystals occurring at the base of a snowpack that form due to the fact that a snow crystal can grow over time as moisture freezes onto the crystal from vapor that is rising in the snowpack."@en ;
    rdfs:subClassOf somaw:IceCrystal .

somaw:Dew a owl:Class ;
    rdfs:label "dew"@en ;
    rdfs:subClassOf somaw:LiquidWater .

somaw:DrinkingWater a owl:Class ;
    rdfs:label "drinking water"@en ;
    rdfs:subClassOf sohu:HumanNeed,
        somaw:WaterMixture .

somaw:DrizzleDrop a owl:Class ;
    rdfs:label "drizzle drop"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropsdis:SizeRange_micron ] ;
            owl:onProperty sorelsp:diameter ],
        somaw:Drop .

somaw:Firn a owl:Class ;
    rdfs:label "firn"@en ;
    rdfs:comment "Firn is partially-compacted névé, a type of snow that has been left over from past seasons and has been recrystallized into a substance denser than névé. It is ice that is at an intermediate stage between snow and glacial ice. Firn has the appearance of wet sugar, but has a hardness that makes it extremely resistant to shovelling. It generally has a density greater than 550 kg/m³ and is often found underneath the snow that accumulates at the head of a glacier."@en ;
    rdfs:subClassOf somaw:IceCrystal .

somaw:GranularIce a owl:Class ;
    rdfs:label "granular ice"@en ;
    rdfs:subClassOf somaw:Ice .

somaw:GrayWater a owl:Class ;
    rdfs:label "gray water"@en ;
    rdfs:subClassOf somaw:WaterMixture .

somaw:HoarCrystal a owl:Class ;
    rdfs:label "hoar crystal"@en ;
    rdfs:subClassOf somaw:IceCrystal .

somaw:Hydrate a owl:Class ;
    rdfs:label "hydrate"@en ;
    rdfs:subClassOf somaw:WaterSubstance .

somaw:RainDrop a owl:Class ;
    rdfs:label "rain drop"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropsdis:SizeRange_micron ] ;
            owl:onProperty sorelsp:diameter ],
        somaw:Drop .

somaw:Rainwater a owl:Class ;
    rdfs:label "rainwater"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Rainfall ;
            owl:onProperty sorelpr:hasSource ],
        somaw:LiquidWater .

somaw:Rime a owl:Class ;
    rdfs:label "rime"@en ;
    rdfs:comment "A white or milky and opaque granular deposit of ice formed by the rapid freezing of supercooled water drops as they impinge upon an exposed object."@en ;
    rdfs:subClassOf somaw:Ice .

somaw:SeaWater a owl:Class ;
    rdfs:label "sea water"@en ;
    rdfs:subClassOf somaw:SaltWater .

somaw:Sewage a owl:Class ;
    rdfs:label "sewage"@en ;
    rdfs:subClassOf somaw:Effluent .

somaw:SnowFacies a owl:Class ;
    rdfs:label "snow facies"@en ;
    rdfs:subClassOf somaw:IceCrystal .

somaw:SnowGrain a owl:Class ;
    rdfs:label "snow grain"@en ;
    rdfs:subClassOf somaw:Snow .

somaw:Wastewater a owl:Class ;
    rdfs:label "wastewater"@en ;
    rdfs:subClassOf somaw:Effluent .

soph:AirSeaExchange a owl:Class ;
    rdfs:label "air sea exchange"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasSource ;
            owl:someValuesFrom sorea:Atmosphere ],
        [ a owl:Restriction ;
            owl:onProperty sorelsc:hasSource ;
            owl:someValuesFrom sorea:Ocean ],
        soph:Phenomena,
        sophsy:Exchange ;
    owl:equivalentClass soph:AtmosphereOceanExchange .

soph:BrownianMotion a owl:Class ;
    rdfs:label "brownian motion"@en ;
    rdfs:comment "A stochastic process that describes (among other things) the rapid and chaotic motion of particles suspended in a fluid at rest as a consequence of fluctuations in the rate at which fluid molecules collide with the particles."@en ;
    rdfs:subClassOf soph:StochasticProcess .

soph:Flash a owl:Class ;
    rdfs:label "flash"@en ;
    rdfs:subClassOf soph:Phenomena .

soph:RadiationalHeating a owl:Class ;
    rdfs:label "radiational heating"@en ;
    owl:equivalentClass soph:RadiativeHeating .

soph:Teleconnection a owl:Class ;
    rdfs:label "teleconnection"@en ;
    rdfs:subClassOf soph:PlanetaryPhenomena .

sophatmo:AirMass a owl:Class ;
    rdfs:label "air mass"@en ;
    rdfs:comment "A widespread body of air, the properties of which can be identified as 1) having been established while that air was situated over a particular region of the earth's surface (airmass source region), and 2) undergoing specific modifications while in transit away from the source region."@en ;
    rdfs:subClassOf soma:Air,
        sorepsmo:Model .

sophatmo:EasterlyWave a owl:Class ;
    rdfs:label "easterly wave"@en ;
    rdfs:comment "A migratory wavelike disturbance of the tropical easterlies."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmow:EasterlyWind ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmo:AtmosphericWave .

sophatmo:FoehnWave a owl:Class ;
    rdfs:label "foehn wave"@en ;
    rdfs:comment "Mountain waves, lee waves, or trapped lee waves in the air stream flowing over the mountain barrier that occur in association with foehn conditions. The Moazagotl is one example of a foehn wave made visible by lee-wave clouds."@en ;
    rdfs:subClassOf sophatmo:MountainWave .

sophatmo:FrontalWave a owl:Class ;
    rdfs:label "frontal wave"@en ;
    rdfs:comment "A horizontal wavelike deformation of a front in the lower levels, commonly associated with a maximum of cyclonic circulation in the adjacent flow. It may develop into a wave cyclone."@en ;
    rdfs:subClassOf sophatmo:AtmosphericWave .

sophatmo:GroundInversion a owl:Class ;
    rdfs:label "ground inversion"@en ;
    rdfs:comment "An air layer with its base at the ground surface and in which temperature increases with height. These often form at night over land under clear skies and are statically stable. See inversion, lapse rate."@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmo:Icing a owl:Class ;
    rdfs:label "icing"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmo:KillingFreeze a owl:Class ;
    rdfs:label "killing freeze"@en ;
    rdfs:comment "The occurrence of air temperature below 0 C (32F) that kills annual vegetation without formation of frost crystals on surfaces. See freeze, dry freeze, hard freeze, light freeze."@en ;
    rdfs:subClassOf somaw:Frost .

sophatmo:LeeWave a owl:Class ;
    rdfs:label "lee wave"@en ;
    rdfs:comment "1. Any wave disturbance that is caused by, and is therefore stationary with respect to, some barrier in the fluid flow. Whether the wave is a gravity wave, inertia wave, barotropic wave, etc., will depend on the structure of the fluid and the dimensions of the barrier. 2. A mountain wave occurring to the lee of a mountain or mountain barrier. These waves can become visible in the form of lenticular or trapped lee-wave clouds."@en ;
    rdfs:subClassOf sophatmo:MountainWave .

sophatmo:LightFreeze a owl:Class ;
    rdfs:label "light freeze"@en ;
    rdfs:comment "The occurrence of air temperature below 0 C (32F) that kills some, but not all, annual vegetation. This often occurs in the 0 to -1 C (32 30 F) range."@en ;
    rdfs:subClassOf somaw:Frost .

sophatmo:LightFrost a owl:Class ;
    rdfs:label "light frost"@en ;
    rdfs:comment "A thin and more or less patchy deposit of hoarfrost on surface objects and vegetation."@en ;
    rdfs:subClassOf somaw:Frost .

sophatmo:MesoscaleDisturbance a owl:Class ;
    rdfs:label "mesoscale disturbance"@en ;
    rdfs:comment "A disturbance where the atmospheric feature has a Rossby number of order 1 and exhibits a horizontal scale comparable to the Rossby radius of deformation. For such systems, both ageostrophic advection and rotational influences are important."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophatmo:AtmosphericDisturbance .

sophatmo:MixedLayerCappingInversion a owl:Class ;
    rdfs:label "mixed layer capping inversion"@en ;
    rdfs:comment "The statically stable layer of air at the top of the atmospheric boundary layer. Because the troposphere is statically stable on the average (i.e., potential temperature increases with height), and because turbulence in the boundary layer causes potential temperatures to become somewhat well mixed there, conservation of heat requires that there be a potential temperature increase (i.e., a temperature step or inversion) at the top of the boundary layer. It is this inversion that separates the boundary layer from the rest of the troposphere by limiting the domain of turbulence. It is also responsible for trapping pollutants near the ground during fair weather."@en ;
    rdfs:subClassOf sophatmo:CappingInversion .

sophatmo:MixedLayerEvolution a owl:Class ;
    rdfs:label "mixed layer evolution"@en ;
    rdfs:comment "The three-part change of the atmospheric boundary layer that typically occurs during fair weather over land on sunny days. In the early morning, the mixed layer is shallow, slowly deepening, cool (in a potential temperature sense), and is capped by the remains of the stable boundary layer from the previous night. In mid- to late morning, the top of the mixed layer exhibits rapid rise as heating eliminates the nocturnal inversion, and the mixed layer grows through the residual layer. The third stage in late morning and afternoon is that of a deep (order of 1?2 km) convective boundary layer of relatively constant depth."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaabl:MixedLayer ;
            owl:onProperty sorel:hasRealm ],
        sophsyc:Evolution .

sophatmo:MoisturePooling a owl:Class ;
    rdfs:label "moisture pooling"@en ;
    rdfs:comment "The development of an area in the boundary layer (e.g., often observed on surface or 850-mb charts) where moisture values become higher than in the surrounding region. Moisture pooling typically occurs in an area of low-level convergence during the warm (growing) season, and can have a significant effect on convection initiation and evolution."@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmo:OrographicLifting a owl:Class ;
    rdfs:label "orographic lifting"@en ;
    rdfs:comment "Ascending air flow caused by mountains.  Mechanisms that produce the lifting fall into two broad categories: 1) the upward deflection of horizontal larger-scale flow by the orography acting as an obstacle or barrier; or 2) the daytime heating of mountain surfaces to produce anabatic flow along the slopes and updrafts in the vicinity of the peaks."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sorealo:Orographic ],
        sophfi:Lifting .

sophatmo:Rainbow a owl:Class ;
    rdfs:label "rainbow"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmo:Sunlight a owl:Class ;
    rdfs:label "sunlight"@en ;
    rdfs:comment " Sunlight, in the broad sense, is the total spectrum of the electromagnetic radiation given off by the Sun. On Earth, sunlight is filtered through the atmosphere, and the solar radiation is obvious as daylight when the Sun is above the horizon. This is usually during the hours known as day. Near the poles in summer, sunlight also occurs during the hours known as night and in the winter at the poles sunlight may not occur at any time. When the direct radiation is not blocked by clouds, it is experienced as sunshine, a combination of bright light and heat. Radiant heat directly produced by the radiation of the sun is different from the increase in atmospheric temperature due to the radiative heating of the atmosphere by the sun's radiation."@en ;
    rdfs:subClassOf soph:RadiativeHeating .

sophatmo:Sunlit a owl:Class ;
    rdfs:label "sunlit"@en ;
    rdfs:subClassOf sophatmo:WeatherCondition .

sophatmo:Thermal a owl:Class ;
    rdfs:label "thermal"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmo:Whiteout a owl:Class ;
    rdfs:label "whiteout"@en ;
    rdfs:comment "An atmospheric optical phenomenon in which the observer appears to be engulfed in a uniformly white glow."@en ;
    rdfs:subClassOf sophatmo:Obscuration .

sophatmoc:Altostratus a owl:Class ;
    rdfs:label "altostratus"@en ;
    rdfs:comment "A principal cloud type (cloud genus) in the form of a gray or bluish (never white) sheet or layer of striated, fibrous, or uniform appearance."@en ;
    rdfs:subClassOf sophatmoc:Stratiform .

sophatmoc:BannerCloud a owl:Class ;
    rdfs:label "banner cloud"@en ;
    rdfs:comment "A cloud plume often observed to extend downwind from isolated, sharp, often pyramid-shaped mountain peaks, even on otherwise cloud-free days."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:BaroclinicLeaf a owl:Class ;
    rdfs:label "baroclinic leaf"@en ;
    rdfs:comment "A synoptic-scale cloud pattern frequently observed in satellite imagery just prior to the onset of cyclogenesis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmops:Cyclogenesis ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmoc:Cloud .

sophatmoc:BillowCloud a owl:Class ;
    rdfs:label "billow cloud"@en ;
    rdfs:comment "A cloud variety composed of merged or separate elements that are elongated and parallel, either suggestive of ocean waves or arranged in ranks and files."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:BlackShearedAnvil a owl:Class ;
    rdfs:label "black sheared anvil"@en ;
    rdfs:comment "Colloquial expression for a cumulonimbus anvil that spreads upwind into relatively strong winds aloft."@en ;
    rdfs:subClassOf sophatmoc:Cumulonimbus .

sophatmoc:Cirrostratus a owl:Class ;
    rdfs:label "cirrostratus"@en ;
    rdfs:subClassOf sophatmoc:Stratiform .

sophatmoc:Cirrus a owl:Class ;
    rdfs:label "cirrus"@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:FlankingLine a owl:Class ;
    rdfs:label "flanking line"@en ;
    rdfs:comment "An organized lifting zone of cumulus and towering cumulus clouds, connected to and extending outward from the mature updraft tower of a supercell or strong multicell convective storm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmoc:Cumulonimbus ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophatmoc:Cumulus ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmo:MeteorologicalPhenomena .

sophatmoc:FoehnCloud a owl:Class ;
    rdfs:label "foehn cloud"@en ;
    rdfs:comment "Any cloudform associated with the foehn, usually referring to standing clouds of two types, orographic clouds and mountain wave clouds. Orographic clouds may include crest clouds and the foehn wall. Wave clouds may consist of lenticular (including altocumulus standing lenticular, or ACSL) clouds, lee-wave clouds and cloud bands, and rotors. See also Bishop wave, chinook arch, contessa di vento, Moazagotl."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmowm:Foehn ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmoc:Cloud ;
    owl:equivalentClass sophatmoc:FoehnWall,
        sophatmoc:Moazagotl .

sophatmoc:ForcedCloud a owl:Class ;
    rdfs:label "forced cloud"@en ;
    rdfs:comment "Small cumulus clouds that are everywhere negatively buoyant compared to the surrounding environment, but that exist because the inertia of the rising thermals feeding them from underneath is sufficient to penetrate the lifting condensation level (LCL). Morphologically, these are often cumulus humilis clouds and are typically found at the top of the convective boundary layer during daytime over land, when a strong temperature inversion aloft prevents the clouds from growing deeper. Compare active cloud, passive cloud."@en ;
    rdfs:subClassOf sophatmoc:Cumulus .

sophatmoc:FunnelCloud a owl:Class ;
    rdfs:label "funnel cloud"@en ;
    rdfs:comment "A condensation cloud, typically funnel-shaped and extending outward from a cumuliform cloud, associated with a rotating column of air (a vortex) that may or may not be in contact with the ground. If the rotation is violent and in contact with the ground, the vortex is a tornado. Funnel clouds can occur through a variety of processes in association with convection. For example, small funnel clouds are infrequently seen extending from small, dissipating cumulus clouds in environments with significant vertical wind shear in the cloud-bearing layer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Rotation ;
            owl:onProperty sorel:hasProcess ],
        sophatmoc:Cloud .

sophatmoc:KelvinHelmholtzBillows a owl:Class ;
    rdfs:label "kelvin helmholtz billows"@en ;
    rdfs:comment "1. Cloud forms that arise from Kelvin?Helmholtz waves. 2. Vortical structures that result from the growth and nonlinear development of unstable waves in a shear flow. The billows get their name from the instability responsible for the growth of the unstable waves, Kelvin?Helmholtz instability."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfi:KelvinHelmholtzInstability ;
            owl:onProperty sorel:hasState ],
        sophatmoc:Cloud .

sophatmoc:LaSerpe a owl:Class ;
    rdfs:label "la serpe"@en ;
    rdfs:comment "A long strip of cloud that sometimes lies against the southern base of Mount Etna in Sicily.  It is said to herald rain."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:LayerCloud a owl:Class ;
    rdfs:label "layer cloud"@en ;
    rdfs:comment "Stratus cloud; a continuous cloud sheet capped by an inversion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmo:CappingInversion ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmoc:Cloud .

sophatmoc:Mamma a owl:Class ;
    rdfs:label "mamma"@en ;
    rdfs:comment "(Also called mammatus.) Hanging protuberances, like pouches, on the undersurface of a cloud. This supplementary cloud feature occurs mostly with cirrus, cirrocumulus, altocumulus, altostratus, stratocumulus, and cumulonimbus; in the case of cumulonimbus, mamma generally appear on the underside of the anvil (incus). See cloud classification."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:MaritimeCloud a owl:Class ;
    rdfs:label "maritime cloud"@en ;
    rdfs:comment "A cloud forming in maritime air containing relatively low concentrations of cloud condensation nuclei. These clouds are characterized by a broader droplet size distribution and low droplet concentrations (some 100 cm-3). See continental cloud."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:MixedCloud a owl:Class ;
    rdfs:label "mixed cloud"@en ;
    rdfs:comment "A cloud containing both water drops (supercooled at temperatures below 0?C) and ice crystals, hence a cloud with a composition between that of a water cloud and that of an ice- crystal cloud."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:MixingCloud a owl:Class ;
    rdfs:label "mixing cloud"@en ;
    rdfs:comment "A cloud formed when two subsaturated volumes of moist air with different temperatures and vapor pressures mix isobarically and adiabatically to form a volume of moist air with an intermediate temperature and vapor pressure above the saturation value at that temperature."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophm:Mixing ],
        sophatmoc:Cloud .

sophatmoc:MountainWaveCloud a owl:Class ;
    rdfs:label "mountain wave cloud"@en ;
    rdfs:comment "A cloud that forms in the rising branches of mountain waves and occupies the crests of the waves. The most distinctive are the sharp-edged, lens-, or almond-shaped lenticular clouds, but a variety of stratocumulus, altocumulus, and cirrocumulus forms appear in both the main, vertically propagating waves and in the lee waves. See mountain wave, foehn cloud."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmo:MountainWave ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmoc:Cloud .

sophatmoc:Nacreous a owl:Class ;
    rdfs:label "nacreous"@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:Nimbostratus a owl:Class ;
    rdfs:label "nimbostratus"@en ;
    rdfs:comment "A principal cloud type (cloud genus), gray colored and often dark, rendered diffuse by more or less continuously falling rain, snow, sleet, etc., of the ordinary varieties and not accompanied by lightning, thunder, or hail."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:NoctilueentCloud a owl:Class ;
    rdfs:label "noctilueent cloud"@en ;
    dcterms:contributor <https://orcid.org/0000-0002-0337-8610> ;
    rdfs:seeAlso sophatmoc:NoctilucentCloud ;
    owl:deprecated true .

sophatmoc:OrographicCloud a owl:Class ;
    rdfs:label "orographic cloud"@en ;
    rdfs:comment "Mountain clouds produced by orographic lifting of moist air to saturation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealo:Orographic ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmoc:Cloud .

sophatmoc:OvershootingTop a owl:Class ;
    rdfs:label "overshooting top"@en ;
    rdfs:comment "A domelike protrusion above a cumulonimbus anvil, representing the intrusion of an updraft through its equilibrium level."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmoc:AnvilCloud ;
            owl:onProperty sorelsp:upperPartOf ],
        sophatmoc:Cloud .

sophatmoc:PassiveCloud a owl:Class ;
    rdfs:label "passive cloud"@en ;
    rdfs:comment "A cumulus cloud that is no longer dynamically connected with the atmospheric boundary layer via updrafts or downdrafts."@en ;
    rdfs:subClassOf sophatmoc:Cumulus .

sophatmoc:RollCloud a owl:Class ;
    rdfs:label "roll cloud"@en ;
    rdfs:comment "A low-level, horizontal, tube-shaped arcus cloud associated with a gust front of a convective storm or occasionally a cold front."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:SelfCloud a owl:Class ;
    rdfs:label "self cloud"@en ;
    rdfs:comment "A low-level, horizontal, wedge-shaped arcus cloud associated with a convective storm's gust front."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:Stratocumulus a owl:Class ;
    rdfs:label "stratocumulus"@en ;
    rdfs:subClassOf sophatmoc:Stratiform .

sophatmoc:Stratus a owl:Class ;
    rdfs:label "stratus"@en ;
    rdfs:subClassOf sophatmoc:Stratiform .

sophatmoc:Towering a owl:Class ;
    rdfs:label "towering"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmoc:WallCloud a owl:Class ;
    rdfs:label "wall cloud"@en ;
    rdfs:comment "A local, often abrupt lowering from a cumulonimbus cloud base into a low-hanging accessory cloud, normally a kilometer or more in diameter."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmofo:AdvectionFog a owl:Class ;
    rdfs:label "advection fog"@en ;
    rdfs:comment "A type of fog caused by the advection of moist air over a cold surface, and the consequent cooling of that air to below its dewpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophft:Advection ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofo:Fog .

sophatmofo:BrownCloud a owl:Class ;
    rdfs:label "brown cloud"@en ;
    rdfs:comment "Phenomenon particularly associated with smog episodes in cities such as Denver, Colorado."@en ;
    rdfs:subClassOf sophatmofo:Smog .

sophatmofo:ColdFront rdfs:comment "Any nonoccluded front, or portion thereof, that moves so that the colder air replaces the warmer air; that is, the leading edge of a relatively cold air mass."@en .

sophatmofo:Dryline rdfs:comment "A low-level mesoscale boundary or transition zone hundreds of kilometers in length and up to tens of kilometers in width separating dry air from moist air."@en .

sophatmofo:EvaporationFog a owl:Class ;
    rdfs:label "evaporation fog"@en ;
    rdfs:comment "Fog formed as a result of evaporation of water that is warmer than the air."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Evaporation ;
            owl:onProperty sorelph:hasStateChange ],
        sophatmofo:Fog .

sophatmofo:FalseWarmSector rdfs:comment "The sector, in a horizontal plane, between the occluded front and a secondary cold-front of an occluded cyclone."@en .

sophatmofo:FreezingFog a owl:Class ;
    rdfs:label "freezing fog"@en ;
    rdfs:comment "A fog the droplets of which freeze upon contact with exposed objects and form a coating of rime and/or glaze."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Freezing ;
            owl:onProperty sorelph:hasStateChange ],
        sophatmofo:Fog .

sophatmofo:Front rdfs:comment "In meteorology, generally, the interface or transition zone between two air masses of different density"@en .

sophatmofo:FrontalFog a owl:Class ;
    rdfs:label "frontal fog"@en ;
    rdfs:comment "Fog associated with frontal zones and frontal passages. It is usually divided into three types: warm-front prefrontal fog; cold-front post-frontal fog; and frontal-passage fog. The first two types are a result of rain falling into cold stable air and raising the dewpoint temperature. Frontal-passage fog can result from the ?mixing of warm and cold air masses in the frontal zone? or by ?sudden cooling of air over moist ground.?"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmofr:Front ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofo:Fog .

sophatmofo:FrontalLifting rdfs:comment "The forced ascent of the warmer, less dense air at and near a front, occurring whenever the relative velocities of the two air masses are such that they converge at the front."@en .

sophatmofo:Garua a owl:Class ;
    rdfs:label "garua"@en ;
    rdfs:comment "A dense fog and/or drizzle from low stratus on the west coast of South America. It creates a raw, cold atmosphere that may last for weeks in winter and supplies a limited amount of moisture to the area."@en ;
    rdfs:subClassOf sophatmofo:Fog .

sophatmofo:GroundFog a owl:Class ;
    rdfs:label "ground fog"@en ;
    rdfs:comment "1. According to U.S. weather observing practice, a fog that hides less than 0.6 of the sky and does not extend to the base of any clouds that may lie above it. As an obstruction to vision in an aviation weather observation, ground fog is encoded GF. 2. See radiation fog."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:near ],
        sophatmofo:Fog .

sophatmofo:Haar a owl:Class ;
    rdfs:label "haar"@en ;
    rdfs:comment "A name applied to a wet sea fog or very fine drizzle that drifts in from the sea in coastal districts of eastern Scotland and northeastern England. It occurs most frequently in summer."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealc:Coastal ;
            owl:onProperty sorel:hasRealm ],
        sophatmofo:Fog .

sophatmofo:HighFog a owl:Class ;
    rdfs:label "high fog"@en ;
    rdfs:comment "In the US, the frequent fog on the slopes of the coastal mountains of California, especially applied when the fog overtops the range and extends as stratus over the leeward valleys."@en ;
    rdfs:subClassOf sophatmofo:MountainFog .

sophatmofo:IceFog a owl:Class ;
    rdfs:label "ice fog"@en ;
    rdfs:comment "A type of fog, composed of suspended particles of ice, partly ice crystals 20 to 100 m in diameter, but chiefly, especially when dense, droxtals 12?20 m in diameter. It occurs at very low temperatures, and usually in clear, calm weather in high latitudes. The sun is usually visible and may cause halo phenomena. Ice fog is rare at temperatures warmer than -30?C, and increases in frequency with decreasing temperature until it is almost always present at air temperatures of -45?C in the vicinity of a source of water vapor. Such sources are the open water of fast-flowing streams or of the sea, herds of animals, volcanoes, and especially products of combustion for heating or propulsion. At temperatures warmer than -30?C, these sources can cause steam fog of liquid water droplets, which may turn into ice fog when cooled (see frost smoke). See ice-crystal haze, arctic mist."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:Ice ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmofo:Fog .

sophatmofo:KataFront rdfs:comment "A front (usually a cold front) at which the warm air descends the frontal surface (except, presumably, in the lowest layers)."@en .

sophatmofo:KatabaticFront rdfs:comment "Frontal surface above which air is descending."@en .

sophatmofo:MediterraneanFront rdfs:comment "A front that forms in the low pressure zone that covers the Mediterranean between the cold air over Europe and the warm air over the Sahara."@en .

sophatmofo:MeiyuFront rdfs:comment "(Also called baiu front). A quasi-persistent, nearly stationary, east?west-oriented weak baroclinic zone in the lower troposphere that typically stretches from the east China coast, across Taiwan, and eastward into the Pacific, south of Japan. The term ?mei-yu? is the Chinese expression for ?plum rains.? The mei-yu front generally occurs from mid- to late spring through early to midsummer. This low-level baroclinic zone typically lies beneath a confluent jet entrance region aloft situated downstream of the Tibetan Plateau. The mei-yu/baiu front is very significant in the weather and climate of southeast Asia as it serves as the focus for persistent heavy convective rainfall associated with mesoscale convective complexes (MCCs) or mesoscale convective systems (MCSs) that propagate eastward along the baroclinic zone. The moisture source is typically the South China Sea and sometimes the Bay of Bengal. The usual lifting mechanism is low-level warm-air advection in association with a low-level jet on the equatorward flank of the baroclinic zone. Deep ascent and resulting organized MCCs/MCSs are especially favored when the low-level warm-air advection is situated beneath the favorable equatorward jet entrance region aloft."@en .

sophatmofo:Microfront rdfs:comment "A sharp horizontal temperature contrast of a few degrees Celsius within a width of tens of centimeters to a few meters along the trailing edge of a thermal plume in the surface layer of the atmospheric boundary layer."@en .

sophatmofo:MixingFog a owl:Class ;
    rdfs:label "mixing fog"@en ;
    rdfs:comment "Fog, light and of short duration, produced by the mixing of two moist but nonsaturated air masses with different temperatures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophm:Mixing ],
        sophatmofo:Fog .

sophatmofo:MoistTongue rdfs:comment "An extension or protrusion of moist air into a region of lower moisture content. Cloudiness and precipitation are closely related to moist tongues."@en .

sophatmofo:MonsoonFog a owl:Class ;
    rdfs:label "monsoon fog"@en ;
    rdfs:comment "An advection fog produced as a monsoon circulation that transports warm moist air over a colder surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Monsoon ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophft:Advection ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofo:Fog .

sophatmofo:OccludedFront rdfs:comment "A front that forms as a cyclone moves deeper into colder air."@en .

sophatmofo:OutflowBoundary rdfs:comment "A surface boundary formed by the horizontal spreading of thunderstorm-cooled air."@en .

sophatmofo:RadiationFog a owl:Class ;
    rdfs:label "radiation fog"@en ;
    rdfs:comment "A common type of fog, produced over a land area when radiational cooling reduces the air temperature to or below its dewpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soph:RadiationalCooling ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorea:Land ;
            owl:onProperty sorel:hasRealm ],
        sophatmofo:Fog .

sophatmofo:SaltHaze a owl:Class ;
    rdfs:label "salt haze"@en ;
    rdfs:comment "A haze created by the presence of finely divided particles of sea salt in the air, usually derived from the evaporation of sea spray."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:Salt ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmofo:Haze .

sophatmofo:SandHaze a owl:Class ;
    rdfs:label "sand haze"@en ;
    rdfs:comment "Reduced visibility in the atmospheric boundary layer caused by suspended particles of soil, mixed into the air during strong winds."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelch:hasSubstance ;
            owl:someValuesFrom somas:Sand ],
        sophatmofo:Haze .

sophatmofo:SeaBreezeFront rdfs:comment "The horizontal discontinuity in temperature and humidity that marks the leading edge of the intrusion of cooler, more moist marine air associated with a sea breeze."@en .

sophatmofo:Seclusion rdfs:comment "A special (and rare) case of the process of occlusion, where the point at which the cold front first overtakes the warm front (or quasi-stationary front) is at some distance from the apex of the wave cyclone."@en .

sophatmofo:TriplePoint rdfs:comment "A junction point within the tropics of three distinct air masses, considered to be an ideal point of origin for a tropical cyclone."@en .

sophatmofo:UpslopeFog a owl:Class ;
    rdfs:label "upslope fog"@en ;
    rdfs:comment "A type of fog formed when air flows upward over rising terrain and is, consequently, adiabatically cooled to or below its dewpoint."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmowm:UpslopeWind ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofo:Fog .

sophatmofo:WarmSector rdfs:comment "That area, within the circulation of a wave cyclone, where the warm air is found.  Traditionally, it lies between the cold front and warm front of the storm; in the typical case, the warm sector continually diminishes in size and ultimately disappears (at the surface) as the result of occlusion."@en .

sophatmofr:ColdFront a owl:Class ;
    rdfs:label "cold front"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Cooling ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofr:Front ;
    owl:disjointWith sophatmofr:WarmFront .

sophatmofr:Damming a owl:Class ;
    rdfs:label "damming"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealo:Orography ;
            owl:onProperty sorel:hasRealm ],
        sophatmofr:Front .

sophatmofr:Dryline a owl:Class ;
    rdfs:label "dryline"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:FalseWarmSector a owl:Class ;
    rdfs:label "false warm sector"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmofr:FrontalLifting a owl:Class ;
    rdfs:label "frontal lifting"@en ;
    rdfs:subClassOf sophfi:Lifting .

sophatmofr:KataFront a owl:Class ;
    rdfs:label "kata front"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:KatabaticFront a owl:Class ;
    rdfs:label "katabatic front"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:MediterraneanFront a owl:Class ;
    rdfs:label "mediterranean front"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:MeiyuFront a owl:Class ;
    rdfs:label "meiyu front"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:Microfront a owl:Class ;
    rdfs:label "microfront"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:MoistTongue a owl:Class ;
    rdfs:label "moist tongue"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmofr:OccludedFront a owl:Class ;
    rdfs:label "occluded front"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:OutflowBoundary a owl:Class ;
    rdfs:label "outflow boundary"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:SeaBreezeFront a owl:Class ;
    rdfs:label "sea breeze front"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmowm:SeaBreeze ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofr:Front .

sophatmofr:Seclusion a owl:Class ;
    rdfs:label "seclusion"@en ;
    rdfs:subClassOf sophatmofr:Front .

sophatmofr:TransitionZone a owl:Class ;
    rdfs:label "transition zone"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmofr:TriplePoint a owl:Class ;
    rdfs:label "triple point"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmofr:WarmSector a owl:Class ;
    rdfs:label "warm sector"@en ;
    rdfs:subClassOf sophatmofr:FrontRegion .

sophatmol:BallLightning a owl:Class ;
    rdfs:label "ball lightning"@en ;
    rdfs:comment "A rare and randomly occurring bright ball of light observed floating or moving through the atmosphere close to the ground."@en ;
    rdfs:subClassOf sophatmol:Lightning .

sophatmol:BeadedLightning a owl:Class ;
    rdfs:label "beaded lightning"@en ;
    rdfs:comment "A particular aspect of a normal lightning flash occasionally seen when the observer happens to view end-on a number of segments of the irregular channel (zigzag lightning) and hence receives an impression of higher luminosity at a series of locations along the channel."@en ;
    rdfs:subClassOf sophatmol:Lightning .

sophatmol:BlueJet a owl:Class ;
    rdfs:label "blue jet"@en ;
    rdfs:comment "Weakly luminous upward propagating discharges, blue in color, emanating from the tops of thunderstorms."@en ;
    rdfs:subClassOf sophatmol:Lightning .

sophatmol:JunctionStreamer a owl:Class ;
    rdfs:label "junction streamer"@en ;
    rdfs:comment "The process by which negative charge centers at successively more distant locations in a thundercloud are tapped for discharge by successive strokes of cloud-to-ground lightning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmol:Lightning ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Thunderstorm ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmol:Lightning .

sophatmol:ReturnStroke a owl:Class ;
    rdfs:label "return stroke"@en ;
    rdfs:comment "The intense luminosity that propagates upward from earth to cloud base in the last phase of each lightning stroke of a cloud-to-ground discharge."@en ;
    rdfs:subClassOf sophatmol:Lightning .

sophatmopc:Blizzard a owl:Class ;
    rdfs:label "blizzard"@en ;
    rdfs:subClassOf sophatmopc:Snowfall .

sophatmopc:CloudBurst a owl:Class ;
    rdfs:label "cloud burst"@en ;
    rdfs:comment "In popular terminology, any sudden and heavy fall of rain, almost always of the shower type."@en ;
    rdfs:subClassOf sophatmopc:HeavyRainfall .

sophatmopc:Drizzle a owl:Class ;
    rdfs:label "drizzle"@en ;
    rdfs:comment "Very small, numerous, and uniformly distributed water drops that may appear to float while following air currents."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Light ;
            owl:onProperty sorelsc:hasImpact ],
        sophatmopc:Rainfall .

sophatmopc:Ecnephias a owl:Class ;
    rdfs:label "ecnephias"@en ;
    rdfs:comment "A squall or thunderstorm in the Mediterranean."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmopc:FamilyOfTornadoes a owl:Class ;
    rdfs:label "family of tornadoes"@en ;
    rdfs:comment "A sequence of long-lived tornadoes produced by a cyclic supercell storm. Tornadoes touch down at quasi-regular intervals (typically 45 min). Usually a new tornado develops in a new mesocyclone just after an old tornado has decayed in an old, occluded neighboring mesocyclone. Sometimes, two successive tornadoes may overlap in time for a few minutes. The two mesocyclones may rotate partially around each other. If the damage tracks of the tornadoes appear to form a wavy broken line, the family is classified as a series mode. In the more common parallel-mode family, the damage tracks are parallel arcs with each new tornado forming on the right side of its predecessor. The parallel mode is subcategorized into left turn and right turn, according to the direction in which the paths curve."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Tornado ;
            owl:onProperty sorelsp:clusterOf ],
        sorepsg:Cluster .

sophatmopc:FreezingRain a owl:Class ;
    rdfs:label "freezing rain"@en ;
    rdfs:comment "Rain that falls in liquid form but freezes upon impact to form a coating of glaze upon the ground and on exposed objects."@en ;
    rdfs:subClassOf sophatmopc:AtmosphericPrecipitation .

sophatmopc:GoslingBlast a owl:Class ;
    rdfs:label "gosling blast"@en ;
    rdfs:comment "A sudden squall of rain or sleet in England."@en ;
    rdfs:subClassOf sophatmopc:AtmosphericPrecipitation .

sophatmopc:GowkStorm a owl:Class ;
    rdfs:label "gowk storm"@en ;
    rdfs:comment "Any disturbed state of the atmosphere, especially as affecting the earth's surface, implying inclement and possibly destructive weather."@en ;
    rdfs:subClassOf sophatmopc:Storm .

sophatmopc:Graupel a owl:Class ;
    rdfs:label "graupel"@en ;
    rdfs:subClassOf somaw:Ice .

sophatmopc:GreenThunderstorm a owl:Class ;
    rdfs:label "green thunderstorm"@en ;
    rdfs:comment "Any thunderstorm that is perceived by observers to be green. The perceptually dominant wavelength of light from green thunderstorms ranges from blue- green to yellow-green. The purity of the color is generally low and the topical mechanism that causes the green appearance is not understood. Although green clouds often occur in conjunction with severe weather, there is no evidence to support anecdotal attributions of the cause of this green to specific characteristics of severe storms, such as hail or tornadoes."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmopc:HailStorm a owl:Class ;
    rdfs:label "hail storm"@en ;
    rdfs:comment "Any storm that produces hailstones that fall to the ground; usually used when the amount or size of the hail is considered significant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Hail ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmopc:Storm .

sophatmopc:HeatThunderstorm a owl:Class ;
    rdfs:label "heat thunderstorm"@en ;
    rdfs:comment "In popular terminology, a thunderstorm of the air mass type that develops near the end of a hot, humid summer day; this term has no precise technical meaning."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmopc:HighLevelThunderstorm a owl:Class ;
    rdfs:label "high level thunderstorm"@en ;
    rdfs:comment "Generally, a thunderstorm based at a comparatively high altitude in the atmosphere, roughly 2400 m or higher. These storms form most strikingly over arid regions, and frequently their precipitation is evaporated before reaching the earth's surface."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmopc:HurricaneBand a owl:Class ;
    rdfs:label "hurricane band"@en ;
    rdfs:comment "A hurricane radar band of circular or spiral shape associated with a tropical cyclone (hurricane or typhoon). Made evident by radar observations, hurricane bands typically curve cyclonically inward toward the center of the storm. The bands may be classified as primary if they merge into the eyewall encircling the eye of the storm, or secondary if they are disconnected from the eyewall. Hurricane bands generally move slowly around the center of the storm in the direction of the hurricane circulation. See banded structure."@en ;
    rdfs:subClassOf sophatmopc:Hurricane .

sophatmopc:IcePellet a owl:Class ;
    rdfs:label "ice pellet"@en ;
    owl:equivalentClass sophatmopc:Sleet .

sophatmopc:IceStorm a owl:Class ;
    rdfs:label "ice storm"@en ;
    rdfs:comment "A storm characterized by a fall of freezing liquid precipitation. The attendant formation of glaze on terrestrial objects creates many hazards."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:Ice ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmopc:Storm .

sophatmopc:Kaavie a owl:Class ;
    rdfs:label "kaavie"@en ;
    rdfs:comment "In Scotland, a heavy fall of snow."@en ;
    rdfs:subClassOf sophatmopc:HeavySnowfall .

sophatmopc:Kelsher a owl:Class ;
    rdfs:label "kelsher"@en ;
    rdfs:comment "In England, a heavy fall of rain."@en ;
    rdfs:subClassOf sophatmopc:HeavyRainfall .

sophatmopc:LakeEffectSnow a owl:Class ;
    rdfs:label "lake effect snow"@en ;
    rdfs:comment "Localized, convective snow bands that occur in the lee of lakes when relatively cold airflows over warm water. In the US this phenomenon is most noted along the south and east shores of the Great Lakes during arctic cold-air outbreaks. Snowstorm occurring near or downwind from the shore of a lake resulting from the warming (destabilization) and moistening of relatively cold air during passage over a warm body of water."@en ;
    rdfs:subClassOf sophatmopc:LakeEffect,
        sophatmopc:Snowfall ;
    owl:equivalentClass sophatmopc:LakeEffectSnowstorm .

sophatmopc:LambingStorm a owl:Class ;
    rdfs:label "lambing storm"@en ;
    rdfs:comment "(Also called lamb-blasts, lamb-showers, lamb storm.) A slight fall of snow in the spring in England."@en ;
    rdfs:subClassOf sophatmopc:Snowfall .

sophatmopc:LandLash a owl:Class ;
    rdfs:label "land lash"@en ;
    rdfs:comment "In England, a heavy fall of rain, accompanied by a high wind."@en ;
    rdfs:subClassOf sophatmopc:Rainfall .

sophatmopc:Landspout a owl:Class ;
    rdfs:label "landspout"@en ;
    rdfs:comment "(Rare.) A tornado. 2. Colloquial expression describing tornadoes occurring with a parent cloud in its growth stage and with its vorticity originating in the boundary layer."@en ;
    rdfs:subClassOf sophatmopc:Tornado .

sophatmopc:LocalStorm a owl:Class ;
    rdfs:label "local storm"@en ;
    rdfs:comment "A storm of mesometeorological scale; thus, thunderstorms, squalls, and tornadoes are often put in this category."@en ;
    rdfs:subClassOf sophatmopc:Storm .

sophatmopc:MesocycloneSignature a owl:Class ;
    rdfs:label "mesocyclone signature"@en ;
    rdfs:comment "The Doppler velocity pattern of a mesocyclone within a severe thunderstorm. In a storm-relative reference frame, the idealized signature is symmetric about the radar viewing direction with marked azimuthal shear across the core region between peak Doppler velocity values of opposite sign. Typical signatures consist of Doppler velocity differences of 25? 75 m s-1 across core diameters of 2?8 km, with resulting azimuthal shear values of 5 ? 10-3 s-1 to 2 ? 10-2 s-1."@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmopc:Mist a owl:Class ;
    rdfs:label "mist"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Light ;
            owl:onProperty sorelsc:hasImpact ],
        sophatmopc:AtmosphericPrecipitation .

sophatmopc:MulticellConvectiveStorm a owl:Class ;
    rdfs:label "multicell convective storm"@en ;
    rdfs:comment "A convective storm system usually composed of a cluster of ordinary convective cells at various stages of their life cycle. New cells within the convective system are generated primarily by either low-level convergence along a preexisting boundary, or by lifting at the leading edge of the system-scale cold pool that was produced by the previous cells. A multicell storm may have a lifetime of several hours, and may also have supercells incorporated as a part of the system as well. See also cell, ordinary cell, supercell, thunderstorm."@en ;
    rdfs:subClassOf sophatmopc:SplittingConvectiveStorm .

sophatmopc:NonSupercellTornado a owl:Class ;
    rdfs:label "non supercell tornado"@en ;
    rdfs:comment "A tornado that occurs with a parent cloud in its growth stage and with its vorticity originating in the boundary layer. The parent cloud does not contain a preexisting midlevel mesocyclone. Landspouts and gustnadoes are examples of the nonsupercell tornado."@en ;
    rdfs:subClassOf sophatmopc:Tornado .

sophatmopc:NortheastStorm a owl:Class ;
    rdfs:label "northeast storm"@en ;
    rdfs:comment "A cyclonic storm off the east coast of North America, so called because the winds over the coastal area are from the northeast."@en ;
    rdfs:subClassOf sophatmopc:Storm .

sophatmopc:PopUpThunderstorm a owl:Class ;
    rdfs:label "pop up thunderstorm"@en ;
    rdfs:comment "An airmass thunderstorm that forms rapidly in an otherwise rain-free environment.   This most often occurs on warm, humid days, in unstable meteorological conditions."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmopc:PrefrontalSquallLine a owl:Class ;
    rdfs:label "prefrontal squall line"@en ;
    rdfs:comment "A squall line less than about 100 km ahead of a cold front, in the warm sector, having an orientation more or less parallel to the cold front."@en ;
    rdfs:subClassOf sophatmopc:SquallLine .

sophatmopc:Rain a owl:Class ;
    rdfs:label "rain"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:LiquidWater ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmopc:AtmosphericPrecipitation ;
    owl:equivalentClass sophatmopc:Rainfall .

sophatmopc:Rainband a owl:Class ;
    rdfs:label "rainband"@en ;
    rdfs:comment "The complete cloud and precipitation structure associated with an area of rainfall sufficiently elongated that an orientation can be assigned."@en ;
    rdfs:subClassOf sophatmopc:Rainfall .

sophatmopc:Shower a owl:Class ;
    rdfs:label "shower"@en ;
    rdfs:subClassOf sophatmopc:Rainfall .

sophatmopc:SupercellConvectiveStorm a owl:Class ;
    rdfs:label "supercell convective storm"@en ;
    rdfs:subClassOf sophatmopc:ConvectiveStorm .

sophatmopc:TropicalStorm a owl:Class ;
    rdfs:label "tropical storm"@en ;
    rdfs:subClassOf sophatmops:TropicalCyclone .

sophatmopc:Typhoon a owl:Class ;
    rdfs:label "typhoon"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        [ a owl:Restriction ;
            owl:hasValue soreaofe:PacificOcean ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:TropicalCyclone .

sophatmopc:WaterSpout a owl:Class ;
    rdfs:label "water spout"@en ;
    rdfs:comment "1. In general, any tornado over a body of water. 2. In its most common form, a nonsupercell tornado over water."@en ;
    rdfs:subClassOf sophatmopc:Tornado .

sophatmops:Barometric a owl:Class ;
    rdfs:label "barometric"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmops:Blocking a owl:Class ;
    rdfs:label "blocking"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfd:Cyclone ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmo:MeteorologicalPhenomena .

sophatmops:BowEcho a owl:Class ;
    rdfs:label "bow echo"@en ;
    rdfs:comment "A bow-shaped line of convective cells that is often associated with swaths of damaging straight-line winds and small tornadoes."@en ;
    rdfs:subClassOf sophfd:CellCluster .

sophatmops:ConvectionCell a owl:Class ;
    rdfs:label "convection cell"@en ;
    rdfs:comment "An organized unit of convection within a convecting layer.  It is isolated by a stream surface, with ascending motion in the center and descending motion near the periphery, or vice versa."@en ;
    rdfs:subClassOf sophfd:CellCluster .

sophatmops:CutOffHigh a owl:Class ;
    rdfs:label "cut off high"@en ;
    rdfs:subClassOf sophatmops:AtmosphericHighPressure .

sophatmops:CutOffLow a owl:Class ;
    rdfs:label "cut off low"@en ;
    rdfs:comment "A cold low that has grown out of a trough and become displaced out of the basic westerly current and lies equatorward of this current."@en ;
    rdfs:subClassOf sophatmops:AtmosphericLowPressure .

sophatmops:DeepConvection a owl:Class ;
    rdfs:label "deep convection"@en ;
    rdfs:subClassOf sophft:Convection .

sophatmops:Deepening a owl:Class ;
    rdfs:label "deepening"@en ;
    rdfs:comment "A decrease in the central pressure of a pressure system as depicted on a constant- height chart, or an analogous decrease in height on a constant-pressure chart; the opposite of filling."@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmops:DryConvection a owl:Class ;
    rdfs:label "dry convection"@en ;
    rdfs:subClassOf sophft:Convection .

sophatmops:ElevatedConvection a owl:Class ;
    rdfs:label "elevated convection"@en ;
    rdfs:comment "Convection that originates from an atmospheric layer above the boundary layer."@en ;
    rdfs:subClassOf sophft:Convection .

sophatmops:ExtratropicalCyclone a owl:Class ;
    rdfs:label "extratropical cyclone"@en ;
    rdfs:comment "Any cyclonic-scale storm that is not a tropical cyclone, usually referring only to the migratory frontal cyclones of middle and high latitudes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorear:Extratropics ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:AtmosphericCyclone .

sophatmops:KatallobaticCenter a owl:Class ;
    rdfs:label "katallobatic center"@en ;
    rdfs:comment "A point of maximum decrease in atmospheric pressure over a specified interval of time; on synoptic charts, a point of greatest negative pressure tendency; opposed to a pressure- rise center."@en ;
    rdfs:subClassOf sophatmops:AtmosphericLowPressure .

sophatmops:LeesideConvergence a owl:Class ;
    rdfs:label "leeside convergence"@en ;
    rdfs:comment "Region of convergence, often a line, downwind of a mountain or mountain ridge during fair-weather daytime conditions that are favorable for the formation of thermally forced upslope flow and deep convective mixing. Convergence forms between upslope (or sometimes light and variable) flow at lower elevations of the lee slopes and downslope flow at higher elevations, which results from the downward convective mixing of ambient momentum from the flow above ridgetops. With moist upslope flow and favorable conditions, updrafts produced by the convergence can lead to mountain cumulus formation, or trigger thunderstorm or severe weather activity."@en ;
    rdfs:subClassOf soproptf:Convergence .

sophatmops:LongmontAnticyclone a owl:Class ;
    rdfs:label "longmont anticyclone"@en ;
    rdfs:comment "A mesoscale zone of anticyclonically turning winds that develops downstream of the Cheyenne Ridge in northeast Colorado and southeast Wyoming, and is often centered just east of the foothills of the Rocky Mountains near the town of Longmont, Colorado. The cause of the feature is the interaction of the ambient low level northwest flow with the east?west terrain feature known as the Cheyenne Ridge. See also Denver convergence?vorticity zone."@en ;
    rdfs:subClassOf sophatmops:AtmosphericAnticyclone .

sophatmops:Mesoanticyclone a owl:Class ;
    rdfs:label "mesoanticyclone"@en ;
    rdfs:comment "An anticyclonically rotating vortex, around 210 km in diameter, in a convective storm."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophft:Convection ],
        [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophatmops:AtmosphericAnticyclone .

sophatmops:Mesocyclone a owl:Class ;
    rdfs:label "mesocyclone"@en ;
    rdfs:comment "A cyclonically rotating vortex, around 2?10 km in diameter, in a convective storm. The vorticity associated with a mesocyclone is often on the order of 10-2 s-1 or greater. (It should be noted that a mesocyclone is not just any cyclone on the mesoscale; it refers specifically to cyclones within convective storms.) Mesocyclones are frequently found in conjunction with updrafts in supercells. Tornadoes sometimes form in mesocyclones. Persistent mesocyclones that have significant vertical extent are detected by Doppler radar as mesocyclone signatures. Tornado warnings may be issued when a mesocyclone signature is detected."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophft:Convection ],
        [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophatmops:AtmosphericCyclone .

sophatmops:Mesolow a owl:Class ;
    rdfs:label "mesolow"@en ;
    rdfs:comment "A low pressure area on the mesoscale. It has been used to refer both to features observed within convective storms and features even larger in scale."@en ;
    rdfs:subClassOf sophatmops:AtmosphericLowPressure .

sophatmops:MesoscaleCellularConvection a owl:Class ;
    rdfs:label "mesoscale cellular convection"@en ;
    rdfs:comment "A regular pattern of convective cells that can develop in an atmospheric boundary layer heated from below or radiatively cooled from cloud top. This phenomenon is readily observed in satellite imagery during cold air outbreaks when continental air passes over the relatively warm coastal ocean. Cloud lines, marking horizontal roll vortices, form initially in the developing marine atmospheric boundary layer. These lines evolve into open cells, which are defined by clouds in the upward motion along the edges of honeycomb- shaped cells, with less cloudy subsiding air in their centers. The convective structure further evolves into closed cells, which have cloudy centers and cloud-free edges."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophfd:CellCluster .

sophatmops:MesoscaleConvectiveComplex a owl:Class ;
    rdfs:label "mesoscale convective complex"@en ;
    rdfs:comment "A subset of mesoscale convective systems (MCS) that exhibit a large, circular (as observed by satellite), long-lived, cold cloud shield.  Alternatively, a dynamical definition of an MCC requires that the system have a Rossby number of order 1 and exhibit a horizontal scale comparable to the Rossby radius of deformation. In midlatitude MCS environments, the Rossby radius of deformation is about 300 km."@en ;
    rdfs:subClassOf sophatmops:MesoscaleConvectiveSystem .

sophatmops:MiniSupercell a owl:Class ;
    rdfs:label "mini supercell"@en ;
    rdfs:comment "Convective storm that contains similar radar characteristics to those of a supercell (e.g., hook echo, WER, BWER), but is significantly smaller in height and width. The diameter of the radar-detected rotation is 1?8 km. This is a relatively new storm type, the existence of which has been confirmed by data from the recently installed WSR?88D radars in the US. Mini-supercells occur in areas where the height of the equilibrium level is low, most often in the northern US, but possibly under certain weather conditions in any area of the world. They are sometimes found in landfalling tropical cyclones."@en ;
    rdfs:subClassOf sophatmopc:ConvectiveStorm .

sophatmops:MinorRidge a owl:Class ;
    rdfs:label "minor ridge"@en ;
    rdfs:comment "A ridge of smaller scale than a long-wave ridge. It ordinarily moves rapidly and is associated with a migratory anticyclonic disturbance in the lower troposphere. See short wave."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostro:Minor ;
            owl:onProperty sorel:hasRole ],
        sophatmops:AtmosphericRidge .

sophatmops:MinorTrough a owl:Class ;
    rdfs:label "minor trough"@en ;
    rdfs:comment "A pressure trough of smaller scale than a long-wave trough. It ordinarily moves rapidly and is associated with a migratory cyclonic disturbance in the lower troposphere. See short wave."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostro:Minor ;
            owl:onProperty sorel:hasRole ],
        sophatmops:AtmosphericTrough .

sophatmops:MoistConvection a owl:Class ;
    rdfs:label "moist convection"@en ;
    rdfs:comment "Atmospheric convection in which the phase changes of water play an appreciable role. All cumuliform clouds are manifestations of moist convection. The enthalpy exchange between condensing water vapor or freezing liquid water and air (see latent heat) is a major contributor to the positive buoyancy of updrafts, while the reverse exchange between air and evaporating water or melting ice contributes strongly to the negative buoyancy of downdrafts."@en ;
    rdfs:subClassOf sophft:Convection .

sophatmops:MonsoonDepression a owl:Class ;
    rdfs:label "monsoon depression"@en ;
    rdfs:comment "A depression that forms within the monsoon trough. The term is most frequently used to describe weak cyclonic disturbances that form over the Bay of Bengal and generally track northwestward over the Indian subcontinent. These occasionally intensify into tropical cyclones if they remain over warm ocean water long enough. The term is also used to describe depressions that form within the monsoon trough near Australia and in the western North Pacific region. The term has gained ascendancy in use to refer to a broad tropical cyclonic vortex characterized by 1) its large size, where the outermost closed isobar may have a diameter on the order of 600 n mi (1000 km); 2) a loosely organized cluster of deep convective elements, which may form an elongated band of deep convection in the east semicircle; 3) a low- level wind distribution that features a 100 n mi (200 km) diameter light-wind core, which may be surrounded by a band of gales or contain a highly asymmetric wind field; and 4) a lack of a distinct cloud system center. Most monsoon depressions that develop in the western North Pacific eventually acquire persistent central convection and accelerated core winds, marking their transitions into conventional tropical cyclones."@en ;
    rdfs:subClassOf sophatmopc:Monsoon .

sophatmops:MonsoonGyre a owl:Class ;
    rdfs:label "monsoon gyre"@en ;
    rdfs:comment "A convection of the summer monsoon circulation of the western North Pacific characterized by 1) a very large nearly circular low-level cyclonic vortex (not the result of the expanding wind field of a preexisting monsoon depression or tropical cyclone) that has an outermost closed isobar with a diameter on the order of 1200 n mi (2500 km); 2) a cloud band bordering the southern through eastern periphery of the vortex/surface low; and 3) a relatively long (two week) life span. Initially, a subsequent regime exists in its core and western and northwestern quadrants with light winds and scattered low cumulus clouds; later, the area within the outer closed isobar may fill with deep convective cloud and become a isobar or tropical cyclone. Note: a series of midget tropical cyclones may emerge from the ?head? or leading edge of the peripheral tropical cyclone of a monsoon gyre."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophft:Convection ],
        sophfd:Circulation .

sophatmops:MonsoonLow a owl:Class ;
    rdfs:label "monsoon low"@en ;
    rdfs:comment "A seasonal low found over a continent in the summer and over the adjacent sea in the winter. Examples are the lows over the southwestern US and India in summer and those located off lower California and in the Bay of Bengal in winter. Palmer (1951) points out that, while the winter and summer monsoon lows appear similar on mean charts, they are dynamically quite different. Compare thermal low."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Monsoon ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmops:AtmosphericLowPressure .

sophatmops:Multivortex a owl:Class ;
    rdfs:label "multivortex"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfd:Vortex ;
            owl:onProperty sorelsp:clusterOf ],
        sorepsg:Cluster .

sophatmops:PolarCyclone a owl:Class ;
    rdfs:label "polar cyclone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorear:Polar ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:AtmosphericCyclone .

sophatmops:PolarLow a owl:Class ;
    rdfs:label "polar low"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorear:Polar ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:AtmosphericLowPressure .

sophatmops:ShallowConvection a owl:Class ;
    rdfs:label "shallow convection"@en ;
    rdfs:subClassOf sophft:Convection .

sophatmops:SubtropicalCyclone a owl:Class ;
    rdfs:label "subtropical cyclone"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorear:Subtropics ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmops:AtmosphericCyclone .

sophatmops:TUTT a owl:Class ;
    rdfs:label "tutt"@en ;
    owl:equivalentClass sophatmops:TropicalUpperTroposphericTrough .

sophatmops:UpdraftCurtain a owl:Class ;
    rdfs:label "updraft curtain"@en ;
    rdfs:comment "Long narrow sheets of warm air rising from a heated surface."@en ;
    rdfs:subClassOf sophft:Convection .

<http://sweetontology.net/phenAtmoSky> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Sky" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/phenAtmoFog>,
        <http://sweetontology.net/phenEnvirImpact>,
        <http://sweetontology.net/procWave>,
        <http://sweetontology.net/rela> ;
    owl:versionInfo "3.6.0" .

sophatmos:Airglow a owl:Class ;
    rdfs:label "airglow"@en ;
    rdfs:subClassOf sophatmos:AtmosphericLightEmission .

sophatmos:Aurora a owl:Class ;
    rdfs:label "aurora"@en ;
    rdfs:subClassOf sophatmos:AtmosphericLightEmission .

sophatmos:AuroralSubstorm a owl:Class ;
    rdfs:label "auroral substorm"@en ;
    rdfs:subClassOf sophatmos:AtmosphericLightEmission ;
    owl:equivalentClass sophatmos:MagneticSubstorm .

sophatmos:IndoorAirQuality a owl:Class ;
    rdfs:label "indoor air quality"@en ;
    rdfs:subClassOf sophatmos:AirQuality .

sophatmos:OzoneDepletion a owl:Class ;
    rdfs:label "ozone depletion"@en ;
    owl:equivalentClass sophatmos:OzoneHole .

sophatmos:PhotochemicalAirPollution a owl:Class ;
    rdfs:label "photochemical air pollution"@en ;
    rdfs:subClassOf sophatmos:AirPollution .

sophatmos:Rainbow a owl:Class ;
    rdfs:label "rainbow"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmos:Sunlight a owl:Class ;
    rdfs:label "sunlight"@en ;
    rdfs:subClassOf soph:RadiativeHeating .

sophatmos:Sunlit a owl:Class ;
    rdfs:label "sunlit"@en ;
    rdfs:subClassOf sophatmo:WeatherCondition .

sophatmos:Whiteout a owl:Class ;
    rdfs:label "whiteout"@en ;
    rdfs:subClassOf sophatmos:Obscuration .

sophatmos:ZodiacalLight a owl:Class ;
    rdfs:label "zodiacal light"@en ;
    rdfs:subClassOf sophatmos:AtmosphericLightEmission .

sophatmot:AcidFog a owl:Class ;
    rdfs:label "acid fog"@en ;
    rdfs:comment "Occurrence of fog or haze in which considerable amounts of acidic material have been taken up from the gas phase, resulting in pH values less than approximately 3 in the liquid phase."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Acid ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmofo:Fog ;
    owl:equivalentClass sophatmot:AcidHaze .

sophatmot:AcidRain a owl:Class ;
    rdfs:label "acid rain"@en ;
    rdfs:comment "A popular expression for the deposition by rainfall of various airborne pollutants (especially SO2 and NO2) that have harmful effects on vegetation, soils, buildings and other external structures."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Acid ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmot:WetDeposition .

sophatmot:MixedLayerVenting a owl:Class ;
    rdfs:label "mixed layer venting"@en ;
    rdfs:comment "Removal of pollutants out of the top of the atmospheric boundary layer through the mixed-layer capping inversion. Normally pollutants cannot escape through the capping inversion. However, penetrating cumulus clouds, thunderstorms, mountain circulations, and frontal circulations can force polluted air through the inversion to vent pollutants into the free atmosphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaabl:MixedLayer ;
            owl:onProperty sorel:hasPhenomena ],
        sophsy:Removal .

sophatmot:NucleationScavenging a owl:Class ;
    rdfs:label "nucleation scavenging"@en ;
    rdfs:comment "Water vapor that removes particulate matter from the atmosphere"@en ;
    rdfs:subClassOf sophatmot:ScavengingByPrecipitation .

sophatmot:Rainout a owl:Class ;
    rdfs:label "rainout"@en ;
    rdfs:subClassOf sophatmot:ScavengingByPrecipitation ;
    owl:equivalentClass sophatmot:Washout .

sophatmow:AgeostrophicWind a owl:Class ;
    rdfs:label "ageostrophic wind"@en ;
    rdfs:comment "The vector difference between the real (or observed) wind and the geostrophic wind"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:AtmosphericPumping a owl:Class ;
    rdfs:label "atmospheric pumping"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:Blowing a owl:Class ;
    rdfs:label "blowing"@en ;
    rdfs:comment "When dust, sand, snow, and/or spray is raised by the wind to a height of 6 feet or more"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:CrossWind a owl:Class ;
    rdfs:label "cross wind"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:Derecho a owl:Class ;
    rdfs:label "derecho"@en ;
    rdfs:comment "A widespread convectively induced straight-line windstorm."@en ;
    rdfs:subClassOf sophatmow:WindStorm .

sophatmow:Downdraft a owl:Class ;
    rdfs:label "downdraft"@en ;
    rdfs:comment "Small-scale downward moving air current in a cumulonimbus cloud."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:DrainageWind a owl:Class ;
    rdfs:label "drainage wind"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:DustDevil a owl:Class ;
    rdfs:label "dust devil"@en ;
    rdfs:subClassOf sophatmow:DustStorm .

sophatmow:EulerianWind a owl:Class ;
    rdfs:label "eulerian wind"@en ;
    rdfs:comment "In the classification of Jeffreys, a wind motion only in response to the pressure force."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:GeostrophicWind a owl:Class ;
    rdfs:label "geostrophic wind"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:Gust a owl:Class ;
    rdfs:label "gust"@en ;
    rdfs:comment "1. A sudden, brief increase in the speed of the wind. It is of a more transient character than a squall and is followed by a lull or slackening in the wind speed. Generally, winds are least gusty over large water surfaces and most gusty over rough land and near high buildings. According to U.S. weather observing practice, gusts are reported when the peak wind speed reaches at least 16 knots and the variation in wind speed between the peaks and lulls is at least 9 knots. The duration of a gust is usually less than 20 s. 2. With respect to aircraft turbulence, a sharp change in wind speed relative to the aircraft; a sudden increase in airspeed due to fluctuations in the airflow, resulting in increased structural stresses upon the aircraft. 3. (Rare.) Same as cloudburst."@en ;
    rdfs:subClassOf sophatmow:Wind ;
    owl:equivalentClass sophatmow:WindGust .

sophatmow:HadleyCirculation a owl:Class ;
    rdfs:label "hadley circulation"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:HeadWind a owl:Class ;
    rdfs:label "head wind"@en ;
    rdfs:comment "A wind that opposes the intended progress of an exposed, moving object, for example, rendering an airborne object's airspeed greater than its groundspeed; the opposite of a tailwind."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:HotWind a owl:Class ;
    rdfs:label "hot wind"@en ;
    rdfs:comment "General term for winds characterized by intense heat and low relative humidity, such as summertime desert winds or an extreme foehn."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Heating ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmow:Wind .

sophatmow:JetEffectWind a owl:Class ;
    rdfs:label "jet effect wind"@en ;
    rdfs:comment "A local wind created by acceleration of the airflow through a gap, constriction, or channel in a mountain range or between ranges."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:JetStreak a owl:Class ;
    rdfs:label "jet streak"@en ;
    rdfs:comment "The region of a jet stream axis with the greatest winds."@en ;
    rdfs:subClassOf sophatmow:JetStream .

sophatmow:JetStreamAxis a owl:Class ;
    rdfs:label "jet stream axis"@en ;
    rdfs:comment "The axis of maximum wind speed in a jet stream."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmow:JetStream ;
            owl:onProperty sorel:hasPhenomena ],
        sopropsdir:Axis .

sophatmow:MeridionalWind a owl:Class ;
    rdfs:label "meridional wind"@en ;
    rdfs:comment "The wind or wind component along the local meridian, as distinguished from the zonal wind. In a horizontal coordinate system fixed locally with the x axis directed eastward and the y axis northward, the meridional wind is positive if from the south, and negative if from the north."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:Microburst a owl:Class ;
    rdfs:label "microburst"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:SandStorm a owl:Class ;
    rdfs:label "sand storm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somas:Sand ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmow:Wind .

sophatmow:Tailwind a owl:Class ;
    rdfs:label "tailwind"@en ;
    rdfs:comment "A wind that assists the intended progress of an exposed, moving object, for example, rendering an airborne object's groundspeed greater than its airspeed; the opposite of a headwind."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:TertiaryCirculation a owl:Class ;
    rdfs:label "tertiary circulation"@en ;
    rdfs:comment "The generally small, localized atmospheric circulations."@en ;
    rdfs:subClassOf sophatmow:AtmosphericCirculation .

sophatmow:ThermalWind a owl:Class ;
    rdfs:label "thermal wind"@en ;
    rdfs:comment "The mean wind-shear vector in geostrophic balance with the gradient of mean temperature of a layer bounded by two isobaric surfaces."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:TradeWind a owl:Class ;
    rdfs:label "trade wind"@en ;
    rdfs:comment "The wind system, occupying most of the Tropics, that blows from the subtropical highs toward the equatorial trough; a major component of the general circulation of the atmosphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmow:AtmosphericCirculation ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmow:GlobalWindCirculation .

sophatmow:VeeringWind a owl:Class ;
    rdfs:label "veering wind"@en ;
    rdfs:comment "In the Northern Hemisphere, a wind that rotates in a clockwise direction with increasing height; the opposite of backing wind."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Rotation ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmow:Wind .

sophatmow:WalkerCell a owl:Class ;
    rdfs:label "walker cell"@en ;
    owl:equivalentClass sophatmow:WalkerCirculation .

sophatmow:WarmConveyorBelt a owl:Class ;
    rdfs:label "warm conveyor belt"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:Windborne a owl:Class ;
    rdfs:label "windborne"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmow:ZonalWind a owl:Class ;
    rdfs:label "zonal wind"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmow:ZonalFlow ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmow:GlobalWindCirculation .

sophatmowm:AnabaticWind a owl:Class ;
    rdfs:label "anabatic wind"@en ;
    rdfs:comment "In mountain meteorology, an upslope wind driven by heating (usually daytime insolation) at the slope surface under fair-weather conditions."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Heating ;
            owl:onProperty sorel:hasProcess ],
        sophatmowm:MountainWind .

sophatmowm:BarrierJet a owl:Class ;
    rdfs:label "barrier jet"@en ;
    rdfs:comment "A jet on the windward side of a mountain barrier, blowing parallel to the barrier."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:BlackSquall a owl:Class ;
    rdfs:label "black squall"@en ;
    rdfs:comment "A squall accompanied by dark clouds and generally by heavy rain."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:BookEndVorticities a owl:Class ;
    rdfs:label "book end vorticities"@en ;
    rdfs:comment "Mesoscale vortices observed at the ends of a line segment of convective cells, usually cyclonic on the northern end of the system and anticyclonic on the southern end, for an environment of westerly vertical wind shear"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:Vortex .

sophatmowm:Bora a owl:Class ;
    rdfs:label "bora"@en ;
    rdfs:comment "A fall wind with a source so cold that, when the air reaches the lowlands or coast, the dynamic warming is insufficient to raise the air temperature to the normal level for the region; hence it appears as a cold wind"@en ;
    rdfs:subClassOf sophatmowm:FallWind .

sophatmowm:CanyonWind a owl:Class ;
    rdfs:label "canyon wind"@en ;
    rdfs:comment "The mountain wind of a canyon, that is, the nighttime down-canyon flow of air caused by cooling at the canyon walls."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Cooling ;
            owl:onProperty sorel:hasProcess ],
        sophatmowm:MountainWind .

sophatmowm:CherguiWind a owl:Class ;
    rdfs:label "chergui wind"@en ;
    rdfs:comment "An east or southeast desert wind in Morocco (North Africa), especially in the north."@en ;
    rdfs:subClassOf sophatmowm:DesertWind .

sophatmowm:ChinookWind a owl:Class ;
    rdfs:label "chinook wind"@en ;
    rdfs:comment "The name given to the foehn in western North America, especially on the plains to the lee or eastern side of the Rocky Mountains in the US and Canada."@en ;
    owl:equivalentClass sophatmowm:Foehn .

sophatmowm:DownslopeWindStorm a owl:Class ;
    rdfs:label "downslope wind storm"@en ;
    rdfs:comment "A very strong, usually gusty, and occasionally, violent wind that blows down the lee slope of a mountain range, often reaching its peak strength near the foot of the mountains and weakening rapidly father away from the mountains."@en ;
    rdfs:subClassOf sophatmowm:DownslopeWind .

sophatmowm:FogWind a owl:Class ;
    rdfs:label "fog wind"@en ;
    rdfs:comment "The humid east wind that crosses the divide of the Andes east of Lake Titicaca and descends on the west in violent squalls; probably the same as puelche."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmofo:Fog ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmowm:Squall .

sophatmowm:Forano a owl:Class ;
    rdfs:label "forano"@en ;
    rdfs:comment "A sea breeze of Naples in Italy."@en ;
    rdfs:subClassOf sophatmowm:SeaBreeze .

sophatmowm:Galerne a owl:Class ;
    rdfs:label "galerne"@en ;
    rdfs:comment "A squally northwesterly wind, cold, humid, and showery, that occurs in the rear of a low pressure area over the English Channel and off the Atlantic coast of France and northern Spain."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:Gallego a owl:Class ;
    rdfs:label "gallego"@en ;
    rdfs:comment "A strong, low-level wind through either a relatively level channel between two mountain ranges or a gap in a mountain barrier; originally applied to strong (10?20 m s-1) easterly winds through the Strait of Juan de Fuca between the Olympic Mountains of western Washington State and the mountains of Vancouver Island, British Columbia, Canada. There they have been defined as ?a flow of air in a sea level channel that accelerates under the influence of a pressure gradient parallel to the axis of the channel.? As in the case of mountain- gap winds, this term has also been applied to pressure-gradient winds accelerating through a gap in a mountain barrier. The pressure gradient often results from a stable, post-cold-frontal anticyclone approaching the barrier and being partially blocked (see blocking) as it ascends the barrier, except for the flow through the gap or channel. The tehuantepecer of Central America is a well- known gap wind by this definition. These flows have sometimes been referred to as jet-effect wind and canyon wind."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:Garbin a owl:Class ;
    rdfs:label "garbin"@en ;
    rdfs:comment "A sea breeze.  In southwest France it refers to a southwesterly sea breeze that sets in about 9 A.M., reaches it maximum towards 2 P.M. and ceases about 5 P.M."@en ;
    rdfs:subClassOf sophatmowm:SeaBreeze .

sophatmowm:Gending a owl:Class ;
    rdfs:label "gending"@en ;
    rdfs:comment "A local dry wind in the northern plains of Java, resembling the foehn. It is caused by a wind crossing the mountains near the south coast and pushing between the volcanoes."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:Gharbi a owl:Class ;
    rdfs:label "gharbi"@en ;
    rdfs:comment "A fresh westerly wind of oceanic origin in Morocco."@en ;
    rdfs:subClassOf sophatmowm:OceanWind .

sophatmowm:Gharra a owl:Class ;
    rdfs:label "gharra"@en ;
    rdfs:comment "Hard squalls from the northeast in Libya and Africa. They are sudden and frequent and are accompanied by heavy rain and thunder."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:Ghibli a owl:Class ;
    rdfs:label "ghibli"@en ;
    rdfs:comment "A hot dust-bearing desert wind in Tripolitania (northwestern Libya), similar to the foehn."@en ;
    rdfs:subClassOf sophatmowm:DesertWind .

sophatmowm:GlacierWind a owl:Class ;
    rdfs:label "glacier wind"@en ;
    rdfs:comment "A shallow gravity wind, along the icy surface of a glacier, caused by the temperature difference between the air in contact with the glacier and free air at the same altitude. The glacier wind does not reverse itself diurnally as do mountain and valley winds, but it reaches its maximum intensity in the early afternoon. The glacier wind is characterized by strongly turbulent flow. See katabatic wind."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreac:Glacier ;
            owl:onProperty sorel:hasRealm ],
        sophatmowm:GravityWind .

sophatmowm:GorgeWind a owl:Class ;
    rdfs:label "gorge wind"@en ;
    rdfs:comment "A gap wind or canyon wind through a gorge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealf:Gorge ;
            owl:onProperty sorel:hasRealm ],
        sophatmowm:MesoscaleWind .

sophatmowm:Greco a owl:Class ;
    rdfs:label "greco"@en ;
    rdfs:comment "An Italian name for the northeast wind. It was given by Roman sailors to the northeast wind in the Gulf of Lions because it came from the direction of the Greek colony of Marsala (Marseilles). Wind names of similar origin are common in the western Mediterranean, for example, gregale."@en ;
    rdfs:subClassOf sophatmowm:OceanWind .

sophatmowm:Gregale a owl:Class ;
    rdfs:label "gregale"@en ;
    rdfs:comment "The Maltese and best-known variant of a term for a strong northeast wind in the central and western Mediterranean and adjacent European land areas (stronger than the levante)."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:GregauWind a owl:Class ;
    rdfs:label "gregau wind"@en ;
    rdfs:comment "In the Tirol, an east wind during March and April."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:GullySquall a owl:Class ;
    rdfs:label "gully squall"@en ;
    rdfs:comment "A nautical term for a violent squall of wind from mountain ravines on the Pacific side of Central America."@en ;
    rdfs:subClassOf sophatmowm:MountainWind,
        sophatmowm:Squall .

sophatmowm:Haboob a owl:Class ;
    rdfs:label "haboob"@en ;
    rdfs:comment "A strong wind and sandstorm or duststorm in northern and central Sudan, especially around Khartoum, where the average number is about 24 a year. The name comes from the Arabic word habb, meaning ?wind.? Haboobs are most frequent from May through September, especially in June, but they have occurred in every month except November. Their average duration is three hours; they are most severe in April and May when the soil is driest. They may approach from any direction, but most commonly from the north in winter and from the south, southeast, or east in summer. The average maximum wind velocity is over 13 m s-1 (30 mph) and a speed of 28 m s-1 (62 mph) has been recorded. The sand and dust form a dense whirling wall that may be 1000 m (3000 ft) high; it is often preceded by isolated dust whirls. During these storms, enormous quantities of sand are deposited. Haboobs usually occur after a few days of rising temperature and falling pressure."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:IbeWind a owl:Class ;
    rdfs:label "ibe wind"@en ;
    rdfs:comment "A local strong wind that blows through the Dzungarian Gate (in western China), a gap in the mountain ridge separating the depression of Lakes Balkash and Ala Kul from that of Lake Ebi Nor. The wind resembles the foehn and brings a sudden rise of temperature, in winter from about -26? to about -1?C."@en ;
    rdfs:subClassOf sophatmowm:Foehn .

sophatmowm:InlandSeaBreeze a owl:Class ;
    rdfs:label "inland sea breeze"@en ;
    rdfs:comment "A circulation similar to a sea breeze, except not at a shore. The inland sea breeze is a very weak thermal circulation caused by temperature contrast between different land surfaces and is sometimes observed between cool irrigated farm land and neighboring dry desert land. This phenomenon is observed only when the synoptic-scale winds are very light."@en ;
    rdfs:subClassOf sophatmowm:SeaBreeze .

sophatmowm:Kachchan a owl:Class ;
    rdfs:label "kachchan"@en ;
    rdfs:comment "A hot, dry, west or southwest wind of foehn type in the lee of the Sri Lanka hills during the southwest monsoon in June and July."@en ;
    rdfs:subClassOf sophatmowm:Foehn .

sophatmowm:KalBaisakhi a owl:Class ;
    rdfs:label "kal baisakhi"@en ;
    rdfs:comment "In India, a short-lived dusty squall at the onset of the southwest monsoon (April? June) in Bengal."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Monsoon ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmowm:Squall .

sophatmowm:Karaburan a owl:Class ;
    rdfs:label "karaburan"@en ;
    rdfs:comment "A violent northeast wind of Central Asia occurring during spring and summer."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Karajol a owl:Class ;
    rdfs:label "karajol"@en ;
    rdfs:comment "On the Bulgarian coast, a west wind that usually follows rain and persists for one to three days."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Karema a owl:Class ;
    rdfs:label "karema"@en ;
    rdfs:comment "A violent east wind on Lake Tanganyika in Africa."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Karif a owl:Class ;
    rdfs:label "karif"@en ;
    rdfs:comment "A strong southwest wind on the southern shore of the Gulf of Aden, especially at Berbera, Somaliland, during the southwest monsoon."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Kaus a owl:Class ;
    rdfs:label "kaus"@en ;
    rdfs:comment "A moderate to gale-force southeasterly wind in the Persian Gulf; it is accompanied by gloomy weather, rain, and squalls."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Khamsin a owl:Class ;
    rdfs:label "khamsin"@en ;
    rdfs:comment "(Also spelled camsin, chamsin, kamsin, khamasseen, khemsin.) A dry, dusty, and generally hot desert wind in Egypt and over the Red Sea. It is generally southerly or southeasterly, occurring in front of depressions moving eastward across North Africa or the southeastern Mediterranean. The deep khamsins occur in spring with depressions traveling east-northeast across the northern Sahara. They are preceded by a heat wave lasting about three days and are followed by a duststorm. The passage of the depression is marked by a cold front bringing Mediterranean air and a sudden drop in temperature. See ghibli, chili, sirocco."@en ;
    rdfs:subClassOf sophatmowm:DesertWind .

sophatmowm:KloofWind a owl:Class ;
    rdfs:label "kloof wind"@en ;
    rdfs:comment "A cold southwest wind of Simons Bay, South Africa."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:KnikWind a owl:Class ;
    rdfs:label "knik wind"@en ;
    rdfs:comment "Local name for a strong southeast wind in the vicinity of Palmer in the Matanuska Valley of Alaska. The knik wind blows most frequently in the winter, although it may occur at any time of year. In winter the knik winds are accompanied by very pronounced temperature rises; cases of more than 10?C in 24 hours have been observed. These winds may last from one to ten days. They result from a pressure gradient normal to the Chugach Mountains, causing a pronounced foehn effect in the Matanuska Valley."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Koembang a owl:Class ;
    rdfs:label "koembang"@en ;
    rdfs:comment "A dry foehnlike wind from southeast or south in Cheribon and Tegal in Indonesia. It is caused by the east monsoon that develops a jet effect in passing through the gaps in the mountain ranges and descends on the leeward side."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Kona a owl:Class ;
    rdfs:label "kona"@en ;
    rdfs:comment "A stormy, rain-bringing wind from the southwest or south-southwest in Hawaii. It blows about five times a year on the southwest slopes that are in the lee of the prevailing northeast trade winds. Kona is the Polynesian word for ?leeward.? It is associated with a southward or a southeastward swing of the Aleutian low and the passage of a secondary depression (kona cyclone) from northwest to southeast, north of the islands."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Kossava a owl:Class ;
    rdfs:label "kossava"@en ;
    rdfs:comment "(Also spelled kosava, koschawa.) A cold, very squally wind, descending from the east or southeast in the region of the Danube ?Iron Gate? through the Carpathians, continuing westward over Belgrade, thence spreading northward to the Rumanian and Hungarian borderlands and southward as far as Nish. In winter it brings temperatures down to below -29C and it is cool even in summer, when it is also dusty. It usually occurs with a depression over the Adriatic and high pressure over southern Russia, a frequent situation in winter. It is usually explained as a jet-effect wind through the Iron Gate, giving speeds well above the gradient wind, but it can be regarded as a katabatic wind intermediate between foehn and bora. The kossava has a marked diurnal variation, with its maximum occurring between 5 AM and 10 AM."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:KrakatoaWind a owl:Class ;
    rdfs:label "krakatoa wind"@en ;
    rdfs:comment "(Also spelled Krakatau; formerly called overtrades.) A layer of easterly winds over the Tropics at an altitude of about 18-24 km. This layer tops the midtropospheric westerlies (the antitrades), is at least 6 km deep, and is based at about 2 km above the tropopause. This easterly current is more prominent and better defined in the summer hemisphere. It derives its name from the observed behavior of the volcanic dust carried around the world after the great eruption of Krakatoa (6?S, 105?E) in 1883."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Labbe a owl:Class ;
    rdfs:label "labbe"@en ;
    rdfs:comment "A moderate to strong southwest wind in Provence (southeastern France), mild, humid, and very cloudy or rainy. On the coast it raises a rough sea. It is not frequent, occurring only in March. In the Swiss? French Alps it is locally termed labech, and is squally with thunder, hail, and brief torrential downpours; it comes mainly in autumn and winter."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Laheimar a owl:Class ;
    rdfs:label "laheimar"@en ;
    rdfs:comment "Severe squalls during the change of seasons in October and November in Arabia."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:LakeBreeze a owl:Class ;
    rdfs:label "lake breeze"@en ;
    rdfs:comment "A wind, similar in origin to the sea breeze but generally weaker, blowing from the surface of a large lake onto the shores during the afternoon; it is caused by the difference in surface temperature of land and water as in the land and sea breeze system. In addition to area, the depth of the lake is an important factor; a shallow lake warms up rapidly and is less effective as the source of a lake breeze in summer than is a deep lake. Lake breezes are well developed around the Great Lakes of North America, where they temper the summer heat."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreahb:Lake ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmowm:MesoscaleWind .

sophatmowm:Leste a owl:Class ;
    rdfs:label "leste"@en ;
    rdfs:comment "Spanish nautical term for east wind. The name is given to a hot, dry, dusty easterly, or southeasterly wind that blows from the Atlantic coast of Morocco out to Madeira and the Canary Islands. It is a form of sirocco and occurs in front of depressions advancing eastward. Compare levanto."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Levante a owl:Class ;
    rdfs:label "levante"@en ;
    rdfs:comment "The Spanish and most widely used term for an east or northeast wind occurring along the coast and inland from southern France to the Straits of Gibraltar. It is moderate or fresh (not as strong as the gregale), mild, very humid, overcast, and rainy; it occurs with a depression over the western Mediterranean Sea. In summer it is rare and weak; in January it is inhibited by the Iberian anticyclone. It is most frequent from February to May and October to December. A levant (French spelling) with fine weather is a levant blanc; in the Roussillon region of southern France (where, as along the Catalonian coast of Spain, it is called llevant) it often brings floods in the mountain streams. The levanter of the Gibraltar Straits is a related phenomenon. Compare leste, lombarde, levantera."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Levantera a owl:Class ;
    rdfs:label "levantera"@en ;
    rdfs:comment "A persistent east wind in the Adriatic, usually bringing cloudy weather."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Leveche a owl:Class ;
    rdfs:label "leveche"@en ;
    rdfs:comment "A hot, sand- and dust-laden wind from between southeast and southwest that blows in front of a depression on the southeast coast of Spain but extends only a few miles inland."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Heating ;
            owl:onProperty sorel:hasProcess ],
        sophatmowm:MesoscaleWind .

sophatmowm:Libeccio a owl:Class ;
    rdfs:label "libeccio"@en ;
    rdfs:comment "Italian name for a southwest wind; used especially in northern Corsica for the west or southwest wind that blows throughout the year, and especially in winter when it is often stormy. On windward slopes it brings rain, with thunderstorms in summer and autumn. After crossing the mountains it is warm and dry, but may be very turbulent."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Liberator a owl:Class ;
    rdfs:label "liberator"@en ;
    rdfs:comment "A name sometimes given the west wind through the Straits of Gibraltar."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:LineSquall a owl:Class ;
    rdfs:label "line squall"@en ;
    rdfs:comment "A squall that occurs along a squall line. This term is now confined mostly to nautical usage."@en ;
    rdfs:subClassOf sophatmowm:Squall .

sophatmowm:Lombarde a owl:Class ;
    rdfs:label "lombarde"@en ;
    rdfs:comment "An easterly wind (from Lombardy) that predominates along the French?Italian frontier. It comes from the High Alps. In winter it is violent and forms snowdrifts in the mountain valleys. In the plains it is gentle and very dry. It is associated with an anticyclone over France and central Europe, or with high pressure to the southeast of Europe and low pressure to the northwest along with falling pressure over western France."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:LongShoreWind a owl:Class ;
    rdfs:label "long shore wind"@en ;
    rdfs:comment "1. A damp unpleasant wind that blows from the south in Madras (India). 2. A wind from the northeast at night in Sri Lanka."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:MackerelBreeze a owl:Class ;
    rdfs:label "mackerel breeze"@en ;
    rdfs:comment "(Also called mackerel gale.) A wind that ruffles the water, favoring the catching of mackerel."@en ;
    rdfs:subClassOf sophatmowm:OceanWind ;
    owl:equivalentClass sophatmowm:MackerelGale .

sophatmowm:Maestro a owl:Class ;
    rdfs:label "maestro"@en ;
    rdfs:comment "A northwesterly wind with fine weather that blows, especially in summer, in the Adriatic; it is most frequent on the western shore and is equivalent to the etesians of the eastern Mediterranean. It is also found on the coasts of Corsica and Sardinia. Compare mistral."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:MajolaWind a owl:Class ;
    rdfs:label "majola wind"@en ;
    rdfs:comment "A wind, named after the Maloja Pass between the Engadine and Bergall, Switzerland, that blows down the valley of the Upper Engadine by day and either up or down by night. This deviation from the usual nature of mountain and valley winds is attributed to the fact that the stronger daytime valley wind from the south overtops the ridge and continues down the Engadine."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:MalojaWind a owl:Class ;
    rdfs:label "maloja wind"@en ;
    rdfs:comment "A northwesterly wind with fine weather that blows, especially in summer, in the Adriatic; it is most frequent on the western shore and is equivalent to the etesians of the eastern Mediterranean. It is also found on the coasts of Corsica and Sardinia. Compare mistral."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Mamatele a owl:Class ;
    rdfs:label "mamatele"@en ;
    rdfs:comment "(Also called mamaliti, mamatili.) A light northwest wind of Sicily; a form of mistral."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Marin a owl:Class ;
    rdfs:label "marin"@en ;
    rdfs:comment "A warm moist southeast wind from the sea on the French Mediterranean coast and in the Maritime Alps, especially frequent in spring and autumn. In the Rh?ne delta it blows also from the south. The marin is associated with depressions that cross southern France or northern Spain and the Gulf of Lions. Generally, it is strong and regular, sometimes violent and turbulent in hilly country as the ayalas in the Massif Central; it is very humid, cloudy with hill fog, and often rainy (unless unaccompanied by fronts, when it is the marin blanc). The heavy rains, which may continue for one or two days on the mountain slopes, cause dangerous river floods. On the western slope of the C?vennes it becomes the autan. In the southern C?vennes the marin is called the aygalas. On the coast of Catalonia (northeast Spain) and Roussillon (southern France) it is the marinada and generally occurs with a depression centered over or south of the Gulf of Gascony. Compare sirocco."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:MatanuskaWind a owl:Class ;
    rdfs:label "matanuska wind"@en ;
    rdfs:comment "The local name, taken from the Matanuska River, for a strong, gusty, northeast wind that occasionally occurs during the winter in the vicinity of Palmer, Alaska."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Matinal a owl:Class ;
    rdfs:label "matinal"@en ;
    rdfs:comment "The morning wind, that is, an east wind. In the Morvan Mountains and the center of the Massif Central in France, the matinal often blows for several days, especially in summer, and brings fine weather. On winter mornings a northeast or east wind descends the western slopes of the Alps (where it is known as the matini?re) bringing cold and generally fine weather. Compare solaire."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Meltem a owl:Class ;
    rdfs:label "meltem"@en ;
    rdfs:comment "1. (Also spelled melt?mi.) A strong wind from the northeast or east that often sets in suddenly and blows during the day in summer on the Bulgarian coast and in the Bosporus. 2. Same as monsoon."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Mergozzo a owl:Class ;
    rdfs:label "mergozzo"@en ;
    rdfs:comment "Northwest wind on Lake Maggiore, Italy."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Mesojet a owl:Class ;
    rdfs:label "mesojet"@en ;
    rdfs:comment "A mesoscale wind maximum. It typically may have an along-flow length scale of tens to hundreds of kilometers and a cross- flow length scale of 100 km. Mesojets differ from planetary-scale jets, which can have length scales of several thousand kilometers, and synoptic-scale jets, which may have length scales of 1000? 2000 km and are commonly found in association with progressive synoptic-scale troughs and ridges. Larger mesojets may also sometimes be known as jet streaks. Mesojets can form adjacent to prominent orographic features in association with terrain-channeled flow. Mesojets are also seen in association with organized mesocale convective systems as typified by the evaporatively driven rear-inflow jet commonly found behind active squall lines lines. Mesojets may also be found in conjunction with prominent lower-tropospheric stable layers where the airflow can become decoupled from the planetary boundary layer, especially at night. An exceptionally well organized lower-tropospheric mesojet extending over hundreds of kilometers might be known as a low-level jet."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Miejour a owl:Class ;
    rdfs:label "miejour"@en ;
    rdfs:comment "A warm, moist sea breeze from the south that sets in at midday in Provence, France, south of Mount Ventoux. In the Roussillon region the midday south wind (mitgjorn) is irregular and generally light, and is dry after crossing the Pyrenees."@en ;
    rdfs:subClassOf sophatmowm:SeaBreeze .

sophatmowm:MoazagotlWind a owl:Class ;
    rdfs:label "moazagotl wind"@en ;
    rdfs:comment "The strong wind blowing across a mountain crest, responsible for the formation of the Moazagotl cloud."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:Molan a owl:Class ;
    rdfs:label "molan"@en ;
    rdfs:comment "Breeze blowing from Arve toward Geneva in Switzerland."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:MonsoonSurge a owl:Class ;
    rdfs:label "monsoon surge"@en ;
    rdfs:comment "The temporary extension of deep monsoon flow into a region not normally dominated by persistent monsoon flow. This temporary extension or surge may last from a few days to three weeks. These surges most commonly occur eastward across the Philippine Sea into the western North Pacific and east of Australia into the western South Pacific. The establishment of a reverse-oriented monsoon trough is accompanied by an eastward surge in the monsoon flow. Monsoon surges are often precursors to the development of tropical cyclones."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:Morget a owl:Class ;
    rdfs:label "morget"@en ;
    rdfs:comment "The night land breeze on Lake Geneva, Switzerland.  It blows from the north from 5-7 P.M. until 7-9 A.M. as a poweful breeze.  In the late fall and winter it blows almost throughout the day."@en ;
    rdfs:subClassOf sophatmowm:LandBreeze .

sophatmowm:MountainBreeze a owl:Class ;
    rdfs:label "mountain breeze"@en ;
    rdfs:comment "A nocturnal component of the mountain?plains or mountain?valley wind systems encountered during periods of light synoptic flow."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:MountainGapWind a owl:Class ;
    rdfs:label "mountain gap wind"@en ;
    rdfs:comment "A local wind blowing through a gap between mountains, a gap wind. This term was introduced by R. S. Scorer (1952) for the surface winds blowing through the Strait of Gibraltar. When air stratification is stable, as it usually is in summer, the air tends to flow through the gap from high to low pressure, emerging as a ?jet? with large standing eddies in the lee of the gap. The excess of pressure on the upwind side is attributed to a pool of cold air held up by the mountains. Similar winds occur at other gaps in mountain ranges, such as the tehuantepecer and the jochwinde, and in long channels, such as the Strait of Juan de Fuca between the Olympic Mountains of Washington and Vancouver Island, British Columbia. Compare jet-effect wind, canyon wind, mountain wind."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:MountainPlainWind a owl:Class ;
    rdfs:label "mountain plain wind"@en ;
    rdfs:comment "The diurnal cycle of local winds between a mountain or a mountain range and the adjacent or surrounding plains during periods of weak synoptic flow."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:MountainValleyWind a owl:Class ;
    rdfs:label "mountain valley wind"@en ;
    rdfs:comment "The diurnal cycle of local winds in a mountain valley during clear or mostly clear periods of weak synoptic flow."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:N_aschi a owl:Class ;
    rdfs:label "n aschi"@en ;
    rdfs:comment "The Arabic name for a northeasterly wind that ocurrs in winter on the Iranian coast of the Persian Gulf, especially near the entrance to the gulf and also on the Makran coast."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Narbonnais a owl:Class ;
    rdfs:label "narbonnais"@en ;
    rdfs:comment "(Also spelled narbon?.) In France, a wind coming from Narbonne; a north wind in the Roussillon region of southern France resembling the tramontana. If associated with an influx of arctic air, it may be very stormy with heavy falls of rain or snow. It is especially violent in the region of Perpignan where it blows in a succession of squalls for several days. In Provence it is rarer and blows from the west. In lower Languedoc and the southern C?vennes, the narbonnais is an infrequent, mild, moist, moderate southwest wind in winter and early spring, sometimes bringing thunderstorms."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:NightWind a owl:Class ;
    rdfs:label "night wind"@en ;
    rdfs:comment "Dry squalls that occur at night in southwest Africa and the Congo. It is likely that this term is loosely applied to other diurnal local winds such as mountain wind, land breeze, midnight wind, etc."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Nortada a owl:Class ;
    rdfs:label "nortada"@en ;
    rdfs:comment "A strong, persistent northerly wind in the Philippines."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Norte a owl:Class ;
    rdfs:label "norte"@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:NorthFoehn a owl:Class ;
    rdfs:label "north foehn"@en ;
    rdfs:comment "A northerly foehn wind blowing down the Italian side of the Alps. The northern slopes are normally cooler than the southern slopes, and the dynamic warming is often insufficient to overcome the difference of temperature. Hence a warm dry northerly wind of foehnlike character occurs less frequently than the south foehn."@en ;
    rdfs:subClassOf sophatmowm:Foehn .

sophatmowm:Northeaster a owl:Class ;
    rdfs:label "northeaster"@en ;
    rdfs:comment "A northeast wind, particularly a strong wind or gale."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Norther a owl:Class ;
    rdfs:label "norther"@en ;
    rdfs:comment "A northerly wind; in general, a cold windstorm from the north."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:Northwester a owl:Class ;
    rdfs:label "northwester"@en ;
    rdfs:comment "(Often contracted nor'wester.) A northwesterly wind (as Canterbury northwester)."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophatmowm:OutflowJet a owl:Class ;
    rdfs:label "outflow jet"@en ;
    rdfs:comment "Nocturnal cold-air jet flowing out of the mouth of a valley or canyon as it opens onto a plain."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorealf:Canyon ],
        [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorealf:Valley ],
        sophatmowm:MesoscaleWind .

sophatmowm:PlowWind a owl:Class ;
    rdfs:label "plow wind"@en ;
    rdfs:comment "Strong straight-line winds associated with nontornadic outflow from strong thunderstorms."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Thunderstorm ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmowm:MesoscaleWind .

sophatmowm:ThunderstormOutflow a owl:Class ;
    rdfs:label "thunderstorm outflow"@en ;
    rdfs:comment "The relatively cool pool of air that results when a thunderstorm downdraft reaches the earth's surface and spreads horizontally as a density current."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmopc:Thunderstorm ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmowm:MesoscaleWind .

sophatmowm:ValleyWind a owl:Class ;
    rdfs:label "valley wind"@en ;
    rdfs:comment "A wind that ascends a mountain valley (upvalley wind) during the day; the daytime component of a mountain?valley wind system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealf:Valley ;
            owl:onProperty sorel:hasRealm ],
        sophatmowm:MesoscaleWind .

sophatmowm:YellowWind a owl:Class ;
    rdfs:label "yellow wind"@en ;
    rdfs:comment "A strong, cold, dry, west wind of eastern Asia, especially northern China, that sweeps across the plains in winter carrying a fine yellow dust from the deserts."@en ;
    rdfs:subClassOf sophatmowm:DesertWind .

sophatmowm:Zephyr a owl:Class ;
    rdfs:label "zephyr"@en ;
    rdfs:comment "Any soft, gentle breeze."@en ;
    rdfs:subClassOf sophatmowm:MesoscaleWind .

sophb:Birth a owl:Class ;
    rdfs:label "birth"@en ;
    rdfs:subClassOf sophb:VitalActivity .

sophb:BirthDefect a owl:Class ;
    rdfs:label "birth defect"@en ;
    rdfs:subClassOf sophb:Disease .

sophb:Breathing a owl:Class ;
    rdfs:label "breathing"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Broncitis a owl:Class ;
    rdfs:label "broncitis"@en ;
    rdfs:subClassOf sophb:Disease .

sophb:CardiovascularDisease a owl:Class ;
    rdfs:label "cardiovascular disease"@en ;
    rdfs:subClassOf sophb:Disease .

sophb:Chemosynthesis a owl:Class ;
    rdfs:label "chemosynthesis"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Consumption a owl:Class ;
    rdfs:label "consumption"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Death a owl:Class ;
    rdfs:label "death"@en ;
    rdfs:subClassOf sophb:VitalActivity .

sophb:Decomposition a owl:Class ;
    rdfs:label "decomposition"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Denitrification a owl:Class ;
    rdfs:label "denitrification"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Epidemic a owl:Class ;
    rdfs:label "epidemic"@en ;
    rdfs:comment "In epidemiology, an epidemic is a classification of a disease that appears as new cases in a given human population, during a given period, at a rate that substantially exceeds what is expected based on recent experience (the number of new cases in the population during a specified period of time is called the incidence rate)."@en ;
    rdfs:subClassOf sophb:Disease .

sophb:Excretion a owl:Class ;
    rdfs:label "excretion"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Exposure a owl:Class ;
    rdfs:label "exposure"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Feeding a owl:Class ;
    rdfs:label "feeding"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Fertilization a owl:Class ;
    rdfs:label "fertilization"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Foraging a owl:Class ;
    rdfs:label "foraging"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Grazing a owl:Class ;
    rdfs:label "grazing"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Health a owl:Class ;
    rdfs:label "health"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Hearing a owl:Class ;
    rdfs:label "hearing"@en ;
    rdfs:subClassOf sophb:Sense .

sophb:Inhalation a owl:Class ;
    rdfs:label "inhalation"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Maintenance a owl:Class ;
    rdfs:label "maintenance"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:MetabolicPathway a owl:Class ;
    rdfs:label "metabolic pathway"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena,
        sorepmg:Path .

sophb:Nursing a owl:Class ;
    rdfs:label "nursing"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:OcularMelanoma a owl:Class ;
    rdfs:label "ocular melanoma"@en ;
    rdfs:subClassOf sophb:Cancer .

sophb:PlantStress a owl:Class ;
    rdfs:label "plant stress"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Pollination a owl:Class ;
    rdfs:label "pollination"@en ;
    rdfs:comment "Pollination is an important step in the reproduction of seed plants: the transfer of pollen grains (male gametes) to the plant carpel, the structure that contains the ovule (female gamete). The receptive part of the carpel is called a stigma in the flowers of angiosperms and a micropyle in gymnosperms. The study of pollination brings together many disciplines, such as botany, horticulture, entomology, and ecology. Pollination is important in horticulture because most plant fruits will not develop if the ovules are not fertilized. The pollination process as interaction between flower and vector was first addressed in the 18th century by Christian Konrad Sprengel."@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Respiration a owl:Class ;
    rdfs:label "respiration"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Spawning a owl:Class ;
    rdfs:label "spawning"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Survival a owl:Class ;
    rdfs:label "survival"@en ;
    rdfs:subClassOf sophb:VitalActivity .

sophb:Transpiration a owl:Class ;
    rdfs:label "transpiration"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Uptake a owl:Class ;
    rdfs:label "uptake"@en ;
    rdfs:subClassOf sophb:Assimilation .

sophb:Vision a owl:Class ;
    rdfs:label "vision"@en ;
    rdfs:subClassOf sophb:Sense .

sophb:Waste a owl:Class ;
    rdfs:label "waste"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophcr:Calving a owl:Class ;
    rdfs:label "calving"@en ;
    rdfs:subClassOf sophcr:GlacialProcess,
        soprocsc:Melting ;
    owl:equivalentClass sophcr:IceCalving .

sophcr:Englacial a owl:Class ;
    rdfs:label "englacial"@en ;
    rdfs:comment "Embedded in, carried by, or running through a glacier"@en,
        "This class is deprecated in favor of the URI EnglacialProcess"@en ;
    rdfs:seeAlso sophcr:EnglacialProcess ;
    owl:deprecated true .

sophcr:Glacial a owl:Class ;
    rdfs:label "glacial"@en ;
    owl:equivalentClass sophcr:Glaciation ;
    skos:definition [ dcterms:created "2020-04-09T10:14:10-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "An environmental process which involves glaciers or ice sheets."@en ] .

sophcr:Periglacial a owl:Class ;
    rdfs:label "periglacial"@en ;
    rdfs:seeAlso <https://github.com/ESIPFed/sweet/issues/185> ;
    rdfs:subClassOf sophcr:PhysicalProcess ;
    owl:disjointWith sophcr:GlacialProcess ;
    skos:definition [ dcterms:created "2020-04-09T10:24:28-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A frost action process which occurs in cold environments which are not part of a glacier."@en,
                "The conditions, processes and landforms associated with cold, nonglacial environments."@en ] ;
    skos:note "Subclass relation changed from Glacial Process to Physical Process because Periglacial involves frost action not associated with glacial processes"@en .

sophcr:Periglaciation a owl:Class ;
    rdfs:label "obsolete periglaciation"@en ;
    rdfs:seeAlso <https://github.com/ESIPFed/sweet/issues/185> ;
    rdfs:subClassOf soprocp:PhysicalProcess ;
    owl:deprecated true ;
    owl:disjointWith sophcr:GlacialProcess ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001659> ;
    skos:definition [ dcterms:created "2020-04-09T10:28:56-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "Processes associated with cold, nonglacial environments"@en ] ;
    skos:note "This is not a term found in any community thesaurus or dictionary i.e. GCMD, etc, or community of practice. Should be depricated in a future version of sweet. We consider it to be synonymous with glaciation in the ENVO crossreference"@en .

sophcr:Proglacial a owl:Class ;
    rdfs:label "proglacial"@en ;
    rdfs:comment "Of streams, deposits, and other features, being immediately in front of or just beyond the outer limits of a glacier or ice sheet, and formed by or derived from glacier ice."@en ;
    rdfs:subClassOf sophcr:GlacialProcess .

sophcr:Subglacial a owl:Class ;
    rdfs:label "subglacial"@en ;
    rdfs:comment "Pertaining to the area in or at the bottom of, or immediately beneath, a glacier."@en ;
    rdfs:subClassOf sophcr:GlacialProcess .

sophcr:Supraglacial a owl:Class ;
    rdfs:label "supraglacial"@en ;
    rdfs:subClassOf sophcr:GlacialProcess .

sophcy:AnnualCycle a owl:Class ;
    rdfs:label "annual cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sosttf:Annual ;
            owl:onProperty sorelt:hasFrequency ],
        sophcy:GlobalCycle .

sophcy:AntarcticOscillation a owl:Class ;
    rdfs:label "antarctic oscillation"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:ArcticOscillation a owl:Class ;
    rdfs:label "arctic oscillation"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:BodyTide a owl:Class ;
    rdfs:label "body tide"@en ;
    rdfs:subClassOf sophcy:Tide .

sophcy:ChandlerWobble a owl:Class ;
    rdfs:label "chandler wobble"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:DiurnalCycle a owl:Class ;
    rdfs:label "diurnal cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sosttf:Daily ;
            owl:onProperty sorelt:hasFrequency ],
        sophcy:GlobalCycle .

sophcy:MaddenJulianOscillation a owl:Class ;
    rdfs:label "madden julian oscillation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sosttf:Decadal ;
            owl:onProperty sorelt:hasFrequency ],
        sophcy:EarthOscillation .

sophcy:MilankovitchCycle a owl:Class ;
    rdfs:label "milankovitch cycle"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:PacificNorthAmericanPattern a owl:Class ;
    rdfs:label "pacific north american pattern"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:PolarWander a owl:Class ;
    rdfs:label "polar wander"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:PoleTide a owl:Class ;
    rdfs:label "pole tide"@en ;
    rdfs:subClassOf sophcy:Tide .

sophcy:QBO a owl:Class ;
    rdfs:label "qbo"@en ;
    owl:equivalentClass sophcy:QuasiBiennialOscillation .

sophcm:CarbonCycle a owl:Class ;
    rdfs:label "carbon cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somael:Carbon ;
            owl:onProperty sorelch:hasSubstance ],
        sophcm:BiogeochemicalCycle .

sophcm:HydrologicCycle a owl:Class ;
    rdfs:label "hydrologic cycle"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:Water ;
            owl:onProperty sorelch:hasSubstance ],
        sophcm:MaterialCycle ;
    owl:equivalentClass sophcm:HydrologicalCycle,
        sophcm:WaterCycle .

