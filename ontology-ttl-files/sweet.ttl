sostsy:Instability a owl:Class ;
    rdfs:label "instability"@en ;
    owl:equivalentClass sostsy:Unstable .

sostsy:Stochastic a sostsy:SystemState,
        owl:NamedIndividual ;
    rdfs:label "stochastic"@en .

sostsy:Unstable a owl:Class ;
    rdfs:label "unstable"@en ;
    rdfs:comment "property describing unstable conditions, such as in the atmosphere"@en ;
    rdfs:subClassOf sostsy:SystemState .

sostth:Cool a sopropo:TemperatureRange,
        owl:NamedIndividual ;
    rdfs:label "cool"@en ;
    sorelph:warmerThan sostth:Cold,
        sostth:FreezingCold .

sostth:DryAdiabatic a sostth:ThermodynamicState,
        owl:NamedIndividual ;
    rdfs:label "dry adiabatic"@en .

sostth:Superadiabatic a sostth:ThermodynamicState,
        owl:NamedIndividual ;
    rdfs:label "superadiabatic"@en .

sostti:Supereon a owl:Class ;
    rdfs:label "supereon"@en ;
    rdfs:comment "The largest defined unit of time is the supereon, composed of eons.] [Wikipedia]"@en ;
    rdfs:subClassOf sostti:GeologicTimeUnit .

sostti:day a owl:NamedIndividual .

sostti:hour a owl:NamedIndividual .

sostti:week a owl:NamedIndividual .

sosttc:HighTide a owl:Class ;
    rdfs:label "high tide"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:maximumOf ;
