    rdfs:label "potential density"@en ;
    sorelsp:hasDirection sorepsd:Down .

sorepscd:Pressure a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "pressure"@en .

sorepscd:PrimeMeridian a owl:Class ;
    rdfs:label "prime meridian"@en ;
    rdfs:subClassOf sorepscd:Meridian .

sorepscd:R a sorepscd:HorizontalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "r"@en .

sorepscd:RA a sorepscd:AngularCoordinate,
        owl:NamedIndividual ;
    rdfs:label "ra"@en ;
    owl:sameAs sorepscd:RightAscension .

sorepscd:S a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "s"@en .

sorepscd:Sigma a sorepscd:VerticalCoordinate,
        owl:NamedIndividual ;
    rdfs:label "sigma"@en .

