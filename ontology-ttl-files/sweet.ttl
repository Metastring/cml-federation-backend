    rdfs:label "lag"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsy:Loss a owl:Class ;
    rdfs:label "loss"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Replenishment a owl:Class ;
    rdfs:label "replenishment"@en ;
