    rdfs:subClassOf sorepm:Relation .

sorepm:Matrix a owl:Class ;
    rdfs:label "matrix"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorepm:Array ;
            owl:onProperty sorelm:eachElementHasType ],
        sorepm:Seq .

