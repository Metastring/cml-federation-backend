somarock:MetamorphicRock a owl:Class ;
    rdfs:label "metamorphic rock"@en ;
    rdfs:comment "One of the major groups of rock that makes up the crust of the Earth; consists of pre-existing rock mass in which new minerals or textures are formed at higher temperatures and greater pressures than those present on the Earth's surface [wicktionary]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophg:Metamorphic ;
            owl:onProperty sorelpr:hasGenesis ],
        somarock:Rock .

somarock:Meteor a owl:Class ;
    rdfs:label "meteor"@en ;
    rdfs:subClassOf somarock:Rock .

somarock:Meteorite a owl:Class ;
    rdfs:label "meteorite"@en ;
    rdfs:comment "Meteoric substances are rocks that have composition significantly different from earth rocks. Meteorites have traditionally been divided into three broad categories: stony meteorites are rocks, mainly composed of silicate minerals; iron meteorites are largely composed of metallic iron-nickel; and, stony-iron meteorites contain large amounts of both metallic and rocky material. [Wikipedia]"@en ;
    rdfs:subClassOf somarock:Meteor .

somarock:Molasse a owl:Class ;
    rdfs:label "molasse"@en ;
    rdfs:comment "Molasse refers to the sandstones, shales and conglomerates formed as terrestrial or shallow marine deposits in front of rising mountain chains deposited in a foreland basin, especially on top of flysch, for example that left from the rising Alps, or erosion in the Himalaya. These deposits are typically the non-marine alluvial and fluvial sediments of lowlands, as compared to deep-water flysch sediments. Sedimentation stops once the orogeny stops, or once the mountains have eroded flat. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:Sedimentary .

somarock:SedimentaryRock a owl:Class ;
    rdfs:label "sedimentary rock"@en ;
    rdfs:comment "One of the major groups of rock that makes up the crust of the Earth; formed by the deposition of either the weathered remains of other rocks, the results of biological activity, or precipitation from solution [wicktionary]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophg:Sedimentary ;
            owl:onProperty sorelpr:hasGenesis ],
        somarock:Rock .

somarock:Serpentinization a owl:Class ;
    rdfs:label "serpentinization"@en ;
    rdfs:subClassOf sophg:Metamorphic .

somarocki:Felsic a owl:Class ;
    rdfs:label "felsic"@en ;
    rdfs:comment "Felsic refers to silicate minerals, magma, and rocks which are enriched in the lighter elements such as silicon, oxygen, aluminium, sodium, and potassium. The term combines the words ‘feldspar’ and ‘silica.’ Felsic minerals are usually light in color and have specific gravities less than 3. Common felsic minerals include quartz, muscovite, orthoclase, and the sodium-rich plagioclase feldspars. The most common felsic rock is granite. On the opposite side of the rock spectrum are the iron and magnesium-rich mafic and ultramafic minerals and rocks. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IgneousRock ;
    owl:disjointWith somarocki:Mafic .

somarocki:Kimberlite a owl:Class ;
    rdfs:label "kimberlite"@en ;
    rdfs:comment "Kimberlite is a type of potassic volcanic rock best known for sometimes containing diamonds. The general consensus reached on kimberlites is that they are formed deep within the mantle, at between 150 and 450 kilometres depth, from anomalously enriched exotic mantle compositions, and are erupted rapidly and violently, often with considerable carbon dioxide and other volatile components.  [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:Mafic a owl:Class ;
    rdfs:label "mafic"@en ;
    rdfs:comment "Mafic is an adjective describing a silicate mineral or rock that is rich in magnesium and iron; the term was derived by contracting ‘magnesium’ and ‘ferric’. Most mafic minerals are dark in color and the specific gravity is greater than 3. Common rock-forming mafic minerals include olivine, pyroxene, amphibole, and biotite. Common mafic rocks include basalt and gabbro. In terms of chemistry, mafic rocks are on the other side of the rock spectrum from the felsic rocks. The term roughly corresponds to the older basic rock class.Mafic lava, before cooling, has a low viscosity, in comparison to felsic lava, due to the lower silica content in mafic magma. Water and other volatiles can more easily and gradually escape from mafic lava, so eruptions of volcanoes made of mafic lavas are less explosively violent than felsic lava eruptions. Most mafic lava volcanoes are oceanic volcanoes, like Hawaii. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IgneousRock .

somarocki:Magma a owl:Class ;
    rdfs:label "magma"@en ;
    rdfs:comment "Magma is molten rock that is found beneath the surface of the Earth.Magma is a complex high-temperature fluid substance in 3 phases; a system of silicate liquid, solid minerals, and perhaps a vapor phase. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somarocki:PlutonicRock a owl:Class ;
    rdfs:label "plutonic rock"@en .

somarocki:Pyroclastic a owl:Class ;
    rdfs:label "pyroclastic"@en ;
    rdfs:comment " A descriptive term, usually for rock, which results from explosive magma ejection [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:ExtrusiveRock,
        somarocki:VolcanicRock .

somas:Clay a owl:Class ;
    rdfs:label "clay"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Mud a owl:Class ;
    rdfs:label "mud"@en ;
    rdfs:subClassOf somas:Sediment .

somas:Mudflow a owl:Class ;
    rdfs:label "mudflow"@en ;
    rdfs:comment "A flowage of water-saturated earth material possessing a high degree of fluidity during movement. A less-saturated flowing mass is often called a debris flow. A mudflow originating on the flank of a volcano is properly called a lahar."@en ;
    rdfs:subClassOf somas:DebrisFlow .

somas:Peat a owl:Class ;
    rdfs:label "peat"@en ;
    rdfs:comment "Peat is an accumulation of partially decayed vegetation matter. Peat forms in wetlands or peatlands."@en ;
    rdfs:subClassOf somas:Sediment .

somas:Soil a owl:Class ;
    rdfs:label "soil"@en ;
    rdfs:subClassOf somas:Sediment .

somas:VolcanicDeposit a owl:Class ;
    rdfs:label "volcanic deposit"@en ;
    rdfs:comment "Volcanic deposits are molten rock (lava), solid rocks and ash which surround a volcano crater. [Wikipedia]"@en ;
    rdfs:subClassOf soma:Substance .

somaw:BrackishWater a owl:Class ;
    rdfs:label "brackish water"@en ;
    rdfs:comment "Brackish water is water that has more salinity than fresh water, but not as much as seawater. It may result from mixing of seawater with fresh water, as in estuaries, or it may occur in brackish fossil aquifers."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Brackish ;
            owl:onProperty sorel:hasState ],
        somaw:SaltWater .

somaw:FreshWater a owl:Class ;
    rdfs:label "fresh water"@en ;
    rdfs:subClassOf somaw:WaterSubstance ;
    owl:disjointWith somaw:SaltWater .

somaw:IceParticle a owl:Class ;
    rdfs:label "ice particle"@en .

somaw:SalineWater a owl:Class ;
    rdfs:label "saline water"@en ;
    rdfs:subClassOf somaw:SaltWater .

somaw:Steam a owl:Class ;
    rdfs:label "steam"@en ;
    owl:equivalentClass somaw:WaterVapor .

somaw:WaterVapor a owl:Class ;
    rdfs:label "water vapor"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorel:hasState ],
        somaw:WaterSubstance .

soph:AtmosphereLandExchange a owl:Class ;
    rdfs:label "atmosphere land exchange"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasSource ;
            owl:someValuesFrom sorea:Atmosphere ],
        [ a owl:Restriction ;
            owl:onProperty sorelsc:hasSource ;
            owl:someValuesFrom sorea:Land ],
        soph:Phenomena,
        sophsy:Exchange .

soph:AtmosphereOceanExchange a owl:Class ;
    rdfs:label "atmosphere ocean exchange"@en .

soph:Occurrence a owl:Class ;
    rdfs:label "occurrence"@en .

soph:RadiativeCooling a owl:Class ;
    rdfs:label "radiative cooling"@en ;
    rdfs:comment "In meteorology, the result of radiative cooling of the earth's surface and adjacent air.  Radiational cooling occurs, as is typical on calm, clear nights"@en ;
    rdfs:subClassOf soprocp:Cooling,
        sopropef:RadiativeForcing ;
    owl:disjointWith soph:RadiativeHeating .

soph:StochasticProcess a owl:Class ;
    rdfs:label "stochastic process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsy:Stochastic ;
            owl:onProperty sorel:hasState ],
        soph:DynamicalPhenomena .

sophatmo:AtmosphericDisturbance a owl:Class ;
    rdfs:label "atmospheric disturbance"@en ;
    rdfs:subClassOf sophatmo:AtmosphericWave .

sophatmo:NocturnalCooling a owl:Class ;
    rdfs:label "nocturnal cooling"@en ;
    rdfs:comment "The lowering of temperature during night time, due to a net loss of radiant energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreptd:Nocturnal ;
            owl:onProperty sorelt:hasTime ],
        soph:RadiationalCooling .

sophatmo:Obscuration a owl:Class ;
    rdfs:label "obscuration"@en ;
    rdfs:subClassOf sophatmofo:Fog .

sophatmo:Weather a owl:Class ;
    rdfs:label "weather"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena ;
    owl:equivalentClass sophatmo:WeatherCondition .

sophatmoc:AnvilCloud a owl:Class ;
    rdfs:label "anvil cloud"@en ;
    rdfs:comment "The anvil-shaped cloud that comprises the upper portion of mature cumulonimbus clouds"@en,
        "a type of cloud"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmoc:Cumulonimbus ;
            owl:onProperty sorelsp:upperPartOf ],
        sophatmoc:Cloud .

sophatmoc:FoehnWall a owl:Class ;
    rdfs:label "foehn wall"@en ;
    rdfs:comment "The leeward edge of the orographic stratiform cap cloud as seen from the lee side of a mountain barrier, preceding or during a foehn or chinook event. The edge is generally abrupt and resembles a wall of cloud (?foehnwand? in German). This cloud often signifies the occurrence of orographic precipitation, especially snowfall in the cold season, over the peaks. See foehn cloud."@en .

sophatmoc:LenticularCloud a owl:Class ;
    rdfs:label "lenticular cloud"@en ;
    rdfs:comment "A commonly used term for clouds of the species lenticularis."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmoc:Moazagotl a owl:Class ;
    rdfs:label "moazagotl"@en ;
    rdfs:comment "A stationary bank of cirriform cloud marking the upper portion of the system of lenticular clouds formed in the lee wave produced by flow across the Sudeten Mountains in southeastern Germany; a type of foehn cloud."@en ;
    rdfs:subClassOf sophatmoc:LenticularCloud .

sophatmoc:NoctilucentCloud a owl:Class ;
    rdfs:label "noctilucent cloud"@en ;
    dcterms:contributor <https://orcid.org/0000-0002-0337-8610> ;
    rdfs:comment "(Rarely called luminous clouds.) Thin silvery-blue cirrus-like clouds frequently seen during summer twilight conditions at high latitudes (above 50?) in both hemispheres. They are the highest visible clouds in the atmosphere, occurring in the upper mesosphere at heights of about 85 km, and are closely related to the polar mesospheric clouds seen in satellite observations at similar altitudes over the summer polar cap. Noctilucent clouds are now known to consist of tiny ice particles with dimensions of the order of tens of nanometers, growing in the extreme cold of the summer polar mesopause region. The condensation nuclei on which the particles grow are thought to be either smoke and dust particles of meteoric origin or large hydrated positive ions. Strong upwelling of air from below, associated with a pole-to-pole meridional circulation in the upper mesosphere, is responsible for both the extreme cold and the upward flux of water vapor. Although water-vapor mixing ratios are very low (less than 10 parts per million by volume) in the region, the temperatures are also low enough to produce a high degree of supersaturation at times. Anomalously strong radar echoes from the region, known as polar summer mesospheric echoes, are also associated with the clouds. Compare nacreous clouds, polar stratospheric clouds."@en ;
    rdfs:subClassOf sophatmoc:Cloud .

sophatmofo:MountainFog a owl:Class ;
    rdfs:label "mountain fog"@en ;
    rdfs:comment "Fog formed by orographic lifting to condensation of moist air up a mountain slope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasRealm ;
            owl:someValuesFrom sorealo:Mountain ],
        sophatmofo:Fog ;
    owl:equivalentClass sophatmofo:OrographicFog .

sophatmofo:OrographicFog a owl:Class ;
    rdfs:label "orographic fog"@en .

sophatmofo:Smog a owl:Class ;
    rdfs:label "smog"@en ;
    rdfs:comment "A natural fog contaminated by industrial pollutants, a mixture of smoke and fog."@en ;
    rdfs:subClassOf sophatmofo:Fog .

sophatmofr:FrontRegion a owl:Class ;
    rdfs:label "front region"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophatmofr:Front ;
            owl:onProperty sorelsc:componentOf ],
        sophatmo:MeteorologicalPhenomena .

sophatmofr:WarmFront a owl:Class ;
    rdfs:label "warm front"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Heating ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmofr:Front .

<http://sweetontology.net/phenAtmoLightning> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Lightning" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/phenAtmoPrecipitation>,
        <http://sweetontology.net/phenWave>,
        <http://sweetontology.net/propCharge>,
        <http://sweetontology.net/rela> ;
    owl:versionInfo "3.6.0" .

sophatmol:Thunder a owl:Class ;
    rdfs:label "thunder"@en ;
    rdfs:comment "The sound emitted by rapidly expanding gases along the channel of a lightning discharge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophw:Sound ;
            owl:onProperty sorel:hasPhenomena ],
        sophatmo:MeteorologicalPhenomena .

sophatmopc:Hail a owl:Class ;
    rdfs:label "hail"@en ;
    rdfs:comment "Precipitation in the form of balls or irregular lumps of ice, always produced by convective clouds, nearly always cumulonimbus. An individual unit of hail is called a hailstone. By convention, hail has a diameter of 5 mm or more, while smaller particles of similar origin, formerly called small hail, may be classed as either ice pellets or snow pellets. Thunderstorms that are characterized by strong updrafts, large liquid water contents, large cloud-drop sizes, and great vertical height are favorable to hail formation. The destructive effects of hailstorms upon plant and animal life, buildings and property, and aircraft in flight render them a prime object of weather modification studies. In aviation weather observations, hail is encoded A."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaw:Ice ;
            owl:onProperty sorelch:hasSubstance ],
        [ a owl:Restriction ;
            owl:hasValue sostri:Heavy ;
            owl:onProperty sorelsc:hasImpact ],
        sophatmopc:AtmosphericPrecipitation .

sophatmopc:HeavySnowfall a owl:Class ;
    rdfs:label "heavy snowfall"@en ;
    rdfs:subClassOf sophatmopc:Snowfall .

sophatmopc:LakeEffect a owl:Class ;
    rdfs:label "lake effect"@en ;
    rdfs:comment "Generally, the effect of any lake in modifying the weather about its shore and for some distance downwind. This term is applied specifically to the region about the Great Lakes or the Great Salt Lake. More specifically, lake effect often refers to the generation of sometimes spectacular snowfall amounts to the lee of the Great Lakes as cold air passes over the lake surface, extracting heat and moisture, resulting in cloud formation and snowfall downwind of the lake shore."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreahb:Lake ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmo:MeteorologicalPhenomena .

sophatmopc:LakeEffectSnowstorm a owl:Class ;
    rdfs:label "lake effect snowstorm"@en .

sophatmopc:Sleet a owl:Class ;
    rdfs:label "sleet"@en ;
    rdfs:subClassOf somaw:Ice,
        sophatmopc:AtmosphericPrecipitation .

sophatmopc:SplittingConvectiveStorm a owl:Class ;
    rdfs:label "splitting convective storm"@en ;
    rdfs:comment "The process by which a single convective cell splits into two supercells, one dominated by cyclonic rotation and the other by anticyclonic rotation, their paths then deviating substantially from each other and other nearby convective cells."@en ;
    rdfs:subClassOf sophatmopc:Storm .

sophatmopc:SquallLine a owl:Class ;
    rdfs:label "squall line"@en ;
    rdfs:comment "A line of active thunderstorms, either continuous or with breaks, including contiguous precipitation areas resulting from the existence of the thunderstorms."@en ;
    rdfs:subClassOf sophatmopc:Thunderstorm .

sophatmops:AtmosphericHighPressure a owl:Class ;
    rdfs:label "atmospheric high pressure"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:HighPressure .

sophatmops:AtmosphericRidge a owl:Class ;
    rdfs:label "atmospheric ridge"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:Ridge .

sophatmops:AtmosphericTrough a owl:Class ;
    rdfs:label "atmospheric trough"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena,
        sophfd:Trough .

sophatmops:Cyclogenesis a owl:Class ;
    rdfs:label "cyclogenesis"@en ;
    rdfs:comment "A physical process at the initial stage of cyclone life cycle"@en ;
    rdfs:subClassOf sophatmo:MeteorologicalPhenomena .

sophatmops:MesoscaleConvectiveSystem a owl:Class ;
    rdfs:label "mesoscale convective system"@en ;
    rdfs:comment "A cloud system that occurs in connection with an ensemble of thunderstorms and produces a contiguous precipitation area on the order of 100 km or more in horizontal scale in at least one direction. An MCS exhibits deep, moist convective overturning contiguous with or embedded within a mesoscale vertical circulation that is at least partially driven by the convective overturning."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostss:Mesoscale ;
            owl:onProperty sorelsp:hasSpatialScale ],
        sophatmopc:Storm .

sophatmops:TropicalUpperTroposphericTrough a owl:Class ;
    rdfs:label "tropical upper tropospheric trough"@en ;
    rdfs:subClassOf sophatmops:TropicalCyclone .

sophatmos:AirQuality a owl:Class ;
    rdfs:label "air quality"@en ;
    rdfs:subClassOf sophatmos:AirPollution .

sophatmos:MagneticSubstorm a owl:Class ;
    rdfs:label "magnetic substorm"@en .

sophatmos:Obscuration a owl:Class ;
    rdfs:label "obscuration"@en ;
    rdfs:subClassOf sophatmofo:Fog .

sophatmos:OzoneHole a owl:Class ;
    rdfs:label "ozone hole"@en ;
    rdfs:subClassOf sophatmos:AirPollution .

<http://sweetontology.net/phenAtmoTransport> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Transport" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenAtmoFog>,
        <http://sweetontology.net/phenFluidTransport>,
        <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/realmAtmoBoundaryLayer>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/stateChemical> ;
    owl:versionInfo "3.6.0" .

sophatmot:AcidHaze a owl:Class ;
    rdfs:label "acid haze"@en .

sophatmot:Washout a owl:Class ;
    rdfs:label "washout"@en .

sophatmow:DustStorm a owl:Class ;
    rdfs:label "dust storm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somaae:Dust ;
            owl:onProperty sorelch:hasSubstance ],
        sophatmow:LocalWind .

sophatmow:EasterlyWind a owl:Class ;
    rdfs:label "easterly wind"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:JetStreamWind a owl:Class ;
    rdfs:label "jet stream wind"@en .

sophatmow:LocalWind a owl:Class ;
    rdfs:label "local wind"@en ;
    rdfs:comment "1. Winds that, over a small area, differ from those that would be appropriate to the general large-scale pressure distribution, or that possess some other peculiarity. Often these winds have names unique to the area where they occur. Local winds may be classified into three main groups. The first includes diurnally varying airflows that are driven by local gradients of surface heat flux (e.g., near the shore of a sea or lake) or by diurnal heating or cooling of the ground surface in areas of sloping or mountainous terrain. These include land and sea breezes, mountain?valley circulations, and drainage and slope winds. The second group consists of winds produced by the interaction of a synoptic-scale flow with orography. These may be further subdivided into barrier jets, gap winds, downslope windstorms, and include such local phenomena as the tehuantepecer, Santa Ana, foehn, mistral, and bora. The third group includes those winds accompanying convective activity, more specifically individual thunderstorms or mesoscale convective systems. These are generally the surface manifestations of precipitation- cooled diverging outflow and in some locations are given special names due to the distinctive character of the weather associated with them (e.g., the haboob). 2. Local or colloquial names given to frequently occurring or particularly noteworthy winds (sometimes because of the bad weather associated with them), usually from a certain direction. Often these names reflect the direction from which the wind comes (e.g., sou'wester, nor'easter)."@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:WalkerCirculation a owl:Class ;
    rdfs:label "walker circulation"@en ;
    rdfs:comment "A zonal circulation of the atmosphere confined to equatorial regions and driven principally by the oceanic temperature gradient. In the Pacific, air flows westward from the colder, eastern area to the warm, western ocean, where it acquires warmth and moisture and subsequently rises. A return flow aloft and subsidence over the eastern ocean complete the cell"@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmow:WindGust a owl:Class ;
    rdfs:label "wind gust"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:WindStorm a owl:Class ;
    rdfs:label "wind storm"@en ;
    rdfs:subClassOf sophatmow:Wind .

sophatmow:ZonalFlow a owl:Class ;
    rdfs:label "zonal flow"@en ;
    rdfs:comment "In meteorology, the flow of air along a latitude circle; more specifically, the latitudinal (east or west) component of existing flow."@en ;
    rdfs:subClassOf sophatmow:GlobalWindCirculation .

sophatmowm:DownslopeWind a owl:Class ;
    rdfs:label "downslope wind"@en ;
    rdfs:comment "A wind directed down a slope, often used to describe winds produced by processes larger in scale than the slope."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:FallWind a owl:Class ;
    rdfs:label "fall wind"@en ;
    rdfs:comment "A wind that accelerates as it moves downslope because of its low temperature and greater density."@en ;
    rdfs:subClassOf sophatmowm:KatabaticWind,
        sophatmowm:MountainWind .

sophatmowm:GravityWind a owl:Class ;
    rdfs:label "gravity wind"@en ;
    rdfs:comment "A wind resulting from cold air running or flowing down a slope, caused by greater air density near the slope than at the same altitude some distance horizontally from the slope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Gravity ;
            owl:onProperty sorel:hasProcess ],
        sophatmowm:MountainWind .

sophatmowm:KatabaticWind a owl:Class ;
    rdfs:label "katabatic wind"@en ;
    rdfs:comment "Most widely used in mountain meteorology to denote a downslope flow driven by cooling at the slope surface during periods of light larger-scale winds; the nocturnal component of the along-slope wind systems."@en ;
    rdfs:subClassOf sophatmowm:MountainWind .

sophatmowm:LandBreeze a owl:Class ;
    rdfs:label "land breeze"@en ;
    rdfs:comment "A coastal breeze blowing from land to sea, caused by the temperature difference when the sea surface is warmer than the adjacent land. Therefore, it usually blows by night and alternates with sea breeze, which blows in the opposite direction by day. See puelche, karif."@en ;
    rdfs:subClassOf sophatmowm:OffshoreWind .

sophatmowm:MackerelGale a owl:Class ;
    rdfs:label "mackerel gale"@en ;
    rdfs:comment "Same as a mackerel breeze"@en .

sophatmowm:OffshoreWind a owl:Class ;
    rdfs:label "offshore wind"@en ;
    rdfs:comment "Wind blowing from land to sea.  During synoptic conditions of light winds, offshore winds near the surface often occur at night as a component of the land breeze."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Land ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmowm:MesoscaleWind .

sophatmowm:OnshoreWind a owl:Class ;
    rdfs:label "onshore wind"@en ;
    rdfs:comment "A wind blowing from water onto land; the wind may be a result of heating differences between land and water or related to synoptic weather patterns."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Ocean ;
            owl:onProperty sorelsp:originatesFrom ],
        sophatmowm:MesoscaleWind .

sophatmowm:UpslopeWind a owl:Class ;
    rdfs:label "upslope wind"@en ;
    rdfs:comment "A wind directed up a slope, often used to describe winds produced by processes larger in scale than the slope."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Upslope ;
            owl:onProperty sorelsp:hasDirection ],
        sophatmowm:MountainWind .

sophb:Assimilation a owl:Class ;
    rdfs:label "assimilation"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:BiologicalActivity a owl:Class ;
    rdfs:label "biological activity"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

sophb:Cancer a owl:Class ;
    rdfs:label "cancer"@en ;
    rdfs:subClassOf sophb:Disease .

sophb:Photosynthesis a owl:Class ;
    rdfs:label "photosynthesis"@en ;
    rdfs:subClassOf sophb:BiologicalPhenomena .

<http://sweetontology.net/phenCryo> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Cryosphere" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/procStateChange> ;
    owl:versionInfo "3.6.0" .

sophcr:Accumulation a owl:Class ;
    rdfs:label "accumulation"@en ;
    rdfs:subClassOf sophcr:GlacialProcess,
        sophsy:Accumulation .

sophcr:EnglacialProcess a owl:Class ;
    rdfs:label "englacial process"@en ;
    rdfs:subClassOf sophcr:GlacialProcess ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001622> ;
    skos:definition [ dcterms:created "2020-04-09T10:12:52-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "A positional quality inhering in a bearer by virtue of the bearer being located within a glacier or ice sheet, between their summer surface or bed."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001622> ] .

sophcr:Glaciation a owl:Class ;
    rdfs:label "glaciation"@en ;
    rdfs:seeAlso <https://github.com/ESIPFed/sweet/issues/185> ;
    rdfs:subClassOf sophcr:Accumulation ;
    owl:disjointWith sophcr:GlacierRetreat ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_03000029> ;
    skos:definition [ dcterms:created "2020-04-09T10:17:32-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "The process of glacier ice gain."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_03000029> ] .

sophcr:GlacierRetreat a owl:Class ;
    rdfs:label "glacier retreat"@en ;
    rdfs:seeAlso <https://github.com/ESIPFed/sweet/issues/185> ;
    rdfs:subClassOf sophcr:GlacialProcess ;
    skos:closeMatch <http://purl.obolibrary.org/obo/ENVO_01001656> ;
    skos:definition [ dcterms:created "2020-04-09T10:20:12-08:00"^^xsd:dateTimeStamp ;
            dcterms:creator <https://orcid.org/0000-0003-4091-6059> ;
            dcterms:source <https://orcid.org/0000-0003-4808-4736> ;
            rdfs:comment "The process of glacier ice loss."@en ;
            prov:wasDerivedFrom <http://purl.obolibrary.org/obo/ENVO_01001656> ] .

sophcr:IceCalving a owl:Class ;
    rdfs:label "ice calving"@en .

sophcy:ElNinoSouthernOscillation a owl:Class ;
    rdfs:label "el nino southern oscillation"@en ;
    rdfs:comment "A significant increase in sea surface temperature over the eastern and central equatorial Pacific that occurs at irregular intervals, generally ranging between two and seven years."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Ocean ;
            owl:onProperty sorel:hasRealm ],
        sophcy:EarthOscillation .

sophcy:NAO a owl:Class ;
    rdfs:label "nao"@en ;
    owl:equivalentClass sophcy:NorthAtlanticOscillation .

sophcy:NorthAtlanticOscillation a owl:Class ;
    rdfs:label "north atlantic oscillation"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:PDO a owl:Class ;
    rdfs:label "pdo"@en ;
    owl:equivalentClass sophcy:PacificDecadalOscillation .

sophcy:PacificDecadalOscillation a owl:Class ;
    rdfs:label "pacific decadal oscillation"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

sophcy:QuasiBiennialOscillation a owl:Class ;
    rdfs:label "quasi biennial oscillation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sosttf:Biannual ;
            owl:onProperty sorelt:hasFrequency ],
        sophcy:EarthOscillation .

sophcy:SouthernOscillation a owl:Class ;
    rdfs:label "southern oscillation"@en ;
    rdfs:subClassOf sophcy:EarthOscillation .

<http://sweetontology.net/phenCycleMaterial> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Cycle Material" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrCompound>,
        <http://sweetontology.net/matrElement>,
        <http://sweetontology.net/phenEcology>,
        <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/reprMathGraph> ;
    owl:versionInfo "3.6.0" .

sophcm:HydrologicalCycle a owl:Class ;
    rdfs:label "hydrological cycle"@en .

sophcm:WaterCycle a owl:Class ;
    rdfs:label "water cycle"@en .

sophec:Predation a owl:Class ;
    rdfs:label "predation"@en ;
    rdfs:subClassOf sophec:EcologicalDynamics .

sophen:EnergyCollection a owl:Class ;
    rdfs:label "energy collection"@en ;
    rdfs:subClassOf sophen:EnergyForm .

sophen:Geothermal a owl:Class ;
    rdfs:label "geothermal"@en ;
    rdfs:subClassOf sophen:RenewableEnergySource .

sophei:AirQuality a owl:Class ;
    rdfs:label "air quality"@en ;
    rdfs:subClassOf sophei:AirPollution .

sophei:Extinction a owl:Class ;
    rdfs:label "extinction"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact ;
    owl:equivalentClass sophei:SpeciesExtinction .

sophei:HabitatConversion a owl:Class ;
    rdfs:label "habitat conversion"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelsc:hasImpactOn ;
            owl:someValuesFrom sostrb:Habitat ],
        sophei:EnvironmentalImpact .

sophei:OzoneHole a owl:Class ;
    rdfs:label "ozone hole"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somaem:Ozone ;
            owl:onProperty sorelsc:decrease ],
        sophei:AirPollution .

sophei:SaltWaterIntrusion a owl:Class ;
    rdfs:label "salt water intrusion"@en ;
    rdfs:comment "The movement of salt water into fresh water aquifers."@en ;
    rdfs:subClassOf sophei:WaterPollution .

sophei:SpeciesExtinction a owl:Class ;
    rdfs:label "species extinction"@en .

sophei:Spill a owl:Class ;
    rdfs:label "spill"@en ;
    rdfs:subClassOf sophei:EnvironmentalImpact .

sophfd:Anticyclone a owl:Class ;
    rdfs:label "anticyclone"@en ;
    rdfs:comment "An atmospheric anticyclonic circulation, a closed circulation. The wind in an anticyclone is in the clockwise direction in the Northern Hemisphere and counterclockwise in the Southern Hemisphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasState ;
            owl:someValuesFrom sophfd:HighPressure ],
        sophfd:Cell .

sophfd:BoundaryLayer a owl:Class ;
    rdfs:label "boundary layer"@en ;
    rdfs:subClassOf sorepsg:Region .

sophfd:CapillaryAction a owl:Class ;
    rdfs:label "capillary action"@en ;
    rdfs:subClassOf sophfd:FluidPhenomena .

sophfd:Gyre a owl:Class ;
    rdfs:label "gyre"@en ;
    rdfs:subClassOf sophfd:Cell .

sophfd:Jet a owl:Class ;
    rdfs:label "jet"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropp:Pressure ;
            owl:onProperty sorelsc:hasQuantity ],
        sophfd:Flow .

sophfd:LaminarBoundaryLayer a owl:Class ;
    rdfs:label "laminar boundary layer"@en ;
    rdfs:comment "An interfacial region in which flow is smooth and nonturbulent. Above a surface, a laminar layer will develop and fluid velocity will increase with distance from the surface, but not indefinitely. At some point, flow will become turbulent, with the laminar sublayer separating the turbulent layer from the surface. In the real world, most laminar boundary layers are extremely thin (order of 1 mm), but can be of biological importance, for example, next to plant leaves or as invertebrate refuges in streams."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophfd:LaminarFlow ;
            owl:onProperty sorel:hasPhenomena ],
        sophfd:BoundaryLayer .

sophfd:LaminarFlow a owl:Class ;
    rdfs:label "laminar flow"@en ;
    rdfs:comment "(Also called sheet flow, streamline flow.) A flow regime in which fluid motion is smooth and orderly, and in which adjacent layers or laminas slip past each other with little mixing between them. Exchange of material across laminar layers occurs by molecular diffusion, a process about 106 times less effective than turbulence. Laminar flow can be easily predicted as velocity increases at a steady rate from a boundary. This contrasts with the chaotic and random nature of turbulent flow. Laminar flow is not a common occurrence in the statically neutral and unstable atmosphere and is confined to a very thin layer (1 mm) adjacent to very smooth surfaces such as snow and ice. However, in strongly statically stable regions such as the the nocturnal boundary layer, the Richardson number can be large enough that turbulence is suppressed, and the flow is laminar over a layer many tens of meters thick."@en ;
    rdfs:subClassOf sophfd:Flow .

sophfd:Trough a owl:Class ;
    rdfs:label "trough"@en ;
    rdfs:comment "In meteorology, an elongated area of relatively low atmospheric pressure; the opposite of a ridge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasState ;
            owl:someValuesFrom sophfd:LowPressure ],
        sorepsg:Trough .

sophfi:FreeInstability a owl:Class ;
    rdfs:label "free instability"@en ;
    rdfs:comment "The state of a layer of unsaturated air when its lapse rate of temperature is less than the dry-adiabatic lapse rate but greater than the moist-adiabatic lapse rate."@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophft:Buoyancy a owl:Class ;
    rdfs:label "buoyancy"@en ;
    rdfs:comment "That property of an object that enables it to float on the surface of a liquid, or ascend through and remain freely suspended in a compressible fluid such as the atmosphere."@en ;
    rdfs:subClassOf soph:Phenomena .

sophft:Deposition a owl:Class ;
    rdfs:label "deposition"@en ;
    rdfs:comment "Phenomena by which traces gases or particles are transferred from atmosphere to a surface."@en ;
    rdfs:subClassOf soph:Phenomena .

sophft:HemisphericTransportOfAirPollutants a owl:Class ;
    rdfs:label "hemispheric transport of air pollutants"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasPhenomena ;
            owl:someValuesFrom sophei:AirPollution ],
        sophft:Transport .

sophg:Igneous a owl:Class ;
    rdfs:label "igneous"@en ;
    rdfs:comment "One of 3 processes in the Rock Cycle. Igneous refers to the process whereby hot material from the mantle is squeezed upward toward the earth's surface. If it has not reached the surface then the material is described as an intrusive structure and the rocks it creates are called Intrusive Rock. If it extrudes from the surface the material is described as a volcano and the rock it creates is known as Extrusive Rock. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:RockCycleProcess .

sophg:OrogenicCollapse a owl:Class ;
    rdfs:label "orogenic collapse"@en ;
    rdfs:comment " The process in which mountains begin to collapse under their own weight and spread out laterally."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreagor:Orogen ;
            owl:onProperty sorel:hasRealm ],
        [ a owl:Restriction ;
            owl:allValuesFrom somarocki:AnorogenicIgneousRock ;
            owl:onProperty sorelch:hasSubstance ],
        [ a owl:Restriction ;
            owl:allValuesFrom soreagb:SuccessorBasin ;
            owl:onProperty sorelph:hasPlanetaryStructure ],
        sophgt:TectonicPhenomena .

sophg:Orogeny a owl:Class ;
    rdfs:label "orogeny"@en ;
    rdfs:comment "Orogeny refers to natural mountain building, and may be studied as (a) a tectonic structural event, (b) as a geographical event, and (c) a chronological event. Orogenic events (a) cause distinctive structural phenomena and related tectonic activity, (b) affect certain regions of rocks and crust, and (c) happen within a specific period of time. [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophg:RockCycle a owl:Class ;
    rdfs:label "rock cycle"@en ;
    rdfs:comment "The rock cycle is a fundamental concept that describes the dynamic transitions through geologic time among the three main rock types: sedimentary, metamorphic, and igneous. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena,
        sorepmg:Cycle ;
    owl:equivalentClass sophg:RockCycleProcess .

<http://sweetontology.net/phenGeolFault> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Geologic Fault" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/phenGeol>,
        <http://sweetontology.net/phenGeolTectonic>,
        <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/propSpaceDirection>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/reprSpaceDirection> ;
    owl:versionInfo "3.6.0" .

sophgf:DipSeparationSense a owl:Class ;
    rdfs:label "dip separation sense"@en ;
    rdfs:comment "A fault along which there is some separation parallel to the dip of the fault."@en ;
    rdfs:subClassOf sophgf:Slip .

sophgf:Horizontal a owl:Class ;
    rdfs:label "horizontal"@en ;
    rdfs:comment "The fault is horizontal"@en ;
    rdfs:subClassOf sophgf:Slip .

sophgf:Normal a owl:Class ;
    rdfs:label "normal"@en ;
    rdfs:comment "The hanging wall appears to have moved down relative to the footwall; dip of fault usually 45-90 degrees."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgf:StrikeSeparationSense a owl:Class ;
    rdfs:label "strike separation sense"@en ;
    rdfs:comment "A fault along which there is some separation parallel to the strike of the fault."@en ;
    rdfs:subClassOf sophgf:Slip .

sophgf:Thrust a owl:Class ;
    rdfs:label "thrust"@en ;
    rdfs:comment "Reverse fault with dip typically less than 45 degrees; horizontal compression, rather than vertical displacement is characteristic."@en ;
    rdfs:subClassOf sophgt:TectonicProcess .

sophgg:Avalanche a owl:Class ;
    rdfs:label "avalanche"@en ;
    rdfs:comment " A mass of snow, ice or rocks moving rapidly down a steep mountain slope. Avalanches may be characterized as loose and turbulent, or slab; either type may be dry or wet according to the nature of the snow forming it, although dry snow usually forms loose avalanches and wet snow forms slabs. A large avalanche sweeps a current of air along with and in front of it as an avalanche wind, which supplements its already tremendous destructive force."@en ;
    rdfs:subClassOf sophgg:Slide,
        sophsyc:Collapse .

sophgg:Karst a owl:Class ;
    rdfs:label "karst"@en ;
    rdfs:comment "Karst topography is a landscape shaped by the dissolution of a layer or layers of soluble bedrock, usually carbonate rock such as limestone or dolomite. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena .

sophgg:Reptation a owl:Class ;
    rdfs:label "reptation"@en .

sophgs:Foreshock a owl:Class ;
    rdfs:label "foreshock"@en ;
    rdfs:subClassOf sophgs:Earthquake .

sophgs:Lwave a owl:Class ;
    rdfs:label "lwave"@en .

sophgs:PrimaryWave a owl:Class ;
    rdfs:label "primary wave"@en .

sophgs:SecondaryWave a owl:Class ;
    rdfs:label "secondary wave"@en .

sophgs:ShallowFocusEarthquake a owl:Class ;
    rdfs:label "shallow focus earthquake"@en ;
    rdfs:subClassOf sophgs:Earthquake .

sophgt:IsostaticRebound a owl:Class ;
    rdfs:label "isostatic rebound"@en ;
    rdfs:comment "Post-glacial rebound (sometimes called continental rebound, isostatic rebound, isostatic adjustment or post-ice-age isostatic recovery) is the rise of land masses that were depressed by the huge weight of ice sheets during the last glacial period, through a process known as isostatic depression. [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:PlateDivergence a owl:Class ;
    rdfs:label "plate divergence"@en ;
    rdfs:comment "Plate divergence is the phenomena of plates drifting apart [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicPhenomena .

sophgt:TectonicAssemblage a owl:Class ;
    rdfs:label "tectonic assemblage"@en ;
    rdfs:comment "A tectonic ssemblage is a geological term for an accreted terrane of heterogeneous rocks. [Wikipedia]"@en ;
    rdfs:subClassOf soreag:GeologicFeature .

sophgt:Terrane a owl:Class ;
    rdfs:label "terrane"@en ;
    rdfs:comment "A terrane in geology is a fragment of crustal material formed on, or broken off from, one tectonic plate and accreted — ‘sutured’ — to crust lying on another plate.  [Wikipedia]"@en ;
    rdfs:subClassOf sophgt:TectonicAssemblage .

sophgv:MantleThermalPlume a owl:Class ;
    rdfs:label "mantle thermal plume"@en .

sophgv:PeleeanEruption a owl:Class ;
    rdfs:label "peleean eruption"@en ;
    rdfs:comment "In a Peléan eruption or nuée ardente (glowing cloud) eruptions a large amount of gas, dust, ash, and lava fragments are blown out of a central crater, fall back, and form avalanches that move downslope at speeds as great as 160 km per hour. These eruptions are usually associated with silicic magmas. A name for some pyroclastic flows is nuée ardente (French for ‘glowing cloud’); this was first used to describe the disastrous 1902 eruption of Mount Pelée on Martinique.[3] These pyroclastic flows glowed red in the dark. [Wikipedia]"@en ;
    rdfs:subClassOf sophgv:VolcanicEruption .

sophgv:SteamBlastEruption a owl:Class ;
    rdfs:label "steam blast eruption"@en ;
    rdfs:comment "A series of hundreds of steam explosions preceding an eruption of the volcano A less intense geothermal event may result in a mud volcano. In 1949, Thomas Jaggar described this kind of activity as steam-blast eruptions. [Wikipedia]"@en .

sophgv:Volcanism a owl:Class ;
    rdfs:label "volcanism"@en ;
    rdfs:subClassOf sophg:GeologicalPhenomena ;
    owl:equivalentClass sophgv:Vulcanism .

sophgv:Vulcanism a owl:Class ;
    rdfs:label "vulcanism"@en .

<http://sweetontology.net/phenHelio> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Heliosphere" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrParticle>,
        <http://sweetontology.net/phen>,
        <http://sweetontology.net/phenStar>,
        <http://sweetontology.net/phenSystem>,
        <http://sweetontology.net/procPhysical>,
        <http://sweetontology.net/procWave>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/relaSci> ;
    owl:versionInfo "3.6.0" .

sophhe:BowShockCrossing a owl:Class ;
    rdfs:label "bow shock crossing"@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhe:MagneticStorm a owl:Class ;
    rdfs:label "magnetic storm"@en .

sophhe:MagneticSubstorm a owl:Class ;
    rdfs:label "magnetic substorm"@en .

sophhe:SpaceWeather a owl:Class ;
    rdfs:label "space weather"@en ;
    rdfs:comment "Space weather is the concept of changing environmental conditions in outer space. It is distinct from the concept of weather within a planetary atmosphere, and generally deals with the interactions of ambient radiation and matter within interplanetary, and occasionally interstellar space. Space weather describes the conditions in space that affect Earth and its technological systems. Our space weather is a consequence of the behavior of the sun, the nature of Earth's magnetic field, and our location in the solar system."@en ;
    rdfs:subClassOf sophhe:HeliosphericPhenomena .

sophhy:Flood a owl:Class ;
    rdfs:label "flood"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        sophhy:HydrospherePhenomena,
        sophsy:Inundation .

sophhy:Runoff a owl:Class ;
    rdfs:label "runoff"@en ;
    rdfs:comment "Runoff is a term used to describe the flow of water, from rain, snowmelt, or other sources, over the land surface, and is a major component of the water cycle. Runoff that occurs on surfaces before reaching a channel is also called a nonpoint source. If a nonpoint source contains man-made contaminants, the runoff is called nonpoint source pollution. A land area which produces runoff draining to a common point is called a watershed. When runoff flows along the ground, it can pick up soil contaminants such as petroleum, pesticides (in particular herbicides and insecticides), or fertilizers that become discharge or nonpoint source pollution."@en ;
    rdfs:subClassOf sophhy:WaterFlow .

sophhy:SnowCover a owl:Class ;
    rdfs:label "snow cover"@en ;
    rdfs:subClassOf sophhy:HydrospherePhenomena .

sophhy:StreamDischarge a owl:Class ;
    rdfs:label "stream discharge"@en ;
    rdfs:subClassOf sophhy:Discharge .

sophhy:Streamflow a owl:Class ;
    rdfs:label "streamflow"@en ;
    rdfs:comment "Streamflow, or channel runoff, is the flow of water in streams, rivers, and other channels, and is a major element of the water cycle. It is one component of the runoff of water from the land to waterbodies, the other component being surface runoff. Water flowing in channels comes from surface runoff from adjacent hillslopes, from groundwater flow out of the ground, and from water discharged from pipes. The discharge of water flowing in a channel is measured using stream gauges or can be estimated by the Manning equation. The record of flow over time is called a hydrograph. Flooding occurs when the volume of water exceeds the capacity of the channel."@en ;
    rdfs:subClassOf sophhy:WaterFlow .

sophm:Cryoturbation a owl:Class ;
    rdfs:label "cryoturbation"@en ;
    rdfs:comment "Cryoturbation (frost churning) refers to the mixing of materials from various horizons of the soil right down to the parent rock due to freezing and thawing. Cryoturbation occurs to varying degrees in most Gelisols (permafrost soils). The cause of crytoturbation lies in the way in which the repeated freezing of the soil during autumn causes the formation of ice wedges at the most easily erodible parts of the parent rock. If the parent rock is hard, this can cause quite deep erosion of the rock over many years. As this process continues, during the summer when an active layer forms in the soil this eroded material can easily move both from the soil surface downward and from the permafrost table upward. As this process occurs, the upper soil material gradually dries out (because the soil moisture moves from the warm surface layer to the colder layer at the phen of the permafrost) so that it forms a granular structure with many very distinctive crystalline shapes (such as ice lenses). Separation of coarse from fine soil materials produces distinctive patterned ground with different types of soil."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocsc:Freezing ;
            owl:onProperty sorelph:hasStateChange ],
        sophm:Mixing .

sophm:Separation a owl:Class ;
    rdfs:label "separation"@en ;
    rdfs:subClassOf soph:DynamicalPhenomena .

sophoc:BreakingWave a owl:Class ;
    rdfs:label "breaking wave"@en ;
    rdfs:subClassOf sophoc:CoastalPhenomena .

sophoc:LongshoreDrift a owl:Class ;
    rdfs:label "longshore drift"@en .

sophod:EasternBoundaryCurrent a owl:Class ;
    rdfs:label "eastern boundary current"@en ;
    rdfs:subClassOf sophod:BoundaryCurrent .

sophod:LongshoreCurrent a owl:Class ;
    rdfs:label "longshore current"@en ;
    rdfs:comment "(Also called littoral current.) The resultant current produced by waves being deflected at an angle by the shore. In this case the current runs roughly parallel to the shoreline. The longshore current is capable of carrying a certain amount of material as long as its velocity remains fairly constant; however, any obstruction, such as a submarine rock ridge or a land point cutting across the path of the current, will cause loss of velocity and consequent loss of carrying power."@en ;
    rdfs:subClassOf sophod:OceanCurrent .

sophod:ModeEddy a owl:Class ;
    rdfs:label "mode eddy"@en .

sophod:Tsunami a owl:Class ;
    rdfs:label "tsunami"@en ;
    rdfs:comment "Waves generated by seismic activity."@en ;
    rdfs:subClassOf sophgs:SeismicWave,
        sopho:OceanPhenomena .

sophod:WesternBoundaryCurrent a owl:Class ;
    rdfs:label "western boundary current"@en ;
    rdfs:subClassOf sophod:BoundaryCurrent .

sophpc:ClimateAnomaly a owl:Class ;
    rdfs:label "climate anomaly"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelm:deviationFrom ;
            owl:someValuesFrom sophpc:Climate ],
        sophpc:ClimatePhenomena,
        sopropdife:Anomaly ;
    owl:equivalentClass sophpc:ClimaticAnomaly .

sophpc:ClimateAverage a owl:Class ;
    rdfs:label "climate average"@en .

sophpc:ClimaticAnomaly a owl:Class ;
    rdfs:label "climatic anomaly"@en .

sophpc:ClimaticAverage a owl:Class ;
    rdfs:label "climatic average"@en .

sophpc:ClimatologicalAverage a owl:Class ;
    rdfs:label "climatological average"@en .

sophpc:Drought a owl:Class ;
    rdfs:label "drought"@en ;
    rdfs:subClassOf sophpc:ClimateAnomaly .

sophpc:GlobalWarming a owl:Class ;
    rdfs:label "global warming"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophpc:GreenhouseEffect ;
            owl:onProperty sorel:hasPhenomena ],
        sophpc:GlobalChange .

sophpc:GreenhouseEffect a owl:Class ;
    rdfs:label "greenhouse effect"@en ;
    rdfs:subClassOf sophpc:GlobalWarming .

sophr:Eruption a owl:Class ;
    rdfs:label "eruption"@en ;
    rdfs:subClassOf sophr:Release .

sophr:Fire a owl:Class ;
    rdfs:label "fire"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        soprocc:ChemicalReaction .

sophr:Flaring a owl:Class ;
    rdfs:label "flaring"@en .

sophso:Accretion a owl:Class ;
    rdfs:label "accretion"@en ;
    rdfs:subClassOf sophso:SolidPhenomena ;
    owl:equivalentClass sophso:Coalescence .

sophso:Clumping a owl:Class ;
    rdfs:label "clumping"@en .

sophso:Disintegration a owl:Class ;
    rdfs:label "disintegration"@en .

sophso:FaultLine a owl:Class ;
    rdfs:label "fault line"@en .

sophso:Fissure a owl:Class ;
    rdfs:label "fissure"@en ;
    rdfs:subClassOf sophso:Crack .

sophso:Shear a owl:Class ;
    rdfs:label "shear"@en ;
    rdfs:subClassOf sophso:SolidPhenomena .

sophst:Asteroseismology a owl:Class ;
    rdfs:label "asteroseismology"@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophst:CoronalMassEjection a owl:Class ;
    rdfs:label "coronal mass ejection"@en ;
    rdfs:comment "A coronal mass ejection (CME) is an ejection of material from the solar corona, usually observed with a white-light coronagraph. The ejected material is a plasma consisting primarily of electrons and protons (in addition to small quantities of heavier elements such as helium, oxygen, and iron), plus the entrained coronal magnetic field."@en ;
    rdfs:subClassOf sophst:CoronalPhenomena .

sophst:Granule a owl:Class ;
    rdfs:label "granule"@en ;
    rdfs:comment "Granules on the photosphere are caused by convection currents (thermal columns, Bénard cells) of plasma within the Sconvective zone."@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophst:Prominence a owl:Class ;
    rdfs:label "prominence"@en ;
    rdfs:comment "A solar prominence is a large bright feature extending outwards from the sun's surface, often in a loop configuration. Prominences are anchored to the solar surface in the photosphere, and extend outwards into the solar corona. While the corona consists of extremely hot ionized gases, known as plasma, which do not emit much visible light, prominences contain much cooler plasma, similar in composition to that of the chromosphere. A prominence forms over timescales of about a day, and stable prominences may persist in the corona for several months. Some prominences break apart and give rise to coronal mass ejections"@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophst:StellarWind a owl:Class ;
    rdfs:label "stellar wind"@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophst:Supergranulation a owl:Class ;
    rdfs:label "supergranulation"@en ;
    rdfs:subClassOf sophst:StellarPhenomena .

sophsy:Change a owl:Class ;
    rdfs:label "change"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsy:Disturbance a owl:Class ;
    rdfs:label "disturbance"@en ;
    rdfs:subClassOf sophsy:Variation .

sophsy:Drop a owl:Class ;
    rdfs:label "drop"@en .

sophsy:Fall a owl:Class ;
    rdfs:label "fall"@en .

sophsy:Increase a owl:Class ;
    rdfs:label "increase"@en ;
    rdfs:subClassOf sophsy:SystemStateChange ;
    owl:equivalentClass sophsy:Rise .

sophsy:Interaction a owl:Class ;
    rdfs:label "interaction"@en ;
    rdfs:comment "process that multiple substances are in contact and have some consequence"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Inundation a owl:Class ;
    rdfs:label "inundation"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Perturbation a owl:Class ;
    rdfs:label "perturbation"@en ;
    rdfs:comment "Any departure introduced into an assumed steady state of a system.   The magnitude is often assumed to be small so that product terms in the dependent variables may be neglected."@en ;
    rdfs:subClassOf sophsy:Variation .

sophsy:Recycling a owl:Class ;
    rdfs:label "recycling"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsy:Reduction a owl:Class ;
    rdfs:label "reduction"@en .

sophsy:Return a owl:Class ;
    rdfs:label "return"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsy:Rise a owl:Class ;
    rdfs:label "rise"@en .

sophsyc:Collapse a owl:Class ;
    rdfs:label "collapse"@en ;
    rdfs:subClassOf sophsy:SystemStateChange .

sophsyc:Emergent a owl:Class ;
    rdfs:label "emergent"@en ;
    rdfs:subClassOf sophsy:SystemStateChange ;
    owl:equivalentClass sophsyc:EmergentPhenomenon .

sophsyc:EmergentPhenomenon a owl:Class ;
    rdfs:label "emergent phenomenon"@en .

sophsyc:Fluctuation a owl:Class ;
    rdfs:label "fluctuation"@en ;
    rdfs:subClassOf sophsy:Variation .

sophsyc:Pattern a owl:Class ;
    rdfs:label "pattern"@en ;
    rdfs:subClassOf sophsy:Trend .

sophsyc:PositiveFeedback a owl:Class ;
    rdfs:label "positive feedback"@en ;
    rdfs:subClassOf sophsyc:Feedback .

sophsyc:SelfRegulation a owl:Class ;
    rdfs:label "self regulation"@en ;
    rdfs:subClassOf sophsy:SystemPhenomena .

sophsyc:Shock a owl:Class ;
    rdfs:label "shock"@en ;
    rdfs:subClassOf sophsy:SystemStateChange,
        sorepmf:Discontinuity .

sophsyc:Transforming a owl:Class ;
    rdfs:label "transforming"@en .

sophw:Acoustics a owl:Class ;
    rdfs:label "acoustics"@en .

sophw:BodyWave a owl:Class ;
    rdfs:label "body wave"@en ;
    rdfs:subClassOf sophw:SolidWave ;
    owl:disjointWith sophw:SurfaceWave .

sophw:RossbyWave a owl:Class ;
    rdfs:label "rossby wave"@en ;
    rdfs:comment "Rossby (or planetary) waves are large-scale motions in the ocean or atmosphere whose restoring force is the variation in Coriolis effect with latitude. The waves were first identified in the atmosphere in 1939 by Carl-Gustaf Arvid Rossby who went on to explain their motion. Rossby waves are a subset of inertial waves"@en ;
    rdfs:subClassOf sophw:InertialWave .

sophw:ShearWave a owl:Class ;
    rdfs:label "shear wave"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasRestoringForce ;
            owl:someValuesFrom sophso:Shear ],
        sophw:SolidWave,
        sophw:TransverseWave .

sophw:StandingWave a owl:Class ;
    rdfs:label "standing wave"@en ;
    rdfs:comment "A wave that is stationary with respect to the medium in which it is embedded, for example, two equal gravity waves moving in opposite directions."@en ;
    rdfs:subClassOf sophw:Wave ;
    owl:disjointWith sophw:TravelingWave .

sophw:TransverseWave a owl:Class ;
    rdfs:label "transverse wave"@en ;
    rdfs:comment "A transverse wave is a wave that causes vibration in the medium in a perpendicular direction to its own motion. For example: if a wave moves along the x-axis, its disturbances are in the yz-plane. In other words, it causes medium disturbances across the two-dimensional plane that it is travelling in. Contrary to popular belief, transversal waves do not necessarily move up and down."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Perpendicular ;
            owl:onProperty sorelph:hasOscillationDirection ],
        sophw:Wave .

sophw:TravelingWave a owl:Class ;
    rdfs:label "traveling wave"@en ;
    rdfs:subClassOf sophw:Wave .

sophwn:Interference a owl:Class ;
    rdfs:label "interference"@en ;
    rdfs:subClassOf sophwn:Noise .

sophwn:Resonance a owl:Class ;
    rdfs:label "resonance"@en ;
    rdfs:subClassOf sophw:WavePhenomena ;
    owl:equivalentClass sophwn:Resonant .

sophwn:Resonant a owl:Class ;
    rdfs:label "resonant"@en .

soprocc:Adsorption a owl:Class ;
    rdfs:label "adsorption"@en ;
    rdfs:comment "Adsorption is the accumulation of atoms or molecules on the surface of a material. This process creates a film of the adsorbate (the molecules or atoms being accumulated) on the adsorbent's surface. [Wikipedia]"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Crystallization a owl:Class ;
    rdfs:label "crystallization"@en ;
    rdfs:comment "Crystallization is the (natural or artificial) process of formation of solid crystals precipitating from a solution, melt or more rarely deposited directly from a gas. [Wikipedia]"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Fluorescence a owl:Class ;
    rdfs:label "fluorescence"@en ;
    rdfs:comment "Fluorescence is a luminescence that is mostly found as an optical phenomenon in cold bodies, in which the molecular absorption of a photon triggers the emission of another photon with a longer wavelength. The energy difference between the absorbed and emitted photons ends up as molecular vibrations or heat. Usually the absorbed photon is in the ultraviolet range, and the emitted light is in the visible range, but this depends on the absorbance curve and Stokes shift of the particular fluorophore. Fluorescence is named after the mineral fluorite, composed of calcium fluoride, which often exhibits this phenomenon."@en ;
    rdfs:subClassOf soprocc:Luminescence .

soprocc:Hydration a owl:Class ;
    rdfs:label "hydration"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Reduction a owl:Class ;
    rdfs:label "reduction"@en ;
    rdfs:subClassOf soprocc:ChemicalProcess .

soprocc:Solvation a owl:Class ;
    rdfs:label "solvation"@en .

soprocp:Collision a owl:Class ;
    rdfs:label "collision"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Conduction a owl:Class ;
    rdfs:label "conduction"@en ;
    rdfs:comment "Transport of energy (charge) solely as a consequence of random motions of individual molecules (ions, electrons) not moving together in coherent groups."@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Decompression a owl:Class ;
    rdfs:label "decompression"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Deflection a owl:Class ;
    rdfs:label "deflection"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Friction a owl:Class ;
    rdfs:label "friction"@en ;
    rdfs:subClassOf soproc:Force .

soprocp:GravityForce a owl:Class ;
    rdfs:label "gravity force"@en .

soprocp:Induction a owl:Class ;
    rdfs:label "induction"@en .

soprocp:NonIonizingRadiation a owl:Class ;
    rdfs:label "non ionizing radiation"@en ;
    rdfs:subClassOf soprocp:Radiation .

soprocp:Pressure a owl:Class ;
    rdfs:label "pressure"@en ;
    rdfs:subClassOf soproc:Force .

soprocp:Rareification a owl:Class ;
    rdfs:label "rareification"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprocp:Tension a owl:Class ;
    rdfs:label "tension"@en ;
    rdfs:subClassOf soproc:Force .

soprocsc:Ionization a owl:Class ;
    rdfs:label "ionization"@en ;
    rdfs:comment "Ionization is the physical process of converting an atom or molecule into an ion by changing the difference between the number of protons and electrons. This process works slightly differently depending on whether an ion with a positive or a negative electric charge is being produced. A positive electric charge is produced when an electron bond to an atom or molecule absorbs enough energy from an external source to escape from the electric potential barrier that originally confined it, where the amount of energy required is called the Ionization potential. A negative electric charge is produced when a free electron collides with an atom and is subsequently caught inside the electric potential barrier, releasing any excess energy."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:IonizedState ;
            owl:onProperty sorelph:to ],
        soprocsc:StateChange .

soprocw:Attenuation a owl:Class ;
    rdfs:label "attenuation"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess ;
    owl:equivalentClass soprocw:Extinction .

soprocw:Backscattering a owl:Class ;
    rdfs:label "backscattering"@en ;
    rdfs:comment "scattering of waves (photons) that reverse the direction of propagation"@en ;
    rdfs:subClassOf soprocw:Scattering .

soprocw:ElectromagneticWave a owl:Class ;
    rdfs:label "electromagnetic wave"@en .

soprocw:Extinction a owl:Class ;
    rdfs:label "extinction"@en .

soprocw:Reflection a owl:Class ;
    rdfs:label "reflection"@en ;
    rdfs:subClassOf soprocw:MediumWaveInteractionProcess .

soprop:GeologicalProperty a owl:Class ;
    rdfs:label "geological property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelh:studyOf ;
            owl:someValuesFrom sohukd:Geology ],
        soprop:Property .

soprop:RadiationMediumInteractionProperty a owl:Class ;
    rdfs:label "radiation medium interaction property"@en ;
    rdfs:subClassOf soprop:ElectromagneticRadiationProperty .

soprop:ThermodynamicProperty a owl:Class ;
    rdfs:label "thermodynamic property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelh:studyOf ;
            owl:someValuesFrom sohukd:Thermodynamics ],
        soprop:PhysicalProperty .

