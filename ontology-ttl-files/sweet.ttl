sophfd:Cyclone a owl:Class ;
    rdfs:label "cyclone"@en ;
    rdfs:subClassOf sophfd:LowPressure .

sophfd:Ridge a owl:Class ;
    rdfs:label "ridge"@en ;
    rdfs:comment "In meteorology, an elongated area of relatively low atmospheric pressure; the opposite of a ridge."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasState ;
            owl:someValuesFrom sophfd:HighPressure ],
        sorepsg:Ridge .

sophfi:Inversion a owl:Class ;
    rdfs:label "inversion"@en ;
    rdfs:comment "In meteorology, a departure from the usual decrease or increase with altitude of the value of an atmospheric quantity; also, the layer through which this departure occurs (the inversion layer), or the lowest altitude at which the departure is found (the base of the inversion)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soproptg:TemperatureGradient ;
            owl:onProperty sorelsc:hasQuantity ],
        sophfd:FluidPhenomena .

sophfi:KelvinHelmholtzInstability a owl:Class ;
    rdfs:label "kelvin helmholtz instability"@en ;
    rdfs:comment "An instability of the basic flow of an incompressible inviscid fluid in two parallel infinite streams of different velocities and densities."@en ;
    rdfs:subClassOf sophfi:FluidInstability .

sophg:Metamorphic a owl:Class ;
    rdfs:label "metamorphic"@en ;
    rdfs:comment "One of 3 processes in the Rock Cycle. When sedimentary (and/or) igneous layers are folded, bent or twisted by heat and pressure due to motions of tectonic plates or intrusions by magma, the rocky material is transformed into other rock called metamorphic rock. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:RockCycleProcess .

sophg:Sedimentary a owl:Class ;
    rdfs:label "sedimentary"@en ;
    rdfs:comment "One of 3 processes in the Rock Cycle. When wind or water deposit fine grained material on the surface, it creates sheets. Over thousands of years, the composition can change subtly or distinctly and the result is differing compositions of layered deposits. As the overlying layers compact the soil underneath the soil is converted to rock by the process of lithification. [Wikipedia]"@en ;
    rdfs:subClassOf sophg:RockCycleProcess .

sophgf:Extraction a owl:Class ;
    rdfs:label "extraction"@en ;
    rdfs:comment "A fault whose two sides have approached each other substantially in the direction perpendicular to the fault."@en ;
    rdfs:subClassOf sophgf:Slip .

sophgf:ObliqueSlip a owl:Class ;
    rdfs:label "oblique slip"@en ;
    rdfs:comment "The net slip of the fault lies between the strike and dip directions of the fault; the slip vector rakes between 10 and 80 degrees in the plane of the fault."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsd:Oblique ;
            owl:onProperty sorelsp:hasDirection ],
        sophgf:Slip .

sophgs:SeismicBodyWave a owl:Class ;
    rdfs:label "seismic body wave"@en ;
    rdfs:comment "Body waves are seismic waves that travel through the lithosphere. Two kinds of body waves exist: P-waves and S-waves."@en ;
    rdfs:subClassOf sophgs:SeismicWave,
        sophw:BodyWave .

sophgs:SeismicPhenomena a owl:Class ;
    rdfs:label "seismic phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgs:SeismicWave ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:hasValue sostri:Hazard ;
            owl:onProperty sorelsc:hasImpact ],
        sophg:GeospherePhenomena .

sophgt:AsymmetricHeatFlow a owl:Class ;
    rdfs:label "asymmetric heat flow"@en ;
    rdfs:comment "Asymmetric heat flow in geology is an observation that the heat from upwelling mantle does not spread symmetrically away from the hot spot or rift due to differences in crust composition."@en ;
    rdfs:subClassOf sophfd:Flow .

<http://sweetontology.net/phenGeolVolcano> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Geologic Volcano" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrRockIgneous>,
        <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/phenFluidTransport>,
        <http://sweetontology.net/phenGeol>,
        <http://sweetontology.net/phenReaction>,
        <http://sweetontology.net/propEnergy>,
        <http://sweetontology.net/propMass>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaPhysical> ;
    owl:versionInfo "3.6.0" .

sophgv:VolcanicPlume a owl:Class ;
    rdfs:label "volcanic plume"@en ;
    rdfs:comment "An eruption column of hot volcanic ash and gas emitted into the atmosphere during an explosive volcanic eruption. [Wikipedia]"@en ;
    rdfs:subClassOf sophft:Plume,
        sophgv:VolcanicPhenomena .

sophhe:GeomagneticStorm a owl:Class ;
    rdfs:label "geomagnetic storm"@en ;
    rdfs:comment "A geomagnetic storm is a temporary disturbance of the Earths magnetosphere caused by a disturbance in space weather. Associated with solar coronal mass ejections (CME), coronal holes, or solar flares, a geomagnetic storm is caused by a solar wind shock wave which typically strikes the Earths magnetic field 24 to 36 hours after the event. This only happens if the shock wave travels in a direction toward Earth. The solar wind pressure on the magnetosphere will increase or decrease depending on the Sun's activity. These solar wind pressure changes modify the electric currents in the ionosphere."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophhe:SpaceWeather ;
            owl:onProperty sorel:hasPhenomena ],
        soph:Event,
        sophhe:InterplanetaryPhenomena,
        sophsy:Disturbance ;
    owl:equivalentClass sophhe:MagneticStorm .

<http://sweetontology.net/phenHydro> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Hydrosphere" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrCompound>,
        <http://sweetontology.net/phen>,
