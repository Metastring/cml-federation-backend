sorepsu:FTU a sorepsu:Unit,
        owl:NamedIndividual ;
    rdfs:label "ftu"@en ;
    owl:sameAs sorepsu:FormazinTurbidityUnit .

sorepsu:UnitDerivedByShifting a owl:Class ;
    rdfs:label "unit derived by shifting"@en ;
    rdfs:subClassOf sorepsu:ComplexUnit .

sorepsu:centimeter a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "centimeter"@en ;
    sorelm:hasScalingNumber 0.01 ;
    sorelsc:hasBaseUnit sorepsu:meter ;
    sorelsc:hasPrefix sorepsu:centi ;
    skos:notation "cm"^^qudt:UCUMcs .

sorepsu:day a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "day"@en ;
    sorelm:hasScalingNumber 86400.0 ;
    sorelsc:hasBaseUnit sorepsu:second ;
    skos:notation "d"^^qudt:UCUMcs .

sorepsu:degrees a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "degrees"@en ;
    sorelm:hasScalingNumber 57.2957795 ;
    sorelsc:hasBaseUnit sorepsu:radian ;
    skos:notation "deg"^^qudt:UCUMcs .

sorepsu:farad a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "farad"@en ;
    sorelm:hasOperand sorepsu:coulomb,
        sorepsu:perVolt ;
    sorelsc:hasSymbol "F" ;
    skos:notation "F"^^qudt:UCUMcs .

sorepsu:henry a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "henry"@en ;
    sorelm:hasOperand sorepsu:kilogram,
        sorepsu:meterSquared,
        sorepsu:perAmpereSquared,
        sorepsu:perSecondSquared ;
    skos:notation "H"^^qudt:UCUMcs .

sorepsu:hour a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "hour"@en ;
    sorelm:hasScalingNumber 3600.0 ;
    sorelsc:hasBaseUnit sorepsu:second ;
    skos:notation "h"^^qudt:UCUMcs .

sorepsu:kilo a sorepsu:Prefix,
        owl:NamedIndividual ;
    rdfs:label "kilo"@en ;
    sorelsc:hasNumericValue 1000.0 ;
    sorelsc:hasSymbol "k" ;
    skos:notation "k"^^qudt:UCUMcs .

sorepsu:lumen a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "lumen"@en ;
    sorelm:hasOperand sorepsu:candela,
        sorepsu:steradian ;
    skos:notation "lm"^^qudt:UCUMcs .

sorepsu:meterPerSecondSquared a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "meter per second squared"@en ;
    sorelm:hasOperand sorepsu:meter,
        sorepsu:perSecondSquared ;
    skos:notation "m/s2"^^qudt:UCUMcs .

sorepsu:micron a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "micron"@en ;
    skos:notation "um"^^qudt:UCUMcs .

sorepsu:nanometer a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "nanometer"@en ;
    sorelm:hasScalingNumber 0.000000001 ;
    sorelsc:hasBaseUnit sorepsu:meter ;
    sorelsc:hasPrefix sorepsu:nano ;
    skos:notation "nm"^^qudt:UCUMcs .

sorepsu:newtonPerMeter a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "newton per meter"@en ;
    sorelm:hasOperand sorepsu:newton,
        sorepsu:perMeter ;
    skos:notation "N/m"^^qudt:UCUMcs .

sorepsu:perAmpere a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per ampere"@en ;
    sorelm:toThePower -1.0 ;
    sorelsc:hasBaseUnit sorepsu:ampere ;
    skos:notation "/A"^^qudt:UCUMcs .

sorepsu:perAmpereSquared a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per ampere squared"@en ;
    sorelm:toThePower -2.0 ;
    sorelsc:hasBaseUnit sorepsu:ampere ;
    skos:notation "/A2"^^qudt:UCUMcs .

sorepsu:perSecondCubed a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per second cubed"@en ;
    sorelm:toThePower -3.0 ;
    sorelsc:hasBaseUnit sorepsu:second ;
    skos:notation "/s3"^^qudt:UCUMcs .

sorepsu:perSteradian a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per steradian"@en ;
    sorelm:toThePower -1.0 ;
    sorelsc:hasBaseUnit sorepsu:steradian ;
    skos:notation "/sr"^^qudt:UCUMcs .

sorepsu:tesla a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "tesla"@en ;
    sorelm:hasOperand sorepsu:perMeterSquared,
        sorepsu:weber ;
    skos:notation "T"^^qudt:UCUMcs .

sorepsu:weber a sorepsu:UnitDefinedByProduct,
        owl:NamedIndividual ;
    rdfs:label "weber"@en ;
    sorelm:hasOperand sorepsu:kilogram,
        sorepsu:meterSquared,
        sorepsu:perAmpere,
        sorepsu:perSecondSquared ;
    skos:notation "Wb"^^qudt:UCUMcs .

sorepsu:week a sorepsu:UnitDerivedByScaling,
        owl:NamedIndividual ;
    rdfs:label "week"@en ;
    sorelm:hasScalingNumber 604800.0 ;
    sorelsc:hasBaseUnit sorepsu:second ;
    skos:notation "wk"^^qudt:UCUMcs .

