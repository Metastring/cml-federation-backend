sophgs:SeismicWave a owl:Class ;
    rdfs:label "seismic wave"@en ;
    rdfs:comment "Seismic waves are phenomena that travel through the Earth or other elastic body, for example as the result of an earthquake, explosion, or some other process that imparts forces to the body. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgs:SeismicPhenomena ;
            owl:onProperty sorel:hasPhenomena ],
        sophw:Wave .

