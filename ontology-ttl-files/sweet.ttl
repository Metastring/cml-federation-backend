        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/statePhysical>,
        <http://sweetontology.net/stateSystem> ;
    owl:versionInfo "3.6.0" .

soprocw:WaveProcess a owl:Class ;
    rdfs:label "wave process"@en ;
    rdfs:subClassOf soprocp:PhysicalProcess .

soprop:Error a owl:Class ;
    rdfs:label "error"@en ;
    rdfs:subClassOf soprop:Metric .

soprop:FluidProperty a owl:Class ;
    rdfs:label "fluid property"@en ;
    rdfs:subClassOf soprop:PhysicalProperty .

<http://sweetontology.net/propCategorical> a owl:Ontology ;
    rdfs:label "SWEET Ontology Property Categorical" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/prop>,
        <http://sweetontology.net/propOrdinal>,
        <http://sweetontology.net/propQuantity> ;
    owl:versionInfo "3.6.0" .

sopropcat:CategoricalProperty a owl:Class ;
    rdfs:label "categorical property"@en ;
    rdfs:subClassOf soprop:Property ;
    owl:disjointWith sopropo:OrdinalProperty,
        sopropq:Quantity .

sopropdife:Deviation a owl:Class ;
    rdfs:label "deviation"@en ;
    rdfs:subClassOf soprop:Error,
        sopropdife:Difference .

sopropdifu:DiffusivityQuantity a owl:Class ;
    rdfs:label "diffusivity quantity"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterSquaredPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:PhysicalQuantity .

sopropef:RadiativeForcing a owl:Class ;
    rdfs:label "radiative forcing"@en ;
    rdfs:comment "In radiation, the net flux of radiation into or out of a system.  As a consequence of radiative forcing there must be some change to the nonradiative energy states of the system."@en ;
    rdfs:subClassOf sopropef:FluxDensity,
        sopropef:RadiantFlux .

sopropfu:AnnualAverage a owl:Class ;
    rdfs:label "annual average"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:year ;
            owl:onProperty sorelm:averageOver ],
        sopropfu:TimeMean .

sopropm:Mass a owl:Class ;
    rdfs:label "mass"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:kilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ExtensiveProperty .

sopropmf:MassFlux a owl:Class ;
    rdfs:label "mass flux"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropm:Mass ;
            owl:onProperty sorelch:hasSubstance ],
        sopropq:Flux .

soprops:SpatialProperty a owl:Class ;
    rdfs:label "spatial property"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreps:Space ;
            owl:onProperty sorelsc:measureOf ],
        soprop:Property .

soprops:SpatialSource a owl:Class ;
    rdfs:label "spatial source"@en ;
    rdfs:subClassOf soprops:SpatialProperty .

sopropsdis:SizeRange_micron a owl:Class ;
    rdfs:label "size range micron"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:micron ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropsdis:SizeRange .

sopropsp:Speed a owl:Class ;
    rdfs:label "speed"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        soprop:MotionProperty,
        sopropq:PhysicalQuantity .

sorea:Geosphere a owl:Class ;
    rdfs:label "geosphere"@en ;
    rdfs:comment "The term Geosphere is often used to refer to the densest (solid) parts of a planet, which consist mostly of rock and regolith [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        sorea:PlanetaryRealm ;
    owl:equivalentClass soreag:SolidEarth .

sorea:Hydrosphere a owl:Class ;
    rdfs:label "hydrosphere"@en ;
    rdfs:comment "A hydrosphere in physical geography describes the combined mass of water found on, under, and over the surface of a planet. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue somac:Water ;
            owl:onProperty sorelch:hasSubstance ],
        sorea:PlanetaryRealm .

<http://sweetontology.net/realmAstroBody> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Astrophysical Body" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/propTime>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/reprSpaceGeometry3D> ;
    owl:versionInfo "3.6.0" .

soreacz:A a owl:Class ;
    rdfs:label "a"@en ;
    rdfs:comment "The A climate classification, also known as the Tropical climate classification, is characterized as being consistently warm with all months averaging above 18 degrees C and having annual precipitation exceeds potential evapotranspiration (POTET)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue [ a sopropst:PrecipitationRange ] ;
            owl:onProperty sorelcl:hasAverageAnnualPrecipitation ],
        [ a owl:Restriction ;
            owl:hasValue [ a sopropt:TemperatureRange ] ;
            owl:onProperty sorelcl:hasAverageMonthlyTemperature ],
        soreacz:ClimateClassification ;
    owl:equivalentClass soreacz:TropicalClimate .

soreacz:E a owl:Class ;
    rdfs:label "e"@en ;
    rdfs:subClassOf soreacz:ClimateClassification .

soreag:Crust a owl:Class ;
    rdfs:label "crust"@en ;
    rdfs:comment "The crust is the outermost solid shell of a rocky planet or moon, which is chemically distinct from the underlying mantle.  [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreag:Moho ;
            owl:onProperty sorelsp:hasLowerBoundary ],
        soreag:GeosphereLayer ;
    owl:equivalentClass soreag:SkinLayer .

soreag:GeosphereLayer a owl:Class ;
    rdfs:label "geosphere layer"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Geosphere ;
            owl:onProperty sorel:hasRealm ],
        sorea:PlanetaryLayer,
        soreag:Subsurface .

soreag:Mantle a owl:Class ;
    rdfs:label "mantle"@en ;
    rdfs:comment "The mantle is a highly viscous layer between the crust and the outer core. Earth's mantle is an approximately 2,970 km thick (~1,800 mi) rocky shell that constitutes approximately 84 percent of Earth's volume.  [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreag:Moho ;
            owl:onProperty sorelsp:hasUpperBoundary ],
        soreag:GeosphereLayer .

<http://sweetontology.net/realmGeolBasin> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Geologic Basin" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrRock>,
        <http://sweetontology.net/realmGeol>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical> ;
    owl:versionInfo "3.6.0" .

soreagcons:RockConstituent a owl:Class ;
    rdfs:label "rock constituent"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom somarock:Rock ;
            owl:onProperty sorelch:hasSubstance ],
        sopropche:Constituent .

<http://sweetontology.net/realmHydroBody> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm Hydrosphere Body" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrPlant>,
        <http://sweetontology.net/matrSediment>,
        <http://sweetontology.net/matrWater>,
        <http://sweetontology.net/realm>,
        <http://sweetontology.net/realmCryo>,
        <http://sweetontology.net/realmHydro>,
        <http://sweetontology.net/realmLandFluvial>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/stateChemical> ;
    owl:versionInfo "3.6.0" .

soreala:AeolianLandform a owl:Class ;
    rdfs:label "aeolian landform"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreala:Eolian ;
            owl:onProperty sorel:hasPhenomena ],
        soreal:Landform .

sorealo:Mountain a owl:Class ;
    rdfs:label "mountain"@en ;
    rdfs:subClassOf soreal:Landform ;
    owl:equivalentClass sorealo:Orography .

sorealt:FractureZone a owl:Class ;
    rdfs:label "fracture zone"@en ;
    rdfs:comment "A fracture zone is a linear oceanic feature--often hundreds, even thousands of kilometers long--resulting from the action of offset mid-ocean ridge axis segments. They are a consequence of plate tectonics. Lithospheric plates on either side of an active transform fault move in opposite directions; here, strike-slip activity is possible. Fracture zones extend past the transform faults, away from the ridge axis; seismically inactive (because both plate segments are moving in the same direction), they display evidence of past transform fault activity."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophso:Fracture ;
            owl:onProperty sorel:hasPhenomena ],
        soreag:GeologicBoundary .

sorealv:Volcano a owl:Class ;
    rdfs:label "volcano"@en ;
    rdfs:comment "A volcano is an opening, or rupture, in a planet's surface or crust, which allows hot, molten rock, ash, and gases to escape from below the surface. Volcanic activity involving the extrusion of rock tends to form mountains or features like mountains over a period of time. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelch:hasPrimarySubstance ;
            owl:someValuesFrom somarocki:Magma ],
        sorealv:VolcanicField .

soreal:Plain a owl:Class ;
    rdfs:label "plain"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostsc:Flat ;
            owl:onProperty sorelsp:hasSpatialConfiguration ],
        soreal:Landform .

soreaofe:EarthOcean a owl:Class ;
    rdfs:label "earth ocean"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorea:Earth ;
            owl:onProperty sorelph:hasAstronomicalBody ],
        sorea:Ocean .

sorear:LatitudeLine a owl:Class ;
    rdfs:label "latitude line"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:degrees ;
            owl:onProperty sorelsc:hasUnit ],
        sopropq:PhysicalQuantity,
        sorepsg:Region .

sorear:NorthLatitudeBand a owl:Class ;
    rdfs:label "north latitude band"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0 ;
            owl:onProperty sorelm:hasLowerBound ],
        sorear:LatitudeBand .

sorel:hasProperty a owl:ObjectProperty ;
    rdfs:label "has property"@en ;
    rdfs:range soprop:Property .

sorelm:eachElementHasType a owl:ObjectProperty ;
    rdfs:label "each element has type"@en ;
    rdfs:range sorepm:NumericalEntity .

sorelm:hasUpperBound a owl:DatatypeProperty ;
    rdfs:label "has upper bound"@en ;
    owl:equivalentProperty sorelm:upperBound .

sorelm:maximumOf a owl:ObjectProperty ;
    rdfs:label "maximum of"@en .

sorelm:minimumOf a owl:ObjectProperty ;
    rdfs:label "minimum of"@en .

sorelph:hasStateChange a owl:ObjectProperty ;
    rdfs:label "has state change"@en ;
    rdfs:subPropertyOf sorel:hasProcess .

sorelsc:hasImpactOn a owl:ObjectProperty ;
    rdfs:label "has impact on"@en ;
    rdfs:domain sopropo:Impact .

sorelsc:measures a owl:ObjectProperty ;
    rdfs:label "measures"@en .

sorelsp:below a owl:ObjectProperty ;
    rdfs:label "below"@en ;
    rdfs:subPropertyOf sorelsp:spatialRelation .

sorelsp:diameter a owl:ObjectProperty ;
    rdfs:label "diameter"@en ;
    rdfs:subPropertyOf sorelsp:hasLength .

sorelsp:hasLength a owl:ObjectProperty ;
    rdfs:label "has length"@en ;
    rdfs:range sopropsdis:Length .

sorelsp:hasLowerBoundary a owl:ObjectProperty ;
    rdfs:label "has lower boundary"@en ;
    rdfs:subPropertyOf sorelsp:hasBoundary .

sorelsp:hasSpatialConfiguration a owl:ObjectProperty ;
    rdfs:label "has spatial configuration"@en ;
    rdfs:range soprops:Configuration .

sorep:Dimension a owl:Class ;
    rdfs:label "dimension"@en ;
    rdfs:comment "In common usage, a dimension is a parameter or measurement used to describe some relevant characteristic of an object. The most commonly used dimensions are the parameters describing the size of an object: length, width, and height, but dimensions can also be other physical parameters such as the mass and electric charge of an object, or even, in a context where cost is relevant, an economic parameter such as its price."@en ;
    rdfs:subClassOf sorep:Representation .

sorepdp:Collection a owl:Class ;
    rdfs:label "collection"@en ;
    rdfs:subClassOf sorepdp:Data .

sorepdp:Value a owl:Class ;
