soprocp:PhysicalProcess a owl:Class ;
    rdfs:label "physical process"@en ;
    rdfs:subClassOf soproc:Process .

sopropt:Temperature a owl:Class ;
    rdfs:label "temperature"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Heat ;
            owl:onProperty sorelsc:measureOf ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:kelvin ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ThermodynamicQuantity .

sorepsu:UnitDerivedByScaling a owl:Class ;
    rdfs:label "unit derived by scaling"@en ;
    rdfs:subClassOf sorepsu:ComplexUnit .

somais:Isotope a owl:Class ;
    rdfs:label "isotope"@en ;
    rdfs:subClassOf somael:Element .

sopropo:SpectralBand a owl:Class ;
    rdfs:label "spectral band"@en ;
    rdfs:subClassOf soprop:PhysicalProperty,
        sorepm:Interval .

<http://sweetontology.net/realm> a owl:Ontology ;
    rdfs:label "SWEET Ontology Realm" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrCompound>,
        <http://sweetontology.net/matrWater>,
        <http://sweetontology.net/realmAstroBody>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaSpace>,
        <http://sweetontology.net/reprSpaceGeometry>,
        <http://sweetontology.net/reprSpaceGeometry3D>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/statePhysical> ;
    owl:versionInfo "3.6.0" .

sostti:Epoch a owl:Class ;
    rdfs:label "epoch"@en ;
    rdfs:comment "Periods are divided into epochs [tens of millions of years] [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelt:temporalPartOf ;
            owl:someValuesFrom sostti:Period ],
        sostti:GeologicTimeUnit .

soprops:Shape a owl:Class ;
    rdfs:label "shape"@en ;
    rdfs:comment "Description of the form of an object"@en ;
    rdfs:subClassOf soprops:SpatialConfiguration .

sostc:ChemicalState a owl:Class ;
    rdfs:label "chemical state"@en ;
    rdfs:subClassOf sost:State .

sostso:SolidState a owl:Class ;
    rdfs:label "solid state"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        sostp:PhysicalState .

soprop:Role a owl:Class ;
    rdfs:label "role"@en ;
    rdfs:subClassOf soprop:Property .

<http://sweetontology.net/relaChemical> a owl:Ontology ;
    rdfs:label "SWEET Ontology Relationships Chemical" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/procChemical>,
        <http://sweetontology.net/rela> ;
    owl:versionInfo "3.6.0" .

soproptf:Frequency a owl:Class ;
    rdfs:label "frequency"@en ;
    rdfs:comment "The rate of recurrence of any periodic phenomenon, often associated with waves of all kinds. Without qualification frequency often means temporal frequency, the rate of recurrence of a time-varying function, but could mean spatial frequency, the rate of recurrence of a space-varying function. Spatial frequency is the reciprocal of the repeat distance (sometimes the wavelength). The dimensions of (temporal) frequency are inverse time. A common unit for frequency is cycle per second, formerly abbreviated cps, but superseded by hertz, abbreviated as Hz."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:hertz ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:PhysicalQuantity,
        soproptf:Rate .

sohu:HumanActivity a owl:Class ;
    rdfs:label "human activity"@en .

sopropsdir:Direction a owl:Class ;
    rdfs:label "direction"@en ;
    rdfs:subClassOf sorepm:Vector_3D ;
    owl:equivalentClass sopropsdir:Inclination .

sostsy:SystemState a owl:Class ;
    rdfs:label "system state"@en ;
    rdfs:subClassOf sost:State .

sostef:XClass a owl:Class ;
    rdfs:label "x class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.0001 ;
            owl:onProperty sorelm:hasLowerBound ],
        sopropo:FlareClass .

sophatmowm:MesoscaleWind a owl:Class ;
    rdfs:label "mesoscale wind"@en ;
    rdfs:subClassOf sophatmow:Wind .

