        sopropq:PhysicalQuantity .

sopropcou:Population a owl:Class ;
    rdfs:label "population"@en ;
    rdfs:subClassOf sopropcou:Count .

sopropdife:Anomaly a owl:Class ;
    rdfs:label "anomaly"@en ;
    rdfs:subClassOf sopropdife:Deviation .

sopropdife:NormalizedDifferenceVegetationIndex a sopropdife:Difference,
        owl:NamedIndividual ;
