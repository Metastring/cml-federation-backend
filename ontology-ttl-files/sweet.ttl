        <http://sweetontology.net/reprSciUnits> ;
    owl:versionInfo "3.6.0" .

sopropdifu:Streamfunction a owl:Class ;
    rdfs:label "streamfunction"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterCubedPerSecond ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sorepmf:VectorQuantity .

sopropdr:ChiSquareValue a owl:Class ;
    rdfs:label "chi square value"@en ;
    rdfs:subClassOf sopropdr:StatisticalScore .

sopropdr:HydraulicGradient a soprop:HydrogeologicalProperty,
        sopropdr:DimensionlessRatio,
        owl:NamedIndividual ;
    rdfs:label "hydraulic gradient"@en .

soprope:AvailablePotentialEnergy a owl:Class ;
    rdfs:label "available potential energy"@en ;
    rdfs:comment "That portion of the total potential energy that may be converted to kinetic energy in an adiabatically enclosed system."@en ;
    rdfs:subClassOf soprope:PotentialEnergy .

soprope:EnergyBudget a owl:Class ;
    rdfs:label "energy budget"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Energy ;
            owl:onProperty sorel:hasProperty ],
        sopropq:Budget .

soprope:GravitationalPotential a owl:Class ;
    rdfs:label "gravitational potential"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocp:Gravity ;
            owl:onProperty sorel:hasProcess ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:meterSquaredPerSecondSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ScalarPotential .

soprope:HeatEnergy a owl:Class ;
    rdfs:label "heat energy"@en .

soprope:IonizationPotential a owl:Class ;
    rdfs:label "ionization potential"@en .

soprope:LatentHeat a owl:Class ;
    rdfs:label "latent heat"@en ;
    rdfs:subClassOf soprope:Heat .

soprope:Power a owl:Class ;
    rdfs:label "power"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Energy ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorept:Time ;
            owl:onProperty sorelm:hasSecondOperand ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:watt ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ExtensiveProperty,
        sorepmo:Ratio .

soprope:SensibleHeat a owl:Class ;
    rdfs:label "sensible heat"@en ;
    rdfs:subClassOf soprope:Heat .

soprope:SpecificEnergy a owl:Class ;
    rdfs:label "specific energy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprope:Energy ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sopropm:Mass ;
            owl:onProperty sorelm:hasSecondOperand ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:joulePerKilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:IntensiveProperty,
        sorepmo:Ratio .

soprope:ThermalEnergy a owl:Class ;
    rdfs:label "thermal energy"@en .

sopropef:EarthquakeScale a owl:Class ;
    rdfs:label "earthquake scale"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sophgs:Earthquake ;
            owl:onProperty sorel:hasPhenomena ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:db ;
            owl:onProperty sorelsc:hasUnit ],
        sorep:LogarithmicScale .

sopropef:Intensity a owl:Class ;
    rdfs:label "intensity"@en .

sopropef:Luminance a owl:Class ;
    rdfs:label "luminance"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:candelaPerMeterSquared ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticRadiationQuantity .

sopropef:Opacity a owl:Class ;
    rdfs:label "opacity"@en ;
    rdfs:comment "The extinction coefficient for a particular substance is a measure of how well it scatters and absorbs electromagnetic radiation (EM waves). If the EM wave can pass through very easily, the material has a low extinction coefficient. Conversely, if the radiation hardly penetrates the material, but rather quickly becomes extinct within it, the extinction coefficient is high."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:meterSquaredPerKilogram ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:RadiationMediumInteractionQuantity .

sopropef:Radiance a owl:Class ;
    rdfs:label "radiance"@en ;
    rdfs:comment "A radiometric term for the rate at which radiant energy in a set of directions confined to a unit solid angle around a particular direction is transferred across unit area of a surface (real or imaginary) projected onto this direction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:wattPerMeterSquaredPerSteradian ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ElectromagneticRadiationQuantity .

sopropef:RadiantFlux a owl:Class ;
    rdfs:label "radiant flux"@en ;
    rdfs:comment "Radiant energy per unit time passing some specified area from one side."@en ;
    rdfs:subClassOf sopropef:RadiativeForcing .

sopropef:SpecificIntensity a owl:Class ;
    rdfs:label "specific intensity"@en .

sopropfr:Albedo a owl:Class ;
    rdfs:label "albedo"@en ;
    rdfs:comment "The ratio of reflected flux density to incident flux density, referenced to some surface."@en ;
