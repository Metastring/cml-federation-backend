    rdfs:label "isotherm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:Temperature ;
            owl:onProperty sorelph:hasConstantQuantity ],
        sorepsf:Isopleth .

sorepsf:ThicknessLine a owl:Class ;
    rdfs:label "thickness line"@en ;
    rdfs:comment "A line drawn through all geographic points at which the thickness of a given atmospheric layer is the same; an isopleth of thickness."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropst:Thickness ;
            owl:onProperty sorelph:hasConstantQuantity ],
        sorepsf:Isopleth .

sorepsl:BernoulliTheorem a owl:Class ;
    rdfs:label "bernoulli theorem"@en ;
    rdfs:comment "As originally formulated, a statement of the conservation of energy (per unit mass) for an inviscid fluid in steady motion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasProperty ;
            owl:someValuesFrom sopropsp:Velocity ],
        sorepsl:PhysicalLaw .

sorepsl:BouguerLaw a owl:Class ;
    rdfs:label "bouguer law"@en ;
    rdfs:comment "Attenuation of a beam of light by an optically homogeneous (transparent) medium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soprocw:Attenuation ;
            owl:onProperty sorel:hasProcess ],
        sorepsl:EmpiricalLaw .

sorepsl:BuysBallotLaw a owl:Class ;
    rdfs:label "buys ballot law"@en ;
    rdfs:comment "A law describing the relationship of the horizontal wind direction in the atmosphere to the pressure distribution."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorel:hasProperty ;
            owl:someValuesFrom sopropp:Pressure ],
        [ a owl:Restriction ;
            owl:allValuesFrom sophatmow:Wind ;
            owl:onProperty sorel:hasPhenomena ],
        sorepsl:EmpiricalLaw .

sorepsl:DarcysLaw a owl:Class ;
    rdfs:label "darcys law"@en ;
    rdfs:subClassOf sorepsl:EmpiricalLaw .

sorepsl:HookesLaw a owl:Class ;
    rdfs:label "hookes law"@en ;
    rdfs:subClassOf sorepsl:EmpiricalLaw .

sorepsl:IdealGasLaw a owl:Class ;
    rdfs:label "ideal gas law"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Gas ;
            owl:onProperty sorel:hasState ],
        sorepsl:PhysicalLaw .

sorepsl:MathematicalTheorem a owl:Class ;
    rdfs:label "mathematical theorem"@en ;
    rdfs:subClassOf sorep:Knowledge .

sorepsl:StokesLaw a owl:Class ;
    rdfs:label "stokes law"@en ;
