sophw:GravityWave a owl:Class ;
    rdfs:label "gravity wave"@en ;
    rdfs:comment "A wave disturbance in which buoyancy (or reduced gravity) acts as the restoring force on parcels displaced from hydrostatic equilibrium."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelph:hasRestoringForce ;
            owl:someValuesFrom sophft:Buoyancy ],
        sophw:FluidWave .

soprocsc:StateChange a owl:Class ;
    rdfs:label "state change"@en ;
    rdfs:comment "change of state by state variable change"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sostp:StateOfMatter ;
            owl:onProperty sorelph:from ],
        [ a owl:Restriction ;
            owl:allValuesFrom sostp:StateOfMatter ;
            owl:onProperty sorelph:to ],
        soprocp:PhysicalProcess .

