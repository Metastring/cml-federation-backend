sostp:Solid a sostp:StateOfMatter,
        owl:NamedIndividual ;
    rdfs:label "solid"@en .

sohur:ExperimentActivity a owl:Class ;
    rdfs:label "experiment activity"@en ;
    rdfs:subClassOf sohur:Experiment .

sophatmofo:Fog a owl:Class ;
    rdfs:label "fog"@en ;
    rdfs:comment "Water droplets suspended in the atmosphere in the vicinity the earth's surface that affect visibility."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:PlanetarySurface ;
            owl:onProperty sorel:hasRealm ],
        sophatmoc:Stratiform .

sophw:Wave a owl:Class ;
    rdfs:label "wave"@en ;
    rdfs:subClassOf sophsy:Oscillation .

soprop:Property a owl:Class ;
    rdfs:label "property"@en .

soprope:Energy a owl:Class ;
    rdfs:label "energy"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:joule ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:ExtensiveProperty .

sopropsdis:WavelengthBand_nm a owl:Class ;
    rdfs:label "wavelength band nm"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:nanometer ;
            owl:onProperty sorelsc:hasUnit ],
        sopropsdis:WavelengthBand .

soreahb:BodyOfWater a owl:Class ;
    rdfs:label "body of water"@en ;
    rdfs:subClassOf soreah:HydrosphereFeature .

sorelsp:spatialRelation a owl:ObjectProperty ;
    rdfs:label "spatial relation"@en ;
    rdfs:domain sorepsg:GeometricalObject ;
    rdfs:range sorepsg:GeometricalObject ;
    rdfs:subPropertyOf sorelm:relation .

sostre:RealmConfiguration a owl:Class ;
    rdfs:label "realm configuration"@en ;
    rdfs:subClassOf sostp:PhysicalState .

sopropp:Pressure a owl:Class ;
    rdfs:label "pressure"@en ;
    rdfs:comment "Force per unit area."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropq:Force ;
            owl:onProperty sorelm:hasFirstOperand ],
        [ a owl:Restriction ;
            owl:allValuesFrom sopropsm:Area ;
            owl:onProperty sorelm:hasSecondOperand ],
        [ a owl:Restriction ;
            owl:hasValue sorepsu:pascal ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sopropq:IntensiveProperty,
        sorepmo:Ratio .

soreah:HydrosphereFeature a owl:Class ;
    rdfs:label "hydrosphere feature"@en ;
    rdfs:subClassOf sorea:PlanetaryRealm .

sorelsc:hasUnit a owl:ObjectProperty ;
    rdfs:label "has unit"@en ;
    rdfs:domain sopropq:Quantity ;
    rdfs:range sorepsu:Unit .

sorep:Representation a owl:Class ;
    rdfs:label "representation"@en .

sorepm:NumericalEntity a owl:Class ;
    rdfs:label "numerical entity"@en ;
    rdfs:subClassOf sorep:Representation .

sorepsu:meter a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "meter"@en ;
    sorelsc:hasSymbol "m" ;
    owl:sameAs sorepsu:metre ;
    skos:notation "m"^^qudt:UCUMcs .

<http://sweetontology.net/state> a owl:Ontology ;
    rdfs:label "SWEET Ontology State" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:versionInfo "3.6.0" .

somac:InorganicAcid a owl:Class ;
    rdfs:label "inorganic acid"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostc:Acid ;
            owl:onProperty sorel:hasState ],
        somac:InorganicCompound .

sophatmowm:MountainWind a owl:Class ;
    rdfs:label "mountain wind"@en ;
    rdfs:comment "A nocturnal, thermally forced wind from the direction of the mountains, generated by cooling along the mountain slopes; a downvalley wind, or the nighttime downslope (katabatic) component of a mountain?plains wind system."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealo:Mountain ;
            owl:onProperty sorel:hasRealm ],
        sophatmowm:MesoscaleWind .

sopropsdis:Distance a owl:Class ;
    rdfs:label "distance"@en ;
    rdfs:subClassOf sopropsdis:Length .

sorelsc:measureOf a owl:ObjectProperty ;
    rdfs:label "measure of"@en ;
    rdfs:domain soprop:Property .

<http://sweetontology.net/reprMath> a owl:Ontology ;
    rdfs:label "SWEET Ontology Representation Mathematics" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/relaMath>,
        <http://sweetontology.net/repr> ;
    owl:versionInfo "3.6.0" .

sorepsrs:HorizontalCoordinateSystem a owl:Class ;
    rdfs:label "horizontal coordinate system"@en ;
    rdfs:subClassOf sorepsrs:SpatialReferenceSystem .

sohueccont:EnvironmentalControlStrategy a owl:Class ;
    rdfs:label "environmental control strategy"@en ;
    rdfs:subClassOf sohud:ControlStrategy .

somaio:Ion a owl:Class ;
    rdfs:label "ion"@en ;
    rdfs:comment "An ion is an atom or molecule where the total number of electrons is not equal to the total number of protons, giving it a net positive or negative electrical charge. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Ionized ;
            owl:onProperty sorel:hasState ],
        soma:Substance .

soproc:Force a owl:Class ;
    rdfs:label "force"@en ;
    rdfs:subClassOf soproc:Process .

sopropo:Age a owl:Class ;
    rdfs:label "age"@en ;
    rdfs:subClassOf sorept:Time .

sorel:hasProcess a owl:ObjectProperty ;
    rdfs:label "has process"@en ;
    rdfs:range soproc:Process .

sorepsg3:GeometricalObject_3D a owl:Class ;
    rdfs:label "geometrical object 3d"@en ;
    rdfs:subClassOf sorep:D,
        sorepsg:GeometricalObject .

sostdp:DataState a owl:Class ;
    rdfs:label "data state"@en ;
    rdfs:subClassOf sostsy:SystemState .

somapl:Vegetation a owl:Class ;
    rdfs:label "vegetation"@en ;
    rdfs:subClassOf somapl:Plant .

somas:Sediment a owl:Class ;
    rdfs:label "sediment"@en ;
    rdfs:subClassOf soma:Mixture .

<http://sweetontology.net/propOrdinal> a owl:Ontology ;
    rdfs:label "SWEET Ontology Property Ordinal" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/prop>,
        <http://sweetontology.net/propEnergyFlux>,
        <http://sweetontology.net/relaSci>,
        <http://sweetontology.net/repr>,
        <http://sweetontology.net/reprMath>,
        <http://sweetontology.net/reprTime> ;
    owl:versionInfo "3.6.0" .

sopropo:SpatialScale a owl:Class ;
    rdfs:label "spatial scale"@en ;
    rdfs:subClassOf sorep:OrdinalScale .

sorea:Earth a soreaab:Planet,
        owl:NamedIndividual ;
    rdfs:label "earth"@en .

sorepsu:UnitDerivedByRaisingToPower a owl:Class ;
    rdfs:label "unit derived by raising to power"@en ;
    rdfs:subClassOf sorepsu:ComplexUnit .

sohud:DecisionActivity a owl:Class ;
    rdfs:label "decision activity"@en ;
    rdfs:subClassOf sohu:HumanActivity .

sophatmow:Wind a owl:Class ;
    rdfs:label "wind"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropp:PressureGradient ;
            owl:onProperty sorelsc:hasCause ],
        sophatmo:MeteorologicalPhenomena .

sopropt:TemperatureRange a owl:Class ;
    rdfs:label "temperature range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sopropt:Temperature ;
            owl:onProperty sorelsc:rangeOf ],
        sopropq:IntervalQuantity .

sopropti:Duration a owl:Class ;
    rdfs:label "duration"@en ;
    rdfs:subClassOf sopropti:TemporalRange,
        sorepm:Interval ;
    owl:equivalentClass sopropti:DurationDescription,
        sopropti:TimeInterval .

sopropq:ElectromagneticQuantity a owl:Class ;
    rdfs:label "electromagnetic quantity"@en ;
    rdfs:subClassOf soprop:ElectromagneticRadiationProperty,
        sopropq:Quantity .

sorelpr:hadProcess a owl:ObjectProperty ;
    rdfs:label "had process"@en .

sostb:BiologicalState a owl:Class ;
    rdfs:label "biological state"@en ;
    rdfs:subClassOf sost:State .

sostti:Period a owl:Class ;
    rdfs:label "period"@en ;
    rdfs:comment "Eras are divided into periods. [Wikipedia]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelt:temporalPartOf ;
            owl:someValuesFrom sostti:Era ],
        sostti:GeologicTimeUnit .

<http://sweetontology.net/procPhysical> a owl:Ontology ;
    rdfs:label "SWEET Ontology Process Physical" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/proc>,
        <http://sweetontology.net/reprSciProvenance>,
        <http://sweetontology.net/reprSpaceGeometry> ;
    owl:versionInfo "3.6.0" .

soreal:Landform a owl:Class ;
    rdfs:label "landform"@en ;
    rdfs:comment "A landform comprises a geomorphological unit, and is largely defined by its surface form and location in the landscape, as part of the terrain, and as such, is typically an element of topography. Landforms are categorised by features such as elevation, slope, orientation, stratification, rock exposure, and soil type. They include berms, mounds, hills, cliffs, valleys, rivers and numerous other elements."@en ;
    rdfs:subClassOf soreal:LandRegion .

sostp:PhysicalState a owl:Class ;
    rdfs:label "physical state"@en ;
    rdfs:subClassOf sost:State .

sostrr:RepresentativeRole a owl:Class ;
    rdfs:label "representative role"@en ;
    rdfs:subClassOf soprop:Role,
        sopropo:OrdinalProperty .

soph:Phenomena a owl:Class ;
    rdfs:label "phenomena"@en .

sophatmoc:Cloud a owl:Class ;
    rdfs:label "cloud"@en ;
    rdfs:comment "A visible aggregate of minute water droplets and/or ice particles in the atmosphere above the earth's surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty sorelch:hasSubstance ;
            owl:someValuesFrom somaae:CloudCondensationNuclei ],
        [ a owl:Restriction ;
            owl:onProperty sorelch:hasSubstance ;
            owl:someValuesFrom somaw:Ice ],
        sophatmo:MeteorologicalPhenomena .

sophb:BiologicalPhenomena a owl:Class ;
    rdfs:label "biological phenomena"@en ;
    rdfs:subClassOf soph:Phenomena .

sorepmf:Function a owl:Class ;
    rdfs:label "function"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorep:IndependentVariable ;
            owl:onProperty sorelm:hasInput ],
        [ a owl:Restriction ;
            owl:allValuesFrom sorep:DependentVariable ;
            owl:onProperty sorelm:hasOutput ],
        sorepmo:Operation .

sostrb:BiologicalRole a owl:Class ;
    rdfs:label "biological role"@en ;
    rdfs:subClassOf soprop:Role .

sophso:SolidPhenomena a owl:Class ;
    rdfs:label "solid phenomena"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        soph:Phenomena .

sopropo:Impact a owl:Class ;
    rdfs:label "impact"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropo:Visibility a owl:Class ;
    rdfs:label "visibility"@en ;
    rdfs:subClassOf sopropo:OrdinalProperty .

sopropq:Quantity a owl:Class ;
    rdfs:label "quantity"@en ;
    rdfs:subClassOf sopropq:ScientificQuantity .

sostrc:ChemicalRole a owl:Class ;
    rdfs:label "chemical role"@en ;
    rdfs:subClassOf soprop:Role .

soman:Animal a owl:Class ;
    rdfs:label "animal"@en ;
    rdfs:subClassOf somab:Organism .

sophatmo:MeteorologicalPhenomena a owl:Class ;
    rdfs:label "meteorological phenomena"@en ;
    rdfs:subClassOf sophatmo:AtmosphericPhenomena .

sophec:EcologicalDynamics a owl:Class ;
    rdfs:label "ecological dynamics"@en ;
    rdfs:subClassOf sophec:EcologicalPhenomena .

sopropq:PhysicalQuantity a owl:Class ;
    rdfs:label "physical quantity"@en ;
    rdfs:subClassOf soprop:PhysicalProperty,
        sopropq:Quantity .

sopropdr:DimensionlessRatio a owl:Class ;
    rdfs:label "dimensionless ratio"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sorepsu:dimensionlessUnit ;
            owl:onProperty sorelsc:hasDefaultUnit ],
        sorepmo:Ratio .

soprocc:ChemicalProcess a owl:Class ;
    rdfs:label "chemical process"@en ;
    rdfs:comment "A chemical process is a method or means of somehow changing one or more chemicals or chemical compounds.  [Wikipedia]"@en ;
    rdfs:subClassOf soproc:Process ;
    owl:equivalentClass soprocc:ChemicalReaction,
        soprocc:Reaction .

