    rdfs:label "periodic"@en .

sosttf:Seasonal a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "seasonal"@en ;
    sorelt:hasPeriod sostti:month .

sosttf:SemiAnnual a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "semi annual"@en ;
    sorelt:hasPeriod sostti:month .

sosttf:SemiDiurnal a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "semi diurnal"@en ;
    sorelt:hasPeriod sostti:hour .

sosttf:Spasmodic a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "spasmodic"@en .

sosttf:Steady a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "steady"@en .

sosttf:Usual a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "usual"@en ;
    sorelt:moreFrequentThan sosttf:Unusual .

sosttf:Weekly a soproptf:Frequency,
        owl:NamedIndividual ;
    rdfs:label "weekly"@en ;
    sorelt:hasPeriod sostti:week .

