        <http://sweetontology.net/phenAtmo>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/repr> ;
    owl:versionInfo "3.6.0" .

sorepsu:Unit a owl:Class ;
    rdfs:label "unit"@en ;
    rdfs:subClassOf sorep:Measurement .

sorepsu:perKelvin a sorepsu:UnitDerivedByRaisingToPower,
        owl:NamedIndividual ;
    rdfs:label "per kelvin"@en ;
    sorelm:toThePower -1.0 ;
    sorelsc:hasBaseUnit sorepsu:kelvin ;
    skos:notation "/K"^^qudt:UCUMcs .

sorepsu:radian a sorepsu:BaseUnit,
        owl:NamedIndividual ;
    rdfs:label "radian"@en ;
    sorelsc:hasSymbol "rad" ;
    skos:notation "rad"^^qudt:UCUMcs .

sostef:AClass a owl:Class ;
    rdfs:label "a class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.00000001 ;
            owl:onProperty sorelm:hasLowerBound ],
        [ a owl:Restriction ;
            owl:hasValue 0.0000001 ;
            owl:onProperty sorelm:hasUpperBound ],
        sopropo:FlareClass .

sostef:BClass a owl:Class ;
    rdfs:label "b class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.0000001 ;
            owl:onProperty sorelm:hasLowerBound ],
        [ a owl:Restriction ;
            owl:hasValue 0.000001 ;
            owl:onProperty sorelm:hasUpperBound ],
        sopropo:FlareClass .

sostef:CClass a owl:Class ;
    rdfs:label "c class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.000001 ;
            owl:onProperty sorelm:hasLowerBound ],
        [ a owl:Restriction ;
            owl:hasValue 0.00001 ;
            owl:onProperty sorelm:hasUpperBound ],
        sopropo:FlareClass .

sostef:MClass a owl:Class ;
    rdfs:label "m class"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue 0.00001 ;
            owl:onProperty sorelm:hasLowerBound ],
        [ a owl:Restriction ;
            owl:hasValue 0.0001 ;
            owl:onProperty sorelm:hasUpperBound ],
        sopropo:FlareClass .

sostp:Liquid a sostp:StateOfMatter,
