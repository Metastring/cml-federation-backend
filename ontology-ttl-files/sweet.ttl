    owl:versionInfo "3.6.0" .

sohut:Departure a owl:Class ;
    rdfs:label "departure"@en ;
    rdfs:subClassOf sohu:HumanActivity .

somaae:Aerosol a owl:Class ;
    rdfs:label "aerosol"@en ;
    rdfs:subClassOf soma:SuspendedSubstance .

<http://sweetontology.net/matrAnimal> a owl:Ontology ;
    rdfs:label "SWEET Ontology Material Animal" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matrBiomass> ;
    owl:versionInfo "3.6.0" .

somab:Food a owl:Class ;
    rdfs:label "food"@en ;
    rdfs:subClassOf somab:Biomass .

somab:LivingEntity a owl:Class ;
    rdfs:label "living entity"@en ;
    rdfs:subClassOf soma:Substance .

somac:Salt a somac:InorganicCompound,
        owl:NamedIndividual ;
    rdfs:label "salt"@en .

somael:AlkaliMetal a owl:Class ;
    rdfs:label "alkali metal"@en ;
    rdfs:subClassOf somael:Metal .

somael:AlkalineEarthMetal a owl:Class ;
    rdfs:label "alkaline earth metal"@en ;
    rdfs:subClassOf somael:Metal .

somael:Chalcogen a owl:Class ;
    rdfs:label "chalcogen"@en ;
    rdfs:subClassOf somael:Element .

somael:Metalloid a owl:Class ;
    rdfs:label "metalloid"@en ;
    rdfs:subClassOf somael:Element ;
    owl:disjointWith somael:Nonmetal .

somaen:EnergyConversionDevice a owl:Class ;
    rdfs:label "energy conversion device"@en ;
    rdfs:subClassOf somaeq:Infrastructure .

somaen:EnergyDistributionSystem a owl:Class ;
    rdfs:label "energy distribution system"@en ;
    rdfs:subClassOf somaeq:Infrastructure .

somaeq:Aircraft a owl:Class ;
    rdfs:label "aircraft"@en ;
    rdfs:comment "An aircraft is a vehicle which is able to fly through the air (or through any other atmosphere). All the human activity which surrounds aircraft is called aviation. (Most rocket vehicles are not aircraft because they are not supported by the surrounding air)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorea:Atmosphere ;
            owl:onProperty sorel:hasRealm ],
        somaeq:Equipment .

somaeq:Spacecraft a owl:Class ;
    rdfs:label "spacecraft"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom soreaab:OuterSpace ;
            owl:onProperty sorel:hasRealm ],
        somaeq:TransportationEquipment .

somaeq:TransportationEquipment a owl:Class ;
    rdfs:label "transportation equipment"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sohut:Transportation ;
            owl:onProperty sorelh:hasHumanActivity ],
        somaeq:Equipment .

<http://sweetontology.net/matrIon> a owl:Ontology ;
    rdfs:label "SWEET Ontology Material Ion" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    owl:imports <http://sweetontology.net/matr>,
        <http://sweetontology.net/matrCompound>,
        <http://sweetontology.net/matrElement>,
        <http://sweetontology.net/matrElementalMolecule>,
        <http://sweetontology.net/rela>,
        <http://sweetontology.net/relaChemical>,
        <http://sweetontology.net/relaPhysical>,
        <http://sweetontology.net/state>,
        <http://sweetontology.net/statePhysical> ;
    owl:versionInfo "3.6.0" .

somanr:FossilFuel a owl:Class ;
    rdfs:label "fossil fuel"@en ;
    rdfs:comment "Fossil fuels or mineral fuels are fuels formed by the natural resources such as anaerobic decomposition of buried dead organisms that lived up to 300 million years ago. These fuels contain high percentage of carbon and hydrocarbons. [Wikipedia]"@en ;
    rdfs:subClassOf somanr:NaturalResource .

somaoc:Methane a somaoc:Hydrocarbon,
        owl:NamedIndividual ;
    rdfs:label "methane"@en .

somapa:EnergeticParticle a owl:Class ;
    rdfs:label "energetic particle"@en ;
    rdfs:subClassOf somapa:SubatomicParticle .

somarock:Melange a owl:Class ;
    rdfs:label "melange"@en ;
    rdfs:comment "A mélange is a large scale breccia, a mappable body of rock characterized by a lack of continuous bedding and the inclusion of fragments of rock of all sizes, contained in a fine-grained deformed matrix. The mélange typically consists of a jumble of large blocks of varied lithologies of altered oceanic crustal material and blocks of continental slope sediments in a sheared mudstone matrix. Some larger blocks of rock may be as much as 1 km across. [Wikipedia]"@en ;
    rdfs:subClassOf somarock:Rock .

somarocki:AnorogenicIgneousRock a owl:Class ;
    rdfs:label "anorogenic igneous rock"@en ;
    rdfs:comment "Anorogenic granites are formed above volcanic ‘hot spot’ activity and have peculiar mineralogy and geochemistry. These granites are formed by melting of the lower crust under conditions that are usually extremely dry. The rhyolites of the Yellowstone caldera are examples of volcanic equivalents of A-type granite. [Wikipedia]"@en ;
    rdfs:subClassOf somarocki:IntrusiveRock .

somarocki:VolcanicCone a owl:Class ;
    rdfs:label "volcanic cone"@en ;
    rdfs:comment "A mound of loose material that was ejected ballistically."@en ;
    rdfs:subClassOf somarocki:VolcanicRock .

somas:DebrisFlow a owl:Class ;
    rdfs:label "debris flow"@en ;
    rdfs:comment "A mixture of water-saturated rock debris that flows downslope under the force of gravity (also called lahar or mudflow)."@en ;
    rdfs:subClassOf soma:Mixture .

somas:Sand a owl:Class ;
    rdfs:label "sand"@en ;
    rdfs:subClassOf somas:Sediment .

somaw:Drop a owl:Class ;
    rdfs:label "drop"@en ;
    rdfs:subClassOf somaw:LiquidWater .

somaw:Frost a owl:Class ;
    rdfs:label "frost"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Frozen ;
            owl:onProperty sorel:hasState ],
        somaw:WaterSubstance .

somaw:Snow a owl:Class ;
    rdfs:label "snow"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue sostp:Solid ;
            owl:onProperty sorel:hasState ],
        somaw:WaterSubstance .

soph:Precipitation a owl:Class ;
    rdfs:label "precipitation"@en ;
    rdfs:subClassOf soph:Phenomena .

sophatmo:MountainWave a owl:Class ;
    rdfs:label "mountain wave"@en ;
    rdfs:comment "An atmospheric gravity wave, formed when stable air flow passes over a mountain or mountain barrier."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sorealo:Mountain ;
            owl:onProperty sorel:hasRealm ],
        sophatmo:AtmosphericWave .

sophatmo:WeatherCondition a owl:Class ;
    rdfs:label "weather condition"@en .

<http://sweetontology.net/phenAtmoCloud> a owl:Ontology ;
    rdfs:label "SWEET Ontology Phenomena Atmosphere Cloud" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
