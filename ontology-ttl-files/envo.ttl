    obo:IAO_0000115 "charcoal that is used as a soil amendment." ;
    oboInOwl:created_by <https://orcid.org/0000-0002-6601-2165> ;
    oboInOwl:creation_date "2018-11-03T19:28:29+00:00"^^xsd:dateTime ;
