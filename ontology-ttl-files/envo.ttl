            owl:someValuesFrom obo:ENVO_00002000 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0002354 ;
            owl:someValuesFrom obo:ENVO_03000006 ],
        obo:ENVO_00000137 .

