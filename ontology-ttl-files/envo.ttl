obo:ENVO_00000247 a owl:Class ;
    rdfs:label "volcano" ;
    obo:IAO_0000115 "An opening, or rupture, in the Earth's surface or crust, which allows hot, molten rock, ash and gases to escape from deep below the surface." ;
