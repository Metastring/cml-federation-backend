obo:UBERON_0002346 a owl:Class ;
    rdfs:label "neurectoderm" ;
    obo:IAO_0000115 "Embryonic ectoderm that gives rise to nervous tissue." ;
    oboInOwl:hasExactSynonym "neural ectoderm",
        "neuroectoderm" ;
    oboInOwl:hasRelatedSynonym "epithelium tubi neuralis; neuroectoderma",
        "neuaral ectoderm",
