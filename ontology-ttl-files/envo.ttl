obo:UBERON_0002390 a owl:Class ;
    rdfs:label "hematopoietic system" ;
    obo:IAO_0000115 "Anatomical system that is involved in the production of hematopoietic cells." ;
    oboInOwl:hasExactSynonym "haematological system",
        "haemopoietic system",
        "organa haemopoietica" ;
    oboInOwl:hasRelatedSynonym "Blutbildungssystem",
        "haematopoietic system",
        "hematological system",
        "hematolymphoid system",
        "hemopoietic system" ;
