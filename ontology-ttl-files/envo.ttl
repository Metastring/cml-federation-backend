    oboInOwl:hasDbXref <http://www.langual.org/langual_thesaurus.asp?termid=B3357> ;
    rdfs:comment "LanguaL curation note: This term is for CLASSIFICATION ONLY; DO NOT USE term in indexing. Use a more precise narrower term."@en .

obo:FOODON_03414459 a owl:Class ;
    rdfs:label "cucumis species"@en ;
    obo:IAO_0000114 obo:IAO_0000428 ;
    obo:IAO_0000115 "Cucumis is a genus of twining, tendril-bearing plants in the *Cucurbitaceae* family which includes the cucumber (*Cucumis sativus*), muskmelons (*Cucumis melo*, including cantaloupe and honeydew), the horned melon (*Cucumis metuliferus*), and the West Indian gherkin (*Cucumis anguria*). [https://en.wikipedia.org/wiki/Cucumis]"@en ;
    oboInOwl:hasDbXref <http://www.langual.org/langual_thesaurus.asp?termid=B4459> ;
    rdfs:subClassOf obo:FOODON_03414460 .

obo:FOODON_03414460 a owl:Class ;
    rdfs:label "gourd/squash family"@en ;
    obo:IAO_0000114 obo:IAO_0000428 ;
    obo:IAO_0000115 """The *Cucurbitaceae*, also called cucurbits and the gourd family, are a plant family consisting of about 965 species in around 95 genera, the most important of which are: 
  *Cucurbita* - squash, pumpkin, zucchini, some gourds; 
  *Lagenaria* - calabash, and others that are inedible; 
  *Citrullus* - watermelon (*C. lanatus, C. colocynthis*) and others; 
  *Cucumis* - cucumber (*C. sativus*), various melons; 
  *Luffa* - luffa, loofah"""@en ;
    obo:IAO_0000119 <https://en.wikipedia.org/wiki/Cucurbitaceae> ;
    oboInOwl:hasDbXref <http://www.langual.org/langual_thesaurus.asp?termid=B4460> ;
    oboInOwl:hasSynonym "cucurbitaceae"@en ;
    rdfs:subClassOf obo:FOODON_03413357 .

