        "Geonames:U.BNKU",
        "Geonames:U.SHLU",
        "Geonames:U.SHSU",
        "Geonames:U.TNGU",
        "SWEETRealm:Bar",
        "TGN:21177",
        "TGN:21480",
        "TGN:21531",
        "TGN:23191" ;
    oboInOwl:hasRelatedSynonym "Shoal",
        "ball",
