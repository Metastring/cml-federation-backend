obo:UBERON_0002203 a owl:Class ;
    rdfs:label "vasculature of eye" ;
    obo:IAO_0000115 "Vasculature that is part of the eye region." ;
    oboInOwl:hasExactSynonym "eye vascular network",
        "ocular blood vessel",
        "ocular vasculature",
        "vascular network of eye" ;
    oboInOwl:hasRelatedSynonym "eye vasculature",
