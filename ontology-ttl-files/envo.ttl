        "Geonames:H.CHN",
        "Geonames:U.SCNU",
        "Geonames:U.SCSU",
        "SWEETRealm:Channel",
        "TGN:21137",
        "TGN:23451" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:ENVO_00000141 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:ENVO_00000501 ],
