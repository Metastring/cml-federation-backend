        obo:ENVO_00000094,
        obo:ENVO_00000176 .

obo:ENVO_00000479 a owl:Class ;
    rdfs:label "mouth" ;
    obo:IAO_0000115 "The exit or point of discharge of a stream into another stream, lake or sea." ;
    oboInOwl:hasDbXref "EcoLexicon:outlet",
        "SWEETRealm:Mouth",
        "https://en.wikipedia.org/wiki/Mouth" ;
    oboInOwl:hasExactSynonym "MOUTH" ;
    oboInOwl:hasRelatedSynonym "outlet" ;
