obo:ENVO_00000444 a owl:Class ;
    rdfs:label "woodland clearing" ;
    obo:IAO_0000115 "A tract of land which has few or no trees and is surrounded by more heavily wooded areas." ;
    oboInOwl:hasDbXref "FTT:259",
