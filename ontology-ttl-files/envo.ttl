obo:ENVO_00000523 a owl:Class ;
    rdfs:label "cutoff" ;
    obo:IAO_0000115 "A channel formed as a result of a stream cutting through a meander neck." ;
    oboInOwl:hasDbXref "FTT:462",
        "Geonames:CUTF",
        "TGN:21134",
        "https://en.wikipedia.org/wiki/Cutoff" ;
    oboInOwl:hasExactSynonym "cut off",
