                        owl:onProperty obo:RO_0002507 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( obo:ENVO_00000063 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0002473 ;
                                            owl:someValuesFrom obo:ENVO_00002011 ] ) ] ] ) ] .

