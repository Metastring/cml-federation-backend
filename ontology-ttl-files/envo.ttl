        "portion of scat",
        "scat",
        "spraint" ;
    oboInOwl:hasRelatedSynonym "droppings",
        "excrement",
        "ordure",
        "spoor" ;
    rdfs:subClassOf obo:UBERON_0000174 .

obo:UBERON_0002200 a owl:Class ;
    rdfs:label "vasculature of head" ;
    obo:IAO_0000115 "Vasculature that is part of a head [Automatically generated definition]." ;
    oboInOwl:hasExactSynonym "adult head vascular network",
        "adult head vasculature",
