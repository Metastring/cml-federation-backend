obo:ENVO_00000530 a owl:Class ;
    rdfs:label "apron" ;
    obo:IAO_0000115 "A gentle slope, with a generally smooth surface, particularly found around groups of islands and seamounts." ;
    oboInOwl:hasDbXref "EcoLexicon:apron",
