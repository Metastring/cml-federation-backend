    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000050 ;
            owl:someValuesFrom obo:UBERON_0002416 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
