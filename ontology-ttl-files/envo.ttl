    oboInOwl:hasRelatedSynonym "cerro",
        "foothill",
        "hill",
        "hillock",
        "hills",
        "knoll",
        "mount",
        "mountain" ;
    rdfs:subClassOf obo:ENVO_00000477 .

obo:ENVO_00000086 a owl:Class ;
    rdfs:label "plain" ;
    obo:IAO_0000115 "A region of general uniform slope, comparatively level, and of considerable extent." ;
    oboInOwl:hasDbXref "EcoLexicon:plain",
        "FTT:707",
        "FTT:874",
        "FTT:926",
        "Geonames:T.PLN",
        "SWEETRealm:Plain",
        "TGN:21461",
