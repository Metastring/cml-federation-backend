        obo:UBERON_0005090 .

obo:UBERON_0010371 a owl:Class ;
    rdfs:label "ecto-epithelium" ;
    obo:IAO_0000115 "Epithelium composed of cells that develops from the ectoderm[FMA,modified]." ;
    oboInOwl:hasExactSynonym "ectoderm-derived epithelium" ;
