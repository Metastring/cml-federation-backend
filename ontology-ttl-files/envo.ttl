            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom obo:ENVO_01001170 ],
        obo:BFO_0000003,
        obo:OBI_0000011 .

obo:FOODON_00001015 a owl:Class ;
    rdfs:label "plant food product"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "A food product which has as a defining ingredient some plant material."@en ;
    dc:contributor <https://orcid.org/0000-0002-8844-9165> ;
    rdfs:subClassOf obo:FOODON_00001002,
        obo:FOODON_00004331 .

obo:FOODON_00001635 a owl:Class ;
    rdfs:label "bean food product"@en ;
    obo:IAO_0000115 "A bean vegetable food product is a human or animal food product - such as a snap, shell or dry bean product - derived from the fruit pod, seed, or leaf of one of several genera of the flowering plant family Fabaceae."@en ;
    obo:IAO_0000116 "Note, this was previously labelled \"Bean (vegetable) food product\". We have been listing both dry and freshly harvested moist beans here, so have broadened the name scope."@en ;
    dcterms:contributor "Damion Dooley"@en ;
    rdfs:seeAlso obo:FOODON_00002428,
        <http://www.fao.org/es/faodef/fdef04e.htm#4.02>,
        <https://oconto.extension.wisc.edu/files/2011/02/The-Importance-of-Dry-Beans-in-Your-Diet.pdf> ;
    rdfs:subClassOf obo:FOODON_00001264,
        obo:FOODON_00002153 .

obo:NCBITaxon_33090 a owl:Class ;
    rdfs:label "Viridiplantae" ;
    oboInOwl:hasExactSynonym "Chlorophyta/Embryophyta group",
        "chlorophyte/embryophyte group",
        "green plants",
        "plants" ;
    oboInOwl:hasRelatedSynonym "Chlorobionta",
