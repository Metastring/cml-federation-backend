    oboInOwl:hasRelatedSynonym "shoot (related)" ;
    oboInOwl:id "PO:0025029" ;
    oboInOwl:inSubset <http://purl.obolibrary.org/obo/po#Angiosperm>,
        <http://purl.obolibrary.org/obo/po#Arabidopsis>,
        <http://purl.obolibrary.org/obo/po#Maize>,
        <http://purl.obolibrary.org/obo/po#Poaceae>,
        <http://purl.obolibrary.org/obo/po#Rice>,
