    dcterms:contributor "Damion Dooley"@en ;
    schema1:image <https://upload.wikimedia.org/wikipedia/commons/thumb/f/fb/Hotdog_-_Evan_Swigart.jpg/640px-Hotdog_-_Evan_Swigart.jpg> ;
    oboInOwl:hasExactSynonym "hotdog"@en ;
    oboInOwl:hasNarrowSynonym "frankfurter"@en ;
    rdfs:seeAlso obo:FOODON_03307053 ;
    rdfs:subClassOf obo:FOODON_00001224 .

