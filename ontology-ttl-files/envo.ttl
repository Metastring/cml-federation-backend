    rdfs:subClassOf obo:ENVO_00010483 .

obo:ENVO_03501310 a owl:Class ;
    rdfs:label "switch"@en ;
    obo:IAO_0000115 "A device which can connect, disconnect, or divert current in an electrical circuit."@en ;
