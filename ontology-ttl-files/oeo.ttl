:OEO_00020109 a owl:Class ;
    rdfs:label "market premium"@en ;
    obo:IAO_0000115 "A market premium is an economic instrument that ensures a guaranteed remuneration, e.g. a fixed feed-in tariff, by paying to the producing agent the difference between a guaranteed return on a good/product and the monetary price for which the good/product is traded on the market."@en ;
    obo:IAO_0000118 "Marktprämie"@de ;
    rdfs:subClassOf :OEO_00010456 ;
