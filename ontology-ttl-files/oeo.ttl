                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01013> [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0019002 ;
                                            owl:someValuesFrom :OEO_00020040 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
