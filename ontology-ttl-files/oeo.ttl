                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom :OEO_00020202 ] ) ] ],
        :OEO_00040003 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1050
