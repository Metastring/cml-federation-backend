    rdfs:label "CRF sector (IPCC 2006): international bunkers and multilateral operations"@en ;
    obo:BFO_0000051 :OEO_00010200,
        :OEO_00010203 ;
    obo:IAO_0000115 "The CRF sector (IPCC 2006) international bunkers is a transport sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories. It encompasses international bunkers and multilateral operation." ;
    :OEO_00000504 :OEO_00000242 ;
    :OEO_00010037 "CRF 1.D" ;
