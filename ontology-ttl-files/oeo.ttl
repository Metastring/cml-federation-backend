            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom :OEO_00000117 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom :OEO_00010084 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00000503 ;
            owl:someValuesFrom :OEO_00110000 ],
        :OEO_00010086 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/78
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/758""" .

