pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2087""" .

<https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080000> a owl:Class ;
    rdfs:label "turboshaft gas turbine"@en ;
    obo:IAO_0000115 "A turboshaft gas turbine is a type of gas turbine that is optimized to produce shaft power."@en ;
    obo:IAO_0000118 "turboshaft engine"@en ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142""" ;
    rdfs:subClassOf :OEO_00000185 .

<https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080001> a owl:Class ;
    rdfs:label "turboprop gas turbine"@en ;
    obo:IAO_0000115 "A turboprop gas turbine is a gas turbine that drives an aircraft propeller. It works like a turboshaft turbine but is additionally able to produce jet thrust."@en ;
    obo:IAO_0000118 "turboprop engine"@en ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142""" ;
    rdfs:subClassOf :OEO_00000185 .

<https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080002> a owl:Class ;
    rdfs:label "turbofan gas turbine"@en ;
    obo:IAO_0000115 "A turbofan gas turbine is a gas turbine that produces jet thrust through its core engine and additional thrust through the connected fan."@en ;
    obo:IAO_0000118 "turbofan egine"@en ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142""" ;
    rdfs:subClassOf :OEO_00000185 .

<https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00080003> a owl:Class ;
    rdfs:label "turbojet gas turbine"@en ;
    obo:IAO_0000115 "A turbojet gas turbine is a gas turbine which produces only jet thrust."@en ;
    obo:IAO_0000118 "turbojet engine"@en ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/2132
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2142""" ;
    rdfs:subClassOf :OEO_00000185 .

<https://openenergyplatform.org/ontology/oeo/oeo-physical/OEO_00440000> a owl:Class ;
    rdfs:label "overhead power line"@en ;
    obo:IAO_0000115 "An overhead power line is a power line that is installed above the ground."@en ;
