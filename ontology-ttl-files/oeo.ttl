issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652""" .

:OEO_00020311 a owl:Class ;
    rdfs:label "with existing measures scenario"@en ;
    obo:IAO_0000115 "A with existing measures scenario (WEM) is a policy scenario that includes policy instruments and transformative measures that have been adopted and implemented." ;
    obo:IAO_0000118 "WEM scenario",
        "baseline scenario" ;
    obo:IAO_0000119 "Derived from https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32018R1999&from=EN#d1e968-1-1 Article 2" ;
    rdfs:subClassOf :OEO_00020309 ;
