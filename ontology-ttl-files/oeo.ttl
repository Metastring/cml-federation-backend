:OEO_00390104 a owl:Class ;
    rdfs:label "multi-criteria decision analysis"@en ;
    obo:IAO_0000115 "A multi-criteria decision analysis (MCDA) is a methodology for decision-making. It is an umbrella term to describe a collection of formal approaches, which seek to take explicit account of multiple criteria, comparing goals and outcomes by assigning weights to various criteria." ;
    obo:IAO_0000118 "MCDA" ;
    rdfs:subClassOf :OEO_00020166 ;
    :OEO_00020426 """Add
Issue: https://github.com/OpenEnergyPlatform/ontology/issues/1998
Pull: https://github.com/OpenEnergyPlatform/ontology/pull/2091""" .

:OEO_00390105 a owl:Class ;
    rdfs:label "delayed transition scenario"@en ;
    obo:IAO_0000115 "A delayed transition scenario is an explorative scenario whose intermediate transition indicators are not achieved." ;
    rdfs:subClassOf :OEO_00020248 ;
    :OEO_00020426 """add:
Issue: https://github.com/OpenEnergyPlatform/ontology/issues/2101
Pull Request: https://github.com/OpenEnergyPlatform/ontology/pull/2116""" .

:OEO_00390106 a owl:Class ;
    rdfs:label "technology scenario"@en ;
    obo:IAO_0000115 "An technology scenario is a scenario that investigates future system states with the focus on a specific technology." ;
    rdfs:subClassOf :OEO_00000364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000364 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom :OEO_00000407 ] ) ] ;
    :OEO_00020426 """add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2099
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2124""" .

:OEO_00390107 a owl:Class ;
    rdfs:label "sector focused scenario"@en ;
    obo:IAO_0000115 "A sector focused scenario is a scenario that focuses on a specific sector." ;
    rdfs:subClassOf :OEO_00000364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000364 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom :OEO_00000367 ] ) ] ;
