:OEO_00340006 a owl:Class ;
    rdfs:label "regionalisation"@en ;
    obo:IAO_0000115 "Regionalisation is a methodology to calculate spatially distributed energy producers and consumers with the aim to highlight regional differences in energy supply and potentials, particularly related to renewable energies." ;
    rdfs:subClassOf :OEO_00020166 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1554
