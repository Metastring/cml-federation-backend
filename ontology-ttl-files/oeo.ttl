:OEO_00010248 a owl:Class ;
    rdfs:label "heat gain process"@en ;
    obo:IAO_0000115 "A heat gain process is an energy transformation that has thermal energy as energy output." ;
    obo:IAO_0000118 "heat generation",
        "heat generation process",
        "heating" ;
    rdfs:comment "With the logical definition of heat gain process, heat transfer is inferred as subclass which is intended but depends on the perspective and the system boundaries. To avoid confusion, the main label was changed from heat generation to heat gain process." ;
    rdfs:subClassOf :OEO_00020003 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01013> [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0019002 ;
                                            owl:someValuesFrom :OEO_00000150 ] ) ] ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000117 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01014> [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0019001 ;
                                            owl:someValuesFrom :OEO_00000207 ] ) ] ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1045
