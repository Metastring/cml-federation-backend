pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1724""" .

:OEO_00010068 a owl:NamedIndividual,
        :OEO_00000422 ;
    rdfs:label "KSG sector transport"@en ;
    obo:BFO_0000051 :OEO_00010059,
        :OEO_00010060,
        :OEO_00010061,
        :OEO_00010062 ;
    obo:IAO_0000115 """The KSG sector transport is a transport sector defined by the KSG sector division. It is an aggregate of the following four sectors:
- CRF sector (IPCC 2006): domestic aviation (CRF 1.A.3.a)
- CRF sector (IPCC 2006): road transportation (CRF 1.A.3.b)
- CRF sector (IPCC 2006): railways (CRF 1.A.3.c)
- CRF sector (IPCC 2006): domestic navigation (CRF 1.A.3.d)""" ;
    obo:IAO_0000118 "KSG-Sektor Verkehr"@de ;
    obo:IAO_0000119 "Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html" ;
    :OEO_00000504 :OEO_00010056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/580
