www:ont00000106 a owl:Class ;
    rdfs:label "End of Life Stasis"@en ;
    rdfs:comment "An End of Life Stasis (EoL) is distinguished from a Stasis of Partially Mission Capable or Stasis of Non-Mission Capable in that EoL is more inclusive such that the participating Artifact may be either Partially or Non-Mission Capable. Additionally, EoL applies only to Artifacts and is typically determined in relation to its original mission and designed primary functions. In contrast, an Artifact's level of Mission Capability depends on the requirements of the mission under consideration such that a given Artifact may simultaneously be Fully Mission Capable for mission1, Partially Mission Capable for mission2, and Non-Mission Capable for mission3."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when the participating Artifact is no longer capable of realizing all of its designed primary Artifact Functions."@en ;
    www:ont00001753 "EOL",
        "EoL" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000609 a owl:Class ;
    rdfs:label "Gain of Disposition"@en ;
    rdfs:comment "This class should be used to demarcate the start of the temporal interval (through the BFO 'occupies temporal region' property) that the Entity bears the Disposition."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000642 ;
    skos:definition "A Gain of Realizable Entity in which some Independent Continuant becomes the bearer of some Disposition."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000644 a owl:Class ;
    rdfs:label "Oscillation Process"@en ;
    rdfs:comment "Oscillation is often thought of in the sense of motion, e.g., a swinging clock pendulum. However, the repetitive variation in location around a central point is technically a process of vibration, sometimes referred to as mechanical oscillation. Use the term Vibration Motion for those cases."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000004 ;
    skos:altLabel "Oscillation"@en ;
    skos:definition "A Change in which the dependent entity alternates between two or more stases."@en ;
    www:ont00001754 "https://en.wikipedia.org/w/index.php?title=Oscillation&oldid=1002978272"^^xsd:anyURI ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000660 a owl:Class ;
    rdfs:label "Effect"@en ;
    rdfs:comment "In CCO, the SubClassOf axioms are actually anonymous ancestors and inherited from process (BFO 2020)." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000139 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000117 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000132 ],
        obo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty www:ont00001819 ;
                        owl:someValuesFrom obo:BFO_0000015 ] ) ] ;
    skos:altLabel "Consequence"@en ;
    skos:definition "A Process that follows and is caused by some previous Process."@en ;
    :OEO_00020426 """issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016""" ;
    www:ont00001754 "http://wordnetweb.princeton.edu/perl/webwn?s=effect" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000819 a owl:Class ;
    rdfs:label "Stasis"@en ;
    rdfs:comment "In CCO, the SubClassOf axioms are actually anonymous ancestors and inherited from process (BFO 2020)." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000117 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000132 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000139 ],
        obo:BFO_0000015 ;
    skos:definition "A Process in which one or more Independent Continuants endure in an unchanging condition."@en ;
    :OEO_00020426 """issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016""" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000895 a owl:Class ;
    rdfs:label "Married"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000335 ;
    skos:altLabel "Married Stasis"@en ;
    skos:definition "A Stasis of Generically Dependent Continuant that consists of a socially, culturally, or ritually recognized union or legal contract between spouses that establishes rights and obligations between them, between them and their children, and between them and their in-laws."@en ;
    www:ont00001754 "https://en.wikipedia.org/w/index.php?title=Marriage&oldid=1064076951"^^xsd:anyURI,
        "Haviland, William A.; Prins, Harald E. L.; McBride, Bunny; Walrath, Dana (2011). Cultural Anthropology: The Human Challenge (13th ed.). Cengage Learning. ISBN 978-0-495-81178-7" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000924 a owl:Class ;
    rdfs:label "Beginning of Life Stasis"@en ;
    rdfs:comment "A Beginning of Life Stasis (BoL) is a relatively brief Operational Stasis that is primarily of interest for the purpose of establishing a baseline for operational parameters to be compared to the designed specifications as well as the Artifact's performance throughout its operational life."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001191 ;
    skos:definition "A Operational Stasis that holds during a Temporal Interval when an Artifact is first put into operational use such that its designed set of Artifact Functions is capable of operating at or near their designed peak performance levels."@en ;
    www:ont00001753 "BOL",
        "BoL" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00001753 a owl:AnnotationProperty ;
    rdfs:label "acronym"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    skos:definition "An Alternative Label that consists of a shortened or abbreviated form of the rdfs:label and is used to denote the entity."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

www:ont00001938 a owl:ObjectProperty ;
    rdfs:label "represents"@en ;
    rdfs:comment "Isomorphism between the carrier of x and the represented entity can be via a direct similarity relation, e.g., grooves in a vinyl record corresponding to sound waves, or linguistic convention, e.g., a court stenographer's transcription of spoken words, as well as others, such as encoding processes for images."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subPropertyOf obo:IAO_0000136 ;
    skos:definition "x represents y iff x is an instance of Information Content Entity, y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en ;
    skos:scopeNote "Given a stronger temporal interpretation, this property may be functional. For more info please refer to https://github.com/BFO-ontology/BFO-2020/tree/master/src/owl/temporal%20extensions."@en,
        "The relationship that is being defined here is that between the content of a photographic image and its object, between the content of a video and its objects and events, between the content of an audio recording and the sounds or events generating those sounds, or between the content of a written transcript and the verbal event that it transcribes."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

obo:BFO_0000139 a owl:ObjectProperty ;
    rdfs:label "temporal part of"@en ;
    dc:identifier "078-BFO" ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subPropertyOf obo:BFO_0000132 ;
    skos:definition "b temporal part of c =Def b occurrent part of c & (b and c are temporal regions) or (b and c are spatiotemporal regions & b temporally projects onto an occurrent part of the temporal region that c temporally projects onto) or (b and c are processes or process boundaries & b occupies a temporal region that is an occurrent part of the temporal region that c occupies)"@en ;
    skos:example "Your heart beating from 4pm to 5pm today is a temporal part of the process of your heart beating; the 4th year of your life is a temporal part of your life, as is the process boundary which separates the 3rd and 4th years of your life; the first quarter of a game of football is a temporal part of the whole game"@en ;
    :OEO_00020426 """issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016""" .

obo:IAO_0000234 a owl:AnnotationProperty ;
    rdfs:label "ontology term requester"@en ;
    obo:IAO_0000111 "ontology term requester"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "The name of the person, project, or organization that motivated inclusion of an ontology term by requesting its addition."@en ;
    obo:IAO_0000117 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg"@en ;
    obo:IAO_0000119 "Person: Jie Zheng, Chris Stoeckert, Alan Ruttenberg"@en ;
    rdfs:comment "The 'term requester' can credit the person, organization or project who request the ontology term." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> .

obo:RO_0002314 a owl:ObjectProperty ;
    rdfs:label "characteristic of part of"@en ;
    obo:IAO_0000115 "q characteristic of part of w if and only if there exists some p such that q inheres in p and p part of w." ;
    obo:IAO_0000116 "Because part_of is transitive, inheres in is a sub-relation of characteristic of part of" ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165> ;
    obo:IAO_0000118 "inheres in part of" ;
    obo:IAO_0000119 <http://www.ncbi.nlm.nih.gov/pubmed/20064205> ;
    obo:RO_0001900 obo:RO_0001901 ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/ro/docs/reflexivity/> ;
    rdfs:subPropertyOf obo:RO_0002502 .

obo:RO_0002501 a owl:ObjectProperty ;
    rdfs:label "causal relation between processes" ;
    obo:IAO_0000115 "p is causally related to q if and only if p or any part of p and q or any part of q are linked by a chain of events where each event pair is one where the execution of p influences the execution of q. p may be upstream, downstream, part of, or a container of q." ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165> ;
    obo:IAO_0000119 <http://purl.obolibrary.org/obo/ro/docs/causal-relations> ;
    obo:IAO_0000232 "Do not use this relation directly. It is intended as a grouping for a diverse set of relations, all involving cause and effect." ;
    rdfs:domain obo:BFO_0000015 ;
    rdfs:range obo:BFO_0000015 ;
    rdfs:subPropertyOf obo:RO_0002410 .

obo:STATO_0000314 a owl:Class ;
    rdfs:label "upper confidence limit"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "upper confidence limit is a data item which is a largest value bounding a confidence interval"@en ;
    obo:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Orlaith Burke"@en,
        "Philippe Rocca-Serra"@en ;
    obo:IAO_0000119 "STATO"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/stato-extracted.owl> ;
    rdfs:subClassOf obo:STATO_0000633 ;
    :OEO_00020426 """
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2002
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1133""" .

obo:STATO_0000315 a owl:Class ;
    rdfs:label "lower confidence limit"@en ;
    obo:IAO_0000114 obo:IAO_0000122 ;
    obo:IAO_0000115 "lower confidence limit is a data item which is a lowest value bounding a confidence interval"@en ;
    obo:IAO_0000117 "Alejandra Gonzalez-Beltran"@en,
        "Orlaith Burke"@en,
        "Philippe Rocca-Serra"@en ;
    obo:IAO_0000119 "STATO"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/stato-extracted.owl> ;
