:OEO_00020373 a owl:Class ;
    rdfs:label "study report due to legal obligation"@en ;
    obo:IAO_0000115 "A study report due to legal obligation is a study report that is created beacause of a legal obligation."@en ;
    obo:IAO_0000118 "legally mandatory study report"@en ;
    rdfs:subClassOf :OEO_00020012 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1641
