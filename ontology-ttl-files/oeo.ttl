    obo:BFO_0000050 :OEO_00010040 ;
    obo:IAO_0000115 """The CRF sector (IPCC 2006) 'manufacture of solid fuels and other energy industries' is an energy transformation sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Combustion emissions from fuel use during the manufacture of secondary and tertiary products from solid fuels including production of charcoal.""" ;
    obo:IAO_0000119 "2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 2, Chapter 2.2, https://www.ipcc-nggip.iges.or.jp/public/2006gl/" ;
    :OEO_00000504 :OEO_00000242 ;
    :OEO_00010037 "CRF 1.A.1.c" ;
