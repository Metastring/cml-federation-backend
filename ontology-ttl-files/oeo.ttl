    rdfs:subClassOf :OEO_00020109 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/839
issue: https://github.com/OpenEnergyPlatform/ontology/issues/903
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/909""" .

:OEO_00020113 a owl:Class ;
    rdfs:label "inflation rate"@en ;
    obo:IAO_0000115 "Inflation rate is an economic value reprensenting the ratio between the monetary price for a good at two different points in time that equalises differences in monetary price levels between these two points in time." ;
    obo:IAO_0000118 "Inflationsrate"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00040010 ;
            owl:someValuesFrom obo:UO_0010006 ],
