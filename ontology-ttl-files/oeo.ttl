    rdfs:label "exa" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of ten to the power of 18.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "10^[18]",
        "E" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

