    obo:BFO_0000050 :OEO_00010164 ;
    obo:IAO_0000115 """The CRF sector (IPCC 2006) 'lime production' is an industry sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Process-related emissions from the production of various types of lime (ISIC: D2694).""" ;
    obo:IAO_0000119 "2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 1, Chapter 8.5, https://www.ipcc-nggip.iges.or.jp/public/2006gl/" ;
