    obo:IAO_0000115 "A heat generating unit is an energy transformation unit that has the function to produce thermal energy." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom :OEO_00010248 ],
        :OEO_00020102 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00020102 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000085 ;
                        owl:someValuesFrom :OEO_00010387 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1254
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1360

remove has energy output axiom
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2190
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2233""" .

