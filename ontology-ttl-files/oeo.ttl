    obo:BFO_0000050 :OEO_00010058 ;
    obo:IAO_0000115 """The CRF sector (IPCC 2006) 'CO2 transport and storage' is a sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Any other emissions from CCS not reported elsewhere.""" ;
    obo:IAO_0000119 "2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 1, Chapter 8.5, https://www.ipcc-nggip.iges.or.jp/public/2006gl/" ;
