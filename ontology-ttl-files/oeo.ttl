obo:UO_0000264 a owl:Class ;
    rdfs:label "siemens" ;
    obo:IAO_0000115 "\"An electrical conduction unit which is equal to A/V.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "A V^-1",
        "mho " ;
    oboInOwl:hasRelatedSynonym "S" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000264 .

obo:UO_0000290 a owl:Class ;
    rdfs:label "peta" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of ten to the power of 15.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "10^[15]",
        "P" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

obo:UO_0000291 a owl:Class ;
    rdfs:label "tera" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of ten to the power of 12.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "T" ;
    oboInOwl:hasRelatedSynonym "10^[12]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

obo:UO_0000292 a owl:Class ;
    rdfs:label "giga" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of ten to the power of 9.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "10^[9]",
        "G" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

obo:UO_0000294 a owl:Class ;
    rdfs:label "kilo" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of one thousand.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "10^[3]",
        "k" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

