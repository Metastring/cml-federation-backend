                    owl:intersectionOf ( :OEO_00140004 [ a owl:Class ;
                                owl:unionOf ( :OEO_00010285 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000057 ;
                                            owl:someValuesFrom :OEO_00010292 ] ) ] ) ] ],
        owl:NamedIndividual,
        :OEO_00010320 ;
    rdfs:label "CRF sector (IPCC 2006): international bunkers"@en ;
    obo:BFO_0000051 :OEO_00010201,
        :OEO_00010202 ;
    obo:IAO_0000115 "The CRF sector (IPCC 2006) 'international bunkers' is a transport sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories. It encompasses international aviation and maritime navigation." ;
    :OEO_00000504 :OEO_00000242 ;
    :OEO_00010037 "CRF 1.D.1" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/928
