:OEO_00350001 a owl:Class ;
    rdfs:label "annual GDP growth"@en ;
    obo:IAO_0000115 "Annual GDP growth is an economic value that quantifies the difference between GDP in one year compared to the previous year." ;
    rdfs:subClassOf [ a owl:Restriction ;
