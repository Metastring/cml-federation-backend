pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2233""" .

:OEO_00000407 a owl:Class ;
    rdfs:label "technology"@en ;
    obo:IAO_0000115 "A technology is a plan specification that describes how to combine artificial objects or other material entities and processes in a specific way."@en ;
    obo:IAO_0000118 "Technologie"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :OEO_00000061 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000056 ;
                                owl:someValuesFrom obo:BFO_0000015 ] ) ] ],
        obo:IAO_0000104 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/136
