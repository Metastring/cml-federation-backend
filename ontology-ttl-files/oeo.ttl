www:ont00000004 a owl:Class ;
    rdfs:label "Change"@en ;
    rdfs:comment "In CCO, the SubClassOf axioms are actually anonymous ancestors and inherited from process (BFO 2020)." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000132 ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( obo:BFO_0000015 obo:BFO_0000035 ) ] ;
            owl:onProperty obo:BFO_0000117 ],
        [ a owl:Restriction ;
            owl:allValuesFrom obo:BFO_0000015 ;
            owl:onProperty obo:BFO_0000139 ],
        obo:BFO_0000015 ;
    skos:definition "A Process in which some independent continuant endures and 1) one or more of the dependent entities it bears increase or decrease in intensity, 2) the entity begins to bear some dependent entity or 3) the entity ceases to bear some dependent entity."@en ;
    :OEO_00020426 """issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016""" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

obo:IAO_0000400 a owl:Class ;
    rdfs:label "cartesian spatial coordinate datum"@en ;
    obo:IAO_0000114 obo:IAO_0000120 ;
    obo:IAO_0000115 "A cartesian spatial coordinate datum is a representation of a point in a spatial region, in which equal changes in the magnitude of a coordinate value denote length qualities with the same magnitude"@en ;
    obo:IAO_0000116 "2009-08-18 Alan Ruttenberg - question to BFO list about whether the BFO sense of the lower dimensional regions is that they are always part of actual space (the three dimensional sort) http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en ;
    obo:IAO_0000117 "Alan Ruttenberg"@en ;
    obo:IAO_0000232 "AR notes: We need to discuss whether it should include site." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:seeAlso "http://groups.google.com/group/bfo-discuss/browse_thread/thread/9d04e717e39fb617"@en ;
    rdfs:subClassOf obo:IAO_0000027 .

obo:UO_1000223 a owl:Class ;
