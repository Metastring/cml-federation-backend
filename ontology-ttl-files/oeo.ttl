:OEO_00000014 a owl:Class ;
    rdfs:label "fossil combustion fuel"@en ;
    obo:IAO_0000115 "A fossil combustion fuel is a combustion fuel with the origin fossil." ;
    obo:IAO_0000118 "fossiler Brennstoff"@de ;
