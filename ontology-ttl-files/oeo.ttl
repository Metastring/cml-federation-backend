:OEO_00390007 a owl:Class ;
    rdfs:label "wind characteristics determination process"@en ;
    obo:IAO_0000115 """Wind characteristics determination process is a process that follows a determination methodology for wind characteristics to gain knowledge of the specific wind characteristics of a predefined region.
Wind characteristics include speed, direction, frequency, turbulence, and seasonal or diurnal patterns.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00390026 ;
            owl:someValuesFrom :OEO_00390002 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1966""" .

:OEO_00390023 a owl:ObjectProperty ;
    rdfs:label "has aggregation type"@en ;
    obo:IAO_0000115 "A relation between a data item or data set and an aggregation type that indicates the method of data aggregation applied to the data set." ;
    :OEO_00020426 """Added
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1901
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1944""" .

:OEO_00390024 a owl:ObjectProperty ;
    rdfs:label "has time stamp alignment"@en ;
    obo:IAO_0000115 "A relation between a time stamp or time series and a time stamp alignment that indicates the position of the time stamps that refer to the time step(s)." ;
    :OEO_00020426 """Added
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1901
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1944""" .

:OEO_00390037 a owl:Class ;
    rdfs:label "wind farm area determination process"@en ;
    obo:IAO_0000115 "Wind farm area determination process is a process that follows a determination methodology for available area to gain knowledge of the available area for wind farm development." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00390026 ;
            owl:someValuesFrom :OEO_00390034 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390047 a owl:Class ;
    rdfs:label "wind potential determination process"@en ;
    obo:IAO_0000115 "Wind potential determination processa is a process that follows a determination methodology for wind potential to gain knowledge of the technical wind potential of the available area." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00390026 ;
            owl:someValuesFrom :OEO_00390046 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390057 a owl:Class ;
    rdfs:label "techno-economic potential determination process"@en ;
    obo:IAO_0000115 "Techno-economic potential determination process is a process that follows a determination methodology for techno-economic potental to gain knowledge of the techno-economic potential of the available region." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00390026 ;
            owl:someValuesFrom :OEO_00390056 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390063 a owl:Class ;
    rdfs:label "feasible potental determination process"@en ;
    obo:IAO_0000115 "Feasible potential determination process al is a process that follows a determination methodology for feasable potential to gain knowledge of the feasible potential of something." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00390026 ;
            owl:someValuesFrom :OEO_00390062 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390064 a owl:Class ;
    rdfs:label "study descriptor"@en ;
    obo:IAO_0000115 "A study descriptor is a data descriptor that allows the annotation of study information within a scenario bundle by means of keywords from ontological terminology." ;
    rdfs:subClassOf :OEO_00000119 ;
    :OEO_00020426 """add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1943
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1950""" .

:OEO_00390071 a owl:ObjectProperty ;
    rdfs:label "has study descriptor tag"@en ;
    obo:IAO_0000115 "has study descriptor tag is a relation between a scenario bundle and an oeo class which is used as a study descriptor." ;
    obo:IAO_0000600 "OEO classes that are used as study descriptors are annotated by the annotation property \"oekg annotation\" with value \"study descriptor\"." ;
    rdfs:domain :OEO_00020227 ;
    rdfs:range obo:BFO_0000001 ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00390073 a owl:ObjectProperty ;
    rdfs:label "has scenario type"@en ;
    obo:IAO_0000115 "has scenario type is a relation between a scenario factsheet and a subclass of scenario." ;
    rdfs:domain :OEO_00000365 ;
    rdfs:range :OEO_00000364 ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00390078 a owl:ObjectProperty ;
    rdfs:label "has reference"@en ;
    obo:IAO_0000112 """http://openenergyplatform.org/ontology/oekg/region/Albania 
has reference https://www.omg.org/spec/LCC/Countries/ISO3166-1-CountryCodes/Albania

Here the region Albania in the oekg references the region Albania in the LCC ontology. In the same way any continuant may link to a document it is referencing.""" ;
    obo:IAO_0000115 "has reference is the relation between a continuant and a reference that points to a relevant resource to the continuant." ;
    rdfs:domain obo:BFO_0000002 ;
    rdfs:range :OEO_00000353 ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00390079 a owl:ObjectProperty ;
    rdfs:label "based on sector division"@en ;
    obo:IAO_0000115 "based on sector division is a relation between a scenario bundle and a sector division it is based on." ;
    rdfs:domain :OEO_00020227 ;
    rdfs:range :OEO_00000368 ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020

move to oeo-shared
