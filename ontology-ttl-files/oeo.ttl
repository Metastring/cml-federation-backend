:OEO_00020149 a owl:Class ;
    rdfs:label "fossil energy"@en ;
    obo:IAO_0000115 "Fossil energy is chemical energy that is stored in fossil combustion fuels and thus has a conventional origin." ;
    obo:IAO_0000118 "fossile Energie"@de ;
    rdfs:subClassOf :OEO_00000007 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000007 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000052 ;
                        owl:someValuesFrom :OEO_00000014 ] [ a owl:Restriction ;
                        owl:onProperty :OEO_00000530 ;
                        owl:someValuesFrom :OEO_00020147 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/833
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/955

Update definition and axiom:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1172
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1185

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

