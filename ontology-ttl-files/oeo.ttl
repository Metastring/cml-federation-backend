[] a owl:Axiom ;
    owl:annotatedProperty obo:IAO_0000602 ;
    owl:annotatedSource <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01003> ;
    owl:annotatedTarget """(forall (?et) (iff (EnergyTransformation ?et)  
  (exists (?ed ?ei ?en1 ?en2 ?me) 
    (and (EnergyDecrease ?ed) (has_part ?et ?ed) 
      (EnergyIncrease ?ei) (has_part ?et ?ei)
      (causally_related_to ?ed ?ei)            
      (Energy ?en1) (Energy ?en2) (not (= ?en1 ?en2))
      (negatively_regulates ?ed ?en1) 
      (positively_regulates ?ei ?en2)  
      (MaterialEntity ?me) 
      (has_participant ?ed ?me) (has_participant ?ei ?me) 
      (inheres_in ?en1 ?me) (inheres_in ?en2 ?me) ))))""" ;
    prov:wasDerivedFrom <https://openenergyplatform.org/ontology/oeo/releases/2.13.0/imports/meno-extracted.owl> .

