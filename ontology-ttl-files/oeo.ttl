obo:UO_0010006 a owl:Class ;
    rdfs:label "ratio" ;
    obo:IAO_0000115 "\"A dimensionless ratio unit which, given a pair of quantities a and b, for which b is a multiple of a, denotes b by giving the multiplier (coefficient) c for a to result in b.\" [UOB:LKSR]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000190 .

