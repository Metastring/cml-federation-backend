<https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01004> a owl:Class ;
    rdfs:label "energetic conversion process" ;
    obo:IAO_0000115 "Energetic conversion process is a process that has energy transfers or energy transformations (or both) as part." ;
    obo:IAO_0000600 "Energetic conversion processes comprise any non-idealised processes. The term 'energetic conversion' is chosen as collective term for energy transformations and energy transfers. However, literature is ambiguous in its interpretation. Some sources refer to energy conversion as synonym for energy transformation." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/meno-extracted.owl> ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000015 [ a owl:Class ;
                        owl:unionOf ( [ a owl:Restriction ;
                                    owl:onProperty obo:BFO_0000051 ;
                                    owl:someValuesFrom <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01002> ] [ a owl:Restriction ;
                                    owl:onProperty obo:BFO_0000051 ;
                                    owl:someValuesFrom <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01003> ] ) ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1959
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2022

change axiom to include meno instead of oeo classes
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2058
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2061
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2195""" .

<https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01040> a owl:Class ;
    rdfs:label "radiation" ;
    obo:IAO_0000115 "A radiation process is an energy transfer that transmits radiative energy as  electromagnetic waves. The transfer does not necessarily occur within a material entity." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/meno-extracted.owl> ;
    rdfs:subClassOf <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01002> ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1959
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2022""" .

<https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01041> a owl:Class ;
    rdfs:label "electricity conduction" ;
    obo:IAO_0000115 "Electricity conduction is an energy transfer in which electrical energy is transmitted within a material entity or object aggregat, e.g. a cable." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/meno-extracted.owl> ;
    rdfs:subClassOf <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01002> ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1959
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2022""" .

<https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01042> a owl:Class ;
    rdfs:label "heat convection" ;
    obo:IAO_0000115 "Heat convection is an energy transfer in which thermal energy is transported within flowing gaseous or liquid material entities." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/meno-extracted.owl> ;
    rdfs:subClassOf <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01002> ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1959
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2022""" .

<https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01049> a owl:Class ;
    rdfs:label "heat conduction" ;
    obo:IAO_0000115 "Heat conduction is an energy transfer in which thermal energy is transmitted within a material entity or object aggregat." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/meno-extracted.owl> ;
    rdfs:subClassOf <https://raw.githubusercontent.com/stap-m/midlevel-energy-ontology/main/ontology/src/midlevel-energy.owl/MENO_01002> ;
