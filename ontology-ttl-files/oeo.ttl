pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1878""" .

:OEO_00020114 a owl:Class ;
    rdfs:label "exchange rate"@en ;
    obo:IAO_0000112 "The exchange rate between USD and EUR on March 15, 2020 was X.X." ;
