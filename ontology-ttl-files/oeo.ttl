    oboInOwl:hasExactSynonym "10^[-15]",
        "f" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

obo:UO_0000304 a owl:Class ;
    rdfs:label "atto" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of 10 to the power of -18.\" [UO:GVG]" ;
