:OEO_00040002 a owl:Class ;
    rdfs:label "market exchange role"@en ;
    obo:IAO_0000115 "A role of an organisation, association, or group of persons, whether incorporated or unincorporated, which constitutes, maintains, or provides a facility for bringing together purchasers and sellers of financial instruments, commodities, or other products, services, or goods, and includes the market place and facilities maintained by the exchange" ;
    obo:IAO_0000118 "exchange",
        "market" ;
    obo:IAO_0000119 "fibo-fbc-fct-mkt:Exchange" ;
    rdfs:seeAlso "https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/Markets/Exchange" ;
    rdfs:subClassOf obo:BFO_0000023 ;
    :OEO_00020426 """https://github.com/OpenEnergyPlatform/ontology/issues/341
