    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00000323 :OEO_00030022 ) ] ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue:https://github.com/OpenEnergyPlatform/ontology/issues/148
