:OEO_00030017 a owl:Class ;
    rdfs:label "energy autoproducer"@en ;
    obo:IAO_0000115 "An energy autoproducer is an organisational energy producer who produces electrical energy and/or heat wholly or partly for their own use as an activity which supports their primary activity." ;
    obo:IAO_0000119 "inspired by https://ec.europa.eu/eurostat/documents/38154/41386/Ele_AQ_documentation.pdf/a06bf650-1830-4fcb-9376-7be1f8ab080c" ;
    rdfs:comment "They may be privately or publicly owned." ;
    rdfs:subClassOf :OEO_00030016 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/314
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/370""" .

:OEO_00030018 a owl:Class ;
    rdfs:label "main activity energy producer"@en ;
    obo:IAO_0000115 "A main activity energy producer is an organisational energy producer whose primary activity is electrical energy and/or heat production." ;
    obo:IAO_0000119 "inspired by https://ec.europa.eu/eurostat/documents/38154/41386/Ele_AQ_documentation.pdf/a06bf650-1830-4fcb-9376-7be1f8ab080c" ;
    rdfs:comment "They may be privately or publicly owned. Note that the sale need not take place through the public grid." ;
    rdfs:subClassOf :OEO_00030016 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/314
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/370""" .

:OEO_00030027 a owl:Class ;
    rdfs:label "primary energy carrier mining"@en ;
    obo:IAO_0000115 "Primary energy carrier mining is a primary energy production that recovers non-renewable energy carriers from its natural site."@en ;
    rdfs:subClassOf :OEO_00030026 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/835
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/845

issue: https://github.com/OpenEnergyPlatform/ontology/issues/77
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/498""" .

:OEO_00030028 a owl:Class ;
    rdfs:label "primary energy carrier harvest"@en ;
    obo:IAO_0000115 "Primary energy carrier harvest is a primary energy production that collects solid biomass from its natural site."@en ;
    rdfs:subClassOf :OEO_00030026 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/835
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/845

issue: https://github.com/OpenEnergyPlatform/ontology/issues/77
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/498""" .

:OEO_00040001 a owl:AnnotationProperty ;
    rdfs:label "belongs to module"@en ;
    obo:IAO_0000116 "This annotation property was used to describe in which module a class was implemented. With OEO version 2.0.0 this annotation property gets deprecated."@en ;
    :OEO_00020426 """Make the annotation property deprecated
Pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1732"""@en .

:OEO_00040007 a owl:Class ;
    rdfs:label "price request"@en ;
    obo:IAO_0000115 "A price request is a request in which an agent asks another agent for a price." ;
    rdfs:subClassOf :OEO_00040006 ;
    :OEO_00020426 """https://github.com/OpenEnergyPlatform/ontology/issues/376
https://github.com/OpenEnergyPlatform/ontology/pull/642""" .

:OEO_00040008 a owl:Class ;
    rdfs:label "marginal cost"@en ;
    obo:IAO_0000115 "Marginal cost is the quantity value that corresponds to the change in the total cost that arises when the quantity produced is incremented by one unit; that is, it is the cost of producing one more unit of a good." ;
    obo:IAO_0000118 "Grenzkosten"@de ;
    obo:IAO_0000119 "O'Sullivan, Arthur; Sheffrin, Steven M. (2003). Economics: Principles in Action." ;
    rdfs:subClassOf :OEO_00000350 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/642
make subclass of quantity value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1917
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1931""" .

