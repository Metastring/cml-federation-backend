:OEO_00010473 a owl:ObjectProperty ;
    rdfs:label "has linear unit numerator"@en ;
    obo:IAO_0000115 "A relation between a (composed) unit A and a unit B in which B is in the numerator of unit A with exponent 1."@en ;
    obo:IAO_0000600 """A composed unit is composed of at least two other units. Examples are:
