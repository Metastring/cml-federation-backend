:OEO_00020174 a owl:Class ;
    rdfs:label "delivery cost"@en ;
    obo:IAO_0000115 "A delivery cost is a cost for a product or service that refers to the total unit cost of a product or commodity delivered to a certain market, city or customer. It is normally composed of all associated transport costs and the unit cost of production for that product." ;
    obo:IAO_0000118 "Lieferkosten"@de ;
    rdfs:subClassOf :OEO_00040009 ;
