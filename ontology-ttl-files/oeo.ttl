                        owl:someValuesFrom :OEO_00010028 ] [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( :OEO_00010029 [ a owl:Restriction ;
                                            owl:onProperty obo:RO_0000056 ;
