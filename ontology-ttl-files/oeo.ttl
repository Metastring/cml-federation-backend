:OEO_00010065 a owl:NamedIndividual,
        :OEO_00000158 ;
    rdfs:label "KSG sector energy industry"@en ;
    obo:IAO_0000115 """The KSG sector energy industry is an energy transformation sector defined by the KSG sector division. It is an aggregate of the following three sectors:
- CRF sector (IPCC 2006): energy industry (CRF 1.A.1.a)
- CRF sector (IPCC 2006): other transportation (CRF 1.A.3.e)
- CRF sector (IPCC 2006): fugitive emissions from fuels (CRF 1.B)""" ;
    obo:IAO_0000118 "KSG-Sektor Energiewirtschaft"@de ;
    obo:IAO_0000119 "Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html" ;
    :OEO_00000504 :OEO_00010056 ;
    :OEO_00010467 :OEO_00010040,
        :OEO_00010057,
        :OEO_00010064 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/580
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/595

move to oeo-sector 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1399
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1724""" .

:OEO_00010066 a owl:NamedIndividual,
        :OEO_00000227 ;
    rdfs:label "KSG sector industry"@en ;
    obo:BFO_0000051 :OEO_00010041,
        :OEO_00010046,
        :OEO_00010058 ;
    obo:IAO_0000115 """The KSG sector industry is an industry sector defined by the KSG sector division. It is an aggregate of the following three sectors:
- CRF sector (IPCC 2006): manufacturing industries and construction (CRF 1.A.2)
- CRF sector (IPCC 2006): CO2 transport and storage (CRF 1.C)
- CRF sector (IPCC 2006): industrial processes and product use (CRF 2)""" ;
    obo:IAO_0000118 "KSG-Sektor Industrie"@de ;
    obo:IAO_0000119 "Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html" ;
    :OEO_00000504 :OEO_00010056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/580
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/595

move to oeo-sector 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1399
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1724""" .

:OEO_00010067 a owl:NamedIndividual,
        :OEO_00010034 ;
    rdfs:label "KSG sector buildings"@en ;
    obo:BFO_0000051 :OEO_00010044,
        :OEO_00010052,
        :OEO_00010053 ;
    obo:IAO_0000115 """The KSG sector buildings is a building sector defined by the KSG sector division. It is an aggregate of the following two sectors:
- CRF sector (IPCC 2006): commercial and institutional (CRF 1.A.4.a)
- CRF sector (IPCC 2006): residential (CRF 1.A.4.b)
- CRF sector (IPCC 2006): fuel combustion - other""" ;
    obo:IAO_0000118 "KSG-Sektor Gebäude"@de ;
    obo:IAO_0000119 "Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html" ;
    :OEO_00000504 :OEO_00010056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/580
