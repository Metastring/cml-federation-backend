pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1601""" .

:OEO_00010456 a owl:Class ;
    rdfs:label "economic instrument"@en ;
    obo:IAO_0000115 "An economic instrument is a policy instrument that creates monetary (price) incentives to stimulate transformative measures."@en ;
    obo:IAO_0000600 "Examples: subsidies for installation of renewable energy technologies, tradable permits"@en ;
    rdfs:subClassOf :OEO_00140151 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00140151 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000053 ;
                        owl:someValuesFrom :OEO_00010492 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1545
