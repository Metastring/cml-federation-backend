        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000085 ;
            owl:someValuesFrom :OEO_00010388 ],
        :OEO_00000334 ;
    :OEO_00020426 """Issue: https://github.com/OpenEnergyPlatform/ontology/issues/753
