    :OEO_00020426 """
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2002
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1133""" .

obo:UO_0000005 a owl:Class ;
    rdfs:label "temperature unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the average kinetic energy of the particles in a sample of matter.\" [Wikipedia:Wikipedia]" ;
    oboInOwl:hasExactSynonym "temperature derived unit" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
