:OEO_00050008 a owl:Class ;
    rdfs:label "megawatt-hour"@en ;
    obo:IAO_0000115 "A megawatt-hour is a watt-hour based unit which is equal to 10^6 watt-hours." ;
    obo:IAO_0000118 "Megawattstunde"@de,
        "megawatt hours"@en ;
    oboInOwl:hasExactSynonym "MWh" ;
    rdfs:subClassOf obo:UO_1000223 ;
