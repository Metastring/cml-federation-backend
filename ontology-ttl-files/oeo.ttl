:OEO_00020459 a owl:Class ;
    rdfs:label "electricity pylon"@en ;
    obo:IAO_0000115 "An electricity pylon is a power line support structure that is designed to carry one or more overhead power lines, typically constructed as lattice or tubular tower made of steel." ;
