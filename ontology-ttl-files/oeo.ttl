:OEO_00010360 a owl:Class ;
    rdfs:label "source category"@en ;
    obo:IAO_0000115 "A source category is a sector that is defined by a common reporting format." ;
    obo:IAO_0000118 "Quellgruppe"@de,
        "CRF sector"@en ;
    rdfs:subClassOf :OEO_00000367 ;
