:OEO_00020170 a owl:Class ;
    rdfs:label "installation cost"@en ;
    obo:IAO_0000112 "costs that occur for becoming operational" ;
    obo:IAO_0000115 "Installation and development cost are investment costs incurred for setting up the installation." ;
    obo:IAO_0000118 "Installationskosten"@de,
        "installation and development cost"@en,
        "site development cost"@en ;
    rdfs:subClassOf :OEO_00020167 ;
