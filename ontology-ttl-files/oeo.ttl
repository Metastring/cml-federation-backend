pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1706""" .

:OEO_00230000 a owl:Class ;
    rdfs:label "energy storage capacity"@en ;
    obo:IAO_0000115 "An energy storage capacity is the quantity value stating the maximum energy an energy storage object can store." ;
    obo:IAO_0000118 "Speicherkapazität"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020056 ;
            owl:someValuesFrom :OEO_00000159 ],
        :OEO_00010256 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/320
