pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1897""" .

:OEO_00140138 a owl:Class ;
    rdfs:label "generation time series"@en ;
    obo:IAO_0000115 "A generation time series is a time series that describes the specific electricity generation of a particular power plant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :OEO_00240014 [ a owl:Restriction ;
