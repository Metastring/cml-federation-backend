:OEO_00140124 a owl:Class ;
    rdfs:label "service"@en ;
    obo:IAO_0000115 "A service is a process that is an intangible activity performed by some agent for the benefit of another agent." ;
    obo:IAO_0000118 "Dienstleistung"@de ;
