:OEO_00390000 a owl:Class ;
    rdfs:label "kilowatt"@en ;
    obo:IAO_0000115 "A power unit which is equal to one thousand watts." ;
    obo:IAO_0000118 "kW" ;
    rdfs:subClassOf obo:UO_1000114 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:UO_0000114 [ a owl:Restriction ;
                        owl:onProperty :OEO_00020404 ;
                        owl:someValuesFrom obo:UO_0000294 ] ) ] ;
    :OEO_00020426 """added kilowatt and megawatt as units
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1890
