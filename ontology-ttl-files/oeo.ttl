:OEO_00020247 a owl:Class ;
    rdfs:label "target driven scenario"@en ;
    obo:IAO_0000115 "A target driven scenario is a scenario that contains certain target constraints/ statements that in a possible future shall be realized. The path how the targets will be met is not predefined in the scenario." ;
    obo:IAO_0000118 "Zielszenario"@de ;
    rdfs:subClassOf :OEO_00000364 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000364 [ a owl:Restriction ;
                        owl:onProperty obo:IAO_0000136 ;
                        owl:someValuesFrom :OEO_00020093 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1110
