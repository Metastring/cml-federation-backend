:OEO_00330008 a owl:Class ;
    rdfs:label "power-to-liquid process"@en ;
    obo:IAO_0000115 "A power-to-liquid process is a power-to-fuel process that converts electrical energy to chemical energy by synthesising portions of matter into a liquid synthetic fuel." ;
    rdfs:subClassOf :OEO_00330007 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00330007 [ a owl:Restriction ;
                        owl:onProperty :OEO_00000533 ;
                        owl:someValuesFrom :OEO_00010019 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1477
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1483

replace energy-participant axioms
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2053
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2120""" .

:OEO_00330010 a owl:Class ;
    rdfs:label "power-to-ammonia system"@en ;
    obo:IAO_0000115 "A power-to-ammonia system is a power-to-gas system that implements the power-to-ammonia process." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom :OEO_00010222 ],
        :OEO_00000335 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1477
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1483""" .

:OEO_00340062 a owl:Class ;
    rdfs:label "quantity"@en ;
    obo:IAO_0000115 "A quantity is a quality of a material entity where the magnitude  of the quality can be quantified via a quantity value, which means that it can be expressed as a number and a unit." ;
    obo:IAO_0000119 "Derived from: https://jcgm.bipm.org/vim/en/1.1.html" ;
    rdfs:subClassOf obo:BFO_0000019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000019 [ a owl:Restriction ;
                        owl:onProperty :OEO_00140002 ;
                        owl:someValuesFrom :OEO_00000350 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1510
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1839""" .

:OEO_00340065 a owl:Class ;
    rdfs:label "greenhouse gas emission value"@en ;
    obo:IAO_0000115 "A greenhouse gas emission value is an emission value that quantifies a greenhouse gas emission rate and has a mass unit." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020056 ;
            owl:someValuesFrom :OEO_00140082 ],
        :OEO_00010079 ;
    :OEO_00020426 """restructuring emission rate and emission value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1759
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1846

Correction of implementing mistake concerning emission value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1759
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1880""" .

:OEO_00340068 a owl:Class ;
    rdfs:label "size"@en ;
    obo:IAO_0000115 "Size is a quantity of an entity that quantifies its spatial extend." ;
    obo:IAO_0000119 "Derived from: http://purl.allotrope.org/ontologies/result#AFR_0002109 and http://purl.obolibrary.org/obo/PATO_0000117" ;
    rdfs:subClassOf :OEO_00340062 ;
    :OEO_00020426 """restructuring of quantity values
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1848
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1851
Update size and add amount
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1896
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1905""" .

:OEO_00360006 a owl:Class ;
    rdfs:label "bidding zone role"@en ;
    obo:IAO_0000115 "A bidding zone role is a role of a two-dimensional spatial region that is realised in market participants trading energy without capacity allocation."@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1718""" .

:OEO_00360008 a owl:Class ;
    rdfs:label "energy balancing"@en ;
    obo:IAO_0000115 "Energy balancing is a process that levels out energy supply and demand for system stability."@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1549
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1717""" .

:OEO_00360011 a owl:Class ;
    rdfs:label "process climate neutrality"@en ;
    obo:IAO_0000115 "Process climate neutrality is a process attribute that conforms to some climate neutrality criteria."@en ;
    rdfs:subClassOf :OEO_00030019 ;
    :OEO_00020425 "study descriptor tag" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1392
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1722

add oekg annotation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2063
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2065""" .

:OEO_00360015 a owl:Class ;
    rdfs:label "resilience"@en ;
    obo:IAO_0000115 "Resilience is a disposition of a system that represents the capacity of a system to absorb disturbance and reorganize so as to retain essentially the same function, structure, and feedbacks."@en ;
    obo:IAO_0000119 "B. Walker, C. S. Holling, S. R. Carpenter, and A. Kinzig, “Resilience, adaptability and transformability in social–ecological systems,” Ecol. Soc., vol. 9, no. 2, 2004, Art. no. 5" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom obo:RO_0002577 ],
        obo:BFO_0000016 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1550
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1744
add oekg annotation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1529
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1897

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00360018 a owl:Class ;
    rdfs:label "service product role"@en ;
    obo:IAO_0000115 "A service product role is the role of an immaterial entity that is the result of a service process, and whose value is determined by the value and the costs of the service."@en ;
    rdfs:subClassOf obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1584
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1748""" .

:OEO_00360019 a owl:Class ;
    rdfs:label "service product"@en ;
    obo:IAO_0000115 "A service product is an immaterial entity that has the service product role."@en ;
    rdfs:subClassOf obo:BFO_0000141 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000141 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000087 ;
                        owl:someValuesFrom :OEO_00360018 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1584
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1748""" .

:OEO_00360022 a owl:Class ;
    rdfs:label "considered region role"@en ;
    obo:IAO_0000112 """In a study, the spatial focus of the investigation lies on one European country, e.g. Germany. This is the study region.
The study region is not modelled as a whole, but several subregions are modelled, e.g. German Federal States. These are study subregions.
In the study, a spatial region outside the study region plays a role. E.g. for modelling the electricity transfer between Germany and its neighbouring countries. In this example, the neighbouring countries represent the interacting / external region.
The union of the study region and the interacting/ external region ist the considered region."""@en ;
    obo:IAO_0000115 "A considered region role is the role of a region of relevance that is used in an analysis."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00360020 ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1745
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1749

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00360023 a owl:Class ;
    rdfs:label "interacting region role"@en ;
    obo:IAO_0000112 """In a study, the spatial focus of the investigation lies on one European country, e.g. Germany. This is the study region.
The study region is not modelled as a whole, but several subregions are modelled, e.g. German Federal States. These are study subregions.
In the study, a spatial region outside the study region plays a role. E.g. for modelling the electricity transfer between Germany and its neighbouring countries. In this example, the neighbouring countries represent the interacting / external region.
The union of the study region and the interacting/ external region ist the considered region."""@en ;
    obo:IAO_0000115 "An interacting region role is a role of a region of relevance that interacts with a region of relevance that has the study region role. It is part of a region of relevance that has the considered region role, but not a study region role."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00360020 ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1745
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1749

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00360024 a owl:Class ;
    rdfs:label "study subregion role"@en ;
    obo:IAO_0000115 "A study subregion role is a study region role that refers to a subregion."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00020033 ],
        :OEO_00360021 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1745
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1749

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00360027 a owl:Class ;
    rdfs:label "conditionally reserved region role"@en ;
    obo:IAO_0000115 "A conditionally reserved region role is a role of a region of interest that is prioritised to be used for wind park projects during the planning process, without excluding incompatible building projects." ;
    obo:IAO_0000119 "See German spatial planning law: §7 Absatz 3 ROG: https://www.gesetze-im-internet.de/rog_2008/__7.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410011 ;
            owl:onProperty :OEO_00000504 ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1766
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1791

added "'is defined by' value ROG" relation
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1991""" .

:OEO_00390002 a owl:Class ;
    rdfs:label "wind characteristics determination method"@en ;
    obo:IAO_0000115 """Wind characteristics determination method is a methodology with the goal to understand the specific wind characteristics of a predefined region, encompassing data acquisition, modelling, and analytical procedures.
Wind characteristics include speed, direction, frequency, turbulence, and seasonal or diurnal patterns.""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00390004 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00390003 :OEO_00390005 :OEO_00390014 :OEO_00390015 :OEO_00390016 :OEO_00390017 ) ] ],
        :OEO_00020166 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1966

Axiom update:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2004
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2005""" .

:OEO_00390003 a owl:Class ;
    rdfs:label "data preparation"@en ;
    obo:IAO_0000115 "Data preparation is an action specification that describes the steps the bearer takes to acquire raw data and how this data is cleaned, transformed, and structured for subsequent analysis. So it includes the acquisition and pre-processing of data." ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390004 a owl:Class ;
    rdfs:label "determined wind characteristics"@en ;
    obo:IAO_0000115 """Determined wind characteristics is an object specification that defines the goal of a methodology as a state of understanding the specific wind characteristics of a predefined region.
Wind characteristics include speed, direction, frequency, turbulence, and seasonal or diurnal patterns.""" ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1966""" .

:OEO_00390005 a owl:Class ;
    rdfs:label "wind speed calculation"@en ;
    obo:IAO_0000115 "Wind speed calculation is an action specification that describes how wind speed at the hub height of a wind turbine is inferred from measurements taken at a different height. It is extrapolated vertically to the hub height." ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390014 a owl:Class ;
    rdfs:label "air density adjustment"@en ;
    obo:IAO_0000115 "Air density adjustment is an action specification that describes how variations in air density due to changes in altitude, temperature, and pressure are incorporated into the wind resource calculations." ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390015 a owl:Class ;
    rdfs:label "wind speed frequency analysis"@en ;
    obo:IAO_0000115 "Wind speed frequency analysis is an action specification that describes the process of calculating the frequency of different wind speed intervals over a set period giving a wind speed frequency distribution." ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390016 a owl:Class ;
    rdfs:label "wind variability identification"@en ;
    obo:IAO_0000115 """Wind variability identification is an action specification that describes the process of identifying variations in wind characteristics across temporal scales.
Wind characteristics include speed, direction, frequency, turbulence, and seasonal or diurnal patterns.""" ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1966""" .

:OEO_00390017 a owl:Class ;
    rdfs:label "wind power density calculation"@en ;
    obo:IAO_0000115 "Wind power density calculation is an action specification that describes how wind power density (WPD) is calculated to estimate the theoretical wind power potential based on wind speed and air density." ;
    obo:IAO_0000118 "wpd calculation"@en ;
    rdfs:subClassOf :OEO_00390035 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1964""" .

:OEO_00390027 a owl:Class ;
    rdfs:label "improve spatial resolution"@en ;
    obo:IAO_0000115 "Improve spatial resolution is an action specification that describes the process of increasing the spatial resolution of wind data across a region to provide finer detail for wind resource assessment. This is done by horizontal interpolation." ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390028 a owl:Class ;
    rdfs:label "select exclusion criteria"@en ;
    obo:IAO_0000115 "Select exclusion criteria is an action specification that describes the process of defining physical, environmental, and regulatory criteria that exclude areas from wind farm development, along with the application of buffer zones." ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390029 a owl:Class ;
    rdfs:label "prepare exclusion criteria datasets"@en ;
    obo:IAO_0000115 "Prepare exclusion criteria datasets is an action specification that describes the steps involved in obtaining and preparing datasets that represent exclusion zones for wind farm development, based on predefined criteria. That includes acquiring and processing the data." ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390030 a owl:Class ;
    rdfs:label "run multi-criteria decision analysis"@en ;
    obo:IAO_0000115 "Run multi-criteria secision analysis is an action specification that describes how a multi-criteria decision analysis (MCDA) method is applied to areas where exclusions are not absolute (soft exclusion criteria), allowing for weighted decision-making." ;
    obo:IAO_0000118 "run MCDA"@en ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1964""" .

:OEO_00390031 a owl:Class ;
    rdfs:label "determine development area"@en ;
    obo:IAO_0000115 "Determine development area is an action specification that describes the identification of potential areas where wind farm development is feasible, by iteratively excluding non-available areas based on the processed data and exclusion criteria." ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390032 a owl:Class ;
    rdfs:label "determine geographical potential"@en ;
    obo:IAO_0000115 "Determine geographical potential is an action specification that describes the calculation of the total geographical area available for wind farm development after applying exclusion criteria and considering spatial constraints." ;
    rdfs:subClassOf :OEO_00390036 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390033 a owl:Class ;
    rdfs:label "determined wind farm area"@en ;
    obo:IAO_0000115 "Determined wind farm area is an object specification that defines the goal of a methodology as a state of understanding the available area for wind farm development." ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390034 a owl:Class ;
    rdfs:label "wind farm area determination method"@en ;
    obo:IAO_0000115 "Wind farm area determination method is a methodology with the goal of identifying and quantifying the area suitable for wind farm development, based on topographical, environmental, and regulatory constraints." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00390033 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00390027 :OEO_00390028 :OEO_00390029 :OEO_00390030 :OEO_00390031 :OEO_00390032 ) ] ],
        :OEO_00020166 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940

Axiom update:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2004
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2005""" .

:OEO_00390039 a owl:Class ;
    rdfs:label "select appropriate turbine types"@en ;
    obo:IAO_0000115 """Select appropriate turbine types is an action specification that describes the process of choosing wind turbine models based on site-specific wind characteristics, hub height, and rotor diameter.
Wind characteristics include speed, direction, frequency, turbulence, and seasonal or diurnal patterns.""" ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1966""" .

:OEO_00390040 a owl:Class ;
    rdfs:label "place turbines within area"@en ;
    obo:IAO_0000115 "Place turbines within area is an action specification that describes the definition of the spatial arrangement of wind turbines within the designated area, ensuring optimal positioning based on site characteristics and layout constraints." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390041 a owl:Class ;
    rdfs:label "account for wake losses"@en ;
    obo:IAO_0000115 "Account for wake losses is an action specification that describes the inclusion of losses due to wind turbine wake effects, which reduce wind speed and energy yield behind turbines." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390042 a owl:Class ;
    rdfs:label "determine annual energy yield"@en ;
    obo:IAO_0000115 "Determine annual energy yield is an action specification that describes how a turbine's power curve is combined with the wind speed distribution to calculate the expected annual energy production." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390043 a owl:Class ;
    rdfs:label "determine capacity factor"@en ;
    obo:IAO_0000115 "Determine capacity factor is an action specification that describes the calculation of the capacity factor (CF), which represents the ratio of actual energy output to the maximum possible output over a given time period." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390044 a owl:Class ;
    rdfs:label "calculate technical potential"@en ;
    obo:IAO_0000115 "Calculate technical potential is an action specification that describes how the total energy production capability of the available area is determined, factoring in turbine placement, capacity density, and wake losses." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390045 a owl:Class ;
    rdfs:label "determined wind potential"@en ;
    obo:IAO_0000115 "Determined wind potential is an object specification that defines the goal of a methodology as a state of understanding the technical wind potential of the available area." ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390046 a owl:Class ;
    rdfs:label "wind potential determination method"@en ;
    obo:IAO_0000115 "Wind potential determination method is a methodology with the goal of calculating the technical wind energy potential within the identified suitable area, considering turbine technology, placement, and energy yield factors." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00390045 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00390039 :OEO_00390040 :OEO_00390041 :OEO_00390042 :OEO_00390043 :OEO_00390044 :OEO_00390066 ) ] ],
        :OEO_00020166 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940

Axiom update:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2004
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2005""" .

:OEO_00390049 a owl:Class ;
    rdfs:label "determine wind turbine lifetime"@en ;
    obo:IAO_0000115 "Determine wind turbine lifetime is an action specification that describes the process of estimating the operational lifespan of a wind turbine, based on design and site-specific conditions." ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390050 a owl:Class ;
    rdfs:label "determine capital expenditures"@en ;
    obo:IAO_0000115 "Determine capital expenditures is an action specification that describes the calculation of capital expenditures (CAPEX) required for the installation of wind turbines and associated infrastructure." ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390051 a owl:Class ;
    rdfs:label "determine operational expenditures"@en ;
    obo:IAO_0000115 "Determine operational expenditures is an action specification that describes the estimation of ongoing operational expenditures (OPEX) for wind turbines, including routine maintenance and operational management. These include operating and maintenance costs." ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390052 a owl:Class ;
    rdfs:label "determine discount and interest rate"@en ;
    obo:IAO_0000115 "Determine discount and interest rate is an action specification that describes the selection of financial discount and interest rates, which are used in the economic analysis to account for the time value of money." ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390053 a owl:Class ;
    rdfs:label "calculate levelised cost of electricity"@en ;
    obo:IAO_0000115 "Calculate levelised cost of electricity is an action specification that describes the computation of the levelised cost of electricity (LCOE) either for individual turbines or for sub-regions within the study area by applying a cost model based on the previously calculated economic parameters and the capacity factors." ;
    obo:IAO_0000118 "calculate LCOE"@en ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1964""" .

:OEO_00390054 a owl:Class ;
    rdfs:label "calculate economic potential"@en ;
    obo:IAO_0000115 "Calculate economic potential is an action specification that describes the determination of the total economic potential of the available area under a maximum threshold LCOE value." ;
    rdfs:subClassOf :OEO_00390048 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390055 a owl:Class ;
    rdfs:label "determined techno-economic potential"@en ;
    obo:IAO_0000115 "Determined techno-economic potential is an object specification that defines the goal of a methodology as a state of understanding the techno-economic potential of the available region." ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390056 a owl:Class ;
    rdfs:label "techno-economic potential determination method"@en ;
    obo:IAO_0000115 "Techno-economic potential determination method is a methodology with the goal of assessing the economic viability of wind energy projects within the available area, based on the technical potential and incorporating cost factors and economic metrics." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00390049 :OEO_00390050 :OEO_00390051 :OEO_00390052 :OEO_00390053 :OEO_00390055 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00390054 ],
        :OEO_00020166 ;
    :OEO_00020426 """Add;
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940

Axiom update:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2004
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2005""" .

:OEO_00390059 a owl:Class ;
    rdfs:label "apply socio-economic constraints for assessment of potential"@en ;
    obo:IAO_0000115 "Apply socio-economic constraints for assessment of potential is an action specification that describes the process of integrating non-technical factors, such as social acceptance, land use regulations, or market conditions, into the potential assessment." ;
    rdfs:subClassOf :OEO_00390058 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940

Change label:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1994
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1995""" .

:OEO_00390060 a owl:Class ;
    rdfs:label "calculate feasible potential"@en ;
    obo:IAO_0000115 "Calculate feasible potential is an action specification that describes the calculation of the feasible wind energy potential, considering both technical and socio-economic constraints." ;
    rdfs:subClassOf :OEO_00390058 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390061 a owl:Class ;
    rdfs:label "determined feasible potential"@en ;
    obo:IAO_0000115 "Determined feasible potential is an object specification that defines the goal of a methodology as a state of understanding the feasible potential of something." ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390062 a owl:Class ;
    rdfs:label "feasible potental determination method"@en ;
    obo:IAO_0000115 "Feasible potental determination method is a methodology with the goal of calculating the wind energy potential that remains after applying additional social, regulatory, or market constraints to the available region." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( :OEO_00390059 :OEO_00390060 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00390061 ],
        :OEO_00020166 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940

Axiom update:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2004
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2005""" .

:OEO_00390066 a owl:Class ;
    rdfs:label "determine capacity density"@en ;
    obo:IAO_0000115 "Determine capacity density is an action specification that describes the calculation of the installed capacity per unit area (MW per km²) by assessing the number and power rating of turbines within the available space." ;
    rdfs:subClassOf :OEO_00390038 ;
    :OEO_00020426 """Add:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1891
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1940""" .

:OEO_00390101 a owl:ObjectProperty ;
    rdfs:label "covers technology"@en ;
    obo:IAO_0000115 "covers technology is a relation that holds between a study and a technology covered in the study." ;
    rdfs:domain :OEO_00020011 ;
    rdfs:range :OEO_00000407 ;
    rdfs:subPropertyOf :OEO_00000522 ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00400037 a owl:ObjectProperty ;
    rdfs:label "has uncertainty nature"@en ;
    obo:IAO_0000115 "A relation between an uncertainty of a model (x) and a nature of model uncertainty (z) that indicates x is of kind z."@en ;
    obo:IAO_0000119 "https://www.researchgate.net/publication/264816512_Classifying_and_communicating_uncertainties_in_model-based_policy_analysis" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1829
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1945""" ;
    rdfs:domain :OEO_00400012 ;
    rdfs:range :OEO_00400013 ;
    rdfs:subPropertyOf obo:RO_0000086 .

:OEO_00400038 a owl:ObjectProperty ;
    rdfs:label "has uncertainty level"@en ;
    obo:IAO_0000115 "A relation between an uncertainty of a model (x) and a level of model uncertainty (y) that indicates the degree or severity y of x." ;
    obo:IAO_0000119 "https://www.researchgate.net/publication/264816512_Classifying_and_communicating_uncertainties_in_model-based_policy_analysis" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1829
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1945""" ;
    rdfs:domain :OEO_00400012 ;
    rdfs:range :OEO_00400017 ;
    rdfs:subPropertyOf obo:RO_0000086 .

:OEO_00400039 a owl:ObjectProperty ;
    rdfs:label "has uncertainty location"@en ;
    obo:IAO_0000115 "A relation between an uncertainty of a model (x) and a location of model uncertainty (y) that indicates x is located in y.",
        """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1829
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1945""" ;
    obo:IAO_0000119 "https://www.researchgate.net/publication/264816512_Classifying_and_communicating_uncertainties_in_model-based_policy_analysis" ;
    rdfs:domain :OEO_00400012 .

:OEO_00400040 a owl:Class ;
    rdfs:label "conceptual model"@en ;
    obo:IAO_0000115 "A conceptual model is an information content entity that specifies variables and relationships within a system boundary." ;
    obo:IAO_0000119 "https://www.researchgate.net/publication/264816512_Classifying_and_communicating_uncertainties_in_model-based_policy_analysis" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1952
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1976

Add 'model uncertainty location axiom'
issue:https://github.com/OpenEnergyPlatform/ontology/issues/1829
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1990""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00020353 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00400022 ],
        obo:IAO_0000030 .

:OEO_00400043 a owl:Class ;
    rdfs:label "model uncertainty location"@en ;
    obo:IAO_0000115 "A model uncertainty location is a continuant that has the role to be a location of model uncertainty." ;
    obo:IAO_0000233 """issue:https://github.com/OpenEnergyPlatform/ontology/issues/1829
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1990""" ;
    rdfs:subClassOf obo:BFO_0000002 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( obo:BFO_0000002 [ a owl:Restriction ;
                        owl:onProperty obo:RO_0000087 ;
                        owl:someValuesFrom :OEO_00400022 ] ) ] .

:OEO_00410008 a owl:Class ;
    rdfs:label "bird sanctuary role"@en ;
    obo:IAO_0000115 "A bird sanctuary role is a protected area role for areas, aimed at protecting and conserving endangered and migratory bird species, within the European \"Natura 2000\" network of protected areas."@en ;
    obo:IAO_0000119 "See German nature conservation law: § 31 ff. BNatSchG, Netz „Natura 2000“: https://www.gesetze-im-internet.de/bnatschg_2009/BJNR254210009.html#BJNR254210009BJNG000600000" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410014 ;
            owl:onProperty :OEO_00000504 ],
        :OEO_00410013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1991""" .

:OEO_00410010 a owl:Class ;
    rdfs:label "fauna flora habitat role"@en ;
    obo:IAO_0000115 "A fauna flora habitat role is a protected area role for areas, aimed at conserving natural habitats and wild fauna and flora, within the European \"Natura 2000\" network of protected areas."@en ;
    obo:IAO_0000119 "See German nature conservation law: § 31 ff. BNatSchG, Netz „Natura 2000“: https://www.gesetze-im-internet.de/bnatschg_2009/BJNR254210009.html#BJNR254210009BJNG000600000" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410014 ;
            owl:onProperty :OEO_00000504 ],
        :OEO_00410013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1991""" .

:OEO_00410017 a owl:Class ;
    rdfs:label "biosphere reserve role"@en ;
    obo:IAO_0000115 "A biosphere reserve role is a protected area role for areas, aimed at conserving biodiversity, promoting sustainable development, and supporting research and education, within the UNESCO \"Man and the Biosphere\" (MAB) Programme."@en ;
    obo:IAO_0000119 "See German nature conservation law: § 25 BNatSchG: https://www.gesetze-im-internet.de/bnatschg_2009/__25.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410014 ;
            owl:onProperty :OEO_00000504 ],
        :OEO_00410013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410019 a owl:Class ;
    rdfs:label "protected landscape area role"@en ;
    obo:IAO_0000115 "A protected landscape area role is a protected area role for areas, aimed at conserving and enhancing the natural and cultural landscape, while allowing for sustainable land use and recreational activities."@en ;
    obo:IAO_0000119 "See German nature conservation law: § 26 BNatSchG: https://www.gesetze-im-internet.de/bnatschg_2009/__26.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410014 ;
            owl:onProperty :OEO_00000504 ],
        :OEO_00410013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410022 a owl:Class ;
    rdfs:label "water protection area role"@en ;
    obo:IAO_0000115 "A water protection area role is a protected area role for areas, aimed at safeguarding the quality and quantity of water resources, including surface water and groundwater."@en ;
    obo:IAO_0000119 """See German water resources act: 
§ 51 WHG: https://www.gesetze-im-internet.de/whg_2009/__51.html
§ 52 WHG: https://www.gesetze-im-internet.de/whg_2009/__52.html""" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410020 ;
            owl:onProperty :OEO_00000504 ],
        :OEO_00410013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410024 a owl:Class ;
    rdfs:label "floodplain role"@en ;
    obo:IAO_0000115 "A floodplain role is a role for areas between surface waters and dykes or high banks and other areas that are flooded or flowed through during flooding of a surface water body or that are used for flood relief or retention."@en ;
    obo:IAO_0000119 "See German water resources act: § 76 WHG: https://www.gesetze-im-internet.de/whg_2009/__76.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410020 ;
            owl:onProperty :OEO_00000504 ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410026 a owl:Class ;
    rdfs:label "forest role"@en ;
    obo:IAO_0000115 "A forest role is a role for areas planted with forest plants as well as clear-cut or thinned ground areas, forest paths, forest division and safety strips, forest openings and clearings, forest meadows, game grazing areas, wood storage areas and other areas connected to and serving the forest."@en ;
    obo:IAO_0000119 "See German forest law: § 2 BWaldG: https://www.gesetze-im-internet.de/bwaldg/__2.html" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00410027 ;
            owl:onProperty :OEO_00000504 ],
        obo:BFO_0000023 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410027 a owl:NamedIndividual,
        :OEO_00410009 ;
    rdfs:label "BWaldG"@en ;
    obo:IAO_0000115 "The BWaldG is a legislation providing the legal framework for the preservation of forests and the promotion of forestry in Germany."@en ;
    obo:IAO_0000118 "Bundeswaldgesetz"@de,
        "forest law"@en ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410032 a owl:Class ;
    rdfs:label "high soil quality role"@en ;
    obo:IAO_0000115 "A high soil quality role is a soil quality role inherent in a region of relevance reflecting that the soil, that is part of the bearer, has a high soil quality."@en ;
    rdfs:subClassOf :OEO_00410031 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

:OEO_00410033 a owl:Class ;
    rdfs:label "poor soil quality role"@en ;
    obo:IAO_0000115 "A poor soil quality role is a soil quality role inherent in a region of relevance reflecting that the soil, that is part of the bearer, has a poor soil quality."@en ;
    rdfs:subClassOf :OEO_00410031 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1962
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2006""" .

