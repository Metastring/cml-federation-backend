:OEO_00410009 a owl:Class ;
    rdfs:label "legislation"@en ;
    obo:IAO_0000115 "A legislation is a plan specification that is produced by a government and enables, prohibits or bans activities, or establishes rights or responsibilities."@en ;
    obo:IAO_0000119 "Definition partly adapted from https://addictovocab.org/ADDICTO_0000488" ;
    rdfs:subClassOf [ a owl:Restriction ;
