:OEO_00000180 a owl:NamedIndividual,
        :OEO_00000382 ;
    rdfs:label "General Algebraic Modeling System"@en ;
    obo:IAO_0000115 "The General Algebraic Modeling System (GAMS) is a proprietary software framework developed by GAMS Development Corp. that uses the GAMS programming language."@en ;
    obo:IAO_0000118 "GAMS"@de,
