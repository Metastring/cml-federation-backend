rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652""" .

:OEO_00240036 a owl:Class ;
    rdfs:label "import price"@en ;
    obo:IAO_0000115 "An import price is the monetary price for the import of a material entity."@en ;
    obo:IAO_0000118 "Importpreis"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020056 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :OEO_00010116 [ a owl:Restriction ;
                                owl:onProperty obo:RO_0000053 ;
