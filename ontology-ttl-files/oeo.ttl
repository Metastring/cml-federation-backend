    rdfs:domain obo:BFO_0000015 ;
    rdfs:range :OEO_00000150 ;
    rdfs:subPropertyOf :OEO_00010235 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1530
