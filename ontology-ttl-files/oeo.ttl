    rdfs:label "fuel market exchange"@en ;
    obo:IAO_0000115 "A fuel market exchange is an energy market exchange where fuels like oil, coal, renewable fuels, and natural gas are traded." ;
    rdfs:subClassOf [ a owl:Restriction ;
