issue: https://github.com/OpenEnergyPlatform/ontology/issues/1376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1638"""@en .

:OEO_00360002 a owl:Class ;
    rdfs:label "model intercomparison study"@en ;
    obo:IAO_0000115 "A model intercomparison study is a scenario study that performs a comparison of several models using a reference scenario."@en ;
    rdfs:subClassOf :OEO_00010252 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1640
