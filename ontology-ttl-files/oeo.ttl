:OEO_00020426 a owl:AnnotationProperty ;
    rdfs:label "term tracker annotation" ;
    obo:IAO_0000115 "A term tracker annotation is an editor note used to track the history of an entity. For each change, it records the related GitHub issue and pull request." ;
    obo:IAO_0000116 "This annotation property was added to replace the previously used \"term tracker item\" http://purl.obolibrary.org/obo/IAO_0000233." ;
    rdfs:subPropertyOf obo:IAO_0000116 ;
    :OEO_00020426 """Replace term tracker item
