            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00320056 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00000503 ;
            owl:someValuesFrom :OEO_00000099 ],
        :OEO_00010023 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00010023 [ a owl:Restriction ;
