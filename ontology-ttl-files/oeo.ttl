:OEO_00330023 a owl:Class ;
    rdfs:label "life cycle assessment"@en ;
    obo:IAO_0000115 "A life cycle assessment is a methodology to calculate and analyse environmental impacts of the life cycle of a material entity or process." ;
    obo:IAO_0000118 "Lebenszyklusanalyse"@de,
        "Ökobilanz"@de,
        "LCA"@en,
        "life cycle analysis"@en ;
    rdfs:subClassOf :OEO_00020166 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1551
