:OEO_00020171 a owl:Class ;
    rdfs:label "grid connection cost"@en ;
    obo:IAO_0000115 "Grid connection costs are investment costs for establishing the grid connection from the energy generating device to point of connection to national grid." ;
    rdfs:subClassOf :OEO_00020167 ;
