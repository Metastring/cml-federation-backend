:OEO_00390096 a owl:DatatypeProperty ;
    rdfs:label "has publication date"@en ;
    obo:IAO_0000115 "has publication date is the relation between a report and the year it was published in." ;
    rdfs:domain obo:IAO_0000088 ;
    rdfs:range xsd:dateTime ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00390098 a owl:DatatypeProperty ;
    rdfs:label "has doi"@en ;
    obo:IAO_0000115 "has doi is the relation between a digital object and the literal representing its doi (digital object identifier)." ;
    rdfs:domain obo:IAO_0000088 ;
