:OEO_00140096 a owl:ObjectProperty ;
    rdfs:label "has typical computation hardware"@en ;
    obo:IAO_0000115 "A relation between an algorithm or a software and the typical hardware used for its execution." ;
    rdfs:domain [ a owl:Class ;
