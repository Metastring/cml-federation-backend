    dc:description """The Open Energy Ontology is an ontology for all aspects of the energy modelling domain.
It is developed in four main modules: 'oeo-model', a module for all entities related to models and modelling; 'oeo-physical', a module for all entities related to the world of energy and energy generation; 'oeo-social', a module for all relevant social and economic aspects of the energy domain; 'oeo-shared', a module to cover entities and relations needed in all of the modules above to prevent them getting implemented multiple times.
A supplementary module is the oeo-physical-axioms module, which contains general class axioms.""" ;
    dcterms:creator "OEO Developer Team <https://github.com/OpenEnergyPlatform/ontology/blob/master/CITATION.cff>" ;
    dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:title "Open Energy Ontology" ;
    owl:versionIRI <https://openenergyplatform.org/ontology/oeo/releases/2.13.0/oeo.owl> ;
    owl:versionInfo "2.13.0" .

:OEO_00000004 a owl:Class ;
    rdfs:label "biogas power plant"@en ;
    obo:IAO_0000115 "A biogas power plant is a biofuel power plant that has biogas power units as parts." ;
    obo:IAO_0000118 "Biogaskraftwerk"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00000005 ],
        :OEO_00000073 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/750
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/752""" .

:OEO_00000009 a owl:Class ;
    rdfs:label "electric heat pump"@en ;
    obo:IAO_0000115 "An electric heat pump is a heat pump that uses electrical energy as drive energy."@en ;
    obo:IAO_0000118 "elektrische Wärmepumpe"@de ;
    rdfs:subClassOf :OEO_00000212 ;
    :OEO_00020426 """fix energy axiom:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1281
pull: https://github.com/OpenEnergyPlatform/ontology/pulls/1282

remove has energy input/out axioms:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2190
pull: https://github.com/OpenEnergyPlatform/ontology/pulls/2233""" .

:OEO_00000013 a owl:Class ;
    rdfs:label "fluorinated greenhouse gas"@en ;
    obo:IAO_0000115 "A fluorinated greenhouse gas is a greenhouse gas that is produced by fluorination. Hence it contains Fluor (F) atoms and is of anthropogenic origin." ;
    obo:IAO_0000118 "F-Gas"@de,
        "Fluoriertes Treibhausgas"@de ;
    rdfs:subClassOf :OEO_00000020 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( :OEO_00000026 :OEO_00000038 :OEO_00000219 :OEO_00000322 ) ] .

:OEO_00000036 a owl:Class ;
    rdfs:label "solid biomass power plant"@en ;
    obo:IAO_0000115 "A solid biomass power plant is a biofuel power plant that has solid biomass power units as parts." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00000037 ],
        :OEO_00000073 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/750
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/752""" .

:OEO_00000047 a owl:Class ;
    rdfs:label "AC-line"@en ;
    obo:IAO_0000115 "An AC-line is a powerline for transferring alternating current."@en ;
    obo:IAO_0000118 "Wechselstromleitung"@de ;
    rdfs:comment "undirected" ;
    rdfs:subClassOf :OEO_00000253 ;
    owl:disjointWith :OEO_00000126 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/231
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/385

remove "high voltage" from definition
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2164
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2266""" .

:OEO_00000048 a owl:Class ;
    rdfs:label "acronym"@en ;
    obo:IAO_0000115 "An acronym is an abbreviation of the title by using the first letters of each part of the title."@en ;
    obo:IAO_0000118 "Akronym"@de ;
    rdfs:subClassOf :OEO_00010247 ;
    :OEO_00020426 """make subclass of abbreviation:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1039
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1075""" .

:OEO_00000049 a owl:NamedIndividual,
        :OEO_00000281 ;
    rdfs:label "active"@en ;
    obo:IAO_0000118 "aktiv"@de .

:OEO_00000059 a owl:Class ;
    rdfs:label "application programming interface"@en ;
    obo:IAO_0000115 "An application programming interface (API) is a software interface allowing two software applications to communicate with each other."@en ;
    obo:IAO_0000118 "Programmierschnittstelle"@de,
        "API"@en ;
    rdfs:subClassOf :OEO_00000239 ;
