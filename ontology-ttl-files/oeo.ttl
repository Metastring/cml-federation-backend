:OEO_00050010 a owl:Class ;
    rdfs:label "petawatt-hour"@en ;
    obo:IAO_0000115 "A petawatt-hour is a watt-hour based unit which is equal to 10^15 watt-hours." ;
    obo:IAO_0000118 "Petawattstunde"@de,
        "petawatt hours"@en ;
    oboInOwl:hasExactSynonym "PWh" ;
