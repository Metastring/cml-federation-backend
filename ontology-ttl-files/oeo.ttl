:OEO_00010051 a owl:Class ;
    rdfs:label "sensitivity analysis"@en ;
    obo:IAO_0000115 "A sensitivity analysis is the process of comparing different model calculations based on a variation of input parameters (exogenous data items)." ;
    obo:IAO_0000118 "Sensitivitätsanalyse"@de ;
    rdfs:subClassOf obo:BFO_0000015 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/483
