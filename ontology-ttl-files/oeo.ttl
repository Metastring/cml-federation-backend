:OEO_00020146 a owl:Class ;
    rdfs:label "variable production cost"@en ;
    obo:IAO_0000112 "An example for variable production cost are costs incurred for raw materials (of which more are needed if production is increased)." ;
    obo:IAO_0000115 "Variable production costs are costs that depend on the amount of goods or services produced and which are paid by the producer." ;
    obo:IAO_0000118 "variable Produktionskosten"@de ;
    rdfs:subClassOf :OEO_00020145 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/891
