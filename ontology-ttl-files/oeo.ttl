:OEO_00000149 a owl:Class ;
    rdfs:label "empirical data set"@en ;
    obo:IAO_0000112 "The measurement series of some experiment."@en ;
    obo:IAO_0000115 "An empirical data set is a dataset that is obtained from observations in the real world."@en ;
    obo:IAO_0000118 "Empirischer Datensatz"@de ;
    rdfs:subClassOf obo:IAO_0000100 ;
    owl:disjointWith :OEO_00000403 ;
    :OEO_00020426 """Move to oeo-shared and harmonise label:
