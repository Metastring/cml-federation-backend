:OEO_00020173 a owl:Class ;
    rdfs:label "decommissioning cost"@en ;
    obo:IAO_0000115 "Decommissioning costs are investment costs arising from the decommissioning of a technological device at the end of its lifetime." ;
    obo:IAO_0000118 "Stilllegungskosten"@de ;
    rdfs:subClassOf :OEO_00020167 ;
