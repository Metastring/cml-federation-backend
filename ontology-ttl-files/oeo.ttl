:OEO_00240010 a owl:Class ;
    rdfs:label "combined heat and power generating unit"@en ;
    obo:IAO_0000115 "A combined heat and power generating unit is an energy transformation unit that has both the function to produce thermal energy and the function to produce electrical energy."@en ;
    obo:IAO_0000118 "KWK-Anlage"@de,
        "Kraft-Wärme-Kopplungs-Anlage"@de,
        "co-generating power unit"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
