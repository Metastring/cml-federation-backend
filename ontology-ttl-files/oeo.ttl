                                owl:onProperty :OEO_00000533 ;
                                owl:someValuesFrom :OEO_00240027 ] ) ] ],
        owl:NamedIndividual,
        :OEO_00000227 ;
    rdfs:label "CRF sector (IPCC 2006): chemical industry"@en ;
    obo:BFO_0000050 :OEO_00010046 ;
    obo:IAO_0000115 """The CRF sector (IPCC 2006) 'chemical industry' is an industry sector defined by the 2006 IPCC Guidelines for National Greenhouse Gas Inventories:
Greenhouse gas emissions that result from the production of various inorganic and organic chemicals.""" ;
    obo:IAO_0000119 "2006 IPCC Guidelines for National Greenhouse Gas Inventories, Volume 3, Chapter 3.1, https://www.ipcc-nggip.iges.or.jp/public/2006gl/" ;
    :OEO_00000504 :OEO_00000242 ;
    :OEO_00010037 "CRF 2.B" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/858
