:OEO_00280003 a owl:Class ;
    rdfs:label "comma separated file format"@en ;
    obo:IAO_0000115 "A comma separated file format is a delimiter separated file format that uses comma (,) as delimiter." ;
    obo:IAO_0000118 "CSV" ;
    rdfs:subClassOf :OEO_00280002 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1145
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1326""" .

:OEO_00280005 a owl:Class ;
    rdfs:label "source code file format"@en ;
    obo:IAO_0000115 "A source code file format is a text file format that is source code in a programming language." ;
    rdfs:subClassOf :OEO_00280001 ;
    :OEO_00020426 """Issue: https://github.com/OpenEnergyPlatform/ontology/issues/1145
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1326

Make subclass of 'text file format`:
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1410""" .

:OEO_00280008 a owl:Class ;
    rdfs:label "PMSG wind energy converting unit"@en ;
    obo:IAO_0000115 "A PMSG wind energy converting unit is a wind energy converting unit that has a permanent magnet synchronous generator as part." ;
    obo:IAO_0000118 "permanent magnet synchronous generator wind energy converting unit" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:subClassOf :OEO_00000044 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000044 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom :OEO_00280006 ] ) ] .

:OEO_00280009 a owl:Class ;
    rdfs:label "PMSG wind power technology"@en ;
    obo:IAO_0000118 "permanent magnet synchronous generator wind power technology"@en ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:comment "A PMSG wind power technology is a wind power generation technology that describes how to use wind energy converting units with permanent magnet synchronous generators as parts." ;
    rdfs:subClassOf :OEO_00010424 .

:OEO_00280011 a owl:Class ;
    rdfs:label "PERC panel"@en ;
    obo:IAO_0000115 "A PERC panel is a PV panel constructed with PERC cells." ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:subClassOf :OEO_00000348 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000348 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom :OEO_00280010 ] ) ] .

:OEO_00280012 a owl:Class ;
    rdfs:label "NMC battery"@en ;
    obo:IAO_0000115 "A NMC battery is a lithium-ion battery that is composed of mixed metal oxides of lithium, nickel, manganese and cobalt." ;
    obo:IAO_0000118 "nickel-manganese-cobalt battery" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:comment "These batteries are commonly used for mobile devices and electric vehicles." ;
    rdfs:subClassOf :OEO_00000248 .

:OEO_00280013 a owl:Class ;
    rdfs:label "LFP battery"@en ;
    obo:IAO_0000115 "A LFP battery is a lithium-ion battery containing iron phosphate." ;
    obo:IAO_0000118 "lithium ferrophosphate battery" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:comment "These batteries use lithium iron phosphate as the cathode material, and a graphitic carbon electrode with a metallic backing as the anode." ;
    rdfs:subClassOf :OEO_00000248 .

:OEO_00280014 a owl:Class ;
    rdfs:label "lead-acid battery"@en ;
    obo:IAO_0000115 "A lead-acid battery is a battery whose electrodes are composed of lead and its electrolyte is a solution of sulfuric acid." ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:subClassOf :OEO_00000068 .

:OEO_00280015 a owl:Class ;
    rdfs:label "squirrel-cage induction generator"@en ;
    obo:IAO_0000115 "A squirrel-cage induction generator is an induction generator whose rotating component is a squirrel-cage rotor." ;
    obo:IAO_0000118 "SCIG" ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:subClassOf :OEO_00280016 .

:OEO_00280017 a owl:Class ;
    rdfs:label "SCIG wind energy converting unit"@en ;
    obo:IAO_0000115 "A SCIG wind energy converting unit is a wind energy converting unit that has a squirrel-cage induction generator as part." ;
    obo:IAO_0000118 "squirrel-cage induction generator wind energy converting unit" ;
    rdfs:subClassOf :OEO_00000044 .

:OEO_00280018 a owl:Class ;
    rdfs:label "direct drive wind energy converting unit"@en ;
    obo:IAO_0000115 "A direct drive wind energy converting unit is a wind energy converting unit whose rotor is directly connected to the generator." ;
    obo:IAO_0000233 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1979
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2055""" ;
    rdfs:subClassOf :OEO_00000044 .

:OEO_00280019 a owl:Class ;
    rdfs:label "gearbox wind energy converting unit"@en ;
    obo:IAO_0000115 "A gearbox wind energy converting unit is a wind energy converting unit whose rotor is connected to its generator through a gearbox." ;
    rdfs:subClassOf :OEO_00000044 .

:OEO_00290001 a owl:Class ;
    rdfs:label "slope"@en ;
    obo:IAO_0000115 "A slope is a quantity value with a plane angle unit that measures the angle between the plane of a surface and the horizontal plane."@en ;
    obo:IAO_0000118 "Neigung"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00040010 ;
            owl:someValuesFrom obo:UO_0000122 ],
