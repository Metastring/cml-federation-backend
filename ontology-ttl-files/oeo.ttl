:OEO_00020186 a owl:Class ;
    rdfs:label "data licence"@en ;
    obo:IAO_0000115 "A data licence is a licence that determines ownership, database protection, and permissions for data." ;
    obo:IAO_0000118 "Datenlizenz"@de,
        "data license"@en ;
