www:ont00000011 a owl:Class ;
    rdfs:label "Nominal Stasis"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000135 ;
    skos:altLabel "Nominal"@en ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has a level of intensity or functionality that falls within the designed, expected, or acceptable range such that the Independent Continuant is of normal value, usefulness, or functionality."@en ;
    www:ont00001754 "https://en.oxforddictionaries.com/definition/nominal (Definition 6)" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000100 a owl:Class ;
    rdfs:label "Stasis of Partially Mission Capable"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001132 ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is capable of performing some but not all of its primary functions for the specified Mission."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000335 a owl:Class ;
    rdfs:label "Stasis of Generically Dependent Continuant"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000819 ;
    skos:definition "A Stasis in which some Independent Continuant bears some Generically Dependent Continuant that remains unchanged during a Temporal Interval."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000535 a owl:Class ;
    rdfs:label "Decrease of Quality"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000290 ;
    skos:definition "A Decrease of Specifically Dependent Continuant in which some Independent Continuant has a decrease of some Quality that it bears."@en ;
    skos:example "Weight Loss, Decreasing Temperature, decreasing color intensity, loss of structural integrity" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000543 a owl:Class ;
    rdfs:label "Decrease of Disposition"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000854 ;
    skos:definition "A Decrease of Realizable Entity in which some Independent Continuant has a decrease of some Disposition it bears."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000555 a owl:Class ;
    rdfs:label "Enhanced Stasis"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000135 ;
    skos:altLabel "Enhanced"@en ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears a Quality or Realizable Entity that has undergone improvement (i.e., an increase or gain) due to a previous action or event such that the Independent Continuant is now of greater value, usefulness, or functionality."@en ;
    www:ont00001754 "http://www.thefreedictionary.com/enhance" ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000557 a owl:Class ;
    rdfs:label "Stasis of Non-Mission Capable"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001132 ;
    skos:definition "A Stasis of Mission Capability during which the participating Continuant is not capable of performing any of its primary functions for the specified Mission."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000847 a owl:Class ;
    rdfs:label "Active Stasis"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact is realizing one or more of its designed Artifact Functions (especially one of its primary functions)."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000850 a owl:Class ;
    rdfs:label "Stasis of Quality"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000135 ;
    skos:definition "A Stasis of Specifically Dependent Continuant in which some Independent Continuant bears some Quality that remains unchanged during a Temporal Interval."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00000870 a owl:Class ;
    rdfs:label "Infrastructure System"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf obo:BFO_0000040 ;
    skos:altLabel "Infrastructure"@en ;
    skos:definition "A Material Entity that is composed of elements bearing Infrastructure Roles and is by itself sufficient to provide a planned service or benefit to some organization that maintains its elements."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

www:ont00001066 a owl:Class ;
    rdfs:label "Loss of Disposition"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000250 ;
    skos:definition "A Loss of Realizable Entity in which some Independent Continuant ceases to be the bearer of some Disposition."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00001141 a owl:Class ;
    rdfs:label "Infrastructure Role"@en ;
    rdfs:comment "The disposition will typically be a function of an artifact, which is often designed to be part of some Infrastructure system. But not always. In some cases an entity may be repurposed to be an element of some Infrastructure. In those cases it is a capability of that entity that supports the functioning of the system."@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf obo:BFO_0000023 ;
    skos:definition "A Role that inheres in the bearer of a Disposition and has been assigned to an Infrastructure System such that the realization of that Disposition is sometimes part of the functioning of the Infrastructure System."@en ;
    www:ont00001754 "https://archive.org/details/economicsprincip00osul/page/n489/mode/2up"^^xsd:anyURI ;
    www:ont00001760 "https://www.commoncoreontologies.org/ArtifactOntology"^^xsd:anyURI .

www:ont00001191 a owl:Class ;
    rdfs:label "Operational Stasis"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00001213 ;
    skos:definition "A Stasis of Artifact Operationality that holds during a Temporal Interval when an Artifact maintains its designed set of Artifact Functions (or at least maintains its primary functions)."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

www:ont00001356 a owl:Class ;
    rdfs:label "Increase of Disposition"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subClassOf www:ont00000611 ;
    skos:definition "An Increase of Realizable Entity in which some Independent Continuant has an increase of some Disposition that it bears."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/EventOntology"^^xsd:anyURI .

obo:BFO_0000027 a owl:Class ;
    rdfs:label "object aggregate"@en ;
    obo:BFO_0000179 "object-aggregate" ;
    obo:BFO_0000180 "ObjectAggregate" ;
    obo:IAO_0000112 "a collection of cells in a blood biobank."@en,
        "a swarm of bees is an aggregate of members who are linked together through natural bonds"@en,
        "a symphony orchestra"@en,
        "an organization is an aggregate whose member parts have roles of specific types (for example in a jazz band, a chess club, a football team)"@en,
        "defined by fiat: the aggregate of members of an organization"@en,
        "defined through physical attachment: the aggregate of atoms in a lump of granite"@en,
        "defined through physical containment: the aggregate of molecules of carbon dioxide in a sealed container"@en,
        "defined via attributive delimitations such as: the patients in this hospital"@en,
        "the aggregate of bearings in a constant velocity axle joint"@en,
        "the aggregate of blood cells in your body"@en,
        "the nitrogen atoms in the atmosphere"@en,
        "the restaurants in Palo Alto"@en,
        "your collection of Meissen ceramic plates."@en ;
    obo:IAO_0000116 "An entity a is an object aggregate if and only if there is a mutually exhaustive and pairwise disjoint partition of a into objects ",
        "BFO 2 Reference: object aggregates may gain and lose parts while remaining numerically identical (one and the same individual) over time. This holds both for aggregates whose membership is determined naturally (the aggregate of cells in your body) and aggregates determined by fiat (a baseball team, a congressional committee)."@en ;
    obo:IAO_0000119 "ISBN:978-3-938793-98-5pp124-158#Thomas Bittner and Barry Smith, 'A Theory of Granular Partitions', in K. Munn and B. Smith (eds.), Applied Ontology: An Introduction, Frankfurt/Lancaster: ontos, 2008, 125-158." ;
    obo:IAO_0000600 "b is an object aggregate means: b is a material entity consisting exactly of a plurality of objects as member_parts at all times at which b exists. (axiom label in BFO2 Reference: [025-004])"@en ;
    obo:IAO_0000602 "(forall (x) (if (ObjectAggregate x) (and (MaterialEntity x) (forall (t) (if (existsAt x t) (exists (y z) (and (Object y) (Object z) (memberPartOfAt y x t) (memberPartOfAt z x t) (not (= y z)))))) (not (exists (w t_1) (and (memberPartOfAt w x t_1) (not (Object w)))))))) // axiom label in BFO2 CLIF: [025-004] " ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:BFO_0000035 a owl:Class ;
    rdfs:label "process boundary"@en ;
    obo:BFO_0000179 "p-boundary" ;
    obo:BFO_0000180 "ProcessBoundary" ;
    obo:IAO_0000112 "the boundary between the 2nd and 3rd year of your life."@en ;
    obo:IAO_0000115 "p is a process boundary =Def. p is a temporal part of a process & p has no proper temporal parts. (axiom label in BFO2 Reference: [084-001])"@en ;
    obo:IAO_0000601 "Every process boundary occupies_temporal_region a zero-dimensional temporal region. (axiom label in BFO2 Reference: [085-002])"@en ;
    obo:IAO_0000602 "(forall (x) (if (ProcessBoundary x) (exists (y) (and (ZeroDimensionalTemporalRegion y) (occupiesTemporalRegion x y))))) // axiom label in BFO2 CLIF: [085-002] ",
        "(iff (ProcessBoundary a) (exists (p) (and (Process p) (temporalPartOf a p) (not (exists (b) (properTemporalPartOf b a)))))) // axiom label in BFO2 CLIF: [084-001] " ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subClassOf obo:BFO_0000003 .

obo:IAO_0000129 a owl:Class ;
    rdfs:label "version number"@en ;
    obo:IAO_0000111 "version number"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A version number is an information content entity which is a sequence of characters borne by part of each of a class of manufactured products or its packaging and indicates its order within a set of other products having the same name."@en ;
    obo:IAO_0000116 "Note: we feel that at the moment we are happy with a general version number, and that we will subclass as needed in the future. For example, see 7. genome sequence version"@en ;
    obo:IAO_0000117 "GROUP: IAO"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000028 .

obo:IAO_0000314 a owl:Class ;
    rdfs:label "document part"@en ;
    obo:IAO_0000111 "document part"@en ;
    obo:IAO_0000112 "An abstract, introduction, method or results section."@en ;
    obo:IAO_0000114 obo:IAO_0000120 ;
    obo:IAO_0000115 "An information content entity that is part of a document."@en ;
    obo:IAO_0000117 "PERSON: Lawrence Hunter"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000030 .

obo:IAO_0000591 a owl:Class ;
    rdfs:label "software method"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A software method (also called subroutine, subprogram, procedure, method, function, or routine) is software designed to execute a specific task."@en ;
    obo:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000010 .

obo:IAO_0000592 a owl:Class ;
    rdfs:label "software module"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A software module is software composed of a collection of software methods."@en ;
    obo:IAO_0000117 "PERSON: Melanei Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000010 .

obo:IAO_0000593 a owl:Class ;
    rdfs:label "software library"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A software library is software composed of a collection of software modules and/or software methods in a form that can be statically or dynamically linked to some software application."@en ;
    obo:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000010 .

obo:IAO_0000594 a owl:Class ;
    rdfs:label "software application"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A software application is software that can be directly executed by some processing unit."@en ;
    obo:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000010 .

obo:IAO_0000595 a owl:Class ;
    rdfs:label "software script"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A software script is software whose instructions can be executed using a software interpreter."@en ;
    obo:IAO_0000117 "PERSON: Melanie Courtot"@en,
        "PERSON: Michel Dumontier"@en ;
    obo:IAO_0000119 "https://github.com/information-artifact-ontology/IAO/issues/80"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000010 .

obo:RO_0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    obo:IAO_0000112 "this red color is a quality of this apple"@en ;
    obo:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    obo:IAO_0000118 "is quality of"@en,
        "quality_of"@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:subPropertyOf obo:RO_0000052 .

obo:RO_0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    obo:IAO_0000112 "this investigator role is a role of this person"@en ;
    obo:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    obo:IAO_0000116 "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    obo:IAO_0000118 "is role of"@en,
        "role_of"@en ;
    rdfs:comment "This relation is modeled after the BFO relation of the same name which was in BFO2, but is used in a more restricted sense - specifically, we model this relation as functional (inherited from characteristic-of). Note that this relation is now removed from BFO2020." ;
    rdfs:domain obo:BFO_0000023 ;
    rdfs:range obo:BFO_0000002 ;
    rdfs:subPropertyOf obo:RO_0000052 ;
    owl:inverseOf obo:RO_0000087 ;
    :OEO_00020426 """add domain and range:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1844
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1852""" .

obo:RO_0001015 a owl:ObjectProperty ;
    rdfs:label "location of"@en ;
    obo:IAO_0000111 "is location of"@en ;
    obo:IAO_0000112 "my head is the location of my brain"@en,
        "this cage is the location of this rat"@en ;
    obo:IAO_0000115 "a relation between two independent continuants, the location and the target, in which the target is entirely within the location"@en ;
    obo:IAO_0000116 "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ;
    obo:IAO_0000118 "location_of"@en ;
    obo:RO_0001900 obo:RO_0001901 ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf obo:RO_0001025 ;
    :OEO_00020426 """add `Inverse Of`
issue https://github.com/OpenEnergyPlatform/ontology/issues/979
pull request https://github.com/OpenEnergyPlatform/ontology/pull/1086""" .

obo:RO_0002224 a owl:ObjectProperty ;
    rdfs:label "starts with"@en ;
    obo:IAO_0000112 "Every insulin receptor signaling pathway starts with the binding of a ligand to the insulin receptor" ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "x starts with y if and only if x has part y and the time point at which x starts is equivalent to the time point at which y starts. Formally: α(y) = α(x) ∧ ω(y) < ω(x), where α is a function that maps a process to a start point, and ω is a function that maps a process to an end point." ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165>,
        "Chris Mungall" ;
    obo:IAO_0000118 "started by" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :OEO_00020426 """add `Inverse Of`
issue https://github.com/OpenEnergyPlatform/ontology/issues/979
pull request https://github.com/OpenEnergyPlatform/ontology/pull/1086""" .

obo:UO_0000002 a owl:Class ;
    rdfs:label "mass unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the amount of matter/energy of a physical object.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000036 a owl:Class ;
    rdfs:label "year" ;
    obo:IAO_0000115 "\"A time unit which is equal to 12 months which in science is taken to be equal to 365.25 days.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000036 .

obo:UO_0000060 a owl:Class ;
    rdfs:label "speed/velocity unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the rate of movement. Speed is measured in the same physical units of measurement as velocity, but does not contain the element of direction that velocity has. Speed is thus the magnitude component of velocity.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000182 a owl:Class ;
    rdfs:label "density unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the influence exerted by some mass.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000190 a owl:Class ;
    rdfs:label "ratio unit" ;
    obo:IAO_0000115 "\"A dimensionless unit which denotes an amount or magnitude of one quantity relative to another.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000186 .

obo:UO_0000293 a owl:Class ;
    rdfs:label "mega" ;
    obo:IAO_0000115 "\"A prefix in the metric system denoting a factor of million.\" [UO:GVG]" ;
    oboInOwl:hasExactSynonym "10^[6]",
        "M" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000046 .

:OEO_00000025 a owl:Class ;
    rdfs:label "methane"@en ;
    obo:IAO_0000115 "Methane is a hydrocarbon with the chemical formula CH4. It has a gaseous normal state of matter. It occurs naturally in the atmosphere as a trace gas and can work as a greenhouse gas. As it can be oxidised it can be used as a fuel." ;
    obo:IAO_0000118 "CH4",
        "Methan"@de ;
    obo:IAO_0006011 "http://purl.obolibrary.org/obo/CHEBI_16183" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00000001 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00000097 ],
        [ a owl:Restriction ;
            owl:hasValue :OEO_00000182 ;
            owl:onProperty :OEO_00000529 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00000198 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00010011 ],
        :OEO_00140159 ;
    :OEO_00020426 """classification changed:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/786
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/805""" .

:OEO_00000054 a owl:Class ;
    rdfs:label "air"@en ;
    obo:IAO_0000115 "Air is a gas mixture that forms the Earth's atmosphere."@en ;
    obo:IAO_0000118 "Luft"@de ;
    obo:IAO_0000119 "https://en.wikipedia.org/wiki/Air_(disambiguation)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000086 ;
            owl:someValuesFrom :OEO_00000446 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00140075 ],
        [ a owl:Restriction ;
            owl:hasValue :OEO_00000182 ;
            owl:onProperty :OEO_00000529 ],
        :OEO_00010236 ;
    skos:closeMatch obo:ENVO_00002005 ;
    :OEO_00020426 """add origin
issue: https://github.com/OpenEnergyPlatform/ontology/issues/515
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/684
remove origin 
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/861
make subclass of gas mixture and improve definition:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/988
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1009

remove axiom 'is used by' some 'energy storage unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1495
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1499

added axiom 'has disposition' some 'primary energy carrier disposition'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1032
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2095""" .

:OEO_00000055 a owl:Class ;
    rdfs:label "air pollution"@en ;
    obo:IAO_0000115 "Air pollution occurs when harmful or excessive quantities of substances including gases, particles, and biological molecules are introduced into Earth's atmosphere."@en ;
    obo:IAO_0000118 "Luftverschmutzung"@de ;
    obo:IAO_0000119 "https://en.wikipedia.org/w/index.php?title=Air_pollution&oldid=877082014"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom :OEO_00010012 ],
        :OEO_00000330 ;
    skos:closeMatch obo:ENVO_02500037 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/406
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/410""" .

:OEO_00000068 a owl:Class ;
    rdfs:label "battery"@en ;
    obo:IAO_0000115 "A battery is an energy storage object using different chemical or physical reactions to store energy."@en ;
    obo:IAO_0000118 "Akku"@de,
        "Batterie"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom :OEO_00140037 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000085 ;
            owl:someValuesFrom :OEO_00010322 ],
        :OEO_00000159 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/773
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/801

remove has energy input/output axioms
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2190
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2233""" .

:OEO_00000088 a owl:Class ;
    rdfs:label "coal"@en ;
    obo:IAO_0000115 "Coal is a portion of matter consisting of combustible black or brownish-black sedimentary rock, formed as rock strata called coal seams."@en ;
    obo:IAO_0000118 "Kohle"@de ;
    obo:IAO_0000119 "https://en.wikipedia.org/w/index.php?title=Coal&oldid=907331967" ;
    rdfs:comment "Coal is mostly carbon with variable amounts of other elements; chiefly hydrogen, sulphur, oxygen, and nitrogen. Coal is formed if dead plant matter decays into peat and over millions of years the heat and pressure of deep burial converts the peat into coal." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00000001 ],
