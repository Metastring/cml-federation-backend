:OEO_00240026 a owl:Class ;
    rdfs:label "manufactured material"@en ;
    obo:IAO_0000115 "A manufactured material is a portion of matter that is the physical output of a manufacturing process and that has a good role."@en ;
    obo:IAO_0000118 "industrial material"@en ;
