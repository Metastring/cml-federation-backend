obo:UO_0000218 a owl:Class ;
    rdfs:label "volt" ;
    obo:IAO_0000115 "\"An electric potential difference unit which is equal to the work per unit charge. One volt is the potential difference required to move one coulomb of charge between two points in a circuit while using one joule of energy.\" [Wikipedia:Wikipedia]" ;
    oboInOwl:hasExactSynonym "V" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000218 .

obo:UO_0000223 a owl:Class ;
    rdfs:label "watt-hour" ;
    obo:IAO_0000115 "\"An energy unit which is equal to the amount of electrical energy equivalent to a one-watt load drawing power for one hour.\" [Wikipedia:Wikipedia]" ;
    oboInOwl:hasExactSynonym "Wh" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000223 .

obo:UO_1000008 a owl:Class ;
