:OEO_00020406 a owl:Class ;
    rdfs:label "model coupling" ;
    obo:IAO_0000115 "Model coupling is a model calculation in which output data from one or more numerical computer models is used as input data for one or more other models." ;
    rdfs:subClassOf :OEO_00000275 ;
    :OEO_00020425 "study descriptor" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1521
