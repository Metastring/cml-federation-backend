:OEO_00020172 a owl:Class ;
    rdfs:label "property cost"@en ;
    obo:IAO_0000115 "A property cost is an investment cost arising from the acquisition of a property." ;
    obo:IAO_0000118 "land cost" ;
    rdfs:subClassOf :OEO_00020167 ;
