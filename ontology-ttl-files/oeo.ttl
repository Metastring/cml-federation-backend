:OEO_00360043 a owl:NamedIndividual,
        :OEO_00000422 ;
    rdfs:label "BSI-KritisV transport sector"@en ;
    obo:IAO_0000115 "The BSI-KritisV transport sector is a transport sector defined by the BSI-KritisV sector division (§ 8 BSI-KritisV)."@en ;
