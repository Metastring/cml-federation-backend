:OEO_00000008 a owl:Class ;
    rdfs:label "coal power unit"@en ;
    obo:IAO_0000115 "A coal power unit is a power generating unit using coal as fuel." ;
    obo:IAO_0000118 "Kohlekraftwerksblock"@de ;
    rdfs:subClassOf _:Na70e30dd319346b5bfae95589024486a,
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00000396 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00000503 ;
            owl:someValuesFrom :OEO_00000088 ],
        :OEO_00000334 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/750
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/752""" .

:OEO_00000028 a owl:Class ;
    rdfs:label "nuclear energy carrier disposition"@en ;
    obo:IAO_0000115 "A nuclear energy carrier is an energy carrier used in nuclear power stations to produce heat for steam turbines. Heat is created when the nuclear fuel undergoes nuclear fission." ;
    rdfs:subClassOf :OEO_00000151 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/182
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/237""" .

:OEO_00000144 a owl:Class ;
    rdfs:label "electricity grid component"@en ;
    obo:IAO_0000115 "An electricity grid component is a grid component that is part of an electricity grid."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00010231 ;
            owl:someValuesFrom :OEO_00410068 ],
        :OEO_00020006 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00020006 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000050 ;
                        owl:someValuesFrom :OEO_00000143 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/36
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/385

Move to oeo-shared:
https://github.com/OpenEnergyPlatform/ontology/pull/1360

rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652

added 'is subject of' some 'rated voltage' subclass axiom
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2108""" .

:OEO_00000162 a owl:Class ;
    rdfs:label "factsheet"@en ;
    obo:IAO_0000115 "A factsheet is a document that collects information about a specific topic in a structured way." ;
    rdfs:comment "this entity is general and not specific to the OEP factsheets." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020188 ;
            owl:someValuesFrom :OEO_00010412 ],
        obo:IAO_0000310 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/250
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/271

Add 'has licence' axiom:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1275
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1547""" .

:OEO_00000198 a owl:Class ;
    rdfs:label "greenhouse effect disposition"@en ;
    obo:IAO_0000115 "The greenhouse effect disposition is the disposition of a gas to contribute to the greenhouse effect, when it is emitted into the atmosphere." ;
    obo:IAO_0006011 "http://purl.obolibrary.org/obo/CHEBI_76413" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000054 ;
            owl:someValuesFrom :OEO_00000199 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( :OEO_00000331 [ a owl:Restriction ;
                                owl:hasValue :OEO_00000182 ;
                                owl:onProperty :OEO_00000531 ] ) ] ],
        obo:BFO_0000016 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/56
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/234

add 'has bearer' axiom
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1305
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1310

Add 'realized in' axiom:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1320
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1353

move to oeo-shared:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1384
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1390

rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00000218 a owl:Class ;
    rdfs:label "hydro energy"@en ;
    obo:IAO_0000115 "Hydro energy is kinetic energy of moving liquid water which can result directly from its potential energy."@en ;
    obo:IAO_0000118 "Wasserkraft"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00000441 ],
