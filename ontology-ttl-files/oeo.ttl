move domain and range to oeo-shared-axioms
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2119
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2195""" .

:OEO_00390094 a owl:DatatypeProperty ;
    rdfs:label "has iri"@en ;
    obo:IAO_0000115 "has iri is a relation between a data item or document and the IRI that identifies it as rescource on the internet." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:IAO_0000027 obo:IAO_0000310 ) ] ;
    rdfs:range rdfs:Literal ;
    :OEO_00020426 """add
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2013
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2020""" .

:OEO_00390095 a owl:DatatypeProperty ;
    rdfs:label "has uuid"@en ;
    obo:IAO_0000115 "has uuid is the relation between a factsheet or report and the 128-bit label used to identify it in a computer system." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:IAO_0000088 :OEO_00000162 ) ] ;
    rdfs:range xsd:string ;
    :OEO_00020426 """add
