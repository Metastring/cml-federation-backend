:OEO_00010069 a owl:NamedIndividual,
        :OEO_00010035 ;
    rdfs:label "KSG sector agriculture"@en ;
    obo:BFO_0000051 :OEO_00010047,
        :OEO_00010054 ;
    obo:IAO_0000115 """The KSG sector agriculture is an agriculture, forestry and land use sector defined by the KSG sector division. It is an aggregate of the following two sectors:
- CRF sector (IPCC 2006): agriculture, forestry and fishing (CRF 1.A.4.c)
- CRF sector (IPCC 2006): agriculture (CRF 3)""" ;
    obo:IAO_0000118 "KSG-Sektor Landwirtschaft"@de ;
    obo:IAO_0000119 "Bundes-Klimaschutzgesetz (KSG), Anlage 1 (zu den §§ 4 und 5) https://www.gesetze-im-internet.de/ksg/anlage_1.html" ;
