:OEO_00020312 a owl:Class ;
    rdfs:label "with additional measures scenario"@en ;
    obo:IAO_0000115 "A with additional measures scenario (WAM) is a policy scenario that includes policy instruments and transformative measures which have been adopted and implemented to mitigate climate change or meet energy objectives, as well as policy instruments and transformative measures which are planned for that purpose." ;
    obo:IAO_0000118 "WAM scenario" ;
    obo:IAO_0000119 "Derived from https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32018R1999&from=EN#d1e968-1-1 Article 2" ;
    rdfs:subClassOf :OEO_00020309 ;
