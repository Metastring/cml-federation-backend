    obo:IAO_0000118 "Emission"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00000500 ;
            owl:someValuesFrom :OEO_00000148 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/56
