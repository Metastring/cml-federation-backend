rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652""" .

:OEO_00140013 a owl:Class ;
    rdfs:label "gross domestic product"@en ;
    obo:IAO_0000115 "A gross domestic product is a quantity value that represents the broadest measure of aggregate economic activity, measuring the total unduplicated market value of all final goods and services produced within a statistical area in a period." ;
    obo:IAO_0000118 "BIP"@de,
        "Bruttoinlandsprodukt"@de,
        "GDP"@en ;
    rdfs:comment "has unit some currency per time unit" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00040010 ;
            owl:someValuesFrom :OEO_00040004 ],
        :OEO_00000350 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/454
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/559
alternative term:
https://github.com/OpenEnergyPlatform/ontology/issues/675
https://github.com/OpenEnergyPlatform/ontology/pull/676
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1487
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1623
make subclass of quantity value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1917
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1931""" .

:OEO_00140017 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    obo:IAO_0000115 "A relation between a person and an organisation where the person is a member of the organisation." ;
    rdfs:domain :OEO_00000323 ;
    rdfs:range :OEO_00030022 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/486
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/562""",
        """issue: https://github.com/OpenEnergyPlatform/ontology/issues/486
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/562
move to oeo-sector 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1399
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1724""" .

:OEO_00140018 a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    obo:IAO_0000115 "A relation between an organisation and a person where the person is a member of the organisation." ;
    rdfs:domain :OEO_00030022 ;
    rdfs:range :OEO_00000323 ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/486
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/562""" .

:OEO_00140023 a owl:Class ;
    rdfs:label "gross value added"@en ;
    obo:IAO_0000115 "Gross value added is a quantity value that is the value of goods and services produced in a sector of an economy, measuring that sector's contribution to gross domestic product (GDP). It is calculated as the monetary value of products and services produced, less the value of intermediate consumption." ;
    obo:IAO_0000118 "Bruttowertschöpfung"@de,
        "GVA"@en ;
    rdfs:subClassOf :OEO_00000350 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/455
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/563
alternative term:
https://github.com/OpenEnergyPlatform/ontology/issues/675
https://github.com/OpenEnergyPlatform/ontology/pull/676
make subclass of quantity value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1917
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1931""" .

:OEO_00140025 a owl:Class ;
    rdfs:label "cross-checking against other models"@en ;
    obo:IAO_0000115 "Cross-checking against other models is a validation where a model gets cross-checked against other models of the domain." ;
    rdfs:subClassOf :OEO_00140024 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/487
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/565""" .

:OEO_00140026 a owl:Class ;
    rdfs:label "checking against measurements"@en ;
    obo:IAO_0000115 "Checking against measurements is a validation where something gets checked by using relevant measurements." ;
    obo:IAO_0000118 "Abgleich mit Messwerten"@de ;
    rdfs:subClassOf :OEO_00140024 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/487
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/565""" .

:OEO_00140027 a owl:Class ;
    rdfs:label "checking against empirical data"@en ;
    obo:IAO_0000115 "Checking against empirical data is a validation where something gets checked against empirical data." ;
    obo:IAO_0000118 "Abgleich mit empirischen Daten"@de ;
    rdfs:subClassOf :OEO_00140024 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/487
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/565""" .

:OEO_00140035 a owl:Class ;
    rdfs:label "oxidation"@en ;
    obo:IAO_0000115 "Oxidation is a chemical reaction that describes the loss of electrons of an atom, an ion, or of certain atoms in a molecule and is a part of a redox reaction." ;
    obo:IAO_0000118 "Oxidation"@de ;
    rdfs:subClassOf :OEO_00140033 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/449
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/568""" .

:OEO_00140036 a owl:Class ;
    rdfs:label "reduction"@en ;
    obo:IAO_0000115 "Reduction is a chemical reaction that describes the gain of electrons of an atom, an ion, or of certain atoms in a molecule and is a part of a redox reaction." ;
    obo:IAO_0000118 "Reduktion"@de ;
    rdfs:subClassOf :OEO_00140033 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/449
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/568""" .

:OEO_00140045 a owl:NamedIndividual,
        :OEO_00140044 ;
    rdfs:label "start alignment"@en ;
    obo:IAO_0000115 "A start alignment is a time stamp alignment indicating that the time stamp marks the start of the time step." ;
    obo:IAO_0000118 "left alignment" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/267
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/570""" .

:OEO_00140046 a owl:NamedIndividual,
        :OEO_00140044 ;
    rdfs:label "middle alignment"@en ;
    obo:IAO_0000115 "A middle alignment is a time stamp alignment indicating that the time stamp marks the middle of the time step." ;
    obo:IAO_0000118 "center alignment",
        "centre alignment" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/267
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/570""" .

:OEO_00140047 a owl:NamedIndividual,
        :OEO_00140044 ;
    rdfs:label "end alignment"@en ;
    obo:IAO_0000115 "An end alignment is a time stamp alignment indicating that the time stamp marks the end of the time step." ;
    obo:IAO_0000118 "right alignment" ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/267
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/570""" .

:OEO_00140057 a owl:Class ;
    rdfs:label "theoretical flow potential"@en ;
    obo:IAO_0000115 "A theoretical flow potential is a type of flow potential that identifies the physical upper limit of an input or output of a process in a spatial region of reference per unit time." ;
    rdfs:subClassOf :OEO_00140056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140058 a owl:Class ;
    rdfs:label "technological flow potential"@en ;
    obo:IAO_0000115 "A technological flow potential is a type of a flow potential derived from a theoretical flow potential, taking account of the annual efficiency of the respective conversion technology and the additional restrictions regarding the area that is realistically available for energy generation." ;
    rdfs:subClassOf :OEO_00140056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140059 a owl:Class ;
    rdfs:label "economic flow potential"@en ;
    obo:IAO_0000115 "An economic flow potential is a type of flow potential that identifies the proportion of the technological potential that can be utilised economically (based on economic boundary conditions)." ;
    rdfs:subClassOf :OEO_00140056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140060 a owl:Class ;
    rdfs:label "developable flow potential"@en ;
    obo:IAO_0000115 "A developable flow potential is a type of flow potential that describes the fraction of the economic potential that can be developed under realistic conditions (regulations, environmental and social restrictions)." ;
    rdfs:subClassOf :OEO_00140056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140061 a owl:Class ;
    rdfs:label "sustainable flow potential"@en ;
    obo:IAO_0000115 "A sustainable flow potential is a type of flow potential that takes into account all aspects of sustainability, which usually requires careful consideration and evaluation of different ecological and socio-economic aspects. The differentiation of the sustainable potential is blurred, since ecological aspects may already have been considered for the technological or economic potential, depending on the author." ;
    rdfs:subClassOf :OEO_00140056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140063 a owl:Class ;
    rdfs:label "theoretical stock potential"@en ;
    obo:IAO_0000115 "A theoretical stock potential is a type of stock potential that identifies the physical upper limit of a stock of a source or sink in a spatial region of reference." ;
    rdfs:subClassOf :OEO_00140062 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140064 a owl:Class ;
    rdfs:label "technological stock potential"@en ;
    obo:IAO_0000115 "A technological stock potential is a type of a stock potential derived from a theoretical stock potential, taking account of the annual efficiency of the respective conversion technology and the additional restrictions regarding the area that is realistically available for energy generation." ;
    rdfs:subClassOf :OEO_00140062 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140065 a owl:Class ;
    rdfs:label "economic stock potential"@en ;
    obo:IAO_0000115 "An economic stock potential is a type of stock potential that identifies the proportion of the technological potential that can be utilised economically (based on economic boundary conditions)." ;
    rdfs:subClassOf :OEO_00140062 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140066 a owl:Class ;
    rdfs:label "developable stock potential"@en ;
    obo:IAO_0000115 "A developable stock potential is a type of stock potential that describes the fraction of the economic potential that can be developed under realistic conditions (regulations, environmental and social restrictions)." ;
    rdfs:subClassOf :OEO_00140062 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140067 a owl:Class ;
    rdfs:label "sustainable stock potential"@en ;
    obo:IAO_0000115 "A sustainable stock potential is a type of stock potential that takes into account all aspects of sustainability, which usually requires careful consideration and evaluation of different ecological and socio-economic aspects. The differentiation of the sustainable potential is blurred, since ecological aspects may already have been considered for the technological or economic potential, depending on the author." ;
    rdfs:subClassOf :OEO_00140062 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/481
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/607""" .

:OEO_00140069 a owl:NamedIndividual,
        :OEO_00140068 ;
    rdfs:label "instantaneous"@en ;
    obo:IAO_0000115 "value measured at or modelled for exactly one 0-dim temporal region, referenced by a time stamp, e.g. to represent a time step in a time series" ;
    obo:IAO_0000118 "instantan"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/571
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/610""" .

:OEO_00140070 a owl:NamedIndividual,
        :OEO_00140068 ;
    rdfs:label "integral"@en ;
    obo:IAO_0000115 "sum or integral of values, e.g. within a time step or a spatial region" ;
    obo:IAO_0000118 "Integral"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/571
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/610""" .

:OEO_00140071 a owl:NamedIndividual,
        :OEO_00140068 ;
    rdfs:label "arithmetic mean"@en ;
    obo:IAO_0000115 "average value calculated by arithmetic mean over a set of data values, e.g. within a time step or spatial region" ;
    obo:IAO_0000118 "arithmetisches Mittel"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/571
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/610""" .

:OEO_00140072 a owl:NamedIndividual,
        :OEO_00140068 ;
    rdfs:label "minimum"@en ;
    obo:IAO_0000115 "minimum value within a set of data values, e.g. in a time step or spatial region" ;
    rdfs:comment "Minimum"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/571
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/610""" .

:OEO_00140073 a owl:NamedIndividual,
        :OEO_00140068 ;
    rdfs:label "maximum"@en ;
    obo:IAO_0000115 "maximum value within a set of data values, e.g. in a time step or spatial region" ;
    obo:IAO_0000118 "Maximum"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/571
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/610""" .

:OEO_00140083 a owl:Class ;
    rdfs:label "carbon dioxide equivalent quantity value"@en ;
    obo:IAO_0000115 "A carbon dioxide equivalent quantity is a greenhouse gas emission value that quantifies the combined effect of all emitted greenhouse gases by giving an equivalent amount of CO2 which would have the same effect on the climate." ;
    obo:IAO_0000118 "CO2-Äquivalent"@de,
        "Kohlendioxid-Äquivalent"@de,
        "CO2 equivalent quantity"@en ;
    rdfs:subClassOf :OEO_00010079 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/420
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/651

restructuring emission rate and emission value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1759
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1846""" .

:OEO_00140091 a owl:Class ;
    rdfs:label "plutonium"@en ;
    obo:IAO_0000115 "Plutonium is a portion of matter with the chemical formula Pu. It has a solid normal state of matter." ;
    obo:IAO_0000118 "Plutonium"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00000028 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00000001 ],
        [ a owl:Restriction ;
            owl:hasValue :OEO_00000390 ;
            owl:onProperty :OEO_00000529 ],
        :OEO_00000331 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/694
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/708""" .

:OEO_00140092 a owl:Class ;
    rdfs:label "thorium"@en ;
    obo:IAO_0000115 "Thorium is a portion of matter with the chemical formula Th. It has a solid normal state of matter." ;
    obo:IAO_0000118 "Thorium"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00000001 ],
        [ a owl:Restriction ;
            owl:hasValue :OEO_00000390 ;
            owl:onProperty :OEO_00000529 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000091 ;
            owl:someValuesFrom :OEO_00000028 ],
        :OEO_00000331 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/694
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/708""" .

:OEO_00140095 a owl:ObjectProperty ;
    rdfs:label "has typical computation time"@en ;
    obo:IAO_0000115 "A relation between an algorithm or a software and the typical duration of its execution." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:IAO_0000010 obo:IAO_0000064 ) ] ;
    rdfs:range :OEO_00030035 ;
    rdfs:subPropertyOf :OEO_00140002 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/527
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/723""" .

:OEO_00140098 a owl:Class ;
    rdfs:label "quality control flag"@en ;
    obo:IAO_0000115 "A quality control flag is a data descriptor that describes the measurement quality of a data set, e.g. a time series." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom obo:IAO_0000100 ],
        :OEO_00000119 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/612
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/724""" .

:OEO_00140099 a owl:Class ;
    rdfs:label "goal description"@en ;
    obo:IAO_0000115 "A goal description is an objective specification that contains statements about a desired future state of a system that a person or organisation envisions or plans, or to which it commits." ;
    obo:IAO_0000118 "Zielbeschreibung"@de ;
    rdfs:subClassOf obo:IAO_0000005 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/28
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/729

Changed direct parent class from 'information content entity' to 'objective specification'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2097
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2102""" .

:OEO_00140105 a owl:Class ;
    rdfs:label "artificial ambient thermal energy"@en ;
    obo:IAO_0000115 "Artificial ambient thermal energy is ambient thermal energy that has an anthropogenic origin." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00000530 ;
            owl:someValuesFrom :OEO_00030000 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00000530 ;
            owl:someValuesFrom :OEO_00020147 ],
        :OEO_00000056 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/728
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/742""" .

:OEO_00140106 a owl:Class ;
    rdfs:label "ambient thermal energy transfer"@en ;
    obo:IAO_0000115 "Ambient thermal energy transfer is a heat transfer from the ambient air to a transportable material entity." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020462 ;
            owl:someValuesFrom :OEO_00000056 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom obo:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00020461 ;
            owl:someValuesFrom :OEO_00000207 ],
        :OEO_00140101 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/728
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/742

change 'has physical input / output' axioms to 'has energy input / output':
https://github.com/OpenEnergyPlatform/ontology/issues/994
https://github.com/OpenEnergyPlatform/ontology/pull/1041

change axioms to energy and remove has energy input/output:
https://github.com/OpenEnergyPlatform/ontology/issues/2190
https://github.com/OpenEnergyPlatform/ontology/pull/2233""" .

:OEO_00140117 a owl:Class ;
    rdfs:label "delivery time"@en ;
    obo:IAO_0000115 "Delivery time is a one-dimensional temporal region expressing the amount of time that it takes for goods that have been bought to arrive at the place where they are wanted." ;
    obo:IAO_0000118 "Lieferzeit"@de ;
    rdfs:subClassOf obo:BFO_0000038 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140118 a owl:Class ;
    rdfs:label "delivery time point"@en ;
    obo:IAO_0000115 "A delivery time point is a zero-dimensional temporal region expressing the point in time when goods that have been bought arrive at the place where they are wanted." ;
    obo:IAO_0000118 "Lieferzeitpunkt"@de ;
    rdfs:subClassOf obo:BFO_0000148 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140119 a owl:Class ;
    rdfs:label "sender"@en ;
    obo:IAO_0000115 "A sender is an agent who initiates a communication." ;
    obo:IAO_0000118 "Sender"@de ;
    rdfs:subClassOf :OEO_00000051 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140120 a owl:Class ;
    rdfs:label "receiver"@en ;
    obo:IAO_0000115 "A receiver is an agent who obtains information from a sender." ;
    obo:IAO_0000118 "Empfänger"@de,
        "Empfängerin"@de ;
    rdfs:subClassOf :OEO_00000051 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140121 a owl:Class ;
    rdfs:label "bid"@en ;
    obo:IAO_0000115 "A bid is a document describing an offer made by an agent to another agent in an effort to exchange commodities or services via terms relating to price and quantity which will be part of the resulting contract." ;
    obo:IAO_0000118 "Gebot"@de ;
    rdfs:subClassOf obo:IAO_0000310 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140122 a owl:Class ;
    rdfs:label "award"@en ;
    obo:IAO_0000115 "An award is a document that signifies that a supplier for a particular commodity or service specified in a bid has been accepted." ;
    obo:IAO_0000118 "Zuschlag"@de ;
    rdfs:subClassOf obo:IAO_0000310 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140123 a owl:Class ;
    rdfs:label "provider"@en ;
    obo:IAO_0000115 "A provider is an agent that transfers commodities or services to other agents." ;
    obo:IAO_0000119 "https://spec.edmcouncil.org/fibo/ontology/FND/ProductsAndServices/ProductsAndServices/ServiceProvider (adapted)" ;
    rdfs:comment "The transfer is typically defined in a contract." ;
    rdfs:subClassOf :OEO_00000051 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/778""" .

:OEO_00140125 a owl:Class ;
    rdfs:label "delivery interval"@en ;
    obo:IAO_0000115 "A delivery interval is the duration between repeated deliveries of services or commodities." ;
    obo:IAO_0000118 "Lieferintervall"@de ;
    rdfs:comment "This duration is often contractually fixed and regular." ;
    rdfs:subClassOf :OEO_00030035 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779""" .

:OEO_00140126 a owl:Class ;
    rdfs:label "planned availability"@en ;
    obo:IAO_0000115 "Planned availability is a quality that describes the amount of time a power plant is planned to be operational per year." ;
    obo:IAO_0000118 "geplante Verfügbarkeit"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00000031 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00140002 ;
            owl:someValuesFrom :OEO_00140127 ],
        obo:BFO_0000019 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779

add 'has bearer' axiom
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1305
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1310

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00140128 a owl:Class ;
    rdfs:label "block size"@en ;
    obo:IAO_0000115 "Block size is the declared net capacity of a power generating unit." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020056 ;
            owl:someValuesFrom :OEO_00000334 ],
        :OEO_00230002 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779""" .

:OEO_00140129 a owl:Class ;
    rdfs:label "unplanned availability"@en ;
    obo:IAO_0000115 "Unplanned availability is a quality that describes the amount of time a power plant is planned to be operational per year, but is not operation." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00140002 ;
            owl:someValuesFrom :OEO_00140127 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000052 ;
            owl:someValuesFrom :OEO_00000031 ],
        obo:BFO_0000019 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779

add 'has bearer' axiom
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1305
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1310

replaced 'has bearer' with 'characteristic of'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1907
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1928""" .

:OEO_00140130 a owl:Class ;
    rdfs:label "power plant operator"@en ;
    obo:IAO_0000115 "A power plant operator is an agent that operates an electric utility generation station." ;
    obo:IAO_0000118 "Kraftwerksbetreiber"@de,
        "Kraftwerksbetreiberin"@de ;
    rdfs:subClassOf :OEO_00000051 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779""" .

:OEO_00140131 a owl:Class ;
    rdfs:label "conventional trader"@en ;
    obo:IAO_0000115 "A trader that trades the power of fossil fuel power plants." ;
    rdfs:subClassOf :OEO_00040005 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/779""" .

:OEO_00140134 a owl:Class ;
    rdfs:label "hydrogen fuel cell"@en ;
    obo:IAO_0000115 "A hydrogen fuel cell is a fuel cell that uses hydrogen." ;
    obo:IAO_0000118 "Wasserstoffbrennstoffzelle"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00000503 ;
            owl:someValuesFrom :OEO_00000220 ],
        :OEO_00000016 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/761
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/782""" .

:OEO_00140135 a owl:Class ;
    rdfs:label "natural gas turbine"@en ;
    obo:IAO_0000115 "A natural gas turbine is a gas turbine fueled with natural gas." ;
    obo:IAO_0000118 "Erdgasturbine"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00000503 ;
            owl:someValuesFrom :OEO_00000292 ],
        :OEO_00000185 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/761
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/782""" .

:OEO_00140136 a owl:Class ;
    rdfs:label "dispatch assignment"@en ;
    obo:IAO_0000115 "Dispatch assignment is a plan specification that refers to resource planning at a power plant (usually by the plant’s operator)." ;
    rdfs:subClassOf obo:IAO_0000104 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/792""" .

:OEO_00140137 a owl:Class ;
    rdfs:label "power plant portfolio"@en ;
    obo:IAO_0000115 "A power plant portfolio is an information content entity that describes a particular combination or mix of different power plants, e.g. renewables and fossil plants within one business unit or company or trader." ;
    rdfs:subClassOf obo:IAO_0000030 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/376
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/792""" .

:OEO_00140139 a owl:Class ;
    rdfs:label "yield profile"@en ;
    obo:IAO_0000115 "A yield profile is a generation time series of a particular renewable power plant." ;
    obo:IAO_0000118 "Ertragsprofil"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:IAO_0000136 ;
            owl:someValuesFrom :OEO_00010362 ],
        :OEO_00140138 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/793

Add 'is about' axiom:
issue:https://github.com/OpenEnergyPlatform/ontology/issues/1423
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1437

move axiom to shared-axioms
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1703
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1706""" .

:OEO_00140140 a owl:Class ;
    rdfs:label "demand trader"@en ;
    obo:IAO_0000115 "A demand trader is a trader that deals specifically with energy demand." ;
    rdfs:subClassOf :OEO_00040005 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/793""" .

:OEO_00140141 a owl:Class ;
    rdfs:label "merit order"@en ;
    obo:IAO_0000115 "A merit order is a plan specification that describes the dispatch ranking of power plants (electrical generation) based on ascending order of price." ;
    obo:IAO_0000118 "Merit-Order"@de,
        "geordnete Grenzkostenkurve"@de ;
    rdfs:subClassOf obo:IAO_0000104 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/793""" .

:OEO_00140143 a owl:Class ;
    rdfs:label "direct marketer"@en ;
    obo:IAO_0000115 "A direct marketer is a trader who is the relay between the energy exchange and power plant operators." ;
    obo:IAO_0000118 "Direktvermarkter"@de ;
    rdfs:subClassOf :OEO_00040005 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/793""" .

:OEO_00140144 a owl:Class ;
    rdfs:label "full load hours"@en ;
    obo:IAO_0000115 "Full load hours are a quantity value that describes the utilization of a technical device. The value of the full load hours is obtained by dividing the annual amount of energy generated by the declared net capacity of the plant." ;
    obo:IAO_0000118 "Volllaststunden"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00040010 ;
            owl:someValuesFrom obo:UO_0000032 ],
        :OEO_00000350 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/256
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/793""" .

:OEO_00140161 a owl:Class ;
    rdfs:label "cooperative programming"@en ;
    obo:IAO_0000115 "Cooperative programming is the process of two or more people working on program code together at the same time (according to a specified routine)." ;
    obo:IAO_0000118 "collaborative programming" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
            owl:onClass :OEO_00000323 ;
            owl:onProperty obo:RO_0000057 ],
        obo:BFO_0000015 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/254
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/808

add 'has participant axiom':
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1327
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1395""" .

:OEO_00140162 a owl:Class ;
    rdfs:label "power plant with electro motive generator"@en ;
    obo:IAO_0000115 "A power plant with electromotive generator is a power plant that has an electro motive generator." ;
    rdfs:subClassOf :OEO_00000031 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00000031 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000051 ;
                        owl:someValuesFrom :OEO_00000010 ] ) ] ;
    skos:closeMatch obo:ENVO_00002214 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/636
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/810

Convert to skos:closeMatch
issue: https://github.com/OpenEnergyPlatform/ontology/issues/636
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1879""" .

:OEO_00140168 a owl:NamedIndividual,
        :OEO_00140167 ;
    rdfs:label "stochastic"@en ;
    obo:IAO_0000118 "stochastisch"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/183
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/824""" .

:OEO_00140169 a owl:NamedIndividual,
        :OEO_00140167 ;
    rdfs:label "deterministic"@en ;
    obo:IAO_0000118 "deterministisch"@de ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/183
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/824""" .

:OEO_00140170 a owl:DatatypeProperty ;
    rdfs:label "has documentation quality"@en ;
    obo:IAO_0000115 "Has documentation quality is the relation between a model and a statement about how well it is documented." ;
    rdfs:domain :OEO_00000274 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/526
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/825
make data property
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1802
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1834""" .

:OEO_00140171 a owl:Class ;
    rdfs:label "email address"@en ;
    obo:IAO_0000115 "An email address is an information content entity that identifies an email box to which messages are delivered." ;
    obo:IAO_0000118 "E-Mail-Adresse"@de ;
    rdfs:subClassOf obo:IAO_0000030 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/818
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/827""" .

:OEO_00140175 a owl:ObjectProperty ;
    rdfs:label "has gross output"@en ;
    obo:IAO_0000115 "p has gross output c iff: p has energy output c, and c is the total amount of energy generated during the process." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 :OEO_00000061 ) ] ;
    rdfs:range :OEO_00000150 ;
    rdfs:subPropertyOf :OEO_00010235 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/394
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/838

make subproperty of 'has energy output' and add domain:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/994
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1006""" .

:OEO_00140176 a owl:ObjectProperty ;
    rdfs:label "has net output"@en ;
    obo:IAO_0000115 "p has net output c iff: p has energy output c, and c is the amount of energy delivered to the consumer or fed into a supply grid." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( obo:BFO_0000015 :OEO_00000061 ) ] ;
    rdfs:range :OEO_00000150 ;
    rdfs:subPropertyOf :OEO_00010235 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/394
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/838

make subproperty of 'has energy output' and add domain:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/994
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1006""" .

:OEO_00160002 a owl:Class ;
    rdfs:label "primary control"@en ;
    obo:IAO_0000115 "A primary control is a frequency control that is decentralised and automated. It reacts within seconds to frequency deviations caused by electricity supply and demand imbalances." ;
    obo:IAO_0000118 "Primärregelung"@de ;
    rdfs:subClassOf :OEO_00160001 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202""" .

:OEO_00160003 a owl:Class ;
    rdfs:label "secondary control"@en ;
    obo:IAO_0000115 "A secondary control is a frequency control that is centralised and automated. It refers to the control area of one transmission system operator. Secondary control succeeds primary control and operates for several minutes." ;
    obo:IAO_0000118 "Sekundärregelung"@de ;
    rdfs:subClassOf :OEO_00160001 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202""" .

:OEO_00160004 a owl:Class ;
    rdfs:label "tertiary control"@en ;
    obo:IAO_0000115 "A tertiary control is a frequency control that is either automated or manual. It takes over from secondary control to equalise electricity supply and demand imbalances that last for more than 15 minutes." ;
    obo:IAO_0000118 "Minutenreserve"@de,
        "Tertiärregelung"@de ;
    rdfs:subClassOf :OEO_00160001 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1107
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1202""" .

:OEO_00160005 a owl:Class ;
    rdfs:label "fuel cost"@en ;
    obo:IAO_0000115 "A fuel cost is a variable cost that depends on the type and amount of fuel." ;
    obo:IAO_0000118 "Brennstoffkosten"@de,
        "Kraftstoffkosten"@de ;
    rdfs:subClassOf :OEO_00020145 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1257
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1260

make subclass of process attribute
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1914
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1999""" .

:OEO_00160006 a owl:Class ;
    rdfs:label "market share"@en ;
    obo:IAO_0000115 "A market share is a quality of a market exchange which quantifies the proportion a good to the total amount of goods traded in that market exchange." ;
    rdfs:subClassOf obo:BFO_0000019 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1636
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1779""" .

:OEO_00160007 a owl:Class ;
    rdfs:label "market share value"@en ;
    obo:IAO_0000115 "A market share value is a fraction value that quantifies a market share." ;
    rdfs:subClassOf :OEO_00140127 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1636
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1779

make subclass of fraction value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1875
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1878""" .

:OEO_00230003 a owl:Class ;
    rdfs:label "nameplate capacity"@en ;
    obo:IAO_0000115 "Nameplate capacity is the power capacity stating the maximum power an artificial object, e.g. a power generating unit or a power plant, can generate, and the sum of the power ratings of all energy converting component of that power plant." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00020056 ;
            owl:someValuesFrom :OEO_00000061 ],
        :OEO_00010257 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/320
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/391
extend to artificial objects:
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/933
Make it subclass of power value and add unit axiom:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/918
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/935

use energy converting component in definition:
https://github.com/OpenEnergyPlatform/ontology/pull/993

Make subclass of 'power capacity':
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1092
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1155""" .

:OEO_00230014 a owl:Class ;
    rdfs:label "urban population"@en ;
    obo:IAO_0000115 "An urban population is a population living in urban areas, as defined by national statistical offices."@en ;
    obo:IAO_0000118 "Städtische Bevölkerung"@de ;
    obo:IAO_0000119 "United Nations Population Division. World Urbanization Prospects: 2018 Revision."@en ;
    rdfs:subClassOf :OEO_00230013 ;
    owl:disjointWith :OEO_00230015 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/479
https://github.com/OpenEnergyPlatform/ontology/issues/301
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/491"""@en .

:OEO_00230016 a owl:Class ;
    rdfs:label "labour force"@en ;
    obo:IAO_0000115 "The labour force is the population of people ages 15 and older who supply labour to the production of goods and services.  It includes people who are currently employed and people who are unemployed but seeking work as well as first-time job-seekers."@en ;
    obo:IAO_0000118 "Arbeiterschaft"@de,
        "Arbeitskräfte"@de,
        "labor force"@en ;
    obo:IAO_0000119 "https://databank.worldbank.org/reports.aspx?source=2&type=metadata&series=SL.TLF.TOTL.IN"@en ;
    rdfs:subClassOf :OEO_00230013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/479
https://github.com/OpenEnergyPlatform/ontology/issues/301
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/491"""@en .

:OEO_00230017 a owl:Class ;
    rdfs:label "working age population"@en ;
    obo:IAO_0000115 "The working age population is the population of people aged 15 to 65."@en ;
    obo:IAO_0000118 "Bevökerung im erwerbstätigen Alter"@de ;
    rdfs:subClassOf :OEO_00230013 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/301
https://github.com/OpenEnergyPlatform/ontology/issues/479
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/491"""@en .

:OEO_00240011 a owl:Class ;
    rdfs:label "combined heat and power plant"@en ;
    obo:IAO_0000115 "A combined heat and power plant (CHPP) is an energy transformation unit that consists of combined heat and power generating units, a grid component feeding electric energy into an electricity grid, and a grid component feeding thermal energy into a heating grid." ;
    obo:IAO_0000118 "CHPP" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000056 ;
            owl:someValuesFrom :OEO_00240009 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00000144 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00240010 ],
        [ a owl:Restriction ;
            owl:onProperty obo:BFO_0000051 ;
            owl:someValuesFrom :OEO_00020008 ],
        :OEO_00020102 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/915
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/923

change as a subclass of energy transformation unit:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1254
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1360""" .

:OEO_00240015 a owl:Class ;
    rdfs:label "liquid air production"@en ;
    obo:IAO_0000115 "Liquid air production is a production that produces liquid air by cooling and compressing (gaseous) air."@en ;
    obo:IAO_0000118 "Luftverflüssigung"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00000533 ;
            owl:someValuesFrom :OEO_00000257 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00000532 ;
            owl:someValuesFrom :OEO_00000054 ],
        :OEO_00240003 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/937
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/945""" .

:OEO_00240016 a owl:Class ;
    rdfs:label "net capacity factor"@en ;
    obo:IAO_0000115 "A net capacity factor is a utilisation value that is calculated by dividing the net electricity generation over a given time step by the declared net capacity times the length of this time step."@en ;
    obo:IAO_0000116 "A net capacity factor is typically calculated for a year but other time steps (e.g. month or day) are possible."@en ;
    obo:IAO_0000118 "Nettojahresnutzungsgrad"@de,
        "Nettokapazitätsfaktor"@de,
        "CF"@en,
        "capacity factor"@en ;
    rdfs:subClassOf :OEO_00320072 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/890
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/946

make subclass of 'fraction value':
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1144
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1146

make subclass of 'utilisation value':
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1377
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1435

add alt label:
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1994
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1995""" .

:OEO_00240018 a owl:Class ;
    rdfs:label "gross national electricity consumption value"@en ;
    obo:IAO_0000115 "A gross national electricity consumption value is an energy consumption value measuring the consumption of electrical energy in a spatial region (e.g. a country), including gross electricity generation plus electricity imports, minus electricity exports. It is part of the gross inland energy consumption."@en ;
    obo:IAO_0000118 "gross national electricity consumption" ;
    rdfs:subClassOf :OEO_00240019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( :OEO_00240019 [ a owl:Restriction ;
                        owl:onProperty obo:BFO_0000050 ;
                        owl:someValuesFrom :OEO_00050017 ] ) ] ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/916
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/997"""@en ;
    :OEO_00110012 "GrossNationalElectricityConsumption = GrossElectricityGeneration + ElectricityImports - ElectricityExports" .

:OEO_00240021 a owl:Class ;
    rdfs:label "discount rate"@en ;
    obo:IAO_0000115 "A discount rate is an economic value with the unit percent that refers to the interest rate used in discounted cash flow (DCF) analysis to determine the present value of future cash flows."@en ;
    obo:IAO_0000118 "Diskontierungsrate"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00040010 ;
            owl:someValuesFrom obo:UO_0000187 ],
        :OEO_00140127 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1049
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1077

make subclass of fraction value
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1875
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1878"""@en .

:OEO_00240028 a owl:Class ;
    rdfs:label "paper"@en ;
    obo:IAO_0000115 "Paper is a portion of matter that is made from cellulose fibres and other plant materials. It is used for paper-based products. It has a solid normal state of matter. It is the physical output of an industrial process and has a commodity role."@en ;
    obo:IAO_0000118 "Papier"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue :OEO_00000390 ;
            owl:onProperty :OEO_00000529 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00240025 ;
            owl:someValuesFrom :OEO_00050000 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00040011 ],
        :OEO_00000331 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1053
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1082

rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652""" .

:OEO_00240031 a owl:Class ;
    rdfs:label "non-metallic mineral"@en ;
    obo:IAO_0000115 "A non-metallic mineral is a mineral that does not contain any metallic content within themselves. It is the physical output of an industrial process and has a commodity role."@en ;
    obo:IAO_0000116 "Some examples for non-metallic minerals are ceramic, glass, clay or gypsum."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00040011 ],
        [ a owl:Restriction ;
            owl:onProperty :OEO_00240025 ;
            owl:someValuesFrom :OEO_00050000 ],
        :OEO_00240030 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/1053
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1082

rework module structure 
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1592
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1652""" .

:OEO_00240035 a owl:Class ;
    rdfs:label "non-ferrous metal"@en ;
    obo:IAO_0000115 "A non-ferrous metal is a metal that does not contain a significant amount of iron in its chemical composition. It is the physical output of an industrial process and has a commodity role."@en ;
    obo:IAO_0000118 "Nichteisenmetall"@de ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00240025 ;
            owl:someValuesFrom :OEO_00050000 ],
        [ a owl:Restriction ;
            owl:onProperty obo:RO_0000087 ;
            owl:someValuesFrom :OEO_00040011 ],
        :OEO_00240032 ;
