www:ont00001857 a owl:ObjectProperty ;
    rdfs:label "is part of process"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subPropertyOf obo:BFO_0000132 ;
    skos:definition "x is_part_of_process y iff x and y are instances of Process, such that x occurs during the temporal interval of y, and x either provides an input to y or receives an output of y."@en ;
    :OEO_00020426 """issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016""" ;
    www:ont00001760 "https://www.commoncoreontologies.org/ExtendedRelationOntology"^^xsd:anyURI .

www:ont00001873 a owl:ObjectProperty ;
    rdfs:label "represented by"@en ;
    rdfs:comment "See notes for inverse property." ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subPropertyOf :OEO_00010231 ;
    owl:inverseOf www:ont00001938 ;
    skos:definition "y represented_by x iff x is an instance of Information Content Entity, and y is an instance of Entity, and z is carrier of x, such that x is about y in virtue of there existing an isomorphism between characteristics of z and y."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

www:ont00001920 a owl:ObjectProperty ;
    rdfs:label "prescribed by"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/cco-extracted.owl> ;
    rdfs:subPropertyOf :OEO_00010231 ;
    owl:inverseOf www:ont00001942 ;
    skos:definition "x prescribed_by y iff y is an instance of Information Content Entity and x is an instance of Entity, such that y serves as a rule or guide for x if x is an Occurrent, or y serves as a model for x if x is a Continuant."@en ;
    www:ont00001760 "https://www.commoncoreontologies.org/InformationEntityOntology"^^xsd:anyURI .

obo:BFO_0000009 a owl:Class ;
    rdfs:label "two-dimensional spatial region"@en ;
    obo:BFO_0000179 "2d-s-region" ;
    obo:BFO_0000180 "TwoDimensionalSpatialRegion" ;
    obo:IAO_0000112 "an infinitely thin plane in space."@en,
        "the surface of a sphere-shaped part of space"@en ;
    obo:IAO_0000600 "A two-dimensional spatial region is a spatial region that is of two dimensions. (axiom label in BFO2 Reference: [039-001])"@en ;
    obo:IAO_0000602 "(forall (x) (if (TwoDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [039-001] " ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :OEO_00140002 ;
            owl:someValuesFrom :OEO_00020143 ],
        obo:BFO_0000006 ;
    owl:disjointWith obo:BFO_0000028 ;
    :OEO_00020426 """move axiom to oeo-physical
issue: https://github.com/OpenEnergyPlatform/ontology/issues/1738
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/1776""" .

obo:BFO_0000028 a owl:Class ;
    rdfs:label "three-dimensional spatial region"@en ;
    obo:BFO_0000179 "3d-s-region" ;
    obo:BFO_0000180 "ThreeDimensionalSpatialRegion" ;
    obo:IAO_0000112 "a cube-shaped region of space"@en,
        "a sphere-shaped region of space,"@en ;
    obo:IAO_0000600 "A three-dimensional spatial region is a spatial region that is of three dimensions. (axiom label in BFO2 Reference: [040-001])"@en ;
    obo:IAO_0000602 "(forall (x) (if (ThreeDimensionalSpatialRegion x) (SpatialRegion x))) // axiom label in BFO2 CLIF: [040-001] " ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subClassOf obo:BFO_0000006 .

obo:BFO_0000030 a owl:Class ;
    rdfs:label "object"@en ;
    obo:BFO_0000179 "object" ;
    obo:BFO_0000180 "Object" ;
    obo:IAO_0000112 "atom"@en,
        "cell"@en,
        "cells and organisms"@en,
        "engineered artifacts"@en,
        "grain of sand"@en,
        "molecule"@en,
        "organelle"@en,
        "organism"@en,
        "planet"@en,
        "solid portions of matter"@en,
        "star"@en ;
    obo:IAO_0000116 "BFO 2 Reference: BFO rests on the presupposition that at multiple micro-, meso- and macroscopic scales reality exhibits certain stable, spatially separated or separable material units, combined or combinable into aggregates of various sorts (for example organisms into what are called ‘populations’). Such units play a central role in almost all domains of natural science from particle physics to cosmology. Many scientific laws govern the units in question, employing general terms (such as ‘molecule’ or ‘planet’) referring to the types and subtypes of units, and also to the types and subtypes of the processes through which such units develop and interact. The division of reality into such natural units is at the heart of biological science, as also is the fact that these units may form higher-level units (as cells form multicellular organisms) and that they may also form aggregates of units, for example as cells form portions of tissue and organs form families, herds, breeds, species, and so on. At the same time, the division of certain portions of reality into engineered units (manufactured artifacts) is the basis of modern industrial technology, which rests on the distributed mass production of engineered parts through division of labor and on their assembly into larger, compound units such as cars and laptops. The division of portions of reality into units is one starting point for the phenomenon of counting."@en,
        "BFO 2 Reference: Each object is such that there are entities of which we can assert unproblematically that they lie in its interior, and other entities of which we can assert unproblematically that they lie in its exterior. This may not be so for entities lying at or near the boundary between the interior and exterior. This means that two objects – for example the two cells depicted in Figure 3 – may be such that there are material entities crossing their boundaries which belong determinately to neither cell. Something similar obtains in certain cases of conjoined twins (see below)."@en,
        "BFO 2 Reference: To say that b is causally unified means: b is a material entity which is such that its material parts are tied together in such a way that, in environments typical for entities of the type in question,if c, a continuant part of b that is in the interior of b at t, is larger than a certain threshold size (which will be determined differently from case to case, depending on factors such as porosity of external cover) and is moved in space to be at t at a location on the exterior of the spatial region that had been occupied by b at t, then either b’s other parts will be moved in coordinated fashion or b will be damaged (be affected, for example, by breakage or tearing) in the interval between t and t.causal changes in one part of b can have consequences for other parts of b without the mediation of any entity that lies on the exterior of b. Material entities with no proper material parts would satisfy these conditions trivially. Candidate examples of types of causal unity for material entities of more complex sorts are as follows (this is not intended to be an exhaustive list):CU1: Causal unity via physical coveringHere the parts in the interior of the unified entity are combined together causally through a common membrane or other physical covering\\. The latter points outwards toward and may serve a protective function in relation to what lies on the exterior of the entity [13, 47"@en,
        "BFO 2 Reference: an object is a maximal causally unified material entity"@en,
        "BFO 2 Reference: ‘objects’ are sometimes referred to as ‘grains’ [74"@en ;
    obo:IAO_0000600 "b is an object means: b is a material entity which manifests causal unity of one or other of the types CUn listed above & is of a type (a material universal) instances of which are maximal relative to this criterion of causal unity. (axiom label in BFO2 Reference: [024-001])"@en ;
    rdfs:isDefinedBy obo:bfo.owl ;
    rdfs:subClassOf obo:BFO_0000040 .

obo:IAO_0000401 a owl:Class ;
    rdfs:label "one dimensional cartesian spatial coordinate datum"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A cartesion spatial coordinate datum that  uses one value to specify a position along a one dimensional spatial region"@en ;
    obo:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000400 .

obo:IAO_0000402 a owl:Class ;
    rdfs:label "two dimensional cartesian spatial coordinate datum"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A cartesion spatial coordinate datum that  uses two values to specify a position within a two dimensional spatial region"@en ;
    obo:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000400 .

obo:IAO_0000403 a owl:Class ;
    rdfs:label "three dimensional cartesian spatial coordinate datum"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "A cartesion spatial coordinate datum that  uses three values to specify a position within a three dimensional spatial region"@en ;
    obo:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000400 .

obo:IAO_0000581 a owl:ObjectProperty ;
    rdfs:label "has time stamp"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    obo:IAO_0000115 "relates a time stamped measurement datum to the time measurement datum that denotes the time when the measurement was taken"@en ;
    obo:IAO_0000116 "IAO declared \"time measurement datum\" as range, which is (not yet) imported by OEO. Therefore the range declaration is missing here." ;
    obo:IAO_0000117 "Alan Ruttenberg"@en ;
    rdfs:domain obo:IAO_0000582 ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subPropertyOf obo:BFO_0000051 .

obo:IAO_0000582 a owl:Class ;
    rdfs:label "time stamped measurement datum"@en ;
    obo:IAO_0000114 obo:IAO_0000123 ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000109 .

obo:OBI_0500000 a owl:Class ;
    rdfs:label "study design"@en ;
    obo:IAO_0000111 "study design"@en ;
    obo:IAO_0000115 "A plan specification comprised of protocols (which may specify how and what kinds of data will be gathered) that are executed as part of an investigation and is realized during a study design execution." ;
    obo:IAO_0000412 obo:obi.owl ;
    rdfs:isDefinedBy <https://openenergyplatform.org/ontology/oeo/imports/iao-extracted.owl> ;
    rdfs:subClassOf obo:IAO_0000104 .

obo:RO_0002081 a owl:ObjectProperty ;
    rdfs:label "before or simultaneous with"@en ;
    obo:IAO_0000117 "David Osumi-Sutherland" ;
    obo:IAO_0000118 "<="@en ;
    rdfs:comment "Primitive instance level timing relation between events" ;
    rdfs:subPropertyOf obo:RO_0002222 .

obo:RO_0002093 a owl:ObjectProperty ;
    rdfs:label "ends during"@en ;
    obo:IAO_0000117 "David Osumi-Sutherland" ;
    obo:IAO_0000118 "o",
        "overlaps" ;
    rdfs:comment "X ends_during Y iff: ((start(Y) before_or_simultaneous_with end(X)) AND end(X) before_or_simultaneous_with end(Y). "@en ;
    rdfs:subPropertyOf obo:RO_0002222 .

obo:RO_0002223 a owl:ObjectProperty ;
    rdfs:label "starts"@en ;
    obo:IAO_0000114 obo:IAO_0000125 ;
    obo:IAO_0000115 "inverse of starts with" ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-6601-2165>,
        "Chris Mungall" ;
    obo:IAO_0000119 "Allen" ;
    rdfs:subPropertyOf owl:topObjectProperty ;
    owl:inverseOf obo:RO_0002224 ;
    :OEO_00020426 """add `Inverse Of`
issue https://github.com/OpenEnergyPlatform/ontology/issues/979
pull request https://github.com/OpenEnergyPlatform/ontology/pull/1086""" .

obo:RO_0003301 a owl:ObjectProperty ;
    rdfs:label "has role in modeling"@en ;
    obo:IAO_0000115 "A relation between a biological, experimental, or computational artifact and an entity it is used to study, in virtue of its replicating or approximating features of the studied entity." ;
    obo:IAO_0000117 <https://orcid.org/0000-0002-1048-5019> ;
    obo:IAO_0000118 "is used to study"@en ;
    rdfs:comment "The primary use case for this relation was to link a biological model system such as a cell line or model organism to a disease it is used to investigate, in virtue of the model system exhibiting features similar to that of the disease of interest. But the relation is defined more broadly to support other use cases, such as linking genes in which alterations are made to create model systems to the condition the system is used to interrogate, or computational models to real-world phenomena they are defined to simulate." ;
    rdfs:subPropertyOf owl:topObjectProperty .

obo:RO_0004007 a owl:ObjectProperty ;
    rdfs:label "has primary input or output" ;
    obo:IAO_0000115 "p 'has primary input ot output' c iff either (a) p 'has primary input' c or (b) p 'has primary output' c." ;
    oboInOwl:created_by <https://orcid.org/0000-0002-6601-2165> ;
    oboInOwl:creation_date "2018-12-13T11:26:17+00:00"^^xsd:dateTime ;
    rdfs:subPropertyOf obo:RO_0000057 .

obo:UO_0000004 a owl:Class ;
    rdfs:label "electric current unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the flow of electric charge.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000007 a owl:Class ;
    rdfs:label "luminous intensity unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the wavelength-weighted power emitted by a light source in a particular direction.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000157 .

obo:UO_0000009 a owl:Class ;
    rdfs:label "kilogram" ;
    obo:IAO_0000115 "\"A mass unit which is equal to the mass of the International Prototype Kilogram kept by the BIPM at Svres, France.\" [BIPM:BIPM, NIST:NIST]" ;
    oboInOwl:hasExactSynonym "kg" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000045,
        obo:UO_1000021 .

obo:UO_0000010 a owl:Class ;
    rdfs:label "second" ;
    obo:IAO_0000115 "\"A time unit which is equal to the duration of 9 192 631 770 periods of the radiation corresponding to the transition between the two hyperfine levels of the ground state of the caesium 133 atom.\" [BIPM:BIPM, NIST:NIST]" ;
    oboInOwl:hasExactSynonym "s" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000045,
        obo:UO_1000010 .

obo:UO_0000011 a owl:Class ;
    rdfs:label "ampere" ;
    obo:IAO_0000115 "\"An electric current unit which is equal to the constant current which, if maintained in two straight parallel conductors of infinite length, of negligible circular cross-section, and placed 1 m apart in vacuum, would produce between these conductors a force equal to 2 x 10^[-7] newton per meter of length.\" [BIPM:BIPM, NIST:NIST]" ;
    oboInOwl:hasExactSynonym "A" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000045,
        obo:UO_1000011 .

obo:UO_0000012 a owl:Class ;
    rdfs:label "kelvin" ;
    obo:IAO_0000115 "\"A thermodynamic temperature unit which is equal to the fraction 1/273.16 of the thermodynamic temperature of the triple point of water.\" [BIPM:BIPM, NIST:NIST]" ;
    oboInOwl:hasExactSynonym "K" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000045,
        obo:UO_1000012 .

obo:UO_0000014 a owl:Class ;
    rdfs:label "candela" ;
    obo:IAO_0000115 "\"A luminous intensity unit which equal to the luminous intensity, in a given direction, of a source that emits monochromatic radiation of frequency 540 x 1012 hertz and that has a radiant intensity in that direction of 1/683 watt per steradian.\" [BIPM:BIPM, NIST:NIST]" ;
    oboInOwl:hasExactSynonym "cd" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000045,
        obo:UO_1000014 .

obo:UO_0000016 a owl:Class ;
    rdfs:label "millimeter" ;
    obo:IAO_0000115 "\"A length unit which is equal to one thousandth of a meter or 10^[-3] m.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "millimetre",
        "mm" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000008 .

obo:UO_0000032 a owl:Class ;
    rdfs:label "hour" ;
    obo:IAO_0000115 "\"A time unit which is equal to 3600 seconds or 60 minutes.\" [Wikipedia:Wikipedia]" ;
    oboInOwl:hasExactSynonym "h" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000032 .

obo:UO_0000051 a owl:Class ;
    rdfs:label "concentration unit" ;
    obo:IAO_0000115 "\"A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.\" [UOC:GVG]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000058 a owl:Class ;
    rdfs:label "rotational frequency unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the number of rotations in a given time.\" [NIST:NIST]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000105 .

obo:UO_0000080 a owl:Class ;
    rdfs:label "square meter" ;
    obo:IAO_0000115 "\"An area unit which is equal to an area enclosed by a square with sides each 1 meter long.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "m^[2]",
        "square metre" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000080 .

obo:UO_0000082 a owl:Class ;
    rdfs:label "square millimeter" ;
    obo:IAO_0000115 "\"An area unit which is equal to one millionth of a square meter or 10^[-6] m^[2].\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "mm^[2]",
        "square millimetre" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000082 .

obo:UO_0000083 a owl:Class ;
    rdfs:label "kilogram per cubic meter" ;
    obo:IAO_0000115 "\"A mass unit density which is equal to mass of an object in kilograms divided by the volume in cubic meters.\" [UOC:GVG]" ;
    oboInOwl:hasExactSynonym "kg/m^[3]",
        "kilogram per cubic metre" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000052 .

obo:UO_0000086 a owl:Class ;
    rdfs:label "kilogram per square meter" ;
    obo:IAO_0000115 "\"An area density unit which is equal to the mass of an object in kilograms divided by the surface area in meters squared.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "kg/m^[2]",
        "kilogram per square metre" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1010049 .

obo:UO_0000092 a owl:Class ;
    rdfs:label "turns per second" ;
    obo:IAO_0000115 "\"A rotational frequency unit which is equal to the number complete turn in a period of time that equals to 1 second.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "1/s",
        "one turn per second" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000092 .

obo:UO_0000094 a owl:Class ;
    rdfs:label "meter per second" ;
    obo:IAO_0000115 "\"A speed/velocity unit which is equal to the speed of an object traveling 1 meter distance in one second.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "m/s",
        "metre per second" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000094 .

obo:UO_0000096 a owl:Class ;
    rdfs:label "cubic meter" ;
    obo:IAO_0000115 "\"A volume unit which is equal to the volume of a cube with edges one meter in length. One cubic meter equals to 1000 liters.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "cubic metre",
        "m^[3]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000096 .

obo:UO_0000106 a owl:Class ;
    rdfs:label "hertz" ;
    obo:IAO_0000115 "\"A frequency unit which is equal to 1 complete cycle of a recurring phenomenon in 1 second.\" [NIST:NIST]" ;
    oboInOwl:hasExactSynonym "Hz",
        "s^1" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000106 .

obo:UO_0000107 a owl:Class ;
    rdfs:label "force unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the force is applied when a mass is accelerated.\" [NIST:NIST]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000109 a owl:Class ;
    rdfs:label "pressure unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the force applied to a given area.\" [NIST:NIST]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000115 a owl:Class ;
    rdfs:label "illuminance unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the luminous flux incident on a unit area.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000157 .

obo:UO_0000117 a owl:Class ;
    rdfs:label "luminous flux unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the flow of radiant energy.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000157 .

obo:UO_0000121 a owl:Class ;
    rdfs:label "angle unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the figure or space formed by the junction of two lines or planes.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000154 a owl:Class ;
    rdfs:label "irradiance unit" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the power of electromagnetic radiation at a surface, per unit area.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000157 .

obo:UO_0000166 a owl:Class ;
    rdfs:label "parts per notation unit" ;
    obo:IAO_0000115 "\"A dimensionless concentration notation which describes the amount of one substance in another. It is the ratio of the amount of the substance of interest to the amount of that substance plus the amount of the substance.\" [Wikipedia:Wikipedia]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000186 .

obo:UO_0000169 a owl:Class ;
    rdfs:label "parts per million" ;
    obo:IAO_0000115 "\"A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000 regardless of the units of measure used as long as they are the same or 1 part in 10^[6].\" [UOC:GVG]" ;
    oboInOwl:hasExactSynonym "10^[-6]",
        "ppm" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_1000169 .

obo:UO_0000189 a owl:Class ;
    rdfs:label "count unit" ;
    obo:IAO_0000115 "\"A dimensionless unit which denotes a simple count of things.\" [MGED:MGED]" ;
    oboInOwl:hasExactSynonym "count" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf obo:UO_0000186 .

obo:UO_0000219 a owl:Class ;
    rdfs:label "electric charge" ;
    obo:IAO_0000115 "\"A unit which is a standard measure of the quantity of unbalanced electricity in a body (either positive or negative) and construed as an excess or deficiency of electrons.\" [WordNet:WordNet]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

obo:UO_0000261 a owl:Class ;
    rdfs:label "conduction unit" ;
    obo:IAO_0000115 "\"A unit which represents a standard measurement of the transmission of an entity through a medium.\" [UOC:GVG]" ;
    rdfs:isDefinedBy obo:uo.owl ;
    rdfs:subClassOf :OEO_00010490 ;
    :OEO_00020426 """make subclass of 'physical unit'
issue: https://github.com/OpenEnergyPlatform/ontology/issues/2135
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2141""" .

