:OEO_00000016 a owl:Class ;
    rdfs:label "fuel cell"@en ;
    obo:IAO_0000115 "A fuel cell is a generator that converts chemical energy into electricity using redox reactions."@en ;
    obo:IAO_0000118 "Brennstoffzelle"@de ;
    rdfs:subClassOf _:N4a7370bd16214f86815c741fcc971e88,
        _:N5c925d1493ba44ca86bc2904ff2e1d63,
