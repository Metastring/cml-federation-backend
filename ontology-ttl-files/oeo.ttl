:OEO_00010210 a owl:Class ;
    rdfs:label "energy use"@en ;
    obo:IAO_0000115 "Energy use is the consumption of an energy carrier making use of the energy it carries." ;
    obo:IAO_0000118 "Energieverbrauch"@de,
        "energy consumption"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty obo:RO_0000057 ;
            owl:someValuesFrom :OEO_00020039 ],
        :OEO_00140039 ;
    owl:disjointWith :OEO_00010211 ;
    :OEO_00020426 """issue: https://github.com/OpenEnergyPlatform/ontology/issues/718
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/950

